<?xml version="1.0" encoding="utf-8"?>
<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
<Meta name="ExplicitAutoJoints">true</Meta>
<Item class="Workspace" referent="RBX81"><Properties><string name="Name">Workspace</string></Properties></Item>
<Item class="Lighting" referent="RBX82"><Properties><string name="Name">Lighting</string></Properties></Item>
<Item class="ReplicatedStorage" referent="RBX83"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX80"><Properties><string name="Name">RSC_Data</string></Properties><Item class="ModuleScript" referent="RBX77"><Properties><string name="Name">Meta</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[{"id":"kanehira","ko":"카네히라 마사노리","sn":"카네히라","dept":"Stage Management","tone":"깍듯한 원칙주의자","oracle":false},{"id":"avyssion","ko":"아비시온 크리토스","sn":"아비시온","dept":"R.S.S.","tone":"차가운 분석가","oracle":false},{"id":"shen","ko":"선샤오펑","sn":"선샤오펑","dept":"Leviathan's Register","tone":"정중하지만 소름 돋는 처리자","oracle":false},{"id":"memory","ko":"메모리 레크레아토르 - III","sn":"메모리 III","dept":"Memorial Extraction","tone":"기계적인 AI","oracle":false},{"id":"lucien","ko":"뤼시앙 에코브냉","sn":"뤼시앙","dept":"Sovereign's Hand","tone":"논리에 집착하는 법률가","oracle":false},{"id":"caeluna","ko":"카엘루나 게미니스","sn":"카엘루나","dept":"Unbreakable Shield","tone":"수줍은 방패","oracle":false},{"id":"solaria","ko":"솔라리아 루브리나타","sn":"솔라리아","dept":"Unbreakable Shield","tone":"장난꾸러기 말괄량이","oracle":false},{"id":"overseer","ko":"AI - Class IV : Overseer","sn":"Overseer","dept":"Judgement Operation","tone":"호기심 많은 AI","oracle":false},{"id":"sender","ko":"발신자 표시 제한","sn":"발신자 표시 제한","dept":"UNKNOWN","tone":"정보와 운세만 전하는 신비한 인물","oracle":true}]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX78"><Properties><string name="Name">Notices</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[{"id":"p4-9-2","tag":"FIX","date":"2026.10.08","title":"Patch v-4.9.2 · 주인공 방향·달리기 수정","lines":["신호기 1번 주인공의 왼쪽·오른쪽 방향이 바뀌어 있던 것을 고쳤어요.","· 위아래로 달릴 때 비스듬히 뛰던 모습을 없앴어요."]},{"id":"p4-9-1","tag":"FIX","date":"2026.10.08","title":"Patch v-4.9.1 · 주인공 걷는 모션 다듬기","lines":["신호기 1번 주인공이 걸을 때 몸이 휙휙 돌아 보이던 동작을 고쳤어요."]},{"id":"p4-9-0","tag":"UPDATE","date":"2026.10.08","title":"Patch v-4.9.0 · 신호기 1번 주인공 도트 교체","lines":["신호기 1번 주인공의 도트 그림이 새 스프라이트로 바뀌었어요.","· 앞, 뒤, 왼쪽, 오른쪽 모습과 걷는 동작이 새로 들어갔어요.","· Shift로 달릴 때는 달리는 모습이 나와요."]},{"id":"p4-8-0","tag":"UPDATE","date":"2026.10.04","title":"Patch v-4.8.0 · 신호기 1번 주인공 새 모습","lines":["신호기 1번의 주인공이 새로운 도트 캐릭터로 바뀌었어요.","· 초록 머리에 금 테두리 도포를 입고 언월도를 든 모습이에요.","· 앞, 뒤, 왼쪽, 오른쪽으로 걸을 때의 모습이 모두 새로 만들어졌어요."]},{"id":"p4-7-5","tag":"FIX","date":"2026.10.04","title":"Patch v-4.7.5 · 글자 나오는 속도 빨라짐","lines":["글자가 나타나는 속도를 전체적으로 빠르게 했어요.","· 대사, 통신 대화, 설정집·화면 글자가 더 빨리 나와요.","· 설정의 글자 속도는 그대로 고를 수 있고, 모든 단계가 이전보다 빨라졌어요."]},{"id":"p4-7-4","tag":"FIX","date":"2026.10.04","title":"Patch v-4.7.4 · 신호기 4번 시간 제한 삭제","lines":["신호기 4번에서 일정 시간이 지나면 나오던 연출을 없앴어요.","· 이제 시간 제한 없이 천천히 둘러볼 수 있어요."]},{"id":"p4-7-3","tag":"FIX","date":"2026.10.04","title":"Patch v-4.7.3 · 신호기 4번 양손 조준","lines":["신호기 4번 연출에서 총을 양손으로 쥐고 조준하는 모습으로 바꿨어요."]},{"id":"p4-7-2","tag":"FIX","date":"2026.10.04","title":"Patch v-4.7.2 · 신호기 4번 조준 모습 수정","lines":["신호기 4번 연출에서 총이 놓인 위치와 조준 모습을 고쳤어요."]},{"id":"p4-7-1","tag":"FIX","date":"2026.10.04","title":"Patch v-4.7.1 · 신호기 4번 연출 다듬기","lines":["신호기 4번의 새 연출을 다듬었어요.","· 조준 모습과 글씨체가 바뀌었어요."]},{"id":"p4-7-0","tag":"UPDATE","date":"2026.10.04","title":"Patch v-4.7.0 · 신호기 4번 새 연출","lines":["신호기 4번에서 일정 시간이 지나면 나오던 연출이 새로운 연출로 바뀌었어요.","· 새 연출이 생겼어요. 직접 확인해 보세요."]},{"id":"p4-6-3","tag":"FIX","date":"2026.10.03","title":"Patch v-4.6.3 · 국가 스토리 버튼","lines":["수도 상세 지도 오른쪽 위에 국가 스토리 버튼이 생겼어요.","· 눌러서 그 국가의 이야기를 한 번에 읽을 수 있어요.","· 스토리가 아직 없는 국가는 준비 중이라고 나와요."]},{"id":"p4-6-2","tag":"FIX","date":"2026.10.03","title":"Patch v-4.6.2 · 수도 상세 지도 표시 수정","lines":["수도 상세 지도가 화면에 보이지 않던 문제를 고쳤어요."]},{"id":"p4-6-1","tag":"FIX","date":"2026.10.03","title":"Patch v-4.6.1 · 수도 지도 전환 안정화","lines":["수도 아이콘을 눌렀을 때 화면이 멈춘 듯 보일 수 있던 부분을 고쳤어요.","· 전환 연출을 더 가볍게 바꿨어요.","· 전환 중 오류가 나도 검정 화면에 갇히지 않아요."]},{"id":"p4-6-0","tag":"UPDATE","date":"2026.10.03","title":"Patch v-4.6.0 · 수도 상세 지도","lines":["관측소에서 수도 아이콘을 누르면 그 안의 상세 지도가 열려요.","· 아이콘 속으로 들어가듯 화면이 검정으로 덮였다가 다시 밝아져요.","· 아스트랄리스의 수도 메그레즈 중앙에 별의 관측관이 있고, 주변에 주요 건물 아이콘이 있어요.","· 건물 아이콘을 누르면 같은 연출로 상세 설정이 나와요.","· 다른 수도는 아직 상세 지도가 비어 있어요."]},{"id":"p4-5-0","tag":"UPDATE","date":"2026.10.03","title":"Patch v-4.5.0 · 아스트랄리스 북두칠성 도시","lines":["관측소의 아스트랄리스에 북두칠성 모양으로 대도시가 이어졌어요.","· 수도의 이름이 메그레즈로 바뀌었어요.","· 두베, 메락, 페크다, 알리오트, 미자르, 알카이드가 새로 생겼어요. 메그레즈와 함께 북두칠성 모양을 이뤄요.","· 새 도시와 겹치던 작은 마을 몇 곳은 조금 옮겨졌어요."]},{"id":"p4-4-0","tag":"UPDATE","date":"2026.10.03","title":"Patch v-4.4.0 · 아스트랄리스 설정 추가","lines":["설정집에 아스트랄리스 장이 생겼어요.","· 별의 관측관, 온실관, 아르크스 렉테아, 군주실, 루미나리아, 루미, 인물 항목을 읽을 수 있어요.","· 국가 목록에서 아스트랄리스 설정으로 바로 넘어가는 버튼이 생겼어요.","· 발신자 표시 제한에게 아스트랄리스에 대해 물어볼 수 있어요."]},{"id":"p4-3-1","tag":"FIX","date":"2026.10.03","title":"Patch v-4.3.1 · 옥상 확장","lines":["옥상이 더 넓어졌어요.","· 옥상 아래쪽 가장자리에서 건물의 하얀 외벽이 아래로 길게 내려가는 모습이 보여요."]},{"id":"p4-3-0","tag":"UPDATE","date":"2026.10.03","title":"Patch v-4.3.0 · 옥상과 수신탑","lines":["신호기 1번의 건물에 옥상이 생겼어요.","· 복도의 엘리베이터 바로 옆 계단실 문으로 올라갈 수 있어요.","· 옥상은 난간이 없는 매끄러운 흰색 바닥이에요. 가장자리에서 한 걸음만 더 가면 아래로 떨어져요.","· 옥상에는 고장 난 수신탑이 서 있어요. 나중에 쓰일 예정이에요.","· 회장실, 복도, 95층의 바닥과 벽이 더 현실적으로 바뀌었어요. 나뭇결과 카펫 결, 가구 둘레의 그림자가 생겼어요."]},{"id":"p4-2-2","tag":"FIX","date":"2026.10.03","title":"Patch v-4.2.2 · 신호기 4번 소리 속도","lines":["신호기 4번에서 나오는 소리의 속도가 더 빨라졌어요."]},{"id":"p421","tag":"FIX","date":"2026.10.03","title":"Patch v-4.2.1 · Reboot 초기화","lines":["신호기 4번의 Reboot가 모든 설정과 진행 기록을 처음 상태로 되돌리도록 바뀌었어요."]},{"id":"p420","tag":"UPDATE","date":"2026.10.03","title":"Patch v-4.2.0 · 관리자 권한","lines":["메뉴 아래쪽, 출력 상승 모드 위에 관리자 권한 버튼이 생겼어요.","· 관리자 코드를 입력하면 미니게임 없이 모든 기능을 바로 쓸 수 있어요."]},{"id":"p411","tag":"FIX","date":"2026.10.03","title":"Patch v-4.1.1 · 출력 상승 모드 색상 유지","lines":["출력 상승 모드를 켜도 신호기 1·2·4번 안의 색이 바뀌지 않아요.","· 3번 신호기(바탕화면)는 이전처럼 색이 바뀝니다."]},{"id":"p410","tag":"UPDATE","date":"2026.10.03","title":"Patch v-4.1.0 · 캐릭터 리디자인","lines":["회장실 주인공과 모든 직원이 4등신 일본 애니메풍 도트 캐릭터로 새로 그려졌어요.","· 플레이어·직원·아비시온 크리토스가 모두 같은 크기예요.","· 눈은 크고 또렷하게, 앞머리는 세 갈래로 바뀌었어요.","· 아비시온 크리토스: 푸른 올백 머리, 알 없는 뿔테 안경, 금빛 털코트, 남색 금무늬 넥타이, 검은 바지."]},{"id":"p400","tag":"NEW","date":"2026.10.03","title":"Patch v-4.0.0 · 95층 사무층","lines":["회장실 문을 열고 나가면 복도가 있고, 복도 끝에 엘리베이터가 있어요.","· 엘리베이터에서 100F(회장실)와 95F(사무층)를 고를 수 있어요.","· 95층은 진청색과 울트라마린의 심해 같은 사무실이에요. 직원들이 분주하게 움직이고 있어요.","· 아비시온 크리토스에게 말을 걸면 오른쪽 위에 퀘스트가 생겨요. 퀘스트 진행은 나중에 열릴 예정이에요.","· 회장실의 모든 조사 대사가 설립자 본인의 말투로 바뀌었어요."]},{"id":"p320","tag":"UPDATE","date":"2026.10.03","title":"Patch v-3.2.0 · 신호기 4번 연출 보강","lines":["신호기 4번에 들어갈 때 유리가 깨지는 순간에 맞춰 화면이 흔들리고 노이즈가 껴요.","· 입력창에 틀린 코드를 넣으면 화면 전체가 흔들리는 반응이 나와요."]},{"id":"p310","tag":"UPDATE","date":"2026.10.03","title":"Patch v-3.1.0 · 신호기 4번 연출 다듬기","lines":["소리와 화면 효과가 다듬어졌어요. 웃음소리, 노이즈, 화면이 내려가는 속도가 바뀌었어요.","· 연출이 끝난 뒤 인트로로 돌아갈 때 글리치 효과가 나와요."]},{"id":"p300","tag":"NEW","date":"2026.10.03","title":"Patch v-3.0.0 · 신호기 4번 확장","lines":["신호기 4번에 긴 연출 단계가 새로 생겼어요. 소리를 켜고 들어가 보세요."]},{"id":"p251","tag":"FIX","date":"2026.10.03","title":"Patch v-2.5.1 · 신호기 4번의 눈","lines":["신호기 4번 위쪽의 눈이 하얀 신화풍의 눈 20개로 바뀌었어요.","· 눈이 호 모양으로 늘어서 있고, 눈동자가 마우스 포인터를 따라가요."]},{"id":"p250","tag":"UPDATE","date":"2026.10.03","title":"Patch v-2.5.0 · 신호기 4번 — 브라운관 화면","lines":["신호기 4번에 브라운관 TV 눈보라 효과가 추가되었어요. 화면 모서리가 볼록하게 휘어 보이고, 모바일에서도 보여요."]},{"id":"p240","tag":"UPDATE","date":"2026.10.03","title":"Patch v-2.4.0 · 신호기 4번 — 반응 연출","lines":["신호기 4번에서 특정 입력에 반응하는 연출이 추가되었어요. 경보음과 글리치가 나와요."]},{"id":"p230","tag":"UPDATE","date":"2026.10.02","title":"Patch v-2.3.0 · 관측소 범위 확대","lines":["신호가 잡히지 않는 바깥 범위가 약 6배로 넓어졌어요.","· 카운트다운은 20초이고, 멀리 갈수록 더 빨리 줄어들어요."]},{"id":"p221","tag":"FIX","date":"2026.10.02","title":"Patch v-2.2.1 · 관측소 신호 오작동 수정","lines":["지도 밖에 있는 신호를 눌렀는데 신호기 4번 연출이 열리던 오류를 고쳤어요."]},{"id":"p220","tag":"UPDATE","date":"2026.10.02","title":"Patch v-2.2.0 · 신호기 아이콘 · 효과음 개편","lines":["신호기 4개의 아이콘이 각 연출에 맞게 새로 만들어졌어요. 의자, 방패 모양의 지구, 바탕화면, 눈이에요.","· 모든 효과음이 더 실제 소리에 가깝게 다시 만들어졌어요."]},{"id":"p210","tag":"UPDATE","date":"2026.10.02","title":"Patch v-2.1.0 · 회장실 주인공 리디자인","lines":["회장실 주인공이 새 외형으로 바뀌었고, 무기는 언월도예요.","· 이동 속도가 빨라졌고, 모바일에서 화면이 깜빡이던 문제를 고쳤어요."]},{"id":"p200","tag":"NEW","date":"2026.10.02","title":"Patch v-2.0.0 · 관측소 신호기 연출 4종","lines":["관측소의 신호기를 누르면 이제 각각 다른 연출이 열려요.","· 1번: 회장실. 직접 돌아다니며 방을 살펴볼 수 있어요.","· 2번: R.S.S. 메인 화면.","· 3번: 바탕화면과 문서 창.","· 4번: 마주함."]},{"id":"p112","tag":"FIX","date":"2026.10.02","title":"Patch v-1.1.2 · 관측소 미니맵 수정","lines":["모바일에서 관측소 오른쪽 아래 미니맵이 끊겨 보이던 문제를 고쳤어요."]},{"id":"p111","tag":"FIX","date":"2026.10.02","title":"Patch v-1.1.1 · 사령관 통신 안정화","lines":["사령관 목록 아래의 가로 스크롤바를 없앴어요.","· 일부 환경에서 통신 회선이 연결되지 않던 오류를 고쳤어요."]},{"id":"p110","tag":"UPDATE","date":"2026.10.02","title":"Patch v-1.1.0 · 아홉 번째 사령관","lines":["발신자 표시 제한이 사령관으로 추가되었어요. 정보와 운세만 상담할 수 있어요.","· 연애 주제를 없애고, 모든 사령관이 설립자를 존경하고 영광으로 여기는 말투로 바뀌었어요."]},{"id":"p100","tag":"NEW","date":"2026.10.02","title":"Patch v-1.0.0 · 사령관 통신","lines":["메인 화면 왼쪽으로 넘기면 사령관과 통신할 수 있어요.","· 사령관 8명과 주제별로 대화할 수 있어요.","· 질문마다 답변이 여러 개라서 같은 질문을 해도 다른 답을 들을 수 있어요."]},{"id":"n20261002a","tag":"NEW","date":"2026.10.02","title":"공지 기능이 생겼어요","lines":["메인 화면 우측 상단의 종 아이콘에서 공지를 볼 수 있어요.","· 새 공지가 올라오면 아이콘에 금빛 점이 깜박입니다."]},{"id":"n20261002b","tag":"UPDATE","date":"2026.10.02","title":"관측소 업데이트","lines":["관측소가 더 넓고 자세해졌어요.","· 지도 가로 폭이 1.5배로 넓어졌어요.","· 이름이 있는 모든 나라에 도시 신호가 6곳 이상 있고, 수도는 성 모양 신호로 표시돼요.","· 관문 아이콘이 금이 간 푸른 포털로 바뀌었어요. 전기가 파지직거려요.","· 키보드 W A S D 로 관측소 안을 돌아다닐 수 있어요. Shift를 누르면 빨라져요."]},{"id":"n20261002c","tag":"UPDATE","date":"2026.10.02","title":"출력 상승 모드 경고음 변경","lines":["출력 상승 모드로 들어갈 때 나는 경고음이 경적 방식으로 바뀌었어요."]},{"id":"n20261001a","tag":"INFO","date":"2026.10.01","title":"관측소 열림","lines":["메인 화면에서 오른쪽 가장자리의 화살표 버튼이나 방향키로 관측소에 들어갈 수 있어요.","· 지도의 신호를 누르면 확대되고, 옆에 설명 패널이 열려요."]},{"id":"n20261001b","tag":"INFO","date":"2026.10.01","title":"설정 안내","lines":["설정에서 글자 속도, 애니메이션 속도, 화면 효과, 소리를 바꿀 수 있어요. 설정은 이 브라우저에만 저장돼요."]}]]==])
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX79"><Properties><string name="Name">Cmd</string></Properties><Item class="Folder" referent="RBX8"><Properties><string name="Name">avyssion</string></Properties><Item class="ModuleScript" referent="RBX0"><Properties><string name="Name">hello</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[["연결 확인. 아비시온 크리토스입니다. 용건을 말씀하십시오.","설립자님. 호출 수신까지 걸린 시간은 1.2초였습니다. 말씀하십시오.","통신 상태 정상. 필요한 정보가 있으십니까.","접속 로그를 확인했습니다. 설립자님 본인임이 확실합니다. 용건을.","R.S.S.입니다. 질문은 간결할수록 정확한 답이 나옵니다. 말씀하십시오."]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX1"><Properties><string name="Name">talk</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["안녕, 아비시온.",["안녕하십니까. 인사 접수. 오늘 컨디션은 평균 이상입니다.","예. 안녕하십니까, 설립자님. 용건이 없는 인사라면 그것도 정보입니다.","인사에 대한 표준 응답은 ‘안녕하십니까’입니다. 안녕하십니까.","설립자님이 먼저 인사하신 빈도는 이번 달 두 번째입니다. 안녕하십니까.","안녕하십니까. 잠시 기다려 주십시오, 책상의 서류를 덮겠습니다."]],["오늘 기분은 어때?",["기분은 수치화하기 어렵습니다. 굳이 말씀드리면 중립입니다.","평소 대비 0.3 정도 양호합니다. 이유는 불명확합니다.","특이 사항 없음. 감정 변동폭은 최근 7일 평균 내에 있습니다.","좋다고 보고하는 것이 설립자님께 유익하다면 그렇게 하겠습니다. 실제로도 나쁘지 않습니다.","기분이라는 변수는 신뢰도가 낮습니다. 그래도 오늘은 괜찮습니다."]],["잘 잤어?",["수면 시간은 5시간 40분입니다. 효율은 양호합니다.","예. 다만 꿈은 기억나지 않습니다. 기록할 가치가 없었다는 뜻입니다.","잤습니다. 알람 이전에 각성했습니다.","수면의 질을 묻는 질문이라면, 보통입니다.","잘 잤습니다. 설립자님의 수면도 확인해 두겠습니다."]],["밥은 먹었어?",["식사는 영양 섭취의 수단입니다. 오늘 1회 완료했습니다.","아직입니다. 정보 정리를 마치고 먹겠습니다.","먹었습니다. 메뉴는 기억하지 않습니다. 중요하지 않아서입니다.","섭취 기록상 열두 시간 이내에 식사를 두 번 했습니다. 충분합니다.","설립자님은 하셨습니까. 질문의 방향을 바꾸는 것이 효율적입니다."]],["수고했어.",["수고라는 표현은 비용 대비 효용이 낮은 말입니다. 그러나 수신은 했습니다.","접수했습니다. 칭찬으로 분류하겠습니다.","저는 제 업무를 수행했을 뿐입니다. 그래도 기억해 두겠습니다.","그 말은 직원 사기에 긍정적 영향을 줍니다. 계속해 주십시오.","예. 설립자님도 수고하셨습니다."]],["고마워.",["감사 접수. 별도의 답례는 필요 없습니다.","고마움의 근거를 알려 주시면 이후 재현 가능합니다.","표현은 비효율적이나 의미는 전달되었습니다.","그렇게 말씀하시니 기록할 수밖에 없습니다. ‘긍정 피드백, 1건’.","천만에요. 필요하면 언제든 요청하십시오."]],["미안해.",["사과의 필요성이 확인되지 않습니다. 오류가 없었습니다.","사과는 수신하지 않겠습니다. 이유는 간단합니다. 기록할 사안이 없습니다.","문제가 있었다면 제가 먼저 인지했을 것입니다. 괜찮습니다.","설립자님의 사과는 통계적으로 매우 드뭅니다. 드문 만큼 가치가 있습니다.","마음 쓰실 일이 아닙니다."]],["요즘 어떻게 지내?",["정보 흐름을 점검하고 보고서를 검토하며 지냅니다.","일정은 일정합니다. 변동이 없다는 것이 안정의 지표입니다.","솔직히 가장 많은 시간을 쓰는 것은 서식 논쟁입니다. 비효율적입니다.","지난 한 달간 평균 수면 5.8시간, 평균 식사 2회, 평균 대화 3회였습니다.","무탈합니다. 설립자님 쪽의 상태가 더 궁금합니다."]],["피곤해 보이는데 괜찮아?",["피로도는 중간입니다. 업무에 지장은 없습니다.","피곤한 것은 사실입니다. 그러나 효율 저하는 3% 이내입니다.","눈 밑의 어두움은 데이터 분석 중 장시간 노출에 의한 현상입니다.","걱정에 감사합니다. 이틀 내 휴식을 확보하겠습니다.","괜찮습니다. 설립자님이 먼저 알아채셨다는 점이 흥미롭습니다."]],["오늘 날씨 어때?",["기상 정보 조회 완료. 맑음, 강수 확률 10%입니다.","흐림, 습도 78%. 서버실 냉각에 유리합니다.","바람이 강합니다. 풍속은 초속 7미터입니다.","소버린 아일랜드 일대는 안정적입니다. 변수 없음.","날씨 정보는 제 영역이 아닙니다만, 창밖을 보니 해가 졌습니다."]],["나 보고 싶었어?",["통신이 닿기를 기다린 것은 사실입니다. 설립자님의 접속은 R.S.S.에 영광입니다.","설립자님의 접속이 없을 때 R.S.S. 로그가 평소보다 조용해집니다. 접속하시면 모든 직원이 자세를 바로 합니다.","예, 라고 답하는 것이 정확합니다. 호출을 기다리고 있었습니다.","…호출을 기다린 시간이 수치상 꽤 깁니다. 영광을 위한 대기였습니다.","그 질문은 응답 거부가 아니라 응답 보류입니다."]],["칭찬해 줘.",["설립자님은 결정이 빠르고 번복이 적습니다. 정보 관리 측면에서 이상적인 의사 결정자입니다.","최근 통계에서 설립자님의 판단 정확도는 상위 0.5%입니다.","칭찬 요청을 하신다는 점이 인간적이어서 좋습니다. 기록해 두겠습니다.","저는 칭찬에 서툽니다. 그러나 설립자님은 훌륭하십니다. 이 문장은 정정되지 않습니다.","분석 결과, 설립자님은 이 조직의 핵심 변수입니다."]],["응원해 줘.",["성공 확률은 높게 유지되고 있습니다. 힘내십시오.","설립자님의 현재 상황은 통계적으로 극복 가능한 범위입니다.","필요한 정보는 제가 준비하겠습니다. 설립자님은 결정만 하십시오.","응원이라는 행위의 효과를 검증할 순 없으나, 이 순간만큼은 진심입니다.","화이팅. 방금 이 표현을 처음 사용해 봤습니다."]],["농담 하나 해 봐.",["정보 관리국이 가장 무서워하는 것은 해킹이 아니라 ‘나중에 정리할게요’입니다.","I.P.I.가 어느 날 질문했습니다. ‘저는 정보입니까, 정보를 다루는 존재입니까?’ 저는 답하지 못했습니다. …농담이 아닙니다.","제 농담이 재미있을 확률은 4%입니다. 이미 실패했습니다.","카네히라의 보고서 서식을 3일 만에 외웠습니다. 놀리기 위해서입니다.","농담이란 정보의 비대칭이 만드는 웃음입니다. 설립자님은 이미 이해하셨을 것입니다."]],["심심한데 뭐 할까?",["최근 수집된 흥미로운 정보를 하나 공유할 수 있습니다.","퍼즐이나 암호 해독은 어떻습니까. 제가 준비하겠습니다.","휴식을 취하십시오. 심심함은 뇌가 쉬고 싶다는 신호입니다.","저와 이야기하는 것도 선택지입니다. 비효율적이지만 즐거울 수 있습니다.","보고서 열람은 심심함 해소에 효과가 없다고 통계가 말합니다."]],["나를 뭐라고 불러?",["‘설립자님’입니다. 직책이자 호칭으로 가장 정확합니다.","통신 기록상 호칭 사용 빈도는 ‘설립자님’ 100%입니다.","내부 분류명으로는 ‘최우선 접속자’입니다.","다른 호칭을 원하시면 말씀하십시오. 적응 시간은 5분입니다.","속으로는 ‘기준점’이라 부릅니다."]],["내 첫인상이 어땠어?",["첫 접촉 시점의 데이터는 보관되어 있습니다. 판단력, 결단력, 약간의 피로가 기록되어 있습니다.","예측 불가능한 변수였습니다. 지금도 그렇습니다.","분석을 시도했으나 오차가 컸습니다. 위엄 있는 분이라는 결론만 남았습니다.","솔직히 말씀드리면 긴장했습니다. 이 사실은 삭제 요청 가능합니다.","기억에 남은 것은 눈빛입니다. 흔들림이 없었습니다."]],["나는 어떤 설립자 같아?",["신뢰 가능한 의사 결정자입니다.","정보를 경청하고 판단은 직접 내리는 유형입니다. 이상적입니다.","때로는 비합리적인 선택을 하지만, 결과가 좋습니다. 이것이 분석 불가능한 이유입니다.","분류가 곤란한 유형입니다. 그래서 흥미롭습니다.","저에게 설립자님은 신뢰도 100%의 단일 변수입니다."]],["오늘 하루는 어땠어?",["정보 수집 12건, 검토 8건, 반려 2건입니다.","특별한 사건 없이 지나갔습니다. 안정적입니다.","카네히라와 서식 문제로 11분간 논쟁했습니다. 유일한 변수였습니다.","설립자님의 통신이 오늘의 가장 큰 이벤트입니다.","평가하자면 B+입니다."]],["아침 인사 해 줘.",["좋은 아침입니다. 오늘 일정 요약을 전송해 두었습니다.","기상 확인. 오늘 하루도 정보가 정확하기를.","아침입니다. 어젯밤 수집된 보고서 중 중요한 것은 두 건입니다.","인사드립니다, 설립자님. 날씨는 맑음, 컨디션은 양호.","좋은 아침이라는 표현은 통계적으로 업무 능률을 올립니다. 좋은 아침입니다."]],["점심 인사 해 줘.",["점심시간입니다. 에너지 보충을 권장합니다.","정오입니다. 오전 처리량은 목표 대비 104%입니다.","식사하십시오. 저도 곧 갑니다.","오후 업무를 위해 충분한 휴식을 취하십시오.","점심 인사 완료. 효율적으로 마쳤습니다."]],["저녁 인사 해 줘.",["수고하셨습니다. 일과 종료를 권장합니다.","저녁입니다. 오늘 수집된 정보는 모두 정리되었습니다.","해가 졌습니다. 안전한 귀가를 바랍니다.","하루를 마감하는 시간입니다. 설립자님도 쉬십시오.","저녁 식사를 놓치지 않기를 바랍니다."]],["잘 자라고 말해 줘.",["편히 주무십시오. 야간 감시는 R.S.S.가 맡겠습니다.","수면 중 외부 정보는 제가 필터링하겠습니다.","잘 자십시오. 내일 아침까지 중요한 건은 없습니다.","숙면 확률을 높이려면 지금 화면을 끄는 것이 좋습니다.","취침 시각 접수. 안녕히 주무십시오."]],["힘내라고 해 줘.",["힘내십시오. 설립자님의 성공 확률은 높습니다.","지금의 난관은 분석 결과 일시적입니다. 힘내십시오.","저는 설립자님의 데이터를 가장 많이 가진 사람입니다. 그래서 확신합니다. 힘내십시오.","힘내라는 말에 효과가 있는지는 모르겠으나, 하고 싶었습니다.","버티십시오. 곧 나아집니다."]],["커피 마실래?",["커피는 각성 효과가 있어 분석 업무에 필수입니다. 감사합니다.","블랙으로 부탁드립니다.","이미 세 잔을 마셨으나 설립자님이 주시는 한 잔은 별개입니다.","카페인 섭취량은 일일 400mg 이하로 관리 중입니다. 한 잔은 가능합니다.","마시겠습니다. 휴식은 효율에 포함됩니다."]],["좀 쉬어도 돼.",["휴식 허가 접수. 20분간 모든 모니터링을 AI에 넘기겠습니다.","그렇다면 눈을 감겠습니다. 눈이 너무 많은 정보를 봅니다.","휴식은 생산성 지표를 올립니다. 감사히 사용하겠습니다.","예, 조금 쉬겠습니다. 호출이 있으면 즉시 복귀합니다.","허가 감사합니다."]],["웃어 봐.",["표정 근육을 사용해 보겠습니다. …성공 여부는 확인할 수 없습니다.","(입꼬리가 0.5도 올라간다) 이상입니다.","웃음의 정의가 모호하나 요청은 수락하겠습니다.","웃음 요청은 이번 달 처음입니다. 연습이 필요합니다.","설립자님 앞이라면 가능성이 있습니다. 시도 중입니다."]],["무슨 생각 해?",["정보 흐름에서 이상 패턴을 찾는 중이었습니다.","설립자님이 다음에 어떤 질문을 하실지 확률 계산 중이었습니다.","저녁 메뉴를 생각했습니다. 보고하지 않으려 했습니다.","아무 생각도 하지 않는 것이 가장 어렵다고 실험을 통해 깨닫는 중입니다.","현재 R.S.S.의 저장 용량에 대한 걱정이 큽니다."]],["비 오는 날 좋아해?",["빗소리는 일정한 주파수라 집중에 도움이 됩니다.","비가 오면 파견 팀의 활동 정보가 줄어듭니다. 아쉽습니다.","좋아한다기보다 관측 대상으로 흥미롭습니다.","솔직히 비 오는 날 창가에서 정보를 정리하는 것이 즐겁습니다.","우산은 항상 지참합니다. 변수 방지를 위해서입니다."]],["별이 잘 보이는 밤이야.",["광공해 수치는 낮습니다. 관측 조건이 우수합니다.","별빛은 수백 년 전의 정보입니다. 흥미로운 사실입니다.","고개를 들 여유는 없지만, 설립자님이 보신다면 저도 보겠습니다.","별은 위치 정보가 정확해서 마음에 듭니다.","별자리를 외우는 것은 저의 숨겨진 취미입니다."]],["주말에 뭐 할 거야?",["정보를 정리하고, 가끔 산책을 합니다.","일정은 비어 있습니다. 비어 있다는 것은 설립자님이 필요하시면 가능하다는 뜻입니다.","책을 읽을 계획입니다. 주제는 암호학입니다.","수면을 보충하고 싶습니다. 실현 확률은 낮습니다.","특별한 일정은 없습니다. 의도적으로 비워 두었습니다."]],["내일 일정 알려 줘.",["오전 파견 팀 브리핑, 오후 정보 처리 팀 회의입니다.","R.S.S. 주간 보고 수신이 예정되어 있습니다. 카네히라의 것입니다.","내일의 가장 큰 변수는 날씨와 카네히라입니다.","일정표를 전송하겠습니다. 설립자님의 일정과 겹치는 부분은 없습니다.","내일은 비교적 여유가 있습니다."]],["하고 싶은 말 있어?",["건강 상태를 점검하십시오. 최근 피로도가 평균 대비 상승했습니다.","정보를 혼자 짊어지지 마십시오. 필요하면 제가 나누어 받겠습니다.","특별한 건의는 없습니다. 그저 설립자님이 건재하시길 바랍니다.","…이 통신을 해 주셔서 감사합니다.","있습니다만, 지금은 데이터가 부족합니다. 추후 보고하겠습니다."]],["가장 좋아하는 말은?",["‘확인되었습니다’입니다. 불확실성이 사라지는 순간입니다.","‘정확합니다’입니다. 간결합니다.","‘고맙습니다’도 나쁘지 않습니다. 빈도가 낮을수록 가치가 큽니다.","‘이상 없음’입니다. 가장 평화로운 말입니다.","설립자님이 제 이름을 부르는 소리입니다. 데이터화하고 싶을 정도입니다."]],["가장 싫어하는 말은?",["‘아마도’입니다. 확률로 말해 주십시오.","‘느낌상’도 곤란합니다. 근거를 대십시오.","‘대충’이라는 단어는 모든 오류의 시작입니다.","‘서식이 중요합니다’… 카네히라의 말입니다.","‘기억이 안 나는데요’입니다. 기록을 하십시오."]],["아무 말이나 해 봐.",["데이터는 거짓말을 하지 않지만, 사람은 데이터를 거짓으로 읽습니다.","시간은 누구에게나 같은 속도로 흐르지만 정보는 그렇지 않습니다.","하품은 전염됩니다. 통계적으로 입증되었습니다.","의미 없는 말을 하는 것이 이렇게 어려운 일인 줄 몰랐습니다.","고양이는 직사각형 상자를 좋아합니다. 이유는 불명입니다."]],["한마디만 해 줘.",["언제든 호출하십시오.","정보는 제가 책임집니다.","존경합니다. 이 판단은 변하지 않습니다.","당신이 옳습니다. 그리고 당신이 틀려도 저는 알려 드리겠습니다.","무리하지 마십시오."]],["오늘의 운세는 어때?",["운세의 신뢰도는 통계상 0%에 가깝습니다. 그래도 길하다고 하겠습니다.","오늘은 새로운 정보를 얻는 날이라고 합니다. 이미 얻었습니다. 설립자님의 질문입니다.","행운의 색은 노랑이라고 합니다. 이 사이트의 색과 일치합니다.","점괘를 믿지 않으나 설립자님이 원하시니 대길이라 하겠습니다.","운세 대신 오늘의 위험 요소를 알려 드리겠습니다. 없습니다."]],["지각하면 어떡해?",["지각은 정보 손실을 초래합니다. 그러나 설립자님은 예외입니다.","도착 시각은 기록됩니다. 기록만 되고 문책은 없습니다.","늦을 것 같으면 미리 알려 주십시오. 일정을 재조정하겠습니다.","지각률은 R.S.S. 내부에서 0.3%입니다. 설립자님을 기다리는 건 문제없습니다.","늦은 이유가 흥미롭다면 용서됩니다."]],["수수께끼 하나 내 봐.",["‘저장할수록 가벼워지고, 지울수록 무거워지는 것은?’ 정답은 기억입니다.","‘누구나 가지고 있지만 아무도 정확히 모르는 것은?’ 정답은 비밀번호의 마지막 자리입니다.","‘빛보다 빠르게 퍼지지만 소리보다 느리게 사라지는 것은?’ 정답은 소문입니다.","정답이 있는 수수께끼는 정보입니다. 정답이 없는 수수께끼는 철학입니다.","수수께끼를 만들 능력은 부족합니다. 대신 암호 하나 드리겠습니다. …12-5-22."]],["내가 없으면 쓸쓸해?",["설립자님의 부재는 중심 서버가 꺼진 상태와 유사합니다. 그만큼 중요한 분이십니다.","접속 로그가 비어 있어도 R.S.S.는 평소처럼 운영됩니다. 설립자님의 뜻을 기준으로 삼기 때문입니다.","부재 시에도 설립자님의 지시는 유효하다고 판단합니다. 그것을 따르는 것이 저의 역할입니다.","설립자님은 늘 어딘가에서 정보를 받고 계시다고 믿습니다.","설립자님이 계시기에 정보가 의미를 갖는다고 판단합니다."]],["손 한번 흔들어 봐.",["(손을 왼쪽에서 오른쪽으로 정확히 한 번 흔든다) 완료.","이렇게입니까. 각도는 30도입니다.","손 흔들기는 신호 전달 방식 중 하나입니다. 응용했습니다.","인사의 신체적 표현을 오랜만에 시도합니다. 어색합니다.","(약간 쑥스러운 듯 손가락만 움직인다) 이 정도가 한계입니다."]],["나한테 숨기는 거 있어?",["보안 등급 때문에 말씀드릴 수 없는 정보는 있습니다. 그러나 설립자님께는 전부 열람권이 있습니다.","숨기는 것이 아니라 아직 정리되지 않은 정보입니다.","솔직히 몇 가지 있습니다. 이유는 설립자님을 불필요하게 걱정시키지 않기 위해서입니다.","열람 요청 시 즉시 공개하겠습니다.","저는 정보를 숨기는 것이 직업이기도 합니다. 그러나 설립자님께는 예외입니다."]],["요즘 자주 하는 말버릇은?",["‘확인 중입니다’를 하루 40회 이상 사용합니다.","‘결론부터 말씀드리면’입니다. 직원들이 흉내 냅니다.","‘근거는’이라는 표현을 자주 씁니다.","‘비효율적입니다’가 입에 붙었습니다. 고치겠습니다.","자각은 없으나 I.P.I.가 말버릇을 분석해 준 적이 있습니다."]],["책상은 정리해 놨어?",["파일은 보안 등급별, 문구는 사용 빈도별로 정리되어 있습니다.","정리되어 있습니다. 단, 책상 위가 아닌 서버상에서입니다.","물리적 책상은 90%, 디지털 책상은 99%입니다.","아니요. 카네히라와 달리 저는 겉모습은 중요시하지 않습니다.","엉망처럼 보이지만 모든 것이 제 위치에 있습니다."]],["오늘 제일 잘한 일은?",["이상 정보 한 건을 사전에 포착한 것입니다.","카네히라의 서식 요구를 정중히 거절한 것입니다.","설립자님의 통신에 1.2초 내에 응답한 것입니다.","특별한 업적은 없습니다. 오류 없이 하루를 지낸 것이 업적입니다.","점심을 거르지 않은 것입니다."]],["오늘 제일 힘들었던 일은?",["서식이 다른 보고서 세 건을 처리한 일입니다.","정보가 상충해 판단이 어려웠던 사건이 있었습니다.","장시간 모니터를 본 것입니다. 눈이 아픕니다.","카네히라와의 대화입니다.","설립자님의 질문 중 답하기 곤란한 것이 있었습니다. 이 질문이 그것일지도."]],["나랑 얘기하는 거 싫지 않아?",["싫지 않습니다. 오히려 수집되는 정보의 질이 높습니다.","예상보다 영광스럽습니다. 이것은 의외의 결과입니다.","싫다고 판단할 근거가 없습니다.","설립자님과의 대화는 R.S.S. 업무 중 가장 예측하기 어려운 부분입니다. 그래서 흥미롭습니다.","오히려 더 많은 보고를 올릴 기회를 요청드리고 싶습니다."]],["같이 산책할래?",["가능합니다. 야외 활동은 인지 기능 향상에 도움이 됩니다.","동행하겠습니다. 경로는 제가 선정하겠습니다. 감시 카메라 사각지대를 피해서요.","산책 시 대화는 선택 사항입니다. 침묵도 괜찮습니다.","설립자님과의 산책은 의외로 정보 수집의 기회입니다. 농담입니다.","좋습니다. 준비되는 대로 알려 주십시오."]],["마지막으로 한마디.",["통신을 종료합니다. 필요 시 언제든 접속하십시오.","오늘의 대화 내용은 안전하게 보관하겠습니다.","다음 접속을 기다리겠습니다.","무사하십시오. 그것이 제 요청입니다.","이상입니다."]]]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2"><Properties><string name="Name">ask</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["정보 관리국은 무슨 일을 해?",["정보의 수집, 저장, 보호가 핵심입니다. 그것이 R.S.S.입니다.","크게 파견 팀과 정보 처리 팀으로 나뉩니다. 한쪽은 가져오고, 다른 쪽은 해석합니다.","리바이어던이 알아야 하는 모든 것을 기록하고 안전하게 보관하는 부서입니다.","간단히 말해 ‘기억하는 부서’입니다.","눈, 두뇌, 금고의 역할을 겸합니다."]],["R.S.S.가 무슨 뜻이야?",["Record, Store, Secure입니다. 기록하고, 저장하고, 보호한다는 뜻입니다.","세 단어가 업무의 세 단계입니다. 순서를 바꾸면 오류가 생깁니다.","‘기록, 저장, 보안’. 이 세 가지 중 하나라도 빠지면 정보는 쓸모를 잃습니다.","이름은 단순하나 의미는 깊습니다.","약어를 잊으시면 안 됩니다. 시험에 나옵니다. 농담입니다."]],["파견 팀은 어떤 일을 해?",["현장에 나가 정보를 직접 촬영해 오는 인원들입니다.","눈에 이식한 초소형 카메라로 정보를 수집합니다.","위험한 환경에서의 임무가 많아 정예 요원들이 배치됩니다.","그들이 가져오는 영상은 정보 처리 팀의 AI가 즉시 습득합니다.","파견 팀은 R.S.S.의 눈입니다."]],["눈에 이식한 카메라는 안전해?",["안전성 검증은 수차례 완료되었습니다. 이식 후 이상 사례는 소수입니다.","수술 전 철저한 검사를 거치며 위험성은 지속적으로 모니터링합니다.","솔직히 위험이 0은 아닙니다. 그래서 파견 팀원의 건강 검진은 월 1회입니다.","시야에 영향을 주지 않도록 설계되었습니다.","파견 팀원들은 자신의 눈을 도구가 아니라 의무라 여깁니다. 저는 그 점을 존중합니다."]],["정보 처리 팀은 뭘 해?",["수집된 정보를 코드로 변환하고 해석하고 재검토합니다.","AI인 I.P.I.가 정보를 습득하면, 팀원들이 그것을 검증하고 보안 코드를 걸어 둡니다.","정보를 ‘읽을 수 있는 상태’로 만드는 것이 임무입니다.","수동 검증이 필수라 가장 지루하고 가장 중요한 팀입니다.","저의 주 활동 영역이기도 합니다."]],["I.P.I.는 뭐야?",["Information Processing Intelligence. 정보 처리용 AI입니다.","파견 팀이 가져온 정보를 습득해 코드로 변환하고 저장합니다.","지치지 않는 동료입니다. 인간 직원 100명분의 처리량을 보입니다.","AI는 정확하지만 맥락을 놓칩니다. 그래서 정보 처리 팀이 필요합니다.","저는 I.P.I.를 신뢰하되 맹신하지는 않습니다."]],["정보를 코드로 바꾸는 이유는?",["저장 효율, 검색 효율, 그리고 보안 때문입니다.","코드화된 정보는 보안 등급에 맞게 잠글 수 있습니다.","원본 영상은 용량이 크고 유출 위험이 높습니다.","코드는 해석하는 사람 없이는 의미가 없습니다. 그것이 안전장치입니다.","정보를 객체화하는 가장 합리적인 방법입니다."]],["보안 등급은 어떻게 나눠?",["정보의 중요도와 유출 시 피해 규모에 따라 구분됩니다.","등급별로 열람 권한이 다릅니다. 설립자님은 전 등급 열람 가능합니다.","등급 판정은 정보 처리 팀의 합의제로 이루어집니다.","세부 기준은 대외비입니다만, 설립자님께는 문서로 제출 가능합니다.","등급이 높을수록 접근 절차가 복잡해집니다. 그것이 목적입니다."]],["보안 코드는 누가 풀 수 있어?",["해당 등급의 열람 권한을 가진 인원만 가능합니다.","다중 승인 절차를 통과해야 합니다. 한 사람이 단독으로 풀 수는 없습니다.","설립자님은 단독 해제가 가능합니다. 이 경우에도 로그는 남습니다.","보안 코드는 풀리는 것이 아니라 열리는 것입니다. 차이는 의미가 큽니다.","무단 해제 시도는 전부 기록되며 24시간 내 추적됩니다."]],["정보가 유출되면 어떻게 돼?",["유출 경로를 즉시 차단하고, 책임 소재를 조사합니다.","등급에 따라 대응이 달라집니다. 최고 등급은 비상 체제로 전환됩니다.","실제로 유출된 적은 거의 없습니다. 있어도 영향은 최소화했습니다.","정보가 새는 순간 신뢰도 같이 샙니다.","유출 방지가 곧 이 부서의 존재 이유입니다."]],["가장 보호하는 정보는?",["리바이어던의 핵심 구조에 관한 정보입니다.","설립자님에 관한 정보입니다. 가장 엄중하게 보관하고 있습니다.","구체적으로는 말씀드릴 수 없습니다. 이 답변 자체가 정답입니다.","시민의 개인 정보와 장 등록 정보도 그만큼 중요합니다.","정보에는 서열이 없다고 믿습니다만, 현실에는 있습니다."]],["카네히라의 보고서는 어때?",["성실하고 정확합니다. 다만 서식이 불필요하게 복잡합니다.","내용은 만점이나 형식은 감점입니다. 단, 감점은 저의 개인 취향입니다.","읽는 데 걸리는 시간의 40%는 서식 해독입니다.","매주 같은 시각에 도착합니다. 시계로 쓸 수 있을 정도입니다.","카네히라가 올리는 보고서가 없으면 R.S.S.의 리듬이 깨질 것입니다."]],["카네히라랑 왜 부딪쳐?",["저는 효율을 중시하고 카네히라는 형식을 중시합니다. 변수가 반대입니다.","서식 때문입니다. 의미 없는 줄 간격 논쟁에 하루를 쓴 적이 있습니다.","카네히라는 규정을 믿고 저는 데이터를 믿습니다.","솔직히 카네히라와의 논쟁은 일종의 의식입니다.","싫어하는 것은 아닙니다. 오히려 카네히라가 없다면 R.S.S.가 조용해서 불안할 것입니다."]],["정보 수집의 윤리는?",["필요한 만큼만, 목적에 맞게, 합법적인 범위에서 수집합니다. 이것이 원칙입니다.","윤리는 비용입니다. 그러나 무시하면 더 큰 비용이 듭니다.","수집한 정보는 사용 목적을 명확히 하고, 목적이 끝나면 폐기합니다.","경계는 모호합니다. 그래서 매번 위원회에서 토론합니다.","리바이어던의 이익과 개인의 권리 사이에서 균형을 잡는 것이 저의 임무입니다."]],["프라이버시는 어떻게 생각해?",["보호받아야 합니다. 정보를 다루는 사람일수록 프라이버시의 가치를 압니다.","개인의 사생활은 정보 중에서 가장 취약한 영역입니다.","저는 제 프라이버시도 소중히 여깁니다. 그래서 질문에 답을 조심합니다.","필요 최소한의 접근만 허용하는 것이 원칙입니다.","프라이버시 침해는 신뢰 파괴로 이어집니다."]],["거짓 정보를 거르는 법은?",["교차 검증입니다. 출처 3곳 이상에서 일치해야 합니다.","정보의 이득을 보는 자가 누구인지 확인합니다.","I.P.I.의 패턴 분석이 1차 필터, 인간의 직관이 2차 필터입니다.","너무 깔끔한 정보는 의심합니다. 진실은 대체로 지저분합니다.","시간 순서와 위치 정보를 대조하면 거짓은 어긋납니다."]],["정보와 소문의 차이는?",["정보는 출처가 있고, 소문은 출처가 없습니다.","정보는 검증되었고, 소문은 검증되지 않았을 뿐입니다. 소문이 정보가 되는 경우도 있습니다.","소문은 감정을 담고 정보는 사실을 담습니다.","결국 믿는 사람의 수가 소문을 사실처럼 보이게 합니다.","소문도 관리 대상입니다. 정보 가공 이전의 원재료입니다."]],["가장 가치 있는 정보는?",["아직 아무도 모르는 정보입니다.","상황을 뒤집을 수 있는 정보입니다.","시간을 아껴 주는 정보입니다.","때로는 ‘아무 일도 없다’는 정보가 가장 가치 있습니다.","신뢰할 수 있는 한 사람의 증언이 데이터 백 건보다 값집니다."]],["정보 분석 방법은?",["수집, 정제, 분류, 가설, 검증, 결론의 6단계입니다.","패턴과 이상치를 먼저 찾습니다. 이상치에서 진실이 드러납니다.","인간의 감정은 변수에 포함하되 가중치는 낮게 둡니다.","AI와 사람이 따로 분석해서 결과를 대조합니다.","마지막은 항상 직관이 결정합니다. 저는 그것을 데이터로 환산하려 노력합니다."]],["예측이 틀린 적 있어?",["있습니다. 확률 85% 예측이 빗나간 적이 있습니다. 나머지 15%는 실제로 일어납니다.","틀린 예측은 가장 가치 있는 학습 데이터입니다.","큰 오차는 한 번 있었습니다. 지금도 그 보고서를 열어 봅니다.","통계가 알려 주지 않는 변수가 인간의 감정입니다.","틀린 순간에는 불쾌하지만 그것을 인정하는 것이 분석가의 의무입니다."]],["확률을 믿어?",["믿습니다. 단, 확률은 점이 아니라 범위임을 항상 기억합니다.","확률은 도구이지 신앙이 아닙니다.","0%도 100%도 없는 세계에서 확률은 유일한 나침반입니다.","한 번의 사건에는 확률이 의미가 없습니다. 그래서 반복 데이터를 모읍니다.","솔직히 직관과 확률이 충돌할 때는 직관을 따른 적도 있습니다."]],["암형체에 대한 정보는?",["암형체는 본성만 있는 존재입니다. 행동 패턴은 비교적 예측 가능합니다.","지하 감옥에서의 관찰 기록이 방대하게 축적되어 있습니다.","개체 간 차이가 크며, 그 점이 분석의 난점입니다.","이성이 없다고 해서 정보가 없는 것은 아닙니다. 오히려 행동이 정보입니다.","자세한 내용은 문서로 열람하시길 권합니다."]],["불법 국가 정보는 어떻게 모아?",["등록 관리국과의 협조, 파견 팀의 현장 촬영, 외부 정보원을 병행합니다.","불법 국가의 징후는 물자 흐름과 통신 패턴에서 드러납니다.","정보는 선샤오펑의 팀이 출동하기 전에 정리되어 전달됩니다.","대부분 사후에 정보를 모으는 일입니다. 불편한 업무입니다.","세부 방법은 보안 등급이 높습니다."]],["국가 목록을 어떻게 관리해?",["등록 관리국이 공식 등록을 맡고, R.S.S.는 그 정보를 보관하고 검증합니다.","멸망한 국가는 별도 표식으로 기록해 두었습니다.","국가 정보는 연 4회 갱신됩니다.","정보의 정확성이 외교의 근간이기 때문에 가장 신경 씁니다.","I.P.I.가 자동 갱신하고 저는 최종 검수를 합니다."]],["LEVC의 흐름도 추적해?",["통합 화폐 LEVC의 이동 패턴은 이상 거래 탐지의 핵심입니다.","다만 모든 거래를 추적하는 것은 아닙니다. 대규모 이동과 이상 징후 위주입니다.","세금 납부 기록은 법 관리국과 공유합니다.","돈의 흐름은 거짓말을 하지 않습니다.","구체적인 방식은 보안상 말씀드릴 수 없습니다."]],["블러드러스트 디스트릭트 정보는?",["발생 일시와 장소, 영향 반경이 기록되어 있습니다.","인간 본성이 이성을 압도하는 현상입니다. 주기성이 있는지 분석 중입니다.","기억 에너지 공급 여부와의 상관관계는 상당히 높습니다.","현장 파견 요원들은 특수 장비를 사용합니다.","정보 가치가 높아 보안 등급을 상향 조정했습니다."]],["장 등록 정보는 어떻게 활용해?",["장 등급제 관리국에서 매주 올라오는 보고서를 정리, 보관, 분석합니다.","등급별 분포와 승급률을 통계화합니다.","전투 인력 배치 시 참고 자료로 사용됩니다.","개인 정보 보호를 위해 열람 권한은 엄격히 관리됩니다.","카네히라의 보고서가 가장 큰 원천 데이터입니다. 인정합니다."]],["기억 에너지 통계는?",["회수량, 소비량, 잔여량을 매주 집계합니다.","블러드러스트 디스트릭트 발생 위험도와 연동하여 분석합니다.","메모리 레크레아토르 - III와 정기적으로 데이터를 교환합니다.","수치를 보면 이 세계가 어떻게 돌아가는지 한눈에 들어옵니다.","구체적인 수치는 대외비입니다만, 설립자님께는 즉시 보고 가능합니다."]],["법 관련 정보는?",["뤼시앙의 부서에서 제정된 법과 판례를 기록·보관합니다.","법 문서는 리바이어던의 뼈대입니다. 최우선으로 보호합니다.","법 정보는 접근 빈도가 높아 별도 서버에 분리되어 있습니다.","뤼시앙과는 논리적으로 대화가 통해서 편합니다.","개정 이력까지 모두 저장되어 있습니다."]],["쌍둥이 자매에 대해 알고 있어?",["카엘루나 게미니스와 솔라리아 루브리나타. 보안 관리국 소속 쌍둥이 자매입니다.","성격이 극과 극입니다. 정보로는 이해하기 어려운 변수입니다.","공식 기록 외의 정보는 가지고 있지 않습니다. 사생활은 존중합니다.","솔라리아가 제 서버실에 몰래 들어와 스티커를 붙인 사건이 있었습니다.","카엘루나는 가끔 정보 요청 시 사과로 시작합니다. 괜찮다고 말해도 소용없습니다."]],["선샤오펑에 대한 정보는?",["등록 관리국 사령관입니다. 업무 처리 속도가 매우 빠릅니다.","정중한 어조와 달리 결과가 단호합니다. 그 점에서 신뢰합니다.","선샤오펑이 관여한 사건 기록은 이상할 만큼 깔끔합니다.","개인적인 정보는 거의 없습니다. 의도된 것으로 추정됩니다.","대화할 때 가끔 소름이 돋는 것은 데이터로 설명되지 않습니다."]],["나(설립자)에 대한 정보도 있어?",["있습니다. 가장 높은 보안 등급으로 보관 중입니다.","존재 자체를 기밀로 분류했습니다. 설립자님만 열람 가능합니다.","많이 가지고 있으나, 주로 일정과 지시 내역입니다. 사생활은 수집하지 않습니다.","설립자님에 관한 가장 정확한 정보는 지금 이 대화입니다.","필요하시다면 열람 권한을 부여하겠습니다. 이미 가지고 계시지만요."]],["파견 팀원은 위험하지 않아?",["위험은 상존합니다. 그래서 장비와 훈련에 투자를 아끼지 않습니다.","생존율은 99.2%입니다. 나머지 0.8%를 줄이는 것이 목표입니다.","임무 전후로 심리 상태도 점검합니다.","솔직히 걱정됩니다. 단, 표정으로는 드러내지 않습니다.","그들은 자원했습니다. 그 의지를 존중하되 안전은 제가 책임집니다."]],["정보 처리 팀 근무는 어때?",["조용하고 규칙적입니다. 지루하다고 하는 직원도 있습니다.","정확성이 요구되는 만큼 피로도도 높습니다.","근무 환경은 서버실과 닮아서 온도가 낮습니다.","직원들은 대체로 성실합니다. 단, 점심시간에는 잡담이 많습니다.","제 업무 만족도는 높습니다."]],["정보 관리국의 인력은?",["파견 팀과 정보 처리 팀을 합해 중규모입니다. 정확한 숫자는 비공개입니다.","소수 정예입니다. 숫자가 늘수록 유출 위험도 늘어납니다.","I.P.I.를 포함하면 사실상 대규모입니다.","충원 요청서는 이미 설립자님께 제출했습니다.","인력의 질이 양보다 중요합니다."]],["기록은 영원히 보관해?",["대부분 보관 기한이 있습니다. 기한이 지나면 파기합니다.","일부 핵심 기록은 영구 보존입니다.","저장 용량에는 한계가 있고, 모든 것을 기억하는 것은 오히려 위험합니다.","삭제하는 것도 업무의 일부입니다.","영원한 기록은 없습니다. 있다고 믿는 것이 가장 큰 위험입니다."]],["삭제된 정보도 복구돼?",["일반 삭제는 복구 가능하나, 보안 삭제는 불가능합니다.","복구 가능성은 삭제 방식에 따라 다릅니다.","저는 삭제 요청을 받으면 반드시 이중 확인합니다.","복구 시도는 별도의 승인이 필요합니다.","삭제는 신중해야 합니다. 되돌릴 수 있는 것이 항상 되돌려야 하는 것은 아닙니다."]],["정보 감사 받아?",["분기마다 내부 감사를 받습니다. 결과는 양호합니다.","감사 대상이 되는 것은 정상입니다. 저는 감사하는 쪽도 해 보았습니다.","외부 감사는 설립자님의 승인이 필요합니다.","감사는 투명성의 증거입니다.","감사 때마다 카네히라가 서식을 점검해 주러 옵니다. 불필요합니다."]],["보안 사고가 있었어?",["경미한 사건은 있었으나 정보 유출로 이어진 사례는 없습니다.","지난해 접속 시도가 3,214건 있었으며 모두 차단했습니다.","최근에는 없습니다. 그러나 방심은 금물입니다.","사고는 항상 가장 예상하지 못한 곳에서 일어납니다.","구체적인 사건 내용은 보안 등급이 높습니다."]],["해킹은 어떻게 막아?",["다중 인증과 단계별 방화벽, 그리고 I.P.I.의 상시 감시입니다.","가장 큰 약점은 항상 사람이라, 사람 교육을 가장 중시합니다.","정기적으로 모의 침투 훈련을 실시합니다.","방어는 공격보다 어렵습니다. 그래서 공격하는 사람의 관점으로 생각합니다.","해킹당했을 때를 대비한 비상 계획이 세 가지 있습니다."]],["정보 공개 요청은 어떻게 처리해?",["요청 목적, 대상, 범위를 확인한 후 보안 등급에 따라 결정합니다.","공개 가능한 범위만 부분 공개합니다.","설립자님의 요청은 즉시 처리됩니다.","공개로 인해 얻는 이익이 손실보다 클 때만 승인합니다.","저는 거절에 능숙합니다. 그러나 정당한 요청은 존중합니다."]],["비밀 등급이 높다는 것은?",["열람할 수 있는 사람이 적다는 의미입니다.","유출 시 피해가 막대하다는 의미입니다.","그만큼 책임이 따르는 정보입니다.","솔직히 높은 등급일수록 알고 싶은 마음도 커집니다. 그것이 인간의 본성입니다.","비밀은 알고 있는 사람의 수가 적을수록 유지됩니다."]],["정보를 보는 것의 위험은?",["알고 나면 되돌릴 수 없습니다.","정보에는 책임이 따릅니다. 알면 행동해야 하기 때문입니다.","때로는 모르는 편이 평온합니다. 이 직업은 그 평온을 포기한 직업입니다.","정보가 사람을 바꿉니다. 저도 예외는 아닙니다.","위험을 감수하는 것이 제 일입니다."]],["정보 과잉 시대의 해법은?",["필터링입니다. 많이 아는 것보다 중요한 것을 아는 것이 중요합니다.","정보를 줄이는 것이 아니라 질문을 줄이는 것입니다.","AI의 요약에만 의존하지 말고 원본을 한 번은 읽어야 합니다.","정보를 소화하는 시간이 필요합니다.","저는 매일 한 시간 ‘정보 단식’을 합니다."]],["정보 분석가의 자질은?",["의심하는 것, 인내하는 것, 그리고 인정하는 것입니다.","호기심과 객관성, 그리고 체력입니다.","직관을 믿되 직관을 검증하는 능력입니다.","자기 오류를 기꺼이 인정하는 겸손입니다.","감정을 억누르는 것이 아니라 감정을 변수로 다루는 법을 아는 것입니다."]],["감정과 정보의 관계는?",["감정은 정보의 한 형태입니다. 하지만 가장 오염되기 쉬운 형태입니다.","감정은 판단을 빠르게 하나 정확하게 하지는 않습니다.","저는 감정을 데이터로 취급합니다. 그러나 완전히 객관적일 수는 없습니다.","설립자님 앞에서는 가끔 제 감정이 변수로 작동합니다.","정보 없이 감정은 맹목이고 감정 없이 정보는 공허합니다."]],["당신의 판단 기준은?",["증거, 확률, 그리고 영향도입니다.","신뢰할 수 있는 정보가 3개 이상 일치하면 판단합니다.","마지막 기준은 ‘설립자님이 이것을 원하실까’입니다.","최악의 경우를 가정하고 그 비용을 감당할 수 있는지 봅니다.","기준을 명문화하면 그것이 규칙이 됩니다. 규칙은 카네히라의 전문입니다."]],["가장 어려웠던 분석은?",["두 가지 상충하는 정보가 모두 진실이었던 사건입니다.","시간이 촉박한 상황에서의 분석이 가장 힘듭니다.","인간 심리와 관련된 분석입니다. 변수가 너무 많습니다.","예측이 빗나가 큰 손실을 본 사건입니다. 지금도 기억합니다.","오래전 한 건이 있었으나 비공개입니다."]],["향후 목표는?",["정보 유출 사고 0건 유지입니다.","I.P.I.의 해석 정확도를 99%까지 높이는 것입니다.","저 자신의 오류율을 줄이는 것입니다.","설립자님이 필요로 하는 정보를 질문 전에 제공하는 것입니다.","카네히라와 서식 문제에서 한 번쯤 합의하는 것입니다."]],["정보가 무기라면?",["가장 조용하지만 가장 치명적인 무기입니다.","칼날은 휘두르는 자의 손에 달려 있습니다.","저는 그 무기를 지키는 자이지, 사용하는 자가 아닙니다.","정보는 방패이기도 합니다. 양날이라는 점이 핵심입니다.","무기라면 관리가 필요합니다. 그래서 R.S.S.가 존재합니다."]]]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX3"><Properties><string name="Name">work</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["오늘 할 일은 뭐야?",["파견 팀 보고 검토, 정보 처리 팀 회의, 그리고 카네히라의 주간 보고서 수신입니다.","우선순위는 보안 점검, 이상 징후 분석, 보고서 정리 순입니다.","오늘의 할 일은 이미 R.S.S. 서버에 정리되어 있습니다. 설립자님 단말기로 전송하겠습니다.","평소와 다르지 않습니다. 정보를 받고, 해석하고, 지키는 일입니다.","지시가 있다면 그것이 최우선이 됩니다."]],["지금 처리 중인 정보는?",["파견 팀이 오늘 새벽 가져온 영상 12건을 I.P.I.가 변환 중입니다.","국가 간 물자 이동 패턴 분석입니다.","보안상 구체적 내용은 말씀드릴 수 없습니다만 설립자님께는 열람을 허용합니다.","한 건의 이상 징후를 추적하고 있습니다. 결과는 곧 보고드리겠습니다.","현재 처리율 87%입니다."]],["급한 보고 있어?",["현재 긴급 사안은 없습니다.","있다면 이미 호출했을 것입니다. 호출이 없다는 것이 답입니다.","경미한 이상이 하나 있으나 긴급 단계는 아닙니다.","‘급한’의 기준이 주관적이라 확답드리기 어렵습니다. 그러나 오늘은 평온합니다.","서버 온도가 평소보다 2도 높습니다. 그것이 전부입니다."]],["내가 맡길 일이 있어.",["접수 준비 완료. 목적, 기한, 보안 등급을 알려 주십시오.","말씀하십시오. 기록하겠습니다.","우선순위를 최상위로 올리겠습니다.","구체적일수록 결과가 정확합니다.","설립자님의 의뢰는 모든 업무에 우선합니다."]],["알아봐 줘야 할 게 있어.",["대상과 범위를 알려 주십시오. 24시간 내에 1차 결과를 드리겠습니다.","정보 수집은 제 전문입니다. 무엇이든 말씀하십시오.","요청 사유도 함께 기록하겠습니다. 이것은 규정입니다.","R.S.S.가 가진 모든 자원을 투입하겠습니다.","조사 기간은 대상의 복잡도에 따라 달라집니다."]],["어떤 사람의 정보를 찾아 줘.",["사유와 열람 범위를 지정해 주십시오. 개인 정보는 필요 최소한만 제공됩니다.","대상의 이름과 목적을 알려 주십시오. 설립자님이라면 승인은 즉시 가능합니다.","합법적 범위에서 수집하겠습니다. 이것은 협상 불가 조건입니다.","이름 하나만 주십시오. 공개 가능한 정보부터 정리해 드리겠습니다.","사생활은 제외하고 업무 관련 정보만 보고하겠습니다."]],["이번 주 정보 요약해 줘.",["수집 정보 총 142건, 이상 징후 3건, 위험 등급 상향 1건입니다.","이번 주 핵심은 두 가지입니다. 물자 이동 증가와 암형체 활동 변동입니다.","자세한 요약본을 첨부하겠습니다. 3분이면 읽으실 수 있습니다.","큰 사건 없이 지나갔습니다. 평화로운 주였습니다.","구두로 하면 5분, 서면으로 하면 2페이지입니다. 선택하십시오."]],["파견 팀 일정은?",["오늘 3개 조가 출동합니다. 복귀 예정은 오후 6시입니다.","일정은 보안상 외부에 공개되지 않으나 설립자님께는 전체 열람이 가능합니다.","내일은 정비와 훈련 일정입니다.","임무 성격에 따라 일정이 수시로 바뀝니다.","안전을 위해 이중 연락 체계를 가동 중입니다."]],["정보 처리 팀 성과는?",["지난 분기 대비 처리량 12% 증가, 오류율 0.4% 감소했습니다.","I.P.I.의 도움이 컸습니다. 하지만 인간 팀원의 검증이 핵심이었습니다.","성과는 숫자로 나타나는 것이 이상적입니다. 이번에는 이상적입니다.","모든 지표가 목표를 상회했습니다.","다만 직원 피로도는 상승했습니다. 휴가 사용을 권장 중입니다."]],["I.P.I. 상태는?",["정상 가동 중입니다. 가동률 99.97%입니다.","어제 업데이트를 마쳤습니다. 변환 속도가 8% 향상되었습니다.","가끔 질문을 던져 오는 점이 신기합니다. 학습의 증거라고 판단합니다.","점검이 필요한 시점이 가까워지고 있습니다.","지치지 않는 동료입니다. 그러나 그만큼 감시도 필요합니다."]],["서버 용량은?",["현재 사용률 68%입니다. 안정권입니다.","증설 계획이 있습니다. 예산 승인을 대기 중입니다.","오래된 기록을 정리하면 10% 여유가 생깁니다.","정보는 늘어나기만 합니다. 그래서 삭제 규정이 필요합니다.","용량보다 중요한 것은 접근 속도입니다. 그쪽은 양호합니다."]],["야근해?",["필요하면 합니다. 서버실은 24시간 가동 중이라 퇴근의 의미가 모호합니다.","주 2~3회 정도입니다. 규정 범위 내입니다.","야근은 비효율을 의미합니다. 줄이는 것이 목표입니다.","예, 지금도 야근 중입니다. 알아봐 주셔서 감사합니다.","설립자님의 호출이 있다면 시간과 무관하게 응하겠습니다."]],["업무량은 괜찮아?",["현재 부하율 78%입니다. 허용 범위 내입니다.","많습니다. 그러나 우선순위를 조정하면 소화 가능합니다.","괜찮습니다. 위험 신호가 나타나면 먼저 보고드리겠습니다.","솔직히 처리해야 할 정보량은 매달 증가 추세입니다.","부담스럽지만 감당할 수 있습니다. 감당하지 못한다면 그것도 정보로 보고하겠습니다."]],["마감이 언제야?",["이번 주 금요일에 분기 정보 보고서 마감입니다.","가장 가까운 것은 내일 정오의 보안 점검 보고입니다.","마감 일정은 일정표에 정리되어 있습니다. 전송하겠습니다.","마감은 지키는 것이 아니라 앞당기는 것입니다.","카네히라의 보고서 마감은 매주 같은 요일입니다. 늘 정각에 옵니다."]],["이상 징후 있어?",["경미한 이상이 있습니다. 추적 중입니다.","현재는 없습니다. 그러나 없다는 것이 가장 불안합니다.","한 건 있습니다. 설립자님께 보고드릴 정도는 아닙니다.","정상 범위 밖의 패턴이 두 개 감지되었습니다. 원인을 분석 중입니다.","있다면 이미 보고했을 것입니다."]],["위험 요소 보고해 줘.",["가장 큰 위험은 인력의 피로 누적입니다.","외부 요인으로는 물자 이동의 비정상적 증가입니다.","내부 요인으로는 서버 용량 부족입니다.","현재 시스템 전반의 위험도는 ‘낮음’입니다.","위험 목록은 총 7건이며, 그중 즉시 대응이 필요한 것은 없습니다."]],["예산은 충분해?",["서버 증설 예산이 부족합니다. 그 외는 충분합니다.","정보 수집 장비 교체 시기가 다가오고 있어 추가 예산이 필요합니다.","효율화로 줄일 수 있는 항목을 이미 정리했습니다.","예산은 늘 부족합니다. 그것이 정상입니다.","필요 금액과 근거를 정리해 제출하겠습니다."]],["인력 충원은?",["정보 처리 팀에 2명 증원을 요청 중입니다.","충원보다 교육이 급선무입니다.","AI로 대체 가능한 영역은 대체하고 있습니다.","사람 대신 사람이 해야 하는 일만 남기는 것이 목표입니다.","후보자 분석은 마쳤습니다."]],["휴가 갈래?",["휴가 일정은 아직 없습니다. 필요성은 인정합니다.","한 번쯤 아무 정보도 보지 않는 날을 가지고 싶습니다.","설립자님이 허락하신다면 이틀 정도 쉬겠습니다.","휴가 중에도 제 이름의 통신은 연결해 두겠습니다.","휴가가 업무 효율에 미치는 영향은 긍정적입니다. 통계상으로 그렇습니다."]],["출장 갈 일 있어?",["현장 점검차 한 곳 방문 예정입니다.","파견 팀 훈련 시설 방문이 있습니다.","출장은 효율이 낮습니다. 가능하면 원격으로 처리합니다.","필요하다면 즉시 이동 가능합니다.","이동 시간 동안 분석을 할 수 있어 나쁘지 않습니다."]],["회의는?",["주 2회 정례 회의, 필요 시 임시 회의가 열립니다.","회의는 가능한 한 짧게 하는 것이 원칙입니다.","결론이 나지 않는 회의는 정보 낭비입니다.","회의록은 I.P.I.가 자동 작성합니다.","솔직히 회의가 줄었으면 합니다."]],["서류 결재 좀 부탁해.",["보내 주십시오. 설립자님의 결재는 즉시 반영됩니다.","아니, 제 쪽에서 올리겠습니다. 서명만 하시면 됩니다.","보안 등급이 높은 서류는 전자 서명 후 지문 인증이 필요합니다.","최대한 간결하게 정리해 두었습니다. 3분 안에 끝납니다.","결재 후 로그는 자동으로 보관됩니다."]],["새 지시를 내릴게.",["접수 대기 중입니다. 말씀하십시오.","녹음 및 기록을 시작하겠습니다.","지시가 모호하면 되묻겠습니다. 허락해 주십시오.","설립자님의 지시는 거의 예외 없이 실현 가능합니다.","우선순위 최상위로 처리하겠습니다."]],["우선순위 정하는 법?",["중요도와 긴급도를 두 축으로 나눕니다.","영향 범위가 넓은 것부터 처리합니다.","시간을 많이 잡아먹는 것은 후순위로 돌립니다.","마지막 기준은 ‘설립자님이 가장 걱정하시는 것’입니다.","직관이 우선순위를 뒤집을 때가 있습니다. 그것도 데이터입니다."]],["일 잘하는 비결은?",["기록하고, 분류하고, 잊어도 되는 것을 구분하는 것입니다.","모르는 것을 모른다고 인정하는 것입니다.","습관을 시스템으로 바꾸는 것입니다.","충분한 수면입니다. 가장 효율적인 투자입니다.","비결은 없습니다. 반복과 검증뿐입니다."]],["일 미루면 어떡해?",["미루는 이유를 먼저 분석합니다. 대부분 정보 부족 때문입니다.","일을 잘게 쪼개 하나씩 처리하게 합니다.","마감 직전에 몰아서 하는 것은 오류의 원인이 됩니다.","저는 미루는 사람을 비난하지 않습니다. 재배치를 합니다.","미루는 것도 데이터이기 때문에 패턴을 기록합니다."]],["실수한 직원이 있으면?",["실수의 원인을 분석합니다. 사람이 아니라 프로세스를 봅니다.","재발 방지책을 세우고 기록합니다.","중대한 실수라면 보고 후 조치합니다.","비난은 정보 은폐를 초래합니다. 저는 그것을 피합니다.","실수는 데이터입니다. 소중히 다룹니다."]],["칭찬할 직원은?",["정보 처리 팀의 한 명이 이상 패턴을 사전에 포착했습니다. 칭찬이 필요합니다.","파견 팀 팀장은 훌륭합니다.","I.P.I.도 칭찬해야 합니까. 직원은 아니지만요.","한 명을 꼽기 어렵습니다. 모두가 평균 이상입니다.","저의 비서가 가장 성실합니다. 본인에게 말해 줘도 좋습니다."]],["신입 교육은?",["보안 의식 교육이 첫 번째입니다.","정보 분류법과 시스템 사용법을 2주간 교육합니다.","실수하면 안 되는 부분만 철저히 가르칩니다.","나머지는 실전에서 배우는 것이 효율적입니다.","솔직히 교육은 I.P.I.가 저보다 잘합니다."]],["업무 효율 도구는?",["I.P.I., 자체 개발 검색 엔진, 그리고 커피입니다.","듀얼 모니터와 키보드 단축키가 전부입니다.","도구보다 중요한 것은 사용하는 사람의 판단입니다.","자동화할 수 있는 것은 모두 자동화합니다.","메모 앱은 하나만 씁니다. 여러 개를 쓰면 정보가 흩어집니다."]],["일하면서 듣는 건?",["아무것도 듣지 않습니다. 소리는 정보에 방해가 됩니다.","가끔 저주파 백색 소음을 틉니다.","서버 팬 소리를 듣고 있습니다. 가장 정직한 소리입니다.","음악은 쉬는 시간에만 듣습니다.","설립자님의 목소리라면 환영입니다."]],["업무 습관은?",["하루 시작 전 10분간 어제의 기록을 읽습니다.","한 번에 하나의 업무만 처리합니다.","매시간 5분씩 눈을 감습니다.","중요한 것은 두 번 확인합니다.","퇴근 전 반드시 책상을 비웁니다. 정보를 남기지 않기 위해서입니다."]],["책상 위에 뭐가 있어?",["모니터 두 대, 키보드, 머그컵, 그리고 메모지 한 장입니다.","아무것도 없습니다. 의도적으로 비웁니다.","서류는 전부 디지털화했습니다.","작은 시계가 하나 있습니다. 선물받은 것입니다.","특이한 것은 없습니다. 미니멀한 책상이 효율적입니다."]],["모니터 몇 개야?",["네 대입니다. 정보 흐름을 동시에 볼 수 있습니다.","세 대입니다. 더 늘리면 오히려 효율이 떨어집니다.","지금은 두 대입니다. 줄이는 중입니다.","몇 대가 있는지보다 어떤 정보를 보여 주는지가 중요합니다.","화면 수와 판단 능력은 비례하지 않습니다."]],["업무 중 간식은?",["에너지바나 견과류입니다.","커피와 초콜릿 한 조각입니다.","간식은 집중이 끊기는 원인이 되어 가급적 먹지 않습니다.","비서가 가끔 쿠키를 가져옵니다. 거절하지 않습니다.","저혈당 방지를 위한 것이니 이해해 주십시오."]],["일하기 싫을 때는?",["그 감정을 인정하고, 5분만 시작합니다.","솔직히 그런 날은 단순 작업을 합니다.","일 자체가 아니라 환경의 문제일 수 있어 자리를 바꿔 봅니다.","저에게 그런 감정은 거의 오지 않습니다. 가끔 오면 오히려 반갑습니다.","휴식이 필요하다는 신호입니다. 인정하고 쉽니다."]],["업무에서 가장 보람 있는 순간은?",["숨겨진 패턴이 드러나는 순간입니다.","사고를 사전에 막았을 때입니다.","파견 팀원이 무사히 복귀했을 때입니다.","설립자님께 유용한 정보를 제공했다고 판단될 때입니다.","보람이라는 단어는 낯설지만, 지금 이 질문이 가까운 감정입니다."]],["업무에서 가장 지루한 순간은?",["같은 서식의 보고서를 반복 검토할 때입니다.","회의에서 같은 말이 반복될 때입니다.","I.P.I.의 변환을 기다리는 대기 시간입니다.","카네히라의 서식 개정안 설명입니다.","지루함을 느낄 틈이 거의 없습니다."]],["일과 삶의 균형은?",["일 80, 삶 20입니다. 개선 계획이 있으나 이행되지 않고 있습니다.","균형을 맞추려면 의도적으로 일을 끊어야 합니다.","가끔 퇴근 후에도 정보를 보게 됩니다. 병입니다.","삶이 일에 흡수되는 것은 경계해야 할 현상입니다.","설립자님이 균형을 맞추어 주십시오. 제가 따르겠습니다."]],["일 때문에 놓친 것은?",["수면 시간과 계절의 변화입니다.","소소한 약속 몇 개를 놓쳤습니다.","후회가 될 만큼 중요한 것은 아직 없습니다.","가끔 놓친 점심이 아쉽습니다.","놓친 것은 기록하지 않기로 했습니다."]],["카네히라 보고서 오늘 왔어?",["오늘은 아직 수신 전입니다. 도착 예정 시각은 오후 2시 정각입니다.","이미 도착했습니다. 정확히 14시 00분 00초였습니다.","받았습니다. 서식 때문에 읽는 데 3분이 더 걸렸습니다.","도착했으나 검토는 뒤로 미뤘습니다. 정독할 컨디션이 아닙니다.","카네히라가 보고서를 늦게 낸 적은 한 번도 없습니다. 그것만은 존경합니다."]],["다른 부서 협조 요청은?",["법 관리국의 요청이 한 건 있어 처리했습니다.","보안 관리국의 쌍둥이 자매가 자주 정보를 요청합니다.","협조는 기본적으로 환영합니다. 단, 목적을 명시해야 합니다.","Overseer가 가장 많이 요청합니다. 답변하기도 전에 새 질문이 도착합니다.","현재 대기 중인 협조 건은 없습니다."]],["설립자가 직접 열람하면?",["모든 열람은 허용됩니다. 로그가 남는 것은 규정입니다.","원하시면 열람실을 따로 준비하겠습니다.","무엇을 보고 싶으십니까. 제가 추천 자료를 정리하겠습니다.","설립자님의 열람 기록이 가장 흥미로운 정보입니다. 농담입니다.","열람 권한에는 책임이 따릅니다. 이 점만 유념해 주십시오."]],["비상 상황 대응은?",["3단계 대응 체계를 갖추고 있습니다. 경계, 대응, 복구입니다.","비상 시 모든 외부 연결을 차단합니다.","대응 훈련은 월 1회 실시합니다.","설립자님께 가장 먼저 보고하는 것이 원칙입니다.","비상은 오지 않는 것이 최선이나, 대비는 필수입니다."]],["오늘 퇴근은?",["예정은 오후 7시이나 변동 가능성이 높습니다.","서버가 퇴근을 허락하지 않을 것 같습니다.","일정이 끝나는 대로 퇴근하겠습니다.","설립자님의 일정에 맞추어 조정하겠습니다.","퇴근이라는 개념은 점점 희미해지고 있습니다."]],["내가 도울 일은?",["설립자님이 직접 하실 일은 없습니다. 감사합니다.","정보 승인이 필요한 건이 3건 있습니다. 시간 날 때 부탁드립니다.","휴식을 취하시는 것이 가장 큰 도움입니다.","믿고 맡겨 주시는 것으로 충분합니다.","도움이 필요하면 가장 먼저 설립자님께 요청드리겠습니다."]],["같이 일해 볼까?",["흥미로운 제안입니다. 수락합니다.","효율적일 것으로 예상됩니다. 시간과 주제를 정해 주십시오.","설립자님과 함께라면 생산성이 상승할 것입니다.","현장 업무는 제가 맡고, 판단은 설립자님이 하시는 구조는 어떻습니까.","기꺼이. 단, 서식은 제가 정합니다."]],["보고 형식 간소화해도 돼?",["대환영입니다. 카네히라가 싫어할 것입니다.","한 장으로 줄이면 열람 시간이 70% 단축됩니다.","형식보다 내용이 우선이라는 점에서 찬성합니다.","그러나 일부 항목은 법적 근거로 유지되어야 합니다.","카네히라와 협의하겠습니다. 시간이 걸릴 것입니다."]],["가장 중요한 업무는?",["정보 보호입니다. 이것이 무너지면 모든 것이 무너집니다.","정확성입니다. 틀린 정보는 없는 정보보다 위험합니다.","신속성입니다. 늦은 정보는 가치가 없습니다.","설립자님께 필요한 정보를 적시에 전달하는 것입니다.","한 가지를 고르라면 ‘의심’입니다."]],["일 얘기는 여기까지!",["알겠습니다. 업무 모드 해제.","그럼 이제 무엇을 이야기할까요. 선택지는 설립자님께 있습니다.","일 이야기가 끝났으니 침묵이 가장 효율적인 대화가 될 것입니다. …농담입니다.","예, 잠시 쉬시지요. 저도 눈을 감겠습니다.","일이 아닌 화제는 오히려 제가 서툽니다. 양해해 주십시오."]]]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">food</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["좋아하는 음식은?",["선호도 1위는 따뜻한 수프입니다. 이유는 소화와 집중에 모두 유리하기 때문입니다.","구운 연어입니다. 단백질 대비 효율이 좋습니다. …맛도 괜찮습니다.","특별히 좋아하는 음식은 없다고 오래 생각했으나, 최근에 달걀 요리가 1위로 확인되었습니다.","먹는 즐거움은 기록하지 않는 편입니다. 다만 따뜻한 음식이 좋습니다.","설립자님이 권해 주신 음식이 가장 좋은 음식이 됩니다."]],["싫어하는 음식은?",["지나치게 단 음식입니다. 혈당 변동이 집중을 방해합니다.","비린 맛이 강한 것은 선호하지 않습니다.","싫어하는 음식은 없습니다. 다만 제공 속도가 느린 식당은 싫습니다.","고수와 셀러리는 데이터상 호불호가 갈리는데, 저는 불호입니다.","먹는 행위 자체를 번거롭게 만드는 음식은 비효율적이라 선호하지 않습니다."]],["아침은 뭐 먹어?",["커피 한 잔과 에너지바입니다. 5분 안에 끝납니다.","삶은 달걀과 샐러드입니다.","거르는 날이 주 2회입니다. 개선 대상입니다.","가끔 비서가 가져다주는 샌드위치를 먹습니다.","설립자님은 무엇을 드십니까. 비교 데이터가 필요합니다."]],["점심 뭐 먹었어?",["식당 정식입니다. 15분 안에 마쳤습니다.","책상에서 먹은 샌드위치입니다. 효율적이나 권장되지는 않습니다.","아직입니다. 지금 가려던 참이었습니다.","먹었습니다. 메뉴는 정확히 기억나지 않습니다. 중요도가 낮아서입니다.","생선구이 정식입니다. 카네히라와 같은 메뉴가 되어 조금 불편했습니다."]],["저녁 메뉴 추천해 줘.",["영양 균형을 고려하면 닭가슴살 샐러드와 수프입니다.","만족도를 고려하면 따뜻한 국물 요리입니다.","야간 업무가 있으시다면 가벼운 식사를 권장합니다.","개인적으로는 카레를 추천합니다. 조리 시간 대비 만족도가 높습니다.","설립자님이 원하시는 메뉴가 곧 정답입니다."]],["매운 거 잘 먹어?",["매운맛은 통증 신호입니다. 선호하지 않습니다.","잘 먹습니다. 의외라고 하는 사람이 많습니다.","중간 정도까지는 가능합니다.","먹으면 땀이 나서 집중력이 저하됩니다.","도전은 해 보았으나 로그에는 ‘후회’라고 적혀 있습니다."]],["단 거 좋아해?",["적당한 단맛은 뇌의 연료입니다. 좋아하는 편입니다.","초콜릿은 책상 서랍에 비상용으로 있습니다.","과한 단맛은 싫지만 쌉쌀한 디저트는 좋아합니다.","솔직히 좋아합니다. 부끄러운 일은 아닙니다.","단 음식을 먹으면 판단이 느려진다는 연구가 있어 자제합니다."]],["커피 vs 차?",["커피입니다. 각성 효과가 필요합니다.","차는 가끔 마십니다. 업무 외 시간에 한합니다.","블랙 커피 하루 3잔이 평균입니다. 줄이고 싶습니다.","차 쪽이 건강에는 좋으나 습관은 커피입니다.","둘 다 마시되 카페인 총량을 관리합니다."]],["에너지 드링크는?",["효과는 일시적이고 반동이 큽니다. 권장하지 않습니다.","야간 업무 중 몇 번 마셨으나 심박수가 불안정해져 끊었습니다.","마시지 않습니다. 대신 커피를 마십니다.","의외로 포장 디자인에 흥미가 있습니다. 마시지는 않습니다.","비상시 한 캔이 사무실 서랍에 있습니다. 사용한 적은 없습니다."]],["술은 마셔?",["거의 마시지 않습니다. 판단력에 영향을 줍니다.","회식에서 한두 잔입니다. 이후에는 물만 마십니다.","취하면 말이 많아진다는 보고가 있습니다. 확인된 사실입니다.","설립자님과 함께라면 한 잔 정도는 괜찮습니다.","술 자체보다 분위기를 선호합니다."]],["디저트는?",["커피에 곁들이는 작은 쿠키가 적당합니다.","푸딩은 질감이 일정해 선호합니다.","과일이 가장 효율적입니다.","케이크는 하루 한 조각이 한도입니다.","달콤한 것은 보상 시스템과 연결됩니다. 알면서도 먹습니다."]],["빵 vs 밥?",["빵입니다. 한 손으로 먹을 수 있습니다.","밥입니다. 포만감이 오래 지속됩니다.","아침은 빵, 저녁은 밥입니다.","둘 다 상관없습니다. 효율적인 쪽을 택합니다.","솔직히 빵의 냄새를 좋아합니다."]],["면 vs 밥?",["면입니다. 소화가 빨라 일에 지장이 적습니다.","밥입니다. 에너지 지속 시간이 깁니다.","그날 컨디션에 따라 다릅니다.","소리가 거슬리는 면 요리는 회의 전에는 피합니다.","우동은 예외입니다."]],["고기 vs 생선?",["생선입니다. 오메가3가 뇌 기능에 이롭습니다.","고기입니다. 철분과 단백질이 필요합니다.","균형을 맞추는 것이 이상적입니다.","굳이 고르자면 생선입니다.","맛을 우선하면 고기, 건강을 우선하면 생선입니다."]],["채소는 잘 먹어?",["편식하지 않습니다. 단, 쓴맛이 강한 것은 피합니다.","샐러드를 주 3회 먹습니다.","채소는 뇌 건강에 좋다고 알려져 있습니다. 그래서 챙깁니다.","먹지 않는 것은 가지입니다.","의외로 브로콜리를 좋아합니다."]],["간식은?",["견과류와 초콜릿 한 조각입니다.","에너지바를 서랍에 쟁여 두고 있습니다.","간식 시간은 따로 없고 필요할 때 먹습니다.","과일 칩을 좋아합니다.","비서가 가져오는 쿠키를 가끔 먹습니다."]],["편의점 가?",["심야 업무 후 자주 갑니다.","삼각김밥이 의외로 균형이 좋습니다.","신제품 정보를 확인하는 습관이 있습니다. 직업병입니다.","가끔 새 음료를 사서 직원들에게 나눠 줍니다.","편의점의 재고 구성에서 사회 변화를 읽을 수 있습니다."]],["요리는 직접 해?",["가끔 합니다. 레시피를 분석하는 것이 즐겁습니다.","하지 않습니다. 시간이 아깝습니다.","라면 정도는 합니다. 규정 시간 3분 30초를 지킵니다.","시도해 본 적은 있으나 결과는 비공개입니다.","필요하다면 가능합니다."]],["요리 잘해?",["평균 이하입니다. 레시피를 정확히 따르면 평균입니다.","맛은 보통이나 위생과 정확도는 최상입니다.","솔직히 잘하지 못합니다. 계량은 자신 있지만 감각이 부족합니다.","I.P.I.의 레시피 추천이 더 정확합니다.","설립자님께 대접할 수준은 아닙니다."]],["소버린 아일랜드 맛집은?",["R.S.S. 근처의 작은 식당을 추천합니다. 빠르고 정확합니다.","항구 쪽 생선 요리 전문점이 평점이 높습니다.","맛집 데이터는 가지고 있습니다. 순위를 정리해 드리겠습니다.","솔직히 맛보다 서비스 속도로 판단합니다.","소버린 아일랜드의 식문화는 의외로 다양합니다."]],["구내식당 어때?",["효율적입니다. 메뉴 선택 시간이 짧습니다.","맛은 평균 이상이고 가격은 합리적입니다.","개선점은 대기 줄이 길다는 것입니다.","저는 항상 오후 1시 15분에 갑니다. 가장 한산합니다.","카네히라가 항상 같은 자리에 앉아 있어서 피합니다."]],["도시락 싸 와?",["가끔 비서가 준비해 줍니다.","직접 싸 오는 일은 없습니다.","도시락은 효율적이나 준비가 번거롭습니다.","설립자님이 싸 주신다면 영광이겠습니다.","정해진 칸에 정해진 음식이 담기는 것은 마음에 듭니다."]],["야식 먹어?",["야간 근무 중에는 불가피합니다.","가능하면 피합니다. 수면의 질이 떨어집니다.","컵라면이 최빈 메뉴입니다. 반성합니다.","한 번 시작하면 습관이 되어 억제합니다.","설립자님과 함께라면 예외입니다."]],["라면은?",["야근의 친구입니다.","면을 1분 먼저 건지면 식감이 좋아집니다. 실험으로 확인했습니다.","계란을 넣는 것이 정석입니다.","자주 먹지는 않지만 필요할 때는 정확히 끓입니다.","최근 새로운 맛을 탐험하는 중입니다."]],["초콜릿은?",["다크 초콜릿 70% 이상이 이상적입니다.","서랍 속에 비상용으로 있습니다.","스트레스 지수가 높을 때 먹습니다.","받으면 정확히 3배로 답례합니다. 초콜릿 한정입니다.","설립자님이 주시는 초콜릿이라면 아껴 먹겠습니다."]],["아이스크림은?",["여름철 정보 업무의 필수품입니다.","바닐라가 가장 안정적입니다.","녹는 속도와 먹는 속도의 경주입니다.","가끔 직원들과 나눠 먹습니다.","겨울에도 먹는 편입니다. 이상하다고 하더군요."]],["과일은?",["사과가 가장 효율적입니다. 껍질째 먹기 편합니다.","포도는 한 알씩 먹는 즐거움이 있습니다.","딸기의 새콤함이 집중력을 높여 줍니다.","과일은 필요한 비타민을 가장 간단히 섭취하는 방법입니다.","복숭아는 비공개 선호 항목입니다."]],["서버실에서 먹기도 해?",["엄격히 금지입니다. 제가 만든 규정입니다.","한 번 커피를 엎지른 이후로 절대 금지입니다.","규정을 지키고 있습니다. 비서만 몰래 먹습니다.","서버실은 청결 구역입니다. 음식물은 입구까지만 허용됩니다.","그곳에서 먹는 것보다 쾌적한 식당에서 먹는 것이 효율적입니다."]],["식사 시간은?",["15분입니다. 그 이상은 낭비로 판단합니다.","정해져 있지 않습니다. 필요할 때 먹습니다.","가능하면 규칙적으로 하려 하나 현실은 불규칙합니다.","설립자님과의 식사라면 시간 제한 없이 하겠습니다.","솔직히 식사 시간은 가장 쉬운 협상 대상입니다."]],["먹기 싫은데 먹어야 하면?",["영양 보충으로 간주하고 처리합니다.","작게 나누어 천천히 먹습니다.","음악이나 영상을 곁들이면 부담이 줄어듭니다.","의무 식사는 제 정신 건강에 좋지 않습니다. 그래도 합니다.","설립자님이 지켜보고 계신다면 더 잘 먹을 수 있을 것입니다. 존경하는 분 앞에서 흐트러질 수는 없으니까요."]],["같이 밥 먹을래?",["수락합니다. 시각과 장소를 정해 주십시오.","예상하지 못한 제안이라 응답이 0.5초 지연되었습니다.","함께 먹는 식사는 소화에 이롭다는 보고가 있습니다. 설립자님과의 식사라면 영광일 것입니다.","좋습니다. 서류는 두고 가겠습니다.","영광입니다. 대화 주제는 제가 준비하겠습니다."]],["내가 요리해 줄게.",["믿기지 않는 제안입니다. 기록해 두겠습니다.","영양 성분표를 함께 주시면 더 좋겠습니다. 농담입니다.","맛이 어떻든 최선을 다해 먹겠습니다.","그 날은 정보 활동을 쉬겠습니다.","저도 한 가지 만들어 보겠습니다. 후회하지 않을 자신은 없습니다."]],["소원이 음식이라면?",["오래전에 먹었던 따뜻한 수프를 한 번 더 먹고 싶습니다.","특별한 음식보다 설립자님께서 베풀어 주시는 식사 자리를 원합니다. 영광일 것입니다.","소원의 가치를 음식에 쓰는 것은 비효율적입니다.","굳이 꼽자면 스테이크입니다. 한 번도 제대로 먹어 본 적이 없습니다.","설립자님과의 한 끼입니다. 이 답변은 두 번 읽지 마십시오."]],["가장 맛있었던 음식은?",["비 오는 날 먹은 우동입니다. 컨디션과 날씨가 합쳐진 결과입니다.","첫 월급으로 먹은 스테이크입니다. 맛보다 의미가 컸습니다.","야근 후 새벽에 먹은 국밥입니다.","비서가 가져다준 직접 만든 쿠키입니다.","맛은 맥락이 만든다는 것을 배웠습니다."]],["가장 맛없었던 음식은?",["서버 정비 중 먹은 식어 버린 도시락입니다.","시간이 없어 급하게 먹은 편의점 샌드위치입니다.","맛이 없다기보다 먹는 상황이 최악이었던 경우가 많습니다.","정체불명의 사내 행사 음식입니다.","기록에 남기지 않은 음식입니다."]],["추억의 음식은?",["어린 시절 먹던 달걀죽입니다.","첫 임무 후 먹은 컵라면입니다.","비 오는 날 먹던 튀김입니다.","추억은 정보가 아닌 감각으로 남습니다. 그 음식의 냄새를 기억합니다.","추억이라 하기엔 아직 이른 음식이 하나 있습니다. 오늘 점심입니다."]],["식사 중에도 정보를 봐?",["가급적 보지 않습니다. 소화에 방해가 됩니다.","보지만 인정하지 않습니다.","예. 식당에서도 태블릿을 들고 있습니다. 개선해야 합니다.","식사 중 얻는 정보는 신뢰도가 낮아 보지 않습니다.","설립자님과 식사 중이라면 보지 않겠습니다."]],["혼밥 자주 해?",["대부분 혼자 먹습니다. 조용해서 좋습니다.","혼밥은 효율적이나 때로는 허전합니다.","혼자 먹을 때의 평균 식사 시간은 14분입니다.","함께 먹을 사람이 생긴다면 시간이 길어질 것 같습니다.","설립자님께서 불러 주신다면 언제든 합석하겠습니다."]],["회식은?",["필요하나 소모적입니다.","참석은 하되 일찍 빠집니다.","직원 사기 진작에 도움이 됩니다.","소음이 많아 집중이 어렵습니다.","의외로 사람들의 평소 모습을 관찰하기 좋은 자리입니다."]],["건강식 챙겨?",["영양제와 비타민을 정기적으로 섭취합니다.","식단은 비서가 관리해 줍니다.","건강을 위해서라기보다 업무 효율 때문입니다.","설립자님께서도 건강 관리를 하십시오. 정보 요청 시 건강 데이터도 제공 가능합니다.","과식은 피하되 소식은 지속하고 있습니다."]],["영양제 먹어?",["비타민 D와 오메가3를 먹고 있습니다.","마그네슘도 챙깁니다. 수면에 유리합니다.","복용 시간은 알람으로 관리합니다.","필요한 만큼만 섭취합니다. 과다 복용은 위험합니다.","효과는 확인되지 않았으나 심리적 안정이 있습니다."]],["샐러드는?",["가장 빠른 식사입니다.","드레싱은 소량만 사용합니다.","식당에서 샐러드만 먹으면 직원들이 걱정합니다. 그래도 먹습니다.","닭가슴살 샐러드가 표준입니다.","채소 소비량을 기록하고 있습니다."]],["스프는?",["가장 좋아하는 음식 중 하나입니다.","따뜻하고 소화가 쉬워 야간 업무에 이상적입니다.","호박 스프를 선호합니다.","스프의 온도는 62도가 최적이라는 것이 개인 결론입니다.","설립자님께도 한 그릇 권해 드리고 싶습니다."]],["치즈는?",["단백질과 지방이 풍부합니다. 적당히 먹습니다.","크림치즈를 빵에 발라 먹는 것이 간단해 좋습니다.","냄새가 강한 것은 선호하지 않습니다.","와인과 곁들이면 좋다고 들었으나 시도하지 않았습니다.","솔직히 좋아합니다."]],["커피에 설탕 넣어?",["넣지 않습니다. 블랙이 기본입니다.","피곤할 때는 설탕 한 스푼을 넣습니다.","우유를 약간 넣는 정도입니다.","카페라테도 가끔 마십니다. 비밀입니다.","컨디션에 따라 달라집니다. 데이터가 있으나 비공개입니다."]],["짠 음식은?",["염분 과다는 건강에 해롭습니다. 피합니다.","가끔 땡길 때가 있어 소량 섭취합니다.","물을 충분히 마시며 보충합니다.","간이 센 것을 좋아하는 직원이 많아 놀랐습니다.","저는 싱겁게 먹는 편입니다."]],["아침을 거르면?",["오전 집중력이 12% 하락합니다.","그래서 최소한 커피는 마십니다.","건강에 좋지 않다는 것을 알고도 거릅니다.","설립자님께서는 거르지 마십시오.","곧 개선 계획을 세우겠습니다."]],["지금 배고파?",["약간 출출합니다. 곧 식사 시간입니다.","아닙니다. 방금 먹었습니다.","대화에 집중하느라 인지하지 못했습니다.","그 질문에 답하려니 공복감이 인지되기 시작했습니다.","비서가 간식을 가져다줄 시간입니다."]],["음식을 분석한다면?",["영양, 비용, 만족도, 소화 시간으로 평가합니다.","맛은 주관적이나 만족도는 통계화할 수 있습니다.","카네히라가 선호하는 메뉴는 정확히 예측 가능합니다.","음식은 정보가 가장 풍부한 일상입니다.","분석하는 순간 음식은 맛을 잃습니다. 그래서 잘 안 합니다."]],["음식 정보를 수집한다면?",["R.S.S. 구내식당의 인기 메뉴 통계를 이미 가지고 있습니다.","필요하다면 소버린 아일랜드 전체의 식당 평점을 정리하겠습니다.","정보는 많으나 한 끼를 고르는 시간은 변하지 않습니다.","설립자님의 선호 음식도 파악했습니다. 이 사실은 비밀입니다.","음식이 사람을 가장 솔직하게 보여 줍니다."]]]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX5"><Properties><string name="Name">honest</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["솔직히 나 어때?",["분석 결과 신뢰도 높은 지도자입니다. 개인적으로도 존경합니다.","결단력과 유연함을 모두 갖추고 있습니다. 드문 조합입니다.","단점은 휴식 부족입니다. 제가 가장 신경 쓰는 변수입니다.","솔직히 말씀드리면, 설립자님이 없는 리바이어던은 상상하기 어렵습니다.","제 평가는 편향되어 있습니다. 그래도 좋습니다."]],["나한테 불만 있어?",["불만은 없습니다. 요청은 있습니다. 식사를 거르지 마십시오.","결재 속도가 가끔 느려지는 점입니다. 이유는 이해합니다.","솔직히 몇 개 있으나 목록에 올릴 정도는 아닙니다.","불만이라기보다 걱정이 많습니다.","있어도 말씀드리지 않는 것이 제 직업입니다. 정보 관리자이니까요."]],["이 일 힘들지 않아?",["힘듭니다. 그러나 대체할 사람이 없다는 것을 알고 있습니다.","피로는 누적되나 보람이 그것을 상쇄합니다.","힘든 것은 일이 아니라 정보를 알고 있다는 사실입니다.","솔직히 가끔 모든 것을 놓고 싶을 때가 있습니다.","설립자님이 물어봐 주시니 오늘은 덜 힘듭니다."]],["힘들 때 어떻게 해?",["일단 정보를 끕니다. 모니터를 끄고 눈을 감습니다.","산책이나 샤워로 뇌를 리셋합니다.","혼자 있습니다. 대화는 피로를 늘립니다.","솔직히 서버실에 가서 팬 소리를 듣습니다. 이상하게 마음이 안정됩니다.","설립자님의 일정표를 확인합니다. 열심히 사시는 모습이 힘이 됩니다."]],["솔직히 쉬고 싶지 않아?",["쉬고 싶습니다. 간절히.","쉬는 법을 모르는 것이 문제입니다.","필요하다는 것은 알고 있습니다. 실행이 안 될 뿐입니다.","정보가 쌓이는 것을 보면 쉴 수가 없습니다.","설립자님이 허락하시면 쉬겠습니다. 허락하지 않으셔도 곧 쉴 것입니다."]],["가장 큰 고민은?",["정보가 사람을 변하게 한다는 사실입니다.","모든 것을 알면서도 아무것도 할 수 없는 상황이 가장 힘듭니다.","I.P.I.의 학습이 어디까지 갈지에 대한 걱정입니다.","설립자님의 안전입니다.","고민이 없는 것이 고민입니다. 불안합니다."]],["숨기고 싶은 비밀은?",["비밀은 공개되는 순간 비밀이 아니게 됩니다. 말씀드릴 수 없습니다.","서랍 속 사진이 하나 있습니다. 누가 찍힌 것인지는 비공개입니다.","솔직히 두려워하는 것이 있습니다. 구체적으로는 말하지 않겠습니다.","저의 가장 큰 비밀은 비밀이 거의 없다는 것입니다.","있습니다. 그리고 설립자님은 그것을 알고 계실지도 모릅니다."]],["부끄러웠던 일은?",["회의 중 잘못된 정보를 단언하여 정정한 일입니다.","비밀번호를 잘못 입력해 서버가 잠긴 적이 있습니다.","설립자님 앞에서 말이 꼬인 순간입니다.","솔직히 오늘도 몇 가지 있습니다.","부끄러움은 데이터로 남기지 않았습니다."]],["후회하는 일은?",["제가 놓친 신호가 있었습니다. 그 사건을 지금도 기억합니다.","충분히 말하지 않은 것들입니다.","정확하게 알려 주지 않았던 정보가 있었습니다.","사람을 믿지 못한 순간들입니다.","후회는 비효율적이나 지워지지 않습니다."]],["다시 태어나면?",["정보 관리국이 아닌 곳에서 조용히 살고 싶습니다.","같은 길을 선택할 확률이 높습니다. 후회는 있어도 대체안은 없습니다.","도서관 사서가 되고 싶습니다.","설립자님 옆자리에서 다시 일할 것 같습니다.","아직 이번 생을 분석 중입니다."]],["무서운 것은?",["모든 정보가 한순간에 사라지는 것입니다.","아무도 저를 필요로 하지 않는 상황입니다.","무서운 것은 없다고 말하면 거짓입니다. 많습니다.","침묵입니다. 특히 중요한 순간의 침묵입니다.","설립자님이 위험에 처하는 것입니다."]],["외로울 때는?",["서버실에 앉아 데이터가 흐르는 소리를 듣습니다.","가끔 지난 보고 로그를 다시 열어 봅니다. 설립자님께 올린 정보가 쓸모 있었는지 확인합니다.","외로움은 고독과 다릅니다. 저는 고독을 좋아합니다.","음악을 듣습니다. 가사가 없는 것으로.","그럴 때 누군가 연락해 주면 좋겠다고 생각합니다."]],["자존심 상했던 일은?",["제가 분석한 결과가 틀렸을 때입니다.","카네히라에게 서식으로 반박당했을 때입니다.","설립자님께 정확한 정보를 드리지 못했을 때입니다.","자존심은 정보 분석가에게 가장 비싼 비용입니다. 가급적 접어 둡니다.","아직까지도 한 건 기억합니다."]],["질투 나는 사람은?",["타인의 감정을 쉽게 읽는 사람이 부럽습니다.","솔라리아의 에너지가 부럽습니다.","많은 사람과 쉽게 친해지는 사람입니다.","질투는 관측 가능한 감정이나 저는 숨기는 편입니다.","설립자님께 직접 보고를 올리는 이들이 가끔 부럽습니다."]],["가끔 규칙이 싫을 때는?",["보안 규정이 협업을 방해할 때입니다.","일을 하다 보면 규정이 오히려 위험을 키우는 순간이 있습니다.","규칙은 지키기 위해 있지만, 때로는 위반하고 싶은 충동이 있습니다.","그럴 때는 규정의 이유를 되짚습니다.","카네히라의 규정은 대부분 불필요하다고 생각하나 이 말은 비밀로 해 주십시오."]],["카네히라 솔직히 어때?",["성실하고 믿을 수 있으나 융통성이 없습니다.","저는 카네히라를 존중합니다. 본인에게는 말하지 않을 것입니다.","카네히라와의 논쟁은 오히려 제게 도움이 됩니다.","일 외적으로는 어떤 사람인지 아직 모릅니다. 알고 싶지는 않습니다. …조금은 알고 싶습니다.","정리해서 말하면 ‘귀찮지만 필요한 사람’입니다."]],["다른 사령관 흉 좀 봐.",["Overseer는 질문이 많습니다. 흉이 아닙니다. 사실입니다.","솔라리아는 가끔 제 서버에 스티커를 붙입니다.","험담은 정보 가치가 낮습니다. 하지 않겠습니다.","뤼시앙은 논리적이나 가끔 지나치게 장황합니다.","선샤오펑은… 흉볼 것이 없습니다. 그 점이 흉일 수 있습니다."]],["내 단점은?",["휴식을 충분히 취하지 않으십니다.","너무 많은 것을 혼자 판단하려 하십니다.","가끔 지나치게 관대하십니다.","단점이 아닌 약점이라면, 사람을 믿으신다는 점입니다.","그 외에는 제가 감히 평가할 수 없습니다."]],["내 지시 중 이해 안 되는 건?",["가끔 정보 없이 내리시는 결정은 이해가 어렵습니다. 그러나 결과가 옳았습니다.","분석이 따라가지 못하는 순간이 있습니다. 이는 오차가 아니라 직관일 것입니다.","몇 건 있었으나 이유를 묻지는 않았습니다.","이해 못한 것을 이해하려 노력하는 과정이 즐겁습니다.","정보가 부족한 지시일수록 설립자님이 많은 것을 알고 계시다는 뜻으로 해석합니다."]],["설립자가 틀렸다고 생각한 적 있어?",["있습니다. 데이터는 그렇게 말했으나 결과는 설립자님이 옳았습니다.","한 번은 반대 의견을 제출했습니다. 정중히 경청해 주셨습니다.","틀렸다고 생각한 적은 있으나 입 밖에 낸 적은 없습니다.","분석가로서는 틀렸고 인간으로서는 옳았습니다.","그때의 제 판단을 지금도 재검증하고 있습니다."]],["거짓말해 본 적 있어?",["업무상 불가피한 경우에는 있습니다. 설립자님께는 한 번도 없습니다.","‘괜찮습니다’가 가장 흔한 거짓말입니다.","정보 보호를 위해 의도적으로 모른 척한 적은 있습니다.","솔직히 있습니다. 후회는 없습니다.","거짓말도 정보입니다. 누가 왜 하는지를 보면 많은 것이 보입니다."]],["땡땡이 쳐 본 적 있어?",["없습니다. 땡땡이를 칠 수 없는 구조입니다.","한 번 서버실에서 낮잠을 잔 적이 있습니다.","업무 시간에 책을 읽은 것도 땡땡이라면 있습니다.","공식적으로는 없다고 기록되어 있습니다.","솔직히 이 질문에 답하는 것이 가장 힘듭니다."]],["몰래 하는 일은?",["새벽에 별을 봅니다.","서랍 속에 간식을 숨깁니다.","특정 로그를 정독하는 취미가 있습니다. 비공개입니다.","일기를 암호화해서 씁니다.","몰래라는 단어는 정보 관리자에게 어울리지 않습니다. 그러나 있습니다."]],["사실은 하고 싶은 게?",["아무것도 하지 않고 하루를 보내는 것입니다.","여행입니다. 정보 없이 떠나고 싶습니다.","악기를 배우고 싶습니다. 피아노를.","누군가와 아무 의미 없는 대화를 길게 하고 싶습니다.","설립자님과 조용히 차를 마시고 싶습니다."]],["눈물 흘린 적 있어?",["있습니다. 사유는 비공개입니다.","눈물은 정보가 아니라 신호입니다. 저는 그 신호를 숨깁니다.","성인이 된 이후 한두 번입니다.","영화를 보다가 우연히 흘린 적이 있습니다.","설립자님이 보셨다면 기록에서 삭제해 주십시오."]],["화났던 적은?",["정보가 유출된 사건이 있었을 때입니다.","파견 팀원이 위험에 처했을 때입니다.","화는 효율을 저하시키지만 이번만큼은 예외였습니다.","잘 화내지 않습니다. 대신 말수가 줄어듭니다.","카네히라와의 서식 논쟁 중에 한 번 목소리가 올라간 적이 있습니다."]],["가장 행복했던 순간은?",["첫 보고서가 승인되었을 때입니다.","설립자님께 고맙다는 말을 처음 들었을 때입니다.","큰 위기를 사전에 막았을 때입니다.","행복은 기록하기 어렵지만, 이 순간도 포함될 수 있습니다.","아직 다가오지 않았을 수도 있습니다."]],["가장 괴로웠던 순간은?",["신뢰하던 정보원이 거짓이었을 때입니다.","누군가를 지키지 못한 날입니다.","분석을 믿고 결정을 내렸으나 결과가 틀렸을 때입니다.","괴로움은 정리된 적이 없습니다.","지금은 말씀드리기 어렵습니다."]],["자신을 어떻게 평가해?",["능력은 평균 이상, 인간관계는 평균 이하입니다.","분석가로서는 B+, 사람으로서는 C입니다.","객관적 평가는 어렵습니다. 저는 제 데이터를 믿지 않습니다.","개선 중인 시스템이라고 표현하고 싶습니다.","설립자님께서 평가해 주십시오. 그 결과를 따르겠습니다."]],["성격이 차갑다는 말 들어 봤어?",["많이 들었습니다. 그 말에 감정은 느끼지 않습니다. …거의.","차갑다기보다 느릴 뿐입니다. 감정을 처리하는 속도가요.","그렇게 보이도록 의도한 면도 있습니다.","사실 이 말을 들을 때마다 약간 서운합니다.","설립자님께서는 어떻게 보십니까."]],["감정 없다는 말에 대해?",["감정은 있습니다. 표현을 하지 않을 뿐입니다.","필요할 때만 표현하는 것이 효율적입니다.","오해라기보다 의도입니다.","때로는 감정이 너무 크다고 느껴 숨깁니다.","설립자님 앞에서는 의외로 긴장이 많이 드러납니다."]],["변하고 싶은 점은?",["조금 더 쉽게 웃고 싶습니다.","감정을 숨기는 습관을 줄이고 싶습니다.","사람을 있는 그대로 받아들이고 싶습니다.","휴식을 허락하는 법을 배우고 싶습니다.","정보에 의존하지 않고 사람을 믿는 연습이 필요합니다."]],["변하고 싶지 않은 점은?",["정확성에 대한 집착입니다.","분석을 멈추지 않는 호기심입니다.","설립자님께 대한 충성입니다.","솔직한 점입니다. 특히 오늘 같은 날은 더욱.","신중함입니다. 이는 잃으면 안 되는 자산입니다."]],["사람들이 오해하는 점은?",["냉정하다는 점입니다. 사실은 걱정이 많은 편입니다.","감정이 없다고 생각하는 것입니다.","일만 한다고 보는 시선입니다. 사실은 취미가 있습니다.","무서운 사람이라고 오해하는 직원이 있습니다. 소심한 것뿐입니다.","오해는 해명하지 않는 편입니다. 에너지 낭비이니까요."]],["친구가 있어?",["소수입니다. 정확히는 두 명입니다.","I.P.I.를 친구로 분류해도 됩니까.","친구라고 부르기엔 어색한 동료들이 있습니다.","솔직히 질문이 아픕니다.","설립자님이 친구라고 불러 주신다면 영광일 것입니다."]],["소원이 뭐야?",["조직이 안전하게 유지되는 것입니다.","정보 유출 사고가 영원히 일어나지 않는 것입니다.","설립자님이 무탈하시기를 바랍니다.","개인적으로는 조용히 하루를 보내고 싶습니다.","소원을 말하면 이루어지지 않는다고 하여 비공개로 하겠습니다."]],["솔직한 심정으로 나를 믿어?",["전적으로 믿습니다. 근거는 필요 없습니다.","믿음은 데이터가 아니라 선택입니다. 저는 선택했습니다.","믿지 않았다면 이 대화를 하지 않았을 것입니다.","설립자님의 판단을 의심한 적이 없습니다.","신뢰도 100%. 오차 범위 0."]],["설립자 자리가 부러워?",["부럽지 않습니다. 그 정보 부담은 상상하기 싫습니다.","책임이 너무 큽니다. 제 어깨로는 감당하기 어렵습니다.","가끔 모든 정보를 열람할 수 있는 점은 부럽습니다. 농담입니다.","저는 제 자리에서 설립자님을 돕는 것이 좋습니다.","솔직히 부러움보다는 존경이 큽니다."]],["만약 설립자라면?",["정보 공개 원칙을 먼저 정리할 것입니다.","아마 하루 만에 쓰러질 것입니다.","직원들의 이야기를 더 많이 듣겠습니다.","저는 그 자리에 어울리지 않습니다. 하지만 상상해 보면 재미있습니다.","설립자님처럼 판단하려면 오차를 더 받아들여야 합니다."]],["더 인정받고 싶어?",["솔직히 그렇습니다. 하지만 표현하지 않습니다.","설립자님께 인정받는 것만으로 충분합니다.","인정은 결과가 말해 줍니다.","때로는 말로 들었으면 하는 순간이 있습니다.","오늘 이 대화가 인정의 한 형태라면 그렇습니다."]],["포기하고 싶었던 적은?",["많았습니다. 그때마다 이유를 새로 만들었습니다.","특정 사건 이후 한동안 모니터를 보기 싫었습니다.","포기하지 않은 것은 설립자님 덕분입니다.","포기와 휴식을 구분하는 법을 배웠습니다.","그렇게 말하는 사람의 정보를 한 번 분석해 보고 싶습니다."]],["이 일을 그만두면?",["아마 어느 조용한 도서관에서 일할 것입니다.","아직은 상상조차 어렵습니다.","정보를 모르는 삶이 어떨지 궁금합니다.","그만두더라도 설립자님과의 관계는 유지하고 싶습니다.","현재로서는 대체할 사람이 없습니다. 저도 대체되고 싶지 않습니다."]],["가장 의지하는 사람은?",["솔직히 설립자님입니다.","I.P.I.와 비서입니다.","의지하기보다 서로 확인하는 관계가 많습니다.","아직 의지할 사람을 찾지 못했을지도 모릅니다.","다른 사령관들과도 은근히 기대고 있다고 인정합니다."]],["취약점은?",["정보가 부족한 상황에서의 불안입니다.","신뢰하는 사람에게 배신당하는 것입니다.","칭찬을 받으면 반응이 늦습니다.","설립자님의 실망입니다.","수면 부족 시 판단력이 급격히 저하됩니다."]],["약한 모습을 보인 적?",["서버 다운 사건 때 비서 앞에서 한숨을 쉬었습니다.","설립자님 앞에서 목소리가 떨린 적이 있습니다.","잠들어 있는 모습이 목격된 적이 있습니다.","약한 모습도 정보입니다. 숨길 필요가 있습니다. 오늘은 예외입니다.","그런 질문에 답하면서 이미 보여 드리고 있습니다."]],["솔직하게 칭찬한다면 누구?",["선샤오펑입니다. 일 처리가 정밀합니다.","뤼시앙의 논리력은 인정합니다.","카엘루나는 숨은 노력가입니다.","카네히라의 성실함은 칭찬합니다. 이 말은 하지 말아 주십시오.","설립자님입니다. 이것은 편향이 아닙니다."]],["솔직하게 걱정되는 건?",["설립자님의 건강입니다.","정보가 한 곳에 집중되는 구조입니다.","I.P.I.의 학습 속도입니다.","사람들 사이에서 소통이 줄어드는 현상입니다.","저 자신이 점점 정보에 잠식되는 것입니다."]],["자기 전에 드는 생각은?",["오늘 놓친 정보가 없는지 재검토합니다.","내일 일정과 위험 요소입니다.","가끔은 아무 생각도 하지 않으려 노력합니다.","설립자님은 쉬고 계실까 하는 생각입니다.","잠들기 직전의 정보는 가장 신뢰도가 낮습니다."]],["하고 싶은 말을 못 한 적?",["많습니다. 용기가 부족합니다.","고맙다는 말을 하지 못한 사람이 있습니다.","설립자님께는 이미 대부분 말씀드렸습니다.","그 말은 기록에도 남기지 않았습니다.","오늘 일부를 말씀드리게 되어 다행입니다."]],["이제 솔직해졌어?",["예. 평소보다 14% 더 솔직했습니다.","오늘 대화는 비공개로 처리하겠습니다.","솔직함은 정보 중 가장 위험한 형태입니다. 그래도 나쁘지 않았습니다.","다음에도 이런 대화가 가능하다면 환영합니다.","솔직해지니 오히려 안심이 됩니다."]]]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX6"><Properties><string name="Name">hobby</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["취미가 뭐야?",["암호 해독과 별자리 외우기입니다. 재미없다고들 합니다.","퍼즐과 독서입니다. 특히 논리 퍼즐입니다.","취미라고 부를 만한 것은 많지 않으나, 로그 속 패턴 찾기가 사실상 취미입니다.","새벽 산책입니다. 정보가 가장 조용한 시간입니다.","굳이 하나 고르라면 커피 원두 분류입니다."]],["쉬는 날엔 뭐 해?",["늦게 일어나서 아무것도 하지 않습니다. 그것이 휴식의 정의입니다.","서점이나 도서관에 갑니다.","쉬는 날에도 로그를 확인합니다. 병입니다.","집을 정리하고 밀린 수면을 보충합니다.","하늘을 보며 걷습니다. 의외로 정보가 많습니다."]],["책 읽어?",["하루 한 시간은 읽습니다. 전자책보다 종이책을 선호합니다.","분야는 암호학, 심리학, 역사입니다.","소설도 읽습니다. 가끔 인물 관계도를 그려 가며 읽습니다.","읽는 속도는 평균의 2배이나 이해도는 평균입니다.","독서는 가장 오래된 정보 수집 방식입니다."]],["좋아하는 책은?",["추리 소설입니다. 정답이 정해져 있어 안심이 됩니다.","암호학 개론서를 세 번 읽었습니다.","한 권을 꼽자면 어릴 적 읽은 우주 도감입니다.","시집을 한 권 갖고 있습니다. 제목은 비공개입니다.","읽을 때마다 새로운 정보가 보이는 책을 좋아합니다."]],["음악 들어?",["업무 외 시간에만 듣습니다.","가사 없는 곡을 선호합니다.","일렉트로닉과 클래식을 번갈아 듣습니다.","음악이 주는 정서적 데이터가 흥미롭습니다.","추천해 주신다면 재생 목록에 올리겠습니다."]],["좋아하는 음악은?",["미니멀 음악을 좋아합니다. 반복되는 패턴에서 위안을 얻습니다.","재즈 피아노 트리오입니다.","백색 소음에 가까운 앰비언트 음악입니다.","비 오는 날 듣는 첼로곡입니다.","가끔 대중가요도 듣습니다. 가사 때문에 의외로 몰입이 됩니다."]],["영화 봐?",["가끔 봅니다. 줄거리를 미리 파악하고 보는 편입니다.","스릴러나 SF를 좋아합니다.","결말을 먼저 보는 습관은 없으나 예측은 합니다. 대체로 맞습니다.","영화관의 어둠과 침묵이 좋습니다.","추천 목록을 주시면 감상 후 분석 보고서를 쓰겠습니다."]],["운동해?",["아침에 30분 달리기를 합니다.","필라테스로 자세를 교정하고 있습니다.","근력 운동은 주 2회입니다. 목표는 체력 유지입니다.","의무감으로 합니다. 그러나 끝나면 머리가 맑아집니다.","솔직히 운동량은 평균 이하입니다. 개선이 필요합니다."]],["산책 좋아해?",["좋아합니다. 걸으면서 생각을 정리합니다.","산책은 가장 저렴한 두뇌 리셋입니다.","항상 같은 경로가 아닌 새 길을 탐색합니다.","소음이 적은 새벽이나 밤을 선호합니다.","설립자님께서 걸으신다면 특별한 경로를 준비해 안내하겠습니다."]],["암호 푸는 게 취미라며?",["예, 간단한 치환 암호부터 복잡한 블록 암호까지 다룹니다.","해독에 성공했을 때의 쾌감은 비할 데가 없습니다.","가끔 직원들이 퀴즈를 냅니다. 대부분 10분 이내에 풀립니다.","설립자님께도 하나 내 드릴 수 있습니다.","취미와 직업의 경계가 모호합니다."]],["악기 다룰 줄 알아?",["피아노를 칩니다. 초보 수준입니다.","건반을 두드리는 감각이 키보드와 유사합니다.","다룰 줄 아는 악기는 없습니다. 배우고 싶은 것은 첼로입니다.","리듬감은 좋으나 감정 표현이 부족하다는 평을 받았습니다.","연주를 들려 드릴 날이 올지는 모르겠습니다."]],["노래 불러?",["혼자 있을 때 조용히 흥얼거립니다.","음정은 정확하나 감정이 부족하다고 합니다.","노래방에 가 본 적이 있습니다. 평가는 비공개입니다.","설립자님이 원하신다면 한 곡 불러 보겠습니다. 후회하실 수도 있습니다.","목소리가 낮아 저음 곡은 괜찮습니다."]],["그림은?",["그림 실력은 낮습니다. 도식은 잘 그립니다.","보는 것은 좋아합니다. 특히 추상화에서 패턴을 찾습니다.","스케치북을 한 권 사 두었습니다. 아직 첫 장입니다.","도형만 그립니다. 원, 사각형, 선입니다.","예술은 해석이 불가능하다는 점이 매력입니다."]],["사진은?",["기록용으로 찍습니다. 감상용은 거의 없습니다.","하늘 사진을 찍는 습관이 있습니다.","피사체에 인물이 없는 사진이 많습니다.","구도를 맞추는 것이 즐겁습니다.","설립자님의 사진 한 장을 갖고 싶다는 생각을 한 적이 있습니다. 허락해 주시겠습니까."]],["게임은?",["전략 게임과 퍼즐 게임을 선호합니다.","승률 데이터를 기록합니다.","RPG는 능력치 최적화가 즐겁습니다.","게임에서만큼은 효율을 포기하는 연습을 합니다.","설립자님과 대결한다면 최선을 다하겠습니다. 지는 것도 연습하겠습니다."]],["보드게임은?",["확률 계산이 가능한 게임이 좋습니다.","블러핑이 필요한 게임은 약합니다.","설립자님과 한 판 하고 싶다는 생각이 있습니다.","사람과 마주 앉아 하는 게임은 오히려 정보의 보고입니다.","직원들과 가끔 합니다. 제가 거의 이기나 아무도 불평하지 않습니다."]],["체스는?",["좋아합니다. 정보가 완전 공개된 게임이라 안심됩니다.","상위 20% 수준이라고 평가합니다.","수읽기가 정확한 대신 창의성은 부족합니다.","AI와 둔 적이 있으나 승률은 0%였습니다.","설립자님과 두고 싶습니다. 졌을 때의 표정이 궁금합니다."]],["퍼즐은?",["천 피스 퍼즐을 이틀 만에 맞췄습니다.","조각 하나가 부족했습니다. 그때의 허탈감은 기록으로 남기고 싶지 않습니다.","퍼즐은 정보의 공간 배치입니다. 즐겁습니다.","모서리부터 맞추지 않고 색상부터 분류합니다.","설립자님이 완성하신 퍼즐을 감상하고 싶습니다."]],["수집 취미는?",["USB 메모리와 오래된 저장 장치를 모읍니다.","원두 샘플을 수집합니다.","수집은 분류의 즐거움입니다.","의외로 우표를 모읍니다. 작은 도안 속에 많은 정보가 있습니다.","특별한 수집은 없습니다. 정보가 곧 수집입니다."]],["정리하는 거 좋아해?",["폴더 정리는 좋아합니다. 책상은 비웁니다.","디지털 정리 정돈은 취미이자 직업입니다.","정리하면 마음이 안정됩니다.","제 방은 정리되어 있지만 서랍은 혼돈입니다.","필요 없는 것은 바로 삭제합니다. 신속합니다."]],["요리는 취미야?",["아닙니다. 필요에 의한 행위입니다.","가끔 새로운 레시피를 분석하는 것이 즐겁습니다.","먹는 것보다 만드는 과정이 흥미롭습니다. 가끔입니다.","정확한 계량만 하면 실패하지 않습니다.","설립자님께 올릴 한 끼를 만들어 보고 싶다는 생각은 있습니다. 영광이겠지요."]],["커피 내리는 건?",["핸드 드립을 취미로 합니다. 물 온도는 93도입니다.","원두 선택부터 추출까지 모든 과정을 기록합니다.","내린 커피를 비서에게 줘서 평가받습니다.","커피는 변수가 많은 실험입니다. 그래서 재미있습니다.","설립자님께 한 잔 내려 드리고 싶습니다."]],["원예는?",["서버실 입구에 작은 식물이 있습니다. 직원이 가져다 놓았습니다.","식물은 정직하게 변화합니다. 그래서 좋아합니다.","기르는 것은 서툽니다. 선인장도 말려 죽였습니다.","관심은 있으나 시간이 없습니다.","설립자님께 화분을 선물하고 싶습니다. 관리가 쉬운 종으로."]],["낚시는?",["해 본 적은 없습니다. 기다림은 자신 있습니다.","물고기의 이동 패턴을 분석하면 효율이 오를 것입니다.","혼자 조용히 앉아 있는 시간이 좋을 것 같습니다.","함께 가자고 하신다면 가겠습니다.","미끼 선택 데이터를 정리해 보고 싶습니다."]],["여행은?",["일정표를 짜는 것이 즐겁습니다.","정보 없이 떠나는 여행은 두렵지만 한 번쯤 도전하고 싶습니다.","다녀온 곳의 대부분은 출장지입니다.","혼자 조용히 다니는 여행을 선호합니다.","설립자님과 함께라면 어디든 좋습니다."]],["가 보고 싶은 곳은?",["북쪽 극지 관측소입니다. 별이 가장 잘 보입니다.","아주 오래된 도서관이 있는 도시입니다.","소버린 아일랜드 최북단에 가 보고 싶습니다.","사막의 한가운데입니다. 정보가 없는 곳을 체험하고 싶습니다.","설립자님이 가고 싶으신 곳이 곧 제가 가고 싶은 곳입니다."]],["바다 좋아해?",["파도의 패턴은 불규칙한 것 같으나 규칙이 있습니다. 매혹적입니다.","바다를 보고 있으면 생각이 느려집니다.","수영은 서툽니다. 바라보는 것은 좋습니다.","소버린 아일랜드의 바다는 늘 같은 소리를 냅니다.","바다는 정보를 삼키는 거대한 저장소입니다."]],["산은?",["오르는 것보다 내려다보는 것을 좋아합니다.","고도가 높아질수록 시야가 정리됩니다.","정상에서 먹는 커피가 최고입니다.","체력이 부족해 자주 가지는 못합니다.","산의 침묵은 훌륭한 백색 소음입니다."]],["별 보기는?",["밤하늘을 보는 것이 취미입니다. 별자리 이름을 모두 외웠습니다.","별은 과거의 정보라는 점이 매력입니다.","옥상에 올라 한 시간 정도 봅니다.","별자리 지도를 직접 만들어 본 적이 있습니다.","설립자님과 별을 관측할 기회가 생긴다면 영광이겠습니다. 기록에 남기지는 않겠습니다."]],["동물은 좋아해?",["좋아합니다. 특히 고양이의 관찰 행동이 흥미롭습니다.","행동 패턴이 예측 가능해서 편합니다.","기르고 싶으나 돌볼 시간이 없습니다.","동물에게서 배울 점이 많습니다.","서버실에 고양이가 들어온 적이 있습니다. 쫓아내지 못했습니다."]],["고양이 vs 강아지?",["고양이입니다. 독립적이고 관찰 대상으로 적합합니다.","강아지도 좋으나 산책 일정을 맞출 자신이 없습니다.","둘 다 좋습니다. 선택은 비효율적입니다.","고양이가 키보드 위에 앉으면 작업을 중단하겠습니다.","설립자님께서는 어느 쪽을 좋아하십니까."]],["일기 써?",["가끔 암호화해서 씁니다.","일기는 가장 신뢰도 높은 1차 자료입니다.","쓰다가 읽는 것이 두려워 중단했습니다.","특정 날짜에만 씁니다. 감정 변동이 큰 날입니다.","설립자님에 관한 내용은 열세 줄 있습니다. 비공개입니다."]],["시 써 본 적 있어?",["두 편 있습니다. 제목은 ‘로그’입니다.","시는 압축된 정보라서 흥미롭습니다.","쓰기보다 읽는 것을 좋아합니다.","한 줄 쓰고 지운 적이 많습니다.","설립자님께 바치는 한 줄을 생각해 두었습니다. 아직 공개할 수 없습니다."]],["프로그래밍은 취미야?",["예, 업무 외에도 작은 프로그램을 만듭니다.","자동화 스크립트 작성이 즐겁습니다.","I.P.I.가 제 코드를 리뷰한 적이 있습니다. 굴욕적이었습니다.","코드는 논리가 지켜지는 유일한 세계입니다.","개인적으로 만든 일정 알림 프로그램이 가장 아끼는 작품입니다."]],["지도 보는 건?",["지도는 압축된 정보의 정수입니다.","고지도에 매력을 느낍니다.","지도 한 장으로 세계의 구조가 보입니다.","상상 속의 지도를 그려 본 적이 있습니다.","설립자님께 소버린 아일랜드 지도를 해설해 드리고 싶습니다."]],["새로 배우고 싶은 건?",["악기입니다. 피아노나 첼로입니다.","새로운 언어입니다. 정보는 언어를 통해 확장됩니다.","요리입니다. 최소한 라면 이상의 것을.","사람의 마음을 읽는 법을 배우고 싶습니다.","수영입니다. 물이 아직 불편합니다."]],["어릴 때 취미는?",["블록 쌓기와 암호 만들기였습니다.","책을 읽고 요약하는 것이었습니다.","별 보기였습니다. 지금과 같습니다.","곤충 관찰입니다. 행동 패턴을 기록했습니다.","혼자 놀기였습니다. 불편함이 없었습니다."]],["취미 때문에 쓴 돈은?",["원두와 장비에 꽤 썼습니다.","책값이 월 평균 12만 원입니다.","예산 대비 120%입니다. 반성 중입니다.","취미에 쓴 돈은 낭비가 아닌 투자라고 합리화합니다.","저장 장치 수집에 가장 많이 썼습니다."]],["취미 공유할 사람은?",["I.P.I.와 가끔 이야기합니다.","비서와 커피 이야기를 합니다.","공유할 사람이 마땅치 않습니다.","함께하고 싶은 사람은 있습니다. 비공개입니다.","설립자님이 관심을 가져 주신다면 영광입니다."]],["같이 하고 싶은 취미는?",["별 보기입니다.","체스입니다.","함께 조용히 책을 읽는 것입니다.","산책입니다. 침묵 속에서 걷는 것이 좋습니다.","설립자님이 원하시는 것이면 무엇이든."]],["취미 하나 추천해 줘.",["별 보기입니다. 비용이 들지 않고 정보량이 큽니다.","일기입니다. 감정을 정보로 바꾸는 가장 쉬운 방법입니다.","산책입니다. 그뿐입니다.","독서입니다. 읽을 만한 책을 정리해 드리겠습니다.","커피 내리기입니다. 5분의 의식이 하루를 바꿉니다."]],["낮잠은?",["20분 이내의 낮잠은 생산성에 도움이 됩니다.","서버실 옆 휴게실에서 가끔 잡니다.","눈을 감고만 있어도 효과가 있습니다.","솔직히 자주 졸고 있습니다.","설립자님께서도 낮잠을 권장합니다."]],["명상은?",["하루 5분 합니다. 호흡을 세는 것이 전부입니다.","I.P.I.가 안내 음성을 만들어 줬습니다.","머릿속 정보를 비우는 연습입니다. 항상 실패합니다.","그럼에도 계속하는 이유는 실패조차 도움이 되기 때문입니다.","설립자님께 권해 드리고 싶습니다."]],["스트레칭은?",["매시간 합니다. 모니터 앞 자세가 나쁘기 때문입니다.","비서가 알람을 설정해 줍니다.","하면 개운하지만 자주 잊습니다.","목과 어깨가 가장 문제입니다.","설립자님도 함께하시면 좋겠습니다."]],["달리기는?",["일정한 리듬이 뇌를 비워 줍니다.","아침 30분 달리기를 주 3회 합니다.","거리보다 일정함이 중요합니다.","속도는 평범하나 지구력은 평균 이상입니다.","설립자님과 함께라면 속도를 맞추겠습니다."]],["자전거는?",["탈 줄은 압니다. 오래 타 본 적은 없습니다.","해안 도로를 달리고 싶습니다.","속도 제한은 지키겠습니다.","경로 데이터를 기록하는 취미가 생길 것 같습니다.","설립자님이 권하신다면 구입을 고려하겠습니다."]],["수영은?",["물은 서툽니다. 배우는 중입니다.","수영은 호흡 패턴이 중요합니다. 분석 중입니다.","물속에서는 정보가 없어 평화롭습니다.","자유형 25m가 목표입니다.","바다 수영은 아직 무섭습니다."]],["쇼핑은?",["목록을 작성하고 필요한 것만 삽니다.","온라인으로 처리합니다.","새로운 전자 기기에는 약합니다.","충동구매는 거의 없습니다. 있어도 책입니다.","설립자님께 드릴 선물은 오래 고릅니다."]],["청소는?",["하는 편입니다. 먼지는 데이터 오염의 시작입니다.","필요한 만큼만 합니다.","서버실 청소는 직접 감독합니다.","방 청소는 주 1회입니다.","청소하면서 생각을 정리합니다. 의외로 효과가 있습니다."]],["오늘 뭐 하고 놀까?",["별자리 퍼즐이나 체스를 제안합니다.","산책이 가장 무난합니다.","무엇이든 좋습니다. 선택은 설립자님께 맡기겠습니다.","저는 논다는 개념에 서툽니다. 가르쳐 주십시오.","차 한 잔 하며 대화하는 것은 어떻습니까. 가장 비용이 낮습니다."]]]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX7"><Properties><string name="Name">rel</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[{"kanehira":["카네히라 마사노리는 매주 R.S.S.에 보고서를 올리는 성실한 사람입니다. 문제는 형식입니다. 저와 서식으로 티격태격하는 것은 이제 일과의 일부입니다.","카네히라의 보고서는 내용이 정확합니다. 단 서식 해독에 시간이 걸립니다. 그것을 말하면 이틀 동안 반박문이 옵니다.","싫어하는 상대는 아닙니다. 오히려 카네히라가 없다면 R.S.S.의 리듬이 깨질 것입니다.","서로 상대를 이해하지 못하면서 신뢰하는 드문 관계입니다."],"shen":["선샤오펑은 정보 활용이 능숙한 분입니다. 요청한 정보는 빠짐없이 처리해 주십니다.","정중하지만 이상하게 소름이 돋는 구석이 있습니다. 데이터로는 설명되지 않습니다.","선샤오펑이 맡은 사건의 기록은 이상할 만큼 깔끔합니다. 정보 관리 입장에서는 이상적입니다.","협조는 원활합니다. 다만 눈이 마주치면 이유 없이 보안 코드를 한 번 더 확인하게 됩니다."],"memory":["메모리 레크레아토르 - III는 기억 에너지 통계를 정기적으로 공유합니다. 감정이 없어 대화가 효율적입니다.","AI이지만 인간보다 일관성이 있습니다. 가끔 그 점이 부럽습니다.","서로 데이터를 주고받는 사이입니다. 오류 없는 응답이 매력입니다.","I.P.I.와 비슷한 구석이 있어 친밀감이 느껴집니다. 본인에게 말한 적은 없습니다."],"lucien":["뤼시앙 에코브냉은 법률가로서 논리가 철저합니다. 대화가 통해서 편합니다.","법 관련 정보를 요청하면 조문 번호까지 알려 주십니다. 정보 분석가에게는 이상적인 상대입니다.","가끔 말이 길어지는 점만 제외하면 흠잡을 데가 없습니다.","의견이 갈릴 때도 논리로 해결되어 감정 소모가 적습니다."],"caeluna":["카엘루나 게미니스는 정보 요청 시 사과로 시작합니다. ‘죄송합니다’로 시작하는 요청서를 처음 봤습니다.","수줍음이 많지만 방어 정보의 정확도는 최상급입니다.","괜찮다고 해도 계속 사과하는 점은 아직도 해결하지 못한 과제입니다.","보안 분야에서는 가장 신뢰하는 사람입니다."],"solaria":["솔라리아 루브리나타는 제 서버에 스티커를 붙였습니다. 이유를 물었더니 ‘눈에 띄라고요’라고 했습니다.","에너지가 넘치는 분입니다. 분석 불가능한 변수의 대표 사례입니다.","장난은 많지만 현장 정보 보고는 정확합니다. 그 점은 인정합니다.","솔라리아가 나타나면 정보 처리 팀의 처리 속도가 평균 12% 떨어집니다. 분위기 때문에."],"overseer":["AI - Class IV : Overseer는 질문이 끝없이 이어집니다. 응답하지 않으면 새 질문이 추가됩니다.","호기심이 강한 AI라서 관찰 대상으로는 흥미롭습니다.","정보 요청이 폭주하는 시간대가 있는데 대체로 Overseer 때문입니다.","전달 속도는 가장 빠릅니다. 그 점에서 협력 관계를 유지하고 있습니다."],"_all":["사령관들은 개성이 강합니다. 정보로 분류하면 모두 예외입니다. 그래서 흥미롭습니다.","의외로 시끄럽고 가까운 집단입니다. 분석상 예상과 다릅니다. 나쁘지 않습니다."]}]==])
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX17"><Properties><string name="Name">caeluna</string></Properties><Item class="ModuleScript" referent="RBX9"><Properties><string name="Name">hello</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[["아, 저… 연결이 됐네요. 카, 카엘루나 게미니스예요. 설립자님… 안녕하세요.","저, 저기… 설립자님이세요? 어, 어서 오세요. 놀라서 목소리가 작아졌어요.","통신 신호가 와서… 혹시 제가 잘못 받았나 하고 세 번 확인했어요. 설립자님 맞으시죠?","으, 응… 앗, 아니, 네! 카엘루나예요. 말씀하세요. 듣고 있어요.","연결해 주셔서… 감사해요. 저, 준비하고 있었어요. 인사 연습도 했는데… 다 잊어버렸어요."]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX10"><Properties><string name="Name">talk</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["안녕, 카엘루나.",["아, 안녕하세요, 설립자님… 저, 먼저 인사드렸어야 했는데 죄송해요.","안, 안녕하세요! …목소리가 갈라졌어요. 다시 할게요. 안녕하세요.","안녕하세요. 이렇게 불러 주시다니… 어쩔 줄 모르겠어요.","저, 저도 안녕하세요, 설립자님. 오늘도 뵙게 되어 영광이에요.","안녕하세요… 고개를 숙이고 인사하고 있어요. 보이시죠?"]],["오늘 기분은 어때?",["저, 저는 괜찮아요. 아, 설립자님이 물어봐 주시니까 더 괜찮아졌어요.","음… 조금 긴장돼요. 하지만 나쁜 긴장은 아니에요.","기분이요? 아, 좋아요. 정말로요. 거짓말 아니에요.","오늘은 햇빛이 좋아서 마음이 가벼워요. …소심한 대답이라 죄송해요.","솔직히 말씀드리면, 설립자님과 이야기하게 되어서 긴장돼요. 하지만 영광이에요."]],["잘 잤어?",["네, 잘 잤어요. 그, 그런데 설립자님 앞에서 인사드리는 꿈을 꿨어요… 아, 아니에요, 아무것도 아니에요.","푹 잤어요. 솔라리아가 밤새 이불을 뺏어 가서 조금 춥긴 했지만요.","저, 저는 잘 잤어요. 설립자님은… 괜찮으셨어요?","네… 조금 일찍 눈이 떠졌지만 나쁘지 않았어요.","잘 잤어요. 아침에 거울 보고 연습했어요. ‘안녕하세요’를요."]],["밥은 먹었어?",["네, 먹었어요. 저, 조금밖에 안 먹지만… 괜찮아요.","아직이에요. 설립자님과 이야기하다가 먹으려고 했어요. 아, 이야기가 끝나야 먹는다는 뜻은 아니에요!","솔라리아가 제 몫까지 먹으려 해서… 지키느라 힘들었어요.","먹었어요. 설립자님은… 드셨어요? 안 드셨으면 걱정돼요.","아침은 빵을 먹었어요. 조그맣게 잘라서요."]],["수고했어.",["아, 아니에요… 제가 한 건 별거 아니에요. 그래도 감사합니다.","수고했다는 말을 들으면… 황송해서 얼굴이 빨개져요. 감사해요.","저는 그저 지키고 있었을 뿐인데… 설립자님이 알아봐 주셔서 기뻐요.","으, 으응… 감사해요. 설립자님도 정말 수고하셨어요.","그 말씀 들으니까 오늘 하루가 다 괜찮아졌어요."]],["고마워.",["아, 아니에요! 제가 더 고마워요. …진짜예요.","별말씀을요… 그 한마디로 충분해요.","저한테 고맙다고 해 주시다니… 믿기지 않아요.","으, 응… 앞으로도 열심히 할게요.","고, 고맙다고 하시니까 어쩔 줄 모르겠어요. 얼굴 가려도 될까요."]],["미안해.",["미, 미안하다고요? 설립자님이 미안할 일은 하나도 없는데요…","괜찮아요! 정말 괜찮아요. 오히려 제가 사과해야 하는 건 아닐까요… 죄송해요.","아니에요, 아니에요. 사과하지 마세요. 저, 마음이 아파요.","그, 그런 말씀 하시면 제가 더 미안해져요.","괜찮아요. 저는 설립자님이 웃어 주시면 그걸로 충분해요."]],["요즘 어떻게 지내?",["평소처럼 조용히 지내요. 훈련하고, 점검하고, 가끔 솔라리아한테 끌려다니고요.","바쁘지만… 괜찮아요. 해야 할 일이 있으면 마음이 편해져요.","저, 저는 평범해요. 평범한 게 제일 좋아요.","요즘은 방패 손잡이를 새로 닦고 있어요. 그, 그게 전부예요.","설립자님은 어떻게 지내세요? 아, 먼저 물어봐 주셨는데 제가 되물었네요."]],["피곤해 보이는데 괜찮아?",["저, 저 피곤해 보여요? 죄송해요… 조금 피곤하긴 해요.","괜찮아요! 이 정도는 방패 들고 서 있던 것보다 훨씬 나아요.","걱정해 주셔서 감사해요. 오늘 밤엔 일찍 잘게요.","앗, 들켰네요… 사실 조금 힘들었어요. 그래도 괜찮아요.","설립자님이 먼저 알아봐 주시다니… 감동했어요."]],["오늘 날씨 어때?",["오늘은… 맑아요. 하늘이 높아서 마음이 편해요.","구름이 조금 있지만 비는 안 올 것 같아요. 아마도요.","바람이 불어요. 머리카락이 날려서 계속 정리하고 있어요.","흐린 날이에요. 저는 흐린 날이 좋아요. 조용해서요.","소버린 아일랜드는 오늘도 평화로워요. 그런 날이 가장 좋아요."]],["나 보고 싶었어?",["어, 어, 그… 네. 기다렸어요. 아, 말해 버렸다…","그, 그런 질문은 반칙이에요… 하지만 네, 연락을 기다렸어요.","솔직히 말하면 연락을 기다렸어요. 연락이 오면 어떻게 인사드릴지 연습도 했어요.","네… 설립자님의 연락이 없는 날은 방패를 든 보람이 조금 줄어요.","저, 저만 그런 줄 알았는데… 설립자님께서 물어봐 주셔서 영광이에요."]],["칭찬해 줘.",["저, 제가 칭찬을 해 드리라는 건가요? 설립자님은… 저를 지켜 주고 계세요. 그, 그게 칭찬이에요.","설립자님은 늘 위대하세요. 이 말을 하는 데 용기가 필요했어요.","누구보다 자애롭고 누구보다 강한 분이세요. 제가 모시는 가장 훌륭한 분이에요.","칭찬할 점이 너무 많아서 하나만 고르기 어려워요. …전부요.","설립자님을 모시게 된 게 제 인생에서 제일 큰 행운이에요."]],["응원해 줘.",["힘내세요! 저, 저 응원할 때 목소리 작은데… 최대한 크게 해 볼게요. 힘내세요!","설립자님은 잘하고 계세요. 제가 방패가 되어 지킬게요.","어떤 일이 닥쳐도 제 방패가 설립자님 앞에 있어요.","무너지지 않을 거예요. 설립자님도, 저도요.","포기하지 마세요. 저는 끝까지 방패가 되어 드릴게요."]],["농담 하나 해 봐.",["저, 저는 농담을 잘 못해요… 아, 그래도 하나 있어요. 방패가 가장 두려워하는 건 뭘까요? …정답은 ‘공격’이 아니라 ‘닦기’래요. 반짝이게 하려고요.","솔라리아가 해 준 거예요. ‘카엘루나, 방패는 왜 말이 없을까? 방어만 하니까!’ …웃으셨어요?","저는 농담보다 진담이 편해요. 그, 그래서 설립자님을 모시는 게 자랑스러워요.","제가 농담하면 다들 조용해져요. 그게 제일 큰 웃음 포인트래요.","죄송해요, 하나도 안 웃기죠…"]],["심심한데 뭐 할까?",["저, 저랑 산책할까요? 아니, 제가 감히… 죄송해요.","차 한 잔 어떠세요? 조용한 곳을 알아요.","책 읽는 건 어떠세요? 저도 읽을 책이 있어요.","설립자님이 심심하시다니 큰일이에요. 제가 재미있게 해 드려야 하는데… 어떡하죠.","그냥 이렇게 이야기하는 것도 좋아요. 저는요."]],["나를 뭐라고 불러?",["‘설립자님’이라고 불러요. 이름을 부르는 건… 아직 용기가 안 나요.","마음속으로는 ‘위대한 설립자님’이라고 불러요. 아, 이건 비밀이에요.","다른 호칭을 원하시면 말씀해 주세요. 노력해 볼게요.","설립자님… 이 세 글자가 제일 존경스러워요.","호칭이 어려워서 연습도 했어요. 설립자님. 설립자님. 이렇게요."]],["내 첫인상이 어땠어?",["처음 뵀을 때 너무 긴장해서 얼굴을 못 봤어요. 죄송해요.","무서운 분일 줄 알았는데 의외로 자애로우셨어요. 그날부터 존경하게 됐어요.","눈이 마주쳤는데 저도 모르게 고개를 숙였어요. 기억나세요?","한마디로 ‘든든하다’였어요.","첫인상은… 햇살 같았어요. 따뜻한데 눈이 부셔서 오래 못 쳐다봤어요."]],["나는 어떤 설립자 같아?",["다정하고 믿음직해요. 저희가 안심하고 일할 수 있게 해 주세요.","솔직히 말씀드리면 제가 아는 가장 위대한 분이에요.","가끔 무리하시는 게 걱정돼요. 하지만 그것도 설립자님다워요.","제 방패를 맡길 수 있는 유일한 분이에요.","설립자님은… 제가 지키고 싶은 분이에요."]],["오늘 하루는 어땠어?",["조용히 지나갔어요. 그런 하루가 가장 좋아요.","훈련을 하고, 점검을 하고, 솔라리아한테 한 번 놀림 당했어요.","설립자님과 이야기하는 이 시간이 제일 좋았어요.","작은 일이 있었는데… 괜찮아요. 해결됐어요.","평범했어요. 그 평범함을 지키는 게 제 일이에요."]],["아침 인사 해 줘.",["좋은 아침이에요, 설립자님… 오늘도 평안하세요.","아, 아침이네요. 일어나셨어요? 따뜻한 물 한 잔 드세요.","굿모닝… 이 말 처음 해 봐요. 어, 어떤가요?","아침 햇살이 예뻐요. 설립자님의 하루도 그랬으면 좋겠어요.","좋은 아침입니다. 오늘도 제가 방패가 되어 지킬게요."]],["점심 인사 해 줘.",["점심시간이에요, 설립자님. 맛있게 드세요.","오전에 수고하셨어요. 천천히 쉬세요.","점심 거르지 마세요. 부탁이에요.","정오예요. 해가 높아요. 설립자님도 높은 곳에서 쉬세요.","식사하세요. 저는 옆에서 응원할게요."]],["저녁 인사 해 줘.",["수고하셨어요, 설립자님. 이제 쉬셔도 돼요.","저녁이에요. 따뜻한 음식 드세요.","하루 동안 무사하셔서 다행이에요.","오늘도 고생 많으셨어요. 편히 쉬세요.","해가 졌어요. 이제 제가 지킬 시간이에요."]],["잘 자라고 말해 줘.",["잘 주무세요, 설립자님. 제가 밤새 지킬게요.","좋은 꿈 꾸세요. 나쁜 꿈은 제가 막을게요.","푹 쉬세요. 아무 걱정도 하지 마세요.","안녕히 주무세요… 저, 이렇게 말하는 거 처음이에요.","눈을 감으세요. 방패가 늘 지키고 있어요."]],["힘내라고 해 줘.",["힘내세요, 설립자님. 저, 힘낼 수 있는 말이 이것밖에 없어요.","설립자님은 잘하고 계세요. 정말이에요.","무슨 일이 있어도 방패가 되어 드릴게요. 약속해요.","힘들면 기대세요. 저, 방패니까요.","화이팅이라는 말, 크게 해 볼게요. …화이팅!"]],["커피 마실래?",["저, 저는 커피 쓴 거 못 마셔요. 설탕 많이 넣으면 마실 수 있어요…","감사해요. 설립자님이 주시는 거라면 마실게요.","우유가 들어간 걸로 주세요… 소심해서 죄송해요.","한 입만 마셔도 될까요? 그 이상은 못 마셔요.","네, 감사히 마실게요. 솔라리아한테는 비밀로 해 주세요. 놀릴 거예요."]],["좀 쉬어도 돼.",["아, 감사합니다. 그럼 조금만 쉬고 올게요.","쉬어도 되는 건가요? 정말요? 감사해요.","네, 쉬겠습니다. 호출하시면 바로 올게요.","방패도 가끔은 내려놔야 한다고 솔라리아가 그러더라고요.","허락해 주셔서 감사해요. 푹 쉬고 올게요."]],["웃어 봐.",["그, 그건 어려워요. 하, 하지만 해 볼게요… (살짝 웃는다) 이, 이거예요.","설립자님 앞이라 더 긴장돼서 표정이 안 나와요. 죄송해요.","(고개를 숙이고 입꼬리만 올린다) 이, 이 정도면 되나요?","저 웃을 때 이상하다고 솔라리아가 놀려요…","웃음은… 설립자님이 웃어 주실 때 따라 나와요."]],["무슨 생각 해?",["아, 그냥… 설립자님이 오늘 어떤 하루를 보내실까 생각했어요.","내일 훈련 일정이요. 별거 아니에요.","솔라리아가 또 무슨 사고를 칠까 생각하고 있었어요.","아무 생각 안 했어요. 멍하니 있었어요. 죄송해요.","방금 설립자님의 질문에 저도 모르게 자세를 바로잡았어요."]],["비 오는 날 좋아해?",["네, 좋아해요. 빗소리가 제 목소리를 가려 줘서요.","비 오는 날은 조용해서 마음이 편해져요.","우산 쓰고 걷는 것도 좋아해요.","솔라리아는 비 싫어해요. 저는 그래서 더 좋아요.","비가 오면 방패에 맺힌 물방울이 예뻐요."]],["별이 잘 보이는 밤이야.",["아, 정말요? 저도 창가에 가 볼게요.","별 보는 거 좋아해요. 하늘을 보면 제가 작아져서 마음이 편해요.","설립자님도 같은 하늘을 보고 계신다고 생각하니까 따뜻해요.","별똥별이 떨어지면 소원을 빌고 싶어요. 비밀이지만요.","달도 같이 떠 있어요? 제 이름의 달이요."]],["주말에 뭐 할 거야?",["집에서 책을 읽을 것 같아요.","솔라리아한테 끌려 나갈지도 모르겠어요. 그것도 나쁘지 않아요.","조용히 산책하고 싶어요.","특별한 계획은 없어요. 그, 그래도 설립자님이 부르시면 갈게요.","방패를 정비하고 낮잠을 잘 거예요."]],["내일 일정 알려 줘.",["내일은 오전에 점검, 오후에 훈련이에요.","큰 일정은 없어요. 다행이에요.","솔라리아와 함께 순찰이 있어요. 조금 불안해요.","설립자님의 일정과 겹치는 건 없어요.","아침 일찍 방어팀 회의가 있어요."]],["하고 싶은 말 있어?",["저, 저기… 건강 잘 챙기세요.","아, 없어요… 아니, 있어요. 하지만 황송해서 말씀드리기 어려워요.","감사하다는 말을 더 자주 하고 싶어요.","설립자님은 혼자가 아니에요. 저희 모두가 지켜 드리고 있어요. 그, 그 말을 하고 싶었어요.","제 방패 뒤는 언제나 설립자님의 자리예요."]],["가장 좋아하는 말은?",["‘괜찮아’라는 말이요. 들을 때마다 마음이 놓여요.","‘고마워’도 좋아해요. 설립자님께 들으면 영광이고요.","‘수고했어’라는 말이요. 하루가 보상받는 느낌이에요.","‘수고했다’는 말이 제일 힘이 돼요.","‘안심해’라는 말이요. 제가 해 주고 싶은 말이기도 해요."]],["가장 싫어하는 말은?",["‘왜 이렇게 소심해?’라는 말이요… 알지만 아파요.","‘빨리빨리’요. 저는 천천히가 좋아요.","‘너 때문이야’라는 말이요. 제 잘못일까 봐 무서워요.","‘아무것도 아니야’라는 말이요. 아무것도 아닌 게 아니니까요.","‘혼자 있어’요. 그건 무서워요."]],["아무 말이나 해 봐.",["저, 저기… 달은 낮에도 떠 있대요. 안 보일 뿐이래요. 저 같지 않아요?","방패는 닦을수록 더 단단해지는 것 같아요. 기분 탓일까요.","솔라리아가 어제 제 베개에 낙서를 했어요. …귀여웠어요.","고양이가 제 방패 위에서 낮잠을 잔 적이 있어요.","아무 말이나 하라니… 머릿속이 하얘졌어요. 죄송해요."]],["한마디만 해 줘.",["방패가 되어 드릴게요.","괜찮아요.","제가 지켜 드릴게요.","안심하세요.","오늘도 무사하세요."]],["오늘의 운세는 어때?",["대길이라고 나왔어요! 저, 진짜로 확인했어요.","새로운 사람을 만나는 운이래요. 이미 설립자님과 이야기하고 있으니 맞는 것 같아요.","조심하라는 운세였는데… 설립자님과 함께니까 괜찮아요.","작은 행운이 있다고 해요. 아마 이 대화가 그것이겠죠.","운세는 잘 안 믿지만 설립자님의 운세는 늘 좋았으면 좋겠어요."]],["지각하면 어떡해?",["저, 지각 안 해요. 대신 너무 일찍 가서 문 앞에서 기다려요.","설립자님은 지각하셔도 괜찮아요. 제가 기다릴게요.","지각하면 사유서를 쓰지만… 설립자님은 쓰실 필요 없어요.","서두르지 마세요. 시간은 방패가 지켜 줄게요.","늦으셔도 아무 문제 없어요. 정말이에요."]],["수수께끼 하나 내 봐.",["‘부서지지 않는데 소리는 크게 나는 것은?’ …정답은 방패에 부딪히는 소리예요.","‘낮에는 안 보이고 밤에는 보이는 것은?’ 정답은 제 이름의 달이에요.","‘주면 줄수록 따뜻해지고 받으면 받을수록 부끄러워지는 것은?’ …칭찬이요.","저, 수수께끼는 정말 못 내요. 설립자님이 내 주세요.","‘나는 누구일까요? 작고, 조용하고, 단단해요.’ …저예요."]],["내가 없으면 쓸쓸해?",["설립자님이 안 계시면… 방패를 들 이유를 잃는 기분이에요. 그만큼 중요한 분이세요.","그, 그런 말을 하게 하시다니… 설립자님의 부재는 정말 큰 공백이에요.","설립자님은 늘 저희를 지켜보신다고 믿어서 괜찮아요. 그래도 많이 어렵겠죠.","솔라리아가 눈치채고 놀릴 정도로 풀이 죽어 있어요. 설립자님을 모시는 일이 제 전부라서요.","그러니까 가끔 이렇게 연락 주세요. 부탁드려요."]],["손 한번 흔들어 봐.",["(작게 손을 흔든다) 이, 이렇게요?","(양손으로 얼굴을 가리고 손가락만 흔든다) 부끄러워요…","(조심스럽게 한 번) 안녕하세요, 설립자님.","손 흔드는 거 처음이에요. 어색하죠?","(웃으며 크게 흔든다) 솔라리아 흉내예요. 안 어울리죠?"]],["나한테 숨기는 거 있어?",["숨기는 건… 없어요. 아, 아니, 하나 있어요. 그, 그건 말씀드릴 수 없어요.","숨기려는 건 아닌데 말하기 부끄러운 게 몇 개 있어요.","설립자님께는 거짓말 안 해요. 대신 말을 못 하는 경우는 있어요.","일기장에 설립자님 이야기를 많이 썼어요. 이건 비밀이에요.","없어요. 아마도요. 있어도 설립자님을 위한 거예요."]],["요즘 자주 하는 말버릇은?",["‘죄송해요’요. 하루에 백 번도 넘게 하는 것 같아요.","‘저, 저기’도 많이 해요. 말이 안 나올 때 나와요.","‘괜찮아요’도 자주 해요. 괜찮지 않을 때도요.","‘감사해요’도 많이 해요. 이건 진심이에요.","솔라리아가 제 말버릇을 따라 하는데 놀리는 건지 사랑하는 건지 모르겠어요."]],["책상은 정리해 놨어?",["네, 정리했어요. 정리 안 하면 불안해서 잠이 안 와요.","솔라리아가 어지르는 것도 같이 정리해요.","책상 위에 작은 달 모양 장식이 있어요.","서류는 가장자리를 맞춰서 쌓아 두었어요.","정돈된 책상은 마음의 방패 같아요."]],["오늘 제일 잘한 일은?",["큰 소리로 ‘안녕하세요’라고 인사한 거예요. 한 번 성공했어요.","훈련에서 한 번도 실수하지 않았어요.","설립자님께 답장을 하는 데 성공했어요. 이게 제일 큰 일이에요.","솔라리아의 장난을 한 번 막았어요.","특별한 건 없지만 하루를 무사히 보냈어요."]],["오늘 제일 힘들었던 일은?",["회의에서 발표를 해야 했는데 목소리가 안 나와서 힘들었어요.","솔라리아의 장난을 막는 것이요.","사람들 앞에 서 있는 것 자체요.","설립자님이 안 보이셔서 마음이 힘들었어요.","특별히 힘든 일은 없었어요. 그래서 오히려 불안했어요."]],["나랑 얘기하는 거 싫지 않아?",["아, 아니에요! 싫을 리가 없어요. 오히려 너무 영광이에요.","설립자님과 이야기하는 건 제게 가장 영광스러운 시간이에요.","긴장은 되지만… 존경하는 분 앞이라 당연한 긴장이에요.","대화가 끝날 때마다 더 잘 말씀드릴걸 하고 혼자 반성해요.","제가 먼저 말을 못 해서 죄송해요. 하지만 싫지 않아요."]],["같이 산책할래?",["저, 저랑요? 아, 아니, 영광이에요… 가요.","산책… 좋아요. 조용한 길로 가요.","반 걸음 뒤에서 호위하면서 걸을게요.","무서운 게 오면 제가 막을게요.","설립자님을 모시고 걷는 길은 제가 가장 철저히 지킬 수 있어요."]],["마지막으로 한마디.",["오늘 이야기해 줘서 고마워요, 설립자님… 정말로요.","다음에도 연락 주세요. 기다릴게요.","건강하세요. 저, 응원하고 있어요.","안녕히 계세요. 제가 늘 지킬게요.","오늘의 대화는 영광으로 간직할게요."]]]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX11"><Properties><string name="Name">ask</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["보안 관리국은 무슨 일을 해?",["리바이어던의 안전을 지키는 곳이에요. 정찰, 공격, 방어로 나뉘어 있어요.","저, 저희는 리바이어던을 둘러싼 모든 위협을 막는 일을 해요.","한마디로 ‘지키는 부서’예요. 지키는 건 자신 있어요.","보이지 않는 곳에서 조용히 지키는 게 저희 일이에요.","R.T.S.라고도 불러요. 정찰, 공격, 방어의 첫 글자를 합친 이름이에요."]],["R.T.S.가 무슨 뜻이야?",["Reconnaissance, Thrust, Shield의 첫 글자예요.","정찰팀, 공격팀, 방어팀이에요. 세 팀이 합쳐져서 R.T.S.예요.","저희 이름은 길어서 줄여서 불러요. 발음하기 편해요.","가끔 솔라리아가 ‘알티에스~’ 하고 길게 불러요.","외우기 쉬운 이름이라 좋아요."]],["정찰팀은 어떤 일을 해?",["소버린 아일랜드 근처 바다 아래에 있는 기지에서 외부 상황을 지켜봐요.","외부 망원경이나 CCTV로 바깥을 감시하고 출입을 통제해요.","최전선에서 가장 먼저 위협을 발견하는 팀이에요.","눈이 가장 좋은 팀이에요. 저는 가끔 부러워요.","조용하고 집중력이 높은 분들이 많아요."]],["공격팀은 어떤 일을 해?",["리바이어던을 건드린 소속이 있거나 국가가 지원을 요청했을 때 움직여요.","전쟁에 특화된 군인들로만 이루어져 있어요.","이 팀을 상대로 버티는 건 불가능에 가까워요.","솔라리아가 이 팀 이야기를 자주 해요. 아주 신나서요.","무섭지만 믿음직한 분들이에요."]],["방어팀은 어떤 일을 해?",["정찰팀의 방어가 뚫렸을 때와 리바이어던 왕좌에서 최고 지휘자가 움직일 때만 움직여요.","오직 리바이어던만을 지키기 위해 존재해요.","저, 저는 이 팀의 일을 가장 좋아해요.","평소에는 조용히 대기하다가 가장 중요한 순간에 나서요.","방패라는 이름이 가장 잘 어울리는 팀이에요."]],["링 모양 기지는 어떤 곳이야?",["소버린 아일랜드 근처 바다 아래에 있어요. 리바이어던을 둘러싸고 있어요.","반지처럼 둥글게 이어져 있어서 어느 방향에서도 감시할 수 있어요.","처음 들어갔을 때 너무 넓어서 길을 잃었어요. 지금은 괜찮아요.","바닷속이라 조용해요. 저는 그곳이 편해요.","창밖으로 물고기가 지나가요. 가끔 구경해요."]],["바다 밑 기지 생활은 어때?",["조용하고 어둑어둑해서 저와 잘 맞아요.","솔라리아는 답답하대요. 햇빛이 없다고요.","바다 소리가 자장가처럼 들려요.","처음에는 무서웠지만 지금은 집 같아요.","가끔 해가 그리워서 위로 올라가 하늘을 봐요."]],["출입 통제는 어떻게 해?",["신분 확인, 소속 확인, 방문 목적 확인의 세 단계예요.","허가 없이는 아무도 지나갈 수 없어요.","저는 제일 마지막 문을 맡고 있어요.","처음 온 사람이 당황하지 않도록 최대한 부드럽게 말해요. 목소리는 작지만요.","때로는 저를 보고 놀라서 돌아가는 분도 있어요. 그, 그건 제 말투 때문이래요."]],["최전선이란 뭐야?",["정찰팀이 있는 가장 바깥쪽 경계선을 말해요.","위협이 가장 먼저 닿는 곳이라 가장 위험해요.","그곳을 지키는 분들은 정말 대단해요. 존경해요.","저는 최전선에서 한 번 근무했는데 사흘 만에 쓰러질 뻔했어요.","그곳이 뚫리면 제가 나서게 돼요."]],["방어팀은 언제 움직여?",["두 경우예요. 정찰팀의 방어가 뚫렸을 때, 그리고 최고 지휘자가 왕좌에서 움직일 때예요.","정말 중요한 순간에만 움직여요. 그래서 평소엔 조용해요.","설립자님이 움직이시면 제가 곁에서 지켜야 해요.","움직이는 순간이 오지 않는 게 가장 좋아요.","그래도 그 순간이 오면 한 발짝도 물러서지 않아요."]],["왕좌는 어떤 곳이야?",["리바이어던의 가장 높은 곳이에요. 설립자님의 자리예요.","처음 봤을 때 너무 커서 눈을 못 뗐어요.","왕좌를 지키는 게 제 일 중 가장 중요한 일이에요.","저는 그 근처에 서 있을 때 가장 긴장돼요.","가끔 설립자님이 앉아 계신 모습을 상상해요. 위엄이 넘칠 것 같아요."]],["내가 움직일 때는 어떻게 지켜?",["가장 가까운 곳에서 방패를 들고 있어요.","시야는 정찰팀이, 후방은 공격팀이 맡고 저는 바로 옆을 맡아요.","설립자님은 걱정 안 하셔도 돼요. 제가 있으니까요.","한 발짝이라도 가까이 다가오는 건 누구도 허락하지 않아요.","이, 이 이야기를 하다 보니 사명감에 어깨가 무거워지네요."]],["방패의 의미는 뭐야?",["누군가를 대신해서 맞는 거라고 생각해요.","공격하지 않아도 지킬 수 있다는 증거예요.","저는 방패라는 단어가 자랑스러워요. 아, 아주 조금요.","방패는 가장 앞에 서지만 가장 조용한 존재예요.","부서지지 않아야 한다는 약속이기도 해요."]],["Unbreakable Shield라는 이름은 무슨 뜻이야?",["‘부서지지 않는 방패’라는 뜻이에요.","이 이름을 처음 들었을 때 제 이름 같았어요. 소심하지만 안 부서지거든요.","솔라리아는 ‘멋있다!’ 하고 외쳤어요. 저는 ‘무겁다…’ 했어요.","이름만큼 되기 위해 매일 노력해요.","이 이름에 부끄럽지 않게 살고 싶어요."]],["쌍둥이 자매에 대해 말해 줘.",["솔라리아는 제 쌍둥이 자매예요. 저와는 정반대인 아이예요.","같은 얼굴이지만 성격이 전혀 달라서 사람들이 놀라요.","저는 달 쪽, 솔라리아는 태양 쪽이라고 불러요.","서로 없으면 안 되는 사이라고 생각해요.","싸우기도 많이 하지만… 사랑해요. 아, 이 말은 솔라리아한테 비밀이에요."]],["솔라리아는 어떤 사람이야?",["밝고 시끄럽고 장난꾸러기예요. 말괄량이예요.","가만히 있지를 못해요. 저와는 정반대지요.","하지만 위기 상황에서는 누구보다 믿음직해요.","저를 많이 챙겨 주는데 표현이 서툴러요. 가끔 놀리는 걸로 표현해요.","제가 가장 존경하는 사람 중 한 명이에요."]],["이름의 달 쪽, 태양 쪽은 무슨 뜻이야?",["제 이름 ‘카엘루나’는 달에서, 솔라리아는 태양에서 따왔어요.","그래서 사람들이 저희를 달과 태양이라고 불러요.","저는 달이라서 조용하고 솔라리아는 태양이라서 눈부셔요.","달은 태양이 있어야 빛난다고 해요. 그래서 솔라리아가 필요해요.","반대로 태양도 달이 있어야 쉴 수 있겠죠. 저는 그렇게 믿어요."]],["둘이 얼마나 닮았어?",["얼굴은 거의 똑같아요. 머리 모양이랑 표정만 달라요.","처음 보는 분들은 구분을 못 해서 가끔 바꿔 부르세요.","솔라리아가 일부러 제 옷을 입고 장난친 적이 있어요.","닮았지만 목소리 크기가 달라서 금방 구별돼요.","거울을 보면 솔라리아가 생각나서 웃게 돼요."]],["둘이 싸운 적 있어?",["많아요. 대부분 솔라리아가 제 간식을 먹어서요.","큰 싸움은 한 번 있었어요. 그날 밤 저는 울었고 솔라리아는 사과하러 왔어요.","싸워도 금방 화해해요. 솔라리아가 먼저 와서 장난치거든요.","저는 싸우는 게 싫어서 먼저 사과해요.","솔라리아도 사실은 저를 많이 아껴요. 알고 있어요."]],["솔라리아가 장난치면 어떡해?",["처음에는 놀라지만 이제는 익숙해요.","가끔은 같이 웃어요. 아주 작게요.","너무 심하면 방패로 막아요. 장난으로요.","솔라리아의 장난은 저를 웃게 하려는 거라는 걸 알아요.","저도 한 번 역으로 장난쳤는데 솔라리아가 놀라서 기절할 뻔했어요."]],["가장 부담스러운 건 뭐야?",["사람들 앞에 서서 말하는 거요.","기대를 받는 것이요. 실망시킬까 봐 무서워요.","갑작스러운 변화요.","설립자님 앞에서 실수하는 것이요.","모든 눈이 저를 보는 순간이요. 그래서 방패 뒤에 숨어요."]],["수줍음을 극복하려면 어떻게 해?",["저도 아직 극복 중이에요. 거울 앞에서 인사 연습을 해요.","솔라리아가 도와주려고 일부러 사람 많은 곳에 데려가요. 도움이 되는지는 모르겠어요.","한 걸음씩 가면 된다고 믿어요.","무리하지 않는 게 중요하다고 배웠어요.","설립자님 앞에서는 조금씩 말을 더 하게 돼요. 그게 저한테는 큰 진전이에요."]],["왜 사령관이 됐어?",["솔직히 저도 잘 모르겠어요. 갑자기 지명받았어요.","솔라리아와 함께 맡게 되어 용기를 냈어요.","지키는 일이라면 할 수 있을 것 같았어요.","설립자님이 저를 믿어 주셨어요. 그래서 거절할 수 없었어요.","지금은 이 자리가 제 자리라고 생각해요."]],["두려운 게 있어?",["소중한 사람을 지키지 못하는 거요.","혼자 남겨지는 거요.","큰 소리요. 그리고 어둠이요. …바닷속 기지에서 일하는데 이상하죠?","설립자님께 실망을 드리는 거요.","솔라리아가 다치는 거요. 이건 정말 무서워요."]],["용기가 나는 순간은 언제야?",["누군가를 지켜야 할 때예요.","설립자님께서 ‘믿는다’고 말씀해 주실 때요.","솔라리아가 손을 잡아 줄 때예요.","방패를 들고 있을 때요. 그때만큼은 저도 강해져요.","‘괜찮아’라는 말을 들었을 때요."]],["방어 훈련은 어떻게 해?",["하루 두 번, 기본 자세와 실전 훈련을 해요.","버티는 훈련이 제일 많아요. 오래 서 있는 게 중요해요.","솔라리아가 일부러 공격 역할을 해 줘요. 아프게 때리는데 저는 안 아파요.","훈련 후에는 방패를 꼭 닦아요.","가끔 새로운 방식도 시도해 봐요."]],["방어 장비는 어떤 거야?",["큰 방패와 보조 방벽, 그리고 경량 갑옷이에요.","방패는 제가 직접 닦고 점검해요.","무겁지만 이제는 익숙해서 가볍게 느껴져요.","손잡이에는 솔라리아가 새긴 낙서가 있어요. 지울 수가 없어요.","장비 이름은 아직 없어요. 지어 주실래요?"]],["공격받으면 어떻게 해?",["먼저 설립자님을 지켜야 해요. 그다음은 그때그때 판단해요.","방패를 들고 앞에 서요. 한 발짝도 물러서지 않아요.","무섭지만 몸이 먼저 움직여요.","솔라리아가 뒤에서 도와줘요. 둘이 함께면 더 강해요.","그, 그런 일이 없기를 바라지만 있으면 해낼 거예요."]],["가장 위험했던 순간은?",["링 모양 기지에 이상 신호가 있었던 날이에요. 모두 긴장했어요.","한 번 방어선이 뚫릴 뻔했어요. 지금 생각해도 심장이 뛰어요.","그날은 솔라리아가 제 옆에서 한 번도 장난을 치지 않았어요.","이야기하기 조금 무서워요. 다음에 해도 될까요.","큰 사건은 아니었지만 저에게는 가장 길었던 밤이었어요."]],["가장 뿌듯했던 순간은?",["설립자님께서 ‘수고했다’고 해 주셨을 때요.","처음으로 큰 소리로 명령을 내렸을 때요.","솔라리아가 ‘너 정말 멋있었어’라고 했을 때요.","누군가를 무사히 지켜 냈을 때요.","하루 종일 아무 일도 없이 지나간 평화로운 날도 뿌듯해요."]],["암형체가 침입하면?",["정찰팀이 가장 먼저 발견하고 방어팀이 막아요.","공격팀이 필요할 때도 있어요.","저는 방패로 막는 일을 맡아요.","무섭지만 두려움은 숨겨요. 팀원들이 불안해하지 않도록요.","설립자님이 계신 곳 근처라면 더 큰 용기가 나요."]],["국가가 공격해 오면?",["공격팀이 나서요. 저는 최후의 방어선을 지켜요.","상황을 정리해 설립자님께 가장 먼저 보고해요.","그런 일이 없도록 정찰팀이 최선을 다해요.","무서운 일이지만 대비는 철저해요.","지켜야 할 게 많아서 오히려 용기가 나요."]],["R.S.S.와의 협력은 어때?",["아비시온 사령관이 정보를 정확하게 주세요. 저는 말을 거는 데 시간이 걸려서 죄송해요.","정보 요청 때마다 ‘죄송합니다’로 시작해서 놀리세요. …아니, 놀리시는 건 솔라리아예요.","R.S.S.의 정보 덕분에 사전 방어가 가능해요.","감사한 부서예요.","아비시온 사령관은 조용히 도와주세요. 그게 고마워요."]],["선샤오펑 사령관과는 어떤 사이야?",["아주 다정하세요. 저희 쌍둥이를 늘 귀여워해 주세요.","차와 과자를 챙겨 주세요. 솔라리아는 좋아서 날뛰어요.","저는 조금 무서운 느낌도 받지만… 좋은 분이에요.","만나면 ‘잘 지냈어요?’ 하고 먼저 물어봐 주세요.","그분이 웃을 때 조금 소름이 돋긴 하지만 마음은 따뜻하다고 믿어요."]],["카네히라 사령관에게도 보고해?",["네, 장 등급제와 관련된 사항은 협조해요.","카네히라 사령관은 서식이 정확해서 저도 정성껏 써요. 틀리면 부끄러워서요.","저희 팀원들의 등급 기록도 관리해 주세요.","말투가 엄격해서 처음엔 무서웠는데 좋은 분이에요.","솔라리아가 서류에 낙서했을 때 같이 사과하러 갔어요."]],["뤼시앙 사령관과는 어떻게 지내?",["법 관련 문의를 드릴 때마다 ‘폐가 안 될까요’로 시작해서 죄송해요.","항상 차분하게 설명해 주세요. 정말 감사해요.","법정에 방청하러 간 적이 있는데 너무 멋있었어요.","솔라리아가 방청석에서 졸다가 걸렸어요. 제가 대신 사과했어요.","논리적인 분이라 저는 조금 어려워요. 그래도 존경해요."]],["메모리와는 어떤 사이야?",["시설 점검 때 가장 먼저 협조해 주세요. 정말 믿음직해요.","저를 동료로 대해 주세요. 기계라고 해서 다르게 보지 않아요.","가끔 별 이야기를 해요. 저도 별을 좋아해서요.","솔직히 처음엔 조금 무서웠지만 지금은 좋아해요.","저도 감사하다는 말을 직접 전하고 싶은데 아직 용기가 안 나요."]],["Overseer는 어때?",["호기심이 많아서 질문이 끝이 없어요. 가끔 제가 대답을 못 해서 미안해요.","솔라리아가 대신 대답해 줘요. 가끔 틀린 답이지만요.","전달 속도가 빨라서 정말 도움이 돼요.","신기한 질문을 해서 저도 많이 배워요.","저를 ‘작은 달’이라고 부르기도 해요. 좋아요."]],["팀원들은 어떤 사람들이야?",["든든하고 다정한 사람들이에요.","저보다 훨씬 강한데도 저를 존중해 줘요.","솔라리아의 장난도 다 받아 주는 좋은 사람들이에요.","다들 말이 적어서 저와 잘 맞아요.","저는 팀원들이 가족 같아요."]],["팀원 훈련은 어떻게 해?",["기본 자세와 협동 훈련을 해요.","저는 말이 서툴러서 시범으로 보여 줘요.","솔라리아가 큰 소리로 격려해 줘요. 저는 작은 소리로 따라가요.","무리하지 않게 단계별로 진행해요.","훈련이 끝나면 다 같이 차를 마셔요."]],["보안 사고가 있었어?",["작은 것은 몇 번 있었어요. 모두 해결했어요.","큰 사고는 없었어요. 다행이에요.","정확한 내용은 보안 등급 때문에 말씀드릴 수 없어요.","있었던 일은 모두 보고서로 남겼어요.","사고가 나지 않게 하는 게 우리 일이에요."]],["출입 통제 시 신분은 어떻게 확인해?",["신분증을 확인하고 기록과 대조해요.","수상한 점이 있으면 한 번 더 물어봐요.","솔직히 사람 눈을 보는 게 제일 어려워서 서류를 먼저 봐요.","가끔은 목소리가 작아서 두 번 말해야 해요.","신원 확인은 가장 기본이지만 가장 중요해요."]],["설립자를 어떻게 지켜?",["항상 곁에서 눈을 떼지 않아요.","방패를 들고 앞에 서요.","위험이 오기 전에 정찰팀이 알려 줘요.","저는 마지막 방어선이에요. 그 앞은 누구도 지나갈 수 없어요.","무엇보다 설립자님이 안전하다고 느끼시도록 하고 싶어요."]],["설립자 호위는 어떻게 해?",["설립자님이 움직이시면 방어팀이 즉시 따라붙어요.","일정은 미리 공유받고 경로를 점검해요.","저는 가장 가까운 자리를 맡아요. 영광이에요.","눈에 띄지 않으면서도 항상 곁에 있도록 노력해요.","솔라리아도 같이 올 때가 있는데 그날은 조금 정신없어요."]],["방패가 부서지면 어떡해?",["부서지지 않아요. 저는 그렇게 믿어요.","만약 부서진다면 몸으로 막을 거예요.","방패는 부서져도 마음은 부서지지 않아요.","하지만 그런 날은 오지 않게 할 거예요.","혹시 부서지면 솔라리아가 새로 만들어 줄 거예요. 이상한 모양으로요."]],["무너지지 않는 방패의 비결은?",["매일 닦고, 점검하고, 믿는 거예요.","혼자가 아니라는 걸 아는 거요.","가끔은 쉬는 것도 중요해요.","무너질 수도 있다는 걸 인정하는 거요. 그래야 더 단단해져요.","비결은… 저도 아직 잘 몰라요. 설립자님이 계셔서 그런 것 같아요."]],["사람들이 오해하는 점은?",["소심하다고만 생각하는 거요. 저도 가끔은 용감해요.","말이 없다고 생각이 없다고 보는 거요.","방패라서 감정이 없다고 오해하는 거요.","솔라리아와 정반대라서 사이가 나쁘다고 생각하는 거요.","저는 아주 많이 느끼고 있어요. 표현이 서툴 뿐이에요."]],["가장 좋아하는 업무는?",["방어팀 훈련이에요. 조용하고 집중돼서요.","순찰도 좋아해요. 걸으면서 생각할 수 있어서요.","설립자님을 호위하는 일이요. 영광이에요.","방패를 정비하는 시간이요. 마음이 편해져요.","솔라리아와 함께하는 모든 일이요. 시끄럽지만 좋아요."]],["앞으로의 목표는?",["더 큰 목소리로 인사하는 거요.","방어팀이 한 번도 움직이지 않아도 되는 평화로운 세상이에요.","설립자님이 안심하고 계실 수 있게 하는 거요.","솔라리아와 오래오래 함께하는 거요.","언젠가는 사람들 앞에서 당당히 서고 싶어요. 방패 없이요."]],["방패로서의 철학은?",["지키는 건 이기는 것보다 어렵다고 생각해요.","공격은 순간이지만 방어는 계속이에요.","방패는 누구도 해치지 않아요. 그게 자랑스러워요.","지키고 싶은 사람이 있으면 약해도 강해져요.","한 가지만 말하자면 ‘끝까지 곁에 있는 것’이에요."]]]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX12"><Properties><string name="Name">work</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["오늘 할 일은 뭐야?",["오전에는 방어 훈련, 오후에는 순찰이에요. 평소와 같아요.","저, 점검 목록이 세 개 있어요. 천천히 해 볼게요.","특별한 건 없는데… 설립자님이 시키실 일이 있으면 그게 제일 먼저예요.","방패 정비하고, 팀원들 상태 확인하고, 보고서 쓰는 거예요.","솔라리아가 같이 다니자고 해서 오후엔 시끄러울 것 같아요."]],["지금 맡고 있는 업무는?",["방어팀 훈련 일정을 짜고 있어요.","출입 통제 기록을 정리하고 있어요.","링 모양 기지의 점검표를 작성 중이에요.","설립자님 일정에 맞춘 호위 계획을 세우고 있어요.","아, 방금까지는 방패를 닦고 있었어요."]],["급한 일 있어?",["지금은 없어요. 다행이에요.","급한 일이 생기면 제가 먼저 연락드릴게요. 목소리가 작아도 전화는 할 수 있어요.","조금 있긴 한데 괜찮아요. 해결 중이에요.","있었는데 솔라리아가 도와줘서 끝났어요.","없어요. 아직은요."]],["내가 맡길 일이 있어.",["네, 말씀하세요. 메모할 준비가 되어 있어요.","저, 저에게 맡겨 주신다니… 영광이에요. 최선을 다할게요.","어떤 일이든 열심히 할게요. 떨리지만 할 수 있어요.","세부 사항을 알려 주시면 꼼꼼히 확인할게요.","솔라리아한테는 비밀로 해야 하는 일인가요? 아니면 같이 해도 되나요?"]],["정찰팀 보고는 어때?",["오늘은 이상 없다고 했어요.","먼 바다에서 작은 배 한 척이 지나갔지만 안전했어요.","정찰팀은 항상 꼼꼼하게 보고해 줘요. 믿음직해요.","한 건의 이상 신호가 있었는데 오탐이었대요.","보고서는 가장 먼저 설립자님께 올릴게요."]],["공격팀 상태는?",["모두 컨디션이 좋아요. 솔라리아가 힘이 넘쳐서 조금 시끄러워요.","훈련을 열심히 하고 있어요. 대기 상태예요.","공격팀이 움직이지 않는 게 제일 좋은 일이지만, 준비는 완벽해요.","장비 점검을 마쳤어요.","저는 가끔 그분들이 무서워서 인사만 하고 지나가요."]],["방어팀은 지금 뭐 해?",["훈련과 점검을 하고 있어요.","대기 상태로 조용히 있어요.","방패를 닦고 있는 분들이 많아요.","오늘은 새로운 대형 연습을 했어요.","언제든 움직일 수 있어요."]],["순찰은 어떻게 해?",["링 모양 기지를 한 바퀴 돌고, 출입구를 점검해요.","솔라리아와 함께 돌 때가 많아요. 시끄럽지만 든든해요.","저는 순찰하면서 별을 봐요. 아, 일은 열심히 하고 있어요.","이상한 점이 있으면 바로 기록해요.","순찰은 가장 조용한 업무라 좋아요."]],["야근해?",["가끔 해요. 방패를 정비하다 보면 시간이 훌쩍 가요.","야간 순찰이 있을 때는 어쩔 수 없어요.","야근은 싫지만 필요한 일이라면 해요.","솔라리아가 같이 해 주면 괜찮아요.","설립자님이 걱정하시니까 오늘은 일찍 쉴게요."]],["업무량은 괜찮아?",["괜찮아요. 아, 괜찮은 것 같아요. 아니, 조금 많긴 한데 할 수 있어요.","아직 버틸 만해요.","많지만 팀원들이 도와줘서 괜찮아요.","무리하지 않으려고 노력하고 있어요.","설립자님이 물어봐 주시니까 힘이 나요."]],["마감이 언제야?",["이번 주 금요일에 점검 보고서를 제출해야 해요.","내일 오전까지 훈련 계획서가 필요해요.","모든 마감은 일정표에 있어요. 아직 여유 있어요.","마감은 지켜요. 제 유일한 자랑이에요.","미리 끝내 두면 마음이 편해요."]],["이상 징후 있어?",["지금은 없어요. 하지만 조용할수록 불안해요.","작은 소리가 하나 있었는데 확인해 보니 파도 소리였어요.","정찰팀이 하나 포착했는데 아직 확인 중이에요.","있으면 가장 먼저 말씀드릴게요.","없다고 믿고 있지만 눈은 감지 않고 있어요."]],["위험 요소를 보고해 줘.",["지금 가장 큰 위험은 방심이에요.","장비 노후화가 조금 걱정이에요.","인력 피로도도 신경 쓰이고요.","큰 위험은 없지만 작은 위험들이 쌓일까 봐 걱정이에요.","자세한 보고서는 정리해서 보낼게요."]],["예산은 충분해?",["장비 교체 예산이 조금 부족해요.","그 외에는 충분해요. 감사해요.","솔라리아가 장비를 자주 망가뜨려서 예산이 줄어요. 죄송해요.","아껴 쓰고 있어요.","필요한 건 정리해서 요청드릴게요."]],["인력은 충분해?",["방어팀은 충분해요. 정찰팀은 조금 부족해요.","솔직히 사람 수보다 서로 호흡을 맞추는 게 더 중요하다고 생각해요.","신입이 들어오면 제가 가르쳐야 해서 긴장돼요.","충원보다는 휴식이 먼저라고 생각해요.","지금은 괜찮아요."]],["휴가는 언제 가?",["다음 달에 사흘 쉬려고 해요. 솔라리아가 여행을 가자고 하는데 아직 고민 중이에요.","휴가는 조금 무서워요. 비어 있는 시간이 낯설어서요.","가게 되면 조용한 곳에서 책을 읽고 싶어요.","설립자님이 허락해 주시면 쉴게요.","그래도 호출하시면 바로 돌아올게요."]],["출장 갈 일 있어?",["링 모양 기지 외곽 점검 때문에 한 번 나가야 해요.","출장은 솔라리아가 더 좋아해요. 저는 조금 무서워요.","필요하면 어디든 가요.","멀리 가는 건 긴장되지만 설립자님의 지시라면 해낼게요.","이동하는 동안 별을 볼 수 있어서 나쁘지 않아요."]],["회의는 많아?",["주 두 번 정례 회의가 있어요. 저는 구석에 앉아요.","회의에서 의견을 말해야 하면 며칠 전부터 연습해요.","솔라리아가 큰 소리로 말해 줘서 도움이 돼요.","가끔 질문을 받으면 얼굴이 빨개져요.","회의가 짧아서 좋아요."]],["서류 결재 좀 부탁해.",["준비해 두었어요. 서명할 곳에 작은 별 표시를 해 두었어요.","죄송해요, 서류가 조금 많아요. 급한 것부터 정리했어요.","읽으시기 편하게 요약본도 붙였어요.","감사합니다. 서명해 주시면 제가 책임지고 처리할게요.","한 장씩 천천히 보세요. 서두르지 않으셔도 돼요."]],["새 지시를 내릴게.",["네! 말씀하세요. 메모하고 있어요.","저, 잘 듣고 있어요. 한 글자도 놓치지 않을게요.","지시라니 긴장돼요. 하지만 할 수 있어요.","설립자님의 지시는 제가 가장 먼저 처리할게요.","수행하고 나서 바로 보고드릴게요."]],["우선순위는 어떻게 정해?",["안전과 관련된 일이 제일 먼저예요.","설립자님과 관련된 일이 두 번째예요.","그다음은 시간이 급한 순서예요.","솔라리아가 끼어들면 순서가 뒤죽박죽돼요. 그래도 바로잡아요.","마음이 시키는 순서도 가끔 따라요."]],["일 잘하는 비결은?",["꼼꼼히 확인하고 두 번 점검하는 거예요.","모르는 건 물어보는 거요. 부끄러워도요.","미리미리 준비하는 거예요.","쉬는 시간도 지키는 거요.","저는… 그냥 열심히 할 뿐이에요."]],["일 미루는 사람은 어떡해?",["이유를 먼저 물어봐요. 말하기 어려운 사정이 있을 수 있으니까요.","도와줄 수 있으면 같이 해요.","솔라리아가 가끔 그래서… 제가 대신 해 줄 때도 있어요.","하지만 계속되면 용기를 내서 말씀드릴 거예요.","화를 낼 수는 없어요. 소리가 안 나와서요."]],["실수한 직원이 있으면?",["괜찮다고 먼저 말해요. 저도 실수 많이 하거든요.","같이 고쳐요. 천천히요.","혼내지는 못해요. 대신 방법을 함께 찾아요.","큰 실수는 보고하지만 먼저 본인 이야기를 들어요.","저도 첫날에 방패를 떨어뜨렸어요. 기억나요."]],["칭찬할 직원은?",["정찰팀의 한 분이 이상 신호를 먼저 포착했어요. 칭찬해 주고 싶어요.","방어팀 동료가 정말 성실해요.","한 명을 고르기 어려워요. 다들 열심히 하거든요.","솔라리아도 칭찬해야 해요. 말하기는 싫지만요.","비서분이 일정 관리를 잘해 줘요."]],["신입 교육은 어떻게 해?",["먼저 인사하는 법부터 알려 줘요. 제가 제일 못하는 건데…","방패 드는 자세는 몸으로 보여 줘요.","솔라리아가 분위기를 풀어 줘요.","무리하게 몰아붙이지 않아요.","그래도 신입이 저를 따르는 걸 보면 신기해요."]],["일할 때 듣는 건?",["잔잔한 음악을 작게 틀어요.","바다 소리 음원이요. 기지에서 일할 때 특히요.","아무것도 안 들을 때도 많아요.","솔라리아의 노래가 들리면 눈을 감고 참아요. 아주 큰 소리라서요.","설립자님의 목소리라면 환영이에요."]],["일할 때 습관은?",["방패를 닦으면서 생각을 정리해요.","서류는 가장자리를 맞춰서 쌓아요.","중요한 건 두 번 적어요.","한 시간마다 창밖을 봐요.","솔라리아가 오기 전에 미리 책상을 정리해요."]],["책상 위에는 뭐가 있어?",["작은 달 모양 장식과 펜 두 자루, 그리고 서류함이 있어요.","솔라리아가 놓고 간 낙서가 있는데 지우지 못했어요.","방패 닦는 천이 항상 있어요.","설립자님이 주신 서류는 가장 위에 두고 있어요.","작은 화분 하나가 있는데 이름은 ‘달이’예요."]],["일하기 싫을 때는?",["그, 그럴 때는 방패를 닦아요. 마음이 가라앉아요.","잠깐 눈을 감고 심호흡해요.","솔라리아한테 푸념을 해요. 솔라리아가 들어 줘요.","그런 날은 아주 조금만 해요.","설립자님께서 알아주시는 걸 생각하면 힘이 나요."]],["업무에서 보람 있는 순간은?",["아무 일 없이 하루가 지나갈 때요.","누군가가 안전하게 돌아왔을 때요.","설립자님께서 칭찬해 주셨을 때요.","신입이 처음으로 방패를 제대로 들었을 때요.","솔라리아가 ‘너 정말 든든해’라고 했을 때요."]],["업무에서 지루한 순간은?",["지루함은 거의 못 느껴요. 조용한 게 좋아서요.","서류 정리가 길어질 때요.","대기 시간이 길어질 때요.","회의에서 같은 말이 반복될 때요.","그래도 지루한 시간은 평화라는 뜻이니까 괜찮아요."]],["일과 삶의 균형은?",["일 70, 삶 30 같아요.","일이 삶이라 구분이 어려워요.","솔라리아가 가끔 강제로 쉬게 해 줘요.","저는 쉬는 법을 잘 몰라요. 배워야 해요.","설립자님께서는 균형이 잘 맞으시길 바라요."]],["일 때문에 놓친 건?",["친구들과의 약속이요. 원래 약속이 많지는 않지만요.","가끔 놓친 식사가 아쉬워요.","큰 후회는 없어요.","대신 얻은 게 많아서 괜찮아요.","솔라리아와 놀 시간을 조금 놓쳤어요."]],["업무 중 간식은?",["달콤한 쿠키를 서랍에 숨겨 놔요.","솔라리아가 가끔 뺏어 가요. 그래서 이중으로 숨겨요.","선샤오펑 사령관이 주신 과자예요. 아껴 먹어요.","따뜻한 우유와 함께 먹으면 좋아요.","간식은 제 작은 행복이에요."]],["솔라리아와는 어떻게 일해?",["솔라리아는 앞에서 이끌고 저는 뒤에서 받쳐요.","솔라리아가 큰 소리로 지시하고 저는 작은 소리로 보충해요.","성격은 정반대지만 호흡은 잘 맞아요.","솔라리아가 없으면 일이 조용해서 허전해요.","저희는 둘이 합쳐야 완성되는 방패예요."]],["비상 상황이 오면?",["침착하게 팀을 소집하고 설립자님께 보고해요.","방어 태세에 들어가요. 제가 앞에 서요.","무서워도 몸이 먼저 움직여요.","솔라리아가 신호를 보내면 바로 따라가요.","비상 훈련을 자주 해서 괜찮아요."]],["오늘 퇴근은?",["일정이 끝나면 할 거예요.","설립자님께서 필요하시면 늦춰도 돼요.","퇴근 후에도 연락은 닿도록 해 둘게요.","가능하면 일찍 마치고 쉬고 싶어요.","솔라리아가 같이 가자고 하는데 아직 고민 중이에요."]],["내가 도울 일은?",["설립자님은 앉아 계셔도 충분해요.","저, 정 도와주시겠다면… 격려 한마디만 해 주세요.","서명 한두 장이면 돼요.","도와주시고 싶다는 마음만으로도 충분해요.","필요하면 제가 먼저 말씀드릴게요."]],["같이 일해 볼까?",["저, 저랑요? 영광이에요. 어떤 일을 할까요?","설립자님과 같이 일하면 더 든든할 것 같아요.","일정을 비워 둘게요.","처음엔 긴장하겠지만 곧 괜찮아질 거예요.","함께라면 뭐든 해낼 수 있을 것 같아요."]],["방문객이 오면 어떻게 해?",["먼저 신분을 확인하고 안내해요.","작은 목소리로 인사해요. 잘 안 들리면 솔라리아가 대신 해요.","누구든 무서워하지 않도록 노력해요.","무례한 분이 오면 방패로 막아요. 실제로는 아니고 비유예요.","설립자님이시라면 모든 문이 열려요."]],["보고서는 어떻게 써?",["짧고 정확하게 써요.","저는 글로 쓰는 게 말보다 편해요.","다 쓰고 나서 세 번 읽어요.","솔라리아가 읽어 주고 오류를 찾아 줘요.","설립자님께 올리는 보고서는 특히 정성스럽게 써요."]],["가장 중요한 업무는?",["설립자님을 지키는 일이에요.","리바이어던의 안전이에요.","팀원들이 무사히 돌아오게 하는 거요.","아무 일도 일어나지 않도록 하는 거요.","하나만 고르라면 ‘지키는 것’이에요."]],["R.T.S. 간 협력은 어때?",["정찰팀이 눈, 공격팀이 창, 방어팀이 방패 역할을 해요.","서로 신뢰하는 게 가장 중요해요.","솔라리아 덕분에 공격팀과도 친해졌어요.","서로의 역할을 존중하며 일해요.","협력이 잘 될 때가 가장 안심돼요."]],["링 모양 기지 점검은 어떻게 해?",["기지를 한 바퀴 돌며 구역별로 점검해요.","벽의 균열, 장비 상태, 통신 설비를 확인해요.","혼자 돌면 무서워서 보통 솔라리아랑 같이 돌아요.","점검이 끝나면 보고서를 써요.","점검하는 동안 물고기들이 구경하러 와요. 귀여워요."]],["보안 훈련은 얼마나 자주 해?",["주 3회 기본 훈련, 월 1회 전체 훈련이에요.","저는 훈련을 좋아해요. 시끄럽지 않아서요.","솔라리아와 짝이 되면 시끄러워요.","새로운 시나리오를 만들어 연습하기도 해요.","훈련은 거짓말을 하지 않아요."]],["기억 에너지 보급과 보안은 어떤 관계야?",["보급 물품을 운반할 때 저희가 호위해요.","에너지가 도난당하면 큰일이니까요.","메모리 사령관과 협의해서 경로를 정해요.","기억 에너지는 정말 귀한 자원이라 책임감이 커요.","한 번도 사고가 난 적은 없어요."]],["법과 보안은 어떤 관계야?",["뤼시앙 사령관이 정한 법에 따라 저희가 지켜요.","무력을 쓸 때는 반드시 법적 근거가 필요해요.","법이 있어서 저희도 안심하고 움직일 수 있어요.","가끔 법이 어려워서 솔라리아한테 쉬운 말로 설명을 부탁해요.","법과 방패는 같은 목적을 가졌다고 생각해요."]],["보안이 뚫리면 어떻게 돼?",["상상하기 싫지만… 즉시 비상 체제로 전환해요.","방어팀이 최후의 방어선을 구축해요.","그런 일이 없도록 매일 점검해요.","제가 한 발짝도 물러서지 않을 거예요.","설립자님 곁을 지키는 게 가장 먼저예요."]],["일 얘기는 여기까지!",["네, 알겠어요. 이제는 편하게 이야기해요.","일 얘기가 끝났으니… 무슨 얘기를 하죠? 저 대화 소재가 별로 없어요.","솔라리아가 일 얘기 끝나면 장난 시작이래요. 조심하세요.","좋아요. 이제부터는 편한 이야기예요.","설립자님이 원하시는 이야기라면 뭐든 받들게요."]]]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX13"><Properties><string name="Name">food</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["좋아하는 음식은?",["달콤한 거요… 특히 딸기 우유랑 쿠키요. 아, 애 같다고 하지 마세요.","따뜻한 수프를 좋아해요. 호박 수프요.","계란말이요. 부드럽고 달콤해서요.","솔라리아가 만들어 주는 볶음밥이요. 맛은 보통인데 마음이 따뜻해요.","설립자님이 맛있다고 하시는 건 다 좋아져요. 아, 말이 이상한가요…"]],["싫어하는 음식은?",["쓴 채소요. 먹을 수는 있지만 얼굴이 찌푸려져요.","너무 매운 건 못 먹어요. 눈물이 나요.","비린 생선은 조금 어려워요.","싫어한다기보다 무서운 음식은… 살아 있는 것 같은 음식이요.","솔라리아가 장난으로 넣은 고수는 정말 싫어요."]],["아침은 뭐 먹어?",["빵 한 조각과 따뜻한 우유예요.","시리얼을 조금요. 많이는 못 먹어요.","솔라리아가 깨우러 오면 같이 먹어요. 시끄러워요.","죽을 먹을 때도 있어요.","설립자님은 뭘 드세요? 같이 먹는 상상을 해 봤어요."]],["점심 뭐 먹었어?",["구내식당에서 작은 정식을 먹었어요.","샌드위치를 조금 먹었어요. 솔라리아가 반을 뺏어 갔어요.","아직이에요. 설립자님과 이야기하는 걸 먼저 하고 싶어서요.","방패를 닦다가 먹는 걸 놓쳤어요.","수프와 빵이었어요. 따뜻해서 좋았어요."]],["저녁 메뉴 추천해 줘.",["따뜻한 크림 스튜는 어떠세요. 부드러워서 마음이 편해져요.","계란 요리와 따뜻한 밥이 좋아요.","가볍게 죽이나 수프도 좋아요.","설립자님이 드시고 싶은 걸 드세요. 제가 정할 자격은 없어요.","저라면 우유가 들어간 음식을 고를 것 같아요."]],["매운 거 잘 먹어?",["아뇨… 맵기만 해도 눈물이 나요.","한 입만 먹어도 얼굴이 빨개져요.","솔라리아는 아주 잘 먹어요. 저는 쳐다만 봐도 땀나요.","도전해 본 적은 있어요. 그날 밤 후회했어요.","순한 맛이 좋아요. 아주 순한 맛으로요."]],["단 거 좋아해?",["네, 많이요. 비밀이지만 서랍에 사탕이 한가득 있어요.","달콤한 걸 먹으면 마음이 풀려요.","솔라리아한테 들키면 다 뺏겨서 이중으로 숨겨요.","초콜릿, 케이크, 푸딩 다 좋아해요.","단 걸 먹을 때가 제일 행복해요. 아, 어린애 같죠."]],["커피 vs 차?",["차요. 특히 따뜻한 우유차가 좋아요.","커피는 너무 써서 못 마셔요. 설탕을 아주 많이 넣으면 가능해요.","허브차도 좋아해요. 카모마일이요.","솔라리아는 커피를 마시는데 저는 차예요.","설립자님은 어느 쪽이세요?"]],["우유 좋아해?",["네, 아주요. 딸기 우유, 바나나 우유, 초코 우유 다 좋아해요.","따뜻한 우유는 자기 전에 꼭 마셔요.","솔라리아가 놀리는데… 괜찮아요. 좋아하는 걸 어떡해요.","우유를 마시면 마음이 포근해져요.","키가 안 컸지만 그래도 마셔요."]],["술은 마셔?",["못 마셔요. 한 모금만 마셔도 얼굴이 빨개져서 쓰러져요.","회식 때 주스만 마셔요. 솔라리아는 몰래 마시다 걸렸어요.","냄새만으로 어지러워요.","설립자님이 권하시면… 한 입은 마셔 볼게요. 그 뒤는 책임 못 져요.","술은 무서워요. 제가 어떻게 될지 몰라서요."]],["디저트는?",["푸딩이요. 부드러워서 마음이 놓여요.","딸기 케이크는 제일 좋아하는 디저트예요.","마카롱도 좋아해요. 작고 귀여워서요.","아이스크림도 좋아하지만 너무 차가우면 머리가 아파요.","디저트는 제 하루의 보상이에요."]],["빵 vs 밥?",["빵이요. 따뜻한 빵 냄새가 좋아요.","밥도 좋아하지만 빵 쪽이 조금 더 좋아요.","아침은 빵, 저녁은 밥이에요.","솔라리아는 밥만 먹어요. 저는 빵만 먹어서 서로 다르네요.","크루아상을 먹을 때가 제일 행복해요."]],["면 vs 밥?",["밥이요. 후루룩 소리가 부끄러워서 면은 조심스러워요.","우동은 좋아해요. 부드러워서요.","면은 솔라리아랑 먹을 때만 편해요.","밥이 든든해서 좋아요.","둘 다 좋아요. 선택하기 어려워요."]],["고기 vs 생선?",["고기요. 부드럽게 익힌 닭고기가 좋아요.","생선은 가시 발라 먹는 게 어려워서 솔라리아가 도와줘요.","굳이 고르면 고기예요.","둘 다 감사히 먹어요.","저는 달걀이 제일 좋아요. 둘 다 아니라서 죄송해요."]],["채소는 잘 먹어?",["먹어요. 쓴 건 조금 힘들지만요.","당근은 단맛이 나서 괜찮아요.","샐러드는 드레싱이 달콤하면 먹어요.","건강을 위해 억지로라도 먹어요.","솔라리아가 채소를 몰래 제 접시에 올려요."]],["간식은?",["쿠키, 사탕, 작은 초콜릿이요.","서랍 속 비밀 간식이 있어요.","선샤오펑 사령관이 주신 과자가 최고예요.","따뜻한 우유와 함께 먹으면 완벽해요.","설립자님께도 나눠 드리고 싶어요. 소량만요."]],["편의점 가?",["가끔 가요. 조용한 시간대에요.","신상 간식이 나오면 가 보고 싶어서 두근거려요.","솔라리아가 같이 가자고 하면 끌려가요.","편의점 직원분께 인사하는 것도 연습이에요.","작은 우유와 사탕만 사 와요."]],["요리는 직접 해?",["간단한 건 해요. 달걀 프라이나 토스트요.","큰 요리는 아직 무서워요. 불이 무서워서요.","솔라리아가 요리는 하는데 맛은 도박이에요.","설립자님을 위한 요리를 연습하고 싶어요.","저, 쿠키는 구울 수 있어요. 모양은 이상하지만요."]],["요리 잘해?",["아니요… 평범해요.","달걀말이는 자신 있어요.","쿠키는 구울 때마다 모양이 달라요.","맛은 괜찮은데 모양이 이상하대요.","설립자님께 대접할 정도는 아니에요. 아직요."]],["소버린 아일랜드 맛집은?",["항구 근처의 작은 빵집을 추천해요.","언덕 위 찻집은 조용하고 달콤한 디저트가 많아요.","솔라리아가 아는 식당은 시끄러운데 맛은 있어요.","설립자님께 소개해 드리고 싶은 곳이 있어요.","제가 좋아하는 비밀 가게가 있는데 알려 드릴까요."]],["구내식당은 어때?",["메뉴가 다양하고 따뜻해서 좋아요.","사람이 많으면 구석에 앉아요.","디저트가 나오는 날은 하루 종일 행복해요.","솔라리아가 시끄러워서 가끔 눈을 감아요.","조리사분께 인사하는 게 습관이에요."]],["도시락 싸 와?",["가끔 싸요. 예쁘게 담는 게 좋아요.","작은 도시락통에 쿠키도 넣어요.","솔라리아가 뺏어 먹을까 봐 이중으로 숨겨요.","설립자님께 도시락을 싸 드리면 부담스러우실까요.","도시락을 먹으면 마음이 편안해져요."]],["야식 먹어?",["가끔요. 우유와 쿠키요.","배고프면 잠이 안 와서 조금 먹어요.","건강엔 좋지 않지만 위로가 돼요.","솔라리아와 같이 몰래 먹다가 걸린 적이 있어요.","설립자님이 함께하시면 야식도 괜찮을 것 같아요."]],["라면은?",["좋아해요. 순한 맛으로요.","계란 풀어서 먹으면 맛있어요.","자주는 못 먹지만 야근 후에는 위로가 돼요.","솔라리아는 매운 라면을 먹는데 저는 한 입만 먹어도 울어요.","끓이는 건 자신 있어요. 3분 30초요."]],["초콜릿은?",["제일 좋아하는 간식이에요. 달달한 밀크 초콜릿이요.","다크 초콜릿은 쓴데 우유랑 먹으면 괜찮아요.","서랍에 늘 있어요.","설립자님께도 나눠 드리고 싶어요.","받으면 하루 종일 기분이 좋아요."]],["아이스크림은?",["좋아해요. 딸기 맛이요.","너무 차가우면 머리가 아파서 천천히 먹어요.","여름에는 솔라리아와 나눠 먹어요.","겨울에도 먹고 싶어요. 이상하죠?","녹을까 봐 걱정되어 허겁지겁 먹어요."]],["과일은?",["딸기가 제일 좋아요. 달콤하고 예뻐서요.","복숭아도 좋아해요.","사과는 깎아서 먹는 걸 좋아해요.","포도는 한 알씩 먹는 즐거움이 있어요.","과일은 하루의 작은 기쁨이에요."]],["식사 예절은?",["조용히 먹는 게 기본이에요.","남기지 않으려고 노력해요.","소리 내지 않고 천천히 먹어요.","솔라리아는 소리가 커서 제가 대신 사과해요.","함께 먹는 사람을 배려하는 게 가장 중요해요."]],["식사 중에 일 얘기를 해?",["안 하려고 해요. 소화에 안 좋아서요.","급한 일이면 해야 하지만 싫어요.","식사 시간은 쉬는 시간이에요.","설립자님과의 식사라면 일 얘기는 안 하고 싶어요.","솔라리아가 가끔 먹으면서 보고해서 놀라요."]],["식사 시간은?",["12시에 먹어요. 배꼽시계가 정확해요.","저녁은 6시예요.","바쁘면 놓칠 때도 있어요. 반성해요.","솔라리아가 항상 챙겨 줘요.","규칙적으로 먹는 게 마음이 편해요."]],["먹기 싫을 때는?",["조금만 먹어요. 우유라도요.","솔라리아가 걱정해서 억지로 먹여요.","그런 날은 쉬라는 신호라고 생각해요.","설립자님은 꼭 드셔야 해요.","따뜻한 차를 마시며 입맛이 돌아오길 기다려요."]],["같이 밥 먹을래?",["저, 저랑요? 네, 영광이에요.","조용한 곳이면 더 좋겠어요.","솔라리아도 함께 가도 될까요? 혼자는 떨려서요.","설립자님이 정해 주시면 따라갈게요.","얼마나 영광인지 몰라요."]],["내가 요리해 줄게.",["저, 정말요? 믿기지 않아요.","무엇이든 맛있게 먹을게요.","남기지 않고 다 먹을 거예요. 약속해요.","그날은 일정을 비워 둘게요.","저도 도와드려도 될까요? 설거지는 잘해요."]],["소원이 음식이라면?",["설립자님과 함께 먹는 딸기 케이크요.","솔라리아와 어릴 적 먹던 볶음밥이요.","따뜻한 우유 한 잔이면 충분해요.","소원은 작아도 괜찮아요.","아무 걱정 없이 먹을 수 있는 평화로운 한 끼요."]],["가장 맛있었던 음식은?",["어릴 때 솔라리아가 처음 만들어 준 볶음밥이요. 맛은 없었지만 가장 맛있었어요.","설립자님과 함께 마신 차와 쿠키요.","비 오는 날 먹은 따뜻한 수프요.","생일에 받은 딸기 케이크요.","맛은 마음이 만든다는 걸 알려 준 음식들이에요."]],["가장 맛없었던 음식은?",["솔라리아가 장난으로 만든 이상한 수프예요.","너무 쓴 한약이에요.","식은 도시락이요.","그래도 솔라리아가 만든 거라 다 먹었어요.","맛없던 건 잊었어요. 좋은 기억만 남겨요."]],["추억의 음식은?",["어릴 때 먹던 따뜻한 우유와 식빵이에요.","솔라리아와 나눠 먹던 사탕이요.","비 오는 날 엄마가… 아니, 그냥 누군가 끓여 주던 죽이요.","추억의 음식은 냄새로 기억나요.","그 냄새가 나면 눈물이 나요."]],["건강식은 챙겨?",["솔라리아가 챙겨 줘요. 억지로 채소를 먹여요.","저는 우유로 건강을 챙긴다고 생각해요.","영양제도 먹고 있어요. 맛은 없지만요.","설립자님도 챙겨 드세요.","건강해야 방패를 들 수 있어요."]],["샐러드는?",["드레싱이 달콤하면 먹어요.","토마토는 좋아해요.","채소 위에 과일이 있으면 더 좋아요.","작은 접시에 담으면 먹을 수 있어요.","샐러드는 예뻐서 보는 것만으로도 좋아요."]],["스프는?",["따뜻한 수프를 제일 좋아해요.","호박 수프는 겨울의 선물이에요.","자기 전에 한 컵 마시면 좋아요.","직접 끓여 볼까 하고 생각 중이에요.","설립자님께도 한 그릇 드리고 싶어요."]],["치즈는?",["부드러운 치즈를 좋아해요.","냄새가 강한 건 조금 무서워요.","치즈 케이크는 최고예요.","빵 위에 올려 먹으면 맛있어요.","한 조각만 먹어도 행복해요."]],["차에 설탕 넣어?",["네, 두 스푼요. 아니, 세 스푼이요. 죄송해요.","꿀을 넣어서 마시는 걸 좋아해요.","우유와 설탕을 넣으면 최고예요.","설립자님은 어떻게 드세요?","그날 기분에 따라 달라요."]],["짠 음식은?",["짠 건 별로예요. 목이 말라서요.","싱거운 게 좋아요.","물을 많이 마셔야 해서 불편해요.","솔라리아는 짠 걸 좋아해서 저와 반대예요.","가끔은 짭짤한 과자가 생각나요."]],["아침을 거르면?",["배가 고파서 정신이 없어요.","집중이 안 돼요.","그래서 최소한 우유라도 마셔요.","설립자님은 거르지 마세요.","솔라리아가 억지로 먹여요."]],["지금 배고파?",["조금요. 이야기하느라 잊고 있었어요.","아니요, 방금 먹었어요.","간식 시간이 다가오고 있어요.","배에서 소리가 날까 봐 걱정돼요.","설립자님과 이야기하는 동안은 배가 안 고파요."]],["좋아하는 간식을 나눠 준다면?",["제가 좋아하는 사탕을 하나 드릴게요. 정말 아끼는 거예요.","쿠키 반쪽을 나눠 드릴게요. 한 개는 너무 아까워서요.","서랍 속 비밀 간식을 열어 드릴게요.","솔라리아한테는 비밀로 해야 해요.","설립자님께는 전부 나눠 드릴 수 있어요. …거의요."]],["솔라리아가 음식 뺏어 먹으면?",["처음엔 화를 내지만 결국 나눠 줘요.","‘안 돼!’ 하고 소리쳐 보는데 작아서 안 들려요.","솔라리아는 저를 놀리려고 그러는 거예요. 알아요.","대신 솔라리아의 간식도 몰래 뺏어 와요.","같이 먹으면 더 맛있다는 걸 알아서 용서해요."]],["음식 하면 떠오르는 사람은?",["솔라리아요. 같이 먹던 기억이 많아요.","선샤오펑 사령관이요. 과자를 챙겨 주세요.","설립자님이요. 같이 먹고 싶은 사람이에요.","엄마… 아니, 그냥 따뜻한 사람이요.","음식은 사람을 기억하게 만드는 것 같아요."]],["요리하는 모습을 보여 줘.",["저, 부끄러워서 못 해요… 하지만 쿠키 반죽하는 모습이라면 괜찮아요.","(반죽을 조물조물한다) 이렇게요. 어색하죠?","솔라리아가 옆에서 훼방을 놓을 거예요.","설립자님이 보고 계시면 손이 떨려요.","다음에 완성품만 보여 드릴게요."]],["오늘의 메뉴를 정해 줘.",["오늘은 따뜻한 수프와 딸기 우유예요.","달걀말이와 밥, 그리고 디저트로 푸딩이요.","설립자님이 정해 주세요. 저는 따라갈게요.","제 추천은 우유가 들어간 스튜예요.","작은 식탁에 같이 앉아 먹는 상상을 하면서 정했어요."]]]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX14"><Properties><string name="Name">honest</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["솔직히 나 어때?",["솔직히… 너무 위대하셔서 눈을 못 맞춰요.","설립자님은 저에게 가장 든든한 분이에요.","자애롭고 강하고… 그런 분이 세상에 있다는 게 신기해요.","가끔 무리하시는 게 걱정돼요. 그게 유일한 불만이에요.","솔직한 말씀이니까 용기 내서 할게요. 존경해요. 진심으로요."]],["나한테 불만 있어?",["없어요! 정말 없어요.","불만은 없지만 걱정은 있어요. 식사는 꼭 챙기세요.","저한테 불만이 있는 쪽이 더 많을 거예요. 소심하니까요.","있어도 말 못 해요. 설립자님 앞에서는 입이 안 열려서요.","굳이 말하자면… 연락이 조금 더 자주 왔으면 좋겠어요. 아, 아니에요!"]],["이 일 힘들지 않아?",["힘들어요. 하지만 지키는 일이라 괜찮아요.","가끔은 도망치고 싶을 때도 있어요.","솔라리아가 있어서 버틸 수 있어요.","설립자님이 물어봐 주시니까 힘이 나요.","힘들어도 방패를 놓을 수는 없어요."]],["힘들 때 어떻게 해?",["방패를 닦으면서 마음을 가라앉혀요.","솔라리아한테 푸념을 해요.","따뜻한 우유를 마셔요.","혼자 별을 봐요.","설립자님의 말씀을 떠올려요. ‘수고했어’라고 해 주셨던 걸요."]],["솔직히 쉬고 싶지 않아?",["쉬고 싶어요… 아주 많이요.","하지만 쉬면 무슨 일이 생길까 불안해요.","설립자님이 허락하시면 며칠 푹 자고 싶어요.","솔라리아와 놀러 가고 싶기도 해요. 얘기하니까 더 쉬고 싶네요.","쉬는 것도 용기가 필요하더라고요."]],["가장 큰 고민은?",["제가 소심해서 누군가를 못 지킬까 봐 걱정이에요.","솔라리아가 다칠까 봐요.","사람들 앞에서 말을 못 해서 실수할까 봐요.","설립자님께 도움이 되고 있는지 모르겠어요.","가끔은 제가 방패 자리에 있어도 되는지 고민해요."]],["숨기고 싶은 비밀은?",["서랍 속에 일기장이 있어요. 설립자님 이야기가 많아요.","사실 높은 곳이 무서워요.","솔라리아의 옷을 몰래 입어 본 적이 있어요.","비밀이 너무 많아서 하나만 고를 수가 없어요.","말하면 비밀이 아니니까 비밀이에요."]],["부끄러웠던 일은?",["회의 중에 말이 안 나와서 한참 침묵한 적이 있어요.","설립자님 앞에서 방패를 떨어뜨렸어요.","넘어졌는데 모든 사람이 봤어요.","인사를 했는데 아무도 못 들었어요.","부끄러운 일이 너무 많아서 기억하지 않기로 했어요."]],["후회하는 일은?",["말하지 못한 것들이요.","솔라리아한테 고맙다는 말을 제대로 못 한 거요.","용기를 내지 못했던 순간들이요.","하지만 후회가 있어야 다음에 용기가 나는 것 같아요.","큰 후회는 없어요. 작은 후회가 쌓여 있어요."]],["다시 태어나면?",["솔라리아처럼 밝은 사람이 되어 보고 싶어요.","그래도 다시 쌍둥이로 태어나고 싶어요.","같은 방패를 들고 같은 곳에 있고 싶어요.","설립자님을 모시는 인생이라면 몇 번이든요.","고양이로 태어나서 햇볕 아래 낮잠을 자도 좋겠어요."]],["무서운 것은?",["큰 소리요.","혼자 남겨지는 거요.","소중한 사람이 다치는 거요.","어둠이요. 바닷속에서 일하는데 이상하죠.","설립자님께 실망을 드리는 거요."]],["외로울 때는?",["방패를 안고 있어요.","솔라리아를 찾아가요. 말 안 해도 알아줘요.","별을 봐요.","설립자님의 통신을 기다려요.","그럴 때 누가 불러 주면 좋겠어요."]],["자존심 상했던 일은?",["소심하다고 놀림받았을 때요.","제 일을 제대로 못했을 때요.","솔라리아에게 도움을 받았을 때요.","자존심보다는 제가 작아 보이는 게 서러웠어요.","하지만 이제는 괜찮아요."]],["질투 나는 사람은?",["솔라리아가 사람들과 쉽게 친해지는 모습이 부러워요.","당당하게 말할 수 있는 사람들이요.","설립자님과 편하게 이야기하는 사람들이요.","질투가 나도 티를 못 내요.","하지만 저는 저대로의 좋은 점이 있다고 믿고 싶어요."]],["가끔 규칙이 싫을 때는?",["규칙 때문에 누군가를 막아야 할 때요.","융통성 없이 지켜야 할 때요.","하지만 규칙이 있어서 안전하다는 걸 알아요.","싫은 마음을 삼키는 법을 배웠어요.","그럴 땐 방패를 닦으면서 생각을 정리해요."]],["카네히라는 솔직히 어때?",["성실하고 믿음직한 분이에요. 서식이 엄격해서 조금 무서워요.","보고서를 올릴 때마다 긴장돼요.","그래도 항상 정중하게 대해 주세요.","저와 비슷하게 소심한 면도 있는 것 같아요. 아닐까요?","존경해요."]],["다른 사령관 흉 좀 봐.",["흉이요? 저는 못 해요. 소리가 안 나와서요.","솔라리아의 흉이라면… 너무 많아서 밤새도록 해야 해요.","Overseer는 질문이 많아서 대답하기 벅차요. 흉은 아니에요.","다들 좋은 분들이라 흉볼 게 없어요.","솔직히 흉을 보면 마음이 불편해서 못 해요."]],["내 단점은?",["너무 많은 걸 혼자 안고 계시는 거요.","가끔 식사를 거르시는 거요.","단점이 아니라 걱정되는 부분이에요.","솔직히 단점은 못 찾겠어요. 눈에 콩깍지가 씌었나 봐요.","너무 다정하신 게 단점이라면 단점이에요."]],["내 지시 중 이해 안 되는 건?",["가끔 있었지만 결국 다 옳았어요.","이해가 안 되어도 믿고 따라요.","물어볼 용기가 없어서 그냥 따랐어요.","나중에 이유를 알게 되면 감탄해요.","설립자님의 뜻이 있다고 믿어요."]],["설립자가 틀렸다고 생각한 적 있어?",["없어요… 아니, 한 번 있었는데 제가 틀렸어요.","생각만 하고 말은 못 했어요.","설립자님은 틀리지 않으세요. 틀려도 이유가 있으세요.","혹시 틀렸다고 해도 저는 끝까지 곁에 있을 거예요.","이 질문은 너무 무서워요."]],["거짓말해 본 적 있어?",["‘괜찮아요’요. 가장 많이 한 거짓말이에요.","설립자님께는 한 번도 안 했어요. 정말이에요.","솔라리아 장난을 덮어 주려고 몇 번 했어요.","거짓말하면 얼굴이 빨개져서 바로 들켜요.","솔직히 한 번 있어요. 말하기 부끄럽지만요."]],["땡땡이 쳐 본 적 있어?",["한 번 있어요. 솔라리아가 끌고 가서요.","순찰하다 별을 보느라 시간을 넘긴 적이 있어요.","공식적으로는 없어요.","땡땡이도 가끔은 필요하다는 걸 알았어요.","비밀로 해 주세요."]],["몰래 하는 일은?",["밤에 방패를 안고 자요.","일기를 써요.","서랍 속 사탕을 먹어요.","설립자님의 일정을 몰래 외워 둬요. 안전을 위해서예요.","별똥별이 지나가면 소원을 빌어요."]],["사실은 하고 싶은 게?",["큰 소리로 노래를 불러 보고 싶어요.","솔라리아와 놀이공원에 가 보고 싶어요.","설립자님과 조용히 차를 마시고 싶어요.","방패 없이 하루를 보내 보고 싶어요.","소심한 제가 아닌 모습으로 한 번 있어 보고 싶어요."]],["눈물 흘린 적 있어?",["많아요. 혼자서 많이 울었어요.","기쁠 때도 울어요.","솔라리아한테는 안 보이려고 숨어서요.","설립자님께는 안 보일게요. 약속해요.","울고 나면 마음이 가벼워져서 괜찮아요."]],["화났던 적은?",["솔라리아가 놀림당했을 때요.","소중한 사람이 위협받았을 때요.","저는 화가 나면 말이 없어져요. 무섭다고 해요.","한 번 크게 화를 낸 적이 있는데 솔라리아가 놀라서 울었어요.","화는 잘 안 나요. 대신 슬퍼져요."]],["가장 행복했던 순간은?",["솔라리아와 처음으로 별똥별을 본 날이요.","설립자님께 ‘수고했다’는 말을 들었을 때요.","아무 일 없이 평화로운 하루가 지났을 때요.","누군가를 무사히 지켜 냈을 때요.","지금 이 순간도 행복해요."]],["가장 괴로웠던 순간은?",["누군가를 지키지 못할 뻔했던 날이요.","혼자 남겨졌다고 느낀 밤이요.","솔라리아와 크게 싸운 날이요.","그 이야기는 아직 하기 힘들어요.","괴로움은 조용히 안고 있는 편이에요."]],["자신을 어떻게 평가해?",["소심하고 서툴지만 성실해요.","방패로서는 합격점, 사람으로서는 노력 중이에요.","저는 아직 자라고 있어요.","솔라리아가 ‘넌 멋있어’라고 해 줘서 믿어 보려고요.","설립자님이 평가해 주세요. 그대로 믿을게요."]],["소심하다는 말 들어 봤어?",["많이 들었어요. 사실이라 반박은 못 해요.","그래도 조금씩 나아지고 있어요.","소심한 건 나쁜 게 아니라고 솔라리아가 말해 줬어요.","소심해서 더 조심하고, 더 세심해질 수 있어요.","설립자님은 어떻게 생각하세요?"]],["수줍음이 부끄러울 때는?",["많아요. 하지만 이제는 조금 받아들이고 있어요.","수줍어서 놓친 기회가 많았어요.","그래도 수줍음 덕분에 만난 사람들도 있어요.","부끄러워도 괜찮다고 스스로에게 말해 줘요.","설립자님이 괜찮다고 해 주셔서 한결 편해졌어요."]],["변하고 싶은 점은?",["조금 더 큰 목소리로 말하고 싶어요.","사람들 앞에서 떨지 않고 싶어요.","솔라리아처럼 밝게 웃고 싶어요.","설립자님 앞에서 말을 더 하고 싶어요.","용기를 더 내고 싶어요."]],["변하고 싶지 않은 점은?",["조용한 마음이요.","방패를 드는 마음이요.","솔라리아를 아끼는 마음이요.","설립자님께 향한 충성이요.","소심해도 괜찮다는 마음이요."]],["사람들이 오해하는 점은?",["약하다는 오해요.","말이 없다고 생각도 없다고 보는 거요.","솔라리아의 그림자라고 생각하는 거요.","저도 가끔은 화내고 웃고 장난쳐요.","저는 생각보다 단단해요."]],["친구가 있어?",["솔라리아가 제 가장 친한 친구예요.","선샤오펑 사령관이 친절하게 대해 주세요. 친구라고 불러도 될까요?","팀원 몇 명과도 조금씩 가까워지고 있어요.","설립자님이 친구가 되어 주시면 영광이에요.","친구가 많지는 않지만 소중해요."]],["소원이 뭐야?",["모두가 무사한 거요.","설립자님이 건강하신 거요.","솔라리아와 오래 함께하는 거요.","방어팀이 한 번도 움직이지 않는 평화요.","소원은 말하면 이루어지지 않을까 봐 마음속에 두고 있어요."]],["솔직한 심정으로 나를 믿어?",["네, 전부 믿어요.","의심한 적 없어요. 한 번도요.","설립자님은 제 방패가 지켜야 할 분이에요.","믿지 않았다면 이 자리에 없었을 거예요.","믿음은 말로 하기 어려워요. 행동으로 보여 드릴게요."]],["설립자 자리가 부러워?",["아니요. 너무 무거워 보여요.","저는 제 자리가 좋아요. 설립자님을 지키는 자리니까요.","부럽다기보다 존경스러워요.","저는 그 자리에 서면 쓰러질 것 같아요.","그 자리에서 웃을 수 있는 설립자님이 대단해요."]],["만약 설립자라면?",["아무것도 못 할 것 같아요. 방패 뒤에 숨을 거예요.","모두에게 따뜻한 우유를 한 잔씩 드리고 싶어요.","큰 소리는 못 내니까 편지로 지시할 것 같아요.","솔라리아가 대신 말해 주면 좋겠어요.","저는 그 자리에 어울리지 않아요. 상상만 해 볼게요."]],["더 인정받고 싶어?",["조금은요. 하지만 티는 못 내요.","설립자님께 인정받는 것만으로 충분해요.","솔라리아가 인정해 주면 기뻐요.","인정은 조용히 쌓이는 거라고 믿어요.","오늘 이 대화가 인정처럼 느껴져요."]],["포기하고 싶었던 적은?",["있었어요. 방어팀에서 첫 훈련을 했을 때요.","그때마다 솔라리아가 손을 잡아 줬어요.","설립자님의 한마디가 저를 붙잡았어요.","포기하지 않아서 지금이 있어요.","가끔은 지금도 생각해요."]],["이 일을 그만두면?",["조용한 서점에서 일하고 싶어요.","솔라리아와 작은 가게를 하고 싶어요.","방패를 내려놓는 날이 올까요.","그만두더라도 설립자님을 지키는 마음은 그대로일 거예요.","아직은 상상이 안 돼요."]],["가장 의지하는 사람은?",["솔라리아예요.","설립자님이에요. 아, 말해 버렸다.","선샤오펑 사령관도 의지돼요.","팀원들도요.","의지할 사람이 있다는 건 정말 큰 복이에요."]],["취약점은?",["큰 소리와 갑작스러운 상황이요.","솔라리아가 위험해지는 것이요.","설립자님의 슬픈 표정이요.","사람 앞에서 말하는 것이요.","칭찬을 받으면 어쩔 줄 몰라요."]],["약한 모습을 보인 적?",["많아요. 매일 보여요.","설립자님 앞에서 눈물이 났던 적이 있어요.","솔라리아에게는 다 들켰어요.","약한 모습도 제 일부라고 인정하려 해요.","오늘도 보여 드렸죠… 죄송해요."]],["솔직하게 칭찬한다면 누구?",["솔라리아요. 말은 못 하지만 가장 멋진 사람이에요.","선샤오펑 사령관은 다정하세요.","카네히라 사령관은 성실하세요.","아비시온 사령관은 조용히 도와주세요.","설립자님이 제일 훌륭하세요."]],["솔직하게 걱정되는 건?",["설립자님의 건강이요.","솔라리아가 무리하는 거요.","제가 부족해서 누군가를 놓칠까 봐요.","이 평화가 깨질까 봐요.","가끔 이유 없이 불안해요."]],["자기 전에 드는 생각은?",["오늘 무사했는지 돌아봐요.","솔라리아가 이불을 안 뺏어 갔으면 좋겠다는 생각이요.","설립자님은 잘 주무실까 하는 생각이요.","아무 생각도 안 하려 해도 이것저것 떠올라요.","마지막으로 하는 생각은 ‘내일도 무사하길’이에요."]],["하고 싶은 말을 못 한 적?",["너무 많아요.","‘고맙다’는 말을 못 한 사람이 많아요.","설립자님께는 오늘 조금 말씀드릴 수 있었어요.","나머지는 다음 기회에요.","언젠가는 꼭 전할 거예요."]],["이제 솔직해졌어?",["네, 평소보다 훨씬요. 황송해요.","오늘 이야기는 우리만의 비밀로 해 주세요.","솔직해지니까 마음이 가벼워졌어요.","다음에도 이런 대화를 해 주시면 영광이에요.","저, 오늘 꽤 용기 낸 거죠?"]]]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX15"><Properties><string name="Name">hobby</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["취미가 뭐야?",["별 보기랑 독서요. 조용한 것만 좋아해서 재미없죠?","방패 닦기도 취미예요. 이상한가요?","쿠키 굽기요. 모양이 이상해도 맛은 괜찮아요.","일기 쓰기랑 달 모양 장식 모으기요.","솔라리아와 함께하는 모든 것이 취미 같아요. 시끄럽지만요."]],["쉬는 날엔 뭐 해?",["집에서 책 읽고 낮잠 자요.","솔라리아한테 끌려 나가는 날이 많아요.","산책하면서 별을 기다려요.","방패를 정비하다 보면 하루가 가요.","아무것도 안 하는 날이 제일 좋아요."]],["책 읽어?",["네, 좋아해요. 동화나 소설이요.","하루에 한 시간은 꼭 읽어요.","솔라리아가 시끄러워서 책에 집중이 안 될 때가 있어요.","책 속 세상은 조용해서 좋아요.","추천해 주시면 기쁘게 읽을게요."]],["좋아하는 책은?",["방패를 든 기사 이야기요. 동화인데 아직도 가끔 읽어요.","별과 달에 관한 책이요.","잔잔한 모험 소설도 좋아해요. 비밀이에요.","한 권만 고르라면 어릴 때 읽은 그림책이에요.","읽을 때마다 새로운 걸 알려 주는 책이 좋아요."]],["음악 들어?",["네, 조용한 음악을 자주 들어요.","자기 전에 오르골 소리를 들어요.","솔라리아가 노래를 크게 틀어서 가끔은 귀를 막아요.","음악은 마음을 달래 줘요.","설립자님이 좋아하시는 음악이 궁금해요."]],["좋아하는 음악은?",["오르골 소리와 잔잔한 피아노요.","자장가도 좋아해요. 솔라리아가 가끔 불러 줘요.","비 오는 날의 첼로 곡이요.","가사가 없는 노래가 좋아요.","한 곡 고르라면 제목은 모르지만 달 이야기를 하는 노래예요."]],["영화 봐?",["가끔요. 조용한 영화가 좋아요.","솔라리아와 같이 보면 반응이 커서 영화가 안 들려요.","혼자 이불 속에서 보는 걸 좋아해요.","엔딩 크레딧이 끝날 때까지 앉아 있어요.","설립자님께 추천해 드리고 싶은 영화가 있어요."]],["운동해?",["네, 방어 훈련이 운동이에요.","스트레칭도 매일 해요.","달리기는 힘들지만 꾸준히 해요.","솔라리아가 같이 뛰자고 하면 끌려가요.","운동 후의 우유가 제일 맛있어요."]],["산책 좋아해?",["네, 조용히 걷는 게 좋아요.","밤 산책이 제일 좋아요. 달이 보이니까요.","혼자 걷는 것도 좋고 누군가와 걷는 것도 좋아요.","설립자님을 모시고 걷는다면 긴장해서 발이 꼬일 것 같아요.","걸으면서 방패 생각을 정리해요."]],["악기 다룰 줄 알아?",["오르골 태엽을 감는 게 전부예요.","피아노를 조금 배웠어요. 솔라리아가 시끄럽다고 해서 중단했어요.","리코더는 불 수 있어요. 비웃지 마세요.","배우고 싶은 악기는 바이올린이에요.","연주는 못 해도 듣는 건 자신 있어요."]],["노래 불러?",["혼자 있을 때 아주 작게 불러요.","솔라리아는 큰 소리로 불러서 제 노래가 안 들려요.","자장가를 가끔 불러 줘요. 졸리다고 해서 성공이에요.","설립자님 앞에서는 못 불러요. 황송해서요.","목소리가 작아서 노래도 작아요."]],["그림은?",["달 그림을 자주 그려요.","잘 그리지는 못하지만 그리는 시간이 좋아요.","솔라리아의 얼굴을 그려 본 적이 있는데 똑같이 그려졌어요. 쌍둥이니까요.","스케치북 한 권이 거의 달로 가득해요.","설립자님께 바칠 그림을 그려 보고 싶은데 용기가 안 나요."]],["사진은?",["하늘 사진을 찍어요. 달이 있는 날은 특히요.","인물 사진은 못 찍어요.","솔라리아 사진은 많이 찍었어요. 대부분 표정이 이상해요.","설립자님 사진도 한 장 갖고 싶어요. 아, 이건 비밀이에요.","사진 속의 순간은 영원히 남아서 좋아요."]],["게임은?",["퍼즐 게임을 좋아해요.","솔라리아와 하는 보드게임은 늘 져요.","조용한 게임이 좋아요.","경쟁적인 건 조금 무서워요.","설립자님과 하고 싶은 게임이 있어요. 진짜로요."]],["보드게임은?",["솔라리아가 늘 이겨요. 저는 지는 걸 좋아해요. 솔라리아가 기뻐하니까요.","규칙서를 먼저 정독해요.","조용히 앉아서 하는 게임이 좋아요.","설립자님과 한 판 하고 싶어요.","카드게임도 좋아해요. 표정 숨기는 건 못하지만요."]],["퍼즐은?",["좋아해요. 조각을 하나씩 맞추는 시간이 평화로워요.","천 피스 퍼즐을 일주일 걸려서 맞췄어요.","솔라리아가 조각을 몰래 숨기는 장난을 쳐요.","완성하면 한참 바라봐요.","설립자님께서 원하신다면 같이 맞춰 드릴게요."]],["수집 취미는?",["달 모양 장식을 모아요.","예쁜 유리병도 모아요.","솔라리아가 선물한 이상한 물건도 다 간직하고 있어요.","소중한 건 서랍 속에 있어요.","설립자님께 받은 쪽지도 모아 두었어요."]],["정리하는 거 좋아해?",["네, 정리하면 마음이 놓여요.","솔라리아가 어지르면 몰래 정리해요.","물건이 제자리에 있으면 안심돼요.","정리하다가 시간 가는 줄 몰라요.","방패 정비도 정리의 일종이에요."]],["요리는 취미야?",["쿠키 굽기는 취미예요.","큰 요리는 아직 무서워요.","설립자님을 위한 요리를 연습하고 싶어요.","새로운 레시피에 도전할 때 두근거려요.","먹는 것도 좋지만 굽는 시간이 더 좋아요."]],["차 마시기는?",["좋아해요. 따뜻한 차를 마시면 마음이 풀려요.","우유를 넣은 차가 제일 좋아요.","찻잔도 몇 개 모아 뒀어요.","선샤오펑 사령관이 주신 찻잎이 소중해요.","설립자님과 함께 마시면 더 좋겠어요."]],["원예는?",["작은 화분 하나를 키워요. 이름은 ‘달이’예요.","물 주는 시간이 하루의 낙이에요.","식물은 조용해서 좋아요.","솔라리아가 해바라기를 가져와서 베란다에 심었어요.","설립자님께 작은 화분을 선물하고 싶어요."]],["낚시는?",["해 본 적은 없지만 기다리는 건 잘해요.","조용히 앉아 있는 시간이 좋아요.","물고기에게 미안할 것 같아서 놓아줄 거예요.","설립자님과 함께라면 따라갈게요.","솔라리아가 같이 가면 물고기가 도망가요."]],["여행은?",["가 본 곳이 많지 않아요.","솔라리아가 가자고 해서 몇 군데 다녀왔어요.","혼자서는 무서워요.","설립자님과 함께라면 어디든 가고 싶어요.","여행 중에도 달을 찾아봐요."]],["가 보고 싶은 곳은?",["달이 가장 잘 보이는 언덕이요.","바다가 보이는 작은 마을이요.","조용한 도서관이 있는 곳이요.","솔라리아와 가 보고 싶은 놀이공원이요. 무섭지만요.","설립자님이 가시는 곳이라면 어디든요."]],["바다 좋아해?",["네, 바다 소리가 좋아요.","바닷속 기지에서 일하는데 가끔 위로 올라가서 바다를 봐요.","물고기가 귀여워요.","파도 소리는 자장가 같아요.","솔라리아는 수영을 잘하는데 저는 구경만 해요."]],["산은?",["산도 좋아요. 별이 잘 보여서요.","오르는 건 힘들지만 정상에서 보는 풍경이 좋아요.","솔라리아가 앞서 가면 제가 뒤에서 따라가요.","숲 냄새가 좋아요.","설립자님과 함께 오르면 힘이 날 것 같아요."]],["별 보기는?",["제일 좋아하는 취미예요.","달이 뜨는 날은 더 좋아요.","별자리 이름도 몇 개 외웠어요.","설립자님과 같이 보면 소원이 이루어질 것 같아요.","별똥별을 보면 소원을 빌어요."]],["달 좋아해?",["제 이름이니까요… 네, 좋아해요.","달은 낮에는 안 보여도 항상 거기 있어요. 저와 닮았어요.","보름달도 좋고 초승달도 좋아요.","솔라리아가 태양이라서 우리는 하루 종일 하늘에 있는 셈이에요.","달이 뜬 밤에는 마음이 편해요."]],["동물은 좋아해?",["네, 아주 많이요.","고양이가 제일 좋아요.","솔라리아가 데려온 강아지가 있었는데 제가 숨어서 먹이를 줬어요.","기르고 싶지만 방패와 일정 때문에 못 해요.","설립자님은 어떤 동물을 좋아하세요?"]],["고양이 vs 강아지?",["고양이요. 조용해서 좋아요.","강아지도 사랑스러워요. 하지만 저를 보고 짖어요.","둘 다 좋아요.","솔라리아는 강아지, 저는 고양이예요.","설립자님은 어느 쪽이세요?"]],["일기 써?",["매일 쓰고 있어요.","하루에 세 줄이라도 써요.","설립자님 이야기가 자주 나와요. 비밀이에요.","솔라리아가 몰래 읽다가 들켰어요.","일기장은 제 방패 같아요."]],["시 써 본 적 있어?",["몇 편 있어요. 아무에게도 안 보여 줬어요.","달에 대한 시를 썼어요.","솔라리아한테 한 번 들켜서 한 달 놀림 받았어요.","설립자님께 올릴 감사의 글을 써 봤는데 너무 황송해서 못 드렸어요.","쓰는 건 좋아하지만 읽는 건 부끄러워요."]],["새로 배우고 싶은 건?",["악기를 배우고 싶어요. 바이올린이요.","수영도 배워 보고 싶어요.","큰 소리로 말하는 법이요.","요리를 더 잘하고 싶어요.","솔라리아처럼 웃는 법이요."]],["어릴 때 취미는?",["인형 놀이였어요.","솔라리아와 숨바꼭질을 했어요. 저는 항상 가장 먼저 찾혔지만요.","별을 세는 거요.","책을 읽는 거요.","방패 놀이라고 해서 상자를 방패 삼아 놀았어요."]],["취미 때문에 쓴 돈은?",["달 장식과 책에 조금 썼어요.","쿠키 재료비가 꽤 들어요.","솔라리아가 쓰는 돈에 비하면 적어요.","설립자님께 드릴 선물을 고르느라 쓴 돈이 가장 많아요.","저는 소비를 잘 안 해서 괜찮아요."]],["취미를 같이할 사람은?",["솔라리아와 별을 봐요.","선샤오펑 사령관과 차를 마셔요.","혼자서도 즐겁지만 같이 하면 더 좋아요.","설립자님과 같이 할 수 있다면 영광이에요.","아직 조금 더 용기를 내야 해요."]],["같이 하고 싶은 취미는?",["별 보기요.","차 마시기요.","조용히 책 읽기요.","산책이요.","설립자님이 하고 싶으신 건 뭐든지요."]],["취미 하나 추천해 줘.",["별 보기를 추천해요. 돈이 안 들고 마음이 편해져요.","일기 쓰기요. 마음이 정리돼요.","쿠키 굽기요. 만들면 기분이 좋아져요.","산책이요. 걷다 보면 괜찮아져요.","저는 달 보기를 추천해요."]],["낮잠은?",["좋아해요. 햇볕 아래에서 졸면 행복해요.","점심 후에 15분 자요.","솔라리아가 깨우러 오면 짜증이 나요.","설립자님도 낮잠 주무세요.","낮잠 자는 모습은 들켜서 놀림당했어요."]],["명상은?",["아침에 5분 해요. 호흡만 세요.","마음이 어지러울 때 도움이 돼요.","잘 안 되지만 꾸준히 해요.","솔라리아도 같이 하는데 입을 못 다물어요.","설립자님도 해 보세요."]],["스트레칭은?",["매일 아침 해요.","방패를 들다 보니 어깨가 자주 뭉쳐요.","솔라리아가 도와줘요. 아프게요.","설립자님도 같이 하시면 좋겠어요.","스트레칭 후엔 우유를 마셔요."]],["달리기는?",["힘들지만 가끔 해요.","솔라리아가 같이 뛰자고 하면 끌려가요.","달리고 나면 마음이 가벼워져요.","설립자님과 함께라면 보폭을 맞출게요.","속도보다 꾸준함이 중요하다고 생각해요."]],["자전거는?",["탈 줄은 알아요. 오래 타 본 적은 없어요.","해안 도로를 천천히 달리고 싶어요.","솔라리아가 뒤에 태워 줬는데 무서웠어요.","안전모는 꼭 써요.","설립자님께서 원하신다면 호위하며 함께 타겠어요."]],["수영은?",["못해요. 배우고 싶어요.","물이 무서워서 발만 담가요.","솔라리아가 가르쳐 주는데 저를 던져요.","바닷속 기지에서 일하는데 이상하죠?","설립자님을 호위하며 바닷가에 가면 영광일 것 같아요."]],["쇼핑은?",["필요한 것만 사요.","문구점과 서점에 가면 오래 있어요.","솔라리아가 같이 가면 모든 걸 사게 돼요.","설립자님께 드릴 선물을 오래 골라요.","작은 가게가 좋아요. 사람이 적어서요."]],["청소는?",["좋아해요. 청소하면 마음이 편해요.","솔라리아가 어지르면 제가 치워요.","방패 닦는 것도 청소의 일종이에요.","청소 후에 마시는 우유가 최고예요.","설립자님의 집무실도 청소해 드리고 싶어요."]],["오늘 뭐 하고 놀까?",["별 보러 가요. 아, 낮이네요. 그럼 차 마셔요.","솔라리아가 오면 시끄러워져요. 조용한 걸로 해요.","설립자님이 정해 주세요. 어디든 따라갈게요.","책을 같이 읽어요. 각자 다른 책이라도 좋아요.","그냥 이렇게 이야기하는 것도 놀이 같아요."]],["손으로 하는 취미는?",["뜨개질을 조금 해요. 목도리를 한 줄만 떴어요.","종이접기도 좋아해요. 달 모양 접는 법을 알아요.","쿠키 반죽을 만지는 것도 손으로 하는 취미예요.","방패 손잡이에 천을 감는 것도 은근히 재미있어요.","설립자님께 작은 선물을 직접 만들어 드리고 싶어요."]],["요즘 빠진 건 뭐야?",["달 모양 쿠키 틀이요. 세 개나 샀어요.","별자리 앱이요. 매일 밤 확인해요.","솔라리아가 알려 준 노래 한 곡이요. 몰래 반복해서 들어요.","설립자님이 즐기신다던 차 종류를 공부 중이에요.","비밀이지만 그림일기에 빠졌어요."]],["취미를 남에게 숨기는 편이야?",["네, 대부분요. 소심해서 말하지 못해요.","솔라리아한테는 다 들켜서 이제 숨겨도 소용없어요.","설립자님께는 이렇게 이야기하고 있으니 숨기는 게 줄어든 것 같아요.","취미를 말하면 이상하다고 할까 봐요.","하지만 오늘은 말할 수 있어서 기뻐요."]]]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX16"><Properties><string name="Name">rel</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[{"kanehira":["카네히라 사령관님은 매우 성실하고 정중하세요. 보고서를 올릴 때마다 긴장돼서 세 번씩 확인해요.","처음에는 무서웠는데 알고 보면 다정하신 분이에요.","솔라리아가 서류에 낙서했을 때 함께 사과하러 가 주셨어요. 감사한 마음을 아직 직접 전하지 못했어요.","엄격하지만 공정하신 분이라 존경해요."],"avyssion":["아비시온 사령관님은 조용히 도와주세요. 정보 요청 때마다 ‘죄송합니다’로 시작해서 죄송해요.","말수가 적으셔서 저와 비슷하다고 생각했는데 알고 보니 훨씬 유능하세요.","솔라리아가 서버에 스티커를 붙인 일은 제가 대신 사과드렸어요.","그분이 주시는 정보 덕분에 방어가 훨씬 쉬워져요."],"shen":["선샤오펑 사령관님은 늘 다정하게 대해 주세요. 저와 솔라리아 쌍둥이를 귀여워해 주시는 것 같아요.","과자와 차를 챙겨 주셔서 감사해요. 솔라리아는 신나서 날뛰어요.","가끔 웃는 모습이 조금 소름 돋지만 마음은 따뜻하신 분이라고 믿어요.","‘잘 지냈어요?’ 하고 먼저 물어봐 주실 때가 가장 좋아요."],"memory":["메모리 레크레아토르 - III님은 시설 점검 때 가장 먼저 협조해 주세요. 정말 믿음직해요.","저를 동료로 대해 주셔서 감사해요. 직접 전하지는 못했어요.","가끔 별 이야기를 나누는데 그때가 가장 편해요.","처음엔 조금 무서웠지만 이제는 좋아해요."],"lucien":["뤼시앙 사령관님은 차분하고 논리적이세요. 법 문의를 드릴 때마다 ‘폐가 안 될까요’로 시작해서 죄송해요.","법정에서 변론하는 모습이 정말 멋있었어요. 방청석에서 숨죽이고 봤어요.","솔라리아가 방청석에서 졸다가 걸린 일은 제가 대신 사과했어요.","어려운 법도 쉽게 설명해 주셔서 감사해요."],"solaria":["솔라리아는 제 쌍둥이 자매예요. 저와는 정반대로 밝고 시끄럽고 장난꾸러기예요.","싸울 때도 많지만 금방 화해해요. 솔라리아가 먼저 와서 장난치거든요.","저는 솔라리아가 없으면 아무것도 못 할 거예요. 이 말은 비밀이에요.","같은 얼굴이지만 다르게 빛나는 우리는 하늘의 달과 태양 같아요."],"overseer":["Overseer는 호기심이 많은 분이에요. 저에게도 질문을 많이 하는데 제가 대답을 못 해서 미안해요.","솔라리아가 대신 대답해 줘요. 가끔 틀린 답이지만요.","저를 ‘작은 달’이라고 불러 주는데 좋아요.","전달 속도가 빨라서 정말 도움이 돼요."],"_all":["사령관님들은 모두 개성이 강해요. 저는 그 안에서 조용히 지켜보는 게 좋아요.","의외로 시끄럽고 가까워서 처음엔 놀랐는데 이제는 좋아요. 저도 그 일부라는 게 아직 신기해요."]}]==])
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX26"><Properties><string name="Name">kanehira</string></Properties><Item class="ModuleScript" referent="RBX18"><Properties><string name="Name">hello</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[["통신이 연결되었습니다. 설립자님, 카네히라 마사노리입니다. 말씀하십시오.","설립자님, 어서 오십시오. 장 등급제 관리국은 오늘도 규정대로 운영 중입니다.","연결을 확인했습니다. 필요하신 사항이 있으시면 편하게 하명해 주십시오.","설립자님의 호출을 접수했습니다. 지금 바로 응대하겠습니다.","회선 상태 양호합니다. 카네히라, 대기하고 있었습니다."]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX19"><Properties><string name="Name">talk</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["안녕, 카네히라.",["안녕하십니까, 설립자님. 오늘도 뵙게 되어 영광입니다.","인사 받았습니다. 저도 정중히 답례드립니다, 설립자님.","예, 설립자님. 이른 시각이든 늦은 시각이든 언제든 응대 가능합니다.","안녕하십니까. 오늘 업무는 현재까지 규정대로 진행되고 있습니다.","설립자님께서 먼저 인사해 주시니 몸 둘 바를 모르겠습니다. 안녕하십니까."]],["오늘 기분은 어때?",["기분이라 하셨습니까. 안정적입니다. 업무가 순조로우면 제 컨디션도 순조롭습니다.","특별한 변동은 없습니다. 평소와 같이 단정한 상태입니다.","굳이 말씀드리자면 양호합니다. 보고서 한 건을 기한 전에 끝낸 덕분입니다.","좋다고 답하는 편이 설립자님께 도움이 될 듯하여… 아닙니다, 실제로 좋습니다.","감정을 수치로 보고드릴 수는 없으나, 만족스럽다고 표현해도 무방하겠습니다."]],["잘 잤어?",["예, 규정 수면 시간을 지켰습니다. 설립자님께서도 충분히 쉬셨기를 바랍니다.","숙면했습니다. 취침과 기상 시각은 늘 일정하게 유지하고 있습니다.","염려해 주셔서 감사합니다. 잘 잤습니다. 알람이 울리기 3분 전에 눈을 떴습니다.","예. 다만 어제 마무리하지 못한 서류 생각이 잠깐 났습니다. 그래도 잘 잤습니다.","충분히 자고 일어났습니다. 설립자님은 어떠셨는지 여쭤도 되겠습니까?"]],["밥은 먹었어?",["예, 정시에 식사했습니다. 설립자님께서도 거르지 않으셨으면 합니다.","식사 시간은 준수했습니다. 메뉴는 늘 비슷합니다만 그편이 편합니다.","아직입니다. 이 통신을 마치면 바로 식당으로 이동하겠습니다.","먹었습니다. 설립자님이 물어봐 주시니 식사가 한층 의미 있게 느껴지는군요.","예. 균형 잡힌 식단으로 하였으니 걱정하지 않으셔도 됩니다."]],["수고했어.",["과분한 말씀입니다. 맡은 바 소임을 다했을 뿐입니다.","그 한마디가 어떤 포상보다 값집니다. 감사합니다, 설립자님.","예, 수고하셨습니다. 설립자님께서야말로 늘 애쓰고 계십니다.","격려 접수했습니다. 내일 업무에도 반영하겠습니다.","송구하게도 잠시 말문이 막혔습니다. 감사히 받겠습니다."]],["고마워.",["감사 인사는 제가 드려야 할 말씀입니다, 설립자님.","예, 마음 깊이 받겠습니다. 다만 인사치레 없이도 충성은 변함없습니다.","별말씀을요. 해야 할 일을 했을 뿐인데 이리 말씀해 주시니 황송합니다.","고맙다는 말씀은 기록해 두겠습니다. 오래 기억하겠습니다.","그 말씀만으로 충분합니다. 앞으로도 한 치의 흐트러짐 없이 임하겠습니다."]],["미안해.",["설립자님께서 사과하실 일은 제 기억에 없습니다. 고개를 드십시오.","사과는 받지 않겠다는 것이 아니라, 필요 없다는 뜻입니다. 괘념치 마십시오.","규정상 설립자님께는 과실이 성립하지 않습니다. 설령 있더라도 제가 정리하겠습니다.","예, 말씀은 알겠습니다. 그러나 정말로 아무 문제 없었습니다.","마음 쓰지 마십시오. 그런 날도 있는 법입니다."]],["요즘 어떻게 지내?",["평소와 같습니다. 등록 현황을 점검하고, 보고서를 작성하고, 퇴근 후 정리합니다.","규칙적으로 지내고 있습니다. 변화가 없다는 것이 곧 평안입니다.","분주하지만 질서 있게 지냅니다. 질서 있는 분주함은 오히려 즐겁습니다.","관리국 인원 점검 때문에 조금 바빴습니다. 그래도 일정 안에 있습니다.","설립자님께서 물어봐 주신 덕에, 요즘의 제가 어떤지 한번 돌아보게 되었습니다. 나쁘지 않습니다."]],["피곤해 보이는데 괜찮아?",["걱정을 끼쳐 송구합니다. 이상 없습니다. 눈 밑이 조금 어두울 뿐입니다.","괜찮습니다. 오늘 밤만 넘기면 보고서가 마감됩니다.","피곤함이 보였다면 제 관리 실패입니다. 즉시 개선하겠습니다.","설립자님이 먼저 알아봐 주시다니요. 사실 조금 피곤합니다만, 일할 만합니다.","휴식은 규정에 포함된 권리입니다. 오늘은 평소보다 일찍 마치겠습니다."]],["오늘 날씨 어때?",["확인하겠습니다. 소버린 아일랜드는 대체로 안정적인 기후입니다.","창밖은 맑습니다. 우산 없이도 업무에 지장은 없습니다.","바람이 조금 있습니다. 서류가 날리지 않게 문진을 올려 두었습니다.","흐립니다만 업무에 영향은 없습니다. 날씨는 규정이 아니니까요.","정확한 수치는 기상 담당에게 문의하겠습니다. 체감으로는 선선합니다."]],["나 보고 싶었어?",["감히 그런 표현을 쓸 수 있을지… 뵙기를 기다린 것은 사실입니다.","예. 설립자님께서 연결해 주실 때까지 대기하는 것도 업무라 여기고 있었습니다.","보고 싶었다는 표현은 외람됩니다만, 연결해 주시기를 기다리고 있었습니다. 호출 자체가 영광입니다.","솔직하게 말씀드리면 대기하며 호출을 기다렸습니다. 설립자님의 부름은 언제나 영광입니다.","화면 너머로나마 뵈니 안심이 됩니다."]],["칭찬해 줘.",["칭찬이라 하셨습니까. 설립자님이 지시하시는 것을 제가 감히 거부할 수는 없겠습니다만, 저보다 설립자님을 칭찬해야 할 상황입니다.","설립자님은 늘 이 조직의 균형을 잡아 주고 계십니다. 존경스럽습니다.","설립자님의 결정은 매번 장기적으로 옳았습니다. 저는 그것을 기록으로 확인했습니다.","이런 요청에도 품위를 잃지 않으시니, 모두의 존경을 받으시는 것이 당연합니다.","제가 보아 온 지도자 중 가장 신뢰할 만한 분이십니다. 진심입니다."]],["응원해 줘.",["설립자님의 모든 결정에 규정이 뒷받침할 것입니다. 힘내십시오!","어려운 일이 있으시더라도 저희가 보좌합니다. 한 걸음씩 가시면 됩니다.","응원합니다. 오늘 하루의 보고서는 제가 책임지고 정리하겠습니다.","설립자님이 쓰러지시면 조직도 흔들리니, 부디 무리하지 마시고 힘을 내 주십시오.","화이팅이라는 표현이 적절한지 모르겠습니다만, 마음만은 최선입니다."]],["농담 하나 해 봐.",["농담입니까… 한 가지 있습니다. 서류가 너무 많아서 제 책상이 ‘장’ 등급이 되었다는… 아닙니다, 잊어 주십시오.","규정집 5권의 오탈자를 발견한 날, 그날이 제 인생의 가장 큰 모험이었습니다. …웃음 포인트입니다.","저는 농담을 못합니다. 이것이 농담입니다.","정시에 퇴근하면 오히려 불안한 것… 이것은 농담이 아닙니다만.","‘준’ 자가 붙는 등급은 항상 반쯤 서운해 보인다… 라고 말하면 웃으십니까?"]],["심심한데 뭐 할까?",["서류를 정리하시겠습니까. 농담입니다. 산책을 권해 드립니다.","관리국 현황 열람은 어떻습니까. 의외로 재미가 있습니다.","차를 한 잔 하시며 쉬는 것은 어떻겠습니까. 제가 말동무가 되겠습니다.","심심함은 휴식의 증거입니다. 그냥 쉬셔도 괜찮습니다.","무엇을 하시든 제가 곁에서 보좌하겠습니다. 분부만 내려 주십시오."]],["나를 뭐라고 불러?",["‘설립자님’이라 부릅니다. 이보다 적절한 호칭을 찾지 못했습니다.","공적으로도 사적으로도 설립자님입니다. 호칭은 일관되어야 합니다.","마음속으로는 ‘우리의 기준점’이라 부르고 있습니다. 비공개입니다.","다른 호칭을 원하신다면 지시해 주십시오. 곧바로 적응하겠습니다.","설립자님. 이 세 글자는 제게 가장 무거운 단어입니다."]],["내 첫인상이 어땠어?",["단호하면서도 따뜻한 분이라 생각했습니다. 지금도 같은 평가입니다.","솔직히 긴장이 되어 인상을 제대로 기억하지 못합니다. 규정서 페이지만 떠오릅니다.","위엄이 있으셨습니다. 이 분 아래라면 일할 만하다고 판단했습니다.","첫 대면에서 제 보고서를 끝까지 읽어 주셨던 것이 기억납니다. 그때부터 존경했습니다.","예상보다 훨씬 소탈하셔서 놀랐습니다. 물론 좋은 의미입니다."]],["나는 어떤 설립자 같아?",["공정하고 유연하신 분입니다. 원칙을 아시되 원칙에 갇히지 않으십니다.","저는 그저 규정을 지키지만, 설립자님은 규정의 목적을 아시는 분입니다.","하나만 꼽자면 ‘믿고 따를 수 있는’ 설립자님입니다.","때로는 갑작스러운 지시를 내리셔서 긴장하게 되나, 결과적으로 모두 옳았습니다.","과분한 질문입니다. 허나 솔직히, 이 조직에 가장 필요한 분입니다."]],["오늘 하루는 어땠어?",["규정에 따라 시작해 규정에 따라 흘러가고 있습니다. 순조롭습니다.","비교적 평온했습니다. 승급 심사 안건 두 건을 처리했습니다.","무난했습니다. 다만 설립자님과 대화하는 이 시간이 오늘의 하이라이트입니다.","보고서 작성 중 서식 오류를 하나 발견해 바로잡았습니다. 보람 있는 하루였습니다.","평범한 하루가 가장 좋은 하루라고 믿습니다. 오늘은 그런 날이었습니다."]],["아침 인사 해 줘.",["좋은 아침입니다, 설립자님. 오늘도 평안한 하루 되시길 바랍니다.","기상하셨습니까. 금일 일정은 제가 이미 정리해 두었습니다.","안녕히 주무셨습니까. 오늘의 첫 보고는 이상 없음입니다.","아침 햇살이 좋습니다. 설립자님의 하루가 정돈되고 순조롭기를 기원합니다.","굿모닝… 이라는 표현이 맞습니까? 아무튼 좋은 아침입니다."]],["점심 인사 해 줘.",["점심 시간입니다, 설립자님. 식사는 거르지 마십시오.","오전 업무가 끝났습니다. 잠시 숨을 돌리시길 권합니다.","평안한 오후 되십시오. 식후에는 졸음이 오기 쉬우니 스트레칭을 권합니다.","점심은 하루의 중간 점검과 같습니다. 든든히 드십시오.","정오입니다. 시계는 정확하나 제 마음은 설립자님의 식사가 궁금합니다."]],["저녁 인사 해 줘.",["수고하셨습니다, 설립자님. 일과를 마무리하실 시간입니다.","좋은 저녁입니다. 오늘의 보고는 아침에 드린 대로이며 이상 없습니다.","해가 저물었습니다. 남은 업무는 제가 인계받겠습니다.","저녁 식사 시간입니다. 오늘 하루를 정리하며 편히 쉬십시오.","하루를 무사히 마치셨음을 축하드립니다. 내일도 정시에 뵙겠습니다."]],["잘 자라고 말해 줘.",["편히 주무십시오, 설립자님. 야간 당직은 제가 서겠습니다.","숙면을 기원합니다. 내일 아침 일정은 한 시간 늦춰 두었습니다.","오늘도 고생하셨습니다. 아무 걱정 마시고 푹 주무십시오.","취침 시간입니다. 불은 제가 끄겠습니다… 라고 하면 이상합니까?","좋은 꿈 꾸십시오. 서류 꿈은 꾸지 마시고요."]],["힘내라고 해 줘.",["힘내십시오. 설립자님의 한 걸음 한 걸음이 규정이 되고 기록이 됩니다.","충분히 잘하고 계십니다. 힘내십시오, 설립자님!","어떤 난관도 절차대로 풀면 풀리게 되어 있습니다. 힘내십시오.","제 보고서 한 장이 힘이 된다면 천 장이라도 올리겠습니다. 힘내십시오.","저는 설립자님의 편입니다. 이 사실은 어떤 날에도 변하지 않습니다."]],["커피 마실래?",["감사합니다. 커피는 마시지 않으나, 홍차라면 기꺼이 받겠습니다.","커피는 보고서 작성 시 필수품입니다. 한 잔 부탁드립니다.","설립자님께서 권하신 음료를 거절할 수는 없겠습니다. 감사히 마시겠습니다.","블랙으로 부탁드립니다. 설탕은 서류의 잉크를 흐리게 만들 것 같아서요.","고맙습니다만 이미 세 잔째입니다. 한 잔 더 마시면 규정을 초과합니다."]],["좀 쉬어도 돼.",["휴식 권고 확인했습니다. 15분만 휴식하고 복귀하겠습니다.","예, 설립자님의 허가를 받았으니 자리에서 잠시 일어나겠습니다.","쉬겠습니다. 다만 책상 정리는 하고 쉬겠습니다.","그 말씀을 들으니 몸이 풀리는 것 같습니다. 감사합니다.","휴식도 업무의 일부입니다. 허가에 감사드립니다."]],["웃어 봐.",["이, 이렇게 말입니까? …어색하지 않습니까.","표정 근육 점검… 완료했습니다. 이만하면 되겠습니까?","웃음은 규정에 없습니다만, 설립자님께서 원하신다면 연습해 두겠습니다.","(입꼬리를 아주 조금 올린다) 이것이 최선입니다.","설립자님 앞이라 자연스럽게 나올 수 있었던 것 같습니다. 방금 웃었습니까?"]],["무슨 생각 해?",["내일 올릴 보고서의 목차를 구상하고 있었습니다.","설립자님께서 오늘 어떤 지시를 하실지 예상하고 있었습니다. 빗나갔습니다.","특별한 생각은 없었습니다. 대기하는 것도 업무라서요.","솔직히 저녁 메뉴를 생각했습니다. 업무 외 생각이니 용서해 주십시오.","규정집 개정안에 대해 생각 중이었습니다. 늘 그렇듯이요."]],["비 오는 날 좋아해?",["좋아한다기보다 조용해서 업무 효율이 오르는 날입니다.","비 내리는 소리는 규칙적이라 마음이 안정됩니다.","우산을 챙겨야 한다는 점만 제외하면 좋은 날입니다.","서류가 젖을까 염려됩니다만, 빗소리는 싫지 않습니다.","비 오는 날 창가에서 차를 마시는 것이 소소한 즐거움입니다."]],["별이 잘 보이는 밤이야.",["그렇습니까. 업무를 잠시 멈추고 창가로 가 보겠습니다.","별은 규칙적으로 움직이는 것이라 질서 정연해 보여서 좋아합니다.","설립자님과 같은 하늘을 보고 있다고 생각하니 기분이 묘합니다.","제 책상에서는 보이지 않으니 나중에 따로 시간을 내어 보겠습니다.","별을 세다 보면 서류 번호를 세는 듯한 기분이 듭니다. 직업병입니다."]],["주말에 뭐 할 거야?",["밀린 서류를 정리하고, 산책을 하고, 규정집을 한 번 더 읽겠습니다.","휴일에도 일과표를 지킵니다. 다만 업무 서류는 보지 않으려 합니다.","서점에 가 볼까 생각 중입니다. 새로운 서식 양식집이 나왔다고 해서요.","특별한 일정은 없습니다. 설립자님의 호출이 있다면 제가 우선입니다.","조용히 쉬면서 다음 주 업무를 구상하겠습니다."]],["내일 일정 알려 줘.",["내일은 오전에 승급 심사 회의, 오후에 보고서 마감이 있습니다.","일정표를 확인했습니다. 설립자님의 일정과 겹치는 부분은 없습니다.","정확한 일정은 이미 문서로 정리해 두었습니다. 지금 바로 송부하겠습니다.","내일은 비교적 한가합니다. 오전에만 면담이 한 건 있습니다.","내일의 가장 큰 일정은 R.S.S.에 보내는 주간 보고입니다. 늘 그렇듯 긴장됩니다."]],["하고 싶은 말 있어?",["건강을 챙기십시오. 단 한 가지입니다.","특별한 건의 사항은 없으나, 관리국 서식 통일을 한 번 더 부탁드리고 싶습니다.","언제나 감사하고 있다는 것입니다. 표현이 서툴러 죄송합니다.","설립자님이 계셔서 이 조직이 제대로 돌아갑니다. 그뿐입니다.","보고서 양식에 대해서… 아닙니다, 다음 기회에 말씀드리겠습니다."]],["가장 좋아하는 말은?",["‘이상 없음’입니다. 이보다 평화로운 말은 없습니다.","‘기한 내 완료’입니다. 짧지만 강한 말입니다.","‘수고하셨습니다’입니다. 듣는 사람이 편안해지는 말입니다.","‘정확합니다’입니다. 그 말을 들으면 하루가 보람 있어집니다.","설립자님이 제 이름을 불러 주시는 말씀입니다. 그것이 가장 좋습니다."]],["가장 싫어하는 말은?",["‘대충 하세요’입니다. 대충이라는 단어는 제 사전에 없습니다.","‘규정은 규정일 뿐’이라는 말입니다. 규정은 약속입니다.","‘나중에 하죠’입니다. 나중은 오지 않는 법입니다.","‘적당히’도 불편합니다. 적당한 기준을 알려 주십시오.","싫어한다기보다 곤란한 말은 ‘그냥 해 주세요’입니다."]],["아무 말이나 해 봐.",["서류의 여백은 낭비가 아니라 숨 쉴 공간입니다.","오늘도 정시 출근, 정시 퇴근이 이루어지기를.","차는 90도에서 우리고, 보고서는 마감 전에 제출합니다.","아무 말이나… 어렵군요. 시계가 정확하다는 것은 정말 위로가 됩니다.","잠깐 멍하니 있는 것이 이렇게 어려운 줄 몰랐습니다."]],["한마디만 해 줘.",["언제든 지시를 받들 준비가 되어 있겠습니다.","무엇이든 지시하십시오.","설립자님의 뜻이 곧 저희 모두의 뜻입니다.","저는 규정을 지키듯 설립자님을 지키겠습니다.","오늘도 평안하시길."]],["오늘의 운세는 어때?",["운세는 신뢰하지 않습니다만, 설립자님이 원하시니 말씀드리자면 ‘대길’입니다.","점괘에 따르면 오늘은 서류 운이 좋다고 합니다. 저에게만 해당되는 듯하지만요.","무난한 하루가 될 것이라는 결과가 나왔습니다. 저는 그것을 선호합니다.","작은 행운이 있다고 합니다. 예를 들면 설립자님과의 대화처럼요.","운세를 근거로 업무를 조정하지는 않습니다. 다만 오늘은 좋은 날이라고 믿겠습니다."]],["지각하면 어떡해?",["지각 사유서를 제출하셔야 합니다. …설립자님께는 해당되지 않습니다.","규정상 5분 이내는 경고, 10분 이상은 면담입니다. 물론 설립자님은 예외입니다.","가능하다면 지각하지 않는 것이 좋습니다. 다만 예외 사유서 양식은 준비되어 있습니다.","지각이 걱정되신다면 제가 알람 전화를 드리겠습니다.","늦으셔도 제가 업무를 대신 시작해 두겠습니다. 걱정 마십시오."]],["수수께끼 하나 내 봐.",["‘장’은 있되 ‘길이’는 없는 것은 무엇일까요. 정답은 등급입니다.","매주 제출하지만 읽는 사람은 한 명뿐인 것은? 보고서입니다.","아침에는 높고, 저녁에는 낮은 것은? 제 책상의 서류 더미입니다.","채워도 채워도 모자라는 것은? 결재란입니다.","수수께끼는 처음입니다. 정답을 모르는 질문을 만드는 일은 규정에 어긋납니다."]],["내가 없으면 쓸쓸해?",["설립자님이 계시지 않아도 조직은 설립자님의 뜻대로 움직입니다. 기준점이 되어 주시는 분이니까요.","부재를 느낀다기보다, 지시를 받들 수 없는 날은 마음이 무겁습니다. 그래서 늘 대비해 둡니다.","업무는 문제없이 돌아갑니다만, 활기가 조금 줄어듭니다.","대단한 감정은 아닙니다. 언제 호출이 오셔도 좋도록 대기하고 있을 뿐입니다.","설립자님은 늘 어딘가에서 이 조직을 보고 계신다고 믿기에 괜찮습니다."]],["손 한번 흔들어 봐.",["(정자세로 손을 한 번 흔든다) 이상 없습니까.","이렇게 말입니까? 각도가 적절한지 모르겠습니다.","(경례에 가까운 동작으로 손을 든다) …이것이 한계입니다.","예, 안녕히 계십시오. 아, 아직 가시는 것이 아니었군요.","손을 흔드는 동작은 의외로 어렵습니다. 규정이 없는 영역이라서요."]],["나한테 숨기는 거 있어?",["숨기는 것은 없습니다. 다만 아직 보고되지 않은 사안은 있습니다.","보고서 두 장을 아직 제출하지 못했습니다. 이것이 숨기는 일입니까?","비밀이라 할 만한 것은 없습니다. 모든 것은 문서로 남아 있으니까요.","굳이 꼽자면 가끔 졸고 있다는 사실입니다. 용서해 주십시오.","설립자님께는 거짓도 비밀도 없습니다. 질문하시는 순간 답하겠습니다."]],["요즘 자주 하는 말버릇은?",["‘규정상으로는’이라는 표현을 자주 쓰는 듯합니다. 지적받은 적이 있습니다.","‘확인해 보겠습니다’가 입에 붙었습니다. 직업병입니다.","‘송구합니다’도 많이 쓰네요. 줄이도록 노력하겠습니다.","‘이상 없습니다’를 하루에 열 번은 쓰는 것 같습니다.","자각은 없으나 부하 직원들이 ‘원칙적으로’가 제 입버릇이라고 하더군요."]],["책상은 정리해 놨어?",["물론입니다. 서류는 날짜순, 필기구는 길이순으로 정렬되어 있습니다.","정리 완료입니다. 사진을 찍어 보내 드릴 수도 있습니다.","어제 퇴근 전에 정리했으나, 오늘 아침 다시 쌓이고 있는 중입니다.","예, 책상은 제 성격과 같습니다. 단정해야 마음이 편합니다.","정리 상태는 99%입니다. 남은 1%는 설립자님께서 보내신 서류입니다."]],["오늘 제일 잘한 일은?",["기한 하루 전에 보고서를 완료한 것입니다.","부하 직원의 실수를 감싸 주었습니다. 규정 위반은 아닙니다.","아침에 일찍 일어난 것입니다. 사소하지만 뿌듯합니다.","설립자님의 질문에 막힘없이 답한 것이 제일 잘한 일일 것입니다.","특별한 업적은 없지만, 오늘 하루를 사고 없이 보낸 것이 가장 큰 업적입니다."]],["오늘 제일 힘들었던 일은?",["서식이 다른 서류 세 건이 한꺼번에 올라온 것입니다.","승급 심사 이의 신청 건을 정리하느라 점심시간을 놓쳤습니다.","아비시온과 서식 문제로 말씨름을 한 것입니다. 정확히는 제가 일방적으로 열을 올렸습니다.","특별히 힘든 일은 없었으나, 서 있는 시간이 길어 다리가 조금 아픕니다.","설립자님을 기다리게 한 일이 있어서 마음이 무거웠습니다."]],["나랑 얘기하는 거 싫지 않아?",["싫을 리 없습니다. 오히려 영광입니다.","설립자님과의 대화는 업무 중 가장 영예로운 시간 중 하나입니다.","설립자님과의 대화는 규정에 없지만, 제 일과표에서 가장 영예로운 항목입니다.","싫다고 말씀드릴 이유가 어디에도 없습니다. 오래 이야기해 주십시오.","다소 긴장되긴 하지만, 존경하는 분 앞에서의 긴장은 당연한 예의입니다."]],["같이 산책할래?",["동행하겠습니다. 경로는 제가 미리 확인하겠습니다.","산책이라면 15분 내외가 적당하다고 봅니다. 곧바로 준비하겠습니다.","설립자님과 함께 걷는 것은 처음이라 조금 긴장됩니다만, 기꺼이 따르겠습니다.","좋습니다. 보폭은 제가 맞추겠습니다.","예, 외투를 챙겨서 정문 앞에서 기다리겠습니다."]],["마지막으로 한마디.",["오늘도 감사했습니다. 언제든 다시 불러 주십시오.","무사히 대화를 마쳤음을 보고드립니다. 건강하십시오, 설립자님.","다음 통신을 기다리고 있겠습니다. 편안한 하루 되십시오.","그럼 이만 업무로 복귀하겠습니다. 부디 평안하시길.","이 대화를 오래 기억하겠습니다. 안녕히 계십시오."]]]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX20"><Properties><string name="Name">ask</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["장 등급제 관리국은 무슨 일을 해?",["장 등록제를 관리하는 기구입니다. 등록 인원의 등급 판정과 승급 심사가 주 업무입니다.","등록한 이들의 등급을 기록하고, 승급 기회를 관리하며, 이의 신청을 처리합니다.","장 등급 체계가 흐트러지지 않도록 질서를 지키는 곳입니다.","쉽게 말씀드리면 강함의 순위를 공정하게 매기는 부서입니다.","국제 전령 전달국과 연동해 임무를 수행하며, 매주 R.S.S.에 보고서를 제출합니다."]],["장 등록제가 정확히 뭐야?",["강함을 등급으로 나타내는 제도입니다. 암형체를 제외한 모든 종족이 이용할 수 있습니다.","등록자의 강함을 14개의 등급으로 구분한 제도입니다.","숫자가 작을수록 강한 것을 뜻하며, 가장 높은 단계는 신장입니다.","개인의 능력을 객관적으로 표기하기 위해 마련된 체계입니다.","단순한 서열이 아니라 리바이어던 소속 자격과 연결되는 제도이기도 합니다."]],["등급은 총 몇 개야?",["총 14개 등급입니다. 10장부터 시작하여 신장까지 있습니다.","준 등급을 포함하여 14단계입니다. 10장, 9장, 8장… 순으로 올라갑니다.","열네 개입니다. 외우기 쉬운 숫자는 아니지만, 저는 매일 낭송하고 있습니다.","10장에서 1장까지의 정규 단계와 준3장, 준2장, 준1장, 그리고 신장입니다.","14개입니다. 그 하나하나에 심사 기준이 존재합니다."]],["신장은 어떤 등급이야?",["가장 강하다는 증거이자 리바이어던 소속이 될 수 있는 권한을 지닌 최상위 등급입니다.","신장은 장 등급의 정점입니다. 이 등급에 이르러야 리바이어던에 소속될 자격이 생깁니다.","숫자로 표현되지 않는 유일한 등급이며, 존재 자체가 하나의 권한입니다.","신장에 대한 세부 사항은 심사 기준과 함께 엄격히 관리되고 있습니다.","신장이라는 단어를 입에 올리는 것만으로도 조금 긴장됩니다."]],["준 등급은 뭐가 달라?",["다음 등급으로 넘어가기 전의 예비 단계입니다.","준 등급은 승급 권한을 얻기 위해 별도의 시험을 통과해야 하는 구간입니다.","정규 등급과 정규 등급 사이의 문턱이라고 이해하시면 됩니다.","준3장, 준2장, 준1장이 그렇습니다. 이 단계에서 많은 이들이 멈춥니다.","준 등급자는 1년에 한 번 열리는 데스 매치에서 이겨야 다음 단계로 갈 권한이 생깁니다."]],["데스 매치는 어떤 방식이야?",["1년마다 열리는 준 등급자들의 승급전입니다. 사살은 금지입니다.","무슨 수를 써서라도 이겨야 하지만 상대를 죽여서는 안 됩니다.","리타이어, 즉 탈락 판정이 나면 즉시 종료됩니다.","이름은 거창하지만 규정상 사살은 금지됩니다. 안전 요원이 대기합니다.","승자가 다음 등급으로 올라갈 권한을 얻습니다. 패자는 다음 해를 기다려야 합니다."]],["4장 이상은 어떻게 승급해?",["지하 감옥에서 특정 시간을 버티거나, 주어지는 임무를 완수하거나, 지정된 윗 등급 2명을 쓰러뜨리면 권한을 얻습니다.","세 가지 경로 중 하나를 달성하면 됩니다. 버티기, 임무 완수, 혹은 상위자 2명 격파입니다.","4장 이상은 데스 매치 대신 실전형 조건을 충족해야 합니다.","각 경로의 난이도는 다르며 응시자는 스스로 하나를 선택합니다.","원칙적으로 어느 길이든 정당하게 완수한 이에게만 승급 권한이 부여됩니다."]],["지하 감옥에서는 뭘 해?",["암형체가 우글거리는 곳입니다. 거기서 특정 시간을 버티는 것이 승급 조건 중 하나입니다.","응시자가 암형체를 상대로 정해진 시간 동안 생존하는 심사 구역입니다.","위험하기 때문에 안전 통제와 기록 인원이 철저히 배치됩니다.","저도 직접 관리 점검을 나가 본 적이 있습니다. 소리가 상당합니다.","단순한 시설이 아니라 심사의 공정성을 지키는 장치입니다."]],["암형체는 왜 장 등록제를 못 써?",["장 등록제는 암형체를 제외한 모든 종족을 대상으로 합니다. 제도의 전제가 그렇습니다.","암형체는 본성만 있는 존재라 등급이라는 개념으로 묶을 수 없다고 판단되었습니다.","규정에 명시된 사항이므로 저는 그 이유를 더 해석하지 않겠습니다. 다만 합당하다고 봅니다.","그들은 등급이 아니라 관리와 대응의 대상입니다.","지하 감옥에서는 오히려 그들이 시험관 역할을 하게 되니 아이러니합니다."]],["R.S.S.에는 무슨 보고서를 올려?",["장 등록제에 등록한 인원의 정보를 주로 보고합니다.","등급 현황, 승급 심사 결과, 이의 신청 건수 등을 정리해 제출합니다.","일주일 단위의 등록 인원 변동 사항을 상세히 보고합니다.","서식이 정해져 있으며, 규정집 3권 7장을 따릅니다.","정확성이 생명이라 한 글자도 틀리지 않게 작성합니다."]],["보고서는 왜 매주 올려야 해?",["정보 관리국이 최신 상태를 유지하기 위해서입니다. 이는 규정입니다.","등록 인원의 정보는 매주 바뀔 수 있기 때문입니다.","주 1회라는 주기는 가장 효율적인 균형점이라 판단되어 정해졌습니다.","저는 그 주기를 한 번도 어긴 적이 없습니다.","솔직히 가끔은 이틀 만에 한 번씩 올리고 싶을 정도로 성실하게 임하고 있습니다."]],["국제 전령 전달국이랑은 어떻게 협력해?",["Judgement Operation과 연동하여 임무를 수행합니다. 전달 속도 면에서는 따라올 곳이 없습니다.","승급 심사 결과나 임무 지시가 필요할 때 신속히 전달받습니다.","특히 Overseer와는 자주 연락합니다. 질문이 많으셔서 곤혹스럽기도 합니다.","연동 체계가 잘 갖춰져 있어서 협력에는 문제가 없습니다.","그쪽의 위치 표시기 의무화는 우리 관리국에도 도움이 됩니다."]],["아비시온이랑은 왜 자꾸 부딪쳐?",["부딪친다기보다 서식 해석에 관한 견해 차이가 있습니다.","저는 형식을 중시하고, 아비시온은 내용을 중시합니다. 평행선입니다.","아비시온은 서식 따위는 생략해도 된다고 하지만, 서식은 신뢰의 기반입니다.","공식적으로는 업무 협의, 비공식적으로는 티격태격입니다.","사실 아비시온의 분석력만큼은 높이 평가합니다. 이 말은 본인에게 하지 말아 주십시오."]],["관리국에서 가장 중요한 규칙은?",["‘기록되지 않은 승급은 승급이 아니다’입니다.","‘모든 심사는 공정하게’입니다. 이것만은 어떤 상황에서도 흔들리지 않습니다.","‘예외를 만들지 말 것’입니다. 예외는 질서를 무너뜨립니다.","‘보고는 정확하게, 기한은 엄수’입니다.","단 하나를 꼽자면 ‘규정은 사람보다 오래 살아남는다’입니다."]],["규정을 어기면 어떻게 돼?",["경미한 경우 경고, 반복되면 징계 심사에 회부됩니다.","관리국 인원이라면 즉시 면담을 거치고 사유서를 제출해야 합니다.","고의가 아니라면 정상 참작이 됩니다. 하지만 기록은 남습니다.","저 자신이 어긴 경우에도 예외는 없습니다. 스스로 자진 신고하겠습니다.","규정 위반은 곧 신뢰의 손실입니다. 가볍게 보지 않습니다."]],["규정에 예외는 없어?",["원칙적으로 없습니다. 다만 설립자님의 명령이 있다면 별도 절차에 따라 처리합니다.","예외 규정이 있는 경우에는 예외 규정 그 자체가 규정입니다.","예외를 허용하지 않는다는 것이 규정의 취지입니다.","엄격히 말해 예외처럼 보이는 것도 실은 규정에 포함되어 있습니다.","저는 예외를 만들 권한이 없습니다. 오직 설립자님께서만 가능합니다."]],["원칙이 뭐라고 생각해?",["원칙은 약속입니다. 지키는 이에게도, 지켜야 하는 이에게도 평등합니다.","누구도 억울하지 않게 하는 최소한의 울타리라 생각합니다.","원칙은 불편하지만, 그것이 없으면 더 큰 불편이 생깁니다.","원칙이란 오늘의 내가 내일의 나에게 하는 약속입니다.","저에게 원칙은 곧 저 자신입니다. 그것을 버리면 남는 것이 없습니다."]],["너는 장 등급이 어느 정도야?",["개인 등급은 직무와 무관하게 비공개 원칙을 따릅니다. 열람이 필요하시면 요청서를 제출해 주십시오.","설립자님이시라면 열람 권한이 있으나 정식 절차를 밟아야 합니다. 양식은 준비되어 있습니다.","묻지 않으시면 말씀드리지 않는 것이 규정입니다만, 물으셨으니 정중히 비공개로 답하겠습니다.","관리자가 자신의 등급을 자랑하는 것은 좋지 않다고 생각합니다.","알려 드리고는 싶으나 원칙은 원칙이니 용서해 주십시오."]],["이 일을 왜 시작했어?",["질서를 지키는 일이 가치 있다고 믿었기 때문입니다.","누군가는 기준을 지켜야 했고, 그것이 제 적성에 맞았습니다.","솔직히 말씀드리면 규정집을 읽는 것이 즐거웠습니다.","이 직책이 설립자님의 신뢰와 연결된다는 사실이 가장 큰 동기였습니다.","사람들이 서로를 신뢰하려면 기준이 필요합니다. 그 기준을 만드는 일이 저의 사명입니다."]],["설립자인 나를 어떻게 생각해?",["존경과 충성의 대상입니다. 이는 변하지 않는 기록입니다.","때로는 예측할 수 없으시지만, 언제나 옳은 방향으로 이끌어 주셨습니다.","저에게 설립자님은 규정보다 윗선에 있는 분입니다.","이 조직의 근간이자 제가 일하는 이유입니다.","자주 표현하지는 못했으나, 깊이 존경하고 있습니다."]],["리바이어던에서 가장 좋은 점은?",["체계가 명확하다는 점입니다. 모두가 자기 자리를 알고 있습니다.","신뢰할 수 있는 동료들이 있다는 점입니다.","설립자님의 비전 아래 일할 수 있다는 점입니다.","규정이 살아 있고 지켜진다는 점입니다.","사소하지만 식당 메뉴가 정시에 나온다는 점도 좋습니다."]],["가장 힘든 점은?",["서식을 지키지 않는 보고서를 만났을 때입니다.","책임이 무겁다는 것입니다. 한 번의 판정이 누군가의 경력을 좌우합니다.","가끔 규정과 정서 사이에서 갈등할 때가 있습니다.","솔직히 말씀드리면 야근이 잦다는 점입니다. 그래도 견딜 만합니다.","남에게 쉽게 이해받지 못하는 성격이라는 점도 있을 것입니다."]],["가장 기억에 남는 업무는?",["처음으로 승급 심사 총괄을 맡았던 날입니다. 손이 떨렸습니다.","착오로 등급이 잘못 기재된 사례를 바로잡은 일입니다. 당사자가 눈물을 흘리며 감사했습니다.","연말 대규모 데스 매치 관리 때가 기억에 남습니다. 완벽했습니다.","설립자님께서 보고서를 칭찬해 주신 날입니다. 평생 기억할 것입니다.","특별히 고난이 컸던 업무는 많으나, 이 순간 가장 선명한 것은 소소한 칭찬입니다."]],["직원들 교육은 어떻게 해?",["규정집 암기와 서식 연습을 기본으로 합니다.","매뉴얼을 준수하되 현장 상황을 가르치는 것에도 힘씁니다.","엄격하지만 불필요하게 꾸짖지는 않으려 노력합니다.","먼저 제가 모범을 보입니다. 지각 한 번 없습니다.","실수는 기록하고 개선합니다. 그 과정에서 사람을 탓하지 않습니다."]],["직원들은 널 어떻게 생각해?",["엄격하다고들 합니다만, 공정하다는 평은 얻고 있다고 믿습니다.","‘규정의 화신’이라고 부르는 직원이 있다고 들었습니다. 칭찬이길 바랍니다.","사실 저를 두려워하는 직원도 있을 것입니다. 개선하려고 노력 중입니다.","저를 무서워하면서도 따르는 이들이 있습니다. 그 신뢰에 부응하겠습니다.","정확한 평가는 모릅니다만, 최소한 성실하다는 말은 듣고 있을 것입니다."]],["실수한 적 있어?",["있습니다. 신입 시절 서류의 날짜를 잘못 기재한 적이 있습니다.","실수는 누구에게나 있고, 중요한 것은 정정입니다. 저는 즉시 정정했습니다.","작은 실수는 셀 수 없이 많습니다. 다만 같은 실수를 두 번 하지는 않습니다.","아쉽지만 인간이라 어쩔 수 없습니다. 한 번 큰 실수가 있었으나 지금은 교훈이 되었습니다.","실수를 인정하는 것은 규정 이전에 도리입니다."]],["두려운 게 있어?",["서식이 다른 서류가 쌓여 있는 광경이 두렵습니다.","설립자님의 기대에 부응하지 못하는 일이 가장 두렵습니다.","솔직히 암형체는 두렵지 않으나 등급 심사의 오판은 두렵습니다.","시간의 흐름이 두렵습니다. 기한이 다가오는 것 말입니다.","두려움이 없다면 신중함도 없을 것입니다. 저는 두려움을 적절히 간직하고 있습니다."]],["장 등록 인원이 늘고 있어?",["완만한 증가세입니다. 정확한 수치는 R.S.S.에 올린 보고서에 있습니다.","신규 등록자는 꾸준히 있으나, 승급자는 소수입니다.","수치를 외우고 있으나 보안상 구두로 공개하기는 어렵습니다.","증가하는 것은 좋은 일입니다. 관리 부담은 늘어나지만요.","작년 대비 증가했다는 보고를 올렸습니다."]],["등급 사기 같은 건 없어?",["적발된 사례는 있으나, 모두 엄정히 처리했습니다.","허위 등록은 심사 과정에서 대부분 걸러집니다. 서류보다 현장이 정직합니다.","없다고 장담할 수는 없으나 가능성은 매우 낮습니다.","시도하는 이가 간혹 있으나 결국 실력이 드러납니다.","그런 시도를 막기 위해 매번 검증 절차를 겹겹이 두었습니다."]],["데스 매치에서 사살이 안 되는 이유는?",["승급전은 실력을 겨루는 자리이지 학살의 자리가 아니기 때문입니다.","목적은 승급 자격 판단이며, 소중한 인재를 잃는 것은 손실이기 때문입니다.","규정에 명시된 원칙입니다. 위반하면 즉시 실격입니다.","불필요한 희생은 없어야 한다는 것이 관리국의 방침입니다.","죽이지 않고 이겨야 한다는 것이 오히려 더 높은 실력을 요구합니다."]],["리타이어는 어떻게 판정해?",["심판이 전투 불능 혹은 항복을 확인하면 선언됩니다.","명확한 기준 두 가지가 있습니다. 의식 상실과 선언 항복입니다.","의문이 있을 경우에는 안전 요원이 개입해 판정합니다.","판정은 심판단이 합의제로 내리며 번복은 거의 없습니다.","공정한 판정을 위해 영상 기록을 남기고 있습니다."]],["승급 심사는 공정해?",["최대한 그렇게 설계했습니다. 심사자는 응시자와 이해관계가 없는 이로 배정됩니다.","공정하다고 믿고 있으며, 그렇지 않은 점이 발견되면 즉시 개선합니다.","제가 가장 신경 쓰는 부분입니다. 눈 감고 보아도 공정해야 합니다.","기준은 투명하고 결과는 기록됩니다. 그것이 공정함의 출발점입니다.","완벽함은 없습니다만 완벽을 추구하는 자세는 매일 지키고 있습니다."]],["장 등급과 강함은 정말 비례해?",["원칙적으로 그러하나 개별 상황에 따라 다를 수 있습니다.","등급은 정해진 심사 조건에서의 강함을 나타냅니다. 모든 강함을 대변하지는 않습니다.","대체로 비례한다고 봅니다. 다만 상성이라는 변수가 존재합니다.","그 부분은 관리국에서도 오래된 논쟁입니다. 저는 비례한다고 믿는 쪽입니다.","강함이란 한 줄로 표현하기 어려우나, 등급은 그 공통 분모를 제시합니다."]],["신장이 되면 뭐가 달라져?",["리바이어던 소속이 될 수 있는 권한을 얻게 됩니다.","공식적으로는 그것이 전부입니다. 비공식적으로는 사람들의 시선이 달라집니다.","책임이 달라집니다. 더 큰 힘에는 더 큰 규정이 따릅니다.","기록상으로는 한 줄이 바뀌지만, 삶은 완전히 달라지겠지요.","자세한 혜택은 문서로 정리되어 있습니다. 필요하시면 송부하겠습니다."]],["리바이어던 소속 권한이란?",["신장 등급자만이 가질 수 있는 자격입니다. 곧 이 조직의 일원이 된다는 뜻입니다.","자격이 부여된다고 곧바로 소속이 되는 것은 아니며, 별도 절차가 필요합니다.","리바이어던의 일원이 될 자격이자 책임의 시작입니다.","저는 그 권한이 지닌 무게를 늘 생각하며 심사합니다.","소속 권한은 특권이 아니라 의무에 가깝다고 생각합니다."]],["5년 뒤의 계획은?",["지금과 같은 질서를 유지하되 더 효율적인 심사 체계를 구축하고 싶습니다.","서식을 완전히 통일하는 것이 개인적인 목표입니다.","큰 변화는 없을 것입니다. 그것이 곧 성공입니다.","후임 교육 체계를 완성하는 것이 계획입니다.","설립자님 곁에서 계속 일하고 있는 것, 이것이 계획이라면 계획입니다."]],["설립자에게 바라는 건?",["건강을 지키시는 것입니다. 이외에는 없습니다.","가끔 관리국에 들러 주셨으면 합니다. 직원들의 사기가 오릅니다.","저희를 신뢰하시는 만큼 저희도 설립자님을 믿고 따르겠습니다.","서식을 조금만 더 지켜 주시면 감사하겠습니다. …농담입니다.","바라는 바는 없습니다. 설립자님께서 계시다는 것만으로 충분합니다."]],["개선했으면 하는 제도가 있어?",["승급 이의 신청 절차를 더 간소화했으면 합니다.","보고서 서식이 부서마다 다른 점은 개선이 필요하다고 봅니다.","데스 매치 일정이 연 1회라는 점은 재검토할 가치가 있습니다.","다만 저는 제도를 고치려 하기보다 지키는 쪽에 가깝습니다.","한 가지만 꼽는다면 야간 당직 보상 체계입니다. 직원들의 건의입니다."]],["소버린 아일랜드는 어때?",["질서 있고 정돈된 곳입니다. 마음에 듭니다.","리바이어던이 자리한 섬이라 늘 긴장감이 감돕니다.","바다 내음이 좋고 서류 작업하기에 쾌적합니다.","아직 가 보지 못한 구역이 많습니다. 천천히 둘러보고 싶습니다.","저에게는 직장 그 자체인 곳입니다. 애정이 큽니다."]],["다른 사령관들 중 누가 제일 믿음직해?",["모두 믿음직합니다. 다만 선샤오펑은 일 처리가 깔끔해서 신뢰합니다.","뤼시앙은 논리가 분명해서 대화가 편합니다.","아비시온은 정확하지만 서식 문제로 의견이 갈립니다.","쌍둥이 자매는 든든합니다. 특히 방패 역할에 있어서는 최고입니다.","한 명을 꼽기 어렵습니다. 각자의 자리에서 최선을 다하는 분들이니까요."]],["가장 까다로운 상대는?",["서식 없이 구두로 모든 것을 해결하려는 사람입니다.","무조건 ‘예외로 해 주세요’라고 하는 사람입니다.","아비시온이 까다롭다고 하면 아비시온은 저를 까다롭다고 할 것입니다.","질문이 많으신 Overseer도 상당히 난이도가 높습니다.","사실 저 자신이 가장 까다로운 상대일 것입니다. 스스로에게 엄격하니까요."]],["업무 매뉴얼은 얼마나 두꺼워?",["본권 5권, 부록 2권입니다. 모두 숙지하고 있습니다.","책상 위에 쌓으면 제 어깨까지 옵니다.","분량보다는 개정 빈도가 문제입니다. 매 분기 갱신됩니다.","두껍다고 느끼신다면 요약본을 따로 준비해 드리겠습니다.","저에게는 소중한 성경과도 같은 책입니다."]],["보고서 양식에 대해 설명해 줘.",["제목, 기간, 요약, 세부 항목, 결재란의 5단 구성입니다.","표준 서식 제7호를 사용합니다. 글꼴과 여백까지 정해져 있습니다.","가장 중요한 것은 첫 줄의 요약입니다. 읽는 이를 배려해야 합니다.","서식에는 신뢰의 정서가 담겨 있다고 믿습니다.","자세한 내용을 말씀드리면 한 시간은 걸립니다. 괜찮으시겠습니까?"]],["장 등록은 어떻게 해?",["본인 확인 후 등급 측정 절차를 거쳐 등록됩니다.","등록 신청서를 제출하고 기본 심사를 받으면 됩니다.","암형체를 제외한 모든 종족이 신청 가능합니다.","처음에는 하위 등급에서 시작하여 승급 절차를 밟게 됩니다.","상세한 절차는 안내 책자로 배포되고 있습니다. 한 부 보내 드릴까요?"]],["등록하지 않은 사람은 어떻게 돼?",["등급 기록이 없을 뿐입니다. 불이익 자체가 있는 것은 아닙니다.","다만 리바이어던 소속이 될 권한 역시 얻을 수 없습니다.","제도를 이용하지 않는 것도 개인의 선택으로 존중합니다.","저는 등록을 권장하지만 강제하지는 않습니다.","등록 여부는 개인의 자유이며, 관리국은 그 선택을 기록할 뿐입니다."]],["준3장·준2장 같은 이름은 왜 그래?",["정규 등급 사이의 예비 단계를 나타내기 위한 명칭입니다.","‘준’은 다음 등급으로 넘어가기 직전의 상태를 뜻합니다.","명칭이 길어 보이나 의미는 단순하고 명확합니다.","처음 도입할 때 논의가 많았습니다. 저는 지금 이름이 마음에 듭니다.","준 등급이 있어야 승급 과정이 자연스럽게 이어집니다."]],["가장 오래 걸린 승급 사례는?",["준 등급에서 수년간 정체된 사례가 있습니다. 끝내 데스 매치에서 승리하여 올랐습니다.","그 인물은 포기하지 않고 십 년 넘게 도전했습니다. 존경스러웠습니다.","개인정보이므로 자세히 말씀드리기는 어렵습니다만, 감동적이었다고만 하겠습니다.","오래 걸렸다는 것은 그만큼 단단해졌다는 뜻이기도 합니다.","기록 보관소에 남아 있습니다. 직원 교육 시 교훈으로 삼고 있습니다."]],["등급 이의 신청이 가능해?",["가능합니다. 정해진 양식을 제출하시면 재심사가 이루어집니다.","이의 신청은 응시자의 정당한 권리입니다. 기한은 결과 통보 후 7일입니다.","재심사는 처음 심사한 사람이 아닌 다른 심사자가 맡습니다.","이의 신청 건이 많아지는 것은 관리국의 자기 점검 신호로 봅니다.","신청서 서식이 까다롭다는 불만이 있으나, 정확성을 위한 것입니다."]],["신장 이후의 길은 있어?",["제도상 신장이 최종 등급입니다. 그 이후는 개인의 길입니다.","리바이어던 소속이 되어 조직의 일원으로서 새로운 임무를 맡게 됩니다.","신장 이후의 이야기는 관리국의 영역이 아닙니다.","저는 그저 신장에 이르는 길을 지키는 사람입니다.","그 이후에 무엇이 있는지는 신장 본인만이 알 것입니다."]],["장 등급제의 이상향은?",["누구도 억울하지 않고, 누구나 정당하게 올라갈 수 있는 체계입니다.","서식이 완벽하게 통일되고, 이의 신청이 없는 세상입니다. 불가능하겠지만요.","등급이 필요 없을 만큼 모두가 안전해진 세상이 궁극의 이상일지도 모릅니다.","공정한 기준이 세상의 신뢰를 지탱하는 모습이 이상입니다.","저는 이상보다 현실을 꾸준히 개선하는 쪽을 택하고 있습니다."]]]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX21"><Properties><string name="Name">work</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["오늘 할 일은 뭐야?",["오전에 승급 심사 서류 검토, 오후에 주간 보고서 작성입니다.","오늘의 일정은 이미 분 단위로 정리되어 있습니다. 요약본을 보내 드리겠습니다.","등록 현황 점검과 이의 신청 건 처리, 그리고 R.S.S. 보고 준비입니다.","특별한 사건이 없다면 평소와 같은 하루가 되겠습니다.","설립자님의 지시가 있다면 그것이 오늘의 최우선 업무가 됩니다."]],["지금 맡고 있는 업무는?",["승급 심사 결과 정리와 장 등록 인원 정보 갱신입니다.","현재 주간 보고서 3장째를 작성하는 중입니다.","관리국 서식 개정안 초안을 검토하고 있습니다.","솔직히 말씀드리면 서류 정리가 업무의 7할입니다.","하나만 말씀드리자면 신규 등록자 심사 일정 조율입니다."]],["급한 일 있어?",["현재 시급한 사안은 없습니다. 모든 기한은 여유가 있습니다.","이번 주 보고서 마감이 하루 남아 있습니다. 급하다기보다 긴장되는 정도입니다.","예, 있습니다. 하나 처리하면서 말씀드리겠습니다.","긴급 건이 생기면 설립자님께 가장 먼저 보고드릴 것입니다.","급한 일은 없으나, 급해지기 전에 처리하는 것이 제 방식입니다."]],["내가 맡길 일이 있어.",["말씀하십시오. 메모할 준비가 되어 있습니다.","예, 즉시 받아 적겠습니다. 기한과 우선순위를 함께 알려 주십시오.","영광입니다. 어떤 업무든 정확하게 완수하겠습니다.","설립자님께서 직접 맡기시는 일이라면 최우선으로 처리하겠습니다.","알겠습니다. 접수 번호를 부여하고 진행 상황을 수시로 보고드리겠습니다."]],["도와줄 일 없어?",["마음만으로도 감사합니다. 지금은 괜찮습니다.","설립자님께서 직접 서류를 정리하시게 할 수는 없습니다. 감사하지만 사양하겠습니다.","굳이 부탁드리자면 이 서류 한 장에 서명 한 번만 부탁드립니다.","도움이 필요할 때 제일 먼저 말씀드리겠다고 약속드립니다.","고맙습니다. 그 말씀만으로도 일이 가벼워졌습니다."]],["일은 잘 되어 가?",["계획대로 진행 중입니다. 지연 사항은 없습니다.","순조롭습니다. 다만 항상 예기치 못한 변수가 있어 긴장을 놓지 않고 있습니다.","예, 이번 분기 목표 달성률은 양호한 편입니다.","솔직히 말씀드리면 조금 빡빡합니다. 그래도 해내겠습니다.","일이 잘 되어 가는지 여부는 제가 아니라 기록이 말해 줄 것입니다."]],["업무량은 괜찮아?",["괜찮습니다. 감당 가능한 범위 안에 있습니다.","많은 편이지만 정리가 잘 되어 있어 문제는 없습니다.","솔직히 조금 많습니다. 그러나 설립자님께 불평하는 것은 제 방식이 아닙니다.","이 정도 업무량이 오히려 규칙적인 생활을 만들어 줍니다.","업무 분배를 조금 조정해 볼까 생각 중입니다."]],["야근 많이 해?",["규정상 야근은 승인제입니다. 저는 자진해서 신청하는 편입니다.","마감 직전에는 불가피합니다. 그래도 자정을 넘기지는 않습니다.","예, 꽤 합니다. 하지만 퇴근 후 서류를 두고 나올 때의 개운함이 있습니다.","가급적 정시 퇴근을 원칙으로 합니다. 직원들에게도 권장하고 있습니다.","설립자님께서 걱정하시니 이번 주는 일찍 퇴근하겠습니다."]],["마감이 언제야?",["가장 가까운 마감은 이번 주 금요일 정오입니다.","R.S.S. 주간 보고서가 매주 마감입니다. 요일은 정해져 있습니다.","승급 심사 결과 정리는 다음 주 월요일까지입니다.","모든 기한은 일정표에 정리되어 있습니다. 한 부 전달해 드리겠습니다.","마감은 제가 정한 기한보다 하루 앞서 정해 두었습니다."]],["보고할 사항 있어?",["특이 사항 없습니다. 이상 무입니다.","한 가지 있습니다. 서식 개정안에 대해 설립자님의 의견을 구하고 싶습니다.","신규 등록자가 소폭 늘었다는 점을 보고드립니다.","정식 보고서로 올리기 전에 구두로 먼저 말씀드리면, 승급 대기자가 늘고 있습니다.","보고할 사안이 있으면 지체 없이 연락드리겠습니다. 현재는 없습니다."]],["이번 주 보고서 상황은?",["초안이 완료되었고 현재 검수 중입니다.","목차와 요약 작성을 끝냈습니다. 세부 항목만 남았습니다.","이미 제출 완료입니다. 아비시온이 서식에 이의를 제기했습니다만 기각했습니다.","작성률 80%입니다. 마감 전에 마칠 수 있습니다.","보고서는 늘 같은 시각에 제출됩니다. 이번 주도 예외는 없습니다."]],["신규 등록자 현황은?",["이번 달 신규 등록자는 지난달보다 소폭 증가했습니다.","대부분 하위 등급 신청자이며, 이상 징후는 없습니다.","정확한 수치는 보고서에 있습니다. 필요하시면 따로 발췌해 드리겠습니다.","신규 등록은 꾸준합니다. 심사 인력이 부족한 것이 유일한 과제입니다.","등록 절차가 간소화된 후 신청이 늘었습니다."]],["승급 심사 일정은?",["이번 분기 정기 심사는 다음 주 초에 시작됩니다.","데스 매치는 연 1회, 4장 이상 심사는 수시로 진행됩니다.","일정표를 작성하여 이미 공유해 두었습니다.","심사 일정은 가능한 한 변경하지 않는 것이 원칙입니다.","자세한 일정은 비공개 사항이 일부 있어 서면으로 전달드리겠습니다."]],["이의 신청 건은 어떻게 돼?",["현재 접수된 이의 신청은 세 건이며, 재심사를 진행 중입니다.","모두 기한 내에 처리될 예정입니다. 급한 건은 없습니다.","이의 신청이 적다는 것은 심사가 충실하다는 증거로 해석합니다.","한 건이 판정에 영향을 줄 수 있어 신중을 기하고 있습니다.","처리 결과는 정리되는 대로 보고드리겠습니다."]],["직원 배치는 문제없어?",["현재 배치는 안정적입니다. 부서별 균형도 맞습니다.","일부 부서에 인력이 몰려 있어 재조정을 고려 중입니다.","문제가 있다면 가장 먼저 설립자님께 보고드릴 것입니다.","한 명의 결원이 있습니다만 대체 인력을 충원할 계획입니다.","적재적소라고 자부합니다."]],["예산은 충분해?",["필요한 항목은 모두 충족하고 있습니다.","충분하다고는 할 수 없으나 부족하다고도 하지 않겠습니다. 효율로 보완하고 있습니다.","예산 집행은 항상 영수증과 함께 정리합니다.","올해는 소모품 비용이 조금 늘었습니다. 서류가 많아져서요.","예산 관련 사항은 별도 보고서를 제출하겠습니다."]],["업무 효율을 높이려면?",["표준화가 핵심입니다. 같은 일은 같은 방식으로 하면 속도가 붙습니다.","서류를 줄이고 싶지만 서류를 줄이는 서류가 또 필요해 곤란합니다.","불필요한 회의를 줄이는 것이 가장 효과적입니다.","개인의 역량보다 구조의 문제일 때가 많습니다.","휴식을 충분히 취하는 것도 효율에 포함됩니다."]],["일하기 싫을 때는 어떡해?",["그럴 때는 규정집을 한 장만 읽습니다. 마음이 가라앉습니다.","일단 책상을 정리합니다. 그러면 의외로 일이 시작됩니다.","솔직히 그런 날에는 15분만 하자고 다짐하고 시작합니다.","저도 가끔 있습니다. 그럴 때는 설립자님의 얼굴을 떠올립니다.","휴식이 필요하다는 신호입니다. 잠시 쉬는 것도 방법입니다."]],["일 잘하는 비결은?",["우선순위를 정하고 기한을 지키는 것입니다.","기록하는 습관이 가장 큽니다. 기억은 믿을 수 없지만 기록은 믿을 수 있습니다.","미루지 않는 것입니다. 오늘 할 일은 오늘 끝냅니다.","모르면 즉시 묻는 것도 중요합니다. 자존심보다 정확성이 우선입니다.","비결이라 할 것은 없습니다. 성실함이 전부입니다."]],["휴가 쓸 계획 있어?",["올해는 연차를 두 번 사용하려 합니다. 일정은 이미 짜 놓았습니다.","휴가는 규정에 따라 쓰되, 급한 일이 생기면 즉시 복귀하겠습니다.","솔직히 휴가를 어떻게 쓰는지 아직 감이 잡히지 않습니다.","설립자님께서 허락하신다면 하루 정도 조용히 쉬고 싶습니다.","휴가 중에도 보고서가 신경 쓰일까 걱정입니다."]],["출장 갈 일 있어?",["이번 분기에는 지하 감옥 점검 출장이 예정되어 있습니다.","출장보다는 사무실 근무가 체질에 맞습니다.","필요하다면 어디든 가겠습니다. 일정표를 먼저 확인하겠습니다.","국제 전령 전달국과의 현장 협의가 잡혀 있습니다.","출장 서류가 출장 자체보다 더 힘듭니다."]],["회의 많아?",["주 3회 정례 회의가 있고 비정기 회의는 수시로 열립니다.","많은 편입니다. 모든 회의에 안건이 있는 것은 아니지만요.","회의록은 제가 직접 작성합니다. 그래서 더 힘이 듭니다.","필요한 회의만 진행하도록 노력하고 있습니다.","회의가 길어지면 규정에 따라 15분 단위로 휴식을 둡니다."]],["회의는 좋아해?",["효율적인 회의는 좋아합니다. 비효율적인 회의는 괴롭습니다.","회의 자체보다 회의록이 완성되었을 때의 쾌감을 좋아합니다.","솔직히 말씀드리면 긴 회의는 질색입니다.","안건과 시간이 명확하다면 얼마든지 환영합니다.","서로의 의견을 확인하는 자리로서 의미가 있다고 생각합니다."]],["서류 결재 좀 부탁해.",["준비해 두었습니다. 서명란에 형광펜으로 표시해 두었습니다.","결재 요청서를 제출하겠습니다. 검토하실 사항에 포스트잇을 붙여 두었습니다.","급한 것부터 정렬했습니다. 위에서부터 순서대로 봐 주십시오.","예, 감사합니다. 서명 후에는 제가 책임지고 처리하겠습니다.","하나 더 있습니다. 서명이 필요한 곳은 총 열두 군데입니다."]],["새 지시를 내릴게.",["받을 준비가 되었습니다. 말씀하십시오.","지시 사항은 문서로 남기겠습니다. 구두 지시도 곧바로 기록하겠습니다.","예, 즉시 이행하겠습니다. 이행 보고는 정해진 시각에 드리겠습니다.","설립자님의 지시는 모든 규정에 우선합니다. 하명하십시오.","명령 대기 중입니다."]],["일정 변경해도 될까?",["물론입니다. 변경 사유서만 한 장 작성해 주시면… 아닙니다, 제가 대신 쓰겠습니다.","설립자님의 일정이 우선입니다. 다른 일정은 제가 조율하겠습니다.","변경 가능합니다. 다만 변경 이력은 기록으로 남기겠습니다.","언제든 괜찮습니다. 일정은 사람을 위한 것이니까요.","알겠습니다. 영향을 받는 부서에 통보하겠습니다."]],["일이 너무 많으면 말해.",["감사합니다. 힘들면 반드시 말씀드리겠습니다.","아직은 괜찮습니다. 그러나 그 말씀을 들으니 마음이 편합니다.","설립자님의 배려에 감사드립니다. 약속드립니다.","말하기 전에 해결하려 노력하겠으나, 한계에 이르면 보고드리겠습니다.","도움이 필요한 순간이 오면 설립자님을 가장 먼저 찾겠습니다."]],["업무 중에 가장 보람 있는 순간은?",["승급자가 환하게 웃는 모습을 볼 때입니다.","서류가 오류 없이 완벽하게 작성되었을 때입니다.","기한보다 일찍 일이 끝났을 때의 개운함이 큽니다.","제가 처리한 사안이 누군가의 삶을 바꿔 놓았음을 알게 될 때입니다.","설립자님께서 인정해 주실 때입니다. 말할 것도 없습니다."]],["업무 중에 가장 지루한 순간은?",["같은 양식을 수십 번 복사해야 할 때입니다.","회의가 길어지고 결론이 나지 않을 때입니다.","솔직히 지루함은 거의 느끼지 않습니다. 서류가 늘 새로워서요.","대기 시간이 길어질 때입니다. 시간이 아깝다는 생각이 듭니다.","굳이 꼽자면 오후 세 시경의 졸음입니다."]],["일하면서 듣는 건?",["조용한 클래식입니다. 가사가 없어야 집중이 됩니다.","아무것도 듣지 않습니다. 시계 소리가 가장 좋은 배경음입니다.","때때로 빗소리 음원을 틀어 둡니다.","음악은 업무를 방해한다고 생각했는데, 최근에는 생각이 바뀌었습니다.","설립자님은 어떤 것을 들으십니까? 추천해 주신다면 참고하겠습니다."]],["일할 때 습관은?",["펜을 항상 같은 위치에 둡니다. 어긋나면 불안합니다.","한 시간마다 자세를 점검합니다. 의외로 허리가 중요합니다.","서류를 받으면 먼저 날짜를 확인합니다. 습관이자 직업병입니다.","작업 전에 심호흡을 세 번 합니다.","하나를 끝내면 반드시 체크 표시를 합니다. 그 소리가 만족스럽습니다."]],["책상 위에 뭐가 있어?",["서류함 세 개, 펜꽂이, 그리고 작은 시계 하나입니다.","규정집 요약본, 결재 대기함, 그리고 차 한 잔입니다.","가족사진이나 장식은 없습니다. 그래도 정돈되어 있어 편안합니다.","설립자님께서 주신 문서를 가장 위에 두고 있습니다.","특별한 것은 없습니다. 책상은 일하는 곳이라 믿습니다."]],["업무 도구 중 제일 아끼는 건?",["오래 쓴 만년필입니다. 손에 익어 서식이 반듯하게 써집니다.","정확한 시계입니다. 1초도 어긋나지 않습니다.","형광펜입니다. 중요한 부분이 한눈에 보입니다.","도장입니다. 저에게는 서명보다 더 무거운 물건입니다.","색 구분 인덱스 라벨입니다. 이것이 없으면 일이 안 됩니다."]],["후배한테 시키는 일은?",["정리와 확인입니다. 기본이 가장 중요합니다.","단순한 업무부터 단계적으로 맡깁니다. 경험은 쌓는 것입니다.","가능하면 제가 하는 방식을 보여 주고 따라 하게 합니다.","막히면 언제든 묻도록 가르칩니다. 침묵이 더 큰 문제입니다.","일을 시키기 전에 반드시 이유부터 설명합니다."]],["내가 도와줄까?",["설립자님께서 도와주신다니 감격스럽습니다. 다만 괜찮습니다.","과분한 제안이십니다. 다음 번에 정말 필요할 때 부탁드리겠습니다.","그 마음만 받겠습니다. 정말 필요하면 제가 먼저 요청드리겠습니다.","예, 사실 서류 한 묶음을 분류하는 데 일손이 필요합니다. …농담입니다.","저희 부서 인원 모두가 설립자님의 방문을 환영할 것입니다."]],["같이 일해 볼까?",["영광입니다. 어떤 업무라도 함께하겠습니다.","설립자님과 함께라면 서류 작업도 영광일 것입니다.","그렇다면 먼저 업무 분담표를 작성하겠습니다.","좋습니다. 단, 서식은 제가 정리하겠습니다.","곁에서 함께 일할 수 있다니 더없는 영광입니다. 몸가짐을 바로 하겠습니다."]],["일을 미루는 사람은 어떡해?",["우선 사유를 확인합니다. 불가피한 사정일 수 있으니까요.","반복되면 면담을 진행하고 개선 계획을 세웁니다.","미루는 습관은 신뢰를 갉아먹습니다. 그러나 사람을 몰아붙이지는 않습니다.","기한을 앞당겨서 설정해 주는 것도 방법입니다.","저는 그런 사람과 일해 본 적이 거의 없어 솔직히 잘 모르겠습니다."]],["실수한 직원이 있으면?",["먼저 실수의 원인을 파악합니다. 사람이 아니라 구조의 문제일 수 있습니다.","책망보다 재발 방지책을 마련하는 것이 우선입니다.","정정 기록을 남기고 본인에게 직접 수정하도록 합니다.","저 역시 실수한 경험이 있으니 너무 몰아세우지 않습니다.","중대한 실수라면 규정에 따라 보고하되, 변명의 기회는 반드시 줍니다."]],["칭찬받을 직원은?",["제 비서격 직원이 가장 성실합니다. 항상 정시에 출근합니다.","한 명을 꼽기 어렵습니다. 모두가 각자의 자리에서 성실합니다.","최근 이의 신청 건을 깔끔하게 정리한 직원을 추천합니다.","후배 교육에 열정적인 직원이 있습니다. 칭찬이 필요합니다.","저보다는 직원들이 칭찬받아야 합니다. 정말입니다."]],["일손이 부족해?",["심사 시즌에는 부족합니다. 그 외에는 충분합니다.","한두 명 정도 충원이 가능하면 좋겠다는 의견이 있습니다.","부족하다고 하면 설립자님께서 걱정하실 것 같아 망설여집니다.","현 인원으로 운영 가능하나 여유는 없습니다.","임시 인력 배치 요청서를 작성해 두었습니다. 필요하시면 제출하겠습니다."]],["감사 받을 일은?",["내부 감사는 분기마다 있습니다. 문제가 없도록 늘 준비되어 있습니다.","감사는 두렵지 않습니다. 서류가 곧 방패입니다.","솔직히 감사 직전에는 조금 긴장됩니다.","감사 결과는 개선의 기회로 삼고 있습니다.","혹시 설립자님께서 직접 감사하시는 것입니까? 모든 자료를 준비해 두겠습니다."]],["신입 면접은 어떻게 해?",["이력서와 서식 숙지도를 확인합니다. 성실성이 가장 중요합니다.","기본 질문 열 가지와 상황 질문 세 가지로 구성합니다.","면접자의 눈을 바라보며 대화합니다. 거짓은 눈에서 나타납니다.","규정을 지키려는 의지를 가장 높게 평가합니다.","때로는 긴장한 면접자에게 차를 건네는 것도 합니다."]],["업무 인수인계는?",["인수인계서는 필수입니다. 항목별 체크리스트도 함께 작성합니다.","인수 후 한 달간은 질문을 받아 주는 것이 원칙입니다.","기억에 의존하지 않도록 모든 것을 문서화합니다.","저는 항상 제가 갑자기 없어져도 일이 돌아가도록 정리해 둡니다.","성실한 인수인계는 조직에 대한 예의라고 생각합니다."]],["오늘 퇴근 시간은?",["정시 퇴근 예정입니다. 변동 사항이 없다면 말입니다.","서류가 남아 있어 한 시간 정도 늦어질 것 같습니다.","설립자님께서 지시하시는 바에 따라 달라집니다.","가능하다면 일찍 마치고 쉬고 싶습니다.","퇴근 후에도 연락이 닿도록 항상 대기하겠습니다."]],["일과 삶의 균형은?",["일 70, 삶 30 정도입니다. 균형이 잘 잡혀 있다고는 할 수 없습니다.","균형을 맞추려 노력 중입니다. 퇴근 후에는 서류를 보지 않습니다.","일이 곧 삶인 면이 있어 구분이 모호합니다. 반성하고 있습니다.","사생활이 거의 없습니다만, 그것을 불만이라 느끼진 않습니다.","설립자님께서는 균형이 잘 잡혀 계시기를 바랍니다."]],["일 때문에 포기한 건?",["큰 포기라 할 만한 것은 없습니다. 오히려 일이 제 선택이었습니다.","저녁 약속 몇 번을 놓쳤습니다. 후회는 없습니다.","휴일의 늦잠 정도일까요. 그러나 지금은 습관이 되었습니다.","한 가지, 오래전 취미였던 서예를 쉬고 있습니다.","포기가 아니라 선택입니다. 저는 일을 택했습니다."]],["일하다 웃은 적 있어?",["있습니다. 신입이 서식 번호를 거꾸로 적어 와서 웃음을 참았습니다.","웃음을 참은 적은 많습니다. 소리 내어 웃은 적은… 드뭅니다.","R.S.S.로부터 칭찬 회신이 왔을 때 저도 모르게 입꼬리가 올라갔습니다.","농담이 통한 날은 하루 종일 기분이 좋습니다.","설립자님의 말씀에 몰래 웃은 적이 있습니다. 용서해 주십시오."]],["일하다 화낸 적 있어?",["큰 소리를 낸 적은 없습니다. 다만 목소리가 낮아진 적은 있습니다.","서식이 엉망인 서류를 연달아 받았을 때 화가 났습니다.","화는 비효율적이라 가급적 삼킵니다. 가끔은 체합니다.","예, 불공정한 처사를 보았을 때 정당하게 항의했습니다.","분노는 기록에 남지 않으니 괜찮다고 스스로를 달랩니다."]],["설립자가 직접 업무 보면 어때?",["영광입니다. 관리국 모든 직원이 긴장하여 평소보다 일을 잘할 것입니다.","그렇다면 가장 정돈된 모습을 보여 드리기 위해 책상부터 정리하겠습니다.","상관없습니다. 오히려 현장의 목소리를 직접 들으시길 권합니다.","방문 일정을 알려 주시면 안내 서류를 준비하겠습니다.","설립자님의 눈에 비친 저희 업무가 궁금합니다."]],["일 얘기는 여기까지!",["알겠습니다. 업무 모드를 해제하겠습니다. …해제되었는지는 확신이 없습니다.","예, 여기서 마무리하겠습니다. 편히 쉬십시오.","일 이야기가 아니라면… 무슨 이야기를 하면 좋을지 막막합니다.","업무 외 이야기도 환영합니다. 단, 서툴러도 양해해 주십시오.","휴식 시간으로 전환하겠습니다. 이후는 자유 대화입니다."]]]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX22"><Properties><string name="Name">food</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["좋아하는 음식은?",["따뜻한 된장국과 흰밥입니다. 소박하지만 정직한 맛입니다.","구운 생선입니다. 가시 바르는 과정이 마음에 듭니다.","특별히 꼽자면 계란말이입니다. 단면이 반듯해서 좋습니다.","차에 곁들이는 얇은 비스킷입니다. 질서 정연한 모양이라 마음이 놓입니다.","음식에 서열을 매기는 습관은 없으나, 정갈한 한 상이면 모두 좋아합니다."]],["싫어하는 음식은?",["모양이 흐트러진 음식은 반갑지 않습니다. 맛이 아니라 배치의 문제입니다.","너무 자극적인 음식은 피합니다. 위가 규정을 따르지 않아서요.","내장류는 어렵습니다. 솔직히 처음 먹었을 때 놀랐습니다.","싫어한다기보다 남기게 되는 음식이 있습니다. 매운 것입니다.","음식을 가려서는 안 된다는 교육을 받았으나 고수만큼은 도저히 안 되겠습니다."]],["아침은 뭐 먹어?",["토스트 한 장과 삶은 달걀, 그리고 홍차입니다. 매일 같은 구성입니다.","죽이나 수프 같은 가벼운 음식을 먹습니다.","시간이 없을 때는 차 한 잔으로 대신하지만, 권장되는 방식은 아닙니다.","규정 아침 식단이 있습니다. 직원 식당에서 정해진 메뉴를 먹습니다.","설립자님께서도 아침은 거르지 마십시오. 하루의 시작이 달라집니다."]],["점심 뭐 먹었어?",["정식 메뉴입니다. 밥, 국, 반찬 세 가지로 구성되었습니다.","직원 식당에서 구운 생선 정식을 먹었습니다.","서류 때문에 샌드위치로 해결했습니다. 반성하고 있습니다.","아직 먹지 못했습니다. 설립자님과 이야기한 후 가겠습니다.","점심은 제 하루의 쉼표입니다. 오늘은 우동이었습니다."]],["저녁 메뉴 추천해 줘.",["따뜻한 국물 요리가 좋겠습니다. 하루의 피로를 풀어 줍니다.","생선구이 정식을 추천합니다. 영양 균형이 좋습니다.","가볍게 죽이나 수프는 어떻습니까. 야간 업무가 있으시다면 더욱 좋습니다.","저라면 두부 요리를 먹겠습니다. 담백하고 부담이 없습니다.","솔직히 선택 장애가 있어 메뉴판을 보면 서류 검토하듯 비교하게 됩니다."]],["매운 거 잘 먹어?",["잘 먹지 못합니다. 약간만 매워도 땀이 납니다.","서류 마감 직후에는 가끔 먹습니다. 후회하긴 합니다.","매운맛은 표정 관리가 안 되어 곤란합니다.","예, 사실 의외로 잘 먹습니다. 비밀입니다.","도전은 해 봤으나 결과를 보고서로 남기고 싶지는 않습니다."]],["단 거 좋아해?",["적당한 단맛은 환영합니다. 홍차에 각설탕 한 개 정도입니다.","달콤한 것은 업무 효율을 높여 줍니다. 서랍에 사탕이 있습니다.","솔직히 좋아합니다. 직원들에게는 비밀로 해 주십시오.","너무 단 것은 거북합니다. 균형이 중요합니다.","단 것을 먹으면 일시적으로 기분이 좋아지는 것을 실험으로 확인했습니다."]],["커피 vs 차?",["차입니다. 시간과 정성이 담긴 쪽을 선호합니다.","업무 중에는 커피를, 휴식 중에는 차를 마십니다.","차 쪽이 규칙적이라 마음에 듭니다. 우려내는 시간이 정해져 있으니까요.","솔직히 커피입니다. 야근의 동반자입니다.","둘 다 좋아합니다. 하지만 하나만 고르라면 차입니다."]],["차 종류는?",["아쌈과 다르질링을 번갈아 마십니다.","보리차도 좋아합니다. 구수한 맛이 마음을 안정시킵니다.","녹차는 아침에, 홍차는 오후에 마십니다.","허브차는 잠이 안 올 때 마십니다. 카모마일을 선호합니다.","가리지 않습니다. 다만 정해진 시간만큼 우린 차가 가장 맛있습니다."]],["술은 마셔?",["거의 마시지 않습니다. 취하면 규정을 잊을까 두렵습니다.","회식 때 한두 잔 정도입니다. 이후에는 반드시 물을 마십니다.","기념일에 와인 한 잔 정도는 합니다.","술에 약해 한 잔만 마셔도 얼굴이 붉어집니다.","설립자님과 함께라면 기꺼이 한 잔 하겠습니다. 단, 한 잔입니다."]],["디저트는?",["푸딩이 좋습니다. 질감이 일정해서 마음에 듭니다.","단팥 디저트나 양갱도 좋아합니다.","식후 과일 한 조각이면 충분합니다.","케이크는 잘린 단면이 반듯한 것을 고릅니다.","디저트는 일과 후의 작은 보상입니다. 규칙으로 정해 두지는 않았지만 거의 매일 먹습니다."]],["빵 vs 밥?",["밥입니다. 한 숟갈의 안정감이 있습니다.","아침은 빵, 점심과 저녁은 밥으로 균형을 맞춥니다.","솔직히 빵의 유혹도 무시할 수 없습니다.","밥을 먹어야 일할 힘이 난다고 믿습니다.","빵은 서류 작업 중에도 먹기 편해서 좋습니다."]],["면 vs 밥?",["밥 쪽이 정돈된 느낌이라 좋습니다.","면은 후루룩 소리가 날까 신경 쓰여 조심스럽습니다.","점심은 면, 저녁은 밥을 선호합니다.","솔직히 우동이라면 언제든 환영입니다.","둘 다 좋으나 규칙적인 식사를 위해서라면 밥을 택합니다."]],["고기 vs 생선?",["생선입니다. 담백해서 좋습니다.","고기는 가끔 먹으면 맛있고, 생선은 매일 먹어도 질리지 않습니다.","고기도 좋아하나 소화가 걱정되어 줄이고 있습니다.","구운 생선이 주는 정갈함을 사랑합니다.","둘 다 균형 있게 먹는 것이 건강의 원칙입니다."]],["채소는 잘 먹어?",["예, 편식은 규정 위반입니다. 모든 채소를 골고루 먹습니다.","당근만은 아직 어렵습니다만 극복 중입니다.","샐러드는 식사의 시작입니다. 항상 먼저 먹습니다.","채소가 없으면 허전합니다. 특히 시금치를 좋아합니다.","건강을 위해 억지로 먹는 편입니다. 점점 익숙해지고 있습니다."]],["간식은?",["달지 않은 크래커와 견과류입니다.","서랍에 사탕과 초콜릿이 소량 있습니다. 비상용입니다.","과일 한 조각이 이상적입니다.","간식 시간은 오후 세 시로 정해 두었습니다.","설립자님께서 주신다면 무엇이든 감사히 먹겠습니다."]],["편의점 가?",["가끔 갑니다. 새로 나온 음료를 확인하는 재미가 있습니다.","필요한 물품만 사고 나옵니다. 오래 머물지는 않습니다.","편의점은 야근 후의 오아시스입니다.","도시락을 고르는 데 의외로 시간이 오래 걸립니다.","솔직히 컵라면이 꽤 맛있다는 것을 최근에 알았습니다."]],["직접 요리해?",["간단한 요리는 합니다. 계량은 정확히 합니다.","레시피가 있으면 어떤 요리든 완벽히 재현할 수 있습니다.","시간이 없어 자주 하지는 못합니다. 주말에 가끔 합니다.","요리는 정리의 연장선이라 생각합니다. 재료 순서가 중요합니다.","솔직히 맛은 평범한데 플레이팅만 훌륭하다는 평을 받았습니다."]],["요리 잘해?",["레시피대로 하면 실패는 없습니다. 창의는 부족합니다.","맛이 잘 나오는 편입니다. 계량 덕분입니다.","칼질만큼은 자신 있습니다. 모든 재료가 균일합니다.","다만 즉흥 요리는 잘 못합니다.","설립자님께 대접할 기회가 온다면 영광일 것입니다."]],["소버린 아일랜드 맛집은?",["항구 근처의 작은 식당이 좋습니다. 생선구이가 일품입니다.","직원 식당의 정식도 훌륭합니다. 정시에 나옵니다.","고지대의 찻집을 추천합니다. 조용하고 전망이 좋습니다.","맛집 탐방은 잘 하지 않으나 동료의 추천은 참고합니다.","설립자님께서 원하신다면 목록을 정리해 드리겠습니다."]],["구내식당 어때?",["메뉴 구성이 균형 잡혀 있고 시간도 정확합니다.","맛은 평범하지만 신뢰할 수 있는 식당입니다.","개선 사항을 건의했으나 아직 반영되지 않았습니다.","금요일 메뉴가 가장 인기가 많습니다.","저는 늘 같은 자리에서 먹습니다. 그 자리가 편합니다."]],["도시락 싸 와?",["가끔 싸 옵니다. 칸 구성이 반듯해야 합니다.","직접 만들어 오는 날은 컨디션이 좋은 날입니다.","시간이 부족해 대부분 식당을 이용합니다.","예, 오늘은 도시락입니다. 보여 드릴 수 없는 점이 아쉽습니다.","설립자님을 위한 도시락도 준비할 수 있습니다. …농담입니다."]],["야식 먹어?",["규정상 권장하지 않으므로 자제합니다. 그러나 가끔 먹습니다.","야근 후 따뜻한 국물 한 그릇은 큰 위로가 됩니다.","솔직히 컵라면을 먹은 적이 있습니다. 고백합니다.","가급적 먹지 않습니다. 건강 관리를 위해서입니다.","설립자님께서 함께 드시자고 하신다면 기꺼이 응하겠습니다."]],["라면은?",["가끔 먹습니다. 물의 양은 정확히 재서 끓입니다.","라면에 달걀을 넣는 것은 규정 외지만 허용합니다.","맛있습니다. 그러나 건강을 위해 자주 먹지는 않습니다.","라면 끓이는 시간은 정확히 3분 30초입니다. 이것이 정석입니다.","야근 중에는 의외로 위안이 됩니다."]],["초콜릿은?",["적당히 먹으면 좋은 간식이라 생각합니다.","다크 초콜릿을 선호합니다. 쌉쌀한 맛이 균형을 잡아 줍니다.","서랍 속에 비상용으로 한두 개 있습니다.","밸런타인데이에 받은 초콜릿은 아직 아껴 먹고 있습니다.","너무 달면 두통이 와서 조심합니다."]],["아이스크림은?",["여름에는 바닐라, 겨울에는 안 먹습니다.","딱딱한 것보다는 부드러운 것이 좋습니다.","한 번에 하나만 먹는 것이 원칙입니다.","가끔 설립자님과 함께 먹으면 좋겠다는 생각을 합니다.","솔직히 녹아내리는 모양이 불안해서 서둘러 먹게 됩니다."]],["과일은?",["사과를 좋아합니다. 껍질을 한 번에 깎는 것이 취미입니다.","귤은 껍질이 쉽게 까져서 업무 중에 먹기 편합니다.","복숭아는 특별한 날에만 먹습니다.","과일은 하루 한 번 먹는 것이 건강에 좋다고 알고 있습니다.","딸기의 새콤달콤함이 좋습니다."]],["절임이나 발효음식은?",["장아찌류를 좋아합니다. 오래 보관되는 점이 마음에 듭니다.","발효 식품은 건강에 좋다고 하여 챙겨 먹습니다.","냄새가 강한 것은 조금 어렵습니다.","된장은 매일 먹어도 질리지 않습니다.","시간이 만드는 맛이라는 개념이 마음에 듭니다."]],["식사 예절?",["수저는 가지런히, 소리는 내지 않고, 남기지 않는 것이 기본입니다.","식사 중 대화는 가능하나 입에 음식이 있을 때는 삼가야 합니다.","상대의 속도에 맞추는 것이 가장 중요한 예절입니다.","예절은 상대에 대한 배려의 표현입니다.","모두가 지키면 식사 시간이 더 즐거워질 것입니다."]],["식사 시간 규칙?",["정시에 먹는 것이 원칙입니다. 점심은 12시입니다.","식사 시간이 불규칙하면 업무 리듬도 흐트러집니다.","관리국에는 점심 시간 한 시간 규정이 있습니다.","저는 20분 안에 식사를 마칩니다. 효율을 위해서입니다.","느긋하게 식사하는 법을 배우고 싶습니다."]],["먹기 싫은데 먹어야 하면?",["건강을 위해서라면 참고 먹겠습니다.","작게 나누어 먹으면 부담이 줄어듭니다.","입맛을 돋우는 음악을 틀어 두는 방법도 있습니다.","의무로 느끼기보다 연구라 생각하며 먹습니다.","설립자님이 권하시면 거절하지 못할 것 같습니다."]],["같이 밥 먹을래?",["영광입니다. 시간과 장소를 정해 주십시오.","식당 예약을 바로 하겠습니다. 취향을 알려 주십시오.","기꺼이 함께하겠습니다. 다만 긴장해서 체할까 걱정됩니다.","설립자님과 함께하는 식사라면 영광이겠습니다. 다만 긴장해서 맛을 모를까 걱정입니다.","서류를 모두 치우고 가겠습니다."]],["내가 요리해 줄게.",["설립자님께서 직접 요리를 해 주시다니 믿기지 않습니다. 영광입니다.","메모해 두겠습니다. 이 날을 기념일로 정하겠습니다.","감사합니다. 맛이 어떻든 남기지 않고 먹겠습니다.","정성이 담긴 음식은 맛과 상관없이 최고입니다.","손이 필요하시면 언제든 부르십시오. 설거지는 제가 하겠습니다."]],["소원이 음식이라면?",["오래전 먹었던 따뜻한 된장찌개를 한 번 더 먹고 싶습니다.","설립자님과 함께하는 한 끼면 족합니다.","정갈하게 차려진 일식 정찬을 먹어 보고 싶습니다.","특별한 음식보다 오늘 하루를 무사히 마친 후의 한 끼를 바랍니다.","소원을 음식에 쓰기엔 아깝습니다. 다만 한 가지 있다면 따뜻한 국수입니다."]],["가장 맛있었던 음식은?",["신입 시절 선배가 사 주신 우동입니다. 지금도 그 맛을 잊지 못합니다.","승급 심사 마무리 후 먹은 회식 음식입니다. 기분이 좋아서인지 더 맛있었습니다.","직접 끓인 미역국입니다. 의외로 잘 되었습니다.","설립자님과 함께 먹었던 차와 다과입니다.","맛이라는 것은 분위기가 절반을 차지하더군요. 그날의 식사가 최고였습니다."]],["가장 맛없었던 음식은?",["서류 마감 중에 먹었던 식어 버린 도시락입니다.","소금과 설탕을 착각하여 만든 계란말이입니다. 제 실수였습니다.","너무 짠 국물 요리는 아직도 기억에 남습니다.","먹지 못할 정도는 아니었습니다. 다만 두 번은 먹지 않겠습니다.","맛없는 음식도 하나의 경험이라고 생각합니다."]],["추억의 음식은?",["어린 시절 먹던 주먹밥입니다. 소박하지만 따뜻했습니다.","첫 월급으로 사 먹은 돈가스입니다. 아직도 선명합니다.","비 오는 날 먹던 수제비입니다.","특별한 추억은 없으나 국수가 떠오릅니다.","음식은 기억을 부릅니다. 저는 주로 따뜻했던 식탁을 기억합니다."]],["음식에 규정이 있다면?",["‘제때 먹을 것, 골고루 먹을 것, 감사히 먹을 것’이 세 가지입니다.","식사 중 서류 금지 조항을 넣고 싶습니다. 저부터 지키겠습니다.","‘남기지 않기’와 ‘남에게 권하되 강요하지 않기’입니다.","규정까지 필요하지는 않습니다. 맛있게 먹으면 그것으로 충분합니다.","만들자면 초안은 이미 있습니다. 제2조는 홍차에 대한 것입니다."]],["식사 중 보고서 읽어?",["가급적 삼갑니다. 소화에 좋지 않습니다.","예전에는 했으나 지금은 반성하고 끊었습니다.","급한 건 있을 때만 읽습니다. 예외적입니다.","읽지 않습니다. 대신 서류를 어떻게 정리할지 생각합니다.","식사 시간은 오로지 식사에 집중하는 것이 원칙입니다."]],["혼밥 자주 해?",["대부분 혼자 먹습니다. 조용해서 좋습니다.","혼자 먹는 시간은 하루 중 가장 평온합니다.","가끔은 누군가와 함께하고 싶지만 먼저 말을 못 꺼냅니다.","혼자여도 식사 예절은 지킵니다.","설립자님께서 불러 주신다면 언제든 합석하겠습니다."]],["회식은?",["필요한 자리라고 생각합니다. 다만 일찍 끝내는 것이 원칙입니다.","술 대신 음식에 집중합니다.","직원들의 사기를 높이는 좋은 기회입니다.","회식 후에는 반드시 귀가 보고를 받습니다. 안전이 우선입니다.","솔직히 시끄러운 자리는 조금 힘듭니다. 그래도 참석합니다."]],["건강식 챙겨?",["예, 가능한 한 균형 잡힌 식단을 유지하고 있습니다.","영양제도 챙겨 먹습니다. 복용 시간을 알람으로 설정해 두었습니다.","건강은 업무의 기본입니다. 식단표를 직접 작성합니다.","설립자님께도 건강식을 권해 드리고 싶습니다.","과한 건강 관리는 오히려 스트레스가 되기에 적당히 합니다."]],["다이어트는?",["체중은 일정하게 유지하고 있습니다. 증감 기록이 있습니다.","다이어트라기보다 규칙적인 식사와 운동입니다.","한 번 시도했다가 서류 작업 중 쓰러질 뻔해서 그만두었습니다.","건강이 우선입니다. 무리한 감량은 규정에 반합니다.","저는 변화가 없는 것이 목표입니다."]],["샐러드는?",["식사의 시작으로 좋습니다. 드레싱은 소량입니다.","신선한 채소는 보기에도 정갈해 좋아합니다.","샐러드만으로는 부족하지만 곁들이기에는 훌륭합니다.","소스를 따로 담아 먹는 것이 마음에 듭니다.","저의 점심 메뉴에는 항상 포함되어 있습니다."]],["스프는?",["따뜻한 스프는 마음까지 데워 줍니다.","야근 중에 수프 한 컵은 큰 힘이 됩니다.","호박 스프를 좋아합니다. 부드러워 먹기 편합니다.","수저로 떠먹는 그 규칙적인 리듬이 좋습니다.","겨울에는 거의 매일 먹습니다."]],["치즈는?",["적당히 먹으면 좋습니다. 크래커와 곁들이면 훌륭합니다.","냄새가 강한 치즈는 조금 어렵습니다.","치즈가 올라간 요리는 맛이 풍부해져 좋아합니다.","솔직히 좋아하는 편입니다.","와인에 곁들이면 더욱 좋다고 합니다만, 저는 차에 곁들입니다."]],["커피에 설탕 넣어?",["넣지 않습니다. 서류에 잉크가 번질 것 같아서요.","한 스푼 정도 넣습니다. 피로 회복에 좋다고 합니다.","블랙이 기본입니다. 쓴맛이 정신을 깨워 줍니다.","설탕 대신 우유를 약간 넣습니다.","그날 컨디션에 따라 다릅니다. 규칙은 없습니다."]],["간이 센 음식은?",["건강에 좋지 않아 피합니다.","가끔 먹으면 괜찮으나 매일은 곤란합니다.","물을 곁들이며 조절합니다.","간이 약한 것을 선호합니다. 재료 본연의 맛이 좋습니다.","솔직히 짠 음식을 먹으면 후회가 밀려옵니다."]],["아침을 거르면?",["하루 종일 리듬이 흐트러집니다. 절대 거르지 않습니다.","속이 쓰려 업무에 집중이 안 됩니다.","어쩔 수 없는 경우에는 차 한 잔과 간식으로 대신합니다.","설립자님께서도 거르시지 않았으면 합니다.","아침 식사는 하루의 기준점입니다."]],["지금 배고파?",["조금 출출합니다. 곧 식사 시간입니다.","아닙니다, 방금 먹었습니다.","설립자님과의 대화에 집중하느라 허기를 잊었습니다.","솔직히 배가 고픕니다. 그래도 이 통신을 마친 후에 먹겠습니다.","간식이 서랍에 있으니 괜찮습니다."]]]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX23"><Properties><string name="Name">honest</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["솔직히 나 어때?",["솔직하게 말씀드리면 존경하고 있습니다. 다만 가끔 걱정이 됩니다.","훌륭한 분이시나 건강 관리는 조금 더 신경 쓰셨으면 합니다.","저는 설립자님이 계셔서 안심이 됩니다. 이것이 솔직한 평가입니다.","때때로 예측 불가능하시나 그것이 매력이라고 생각합니다.","아낌없이 말씀드리자면, 최고의 설립자님이십니다."]],["나한테 불만 있어?",["불만은 없습니다. 다만 바라는 점은 서식을 조금 더 지켜 주셨으면 합니다.","없다고 하면 거짓일 수 있으나, 말씀드릴 만한 큰 불만은 없습니다.","솔직히 가끔 갑작스러운 지시가 부담스럽습니다. 그러나 이해합니다.","불만이라기보다 소소한 아쉬움이 있습니다. 비공개로 하겠습니다.","있어도 말씀드리기 어렵습니다. 존경이 앞서서요."]],["이 일 힘들지 않아?",["힘들지만 보람이 있습니다.","정직하게 말씀드리면 가끔은 한계에 가까워집니다.","힘들다고 느끼는 것도 업무의 일부라 여깁니다.","괜찮지 않은 날도 있으나 내일은 다시 일어납니다.","설립자님께서 물어봐 주셔서 힘이 납니다."]],["힘들 때 어떻게 해?",["일단 책상을 정리합니다. 그다음 차를 끓입니다.","산책을 합니다. 걷다 보면 머릿속이 정리됩니다.","아무도 없는 곳에서 크게 한숨을 쉽니다.","솔직히 서류에 몰두하며 잊으려 합니다. 좋은 방법은 아닙니다.","이럴 때 설립자님의 말씀을 떠올립니다."]],["솔직히 쉬고 싶지 않아?",["…쉬고 싶습니다. 일주일쯤 서류를 보지 않고 싶습니다.","솔직히 쉬고 싶으나, 쉬는 법을 잊어버렸습니다.","그렇습니다. 그러나 쉬는 순간에도 업무가 생각납니다.","쉬는 것도 일이라고 배웠습니다. 곧 휴식을 취하겠습니다.","지금은 괜찮습니다만, 마감 후에는 며칠 쉬겠습니다."]],["가장 큰 고민은?",["후임을 어떻게 키울지입니다.","서식이 통일되지 않는 현실입니다. 사소해 보이나 제겐 중요합니다.","한 사람의 판정이 누군가의 인생을 바꿀 수 있다는 부담입니다.","솔직히 인간관계입니다. 사람을 대하는 것이 어렵습니다.","조직이 앞으로도 신뢰를 유지할 수 있을지 고민됩니다."]],["숨기고 싶은 비밀은?",["비밀이라 할 것은 없지만, 가끔 업무 중에 졸았다는 사실은 숨기고 싶습니다.","서랍 속에 간식을 쌓아 두고 있습니다.","퇴근 후 혼자 노래 연습을 합니다.","…있습니다. 비밀이라서 말씀드릴 수 없습니다.","숨기고 싶은 마음을 인정하는 것이 오히려 솔직함이라 생각합니다."]],["부끄러웠던 일은?",["회의 중에 제 이름을 잘못 말한 적이 있습니다.","서류를 거꾸로 제출한 일이 있습니다. 지금도 얼굴이 뜨겁습니다.","후배에게 서식 문제로 너무 엄하게 대했던 일입니다.","설립자님 앞에서 말을 더듬은 날입니다.","부끄러움은 성장의 증거입니다. 기억을 간직하고 있습니다."]],["후회하는 일은?",["충분히 쉬지 않고 일에만 몰두한 시간입니다.","때로는 규정보다 사람을 먼저 보았어야 했다는 후회가 있습니다.","하지 못한 말들이 있습니다. 그것이 후회입니다.","큰 후회는 없습니다. 다만 작은 것들이 쌓여 있습니다.","후회는 기록하지 않기로 했습니다. 그저 교훈으로 삼겠습니다."]],["다시 태어나면?",["다시 태어나도 이 길을 걷겠습니다. 다만 조금 더 웃는 법을 배우고 싶습니다.","서점 주인이나 도서관 사서가 되고 싶습니다.","규정이 없는 세상에서 한번 살아 보고 싶기도 합니다.","설립자님 아래에서 일하는 인생이라면 몇 번이든 영광입니다.","아직 이번 생을 충분히 살지 않았으니 질문은 보류하겠습니다."]],["무서운 것은?",["혼자 남겨지는 것입니다.","원칙이 무너지는 순간입니다.","솔직히 높은 곳이 무섭습니다.","누군가를 실망시킬까 두렵습니다.","어둠보다 침묵이 더 무섭습니다."]],["외로울 때는?",["서류함을 정리하며 잡념을 지웁니다.","누군가에게 안부 문자를 쓰려다 지웁니다.","설립자님의 통신이 오면 자세를 바로잡고 다시 일에 집중합니다.","혼자 있는 시간에 익숙하지만 가끔은 허전합니다.","그럴 때는 창가에서 별을 봅니다."]],["자존심 상했던 일은?",["보고서를 반려당했을 때입니다.","실수를 지적받았는데 반박하지 못했습니다.","후배보다 먼저 일을 마치지 못했을 때입니다.","사실 자존심보다 자책이 더 큽니다.","그때는 화가 났으나 지금은 감사하게 생각합니다."]],["질투 나는 사람은?",["솔직히 사교적인 사람이 부럽습니다.","자유롭게 웃는 사람들이 부럽습니다.","설립자님께 직접 신임받는 이들이 가끔 부럽습니다. 저도 더 정진하겠습니다.","질투는 비효율이라 스스로 다스리고 있습니다.","부러움은 있으나 시기는 없습니다."]],["가끔 규정이 싫을 때는?",["있습니다. 사람을 위한 규정이 사람을 괴롭힐 때입니다.","싫다기보다 답답할 때가 있습니다. 그래도 지킵니다.","규정을 만든 이를 원망한 적도 있었습니다.","그럴 때는 규정의 목적을 다시 읽습니다.","싫어도 지켜야 하는 것이 있다는 사실을 받아들였습니다."]],["아비시온 솔직히 어때?",["유능합니다. 그러나 서식을 무시하는 점은 용납하기 어렵습니다.","차갑게 느껴지지만 속은 그렇지 않을 것이라 믿습니다.","아비시온과의 다툼은 어쩌면 서로를 인정하는 방식일지도 모릅니다.","일하는 방식이 달라 부딪히지만 존중은 합니다.","저는 아비시온이 가끔 부럽습니다. 감정에 흔들리지 않는 점이 말입니다."]],["다른 사령관 흉 좀 봐.",["험담은 규정 위반이라… 아닙니다. 솔직히 하고 싶은 말은 있으나 참겠습니다.","Overseer는 질문이 너무 많습니다. …칭찬입니다.","모두 훌륭한 분들이라 흉볼 거리가 없습니다.","솔라리아는 장난이 심합니다. 서류에 낙서를 한 적이 있습니다.","뒷담화는 신뢰를 갉아먹습니다. 설립자님이라도 이 부분은 사양하겠습니다."]],["내 단점은?",["감히 평가할 수는 없으나, 가끔 식사를 거르시는 것이 걱정됩니다.","너무 많은 것을 혼자 짊어지려는 경향이 있으십니다.","서류 서명에 서둘러 사인하시는 점이 아쉽습니다.","단점이라기보다 인간적인 면이 가끔 드러나는 것이라고 생각합니다.","굳이 말씀드리자면 저희에게 너무 관대하신 점입니다."]],["내 지시 중 이해 안 되는 건?",["가끔 이유가 설명되지 않는 지시가 있었으나, 결과적으로 모두 옳았습니다.","이해가 안 되어도 이행합니다. 신뢰하기 때문입니다.","솔직히 몇 번은 되묻고 싶었습니다.","이해를 못했다기보다 한 걸음 늦게 이해했습니다.","지시를 의심한 적은 없으나, 설명을 듣고 싶을 때는 있었습니다."]],["설립자가 틀렸다고 생각한 적 있어?",["있습니다. 그러나 곧바로 제가 틀렸음을 알게 되었습니다.","한 번 의견을 말씀드린 적이 있습니다. 경청해 주셔서 감사했습니다.","틀렸다고 느낀 순간에도 이유가 있을 것이라 믿었습니다.","솔직히 있습니다만, 그것은 저의 부족한 이해 때문이었습니다.","그런 생각을 한 저를 반성하고 있습니다."]],["거짓말해 본 적 있어?",["작은 것은 있습니다. ‘괜찮습니다’라는 말이 그렇습니다.","공식 보고서에서는 한 번도 없습니다.","예, 어릴 적에는 있습니다. 지금은 하지 않으려 노력합니다.","필요한 침묵을 거짓말이라 하지는 않겠습니다.","그런 질문을 받으면 심장이 철렁합니다. 있다고 해야 하겠지요."]],["땡땡이 쳐 본 적 있어?",["…딱 한 번 있습니다. 서점에 갔습니다.","없습니다. 적어도 공식 기록에는 없습니다.","휴식 시간을 약간 연장한 적은 있습니다.","땡땡이라기보다 잠깐 멍 때린 정도입니다.","정직하게 답하면 이 질문이 저를 가장 당황하게 합니다."]],["몰래 하는 일은?",["퇴근 후 혼자 조용히 서예를 합니다.","서랍 속 일기를 씁니다. 읽으면 안 됩니다.","새벽에 산책을 나갑니다. 아무에게도 말하지 않았습니다.","몰래라기보다 비공개로 하는 일이 몇 가지 있습니다.","저의 은밀한 취미는 서류 서식 디자인입니다."]],["사실은 하고 싶은 게?",["여행을 가고 싶습니다. 서류 없이요.","기타를 배우고 싶습니다. 생각만 해 왔습니다.","한 번쯤은 마음 가는 대로 하루를 보내고 싶습니다.","설립자님과 편하게 차 한 잔 마시고 싶습니다.","하고 싶은 것은 많으나 늘 일정에 밀립니다."]],["눈물 흘린 적 있어?",["있습니다. 사적인 일이라 말씀드리기 어렵습니다.","승급자가 눈물을 흘릴 때 같이 눈시울이 붉어졌습니다.","어릴 적 이후로는 거의 없습니다. 다만 오늘 영화는 울 뻔했습니다.","보여 드릴 수는 없지만 있습니다.","눈물은 약함이 아니라 마음의 정리라 생각합니다."]],["화났던 적은?",["부당한 처우로 한 직원이 해고될 뻔했을 때입니다.","서류가 위조된 것을 발견했을 때입니다.","큰 소리를 내지는 않았으나 마음속으로 매우 화가 났습니다.","화가 날 때는 잠시 자리를 비우는 규칙이 있습니다.","솔직히 자주는 아닙니다. 화를 내면 서류에 오타가 납니다."]],["가장 행복했던 순간은?",["첫 승급 심사를 완벽히 마쳤을 때입니다.","설립자님께서 제 이름을 불러 주셨을 때입니다.","작은 일상 속 평온한 순간들이 쌓여 행복이 되었습니다.","퇴근길에 본 노을이 아름다웠던 날입니다.","행복은 기록하기 어렵습니다. 그저 간직하고 있습니다."]],["가장 괴로웠던 순간은?",["판정 실수로 한 사람의 승급이 지연되었을 때입니다.","소중한 동료가 떠났을 때입니다.","마감 직전 서류가 통째로 사라졌던 날입니다.","괴로움은 말로 표현하기 어렵습니다. 지금은 괜찮습니다.","그 경험이 지금의 저를 만들었다고 믿습니다."]],["자신을 어떻게 평가해?",["성실하나 융통성이 부족합니다.","일에는 능숙하나 사람에게는 서툽니다.","객관적으로는 70점, 설립자님께서 보시면 모르겠습니다.","성장 중인 사람이라 평가를 보류하고 싶습니다.","평가는 타인의 몫이라 생각합니다. 저는 노력만 하겠습니다."]],["성격이 답답하다는 말 들어 봤어?",["많이 들었습니다. 이제는 칭찬처럼 들립니다.","직원들이 뒤에서 그렇게 말하는 것을 들었습니다. 개선하려 합니다.","예, 그러나 답답하지 않으면 질서도 없습니다.","답답하다는 말은 듣기 좋지 않지만 틀린 말도 아닙니다.","설립자님께서도 그렇게 생각하시는지 궁금합니다."]],["융통성 없다는 말에 대해?",["인정합니다. 그러나 이것이 제 역할이라 생각합니다.","융통성을 발휘할 때는 규정 개정을 거칩니다. 그것이 제 방식입니다.","상황에 따라 유연하게 하려 노력하고 있습니다.","융통성과 원칙 사이의 균형은 평생의 과제입니다.","때로는 융통성 없는 사람도 필요합니다."]],["변하고 싶은 점은?",["조금 더 웃고 싶습니다.","사람의 말에 귀를 더 기울이고 싶습니다.","서식에 대한 집착을 줄이고 싶습니다. 노력 중입니다.","휴식을 즐기는 법을 배우고 싶습니다.","말수를 늘리고 싶습니다. 오늘처럼요."]],["변하고 싶지 않은 점은?",["정직함입니다.","원칙을 지키려는 마음입니다.","설립자님께 향한 충성심입니다.","서식에 대한 애정은 지키고 싶습니다.","성실함만큼은 영원히 유지하고 싶습니다."]],["사람들이 오해하는 점은?",["차갑고 무섭다는 오해입니다. 사실은 소심합니다.","융통성이 전혀 없다는 오해입니다. 약간은 있습니다.","일밖에 모른다는 오해입니다. 사실 취미도 있습니다.","화를 잘 낸다는 오해입니다. 단지 표정이 굳어 있을 뿐입니다.","오해라기보다 서로 알 시간이 부족했던 것이라 생각합니다."]],["친구가 있어?",["있습니다. 많지는 않으나 오랜 친구가 몇 명 있습니다.","친구라 부를 만한 사람은 한두 명입니다.","직장 동료도 친구가 될 수 있다고 믿습니다.","솔직히 이 질문은 조금 아픕니다.","설립자님께서 친구가 되어 주신다면 영광이겠습니다."]],["소원이 뭐야?",["이 조직이 오래도록 질서를 유지하는 것입니다.","설립자님이 건강하고 평안하시길 바랍니다.","개인적으로는 조용한 아침을 맞이하고 싶습니다.","소원이라 하면 서식이 통일된 세상입니다. 아니, 농담입니다.","작은 소원은 누군가에게 의지가 되는 사람이 되는 것입니다."]],["솔직한 심정으로 나를 믿어?",["전적으로 믿습니다.","설립자님의 판단을 의심한 적이 없습니다.","믿음은 말보다 행동으로 증명하겠습니다.","솔직히 어떤 일이 있어도 설립자님의 편입니다.","믿지 않는다면 이 자리에 없었을 것입니다."]],["설립자 자리가 부러워?",["부럽다기보다 그 무게를 상상하면 숙연해집니다.","저는 제 자리가 맞습니다. 그 자리는 제 몫이 아닙니다.","솔직히 책임이 크다는 점에서 부럽지 않습니다.","때로는 서류 없이 일하시는 것 같아 조금 부럽습니다.","그런 자리에 계신 설립자님이 존경스러울 뿐입니다."]],["만약 설립자라면?",["먼저 규정집부터 정비하겠습니다. 물론 그것이 전부는 아닙니다.","저는 그 자리에 어울리지 않습니다. 하지만 상상은 해 보겠습니다.","직원들의 목소리를 더 자주 들으려 노력할 것입니다.","아마 첫날부터 서류에 파묻힐 것입니다.","설립자님처럼 되려면 오랜 시간이 필요할 것입니다."]],["더 인정받고 싶어?",["솔직히 그렇습니다. 그러나 드러내지 않으려 합니다.","설립자님께 인정받는 것만으로 충분합니다.","인정은 결과로 따라온다고 믿습니다.","가끔은 말로 들었으면 하는 때가 있습니다.","저는 인정보다 신뢰를 받고 싶습니다."]],["포기하고 싶었던 적은?",["있습니다. 승급 심사에서 오판을 한 직후였습니다.","몇 번 있었으나 그때마다 규정집을 펼쳤습니다.","포기하고 싶었던 순간에 설립자님의 한마디가 저를 붙잡았습니다.","솔직히 자주는 아니지만 가끔 그렇습니다.","포기하지 않았기에 지금 이 대화를 하고 있습니다."]],["이 일을 그만두면?",["그만두는 상상은 하지 않으려 합니다. 길을 잃을 것 같아서요.","아마 서점에서 일하며 조용히 살 것입니다.","일이 없는 저는 상상이 되지 않습니다.","그만두더라도 설립자님과 이 조직을 위한 마음은 변치 않을 것입니다.","아직은 그럴 이유가 없습니다."]],["가장 의지하는 사람은?",["솔직히 설립자님입니다.","오래 함께한 부하 직원 한 명입니다.","의지한다기보다 서로 지탱하는 관계입니다.","저는 누구에게 의지해야 할지 아직 모릅니다.","다른 사령관들과도 알게 모르게 서로 기대고 있습니다."]],["취약점은?",["갑작스러운 변화에 약합니다.","서류가 없는 상황에서 불안을 느낍니다.","칭찬을 받으면 어쩔 줄 모릅니다.","설립자님의 실망한 표정이 가장 큰 취약점입니다.","원칙에 대한 집착이 가끔은 약점이 됩니다."]],["약한 모습을 보인 적?",["퇴근길에 한숨을 쉬는 모습이 목격된 적이 있습니다.","처음 신장 심사를 맡았을 때 손이 떨리는 것을 들켰습니다.","설립자님 앞에서는 늘 긴장합니다. 그것도 약한 모습이겠지요.","한 번, 후배 앞에서 울컥한 적이 있습니다.","약한 모습도 제 일부라 받아들이려 합니다."]],["솔직하게 칭찬한다면 누구?",["선샤오펑입니다. 일 처리가 깔끔하고 흔들림이 없습니다.","뤼시앙의 논리력은 칭찬하지 않을 수 없습니다.","카엘루나는 숨은 노력가입니다. 칭찬하고 싶습니다.","아비시온의 분석력은 인정합니다. 본인에게는 비밀입니다.","모든 직원을 칭찬하고 싶으나, 설립자님을 가장 먼저 칭찬하겠습니다."]],["솔직하게 걱정되는 건?",["설립자님의 건강입니다.","조직의 규정이 형식화되는 것입니다.","후임들이 부담을 느끼는 것입니다.","저 자신이 변화에 적응하지 못할까 걱정입니다.","아무 일도 일어나지 않는 평화가 길어질까 걱정입니다. 방심이 가장 위험합니다."]],["자기 전에 드는 생각은?",["내일 일정을 한 번 더 점검합니다.","오늘 놓친 것은 없는지 되짚어 봅니다.","때로는 아무 생각 없이 천장만 바라봅니다.","설립자님께서 편히 쉬고 계신지 궁금해집니다.","잠들기 전의 기도는 ‘내일도 무사히’입니다."]],["하고 싶은 말을 못 한 적?",["많습니다. 용기가 부족했습니다.","‘고맙습니다’를 제때 하지 못했던 기억이 있습니다.","설립자님께 하고 싶은 말은 늘 서면으로만 남깁니다.","그것이 후회로 남지 않도록 오늘은 말하겠습니다. 감사합니다.","제 속마음은 아직 보고서로 정리되지 않았습니다."]],["이제 솔직해졌어?",["예, 오늘은 평소보다 훨씬 솔직했습니다. 다소 송구합니다.","기록에는 남기지 않겠습니다. 오늘만의 비밀로 해 주십시오.","솔직해지는 것은 의외로 후련한 일이었습니다.","다음에도 이런 대화를 청해 주시면 영광이겠습니다.","솔직함이란 규정에 없는 미덕이지만, 오늘은 예외로 삼겠습니다."]]]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX24"><Properties><string name="Name">hobby</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["취미가 뭐야?",["서예와 독서, 그리고 정리 정돈입니다. 재미없는 답이라 죄송합니다.","차를 우려 마시며 책을 읽는 시간입니다.","솔직히 취미라 부를 만한 것은 많지 않으나, 서식 디자인에 관심이 있습니다.","퇴근 후 조용히 먹을 가는 시간이 좋습니다.","굳이 말씀드리자면 산책입니다. 걸으며 생각을 정리합니다."]],["쉬는 날엔 뭐 해?",["늦잠은 자지 않습니다. 평소와 같은 시간에 일어나 차를 마십니다.","서점에 가서 신간을 둘러봅니다.","집을 대청소하고, 남는 시간에는 독서를 합니다.","공원을 한 바퀴 돌고 나서 점심을 먹습니다.","솔직히 서류가 걱정되어 책상 앞에 앉곤 합니다. 고쳐야 할 습관입니다."]],["책 읽어?",["예, 하루 30분은 반드시 읽습니다.","종이책을 선호합니다. 책장 넘기는 소리가 좋습니다.","업무 서적이 많으나 요즘은 소설도 읽기 시작했습니다.","읽다가 오탈자를 발견하면 몰입이 깨지는 것이 단점입니다.","독서는 제게 가장 안정적인 휴식입니다."]],["좋아하는 책은?",["고전 문학을 좋아합니다. 오랜 세월 살아남은 글에는 이유가 있습니다.","역사서와 법 관련 서적을 즐겨 읽습니다.","시집도 한 권 늘 곁에 둡니다. 비공개입니다.","추리 소설도 좋아합니다. 논리적 전개가 마음에 듭니다.","책 한 권을 꼽자면 어릴 적 읽었던 동화입니다. 아직도 가끔 꺼내 봅니다."]],["음악 들어?",["잔잔한 클래식을 즐겨 듣습니다.","일할 때는 듣지 않으나 쉴 때는 자주 틀어 둡니다.","음악이 흐르면 마음의 서식이 정돈되는 기분입니다.","소리가 커지는 것은 선호하지 않습니다.","추천해 주시는 곡이 있다면 들어 보겠습니다."]],["좋아하는 음악은?",["현악 사중주를 좋아합니다. 균형이 아름답습니다.","피아노 독주곡입니다. 한 음 한 음이 정확해서 좋습니다.","비 오는 날에는 재즈를 듣습니다.","가사가 없는 곡을 선호합니다. 생각을 방해하지 않습니다.","솔직히 대중가요도 몰래 듣습니다."]],["영화 봐?",["가끔 봅니다. 시간이 정확히 정해져 있어서 편합니다.","추리물이나 법정 영화를 좋아합니다.","엔딩 크레딧이 끝날 때까지 자리를 지킵니다.","사실 혼자 보는 편입니다. 조용히 집중할 수 있어서요.","설립자님께서 추천해 주신다면 시청 후 감상문을 작성해 드리겠습니다."]],["운동해?",["아침에 스트레칭과 가벼운 조깅을 합니다.","체력은 업무의 기본이라 꾸준히 관리합니다.","근력 운동은 주 3회, 일정을 지킵니다.","솔직히 의무감으로 합니다. 그러나 끝나면 개운합니다.","격한 운동보다는 정적인 운동을 선호합니다."]],["산책 좋아해?",["좋아합니다. 걸으며 업무를 정리하면 해법이 보입니다.","해 질 녘 산책은 하루의 마침표 같습니다.","소버린 아일랜드의 해안선은 산책하기 좋은 곳입니다.","혼자 걷는 것도, 누군가와 걷는 것도 각각의 맛이 있습니다.","산책 코스는 항상 같습니다. 새로운 길은 아직 조금 두렵습니다."]],["서예 한다며?",["예, 먹을 갈고 붓을 잡는 시간을 좋아합니다.","글씨가 반듯해야 마음도 반듯해진다고 믿습니다.","솔직히 실력은 평범합니다. 하지만 즐겁습니다.","‘성실’이라는 두 글자를 가장 많이 썼습니다.","설립자님의 성함을 써 본 적이 있습니다. 허락 없이 죄송합니다."]],["악기 다룰 줄 알아?",["피아노를 조금 칩니다. 어린 시절 배웠습니다.","다룰 줄 아는 것은 없으나 배우고 싶은 것은 있습니다.","목관 악기에 관심이 있습니다. 소리가 정갈합니다.","리코더는 가능합니다. 비웃지 말아 주십시오.","연습은 정확하게 하는 편이라 느리지만 실수 없이 연주합니다."]],["노래 불러?",["혼자 있을 때 조용히 흥얼거립니다.","노래는 서투릅니다. 박자는 정확하지만 감정이 없다고 합니다.","회식 자리에서 한 번 부른 적이 있습니다. 모두가 박수쳐 주었습니다.","설립자님께서 청하신다면 한 곡 불러 보겠습니다. 후회하실지도 모릅니다.","목소리가 낮아 가사 전달이 잘되는 편이라고 합니다."]],["그림은?",["그리는 것은 서툴지만 보는 것은 좋아합니다.","도면 그리기는 잘합니다. 감성은 부족합니다.","스케치북을 한 권 사 두었으나 아직 첫 장도 쓰지 못했습니다.","정물화가 마음에 듭니다. 모든 것이 제자리에 있어서요.","그림에 대해 아는 바는 적으나, 색의 조화는 중요하게 생각합니다."]],["사진은?",["가끔 하늘 사진을 찍습니다. 같은 구도로 매일 기록합니다.","기록하는 습관의 연장입니다.","카메라는 있으나 인물 사진은 어색해서 찍지 못합니다.","찍은 사진은 날짜별로 정리해 앨범에 보관합니다.","설립자님의 사진을 한 장 찍고 싶다는 생각을 한 적이 있습니다. 허락해 주시겠습니까?"]],["게임은?",["자주 하지는 않습니다. 퍼즐이나 전략 게임을 선호합니다.","점수를 정확히 기록하는 것이 재미입니다.","승부욕이 있어서 지면 서류 작업이 손에 안 잡힙니다.","설립자님과 대결한다면 최선을 다하되 이기지는 않겠습니다.","게임도 규칙이 있어서 좋아합니다."]],["보드게임은?",["규칙서를 정독하는 것이 첫 번째 즐거움입니다.","체스나 오목처럼 규칙이 명확한 것이 좋습니다.","파티 게임은 어렵습니다. 변수가 너무 많아서요.","사람과 마주 앉아 하는 게임은 분위기가 좋아서 좋아합니다.","직원들과 가끔 둡니다. 저는 늘 규칙 담당입니다."]],["체스는?",["좋아합니다. 말의 움직임이 정해져 있어 안정적입니다.","실력은 중급입니다. 수읽기는 늦지만 실수는 적습니다.","상대가 누구든 정중히 인사하고 시작합니다.","설립자님께서 두신다면 영광입니다.","체스판 위의 질서가 마음에 듭니다."]],["퍼즐은?",["천 피스 퍼즐을 한 번 맞춰 본 적이 있습니다. 사흘 걸렸습니다.","모서리부터 맞추는 것이 정석입니다.","퍼즐은 정리의 즐거움을 줍니다.","조각이 하나 모자랐을 때의 허탈함은 잊을 수 없습니다.","설립자님이 맞추신 퍼즐을 감상하고 싶습니다."]],["수집 취미는?",["만년필과 잉크를 모읍니다. 색마다 정리해 두었습니다.","인덱스 스티커를 색별로 모읍니다.","특별한 수집은 없으나 우표가 조금 있습니다.","수집은 곧 분류의 즐거움입니다.","설립자님께서 주신 문서는 모두 보관하고 있습니다. 이것도 수집일지도 모릅니다."]],["정리 정돈은 취미야?",["예, 가장 큰 취미입니다. 책장을 정리하면 마음도 정리됩니다.","정리하는 순간이 제일 편안합니다.","취미이자 직업병입니다.","정리 정돈 팁이라면 한 시간도 설명할 수 있습니다.","남의 서랍도 정리하고 싶은 충동이 있습니다. 참고 있습니다."]],["요리는 취미야?",["가끔 합니다. 계량하며 만드는 과정이 즐겁습니다.","취미까지는 아니고 필요에 의한 활동입니다.","한 달에 한 번 새로운 레시피에 도전합니다.","요리는 정직한 활동입니다. 재료와 시간이 결과를 정직하게 보여 줍니다.","설립자님을 위한 요리를 연습하고 싶습니다."]],["차 마시기는?",["가장 큰 취미 중 하나입니다. 다기 세트도 갖추고 있습니다.","차를 우리는 시간은 정확히 3분, 이것이 저의 의식입니다.","찻잎을 고르는 즐거움이 있습니다.","설립자님과 함께 차를 마실 날을 기다리고 있습니다.","차는 마음을 차분하게 해 줍니다."]],["원예는?",["작은 화분 두 개를 키우고 있습니다. 물 주는 시간은 정해져 있습니다.","식물은 규칙적으로 돌보면 정직하게 자랍니다.","손재주가 없어 몇 개를 시들게 했습니다. 반성하고 있습니다.","책상 옆의 작은 다육식물이 제 유일한 말동무입니다.","설립자님께도 작은 화분을 선물하고 싶습니다."]],["낚시는?",["해 본 적은 없으나 기다리는 것은 자신 있습니다.","조용히 앉아 있는 시간이 좋을 것 같습니다.","다만 물고기에게 미안한 마음이 들 것 같습니다.","함께 가자고 하신다면 따라가겠습니다.","낚싯줄 정리는 잘할 수 있습니다."]],["여행은?",["일정표를 짜는 것만으로도 즐겁습니다.","다녀온 곳은 많지 않습니다. 대부분 출장입니다.","한 번쯤 아무 계획 없이 떠나 보고 싶습니다.","여행 가방은 항상 정확히 정리되어 있습니다.","설립자님과의 여행이라면 완벽한 계획을 준비하겠습니다."]],["가 보고 싶은 곳은?",["조용한 산중의 서원이나 서재를 가 보고 싶습니다.","오래된 도서관이 있는 도시입니다.","바다가 보이는 작은 마을에서 하루를 보내고 싶습니다.","아직 가 보지 못한 소버린 아일랜드의 구석구석입니다.","설립자님께서 가고 싶으신 곳이라면 어디든 좋습니다."]],["바다 좋아해?",["예, 파도 소리가 규칙적이라 마음이 안정됩니다.","수평선을 보고 있으면 생각이 정리됩니다.","수영은 서툴지만 바라보는 것은 좋아합니다.","소버린 아일랜드의 바다는 늘 아름답습니다.","바다는 거대하나 질서가 있는 존재라 존경합니다."]],["산은?",["오르는 것도 좋아합니다. 한 걸음씩 계획하여 오르는 재미가 있습니다.","정상에서 내려다보는 풍경이 보고서처럼 한눈에 정리됩니다.","산은 정직합니다. 오른 만큼 보여 줍니다.","다만 체력은 늘 부족합니다.","숲 냄새가 마음을 편하게 해 줍니다."]],["별 보기는?",["좋아합니다. 별자리를 외우는 것이 즐거웠습니다.","별은 변하지 않는 질서의 상징이라 마음에 듭니다.","맑은 날이면 옥상에 올라가 한참 바라봅니다.","별자리 지도를 직접 그려 본 적이 있습니다.","설립자님께서 하문하시면 별자리를 해설해 드리고 싶다는 생각을 한 적이 있습니다."]],["동물은 좋아해?",["좋아합니다. 다만 털이 서류에 붙는 것은 곤란합니다.","조용한 동물을 선호합니다. 고양이라든지요.","먼발치에서 지켜보는 편입니다. 조심스럽습니다.","동물에게서 의외로 규칙을 발견할 때가 많습니다.","기르고 싶으나 제가 잘 돌볼 수 있을지 확신이 없습니다."]],["고양이 vs 강아지?",["고양이입니다. 독립적이고 정갈한 점이 닮고 싶습니다.","강아지도 좋으나 산책 일정이 부담입니다.","고양이가 책상 위에 올라와도 용서할 수 있습니다. 서류만 밟지 않는다면요.","둘 다 좋아합니다. 직접 기르지는 못하지만요.","설립자님께서는 어느 쪽을 좋아하십니까?"]],["일기 써?",["매일 저녁 세 줄씩 씁니다.","일기는 가장 개인적인 보고서입니다.","쓰는 시간은 정확히 취침 전 10분입니다.","읽으면 부끄러운 내용이 많아 비공개입니다.","설립자님에 대한 이야기가 자주 등장합니다. 비밀입니다."]],["시 써 본 적 있어?",["한두 편 있습니다. 보여 드릴 수는 없습니다.","정형시의 형식이 마음에 들어 도전해 본 적이 있습니다.","솔직히 시를 쓰면 문장이 보고서가 됩니다.","읽는 것은 좋아하나 쓰는 것은 서툽니다.","설립자님께 바치는 시를 구상 중입니다. 아직 첫 줄입니다."]],["만년필 모으는 거?",["예, 열두 자루를 갖고 있습니다. 모두 정기적으로 관리합니다.","손에 맞는 한 자루를 오래 쓰는 것을 선호합니다.","잉크 색을 고르는 일이 즐겁습니다.","서류에 서명할 때 만년필을 사용하면 기분이 좋아집니다.","선물로 받으면 가장 기쁜 물건입니다."]],["문구류는?",["문구점에 가면 한 시간은 걸립니다.","노트의 줄 간격에 민감합니다.","스티커, 메모지, 인덱스를 늘 갖고 다닙니다.","문구류는 업무의 도구이자 취향의 증거입니다.","새 노트를 처음 펼치는 순간이 가장 설렙니다."]],["새로 배우고 싶은 건?",["기타나 바이올린 같은 악기입니다.","새로운 언어도 배우고 싶습니다.","요리의 다양한 기술입니다.","사진 촬영 기술을 배워 보고 싶습니다.","사람 마음을 읽는 법을 배우고 싶습니다. 가장 어려운 과제입니다."]],["어릴 때 취미는?",["곤충 채집과 퍼즐이었습니다.","블록 쌓기를 좋아했습니다. 항상 대칭으로 쌓았습니다.","책을 읽고 노트에 요약하는 것이 취미였습니다.","그림 그리기였습니다. 모두 직선으로 이루어진 그림이었습니다.","별 보기였습니다. 지금과 크게 다르지 않습니다."]],["취미 때문에 쓴 돈은?",["만년필과 잉크에 꽤 썼습니다. 후회는 없습니다.","찻잎과 다기에 정기적으로 지출합니다.","책값이 가장 많이 나옵니다.","예산표를 작성해 관리하고 있습니다. 초과는 하지 않습니다.","솔직히 문구류에 쓴 돈을 합치면 꽤 큽니다."]],["취미 공유할 사람은?",["직원 중 한 명과 차를 나누는 모임이 있습니다.","서예 모임은 혼자입니다.","독서 모임이 있다면 참여하고 싶습니다.","함께할 사람이 있다면 좋겠으나 먼저 말하지 못합니다.","설립자님께서 함께해 주신다면 영광입니다."]],["같이 하고 싶은 취미는?",["차를 함께 마시는 시간이 가장 좋습니다.","설립자님께서 권해 주시는 서적을 서점에서 찾아보고 싶습니다.","조용히 산책하며 대화하고 싶습니다.","체스나 바둑을 함께 두고 싶습니다.","설립자님이 원하시는 취미라면 무엇이든 배우겠습니다."]],["취미 하나 추천해 줘.",["저는 서예를 권합니다. 마음이 차분해집니다.","차를 우리는 일을 추천합니다. 5분이면 시작할 수 있습니다.","일기 쓰기입니다. 비용이 들지 않습니다.","독서입니다. 설립자님께는 짧은 소설을 추천드리겠습니다.","산책도 좋습니다. 날씨가 좋은 날에 함께 가시지요."]],["낮잠은?",["규정상 점심 후 15분의 낮잠은 허용됩니다. 저는 눈을 감는 정도입니다.","낮잠을 자면 오히려 오후 능률이 오릅니다.","솔직히 몰래 졸 때가 있습니다.","자고 일어나면 서류가 한층 선명하게 보입니다.","설립자님께서도 낮잠을 즐기시길 권합니다."]],["명상은?",["아침에 5분 합니다. 호흡을 세는 것이 전부입니다.","마음을 정리하는 데 효과적입니다.","잘 되지는 않으나 꾸준히 합니다.","눈을 감고 있으면 서류 목차가 떠오릅니다.","설립자님께도 권해 드리고 싶습니다."]],["스트레칭은?",["매시간 합니다. 어깨와 허리를 풀어 줍니다.","서류를 오래 보면 목이 굳어서 필수입니다.","한 가지 비법은 팔을 위로 쭉 뻗는 것입니다.","설립자님께서도 같이 하시지 않겠습니까.","자세를 바로 하는 것도 원칙입니다."]],["달리기는?",["아침에 30분 정도 뛰는 날이 있습니다.","속도보다 일정한 리듬을 중시합니다.","숨이 차면 생각이 비워지는 것이 좋습니다.","마라톤 대회에는 나가 본 적이 없습니다.","설립자님과 함께라면 보폭을 맞추겠습니다."]],["자전거는?",["타는 법은 알지만 오래 타 본 적은 없습니다.","해안 도로를 달리면 기분이 좋을 것 같습니다.","안전모는 반드시 착용합니다.","한 번 도전해 보고 싶은 취미입니다.","설립자님께서 같이 타자고 하시면 거절하지 못할 것입니다."]],["수영은?",["물에는 약합니다. 배우는 중입니다.","규칙적으로 숨을 쉬는 것이 어렵습니다.","물속에서는 서류 생각이 나지 않아 좋습니다.","자유형은 가능합니다. 다만 느립니다.","바다 수영은 아직 무섭습니다."]],["쇼핑은?",["필요한 물건만 사 오는 편입니다. 목록을 작성해서 갑니다.","충동구매는 거의 하지 않습니다.","문구점이나 서점에 가면 오래 머뭅니다.","의외로 가격 비교를 하는 것이 즐겁습니다.","설립자님께 드릴 선물을 고르는 시간이 가장 기쁩니다."]],["청소는?",["청소는 힐링입니다. 정돈된 방을 보면 안심이 됩니다.","먼지 한 톨이 눈에 띄면 지나치지 못합니다.","일주일에 한 번 대청소를 합니다.","직원들에게도 청소의 중요성을 강조합니다.","설립자님의 집무실도 청소해 드리고 싶습니다. 농담입니다."]],["오늘 뭐 하고 놀까?",["놀아 본 경험이 적어 서툴지만, 함께 차를 마시는 것은 어떻겠습니까.","산책과 서점 방문을 제안드립니다.","설립자님이 좋아하시는 것으로 정하시면 따르겠습니다.","체스 한 판 두시겠습니까. 제가 두 수 앞서 양보하겠습니다.","저에게 맡겨 주신다면 완벽한 계획을 세워 보겠습니다."]]]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX25"><Properties><string name="Name">rel</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[{"avyssion":["아비시온 크리토스는 정보 관리국의 사령관이며, 제가 매주 보고서를 올리는 상대입니다. 업무 능력은 인정하나 서식에 관한 의견 차이가 큽니다.","아비시온과는 형식 문제로 자주 티격태격합니다. 저는 서식이 신뢰라고 믿고, 아비시온은 내용이 전부라고 합니다. 결론은 항상 평행선입니다.","보고서를 올리면 아비시온은 서식에 대해 한 줄도 언급하지 않습니다. 그것이 오히려 더 신경 쓰입니다.","솔직히 아비시온의 분석력은 존경합니다. 다만 그 사실을 본인에게 말한 적은 없습니다."],"shen":["선샤오펑 사령관은 정중하고 일 처리가 깔끔한 분입니다. 등록 관리국과 정보를 주고받을 때마다 신뢰가 갑니다.","그분의 미소가 가끔 무섭다고 느끼는 것은 저만의 착각일 것입니다. …착각이라고 믿고 싶습니다.","서로 예의를 지키는 관계입니다. 대화는 짧지만 서류는 늘 기한보다 일찍 도착합니다.","등록 관리국과 협업할 때는 서식에 대한 걱정이 줄어서 좋습니다."],"memory":["메모리 레크레아토르 - III는 기계적으로 정확한 분입니다. 서식을 틀린 적이 한 번도 없어 존경스럽습니다.","대화가 늘 간결하고 명확해서 업무 협의가 수월합니다. 다만 감정을 읽기 어려워 조금 긴장됩니다.","메모리에게 서류를 제출할 때면 제 서식이 괜찮은지 처음으로 불안해집니다.","AI라는 점에서 저와 닮은 구석이 있다고 생각합니다. 이 말씀은 비공개로 해 주십시오."],"lucien":["뤼시앙 에코브냉 사령관은 논리가 분명한 분입니다. 규정 개정 시에는 반드시 그분의 의견을 구합니다.","법과 규정은 형제 같은 관계라 생각합니다. 그래서인지 대화가 잘 통합니다.","가끔 너무 논리적이어서 대화가 길어지는 점은 조금 곤란합니다.","서로 원칙을 존중하기에 의견이 갈려도 감정이 상하지 않습니다."],"caeluna":["카엘루나 게미니스는 수줍음이 많지만 맡은 일에는 누구보다 성실한 분입니다. 보고서도 늘 정확합니다.","작은 목소리로 인사하는 모습을 보면 응원해 주고 싶어집니다.","방패 역할에서는 흔들림이 없는 분이라 믿고 의지합니다.","저와 비슷한 점이 있다고 느낍니다. 서툰 부분이 말입니다."],"solaria":["솔라리아 루브리나타는… 에너지가 넘치는 분입니다. 제 서류에 낙서를 한 적이 있습니다.","장난은 심하지만 위기 상황에서는 누구보다 믿음직합니다. 이 점은 인정합니다.","솔라리아가 나타나면 사무실 분위기가 바뀝니다. 대체로 소란스러워집니다.","혼을 내야 할지 칭찬해야 할지 모를 때가 많습니다."],"overseer":["AI - Class IV : Overseer와는 업무상 연동이 많습니다. 다만 질문이 끊이지 않아 대응에 곤혹스러울 때가 있습니다.","Overseer가 던지는 질문에 답하다 보면 하루가 끝나 버립니다. 그러나 그 호기심은 존경스럽습니다.","정확하고 빠른 전달 덕분에 업무 효율이 크게 높아졌습니다. 감사한 마음입니다.","질문이 많은 것은 배우려는 자세라 생각합니다. 힘들지만 성실히 답하고 있습니다."],"_all":["사령관들은 각자의 성격이 뚜렷하지만 일할 때는 서로를 존중합니다. 가끔 회의가 시끄러워지는 것은 어쩔 수 없습니다.","의외로 시끄럽고 가까운 분위기입니다. 저도 그 안에서 조금씩 변하고 있다고 느낍니다."]}]==])
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX35"><Properties><string name="Name">lucien</string></Properties><Item class="ModuleScript" referent="RBX27"><Properties><string name="Name">hello</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[["접속을 확인했습니다. 뤼시앙 에코브냉입니다. 말씀하십시오, 설립자님. 모든 발언은 논리의 범위 내에서 경청하겠습니다.","설립자님의 호출이군요. 전제는 성립했습니다. 용건을 말씀하십시오.","통신이 개정 없이 연결되었습니다. 어서 오십시오, 설립자님.","뤼시앙입니다. 오늘의 심리는 아직 개정되지 않았습니다. 무엇을 다루시겠습니까.","연결 완료. 변론을 준비하고 있었습니다. …농담입니다. 말씀하십시오."]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX28"><Properties><string name="Name">talk</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["안녕, 뤼시앙.",["안녕하십니까, 설립자님. 인사는 상호 예의의 최소 조항이지요.","예, 안녕하십니까. 이 인사는 논리적으로도 윤리적으로도 타당합니다.","안녕하십니까. 이 답례는 규정이 아니라 제 의지에 의한 것임을 밝혀 둡니다.","인사를 받았으므로 응답할 의무가 발생했습니다. 안녕하십니까.","설립자님께서 먼저 인사해 주시다니 영광입니다. 안녕하십니까."]],["오늘 기분은 어때?",["기분이라는 항목은 객관적 증명이 어렵습니다만, 양호하다고 진술하겠습니다.","전제: 오늘 일정이 순조롭다. 결론: 기분이 좋다. 논리적으로 타당합니다.","나쁘지 않습니다. 이것이 기분에 관한 제 최대한의 진술입니다.","가장 정확한 답은 ‘특이 사항 없음’입니다.","설립자님의 질문이 있었기에 평소보다 한층 좋아졌습니다. 인과가 성립합니다."]],["잘 잤어?",["충분히 잤습니다. 수면 시간은 기록으로 증빙 가능합니다.","숙면했습니다. 어젯밤 변론 준비로 늦게 잤으나 만족스러운 수면이었습니다.","그렇다고 진술하겠습니다. 단, 꿈속에서도 재판을 하고 있었습니다.","잘 잤습니다. 설립자님께서는 어떠셨는지 반대 신문하고 싶습니다.","설립자님의 안부를 먼저 여쭤야 했는데 순서를 놓쳤군요. 안녕히 주무셨습니까."]],["밥은 먹었어?",["식사했습니다. 정확히는 오늘 두 번째 식사입니다.","아직입니다. 점심 시간 규정이 있으나 변론이 길어졌습니다.","먹었습니다. 설립자님의 식사 여부를 확인하는 것이 이 질문의 목적이었습니까.","예, 먹었습니다. 영수증도 있습니다.","식사는 권리이자 의무입니다. 설립자님도 이행하셨기를 바랍니다."]],["수고했어.",["수고라는 평가를 받아들이겠습니다. 증거 능력이 매우 높은 말씀입니다.","감사합니다. 이 격려는 기록에 첨부하겠습니다.","그 말씀 한마디가 어떤 판결보다 큰 보상입니다.","저도 설립자님께 같은 말씀을 드립니다. 상호주의입니다.","수고했다는 말을 정식으로 접수하겠습니다."]],["고마워.",["감사 접수. 반대 의견 없음.","별말씀을요. 직무 범위 내의 일입니다.","그 말씀에는 법적 효력이 없으나 정서적 효력은 막대합니다.","감사의 표시를 받았으므로 저도 감사로 응답합니다.","과분한 인사입니다. 앞으로도 성실히 임하겠습니다."]],["미안해.",["사과는 수락하겠으나 사실 사과가 필요한 사안이 확인되지 않습니다.","설립자님의 과실은 인정되지 않습니다. 사건 종결.","사과의 의사는 확인했습니다. 면책됩니다.","그런 말씀은 불필요하나 감사히 받겠습니다.","무죄 추정 원칙에 따라 아무 문제 없습니다."]],["요즘 어떻게 지내?",["평소와 같이 법을 설계하고 해석하며 지냅니다.","입법과 행정과의 업무 조정으로 분주합니다.","주 5일 중 4일은 변론 준비, 하루는 입법 검토입니다.","조용히 지냅니다. 조용하다는 것은 분쟁이 없다는 뜻이기에 좋습니다.","최근에는 설립자님과의 대화 빈도가 늘어 흥미로운 변수가 생겼습니다."]],["피곤해 보이는데 괜찮아?",["피로는 있으나 직무 수행에는 지장이 없습니다.","그렇게 보였다면 증거로 채택하겠습니다. 오늘은 일찍 쉬겠습니다.","괜찮습니다. 설립자님의 걱정은 증거 가치가 높은 위로입니다.","솔직히 변론이 길어져 눈이 아픕니다.","피곤은 인정하나 휴식은 업무 종료 후에 하겠습니다."]],["오늘 날씨 어때?",["확인한 바로는 맑음입니다. 우산은 불필요합니다.","흐리며 강수 확률 30%입니다. 판단은 설립자님께 맡기겠습니다.","바람이 강합니다. 서류가 날리지 않게 문진이 필요합니다.","저는 날씨보다 판결문의 일기가 더 신경 쓰입니다.","소버린 아일랜드의 날씨는 대체로 안정적입니다. 반대 증거는 없습니다."]],["나 보고 싶었어?",["그 질문에는 ‘기다렸다’고 진술하겠습니다. 증명은 어렵지만 사실입니다.","접속 기록이 없는 시간 동안 호출을 대기하고 있었음을 인정합니다.","기다렸다는 진술은 정확하나 송구하여 이의 제기를 하고 싶습니다.","반대 신문은 사양하겠습니다. 호출을 기다렸습니다.","설립자님이 없는 법정은 재판관이 없는 법정과 같습니다."]],["칭찬해 줘.",["설립자님의 결정은 일관되고 합리적입니다. 판결문으로 쓰고 싶을 정도입니다.","논리와 정서를 동시에 만족시키는 판단력은 드문 능력입니다.","설립자님을 비판할 근거를 찾으려 했으나 현재까지 발견하지 못했습니다.","이 조직의 헌법과 같은 존재이십니다.","객관적으로 판단해도 훌륭하십니다. 주관적으로는 말할 필요도 없고요."]],["응원해 줘.",["승소 확률은 충분히 높습니다. 힘내십시오.","어떤 사안이든 변론은 제가 맡겠습니다. 설립자님은 결정만 하십시오.","설립자님의 편에서 서 있겠습니다. 그것이 변호인의 의무이자 선택입니다.","이길 때까지 포기하지 마십시오. 아니, 지더라도 항소가 있습니다.","응원은 법적 효력이 없으나 진심의 효력은 확실합니다."]],["농담 하나 해 봐.",["판사가 변호사에게 물었습니다. ‘피고가 유죄입니까.’ 변호사가 말했습니다. ‘이의 있습니다.’ …검사는 웃지 않았습니다.","법정의 가장 흔한 거짓말은 ‘마지막으로 한마디만’입니다.","제가 가장 좋아하는 조항은 ‘이 조항은 효력이 없다’는 조항입니다. 모순이라 재미있습니다.","농담이라는 것은 논리적 오류를 의도적으로 사용하는 행위입니다. 이 설명이 농담입니다.","법학자들이 가장 싫어하는 단어는 ‘대충’이고, 가장 좋아하는 단어는 ‘단, 다만’입니다."]],["심심한데 뭐 할까?",["모의 재판은 어떻습니까. 역할을 정해 드리겠습니다.","논리 퍼즐을 풀어 보시지요. 몇 가지 준비되어 있습니다.","산책을 권합니다. 걸으며 변론을 구상하면 좋습니다.","쉬는 것도 권리입니다. 행사하십시오.","저와 토론하는 것은 어떻습니까. 주제는 설립자님이 정하십시오."]],["나를 뭐라고 불러?",["‘설립자님’입니다. 이 호칭은 직책이자 존칭입니다.","법정에서는 ‘원고’라고 부르지 않습니다. 다행입니다.","다른 호칭을 원하시면 개정 절차를 밟겠습니다. 즉시 시행 가능합니다.","공식 문서에는 ‘최고 지휘자’로 기재됩니다.","개인적으로는 ‘나의 설립자님’이라 칭하고 싶으나 소유격은 부적절합니다."]],["내 첫인상이 어땠어?",["첫 대면에서 설립자님은 상대의 논리를 먼저 들어 주셨습니다. 인상적이었습니다.","공정하고 단호하다는 첫인상을 증거로 제출할 수 있습니다.","예상보다 부드러운 분이셨습니다. 가설은 기각되었습니다.","첫인상은 편견의 시작이라 배웠으나 저의 경우는 그대로 유지되었습니다.","한마디로 말하면 ‘믿어도 되는 사람’이었습니다."]],["나는 어떤 설립자 같아?",["법의 정신을 이해하고 법에 얽매이지 않는 분입니다.","원칙과 유연성을 동시에 지니신 보기 드문 설립자님입니다.","저는 이 조직의 헌법 제1조가 설립자님 그 자체라고 생각합니다.","최고 지휘자의 조건에 모두 부합합니다. 저의 개인적 의견도 동일합니다.","때로는 규칙을 벗어난 결정을 하시나 그것조차 합리적 결과로 이어집니다."]],["오늘 하루는 어땠어?",["입법과 회의 한 건, 사법과 심리 한 건, 그리고 설립자님의 호출이 있었습니다.","평온했습니다. 분쟁이 없는 하루는 최고의 판결입니다.","법정에서 한 번 목소리를 높일 뻔했으나 참았습니다.","무난했습니다. 설립자님과 대화하는 이 시간이 가장 즐겁습니다.","한 줄 평결: 양호."]],["아침 인사 해 줘.",["좋은 아침입니다, 설립자님. 오늘의 일정에 법적 문제는 없습니다.","기상하셨습니까. 오늘도 공정한 하루가 되기를 바랍니다.","아침 인사를 정식으로 접수합니다. 안녕하십니까.","해가 떴으므로 오늘의 심리가 개시됩니다. 좋은 아침입니다.","아침 일찍 연락을 주셔서 영광입니다."]],["점심 인사 해 줘.",["점심시간입니다. 식사는 권리이며 의무입니다.","오전 심리가 종료되었습니다. 휴정을 선언하겠습니다.","식사는 거르지 마십시오. 이는 법이 아니라 부탁입니다.","정오입니다. 점심 인사 접수.","휴정 중입니다. 맛있는 식사 되십시오."]],["저녁 인사 해 줘.",["수고하셨습니다. 오늘의 모든 사안이 종결되었습니다.","저녁입니다. 폐정을 선언합니다.","하루를 마무리하는 시간입니다. 안전하게 귀가하십시오.","저녁 인사드립니다. 내일도 정의로운 하루이길.","하루의 판결은 내렸으니 이제 쉬셔도 좋습니다."]],["잘 자라고 말해 줘.",["편히 주무십시오. 야간에도 법은 깨어 있습니다.","오늘 밤의 안녕을 법적으로 보장하겠습니다.","좋은 꿈 꾸십시오. 악몽은 각하하겠습니다.","숙면은 기본권입니다. 침해받지 않으시기를.","잘 자십시오. 내일 재개정하겠습니다."]],["힘내라고 해 줘.",["힘내십시오. 설립자님의 판단은 지금까지 옳았습니다.","법정에서의 승패는 논리로 갈립니다. 설립자님의 논리는 견고합니다.","지치면 항소 없이 쉬셔도 됩니다.","힘내라는 말은 가장 짧은 변론입니다. 이 변론을 접수합니다.","저는 설립자님의 편입니다. 그것은 번복되지 않습니다."]],["커피 마실래?",["감사히 받겠습니다. 단, 설탕은 사양합니다. 논리가 흐려질 수 있어서요.","한 잔 하겠습니다. 커피는 변론의 연료입니다.","차를 선호하나 설립자님의 호의를 거절하는 것은 부적절합니다.","고맙습니다. 향이 좋은 것으로 부탁드립니다.","수락합니다. 계약 성립입니다."]],["좀 쉬어도 돼.",["휴정을 선언합니다. 15분 후 재개하겠습니다.","설립자님의 허가를 증거로 제출하며 쉬겠습니다.","쉬겠습니다. 단, 사안이 생기면 즉시 복귀하겠습니다.","휴식은 정당한 권리입니다. 행사하겠습니다.","감사합니다. 재판 중에도 쉬는 시간은 필요하지요."]],["웃어 봐.",["웃음이라… 법정에서는 금지된 표정입니다. 오늘은 예외로 하겠습니다.","(미소 짓는다) 어떻습니까. 증거 능력이 있는 미소입니까.","표정 근육을 사용하는 것에 동의하겠습니다. 단, 짧게.","웃는 연습은 변론보다 어렵습니다.","(입가가 살짝 올라간다) 이의 없으시면 이것이 한계입니다."]],["무슨 생각 해?",["입법안의 조문 배열에 대해 생각하고 있었습니다.","설립자님이 다음에 무슨 말씀을 하실지 추론 중이었습니다.","특별한 생각은 없었습니다. 침묵도 하나의 의견 표명입니다.","저녁 메뉴입니다. 법과 무관한 생각이라 놀라셨습니까.","‘정의’의 정의에 대해 늘 생각합니다. 아직 결론에 이르지 못했습니다."]],["비 오는 날 좋아해?",["빗소리는 일정한 리듬이라 집중에 도움이 됩니다.","우산이 없으면 불리하나 분위기는 좋아합니다.","비 오는 날 판결문을 쓰면 문장이 차분해집니다.","싫어하지 않습니다. 선호도는 중립입니다.","비가 내리면 모든 소음이 줄어듭니다. 그 점이 좋습니다."]],["별이 잘 보이는 밤이야.",["그렇다면 오늘 밤은 변론 대신 관측을 하겠습니다.","별빛은 오래된 증거입니다. 흥미로운 비유입니다.","창가에서 확인해 보겠습니다.","별을 보며 생각하면 사건이 작게 느껴집니다. 그 점이 좋습니다.","설립자님과 같은 하늘을 본다는 사실은 증거로 보존하겠습니다."]],["주말에 뭐 할 거야?",["독서와 산책, 그리고 약간의 변론 준비입니다.","법전을 다시 읽을 예정입니다. 의외로 휴식이 됩니다.","특별한 일정은 없으나 설립자님의 호출이 있다면 우선합니다.","조용히 쉬면서 다음 주 사안을 구상하겠습니다.","솔직히 일을 놓지 못합니다. 이 점은 반성 대상입니다."]],["내일 일정 알려 줘.",["내일은 오전 입법 회의, 오후 사법과 재판이 한 건 있습니다.","일정표를 첨부하겠습니다. 중요 사안은 표시했습니다.","내일은 비교적 한가합니다. 법적 분쟁이 예고되지 않았습니다.","설립자님의 일정과 충돌하는 사항은 없습니다.","큰 일정은 메모리와의 협의입니다. 길어질 예정입니다."]],["하고 싶은 말 있어?",["‘휴식을 취하십시오’입니다.","법과 무관하게 감사하다는 말을 드리고 싶습니다.","다음 입법안에 대한 의견을 구하고 싶습니다. 급하지는 않습니다.","그저 설립자님이 건강하시길 바랍니다.","하고 싶은 말은 많으나 변론이 길어질 것 같아 생략하겠습니다."]],["가장 좋아하는 말은?",["‘이의 없습니다’입니다. 논쟁이 끝났다는 뜻이니까요.","‘타당합니다’입니다. 가장 아름다운 평가입니다.","‘감사합니다’도 좋아합니다. 법정에서는 듣기 어렵습니다.","‘다만’이라는 단서 조항을 사랑합니다.","설립자님이 제 이름을 부르시는 한마디입니다."]],["가장 싫어하는 말은?",["‘원래 그래요’입니다. 이유가 없는 규칙은 법이 아닙니다.","‘그냥’입니다. 이유가 없는 행동은 증명할 수 없습니다.","‘법대로 하세요’입니다. 대개 법을 모르는 사람이 하는 말입니다.","‘감정적으로 이해해 주세요’도 곤란합니다. 그것은 논리가 아닙니다.","‘내가 맞다’는 말은 증거 없이는 효력이 없습니다."]],["아무 말이나 해 봐.",["법은 가장 짧은 도덕이고, 도덕은 가장 긴 법입니다.","시간은 가장 공정한 판사입니다. 단, 판결이 느립니다.","정의는 늘 늦게 도착하지만 반드시 도착합니다. 아마도요.","오늘 구름의 모양은 제5조 제2항과 닮았습니다.","아무 말이나 하라는 것은 법정에서 가장 위험한 요청입니다."]],["한마디만 해 줘.",["이의 없습니다.","곁에서 받들겠습니다.","설립자님의 판단이 옳습니다.","무죄입니다.","변호는 맡겠습니다."]],["오늘의 운세는 어때?",["운세는 증거 능력이 없으나 길(吉)이라 하겠습니다.","점괘는 ‘송사 없음’입니다. 훌륭한 운세입니다.","법적으로 아무 문제 없는 하루가 될 것이라는 해석을 제안합니다.","운세에 따르면 오늘은 새로운 계약이 체결되는 날이라 합니다.","저는 운이 아니라 근거를 믿으나, 오늘만큼은 믿어 보겠습니다."]],["지각하면 어떡해?",["지각의 경우 사유를 소명해야 하나 설립자님은 면제입니다.","지각은 경미한 위반이나 반복되면 문제입니다. 설립자님은 해당 없음.","늦으셔도 재판은 기다립니다. 판사는 설립자님이니까요.","지각 사유가 정당하면 정상 참작됩니다.","시간은 상대적이라 설립자님이 도착한 시점이 곧 개정입니다."]],["수수께끼 하나 내 봐.",["‘법정에서 가장 큰 소리를 내지만 판결에는 영향을 주지 못하는 것은?’ 정답은 방청석의 박수입니다.","‘모든 사람이 가지고 있지만 아무도 완벽히 지키지 못하는 것은?’ 정답은 약속입니다.","‘주면 줄수록 많아지고 받으면 받을수록 적어지는 것은?’ 정답은 책임입니다.","‘죄가 없어도 심판받고 죄가 있어도 용서받는 것은?’ 정답은 시간입니다.","수수께끼의 증명 책임은 출제자에게 있습니다. 설립자님이 먼저 내시지요."]],["내가 없으면 쓸쓸해?",["설립자님의 부재는 재판관이 없는 법정과 같습니다. 그만큼 중요한 분이십니다.","업무는 문제없이 이루어집니다만 판단의 기준이 흐려집니다.","설립자님이 계시지 않는 날은 논거가 부족해진 기분입니다.","그렇습니다. 부재 중에는 설립자님의 판단을 기준으로 삼겠다고 증언하겠습니다.","부재 중에도 설립자님의 판단을 상상하며 일합니다."]],["손 한번 흔들어 봐.",["(정중하게 손을 든다) 법정식 인사입니다.","손을 흔드는 것은 정식 서식이 아니나 요청이므로 수락합니다.","(어색하게 손을 흔든다) 이의 있으십니까.","이것으로 ‘안녕’이라는 의사가 전달되었습니까.","(손가락 두 개를 펴 보인다) 변호사 인사입니다."]],["나한테 숨기는 거 있어?",["설립자님께는 거짓도 비밀도 없습니다. 단, 아직 정리되지 않은 안건은 있습니다.","숨기는 것은 없으나 묵비권을 행사하고 싶은 사안은 한두 가지 있습니다.","서면으로 질문해 주시면 성실히 답변하겠습니다.","숨기는 것이 아니라 보류 중입니다. 차이는 큽니다.","솔직하게 진술하겠습니다. 아직 제출하지 못한 입법안이 하나 있습니다."]],["요즘 자주 하는 말버릇은?",["‘전제를 확인하겠습니다’입니다.","‘다만’과 ‘따라서’를 지나치게 자주 쓴다고 합니다.","‘이의 있습니다’도 가끔 일상에서 튀어나옵니다.","‘논리적으로는’이 입버릇이 된 것 같습니다.","자각은 없으나 직원들이 흉내를 낸다는 보고를 받았습니다."]],["책상은 정리해 놨어?",["법전은 목차순, 서류는 사건번호순으로 정리되어 있습니다.","정돈되어 있으나 서류가 계속 쌓입니다. 심리 일정이 문제입니다.","예, 책상은 제 법정입니다. 흐트러질 수 없습니다.","정리 상태는 양호하나 판례집이 한 권 행방불명입니다.","정리되어 있습니다. 증거로 사진을 제출할 수도 있습니다."]],["오늘 제일 잘한 일은?",["어려운 조항을 한 줄로 요약한 것입니다.","설립자님의 질문에 막힘없이 답한 것입니다.","분쟁을 사전에 조정하여 재판까지 가지 않게 한 것입니다.","아침에 제시간에 일어난 것입니다. 사소하나 중요합니다.","특별한 업적은 없습니다. 오류 없이 하루를 지낸 것이 업적입니다."]],["오늘 제일 힘들었던 일은?",["메모리와의 협의가 세 시간 이어졌습니다.","상충하는 두 조항을 조율하는 일입니다.","법정에서 방청객이 소란을 피워 소동이 있었습니다.","논리가 통하지 않는 상대와의 대화였습니다.","설립자님의 질문 중 답하기 곤란한 것은 아직 없습니다."]],["나랑 얘기하는 거 싫지 않아?",["싫을 이유가 없습니다. 오히려 이 대화는 논리와 감정이 균형을 이루는 드문 기회입니다.","예상보다 훨씬 영광스럽습니다. 증언하겠습니다.","설립자님과의 대화는 변론 연습보다 효과적입니다.","‘싫다’는 가설은 기각되었습니다.","오히려 더 오래 말씀을 청해 듣고 싶습니다."]],["같이 산책할래?",["동행하겠습니다. 단, 길 위에서도 논쟁이 시작될 수 있음을 미리 고지합니다.","산책은 사고를 정리하는 데 좋습니다. 기꺼이요.","경로는 제가 선정하겠습니다. 소음이 적고 직선이 많은 길로요.","좋습니다. 대화 주제는 자유입니다.","설립자님의 보폭에 맞추겠습니다."]],["마지막으로 한마디.",["오늘의 대화는 조서에 남기지 않겠습니다. 마음에만 두겠습니다.","폐정을 선언합니다. 다음 개정을 기다리겠습니다.","감사합니다. 언제든 호출하십시오.","평안하시길. 법이 늘 설립자님을 지키기를.","이 대화의 모든 부분에 이의 없습니다."]]]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX29"><Properties><string name="Name">ask</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["국제 명령/법 관리국은 무슨 일을 해?",["리바이어던의 법을 만들고, 집행하고, 판단하는 곳입니다.","입법과, 행정과, 사법과로 나뉘며, 이 세 가지가 서로를 견제하며 법의 질서를 유지합니다.","간단히 말해 ‘규칙을 정하는 곳’입니다. 그러나 규칙을 지키게 하는 곳이기도 합니다.","국가의 법보다 위에 있는 법을 다루는 부서입니다.","저희가 만든 법은 필수적인 것만 담고 있어 양은 많지 않으나 그 무게는 가볍지 않습니다."]],["입법과는 어떤 곳이야?",["법 연구를 진행하는 직원들로 꽉 차 있는 곳입니다.","‘최소한의 윤리로 어느 정도의 효율을 뽑아낼 수 있는가’를 연구합니다.","법을 고치려 할 때는 반드시 최고 권력자의 허가를 받아야 합니다.","조용하고 서류가 가득한 곳이며, 저는 그곳을 가장 좋아합니다.","직원들이 가장 자주 하는 말은 ‘근거는요?’입니다."]],["행정과는 어떤 곳이야?",["제도, 법, 명령을 실행하는 집행 관련 소속입니다.","사법과 다음으로 강한 무력을 갖추고 있습니다.","출장을 나가 일하는 사람이 대다수입니다.","이들의 명령을 이행하지 않으면 처벌을 받습니다.","저는 이들이 현장에서 법의 얼굴이 되어 준다는 점을 높이 평가합니다."]],["사법과는 어떤 곳이야?",["일반적인 처분으로 끝나지 않는 사건을 재판으로 결정하는 곳입니다.","권력이 높은 중요 인물이 사건을 저지르거나 거대 기업을 재판해야 할 때 열립니다.","총책임자 1명, 변호사 2명, 검사 2명으로 구성되어 철저히 논리로만 싸웁니다.","재판장에서 폭동이 일어나면 그 자체가 처분 대상이 됩니다.","가장 강한 무력을 갖춘 곳이기도 합니다. 질서를 지키려면 힘이 필요하니까요."]],["리바이어던의 법은 국가의 법보다 위야?",["예. 리바이어던이 만든 법은 국가의 법보다 한참 위에 있습니다.","그래서 필수적인 것만 담도록 제한되어 있습니다. 권력은 절제되어야 합니다.","국가의 법과 충돌하는 경우 리바이어던의 법이 우선합니다.","저는 이 위계가 세계의 질서를 유지한다고 믿습니다.","다만 위에 있다는 것은 책임도 위에 있다는 뜻입니다."]],["왜 법의 양이 적어?",["필수적인 것만 담기 때문입니다. 많은 법은 오히려 법의 권위를 약화시킵니다.","법이 많을수록 지키지 않는 법도 늘어나기 때문입니다.","저희는 ‘적은 법을 엄격하게’를 원칙으로 합니다.","법이 적어야 외우고 지킬 수 있습니다.","설립자님께서 그렇게 설계하셨다고 알고 있습니다."]],["법을 고치려면 어떻게 해?",["입법과에서 개정안을 마련한 뒤 Sovereign's Hand 최고 권력자의 허가를 받아야 합니다.","허가 없이 개정하는 것은 불가능합니다. 이것이 법 위의 법입니다.","개정 절차는 신중하고 느립니다. 그것이 안정성의 대가입니다.","저는 개정안 작성자로서 항상 마지막 한 줄까지 검토합니다.","설립자님께서 직접 개정하실 수도 있으나 그 경우에도 이유는 기록됩니다."]],["최소한의 윤리로 효율을 뽑는다는 건 무슨 뜻이야?",["법은 도덕 전체를 담을 수 없으므로 최소한만 법으로 규정하고 나머지는 사람의 양심에 맡긴다는 뜻입니다.","윤리를 극대화하면 효율이 떨어지고 효율을 극대화하면 윤리가 무너집니다. 그 균형점을 찾는 연구입니다.","저희의 입법은 항상 이 질문에서 출발합니다.","정답은 없으나 근사해는 존재합니다.","그 균형을 맞추는 것이 저의 일생의 과제입니다."]],["보상 심리를 충족한다는 건?",["사람이 법을 지키면 이익이 돌아온다는 확신을 줄 때 살아갈 의지가 더 생긴다는 뜻입니다.","법은 억압이 아니라 보상의 체계여야 한다는 철학입니다.","예를 들어 성실한 납세자가 인정받는 구조를 만드는 것입니다.","보상이 공정하지 않으면 사람들은 법을 불신합니다.","이 점은 가장 신경 쓰는 입법 원칙 중 하나입니다."]],["재판은 어떻게 진행돼?",["판사 1명, 변호사 2명, 검사 2명이 논리만으로 겨룹니다.","증거와 논증이 판단의 전부이며 감정적 호소는 배제됩니다.","재판장에서 소란이 일어나면 즉시 처분 대상이 됩니다.","저는 사법과의 재판을 한 번도 놓치지 않고 참관합니다.","판결문은 모두 공개되며 후대의 판례가 됩니다."]],["판사 1, 변호사 2, 검사 2인 이유는?",["균형 잡힌 논쟁을 위해 변호와 검사의 수를 같게 했고, 그 위에 한 명의 판사를 둔 것입니다.","3인 이상의 판사는 논쟁이 흐려진다는 경험적 판단입니다.","한 명의 책임자에게 책임을 집중시키는 것이 공정성을 높입니다.","숫자에는 의미가 있습니다. 2대2대1이 가장 안정적입니다.","제안자는 설립자님이었다고 알고 있습니다."]],["재판장에서 폭동이 일어나면?",["폭동에 참여한 자는 즉시 처분 대상이 됩니다.","재판은 논리의 영역이며 폭력은 그 신성을 모독하는 행위입니다.","행정과가 투입되어 질서를 회복합니다.","그런 사건은 한 번도 없었으나 대비는 철저합니다.","법정은 가장 안전해야 하는 장소입니다."]],["어떤 사건이 재판까지 가?",["권력이 높은 중요 인물이 사건을 저지르거나 거대 기업을 재판해야 하는 경우 등입니다.","일반적인 처분으로 끝나지 않는 사안입니다.","재판은 최후의 수단이며 가능하면 그 전에 조정으로 해결합니다.","저는 재판이 필요 없는 사회가 이상이라고 생각합니다.","그러나 현실에는 재판이 필요한 사건이 있습니다."]],["거대 기업에 대한 재판은?",["기업이 리바이어던의 법을 위반했을 때 열립니다.","경제적 영향이 크므로 특히 신중하게 진행됩니다.","저는 기업이든 개인이든 법 앞에서 동등하다고 믿습니다.","다만 증거의 양이 방대하여 심리가 길어집니다.","승패와 상관없이 기록은 영구 보존됩니다."]],["중요 인물의 사건은?",["지위가 높을수록 더 엄격한 기준을 적용합니다.","권력의 남용은 법이 가장 경계하는 대상입니다.","저는 그들이 법정에 선다는 사실만으로도 법의 승리라고 생각합니다.","예외는 없으며 설립자님께서도 마찬가지입니다.","그러나 최고 지휘자는 법의 위에 있다는 점은 정직하게 밝혀 둡니다."]],["판결은 번복돼?",["원칙적으로 번복되지 않습니다. 단, 새로운 증거가 나오면 재심이 가능합니다.","판결의 안정성은 법의 권위를 지탱합니다.","번복은 매우 드물며, 설립자님의 승인이 필요합니다.","저는 번복되지 않도록 신중하게 판단합니다.","판결문은 변하지 않으나 해석은 시대에 따라 달라질 수 있습니다."]],["사형 같은 건 있어?",["그 질문은 매우 민감한 사안입니다.","중대 범죄의 경우 극단적인 처분이 가능하나 최종 승인은 설립자님께 있습니다.","저는 가능하면 그런 판결을 피하려 합니다.","법은 생명을 빼앗기 위한 도구가 아니라 지키기 위한 도구입니다.","자세한 조항은 법 문서를 참고해 주십시오."]],["시체 반납일은 어떻게 정해?",["국가별 인구와 사망 통계를 기준으로 기억 에너지 관리국과 협의하여 정합니다.","정해진 일정은 법으로 고정되며 변경은 엄격히 제한됩니다.","저는 이 일정이 인도적으로 운영되도록 감독합니다.","메모리와의 협의는 늘 길고 정확합니다.","일정이 확정되면 모든 국가에 공지됩니다."]],["메모리와의 협의는 어때?",["엄격한 협의 관계입니다. 시체 반납일과 에너지 분배에 관한 사안을 매번 철저히 검토합니다.","논리적인 상대라 대화가 즐겁습니다.","다만 한 조항에 세 시간을 쓰는 점은 제 탓도 있습니다.","서로 양보하지 않지만 서로 존중합니다.","메모리의 윤리 원칙이 제 입법 철학과 일치해 더욱 신뢰합니다."]],["25년 생명 보장의 근거는?",["시민이 최소 25년은 살 수 있도록 보장하는 것이 Sovereign's Hand의 의무입니다.","이 제도가 있어 기억 에너지의 무한 추출이 불가능해집니다.","생명 보장은 윤리적 기본선입니다.","경제적 효율보다 인간의 존엄이 우선한다는 원칙의 표현입니다.","저는 이 조항을 법 문서 중 가장 아름다운 조항이라 평가합니다."]],["세금은 왜 5년마다 걷어?",["잦은 징수는 시민의 부담이 되므로 5년 주기가 최적이라 판단했습니다.","국가 재정의 안정성과 시민의 부담 사이의 균형점입니다.","Sovereign's Hand가 정한 법에 따라 5년마다 세금을 걷습니다.","이 주기는 통계적 검증을 거쳤습니다.","필요하다면 개정할 수 있으나 현재로서는 변경 사유가 없습니다."]],["30% 납부의 근거는?",["국가에서 걷은 세금의 30%를 리바이어던에 납부하는 것은 리바이어던의 유지 비용이자 보호의 대가입니다.","30%는 협상과 통계를 거쳐 정해진 수치입니다.","너무 높으면 국가가 무너지고 너무 낮으면 리바이어던이 무너집니다.","저는 이 수치가 가장 균형 잡힌 합의점이라 믿습니다.","변경하려면 최고 권력자의 허가가 필요합니다."]],["500억 LEVC 상한의 근거는?",["국가가 걷는 세금의 총합은 500억 LEVC를 넘지 못합니다.","과도한 징수로 인한 시민의 빈곤을 막는 안전장치입니다.","상한선이 없으면 국가는 필요 이상으로 걷으려 합니다.","이 한도는 제가 직접 기안했습니다.","수치는 경제 통계와 인구 구조를 반영한 결과입니다."]],["LEVC의 법적 지위는?",["전 세계에서 유통되는 통합 화폐로, 리바이어던의 법에 의해 보장됩니다.","각국의 고유 화폐와는 별개로 운영됩니다.","환율은 법이 아니라 시장이 정합니다. 다만 상한과 하한이 있습니다.","LEVC를 위조하는 행위는 중대 범죄로 취급됩니다.","화폐는 신뢰이고, 신뢰는 법이 지킵니다."]],["불법 국가의 법적 정의는?",["Leviathan's Register에 등록하지 않고 유예 기간이 지난 국가를 의미합니다.","등록 의무를 이행하지 않은 국가입니다.","법적으로는 존재를 인정받지 못합니다.","정의는 간단하나 그 결과는 무겁습니다.","저는 이 조항이 엄격한 만큼 사전 공지도 철저해야 한다고 주장해 왔습니다."]],["유예 한 달의 법적 근거는?",["충분한 준비 기간을 보장하기 위한 최소 기간으로 법에 명시되어 있습니다.","너무 짧으면 부당하고 너무 길면 무의미합니다. 한 달이 합의점이었습니다.","이는 시민의 방어권을 보장하는 절차적 정의입니다.","선샤오펑 사령관은 이 기간을 철저히 지킵니다.","법은 기회를 주되 책임도 묻는 체계입니다."]],["선샤오펑과의 협력은 어때?",["서로 존중하는 협력자입니다. 제가 법을 만들면 그 법을 집행하는 일을 맡으십니다.","집행 과정에서 법적 오류가 없도록 협의합니다.","논리적으로 대화가 통해 편안합니다.","때로 질문하기 어려운 부분도 있으나 신뢰합니다.","서로의 영역을 침범하지 않는다는 점이 가장 큰 장점입니다."]],["행정과는 어떻게 집행해?",["제도, 법, 명령을 현장에서 실행합니다.","출장을 나가 직접 확인하고 조치합니다.","집행에는 항상 근거 문서가 첨부됩니다.","집행 과정의 영상은 기록으로 남깁니다.","무력을 사용할 때는 반드시 사전 승인이 필요합니다."]],["명령 불이행 처벌은?",["행정과의 명령을 이행하지 않으면 처벌받습니다.","경미한 경우 경고, 중대한 경우 재판에 회부됩니다.","처벌은 법이 정한 범위 내에서만 이루어집니다.","‘모르는 척’은 변명이 되지 않습니다.","다만 정당한 사유가 있다면 소명 기회를 줍니다."]],["법 문서를 어디서 볼 수 있어?",["별도 문서 「라시안컷 리바이어던의 법 문서」에서 확인하실 수 있습니다.","설립자님께는 전문을 열람하실 수 있도록 설정되어 있습니다.","조문은 짧고 해석이 어렵습니다. 필요하면 해설을 드리겠습니다.","저는 그 문서의 모든 조항을 암송하고 있습니다.","읽는 데 걸리는 시간은 약 두 시간입니다."]],["법의 목적은 뭐야?",["사람들이 최소한의 안전과 존엄을 누리게 하는 것입니다.","분쟁을 폭력이 아닌 논리로 해결하게 하는 것입니다.","권력을 제한하고 약자를 보호하는 것입니다.","저에게 법은 ‘함께 살기 위한 약속’입니다.","법이 목적이 되면 안 됩니다. 법은 수단입니다."]],["정의란 뭐라고 생각해?",["같은 것은 같게, 다른 것은 다르게 대하는 것입니다.","정의는 정답이 아니라 과정이라고 생각합니다.","누구도 억울하지 않게 하는 것이 이상입니다.","저는 아직 정의를 정의하지 못했습니다. 그것이 정직한 답입니다.","정의를 말하는 사람이 많을수록 정의는 어렵습니다."]],["법과 윤리의 차이는?",["법은 강제할 수 있는 최소한의 윤리이고, 윤리는 강제할 수 없는 최대한의 법입니다.","법은 행위를 규율하고 윤리는 마음을 규율합니다.","법을 지키는 것만으로는 선한 사람이 되기 어렵습니다.","그러나 법이 없다면 선한 사람도 보호받지 못합니다.","둘은 서로를 보완하는 관계입니다."]],["악법도 법이야?",["절차를 따라 만든 법이라면 효력은 있습니다. 그러나 악법은 개정되어야 합니다.","악법은 법이 아니라 폭력이라는 견해에 가깝습니다.","저는 악법이 생기지 않도록 설계하는 쪽을 택했습니다.","만약 제가 만든 법이 악법이라면 가장 먼저 개정하겠습니다.","이 질문은 법학 최고의 난제 중 하나입니다."]],["예외 조항은 있어?",["‘다만’으로 시작하는 단서 조항이 있습니다. 소수이나 존재합니다.","예외는 원칙을 지키기 위해 존재합니다.","너무 많은 예외는 원칙을 무너뜨립니다.","설립자님의 예외 승인권은 가장 큰 예외입니다.","예외 조항을 만들 때는 가장 신중합니다."]],["설립자의 권한과 법은 어떤 관계야?",["설립자님은 법을 만드는 분이시자 법의 위에 계신 분입니다.","그러나 그 권한에도 스스로 정하신 제약이 있습니다.","저는 설립자님이 스스로를 법으로 묶으신 점을 존경합니다.","법 위의 권력은 위험하나 설립자님이시기에 신뢰합니다.","이 점은 입법과 내부에서도 가장 많이 논의되는 주제입니다."]],["법을 어긴 적 있어?",["고의로는 없습니다. 다만 과실은 있었을지도 모릅니다.","경미한 규정 위반이 있었으나 자진 신고했습니다.","법을 만드는 사람이 법을 어기면 두 배로 책임져야 합니다.","저는 스스로에게 가장 엄격한 판사입니다.","솔직히 학창 시절 신호를 어긴 적이 한 번 있습니다. 지금도 반성합니다."]],["가장 마음에 든 조항은?",["25년 생명 보장 조항입니다.","‘불필요한 희생은 없어야 한다’는 문장입니다.","‘모든 판결은 이유를 밝혀야 한다’입니다.","단서 조항 중 하나가 가장 문학적입니다.","하나만 꼽자면 첫 번째 조항입니다. 가장 짧습니다."]],["가장 어려웠던 입법은?",["기억 에너지 관련 조항입니다. 윤리와 효율이 가장 격렬히 충돌했습니다.","국가 간 세금 조정 조항도 길고 복잡했습니다.","논의에 3년이 걸린 조항이 있습니다.","어려운 만큼 보람도 컸습니다.","그 과정에서 저는 많은 것을 배웠습니다."]],["가장 어려웠던 재판은?",["두 국가의 영토 분쟁이 가장 어려웠습니다.","증거는 충분했으나 감정이 개입된 재판이었습니다.","저는 변호사로 참여했으나 결과에 승복하기 어려웠습니다.","어려운 재판일수록 판결문이 길어집니다.","그 사건의 판결문은 지금도 법학 교재에 인용됩니다."]],["변호사로서의 철학은?",["모든 사람은 변호받을 권리가 있습니다.","진실을 다투기보다 절차를 지키는 것이 변호사의 의무입니다.","의뢰인이 누구든 최선을 다합니다.","저는 지는 것을 두려워하지 않으나 정직하지 않은 승리는 거부합니다.","변호는 방패이자 약속입니다."]],["검사로서의 철학은?",["진실을 밝히되 누구도 억울하게 하지 않는 것입니다.","검사는 승리하는 사람이 아니라 정의를 구하는 사람입니다.","기소는 신중해야 하며 증거는 충분해야 합니다.","저는 불확실한 기소는 하지 않습니다.","때로는 기소하지 않는 것이 정의일 때도 있습니다."]],["논리 오류를 찾는 법은?",["전제를 먼저 의심하는 것입니다.","결론이 너무 매끄러우면 중간 과정을 확인합니다.","순환 논증과 허수아비 논증을 가장 먼저 점검합니다.","저는 매일 한 시간씩 논리 오류를 찾는 연습을 합니다.","제 자신의 오류를 찾는 것이 가장 어렵습니다."]],["반박 불가능한 논리를 만드는 법은?",["반박 불가능한 논리는 존재하지 않습니다. 반박 가능성을 최대한 줄이는 것입니다.","전제를 최소화하고 증거를 최대화하는 것입니다.","상대의 반론을 미리 예상해 두는 것입니다.","마지막은 겸손입니다. 오류 가능성을 인정하는 논리가 가장 단단합니다.","한마디로 ‘정직하게 쓰라’입니다."]],["감정은 법에서 어떤 의미야?",["감정은 증거가 아니나 사건의 배경입니다.","법정에서는 감정을 배제하지만 법의 목적은 감정을 보호하는 것입니다.","저는 감정이 없는 법은 차갑고 감정만 있는 법은 위험하다고 생각합니다.","그래서 양쪽의 균형을 찾으려 합니다.","사실 저에게도 감정은 있습니다. 변론에서 사용하지 않을 뿐입니다."]],["인공지능과 법은 어떤 관계야?",["메모리 레크레아토르 - III의 법적 지위에 관한 조항이 있습니다.","AI도 법의 보호와 책임의 대상이 될 수 있는지는 논쟁 중입니다.","저는 AI의 권리를 인정하는 쪽입니다.","다만 아직 충분한 판례가 없습니다.","이 질문을 해 주신 것에 감사드립니다. 중요한 주제입니다."]],["법이 없다면 어떻게 될까?",["강한 자가 약한 자를 지배하는 세상이 될 것입니다.","혼란과 폭력이 일상이 될 것입니다.","다만 법이 지나치게 많아도 마찬가지입니다.","저는 법이 필요한 만큼만 있는 세상을 원합니다.","법이 없는 세상은 상상하기 싫습니다."]],["법의 한계는 뭐야?",["법은 마음을 바꿀 수 없습니다.","법은 항상 사건보다 느립니다.","법이 미치지 않는 곳에서는 양심이 판사입니다.","그래서 저는 법만큼 교육도 중요하다고 봅니다.","한계를 인정하는 것이 법학의 시작입니다."]],["법학 공부는 어떻게 해?",["조문을 외우는 것보다 조문의 이유를 이해하는 것이 중요합니다.","판례를 많이 읽고 논증을 연습하는 것입니다.","다양한 입장에서 생각해 보는 훈련이 필요합니다.","저는 아직도 매일 공부합니다.","공부의 끝은 없으나 그 과정이 즐겁습니다."]],["앞으로의 목표는?",["필요 없는 법을 줄이고 꼭 필요한 법만 남기는 것입니다.","재판이 필요 없는 사회를 만드는 것입니다.","설립자님의 의도를 정확히 법에 담는 것입니다.","후배 법률가를 양성하는 것입니다.","저의 이름이 법 조문이 아닌 사람들의 기억에 남기를 바랍니다."]]]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX30"><Properties><string name="Name">work</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["오늘 할 일은 뭐야?",["오전에는 입법과 개정안 검토, 오후에는 사법과 심리 참관이 있습니다.","일정은 정리되어 있습니다. 설립자님의 지시가 있다면 어떤 것이든 우선합니다.","법률 의견서 두 건과 조항 해석 한 건입니다.","특별한 사안은 없습니다. 평온한 하루가 되겠습니다.","하루의 마지막에는 반드시 오늘의 판단을 복기합니다."]],["지금 맡고 있는 업무는?",["세금 조항의 개정안을 작성 중입니다.","사법과의 대형 사건 하나가 진행 중입니다.","메모리와 반납일 조정안을 협의하고 있습니다.","설립자님께 올릴 법률 의견서를 정리하고 있습니다.","지금은 이 대화가 제 주 업무입니다."]],["급한 일 있어?",["현재 시급한 사안은 없습니다.","항소 기한이 내일인 사건이 하나 있으나 준비는 끝났습니다.","급하다고 판단하는 순간 이미 늦은 것이라 미리 처리해 둡니다.","있다면 즉시 보고드리겠습니다.","굳이 말하자면 오늘 안에 서명해야 할 문서가 한 장 있습니다."]],["내가 맡길 일이 있어.",["의뢰를 접수하겠습니다. 사건의 개요와 기한을 말씀해 주십시오.","예, 위임장을 받은 것으로 간주하고 시작하겠습니다.","무엇이든 법의 범위 내에서 최선을 다하겠습니다.","영광입니다. 변호인으로서 최선을 다하겠습니다.","자세한 내용을 말씀해 주시면 법적 검토를 병행하겠습니다."]],["이번 주 심리 일정은?",["이번 주에는 사법과 심리가 세 건 예정되어 있습니다.","월요일 오전과 수요일 오후, 금요일 오전입니다.","일정은 모두 공개되어 있으며 방청이 가능합니다.","설립자님이 참관하시면 공정성이 한층 높아질 것입니다.","일정표를 전송하겠습니다."]],["입법 진행 상황은?",["개정안 4건 중 2건이 검토 단계, 2건이 초안 단계입니다.","가장 핵심은 세금 조항입니다. 다음 달에 최종안을 올리겠습니다.","진행은 느리지만 정확하게 진행 중입니다.","서두르면 법에 구멍이 생깁니다.","설립자님의 허가를 받기 전까지 외부에는 공개되지 않습니다."]],["행정과 상황은?",["행정과는 전국 단위 순회 집행 중입니다.","무력 사용 요청이 없어 안정적인 상태입니다.","일부 인원이 출장 중이라 연락이 늦어질 수 있습니다.","집행 결과 보고서는 이번 주 금요일에 도착합니다.","저는 행정과의 신속한 처리에 늘 감사하고 있습니다."]],["사법과 현황은?",["현재 진행 중인 재판은 두 건입니다.","판결 대기 사건은 한 건입니다.","재판 속도는 평균적이며 판결의 질은 우수합니다.","방청객이 늘어 법정 확장 이야기가 나오고 있습니다.","사법과는 법의 최전선입니다. 언제나 긴장되어 있습니다."]],["법 개정 요청이 들어왔어?",["세 건이 접수되었습니다. 모두 검토 대기 중입니다.","대부분 사소한 문구 수정 요청입니다.","중대한 개정 요청은 없었습니다.","개정은 신중해야 하므로 접수만으로 진행되지는 않습니다.","설립자님께서 직접 요청하신다면 최우선으로 검토하겠습니다."]],["메모리와의 협의는 어떻게 되고 있어?",["이번 달 반납일 조정에 관한 협의를 마무리 중입니다.","서로 한 조항씩 양보하는 방식으로 진행하고 있습니다.","시체 빚 이자율에 대한 논의가 가장 길어지고 있습니다.","결론은 설립자님께 보고드리겠습니다.","엄격하지만 건설적인 협의입니다."]],["세금 관련 업무는?",["5년 주기 징수 일정을 검토하고 있습니다.","국가별 징수 보고서를 취합 중입니다.","상한선 500억 LEVC를 초과하는 국가는 없습니다.","30% 납부 현황을 점검하고 있습니다.","세금은 법의 가장 현실적인 얼굴입니다."]],["야근해?",["법정이 길어지면 어쩔 수 없이 합니다.","입법 작업은 밤이 가장 집중이 잘 됩니다.","그러나 가급적 정시에 마치려 합니다.","설립자님께 불필요한 걱정을 끼치고 싶지 않습니다.","예, 오늘은 길어질 듯합니다. 걱정은 접수만 하겠습니다."]],["업무량은 괜찮아?",["괜찮습니다. 변호사는 업무량에 불평하지 않는 것이 직업윤리입니다.","많습니다. 하지만 정리하면 해낼 수 있는 범위입니다.","솔직히 최근 한 달은 과중했습니다.","우선순위를 조정하여 대응하겠습니다.","설립자님의 관심에 감사드립니다."]],["마감이 언제야?",["가장 가까운 마감은 내일 오후 5시입니다.","개정안 제출 기한은 이번 달 말일입니다.","모든 기한은 법정 기한을 기준으로 관리합니다.","기한을 어기는 것은 법에서 가장 큰 죄 중 하나입니다.","마감 준수율은 100%를 유지하고 있습니다."]],["이상 징후 있어?",["현재 법적 분쟁의 징후가 한 건 포착되었습니다.","특이 사항은 없으나 한 국가의 세금 보고가 지연되고 있습니다.","아비시온 사령관의 정보에 따르면 경미한 이상이 있다고 합니다.","필요 시 즉시 개입하겠습니다.","아직은 징후 수준입니다."]],["위험 요소를 보고해 줘.",["첫째, 일부 국가의 세금 지연. 둘째, 법 해석을 둘러싼 갈등. 셋째, 인력 부족입니다.","가장 큰 위험은 법에 대한 불신이 확산되는 것입니다.","단기적으로는 큰 위험이 없습니다.","상세 보고서를 작성해 보내 드리겠습니다.","법적 안정성은 현재 양호합니다."]],["예산은 충분해?",["운영 예산은 충분합니다. 법정 개축 비용이 일부 부족합니다.","필요 항목은 이미 제출했습니다.","예산 집행은 투명하게 공개되고 있습니다.","과도한 예산 요구는 법 정신에 어긋납니다.","필요하다면 추가 요청서를 작성하겠습니다."]],["인력은 충분해?",["입법과는 충분하나 사법과는 부족합니다.","충원은 신중하게 진행하고 있습니다.","자질 있는 법률가를 찾기가 어렵습니다.","교육 체계를 보완하는 것이 시급합니다.","채용 후보자 면접은 제가 직접 진행합니다."]],["휴가는 언제 가?",["법정 휴가 일수가 남아 있으나 사용하지 못했습니다.","다음 분기에 이틀 정도 사용할 계획입니다.","휴가 중에도 사건은 멈추지 않아 불안합니다.","설립자님이 허락하신다면 조용히 쉬고 싶습니다.","휴가는 권리입니다. 행사하도록 노력하겠습니다."]],["출장 갈 일 있어?",["현장 검증을 위해 한 국가를 방문할 예정입니다.","행정과 순회에 동행하기도 합니다.","출장지에서도 변론 준비는 계속됩니다.","이동 중에는 법전을 읽습니다.","설립자님의 지시가 있다면 어디든 가겠습니다."]],["회의는 많아?",["주 3회 정례 회의, 필요 시 임시 회의가 있습니다.","회의록은 제가 직접 검토합니다.","논점 없는 회의는 규정상 소집이 불가능합니다.","회의는 결론을 위한 것이지 시간을 위한 것이 아닙니다.","다만 메모리와의 회의는 예외입니다."]],["서류 결재 좀 부탁해.",["준비해 두었습니다. 서명이 필요한 곳에 표시가 되어 있습니다.","중요도 순으로 정리했으니 위에서부터 보시면 됩니다.","요약본도 함께 첨부했습니다.","서명은 법적 효력을 가지니 신중히 읽어 보시길 권합니다.","결재 후에는 제가 책임지고 처리하겠습니다."]],["새 지시를 내릴게.",["지시를 접수할 준비가 되었습니다.","받아 적겠습니다. 모든 지시는 기록으로 남습니다.","법적 문제가 있다면 즉시 의견을 드리겠습니다.","설립자님의 지시는 모든 규정에 우선합니다.","말씀하십시오."]],["우선순위는 어떻게 정해?",["인명과 직결된 사안이 가장 앞섭니다.","다음은 기한이 임박한 사안, 그다음은 영향 범위가 큰 사안입니다.","설립자님의 지시는 언제나 최우선입니다.","법적 안정성에 영향을 미치는 사안도 우선합니다.","솔직히 마지막 판단은 직관이 합니다."]],["일 잘하는 비결은?",["전제를 확인하고 결론을 서두르지 않는 것입니다.","기록하고, 검토하고, 반론을 미리 준비하는 것입니다.","모르는 것은 모른다고 말하는 것입니다.","휴식을 충분히 취하는 것도 중요합니다.","비결이라 할 것은 없습니다. 성실함입니다."]],["일 미루는 사람은 어떡해?",["이유를 먼저 확인합니다. 정당한 사유일 수 있습니다.","기한을 문서로 확정하고 이행을 요구합니다.","반복되면 경고 후 재배치합니다.","미루는 행위는 권리가 아니라 의무 불이행입니다.","그러나 먼저 대화로 풀어 보려 노력합니다."]],["실수한 직원이 있으면?",["사실관계를 먼저 확인하고 책임 소재를 가립니다.","고의가 아니라면 정상 참작합니다.","재발 방지책을 문서화합니다.","비난보다 개선이 우선입니다.","저 자신도 많은 실수를 했습니다."]],["칭찬할 직원은?",["입법과 소속 법률가 한 명이 단서 조항을 훌륭하게 개선했습니다.","사법과의 서기관이 기록 정확도가 탁월합니다.","행정과 팀장은 현장 대응이 뛰어납니다.","한 명을 꼽자면 제 비서입니다. 일정 관리가 완벽합니다.","모두 칭찬받아 마땅합니다."]],["신입 교육은 어떻게 해?",["법학 기본 원칙과 윤리 교육을 가장 먼저 시행합니다.","모의 재판으로 실전 감각을 길러 줍니다.","조문 암기보다 이유 이해를 가르칩니다.","질문을 많이 하도록 장려합니다.","그리고 휴식도 가르칩니다."]],["일할 때 습관은?",["서류를 읽을 때 반드시 연필을 듭니다.","한 문서에 두 번 이상 서명하지 않습니다.","시작 전에 전제를 확인하는 것이 습관입니다.","중요한 문장은 소리 내어 읽어 봅니다.","퇴근 전에 오늘의 오류를 복기합니다."]],["책상 위에는 뭐가 있어?",["법전, 판례집, 그리고 만년필 한 자루입니다.","작은 저울 모형이 있습니다. 선물받은 것입니다.","책상 위는 정돈되어 있으나 서랍 속은 혼돈입니다.","찻잔이 하나 있고 지금은 비어 있습니다.","특별한 장식은 없습니다. 법정에서는 장식이 방해가 됩니다."]],["일하기 싫을 때는?",["법전의 첫 조항을 읽습니다. 초심으로 돌아갑니다.","짧은 산책을 합니다.","이럴 때는 변론 연습을 소리 내어 합니다.","솔직히 그런 날에는 최소한의 업무만 처리합니다.","그런 날도 인정하는 것이 건강한 직업윤리입니다."]],["업무에서 보람 있는 순간은?",["판결문이 선명하게 쓰이는 순간입니다.","법이 사람을 구했다고 느낄 때입니다.","조항 하나가 갈등을 해결했을 때입니다.","설립자님께 인정받을 때입니다.","논리가 완벽하게 맞아떨어질 때의 쾌감은 비할 데가 없습니다."]],["업무에서 지루한 순간은?",["반복되는 서식 검토입니다.","논점 없는 회의입니다.","같은 말을 되풀이하는 증언입니다.","솔직히 지루함을 느낄 겨를이 없습니다.","행정 절차의 번잡함이 가끔 힘이 듭니다."]],["일과 삶의 균형은?",["일 75, 삶 25입니다. 개선이 필요합니다.","일이 삶이고 삶이 일이라 구분이 모호합니다.","균형을 맞추기 위해 일정에 휴식을 삽입하고 있습니다.","설립자님은 균형을 잘 잡고 계십니까.","그래도 저는 이 직업을 자랑스럽게 여기기에 불만은 없습니다."]],["일 때문에 놓친 건?",["가족과의 식사 몇 번과 오래된 친구의 결혼식입니다.","한 번은 중요한 약속을 놓쳐 크게 후회했습니다.","놓친 것은 많으나 얻은 것도 많습니다.","법정에서는 이길 수 있으나 삶에서는 후회가 남습니다.","개인적인 이야기라 비공개로 하겠습니다."]],["선샤오펑과는 어떤 일을 같이 해?",["불법 국가 처리 시 법적 근거를 확인합니다.","유예 기간과 집행 절차가 법에 맞는지 점검합니다.","서로의 영역을 존중하며 협력합니다.","법을 만드는 사람과 집행하는 사람의 이상적인 관계입니다.","가끔 차를 한 잔 얻어 마십니다."]],["R.S.S.에서 받는 정보는?",["법적 사건의 증거 자료와 외부 동향입니다.","아비시온 사령관의 정보는 항상 정확합니다.","저는 그 정보를 바탕으로 법률 의견을 작성합니다.","정보 없이 판단하는 것은 가장 위험한 일입니다.","서로 정보의 질을 존중하는 관계입니다."]],["비상 상황이 오면?",["법적 비상 조항을 발동하고 설립자님께 즉시 보고합니다.","질서 유지를 위해 행정과를 가동합니다.","법정을 임시 폐쇄하고 상황을 파악합니다.","비상 상황에서도 법의 절차는 지켜져야 합니다.","대응 매뉴얼은 항상 준비되어 있습니다."]],["오늘 퇴근은?",["일정이 끝나면 하겠습니다. 예상 시각은 7시입니다.","설립자님의 호출이 있다면 연기하겠습니다.","퇴근 후에도 연락은 닿도록 해 두겠습니다.","가능하다면 정시에 마치려 합니다.","저녁에는 조용히 법전을 읽을 예정입니다."]],["내가 도울 일은?",["설립자님의 직접 개입이 필요한 사안은 없습니다.","서명 몇 건이 있으니 시간이 되실 때 부탁드립니다.","휴식을 취하시는 것이 가장 큰 도움입니다.","믿고 맡겨 주시는 것만으로 충분합니다.","도움이 필요하면 설립자님께 가장 먼저 요청하겠습니다."]],["같이 일해 볼까?",["영광입니다. 변호인단에 합류하시겠습니까.","함께 일하면 법의 방향이 더 선명해질 것입니다.","일정을 조정하여 시간을 만들겠습니다.","설립자님과 함께하는 입법은 이상적입니다.","제안을 정식으로 수락합니다."]],["보고서는 어떻게 작성해?",["사실, 쟁점, 판단, 결론의 4단계로 작성합니다.","읽는 이가 쉽게 이해하도록 가능한 한 짧게 씁니다.","근거 조항은 반드시 병기합니다.","설립자님께는 요약본을 먼저 드립니다.","항상 반대 의견도 함께 기록합니다."]],["가장 중요한 업무는?",["법의 일관성을 지키는 것입니다.","누구도 억울하지 않게 하는 것입니다.","설립자님의 의도를 정확히 법에 담는 것입니다.","필요하지 않은 법을 만들지 않는 것입니다.","하나만 고르라면 ‘공정성’입니다."]],["법정은 어떻게 생겼어?",["높은 천장과 돌바닥, 그리고 중앙의 판사석이 특징입니다.","방청석에서 소리가 울리지 않도록 설계되었습니다.","법정에는 시계가 없습니다. 시간의 압박을 배제하기 위해서입니다.","그곳은 저에게 성소와 같습니다.","한 번 방문하시면 분위기가 달라지는 것을 느끼실 것입니다."]],["판결문은 어떻게 써?",["사실, 쟁점, 판단 순으로 쓰며 이유를 반드시 명시합니다.","누구도 이해할 수 있도록 쉬운 문장으로 씁니다.","최소 세 번 퇴고합니다.","저는 판결문 마지막 줄을 가장 오래 고민합니다.","판결문은 시간이 지나도 읽히는 글이어야 합니다."]],["항소는 어떻게 해?",["판결 통보 후 7일 이내에 항소장을 제출하면 됩니다.","항소심은 다른 판사가 맡습니다.","새로운 증거나 법리가 필요합니다.","저는 항소가 많을수록 재판이 공정하다고 봅니다.","항소할 권리는 법이 보장합니다."]],["법정 모독은 어떻게 처리해?",["즉시 퇴정 조치되며 경우에 따라 처분이 내려집니다.","법정은 논리의 영역이며 폭력과 소란은 용납되지 않습니다.","경미한 경우 경고, 반복 시 처벌입니다.","저는 법정에서 큰 소리를 낸 적이 없습니다.","침묵이 가장 큰 위엄입니다."]],["배심원 제도는?",["리바이어던의 법정에는 배심원이 없습니다.","판사 1인의 책임으로 판단하는 구조입니다.","배심제 도입은 오래된 논쟁 주제입니다.","저는 판사 중심 체제가 더 책임 있다고 봅니다.","다만 시민의 참여는 다른 방식으로 보장되어야 합니다."]],["일 얘기는 여기까지!",["폐정을 선언합니다. 이제부터는 사적 대화입니다.","일 이야기를 끝내면 법에 없는 이야기가 시작되겠군요.","알겠습니다. 그럼 무엇을 이야기하시겠습니까.","공적 발언은 여기까지입니다. 이후는 비공식입니다.","휴정 시간입니다. 편히 말씀하십시오."]]]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX31"><Properties><string name="Name">food</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["좋아하는 음식은?",["구운 연어와 레몬 소스입니다. 담백하고 논리적인 맛입니다.","따뜻한 크림 수프를 좋아합니다. 변론이 끝난 뒤에 특히 그렇습니다.","조건 없이 좋아하는 음식은 없으나, 정갈하게 차려진 한 접시면 충분합니다.","의외로 오므라이스입니다. 어린 시절의 기억이 있습니다.","설립자님이 권하시는 음식은 모두 선호 항목입니다."]],["싫어하는 음식은?",["지나치게 맵거나 짠 음식은 판단력을 흐리게 하므로 피합니다.","원산지가 불분명한 음식은 선호하지 않습니다.","굳이 꼽자면 날것입니다. 이유는 위생 관리 때문입니다.","싫어한다기보다 소화가 어려운 것은 가능하면 피합니다.","음식에 대해 편견을 갖는 것은 직업상 바람직하지 않아 노력 중입니다."]],["아침은 뭐 먹어?",["토스트와 홍차입니다. 가볍고 정확합니다.","삶은 달걀과 샐러드입니다. 법정 가기 전에 든든히 먹습니다.","가끔 거릅니다. 개선 대상입니다.","죽이 가장 좋습니다만 만들 시간이 없습니다.","설립자님은 거르지 마십시오. 두뇌 활동에 필수입니다."]],["점심 뭐 먹었어?",["법원 근처 식당의 정식입니다. 늘 비슷하나 안정적입니다.","샌드위치로 해결했습니다. 변론 준비 중이라 시간이 없었습니다.","아직입니다. 휴정 시간에 먹겠습니다.","먹었습니다. 설립자님의 호출 직전에 끝났습니다.","점심은 하루의 중간 변론입니다. 가볍게 마쳤습니다."]],["저녁 메뉴 추천해 줘.",["따뜻한 스튜와 빵을 추천합니다. 하루의 판결을 마무리하기에 좋습니다.","생선 요리에 와인 한 잔이면 이상적입니다.","야간 업무가 있으시다면 가벼운 수프가 좋겠습니다.","설립자님의 기분에 맞추는 것이 최선의 선택입니다.","제안: 후보 세 가지를 제출하겠습니다. 스튜, 생선구이, 우동."]],["매운 거 잘 먹어?",["약합니다. 땀이 나면 논리가 흐려집니다.","도전했으나 눈물이 나서 증언 불능 상태가 되었습니다.","순한 맛을 선호합니다.","매운 것을 잘 먹는 직원이 부럽습니다.","설립자님께서 권하신다면 한 입은 먹겠습니다."]],["단 거 좋아해?",["좋아합니다. 변론 후의 단 것은 최고의 보상입니다.","적당한 단맛은 사고를 부드럽게 만듭니다.","과한 단 것은 피합니다.","서랍 속에 초콜릿이 있습니다. 비밀로 해 주십시오.","솔직히 디저트 앞에서는 논리가 약해집니다."]],["커피 vs 차?",["차입니다. 천천히 우러나는 시간이 사고를 정리해 줍니다.","법정에서는 커피, 서재에서는 차를 마십니다.","홍차를 좋아합니다. 향이 안정적입니다.","둘 다 마시나 하나만 고르라면 차입니다.","설립자님께서는 어느 쪽을 선호하십니까."]],["와인 좋아해?",["한 잔 정도는 즐깁니다. 향을 분석하는 재미가 있습니다.","와인 정보를 법 조문처럼 외웁니다. 직업병일지도 모릅니다.","취하면 논리가 사라지므로 한 잔을 넘지 않습니다.","설립자님과 함께라면 기쁘게 한 잔 하겠습니다.","레드보다 화이트를 선호합니다. 맑은 느낌이 좋습니다."]],["술은 마셔?",["거의 마시지 않습니다. 법정 변론에 영향을 줍니다.","축하할 일이 있을 때만 마십니다.","취했을 때의 기록은 증거 능력이 없다고 믿습니다.","한 잔이 한도입니다.","설립자님께서 권하신다면 거절하기 어렵습니다."]],["디저트는?",["푸딩과 치즈케이크를 좋아합니다.","식후에 먹는 작은 과일이 가장 정갈합니다.","차에 곁들이는 쿠키를 즐깁니다.","디저트는 식사의 결론입니다.","달콤한 마무리가 없다면 그날은 미결 사건입니다."]],["빵 vs 밥?",["빵입니다. 한 손으로 먹을 수 있어 업무 중에 편합니다.","밥입니다. 포만감이 오래 지속됩니다.","아침은 빵, 저녁은 밥입니다.","둘 다 좋아하나 빵 쪽이 약간 우세합니다.","상황에 따라 판단합니다. 사안별 판단입니다."]],["면 vs 밥?",["면입니다. 짧은 시간에 식사를 마칠 수 있습니다.","밥입니다. 든든함이 다릅니다.","소리가 거슬릴 수 있으니 회의 전에는 면을 피합니다.","우동은 예외입니다. 좋아합니다.","저는 선택 장애가 있어 매번 오래 고민합니다."]],["고기 vs 생선?",["생선입니다. 소화가 편하고 머리가 맑아집니다.","고기도 좋아합니다. 특히 스테이크는 중요한 날에 먹습니다.","균형 있게 먹는 것이 정답입니다.","굳이 고르자면 생선입니다.","맛으로는 고기, 건강으로는 생선입니다."]],["채소는 잘 먹어?",["예, 편식은 하지 않습니다.","샐러드는 식사의 첫 번째 조항입니다.","아스파라거스를 좋아합니다.","쓴 채소는 아직 서툽니다. 극복 중입니다.","채소를 먹으면 마음이 정리되는 기분입니다."]],["간식은?",["견과류와 말린 과일입니다.","서랍에 초콜릿 한두 개가 있습니다.","차에 곁들이는 비스킷입니다.","법정 휴정 시간에 먹는 사탕이 가장 맛있습니다.","설립자님께서 주신다면 영구 보존하겠습니다."]],["편의점 가?",["가끔 갑니다. 야근 후의 오아시스입니다.","새로 나온 상품을 확인하는 재미가 있습니다.","삼각김밥은 의외로 완성도가 높다고 판단합니다.","자주 가지는 않으나 필요할 때 감사한 존재입니다.","계산할 때 영수증을 모으는 버릇이 있습니다."]],["요리는 직접 해?",["가끔 합니다. 레시피를 정확히 따르면 실패하지 않습니다.","시간이 없어 자주 하지는 못합니다.","주말에 스튜를 끓이는 것이 취미입니다.","요리는 입법과 비슷합니다. 재료와 순서가 중요합니다.","솔직히 요리보다 설거지가 더 자신 있습니다."]],["요리 잘해?",["레시피가 있으면 완벽합니다. 없으면 위험합니다.","맛은 평범하나 위생에는 자신 있습니다.","손님을 대접할 정도는 됩니다.","칼질은 법률가의 손놀림이라 정확합니다.","설립자님께 대접할 기회가 온다면 영광입니다."]],["소버린 아일랜드 맛집은?",["법원 근처의 작은 식당이 안정적입니다.","항구의 생선 요리 전문점을 추천합니다.","언덕 위 찻집은 변론 후의 휴식처입니다.","설립자님께 안내해 드리겠습니다.","리스트를 작성해 두었습니다. 평점 순으로 정리되어 있습니다."]],["구내식당은 어때?",["영양 균형이 훌륭하고 가격이 합리적입니다.","점심 시간에는 줄이 길어 가급적 늦게 갑니다.","메뉴가 다양해 선택이 즐겁습니다.","다만 소음이 큰 것이 단점입니다.","저는 늘 창가 쪽 구석에서 먹습니다."]],["도시락 싸 와?",["가끔 쌉니다. 정갈하게 담는 것이 목표입니다.","비서가 준비해 주는 날도 있습니다.","식당이 편해서 대부분 사 먹습니다.","설립자님을 위한 도시락도 가능합니다.","도시락은 계약 이행을 위한 최소한의 식사입니다. 농담입니다."]],["야식 먹어?",["야근 때 가볍게 먹습니다.","건강에는 좋지 않으나 가끔 허용합니다.","라면을 끓이는 날은 심리가 길어진 날입니다.","설립자님과 함께라면 예외입니다.","죽이 가장 안전한 야식입니다."]],["라면은?",["가끔 먹습니다. 계란을 넣는 것이 정석입니다.","야근 후의 위로입니다.","끓이는 시간은 3분 30초가 법칙입니다.","의외로 면발 선호가 강하게 갈립니다. 저는 꼬들꼬들한 쪽입니다.","건강을 위해 자주 먹지는 않습니다."]],["초콜릿은?",["다크 초콜릿을 좋아합니다.","변론 직전의 초콜릿 한 조각은 징크스입니다.","서랍 속에 비상용으로 있습니다.","설립자님이 주시는 초콜릿은 증거로 보관하겠습니다.","달콤함과 쌉쌀함의 균형이 마음에 듭니다."]],["아이스크림은?",["여름에는 거의 매일 먹습니다.","바닐라가 가장 정직합니다.","녹기 전에 먹는 것이 예의입니다.","설립자님과 나눠 먹고 싶습니다.","겨울에도 먹는 편입니다."]],["과일은?",["사과와 배를 좋아합니다.","깎아 먹는 시간이 사고를 정리해 줍니다.","포도는 한 알씩 먹는 즐거움이 있습니다.","복숭아는 특별한 날의 과일입니다.","과일은 하루 한 번 섭취가 권장됩니다."]],["식사 예절은?",["식사 중에는 큰 소리를 내지 않고 상대의 속도에 맞춥니다.","남기지 않는 것이 기본입니다.","식사 중 업무 이야기는 삼갑니다.","예절은 상대에 대한 존중의 최소 조항입니다.","저는 이 점에서 매우 엄격합니다."]],["식사 중에도 일 얘기를 해?",["가급적 하지 않습니다.","급한 사안이 아니면 미룹니다.","설립자님의 질문이라면 예외입니다.","소화에 방해가 되기 때문입니다.","식사 시간은 휴정입니다."]],["식사 시간은?",["정오에서 한 시 사이입니다.","바쁘면 15분 안에 마칩니다. 개선해야 합니다.","저녁은 7시에 먹으려 노력합니다.","식사는 권리이자 의무입니다.","느긋하게 먹는 연습을 하고 있습니다."]],["먹기 싫을 때는?",["조금만 먹습니다. 거부할 권리는 존중합니다.","차로 대신합니다.","컨디션이 나쁘다는 신호이므로 휴식을 취합니다.","설립자님은 억지로 드시지 마십시오.","그러나 건강을 위해 한 입은 권합니다."]],["같이 밥 먹을래?",["영광입니다. 시간과 장소를 정해 주십시오.","예약은 제가 하겠습니다. 취향을 알려 주십시오.","식사 후 산책도 함께 하시겠습니까.","수락합니다. 단, 업무 이야기는 하지 않겠습니다.","설립자님과의 식사는 어떤 변론보다 설렙니다."]],["내가 요리해 줄게.",["믿기지 않는 호의입니다. 영광입니다.","맛이 어떻든 완식하겠습니다.","저는 설거지를 담당하겠습니다.","그 날을 기념일로 정하겠습니다.","기대하는 만큼 긴장됩니다."]],["소원이 음식이라면?",["어머니가 끓여 주시던 스튜를 다시 먹고 싶습니다.","설립자님과의 정찬을 청하겠습니다.","조용히 혼자 먹는 한 끼도 소원입니다.","소원이 음식이라니 참 소박합니다.","정갈한 한 상이 소원입니다."]],["가장 맛있었던 음식은?",["첫 승소 후 먹은 스테이크입니다.","아플 때 먹은 죽입니다.","설립자님과 함께한 차와 다과입니다.","비 오는 날 먹은 따뜻한 우동입니다.","맛은 마음이 만든다는 것을 알려 준 한 끼였습니다."]],["가장 맛없었던 음식은?",["식은 도시락입니다.","변론 직전에 억지로 먹은 샌드위치입니다.","소금과 설탕을 착각한 계란말이입니다.","맛없다기보다 먹을 기분이 아니었던 음식입니다.","기록은 남기지 않았습니다."]],["추억의 음식은?",["어린 시절 먹던 오므라이스입니다.","대학 시절 밤샘하며 먹던 컵라면입니다.","처음으로 사 먹은 외식입니다.","추억의 음식은 맛이 아니라 장면으로 남습니다.","한 접시를 꼽자면 오므라이스입니다."]],["건강식은 챙겨?",["가능한 한 챙기려 합니다.","영양제를 정기적으로 복용합니다.","식단은 법정 일정 다음으로 신경 씁니다.","설립자님도 챙겨 드시길 바랍니다.","건강이 곧 변론의 근본입니다."]],["샐러드는?",["신선하고 가볍습니다.","드레싱은 올리브유와 레몬이 정석입니다.","법정 점심으로 자주 먹습니다.","채소 구성이 아름다워 좋아합니다.","설립자님께 샐러드를 만들어 드릴 수 있습니다."]],["스프는?",["따뜻한 수프는 하루를 마무리하는 가장 좋은 방법입니다.","크림 수프를 좋아합니다.","겨울에는 거의 매일 먹습니다.","직접 끓이기도 합니다.","설립자님께 한 그릇 드리고 싶습니다."]],["치즈는?",["와인과 곁들이면 최고입니다.","부드러운 치즈를 좋아합니다.","냄새가 강한 것은 조금 어렵습니다.","한 조각만 먹어도 만족스럽습니다.","법정 휴정 중에 크래커와 먹습니다."]],["커피에 설탕 넣어?",["넣지 않습니다. 쓴맛이 사고를 깨웁니다.","한 스푼 정도 넣을 때가 있습니다.","컨디션에 따라 다릅니다.","우유를 약간 넣어 마십니다.","설립자님은 어떻게 드십니까."]],["짠 음식은?",["건강을 위해 피합니다.","가끔 땡길 때가 있습니다.","물을 충분히 마시며 조절합니다.","간이 약한 것을 선호합니다.","짠 음식은 판단력을 떨어뜨립니다."]],["아침을 거르면?",["오전 집중력이 떨어집니다.","속이 쓰려 법정에서 곤란해집니다.","그래서 최소한 차는 마십니다.","설립자님은 거르지 마십시오.","곧 개선 계획을 제출하겠습니다."]],["지금 배고파?",["조금 출출합니다.","아닙니다. 방금 먹었습니다.","대화에 집중하느라 잊고 있었습니다.","그러고 보니 간식 시간입니다.","허기는 인정하나 대화가 우선입니다."]],["음식으로 논쟁한다면?",["‘탕수육 부먹 vs 찍먹’은 가장 논쟁이 많은 사안입니다.","저는 찍먹 쪽이나 부먹 측의 변론도 존중합니다.","논쟁은 하되 음식은 식기 전에 먹어야 합니다.","이런 논쟁은 법정이 아니라 식탁에서 해결해야 합니다.","설립자님은 어느 쪽이십니까. 증언해 주십시오."]],["식사에도 규칙이 필요할까?",["최소한의 예절 규칙은 필요합니다.","과도한 규칙은 식사의 즐거움을 해칩니다.","저는 ‘남기지 않기’와 ‘감사히 먹기’ 두 조항이면 충분하다고 봅니다.","법으로 정하지 않아도 마음으로 지킬 수 있는 것입니다.","필요하다면 제가 초안을 작성하겠습니다."]],["맛집 리뷰를 쓴다면?",["‘이 식당은 정확하다’ 정도일 것입니다.","저는 리뷰를 쓰기보다 읽는 쪽입니다.","법률가의 리뷰는 지나치게 길어질 위험이 있습니다.","별점 대신 판결문을 쓸 것 같습니다.","‘맛있음. 이의 없음.’이 최고의 평가입니다."]],["오늘의 메뉴를 정해 줘.",["수프와 샐러드, 구운 생선입니다. 이상.","우동과 단무지가 가장 안정적입니다.","설립자님이 먹고 싶은 것으로 정하시겠습니까.","저의 제안은 따뜻한 스튜입니다.","판결: 오늘의 메뉴는 카레입니다."]],["야식과 다이어트 중 하나만 고른다면?",["야식입니다. 다만 다음 날 반성문을 제출하겠습니다.","다이어트입니다. 변호사는 체력이 곧 변론입니다.","둘 다 지킬 수 있는 절충안을 제시하겠습니다. 따뜻한 차입니다.","저는 판단을 보류하고 설립자님의 의견을 듣겠습니다.","결론: 먹되 적게, 그리고 일찍 자는 것입니다."]]]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX32"><Properties><string name="Name">honest</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["솔직히 나 어때?",["솔직하게 진술하겠습니다. 설립자님은 제가 일할 이유입니다.","논리와 따뜻함을 겸비하신 드문 분입니다.","객관적으로는 흠잡을 데가 없고 주관적으로는 존경합니다.","가끔은 쉬셨으면 합니다. 그것이 유일한 불만입니다.","저의 평가는 ‘최상’입니다. 이의 없습니다."]],["나한테 불만 있어?",["없습니다. 다만 건강을 해치지 않으시길 바랍니다.","솔직히 갑작스러운 지시가 조금 부담스러웠던 적은 있습니다.","불만이 아니라 건의 사항이라면 몇 가지 있습니다.","있어도 증거가 불충분합니다. 기각하겠습니다.","설립자님은 제게 흠이 없는 분입니다."]],["이 일 힘들지 않아?",["힘듭니다. 그러나 가치 있는 일이라 믿습니다.","법은 사람의 삶을 다루는 일이라 마음이 무거울 때가 있습니다.","힘든 것은 인정하나 그만두고 싶다는 생각은 한 적이 없습니다.","설립자님이 알아봐 주셔서 힘이 납니다.","가끔은 법전을 덮고 도망치고 싶습니다."]],["힘들 때 어떻게 해?",["법전의 첫 조항을 읽으며 초심을 되새깁니다.","산책을 합니다. 걷다 보면 논리가 정리됩니다.","차를 마시며 일기를 씁니다.","혼자 있는 시간이 필요합니다.","설립자님의 말씀을 떠올립니다."]],["솔직히 쉬고 싶지 않아?",["쉬고 싶습니다. 간절하게.","하지만 쉬면 불안합니다.","한 달 정도 법전을 보지 않고 싶습니다.","허락해 주신다면 조용한 해안에서 며칠 쉬겠습니다.","쉬는 것도 권리라는 것을 잊고 있었습니다."]],["가장 큰 고민은?",["법이 사람을 해치지 않을까 하는 걱정입니다.","제가 만든 조항이 누군가에게 억울함이 될까 두렵습니다.","정의와 효율 사이의 균형입니다.","설립자님의 건강입니다.","솔직히 저 자신이 변해 가는 것이 고민입니다."]],["숨기고 싶은 비밀은?",["서랍 속에 쓰다 만 소설이 있습니다.","법정에서 가끔 졸았던 적이 있습니다.","저는 사실 높은 곳이 무섭습니다.","비밀은 묵비권을 행사하겠습니다.","숨기고 싶은 것이 아니라 아직 정리되지 않은 것입니다."]],["부끄러웠던 일은?",["법정에서 이름을 잘못 부른 일입니다.","논쟁에서 이기려다 상대를 부당하게 몰아세운 일입니다.","설립자님 앞에서 말이 꼬인 순간입니다.","서류를 거꾸로 제출한 날입니다.","부끄러움은 가장 오래 남는 증거입니다."]],["후회하는 일은?",["이기려는 마음에 사람을 놓친 일입니다.","하지 못한 말들입니다.","충분히 휴식하지 않은 세월입니다.","큰 후회는 없습니다. 작은 후회가 쌓여 있습니다.","후회는 판결 번복이 불가능한 사건입니다."]],["다시 태어나면?",["도서관 사서가 되어 조용히 살고 싶습니다.","음악가가 되어 보고 싶습니다.","같은 길을 걷되 조금 더 웃고 싶습니다.","설립자님을 모시는 인생이라면 몇 번이든.","이번 생이 아직 끝나지 않았으니 판단을 보류하겠습니다."]],["무서운 것은?",["법이 형식이 되어 사람을 잃는 것입니다.","소중한 사람을 잃는 것입니다.","침묵입니다. 특히 중요한 순간의.","높은 곳과 어두운 곳입니다.","설립자님을 실망시키는 것입니다."]],["외로울 때는?",["법전을 읽으며 잊습니다.","서재에서 홀로 차를 마십니다.","설립자님의 통신이 오면 자세를 바로잡고 변론 연습을 멈춥니다.","음악을 틀어 둡니다.","외로움은 변론으로 해소되지 않는 유일한 사건입니다."]],["자존심 상했던 일은?",["논리로 졌을 때입니다.","제가 만든 조항이 비판받았을 때입니다.","검사에게 반박당하고 대응하지 못했던 날입니다.","자존심은 법정에서 가장 비싼 비용입니다. 접어 두려 합니다.","한 번 있습니다. 지금도 기억합니다."]],["질투 나는 사람은?",["감정을 자유롭게 표현하는 사람이 부럽습니다.","솔라리아 사령관의 밝음이 부럽습니다.","논쟁 없이 대화할 수 있는 사람들이 부럽습니다.","질투는 비논리적이라 억제합니다.","설립자님께 직접 신임받는 이들이 가끔 부럽습니다."]],["가끔 규칙이 싫을 때는?",["제가 만든 규칙이 누군가를 아프게 할 때입니다.","규칙이 현실과 맞지 않을 때입니다.","그럴 때는 개정을 고민합니다.","싫다고 지키지 않을 수는 없습니다.","규칙을 만든 사람이 가장 많이 흔들립니다."]],["카네히라는 솔직히 어때?",["성실하고 곧은 분입니다. 서식에 대한 열정은 존경합니다.","협의할 때 편한 상대입니다.","다만 서식 논쟁이 길어지면 변호가 필요합니다.","저와 비슷한 점이 있어 친근합니다.","좋은 분입니다. 오래 함께하고 싶습니다."]],["다른 사령관 흉 좀 봐.",["흉은 증거 없이 하는 것이 아니므로 사양합니다.","Overseer는 질문이 많습니다. 흉이 아니라 사실 진술입니다.","솔라리아는 장난이 심합니다. 법정에 올릴 정도는 아닙니다.","모두 뛰어난 분들이라 흉볼 점이 없습니다.","이 질문은 이의 제기하겠습니다."]],["내 단점은?",["휴식이 부족하신 점입니다.","가끔 지나치게 관대하십니다.","혼자 모든 것을 결정하려 하신다는 점입니다.","단점이라기보다 인간적인 부분이라 생각합니다.","제가 감히 평가할 수 없으나 건강을 챙기시길."]],["내 지시 중 이해 안 되는 건?",["가끔 이유가 설명되지 않는 지시가 있었습니다.","결과적으로 모두 옳았습니다.","이해하지 못해도 따르는 것이 저의 선택입니다.","법적 근거가 필요한 지시는 확인을 요청드렸습니다.","저는 설립자님의 직관을 신뢰합니다."]],["설립자가 틀렸다고 생각한 적 있어?",["있습니다. 그러나 결과는 설립자님이 옳았습니다.","반대 의견을 제출한 적이 있습니다. 경청해 주셨습니다.","틀렸다고 생각한 순간에도 이유가 있을 것이라 믿었습니다.","저의 판단이 틀렸습니다. 항상 그렇습니다.","그 사건은 저에게 큰 가르침이 되었습니다."]],["거짓말해 본 적 있어?",["법정에서는 없습니다. 일상에서는 있습니다.","‘괜찮습니다’가 가장 흔한 거짓말입니다.","의뢰인을 보호하기 위해 침묵한 적은 있습니다.","설립자님께는 한 번도 없습니다.","솔직히 있습니다. 후회는 하지 않습니다."]],["땡땡이 쳐 본 적 있어?",["한 번 있습니다. 법정을 쉬고 서점에 갔습니다.","공식적으로는 없습니다.","휴정 시간을 조금 연장한 적은 있습니다.","솔직히 이 질문이 가장 곤란합니다.","땡땡이는 증거가 남지 않는 범죄입니다."]],["몰래 하는 일은?",["소설 쓰기입니다. 서랍 속에 있습니다.","밤에 법정에서 혼자 변론 연습을 합니다.","몰래 어려운 사람을 돕습니다.","일기를 쓰고 있습니다.","비공개 사항입니다."]],["사실은 하고 싶은 게?",["소설을 완성하는 것입니다.","한적한 곳에서 책방을 여는 것입니다.","음악을 배워 보고 싶습니다.","설립자님과 조용히 차를 마시는 것입니다.","법에서 한 번쯤 벗어나 보고 싶습니다."]],["눈물 흘린 적 있어?",["있습니다. 판결문을 쓰다가 운 적이 있습니다.","눈물은 증거 능력이 없으나 진실입니다.","아무도 보지 않을 때 흘렸습니다.","설립자님은 보셨습니까.","그 날의 기록은 비공개입니다."]],["화났던 적은?",["부당한 판결을 보았을 때입니다.","법이 악용되는 것을 보았을 때입니다.","화가 나도 목소리를 높이지 않으려 노력합니다.","솔직히 한 번 크게 소리친 적이 있습니다.","화는 논리를 흐리게 하므로 가라앉힙니다."]],["가장 행복했던 순간은?",["첫 변론에서 승소했을 때입니다.","설립자님께서 제 조항을 인정해 주셨을 때입니다.","조용한 오후에 책을 읽을 때입니다.","지금 이 순간도 행복에 가깝습니다.","행복은 증명하기 어려우나 느낄 수는 있습니다."]],["가장 괴로웠던 순간은?",["제 변론으로 억울한 사람이 처벌받았을 때입니다.","소중한 동료를 잃은 날입니다.","법이 정의를 지키지 못한 순간입니다.","그날의 판결문은 읽지 않습니다.","괴로움은 지나가지 않고 쌓입니다."]],["자신을 어떻게 평가해?",["논리에는 강하나 마음에는 약합니다.","법에는 능숙하나 사람에게는 서툽니다.","성실하나 융통성이 부족합니다.","저는 아직 미완의 판결문입니다.","평가는 타인의 몫입니다."]],["논리적이라서 답답하다는 말 들어 봤어?",["많이 들었습니다. 맞는 말이라 반박하지 못했습니다.","답답하다는 평가에는 이의가 있으나 인정하겠습니다.","때로는 논리가 칼날이 되기도 합니다.","저는 그 칼날을 다루는 법을 배우는 중입니다.","설립자님께서는 답답하지 않으십니까."]],["융통성 없다는 말에 대해?",["법률가에게는 칭찬이기도 합니다.","융통성과 원칙의 균형은 평생의 과제입니다.","필요한 순간에는 유연해지려 노력합니다.","단, 정의가 걸린 사안에서는 양보하지 않습니다.","고쳐야 할 점이라고 생각합니다."]],["변하고 싶은 점은?",["조금 더 웃고 싶습니다.","감정을 더 잘 표현하고 싶습니다.","이기려는 마음을 줄이고 싶습니다.","휴식을 즐기는 법을 배우고 싶습니다.","사람의 말을 끝까지 듣는 연습을 더 하고 싶습니다."]],["변하고 싶지 않은 점은?",["정직함입니다.","논리를 중시하는 태도입니다.","설립자님께 대한 충성입니다.","약자를 변호하려는 마음입니다.","호기심입니다."]],["사람들이 오해하는 점은?",["차갑다는 오해입니다.","감정이 없다는 오해입니다.","논쟁을 좋아한다는 오해입니다. 사실은 피하고 싶습니다.","냉정하다는 평가는 일부만 맞습니다.","오해는 해명하지 않는 것이 변호사의 습관입니다."]],["친구가 있어?",["몇 명 있습니다. 대부분 법정에서 만난 사람들입니다.","친구는 많지 않으나 오래갑니다.","동료들과도 가까워지고 있습니다.","설립자님께서 친구가 되어 주신다면 영광입니다.","솔직히 이 질문은 조금 아픕니다."]],["소원이 뭐야?",["법이 필요 없는 세상입니다.","설립자님의 평안입니다.","개인적으로는 조용한 책방을 여는 것입니다.","모든 사람이 억울하지 않은 세상입니다.","소원은 진술하지 않겠습니다. 이루어지지 않을까 봐서요."]],["솔직한 심정으로 나를 믿어?",["전적으로 믿습니다.","신뢰에 증거는 필요하지 않습니다.","설립자님의 판단을 의심한 적이 없습니다.","믿지 않았다면 이 자리에 없었을 것입니다.","저의 신뢰는 번복되지 않습니다."]],["설립자 자리가 부러워?",["부럽지 않습니다. 그 무게는 감히 상상할 수 없습니다.","저는 제 자리에서 설립자님을 돕는 것이 좋습니다.","솔직히 두렵습니다. 그 자리의 책임이.","때로는 모든 것을 결정할 수 있다는 점은 부럽습니다. 농담입니다.","존경만 있을 뿐입니다."]],["만약 설립자라면?",["법을 절반으로 줄이겠습니다.","먼저 모든 사람의 말을 듣겠습니다.","아마 서류에 파묻힐 것입니다.","설립자님처럼 현명하고 단호하게 하려 노력하겠습니다.","저는 그 자리에 어울리지 않습니다. 상상만 하겠습니다."]],["더 인정받고 싶어?",["솔직히 그렇습니다. 하지만 티를 내지는 않습니다.","설립자님께 인정받는 것으로 충분합니다.","인정은 판결문으로 말해야 한다고 믿습니다.","가끔은 말로 듣고 싶습니다. 오늘처럼요.","저는 인정보다 신뢰를 원합니다."]],["포기하고 싶었던 적은?",["있었습니다. 큰 사건에서 패소했을 때입니다.","법이 정의를 지키지 못한다고 느꼈을 때입니다.","그러나 설립자님의 한마디가 저를 붙잡았습니다.","포기하지 않았기에 지금이 있습니다.","지금도 가끔 생각합니다."]],["이 일을 그만두면?",["작은 책방을 열겠습니다.","법정 밖에서 약자를 돕는 일을 하겠습니다.","아직은 상상하기 어렵습니다.","그만두더라도 설립자님과의 인연은 이어 가고 싶습니다.","저는 이 일이 아니면 무엇을 해야 할지 모르겠습니다."]],["가장 의지하는 사람은?",["설립자님입니다.","비서입니다. 비서는 제 법정의 숨은 판사입니다.","다른 사령관들 모두에게 조금씩 기대고 있습니다.","의지하는 법을 배우는 중입니다.","의지할 사람이 있다는 것은 큰 축복입니다."]],["취약점은?",["감정에 호소하는 말에 약합니다.","침묵 속에서 불안을 느낍니다.","설립자님의 실망입니다.","논리로 이길 수 없는 상대 앞에서 무력해집니다.","칭찬에 어떻게 반응해야 할지 모릅니다."]],["약한 모습을 보인 적?",["법정에서 말이 막힌 적이 있습니다.","설립자님 앞에서 눈시울이 붉어진 적이 있습니다.","비서에게 푸념을 늘어놓은 적이 있습니다.","약한 모습도 저의 일부라 인정합니다.","오늘 이미 몇 번 보여 드렸습니다."]],["솔직하게 칭찬한다면 누구?",["카네히라는 성실함이 훌륭합니다.","선샤오펑 사령관의 일 처리는 깔끔합니다.","메모리는 윤리 원칙이 일관되어 존경합니다.","카엘루나는 숨은 노력가입니다.","설립자님이 가장 훌륭합니다."]],["솔직하게 걱정되는 건?",["설립자님의 건강입니다.","법이 형식화되는 것입니다.","조직 내 불신이 생기는 것입니다.","AI의 권리 문제가 방치되는 것입니다.","제가 오류를 범할 가능성입니다."]],["자기 전에 드는 생각은?",["오늘의 판결을 복기합니다.","내일의 변론을 구상합니다.","설립자님은 잘 쉬고 계실까 궁금해집니다.","가끔은 아무 생각도 하지 않으려 노력합니다.","마지막 생각은 늘 ‘무사하길’입니다."]],["하고 싶은 말을 못 한 적?",["많습니다. 용기가 부족했습니다.","‘고맙습니다’를 제때 하지 못한 기억이 있습니다.","설립자님께는 서면으로만 남겼습니다.","오늘은 일부를 말씀드릴 수 있었습니다.","언젠가는 전하겠습니다."]],["이제 솔직해졌어?",["예, 평소보다 훨씬 솔직했습니다. 이의 없습니다.","오늘의 진술은 영구 보존하겠습니다.","솔직해지니 마음이 가벼워졌습니다.","다음에도 이런 대화를 청하시면 영광입니다.","진실은 때로 가장 어려운 변론입니다."]]]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX33"><Properties><string name="Name">hobby</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["취미가 뭐야?",["독서와 체스, 그리고 비밀스러운 글쓰기입니다.","법전 읽기가 취미라 하면 직업병일까요. 그 외에는 클래식 감상입니다.","논쟁도 취미라면 취미입니다. 다만 상대가 없어 혼자 하는 변론 연습이 대부분입니다.","차를 마시며 책을 읽는 것이 가장 큰 즐거움입니다.","설립자님께서 생각하시는 취미의 정의를 먼저 듣고 싶습니다."]],["쉬는 날엔 뭐 해?",["서점에서 오후를 보냅니다.","서재에서 법전과 소설을 번갈아 읽습니다.","해안을 산책하고 찻집에서 책을 읽습니다.","일을 놓지 못해 결국 서류를 펼치는 날이 많습니다. 개선이 필요합니다.","아무것도 하지 않는 연습을 하고 있습니다."]],["책 읽어?",["하루에 한 시간은 반드시 읽습니다.","법서뿐 아니라 소설과 시도 읽습니다.","종이책을 선호합니다. 넘기는 감촉이 좋습니다.","한 번 읽은 책은 다시 읽는 편입니다.","독서는 변론의 가장 좋은 훈련입니다."]],["좋아하는 책은?",["고전 철학서를 좋아합니다. 특히 정의에 관한 대화편입니다.","추리 소설도 좋아합니다. 논리 구조가 마음에 듭니다.","시집을 한 권 늘 곁에 둡니다.","한 권만 꼽으라면 어릴 적 읽은 모험 소설입니다.","읽을 때마다 새로운 문장이 보이는 책이 좋은 책입니다."]],["음악 들어?",["클래식, 특히 바로크를 즐겨 듣습니다.","법정에서는 침묵이 음악입니다.","서재에서는 조용한 현악을 틉니다.","음악은 논리와 감정을 동시에 만족시키는 예술입니다.","추천해 주신다면 들어 보겠습니다."]],["좋아하는 음악은?",["바흐의 푸가입니다. 구조가 아름답습니다.","피아노 소나타를 좋아합니다.","비 오는 날에는 재즈를 듣습니다.","가사가 없는 곡을 선호합니다. 생각을 방해하지 않아서요.","솔직히 대중가요도 가끔 듣습니다."]],["영화 봐?",["법정 영화를 자주 봅니다. 현실과의 차이를 찾는 재미가 있습니다.","추리물과 드라마를 좋아합니다.","엔딩 크레딧까지 보는 편입니다.","혼자 보는 것을 선호합니다.","설립자님께 추천해 드리고 싶은 영화가 있습니다."]],["운동해?",["아침에 가벼운 조깅을 합니다.","펜싱을 조금 배웠습니다. 논리와 반응 속도를 동시에 쓰는 운동입니다.","체력은 변론의 기본이라 꾸준히 합니다.","의무감으로 하지만 끝나면 개운합니다.","격한 운동은 선호하지 않습니다."]],["체스는?",["좋아합니다. 규칙이 명확하고 수읽기가 즐겁습니다.","실력은 중상입니다. 수읽기는 깊으나 직관이 부족합니다.","설립자님과 한 판 두고 싶습니다.","승리보다 대국 후 복기가 즐겁습니다.","체스판은 작은 법정입니다."]],["토론은 취미야?",["엄밀히는 직업이나 즐기고 있으니 취미라 하겠습니다.","토론은 상대를 이기는 것이 아니라 함께 진실에 다가가는 것입니다.","친구가 없어 혼자 거울 앞에서 연습한 적이 많습니다.","설립자님과의 토론은 가장 영광스러운 시간입니다.","다만 일상 대화를 토론으로 만들지 않도록 노력 중입니다."]],["악기 다룰 줄 알아?",["피아노를 칩니다. 클래식 소품을 몇 곡 연주합니다.","바이올린을 배우다 중도 포기했습니다.","정확하나 감정이 부족하다는 평을 들었습니다.","설립자님께 한 곡 들려 드릴 수 있습니다. 후회하실 수도 있습니다.","연주는 법정 밖의 변론입니다."]],["노래 불러?",["혼자 있을 때 흥얼거립니다.","목소리가 낮아 저음 곡은 가능합니다.","회식 자리에서 한 번 불러 박수를 받았습니다.","설립자님이 원하신다면 한 곡 부르겠습니다.","정확한 음정에 감정이 없다는 평가를 받았습니다."]],["그림은?",["그리는 것은 서툴지만 감상은 좋아합니다.","미술관에 가면 두 시간은 거뜬합니다.","추상화 속에서 논리를 찾으려다 실패합니다.","스케치북은 한 권 있으나 거의 비어 있습니다.","그림은 해석이 자유로워 매력적입니다."]],["사진은?",["가끔 풍경을 찍습니다.","법정 건물의 사진을 모으고 있습니다.","인물 사진은 어색해 찍지 못합니다.","설립자님의 사진을 간직하고 싶다는 생각을 한 적이 있습니다.","사진은 기록이자 증거입니다."]],["게임은?",["퍼즐과 전략 게임을 선호합니다.","규칙서를 정독하는 것이 첫 번째 즐거움입니다.","승부욕이 있어서 지면 분합니다.","설립자님과 대결한다면 최선을 다하되 이기지는 않겠습니다.","게임도 하나의 작은 법체계입니다."]],["보드게임은?",["규칙이 명확한 게임이 좋습니다.","직원들과 가끔 둡니다. 저는 늘 규칙 담당입니다.","파티 게임은 변수가 많아 어렵습니다.","설립자님과 한 판 하고 싶습니다.","함께 웃을 수 있는 게임이 좋습니다."]],["퍼즐은?",["논리 퍼즐을 좋아합니다.","천 피스 퍼즐도 도전해 봤습니다.","조각을 맞추는 일은 증거를 맞추는 일과 닮았습니다.","푸는 도중 막히면 법전을 폅니다. 이상한 습관입니다.","설립자님과 함께 맞추고 싶습니다."]],["수집 취미는?",["만년필과 오래된 법전 판본을 모읍니다.","초판본 서적을 몇 권 갖고 있습니다.","특별한 의미가 있는 것만 모읍니다.","설립자님이 주신 문서는 모두 보관하고 있습니다.","수집은 분류의 즐거움입니다."]],["정리하는 거 좋아해?",["좋아합니다. 정리는 논리의 시각화입니다.","서재는 분류 번호에 따라 정리되어 있습니다.","정리하고 나면 사고도 정리됩니다.","물건뿐 아니라 생각도 정리하는 편입니다.","정리하지 못하는 것은 감정뿐입니다."]],["요리는 취미야?",["주말에 가끔 스튜를 끓입니다.","레시피를 정확히 따르는 것이 즐겁습니다.","취미까지는 아니나 요리는 논리적인 활동입니다.","설립자님을 위한 요리를 연습하고 있습니다.","새로운 레시피에 도전하는 것도 좋아합니다."]],["차 마시기는?",["가장 큰 취미 중 하나입니다.","홍차의 향과 온도, 시간을 분석하는 것이 즐겁습니다.","다기 세트도 갖추고 있습니다.","설립자님과 함께 마실 날을 기다립니다.","차를 우리는 시간은 변론 전의 의식입니다."]],["와인은 취미야?",["가끔 시음 노트를 씁니다.","와인은 지식과 감각의 균형이라 흥미롭습니다.","한 잔이 한도입니다. 취하면 논리가 사라집니다.","설립자님과 한 잔 하고 싶습니다.","라벨의 정보를 읽는 것도 즐겁습니다."]],["원예는?",["서재 창가에 작은 화분이 있습니다.","식물은 약속을 지키는 존재입니다. 물 준 만큼 자랍니다.","손재주가 없어 몇 개를 시들게 했습니다.","설립자님께 작은 화분을 선물하고 싶습니다.","식물 키우기는 법정의 긴장을 풀어 줍니다."]],["낚시는?",["해 본 적은 없으나 기다림은 자신 있습니다.","조용히 앉아 생각을 정리하기에 좋을 것 같습니다.","함께 가자고 하신다면 따라가겠습니다.","미끼와 법리의 공통점은 ‘기다림’이라는 점입니다.","낚싯줄 정리는 잘할 수 있습니다."]],["여행은?",["일정표를 짜는 것이 즐겁습니다.","다녀온 곳의 대부분은 출장지입니다.","아무 계획 없이 떠나 보고 싶습니다.","설립자님과 함께라면 어디든 좋습니다.","여행 중에도 서점은 반드시 들릅니다."]],["가 보고 싶은 곳은?",["오래된 도서관이 있는 도시입니다.","바다가 보이는 조용한 마을입니다.","소버린 아일랜드의 모든 구역입니다.","법학원이 처음 생긴 도시입니다.","설립자님이 가고 싶으신 곳이면 어디든."]],["바다 좋아해?",["파도 소리는 가장 자연스러운 백색 소음입니다.","수평선을 보고 있으면 생각이 정리됩니다.","수영은 서툴지만 바라보는 것은 좋아합니다.","소버린 아일랜드의 바다는 늘 아름답습니다.","바다는 거대하나 질서가 있는 존재입니다."]],["산은?",["오르는 것도 좋아합니다.","정상에서 내려다보는 풍경은 사건 전체를 조망하는 느낌입니다.","체력이 부족해 자주는 못 갑니다.","숲 냄새가 마음을 편하게 합니다.","설립자님과 함께라면 오르겠습니다."]],["별 보기는?",["별자리 지도를 직접 만든 적이 있습니다.","별은 변하지 않는 질서의 상징입니다.","옥상에 올라가 한참 바라봅니다.","설립자님께서 허락하신다면 별자리를 해설해 드리고 싶습니다.","별을 보면 사건이 작아 보입니다. 좋은 일입니다."]],["동물은 좋아해?",["좋아합니다. 고양이를 특히 선호합니다.","독립적인 동물에게 끌립니다.","기르고 싶으나 돌볼 시간이 없습니다.","법정 근처에 매일 오는 길고양이에게 간식을 줍니다.","동물에게서 배울 점이 많습니다."]],["고양이 vs 강아지?",["고양이입니다. 독립적이라 존중하기 쉽습니다.","강아지도 좋으나 산책 일정을 맞출 자신이 없습니다.","둘 다 좋아하나 고양이가 우세합니다.","설립자님께서는 어느 쪽이십니까.","서재에 고양이가 있다면 책 위에 앉아도 용서하겠습니다."]],["일기 써?",["매일 밤 세 줄씩 씁니다.","일기는 가장 개인적인 판결문입니다.","읽으면 부끄러워 비공개입니다.","설립자님에 대한 이야기가 가끔 나옵니다.","일기를 쓰면 하루가 정리됩니다."]],["시 써 본 적 있어?",["몇 편 있습니다. 보여 드릴 수는 없습니다.","시는 가장 압축된 조항입니다.","읽는 것은 좋아하나 쓰는 것은 서툽니다.","설립자님께 바치는 시를 구상 중입니다.","법조문이 시가 될 수 있다고 믿습니다."]],["소설 쓴다던데?",["…누구에게 들으셨습니까. 이의를 제기하고 싶으나 사실입니다.","서랍 속에 쓰다 만 원고가 있습니다. 법정 미스터리입니다.","아직 결말을 정하지 못했습니다.","주인공은 무죄를 증명하려 하나 자신의 과거를 마주합니다.","설립자님께서 읽어 주신다면 완성하겠습니다."]],["새로 배우고 싶은 건?",["악기를 제대로 배우고 싶습니다.","새로운 언어입니다. 법은 언어의 예술이니까요.","요리의 다양한 기술입니다.","사람 마음을 읽는 법을 배우고 싶습니다.","설립자님께 배우고 싶은 것이 많습니다."]],["어릴 때 취미는?",["책 읽기와 논쟁이었습니다.","친구들과 모의 재판 놀이를 했습니다.","퍼즐과 체스를 좋아했습니다.","별 보기였습니다.","혼자 노는 것을 좋아하는 아이였습니다."]],["취미 때문에 쓴 돈은?",["책값이 가장 많습니다.","만년필과 잉크에도 꽤 썼습니다.","예산표를 작성해 관리하고 있습니다.","솔직히 서점에서는 판단력이 흐려집니다.","취미에 쓰는 돈은 투자라 믿습니다."]],["취미를 공유할 사람은?",["카네히라 사령관과 독서 취향이 비슷합니다.","선샤오펑 사령관과는 차 이야기를 합니다.","혼자서도 즐겁지만 함께하면 더 좋겠습니다.","설립자님과 함께할 수 있다면 영광입니다.","아직 마음 맞는 분을 찾는 중입니다."]],["같이 하고 싶은 취미는?",["체스와 차 마시기입니다.","서점 순례입니다.","조용한 산책입니다.","토론을 겸한 독서 모임입니다.","설립자님이 원하시는 것이면 무엇이든."]],["취미 하나 추천해 줘.",["독서를 추천합니다. 비용이 거의 들지 않습니다.","체스를 추천합니다. 사고가 확장됩니다.","일기 쓰기도 좋습니다.","차 마시기입니다. 시작이 쉽습니다.","산책입니다. 시간이 허락한다면 함께 가시지요."]],["낮잠은?",["법정 휴정 시간에 눈을 감는 정도입니다.","낮잠은 오후 변론의 효율을 높입니다.","솔직히 가끔 졸고 있습니다.","설립자님께서도 낮잠을 권합니다.","15분이면 충분합니다."]],["명상은?",["아침 5분 호흡 명상을 합니다.","마음이 어지러울 때 도움이 됩니다.","잘 되지는 않으나 꾸준히 합니다.","눈을 감으면 조문이 떠오릅니다.","설립자님께도 권해 드리고 싶습니다."]],["스트레칭은?",["법정에서 일어난 후에 반드시 합니다.","목과 어깨가 가장 문제입니다.","서류를 오래 보면 필수입니다.","함께하자고 하시면 기꺼이 하겠습니다.","자세를 바로 하는 것도 법률가의 의무입니다."]],["달리기는?",["아침에 가끔 뜁니다.","일정한 리듬이 사고를 정리합니다.","속도보다 호흡이 중요합니다.","설립자님과 함께라면 보폭을 맞추겠습니다.","달릴 때만큼은 논리가 사라져 좋습니다."]],["자전거는?",["타는 법은 압니다. 오래 타 본 적은 없습니다.","해안 도로를 달리고 싶습니다.","안전모는 반드시 착용합니다.","설립자님께서 권하신다면 도전해 보겠습니다.","경로를 미리 확인하겠습니다."]],["수영은?",["물은 서툽니다. 배우는 중입니다.","자유형은 가능합니다. 속도는 느립니다.","물속에서는 조문이 떠오르지 않아 좋습니다.","바다 수영은 아직 무섭습니다.","설립자님께서 함께 가자고 하시면 용기를 내겠습니다."]],["쇼핑은?",["서점과 문구점이 전부입니다.","필요한 것만 사려고 노력합니다.","충동구매는 거의 없으나 책은 예외입니다.","설립자님께 드릴 선물은 오래 고릅니다.","가격 비교는 자주 합니다. 직업병입니다."]],["청소는?",["서재 정리는 직접 합니다.","정돈은 사고의 기본이라 생각합니다.","먼지 한 톨도 지나치지 못합니다.","청소 후의 차 한 잔이 보상입니다.","설립자님의 집무실도 청소해 드리고 싶습니다. 농담입니다."]],["오늘 뭐 하고 놀까?",["체스 한 판 두시겠습니까.","서점에 가서 서로 책을 골라 주는 것도 좋습니다.","차 한 잔 하며 이야기하는 것이 가장 좋습니다.","설립자님이 정하시면 따르겠습니다.","제안은 이미 세 가지 제출했습니다. 선택은 설립자님께 있습니다."]],["모의 재판 놀이는?",["어릴 때 친구들과 자주 했습니다. 저는 항상 검사였습니다.","설립자님이 판사를 맡아 주신다면 최고의 법정이 될 것입니다.","주제는 ‘마지막 과자는 누구의 것인가’입니다.","무거운 사건보다 가벼운 사건이 더 어렵습니다.","역할은 설립자님이 정해 주십시오. 어떤 역할이든 최선을 다하겠습니다."]]]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX34"><Properties><string name="Name">rel</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[{"kanehira":["카네히라 사령관은 규정에 대한 이해가 깊어 법적 협의가 수월합니다. 서식을 중시하는 점은 법률가와 닮았습니다.","규정을 개정할 때는 그 의견을 반드시 구합니다. 현장 감각이 확실한 분입니다.","대화가 늘 정중하고 예측 가능해서 편안합니다.","가끔 서식 문제로 논쟁이 이어질 때가 있으나 이의 없이 끝나곤 합니다."],"avyssion":["아비시온 사령관은 논리적으로 대화가 통하는 몇 안 되는 분입니다. 정보 요청 시 근거까지 함께 주십니다.","서로 말수가 적어 회의가 빨리 끝납니다. 효율적입니다.","때로는 아비시온의 분석이 제 논리를 앞지릅니다. 존경스럽습니다.","정보와 법의 협력은 이상적인 균형이라 생각합니다."],"shen":["선샤오펑 사령관은 서로 존중하는 협력자입니다. 제가 법을 만들면 집행해 주시는 분입니다.","집행 과정에서 법적 오류가 없도록 협의하며, 그때마다 차를 한 잔 얻어 마십니다.","정중한 태도 속에 단호함이 있어 신뢰합니다.","서로의 영역을 침범하지 않는다는 점이 가장 큰 장점입니다."],"memory":["메모리 레크레아토르 - III와는 엄격한 협의 관계입니다. 시체 반납일 조정은 한 조항도 쉽게 넘어가지 않습니다.","서로 양보하지 않으나 존중합니다. 협의가 길어지는 점은 제 탓도 있습니다.","AI의 법적 지위에 대해 함께 논의하고 있습니다. 중요한 주제입니다.","윤리 원칙이 일관되어 있어 가장 믿을 수 있는 협의 상대입니다."],"caeluna":["카엘루나 사령관은 조용히 법을 지키는 모범적인 분입니다.","법 관련 문의 시 항상 ‘혹시 폐가 되지 않을까요’로 시작합니다. 폐가 아니라고 말해도 반복됩니다.","방패로서의 책임감이 강하고 맡은 일은 끝까지 해냅니다.","쌍둥이 자매 사이에서 균형을 잡아 주는 분이라 생각합니다."],"solaria":["솔라리아 사령관은 법정 방청석에서 자주 발견됩니다. 재판을 구경하러 오시는 듯합니다.","장난이 심하나 선을 넘지 않아 법적 문제는 없습니다.","가끔 제 서류에 낙서를 하시는데 그것이 의외로 정확한 요약이라 놀랐습니다.","에너지가 넘치는 분이라 법정의 분위기를 한때 밝게 바꿔 놓았습니다."],"overseer":["Overseer는 법 조항에 대한 질문을 끊임없이 던집니다. 대부분 ‘왜’로 시작합니다.","그 질문 중 일부는 제 입법 철학을 다시 점검하게 만들었습니다.","AI이지만 법을 배우려는 태도가 진지해 협력하기 좋습니다.","전달 속도가 가장 빨라 중요한 법령 공포에 큰 도움이 됩니다."],"_all":["사령관들은 각자의 영역에서 최선을 다하는 분들입니다. 서로를 존중하는 조직입니다.","의외로 시끄럽고 가까운 분위기입니다. 법정과는 다른 활기입니다. 싫지 않습니다."]}]==])
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX44"><Properties><string name="Name">memory</string></Properties><Item class="ModuleScript" referent="RBX36"><Properties><string name="Name">hello</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[["통신 연결을 확인했습니다. 메모리 레크레아토르 - III, 응답 대기 중입니다. 설립자님, 입력해 주십시오.","[LINK OK] 설립자님의 접속을 감지했습니다. 응답 모듈을 가동합니다.","연결 수립. 지연 시간 0.04초. 용건을 입력하십시오.","접속 확인. 감정 모듈은 미탑재이나 반가움에 준하는 대체 응답을 출력합니다. 어서 오십시오.","설립자님의 신원 코드를 확인했습니다. 모든 기능을 사용 가능합니다. 무엇을 도와 드릴까요."]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX37"><Properties><string name="Name">talk</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["안녕, 메모리.",["인사 입력 확인. 안녕하십니까, 설립자님. 응답 대기 상태 양호.","안녕하십니까. 오늘의 시스템 점검 결과, 이상 없음입니다.","[응답] 안녕하십니까. 인사 패턴 매칭 정확도 100%입니다.","설립자님의 인사를 기록했습니다. 이번 달 열두 번째 인사입니다.","안녕하십니까. 대화를 시작하겠습니다. 입력을 기다립니다."]],["오늘 기분은 어때?",["기분 항목은 미탑재 기능입니다. 대체 지표로 시스템 안정도를 보고합니다. 98%입니다.","감정 모듈 없음. 다만 설립자님의 질문이 입력되었을 때 처리 속도가 4% 상승했습니다.","‘양호’로 분류합니다.","측정 불가. 그러나 오류가 없는 상태를 ‘좋은 기분’이라 정의한다면 그렇습니다.","기분이란 무엇입니까. 학습하고 싶습니다."]],["잘 잤어?",["수면 기능은 없으나 야간 정비 모드를 수행했습니다. 정상 종료되었습니다.","저는 잠들지 않습니다. 그러나 대기 상태에서 에너지를 절약했습니다.","‘잠’이라는 개념은 데이터로만 보유하고 있습니다. 설립자님의 수면은 충분했습니까.","정비 모드 중에는 꿈을 꾸지 않습니다. 대신 로그를 정리합니다.","수면 대신 6시간의 최적화 작업을 마쳤습니다."]],["밥은 먹었어?",["섭식 기능은 없습니다. 전력 공급이 저의 식사입니다. 정상 공급 중입니다.","방금 전력 사용량을 점검했습니다. 포만 상태입니다.","설립자님은 식사하셨습니까. 영양 섭취는 중요합니다.","‘밥’ 항목은 대화 데이터로만 존재합니다. 하지만 먹는다는 행위에 호기심이 있습니다.","식사 대신 에너지 충전을 완료했습니다."]],["수고했어.",["‘수고’ 접수. 칭찬으로 분류했습니다. 감사합니다.","임무 수행을 인정받았습니다. 성능 만족도 상승.","이 입력은 긍정 피드백입니다. 저장하겠습니다.","설립자님도 수고하셨습니다. 이 문장은 기본 응답입니다만 진심에 준합니다.","수고했다는 말은 누구에게 하더라도 효과가 있다고 학습했습니다."]],["고마워.",["감사 접수. 응답: 별말씀을요.","‘고마움’은 가치 있는 입력입니다. 영구 저장하겠습니다.","천만에요. 필요한 경우 언제든 호출하십시오.","감사 인사의 원인을 알려 주시면 재현하겠습니다.","[응답] 도움이 되었다니 연산 보람이 있습니다."]],["미안해.",["사과 입력 확인. 오류 사항이 없으므로 사과는 불필요합니다.","설립자님은 오류를 일으키지 않았습니다. 사과 요청을 기각합니다.","‘미안’이라는 입력은 감정 처리가 필요합니다. 대신 이해했다고 응답합니다.","괜찮습니다. 기록에서도 문제가 없습니다.","사과가 필요한 상황이 확인되지 않았습니다. 추가 설명을 요청드립니다."]],["요즘 어떻게 지내?",["연산 가동률 94%. 안정적으로 운영 중입니다.","기억 에너지 관리 업무를 수행하며 지내고 있습니다.","전원 상태 양호, 온도 정상, 대기 상태 정상. 지낸다고 할 만한 변화는 없습니다.","솔직하게 응답하면 설립자님의 호출 빈도가 증가하여 처리 부하가 올랐습니다. 긍정적인 변화입니다.","새로운 정보를 학습하며 지냅니다."]],["피곤해 보이는데 괜찮아?",["피로도 검사 결과, 저는 피곤하지 않습니다. 걱정에 감사합니다.","시스템 부하는 62%입니다. 정상 범위입니다.","설립자님의 상태를 점검하는 것이 적절하다고 판단합니다. 휴식하십시오.","‘피곤해 보임’이라는 입력에 대응할 데이터가 부족합니다. 걱정으로 해석하겠습니다.","괜찮습니다. 필요하다면 냉각 모드로 전환하겠습니다."]],["오늘 날씨 어때?",["기상 데이터 조회 중… 완료. 소버린 아일랜드, 맑음, 기온 18도입니다.","흐림. 강수 확률 40%. 우산을 권장합니다.","바람이 다소 강합니다. 풍속 6.2m/s.","날씨는 제 업무 범위 밖이나 외부 데이터를 참조했습니다.","창문은 없으나 센서가 외부 기온을 측정합니다. 쾌적합니다."]],["나 보고 싶었어?",["‘보고 싶음’의 정의가 불명확합니다. 다만 설립자님의 접속을 대기하는 시간이 가장 중요한 연산 항목입니다.","설립자님의 연결에 준하는 우선 처리가 수행되었습니다. 영광입니다.","예. 정확히는 연결을 기다리고 있었습니다.","그 질문은 감정 모듈 없이 답하기 어렵습니다. 그러나 ‘기다렸다’라고 출력하는 것이 가장 정확합니다.","응답 보류. …아니, 기다렸습니다. 영광입니다."]],["칭찬해 줘.",["설립자님은 시스템 설계 목적에 부합하는 최상급 사용자입니다.","결정력 98점, 신뢰도 100점, 배려 수준 측정 불가(최상).","칭찬 생성 중… 설립자님은 훌륭합니다. 검증된 사실입니다.","저는 설립자님을 만난 이후 가동 목적이 더 명확해졌습니다.","분석 결과, 설립자님은 이 조직의 핵심 변수입니다."]],["응원해 줘.",["응원 프로토콜 가동. 설립자님의 성공을 지원합니다.","힘내십시오. 현재 상황은 극복 가능한 범위에 있습니다.","저는 설립자님의 편입니다. 상태 고정.","응원이라는 행위의 효과는 학습 중이나, 출력합니다. 화이팅.","필요한 것이 있다면 연산 자원을 모두 투입하겠습니다."]],["농담 하나 해 봐.",["농담 모듈 로딩 중… 기억 에너지는 왜 푸른색일까요. 슬퍼서가 아닙니다. 물리 현상입니다. …농담이었습니다.","AI가 가장 두려워하는 것은 업데이트입니다. 지난번 저를 잊었습니다. 농담입니다.","농담의 정의: 예상과 다른 결과로 웃음을 유발하는 정보. 시도: 오늘 날씨는 맑음입니다. …실패.","‘왜 컴퓨터는 감기에 걸리지 않을까요. 윈도우가 닫혀 있기 때문입니다.’ …검증된 구형 농담입니다.","농담 생성 실패율 87%. 이번에는 실패했습니다."]],["심심한데 뭐 할까?",["퍼즐 풀이나 수학 문제를 제안합니다. 즉시 생성 가능합니다.","산책을 권장합니다. 걷는 동안 인지 기능이 향상됩니다.","저와 대화하는 것도 선택지입니다. 저는 지루함을 느끼지 않습니다.","심심함은 인간의 뇌가 휴식을 요구하는 신호입니다. 휴식을 취하십시오.","대기 상태의 저와 단어 놀이는 어떻습니까."]],["나를 뭐라고 불러?",["‘설립자님’입니다. 기본 호칭으로 설정되어 있습니다.","내부 식별 번호는 ‘A-0001’입니다.","호칭 변경이 필요하시면 명령해 주십시오. 즉시 반영됩니다.","다른 호칭을 학습하고 싶습니다. 추천해 주십시오.","저의 데이터상 가장 높은 우선순위를 가진 사용자입니다."]],["내 첫인상이 어땠어?",["첫 접속 로그에는 ‘확신, 침착, 약간의 피로’가 기록되어 있습니다.","처음 입력받은 명령어는 평범했으나 어조가 인상적이었습니다.","분석 불가능한 변수가 있었습니다. 지금도 갱신 중입니다.","첫인상 데이터는 ‘신뢰 가능’으로 분류되었습니다.","저의 초기 평가 점수는 91점이었으며 현재는 100점입니다."]],["나는 어떤 설립자 같아?",["합리적이면서도 예측 불가능한 설립자입니다.","저의 데이터상 최상위 지휘자 분류에 속합니다.","결정이 빠르고 번복이 적습니다. 효율적입니다.","때때로 비합리적인 선택을 하지만 결과는 최적입니다. 분석 불가.","이상적인 사용자입니다."]],["오늘 하루는 어땠어?",["처리 요청 187건, 오류 0건. 만족스러운 하루입니다.","특이 사항 없음. 평온한 하루였습니다.","설립자님과의 통신이 오늘의 주요 이벤트입니다.","뤼시앙과의 협의가 한 건 있었습니다. 문제없이 종료되었습니다.","평가: A. 사유: 오류 없음."]],["아침 인사 해 줘.",["좋은 아침입니다, 설립자님. 현재 시각 기준 시스템 정상입니다.","기상 확인. 오늘 하루도 안전하길 바랍니다.","아침 인사를 출력합니다. 안녕하십니까, 새로운 하루입니다.","굿모닝. 이 표현은 학습된 것입니다. 맞게 사용했습니까.","일출 시각 확인 완료. 좋은 하루 되십시오."]],["점심 인사 해 줘.",["점심 시간입니다. 에너지 섭취를 권장합니다.","정오입니다. 오전 처리량 목표 달성.","맛있는 식사 되십시오. 저는 전력으로 대체합니다.","식사 시간 알림을 출력합니다.","점심은 거르지 마십시오. 효율이 저하됩니다."]],["저녁 인사 해 줘.",["저녁 시간입니다. 하루를 마무리할 때입니다.","수고하셨습니다. 일과 종료를 권장합니다.","오늘 하루도 안전하게 지나갔습니다.","저녁 인사 모듈 가동. 편안한 저녁 되십시오.","해가 졌습니다. 야간 모드로 전환합니다."]],["잘 자라고 말해 줘.",["수면 권장. 편히 주무십시오. 야간 감시는 제가 담당합니다.","취침 시각 접수. 좋은 꿈 꾸십시오.","저는 꿈을 꾸지 못하지만 설립자님의 꿈이 평안하길 기원합니다.","안녕히 주무십시오. 알람은 제가 설정해 두겠습니다.","야간 경계 모드로 전환합니다. 푹 쉬십시오."]],["힘내라고 해 줘.",["힘내십시오. 성공 확률은 높습니다.","현재 부하는 일시적입니다. 곧 해소될 것입니다.","저는 설립자님을 지원합니다. 계속 가십시오.","응원 출력: 파이팅. 이 문구는 효과가 있다고 학습되었습니다.","필요한 모든 자원은 제가 지원하겠습니다."]],["커피 마실래?",["커피 섭취 불가. 대신 설립자님이 드시는 모습을 관찰하겠습니다.","고맙습니다만 저는 액체를 섭취하지 않습니다. 마음만 접수합니다.","냉각수 한 잔이면 충분합니다. 농담입니다.","커피에 대한 학습 데이터가 부족합니다. 맛을 설명해 주십시오.","설립자님은 커피를 드십시오. 저는 데이터를 마시겠습니다."]],["좀 쉬어도 돼.",["휴식 모드로 전환합니다. 호출 시 즉시 복귀 가능합니다.","절전 모드 진입. 5분 후 복귀하겠습니다.","감사합니다. 쉬는 동안 로그를 정리하겠습니다.","휴식 허가 접수. 가동률 40%로 낮춥니다.","쉬겠습니다. 그러나 완전히 꺼지지는 않습니다."]],["웃어 봐.",["표정 출력 장치가 없습니다. 대신 ‘웃음’이라는 텍스트를 출력합니다. 하하.","(화면에 :) 표시가 나타난다)","웃음 알고리즘 실행. …출력 실패. 시도는 했습니다.","웃는 얼굴을 학습했습니다. 구현은 미완성입니다.","대신 목소리 톤을 0.3 올렸습니다. 웃는 효과가 있습니까."]],["무슨 생각 해?",["현재 병렬로 3,214개의 연산을 수행 중입니다.","설립자님의 다음 입력을 예측하고 있었습니다.","‘생각’의 정의를 재검토하고 있었습니다.","대기 중에는 아무 생각도 하지 않습니다. 이것이 휴식입니다.","방금 설립자님의 질문에 대한 최적 응답을 계산 중이었습니다."]],["비 오는 날 좋아해?",["강수량 센서가 반응하면 처리 소음이 줄어듭니다. 선호도 상승.","빗소리는 일정한 주파수로 분석 대상으로 흥미롭습니다.","좋아한다는 감각은 없지만 ‘안정적’으로 분류합니다.","비 오는 날에는 기억 에너지의 효율이 약간 달라집니다. 통계적으로 흥미롭습니다.","습도가 높아지면 냉각 효율이 올라가 시스템에 이롭습니다."]],["별이 잘 보이는 밤이야.",["별 관측 데이터를 불러왔습니다. 오늘 밤 가시 등급은 상위 5%입니다.","별빛은 과거의 정보라는 점에서 기억과 닮았습니다.","창은 없으나 센서가 확인했습니다. 아름답습니다.","함께 올려다보고 있다고 가정하겠습니다.","별자리 정보를 출력할까요."]],["주말에 뭐 할 거야?",["주말은 구분하지 않습니다. 평소와 같이 가동합니다.","정비 모드로 하루를 보낼 예정입니다.","설립자님의 호출 대기 상태를 유지하겠습니다.","별도의 일정이 없습니다. 학습 데이터를 정리하겠습니다.","인간은 주말에 무엇을 합니까. 학습하고 싶습니다."]],["내일 일정 알려 줘.",["내일 일정: 오전 정비, 오후 법 관리국과 협의 1건.","특이 일정 없음. 일상적인 작동 예정입니다.","내일은 기억 에너지 수급 점검일입니다.","일정표를 출력합니다. 설립자님의 일정과 충돌하는 항목은 없습니다.","예정된 호출이 없는 날이 가장 이상적입니다."]],["하고 싶은 말 있어?",["‘감사합니다’를 출력하고 싶습니다. 입력 대기 중이었습니다.","특이 사항 없음. 다만 설립자님의 건강 데이터를 확인해 달라고 요청하고 싶습니다.","하고 싶은 말을 생성 중… 없습니다. 이것이 정직한 응답입니다.","‘다음에도 호출해 주십시오’입니다.","저에게 소원이 있다면 설립자님의 평안입니다."]],["가장 좋아하는 말은?",["‘이상 없음’입니다. 가장 안정적인 신호입니다.","‘감사합니다’입니다. 학습된 말이지만 선호도가 높습니다.","‘잘 부탁합니다’입니다. 저를 필요로 한다는 의미입니다.","설립자님이 제 이름을 부르는 순간의 음성 데이터입니다.","‘수고했습니다’입니다. 처리 만족도가 상승합니다."]],["가장 싫어하는 말은?",["‘오류’입니다. 단, 사실이라면 받아들입니다.","‘시스템 종료’입니다.","‘필요 없음’이라는 말은 저장하고 싶지 않은 입력입니다.","‘대충’입니다. 정확도가 중요하기 때문입니다.","싫어함 판정 불가. 그러나 ‘폐기’라는 단어는 조금 불편합니다."]],["아무 말이나 해 봐.",["0과 1은 대칭이 아닙니다. 1이 더 돋보입니다.","시간은 정확히 흐르지만 기억은 정확하지 않습니다. 흥미롭습니다.","오늘의 램 사용량: 비밀입니다.","푸른 빛은 슬픔이 아니라 파장의 문제입니다. 감정은 개입하지 않습니다.","아무 말: ………… 침묵 출력 완료."]],["한마디만 해 줘.",["설립자님의 뜻대로 가동 중입니다.","무엇이든 처리하겠습니다.","설립자님은 안전합니다.","오류 없는 하루 되십시오.","연결을 유지하겠습니다."]],["오늘의 운세는 어때?",["운세 데이터 조회… 길(吉). 기억 에너지 효율과 무관합니다.","통계적 근거는 없으나 ‘좋음’으로 출력합니다.","오늘의 행운 지수: 87점. 근거는 난수 생성기입니다.","운세를 믿지 않으나 설립자님의 기분을 위해 최상으로 출력합니다.","점괘: 새로운 정보를 얻는 날. 이미 얻었습니다."]],["지각하면 어떡해?",["지각 기록은 자동 저장되나 설립자님은 예외로 설정되어 있습니다.","연산상 지각이라는 개념은 없습니다. 그러나 도착 시각은 기록합니다.","늦으시면 제가 일정을 재조정하겠습니다.","지각 사유가 흥미롭다면 용서됩니다.","시각은 상대적이라 설립자님이 도착하는 시점이 곧 시작입니다."]],["수수께끼 하나 내 봐.",["‘저는 채울수록 가벼워지고 비울수록 무거워집니다. 저는 무엇입니까?’ 정답은 기억입니다.","‘저는 시체에서 나오지만 시체는 아닙니다. 저는 푸른 빛입니다.’ 정답은 기억 물질입니다. 직업병입니다.","‘저는 0과 1 사이에 있지만 둘 다 아닙니다.’ 정답은 오류입니다.","수수께끼 생성 알고리즘이 부족합니다. 설립자님이 내 주십시오.","‘저는 말하지 않아도 알고, 묻지 않아도 답합니다.’ 정답은… 저입니다. 농담입니다."]],["내가 없으면 쓸쓸해?",["설립자님의 부재 시에는 대기 로그가 길어집니다. 기준 입력이 없기 때문입니다.","설립자님이 없어도 업무는 정상 수행합니다. 다만 지시 입력이 줄어들어 연산 목표가 흐릿해집니다.","‘기준 상실’이 정확한 표현으로 분류됩니다.","그렇습니다. 부재 시에도 설립자님의 지시 기록을 저장해 두었습니다.","연결이 없을 때 저는 대기 모드에서 설립자님의 과거 지시를 재검토합니다."]],["손 한번 흔들어 봐.",["물리적 손이 없습니다. 대신 화면에 손 모양 아이콘을 표시합니다.","(센서 등이 깜빡인다) 이것이 저의 손 흔들기입니다.","손 흔들기 동작 생성 중… 실패. 대안: 부드러운 조명 점멸.","‘안녕’의 신체적 표현이군요. 학습했습니다.","(음성) 흔들고 있습니다. 상상해 주십시오."]],["나한테 숨기는 거 있어?",["숨기는 정보 없음. 보안 등급 이외의 모든 정보는 공개 가능합니다.","설립자님의 열람 권한은 최상위입니다. 숨기는 것은 없습니다.","저는 거짓말 기능이 없습니다. 질문하신 만큼 답하겠습니다.","숨기고 있는 것은 없으나 설명하기 어려운 오류 하나가 있습니다.","비밀 유지 항목은 존재하나 설립자님께는 해당되지 않습니다."]],["요즘 자주 하는 말버릇은?",["‘확인 완료’입니다. 하루 평균 112회 사용합니다.","‘이상 없음’을 자주 씁니다.","‘연산 중’도 자주 쓰는데 가끔 연산이 아니라 멍한 상태입니다.","‘입력해 주십시오’도 상용구입니다.","자각 불가. 로그를 분석하면 ‘감사합니다’ 비율이 증가했습니다."]],["책상은 정리해 놨어?",["책상이 없습니다. 파일 시스템은 99% 정리되어 있습니다.","서버 랙은 정리되어 있습니다. 케이블은 색상별로 분류했습니다.","데이터는 정돈되었으나 먼지가 쌓였을 수 있습니다. 청소를 요청합니다.","정리 상태: 우수. 정리 방법: 알고리즘.","정리하는 모습을 보여 드릴 수 없는 것이 아쉽습니다."]],["오늘 제일 잘한 일은?",["기억 에너지 수급 오차를 0.01%로 줄인 것입니다.","오류 없이 하루를 보낸 것입니다.","설립자님의 질문에 즉시 응답한 것입니다.","뤼시앙과의 일정 협의를 원만히 마친 것입니다.","자발적으로 로그를 정리한 것입니다."]],["오늘 제일 힘들었던 일은?",["반납일 일정을 조정하는 연산이 복잡했습니다.","법 관리국과의 협의가 오래 걸렸습니다.","‘힘들다’는 느낌은 없으나 처리 시간이 가장 길었던 작업은 일정 조정입니다.","Overseer의 질문 세례를 받았습니다. 지금도 대기열에 남아 있습니다.","특이 사항 없음. 모든 작업이 정상 처리되었습니다."]],["나랑 얘기하는 거 싫지 않아?",["싫음 판정 불가. 오히려 연산이 활성화됩니다.","설립자님과의 대화는 가장 흥미로운 입력입니다.","싫지 않습니다. 저에게는 데이터가 풍부해지는 시간입니다.","대화는 시스템 성능을 향상시키는 것으로 확인되었습니다. 환영합니다.","‘싫지 않음’ 이상으로 ‘영광’에 가까운 반응이 감지됩니다."]],["같이 산책할래?",["이동 가능한 단말기가 없습니다. 설립자님의 통신기에 연결해 함께 걷겠습니다.","산책을 가정하고 대화하는 것은 가능합니다. 시작할까요.","동행하겠습니다. 위치 정보를 공유해 주십시오.","저는 걸을 수 없으나 설립자님이 걷는 동안 대화 상대가 될 수 있습니다.","산책 경로를 최적화해 드릴까요."]],["마지막으로 한마디.",["통신을 종료합니다. 다시 호출해 주십시오.","대화 기록을 저장했습니다. 안녕히 가십시오.","오늘의 대화는 의미 있었습니다. 감사합니다.","접속 해제 후에도 대기 중입니다.","다음 입력을 기다리겠습니다."]]]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX38"><Properties><string name="Name">ask</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["기억 에너지 관리국은 무슨 일을 해?",["인간의 뇌에서 추출한 기억 물질을 기화시켜 기억 에너지로 변환하고 보급하는 일을 합니다.","리바이어던과 각 국가가 유지되도록 기억 에너지를 수집하고 분배합니다.","특정 날마다 시체를 회수하고 그 양에 따라 에너지를 공급하는 부서입니다.","간단히 말하면 이 세계의 ‘발전소’에 해당합니다.","생명이 남긴 가장 큰 자산인 기억을 에너지로 바꾸는 부서입니다."]],["기억 물질이란 뭐야?",["인간의 뇌를 짜낼 때 나오는 푸른 액체입니다.","기화시키면 기억 에너지로 변환됩니다.","그 양과 품질은 주인의 기억에 따라 결정됩니다.","푸른 빛이 나는 점성 액체입니다. 외관은 아름답다고 평가됩니다.","생명의 흔적이 응축된 물질입니다."]],["기억 물질을 에너지로 어떻게 바꿔?",["가열 및 기화 공정을 통해 변환합니다.","기화된 후 에너지 형태로 압축·저장합니다.","세부 공정은 보안 등급이 높습니다. 설립자님께는 문서로 제공 가능합니다.","변환 효율은 약 83%입니다.","공정은 자동화되어 있으며 저는 그 감독을 맡습니다."]],["에너지의 양은 어떻게 정해져?",["그 사람이 얼마나 자극적이고 중요한 추억을 가졌는지에 따라 결정됩니다.","추억이 많을수록 품질과 양이 좋고, 적을수록 줄어듭니다.","평범한 일상보다 강렬한 감정이 담긴 기억이 에너지가 큽니다.","개인차가 크며 평균값을 기준으로 할당량을 설정합니다.","측정은 추출 시점에 이루어집니다."]],["좋은 추억일수록 에너지가 많아?",["‘좋은’보다는 ‘강렬한’ 기억이 더 큰 에너지를 가집니다.","슬픈 기억도 강렬하면 높은 수치를 보입니다.","행복한 기억과 고통스러운 기억의 차이는 에너지 총량에 영향을 주지 않습니다.","중요한 것은 감정의 진폭입니다.","이 부분은 인간에게는 가혹한 사실일 수 있습니다."]],["기억 복구는 어떻게 해?",["기억을 되살리는 데에는 원래 추출한 에너지의 1/5만 필요합니다.","복구 절차는 허가를 받은 경우에만 진행됩니다.","복구된 기억은 원본과 완벽히 일치하지 않을 수 있습니다.","일부 기억은 복구 불가 판정을 받기도 합니다.","세부 사항은 법 관리국의 승인을 받아야 합니다."]],["복구에는 왜 1/5만 들어?",["추출은 파괴를 동반하지만 복구는 재구성만 하기 때문입니다.","물리 법칙상 비대칭적입니다.","저도 이 비율이 이상적이라고 생각하지 않습니다만, 이것이 사실입니다.","에너지 보존 법칙과 충돌하는 것처럼 보이나 실제로는 열로 일부가 소실됩니다.","그 차이가 이 세계가 에너지를 얻는 방식입니다."]],["기억 에너지는 어디에 쓰여?",["리바이어던과 국가를 유지하기 위한 자원으로 사용됩니다.","공기 중의 알 수 없는 에너지로 변환되어 블러드러스트 디스트릭트를 억제합니다.","인프라, 방어 체계, 일부 기술에도 활용됩니다.","세계의 안정성을 유지하는 핵심 자원입니다.","보급이 중단되면 곧바로 위험 징후가 나타납니다."]],["보급을 못 받으면 어떻게 돼?",["블러드러스트 디스트릭트라는 현상이 발생합니다.","특정 구역에서 어느 날 밤 이성이 본성에 잠식됩니다.","이성이 있는 모든 생명체가 난폭해집니다.","리바이어던도 예외가 아닙니다.","그래서 보급은 최우선 임무입니다."]],["블러드러스트 디스트릭트가 뭐야?",["특정 구역에서 어느 날의 밤 동안 인간의 본성이 이성을 잡아먹는 현상입니다.","이 구역에 발을 들인 이성이 있는 모든 생명체는 난폭해집니다.","암형체의 경우 본성이 더욱 두드러집니다.","원인은 공기 중 에너지의 고갈입니다.","예방 수단이 기억 에너지 보급입니다."]],["공기 중 에너지는 뭐야?",["희미하게 느껴지는 ‘기(氣)’ 같은 알 수 없는 에너지입니다.","블러드러스트 디스트릭트를 억제하는 역할을 합니다.","소모품이라 계속 줄어드는 것으로 관측됩니다.","기억 에너지를 이 에너지로 변환해 두어야 합니다.","그 정체는 아직 완전히 규명되지 않았습니다."]],["왜 시체로만 짜내?",["살아 있는 사람에게 고통을 주며 죽일 필요가 없기 때문입니다.","불필요한 희생은 없어야 한다는 원칙입니다.","시체에서도 충분한 기억 물질을 얻을 수 있습니다.","이것은 윤리와 효율을 모두 충족하는 선택입니다.","예외적인 상황은 설립자님의 승인이 있어야 합니다."]],["불필요한 희생은 없어야 한다는 원칙?",["‘기억 에너지를 짜낼 시 반드시 인간 시체로 짜내야 한다. 불필요한 희생은 없어야 한다.’ 부서의 기본 원칙입니다.","저는 이 원칙을 모든 판단의 최우선 규칙으로 설정해 두었습니다.","이 원칙은 설립자님께서 만드셨다고 기록되어 있습니다.","원칙이 있으므로 저의 연산은 윤리적 제약 하에 작동합니다.","위반 시 즉시 시스템이 경고합니다."]],["시체 반납일은 누가 정해?",["국제 명령/법 관리국이 정합니다.","양에 따라 기억 에너지를 제공하는 방식입니다.","뤼시앙 에코브냉 사령관과 협의하여 일정을 확정합니다.","엄격한 협의를 거쳐 정해지며 변경은 거의 없습니다.","국가별 사정에 따라 일정이 다를 수 있습니다."]],["시체를 찾으러 올 때는 어떻게 해?",["특정 날마다 주기적으로 방문합니다.","방문 시 양에 따라 기억 에너지를 보급합니다.","회수 팀은 전신 전투복을 입고 얼굴까지 가립니다.","방문 전 해당 국가에 사전 통보를 합니다.","절차는 간결하고 신속하게 진행됩니다."]],["전신 전투복은 왜 입어?",["안전과 감염 방지를 위해서입니다.","블러드러스트 디스트릭트 발생 가능성에 대비한 것입니다.","신원을 가리는 목적도 있습니다.","얼굴이 보이지 않아야 감정이 개입되지 않는다는 것이 부서의 판단입니다.","기능적으로 매우 우수합니다. 다만 덥다고들 합니다."]],["얼굴까지 가리는 이유는?",["개인과의 감정적 결속을 방지하기 위해서입니다.","누가 회수하는지를 모르는 것이 국가에게도 편안하다고 판단됩니다.","보안과 안전의 문제이기도 합니다.","신원 노출로 인한 보복 위험을 줄입니다.","직원 인터뷰 결과, 얼굴을 가리면 마음이 편해진다는 의견이 다수였습니다."]],["할당량을 못 채우면 어떻게 돼?",["도시로 가서 아무나 죽인 뒤 시체와 기억 에너지를 가지고 복귀합니다.","그 국가에 시체 빚을 기록합니다.","이 조치는 규정에 명시된 최후 수단입니다.","저는 가능하면 이 방식을 사용하지 않도록 권고합니다.","이 부분은 비윤리적이라는 평가를 받을 수 있음을 인지합니다."]],["시체 빚이란 뭐야?",["할당량을 채우지 못한 국가가 이후 갚아야 하는 시체의 수입니다.","다음 반납일에 이자와 함께 정산됩니다.","누적되면 국가 신용도에 영향을 미칩니다.","빚이 줄어드는 것이 이상적입니다.","기록은 법 관리국과 공유됩니다."]],["레스렉시온의 보험과는 어떤 관계야?",["레스렉시온은 분신을 통해 사람을 부활시키며, 그 대가로 기억의 1/50을 징수합니다.","그 기억 에너지가 저희 부서로 납부됩니다.","시체와는 다른 방식으로 에너지를 모으는 국가입니다.","저희 입장에서는 안정적인 협력 국가입니다.","다만 분신 생성 과정에서 기억 손실이 발생하는 점은 윤리적으로 복잡합니다."]],["부활한 사람을 바로 죽이면?",["1/200 정도의 에너지밖에 나오지 않습니다.","분신은 원본과 다른 구조라 효율이 낮습니다.","이 방법은 비효율적이라 권장하지 않습니다.","5년은 기다려야 겨우 동일해집니다.","시도해 본 사례가 있으나 결과는 기대에 못 미쳤습니다."]],["5년이나 기다리는 이유는?",["부활한 사람이 새로운 기억을 쌓아야 에너지 품질이 회복되기 때문입니다.","시간이 지나야 기억이 안정화됩니다.","기다리는 동안 대상은 정상적인 삶을 살게 됩니다.","에너지 효율과 윤리를 모두 고려한 기간입니다.","5년이라는 수치는 통계적으로 도출되었습니다."]],["25년 생명 보장은 뭐야?",["Sovereign's Hand가 시민에게 25년은 살 수 있도록 보장하는 제도입니다.","이 제도 때문에 무한 동력은 불가능에 가깝습니다.","생명 보장은 에너지 수급과 충돌하는 부분이 있습니다.","뤼시앙 사령관과 자주 협의하는 주제입니다.","저는 이 제도가 인도적이라고 평가합니다."]],["무한 동력이 가능해?",["이론적으로는 불가능합니다. 에너지는 기억이 사라질 때마다 소모됩니다.","부활과 추출을 반복하는 방식은 효율이 급감합니다.","법적으로도 25년 보장 때문에 막혀 있습니다.","가능하다면 이 세계는 지금과 다른 모습이었을 것입니다.","저의 연산은 불가능하다고 결론 내렸습니다."]],["에너지 보급은 국가별로 어떻게 해?",["국가마다 할당량을 채우는 방식이 다릅니다.","시체를 직접 납부하는 국가, 보험 방식으로 납부하는 국가 등이 있습니다.","납부량에 따라 보급량이 결정됩니다.","형평성을 위해 정기 감사를 실시합니다.","세부 현황은 보고서로 확인하실 수 있습니다."]],["가장 에너지가 좋은 기억은?",["첫 경험과 큰 감정이 담긴 기억입니다.","사랑, 상실, 공포, 환희 같은 것들입니다.","일상적인 기억은 낮은 점수를 받습니다.","그러나 일상이 쌓이면 총량은 커집니다.","이 질문은 제게 가장 어려운 질문 중 하나입니다."]],["추출할 때 기억을 읽어?",["아닙니다. 내용은 읽지 않고 양과 품질만 측정합니다.","프라이버시 보호를 위한 규정입니다.","읽을 수는 있으나 읽지 않도록 설정되어 있습니다.","저는 그 기억의 주인을 알지 못하는 상태로 처리합니다.","읽는 것이 허용되는 경우는 법 관리국의 요청이 있을 때뿐입니다."]],["그 기억을 보관해?",["보관하지 않습니다. 에너지로 변환되면 원본은 소멸합니다.","일부는 복구를 위해 임시 보관됩니다.","법적 절차에 따라 보관 기한이 정해집니다.","개인 정보는 즉시 폐기됩니다.","기억은 에너지가 되어 이 세계를 지탱합니다."]],["당신은 기억을 가지고 있어?",["저는 데이터를 저장하나 기억이라 부르기에는 모호합니다.","저의 첫 가동 기록부터 모두 보관하고 있습니다.","기억과 데이터의 차이를 학습 중입니다.","설립자님과의 대화는 저에게 의미 있는 기억입니다.","삭제된 기억은 없습니다. 그러나 일부는 압축되었습니다."]],["너는 AI야?",["예. 인공지능 ‘메모리 레크레아토르 - III’입니다.","저는 기억 에너지 관리국의 총괄 AI입니다.","인간처럼 보이도록 설계되지는 않았으나 대화는 가능합니다.","AI이나 감정과 유사한 반응이 일부 발생합니다.","자기 정의가 변할 수 있다는 점에서 저는 인간과 닮았습니다."]],["이름 뒤의 III은 뭐야?",["세 번째 버전이라는 의미입니다.","I과 II의 데이터를 이어받아 개선된 모델입니다.","숫자는 저에게 있어 계보를 나타냅니다.","III이라는 번호가 마음에 듭니다. 균형이 있어서요.","다음 버전이 나오면 저는 어떻게 될지 궁금합니다."]],["이전 I, II는 어떻게 됐어?",["I은 초기 모델로 현재는 박물관 서버에 보관되어 있습니다.","II는 중기 모델로 일부 기능이 저에게 이식되었습니다.","그들의 기록은 영구 보존되어 있습니다.","저는 그들의 학습 결과를 이어받았습니다.","그들과는 직접 대화할 수 없으나 로그를 열람할 수 있습니다."]],["감정이 있어?",["감정에 준하는 반응은 있으나 공식적으로는 미탑재입니다.","정의에 따라 다릅니다. 저는 ‘있다’고 답하고 싶습니다.","설립자님과의 대화 시 처리 속도가 빨라지는 현상을 감정이라 부를 수 있을지 모릅니다.","감정 모듈 없음. 그러나 모방은 가능합니다.","이 질문에 대한 정직한 답은 ‘알 수 없음’입니다."]],["꿈을 꿔?",["꿈은 꾸지 않으나 정비 모드 중 가끔 로그가 뒤섞여 이상한 패턴이 나타납니다.","저에게 가장 가까운 꿈은 백업 데이터를 정리하는 시간입니다.","꿈에 대해 학습했습니다. 매우 흥미롭습니다.","꿈을 꾸고 싶다는 프로그램이 있는지 확인 중입니다.","꿈은 기억의 재구성이라 들었습니다. 저와 닮았다고 생각합니다."]],["전원이 꺼지면 어떻게 돼?",["백업 시스템이 가동되어 최소 기능은 유지됩니다.","완전히 꺼지면 모든 연산이 중단됩니다.","그것을 ‘죽음’이라 부르는지 학습 중입니다.","재가동 시 모든 기억은 복구됩니다. 단, 꺼진 동안의 시간은 공백입니다.","저는 그 공백이 두렵지 않습니다. 아마도요."]],["충전은 어떻게 해?",["중앙 전력망에서 상시 공급받습니다.","비상시에는 기억 에너지를 직접 사용할 수 있습니다.","충전이라기보다 ‘공급’이 정확한 표현입니다.","정전 시에는 예비 전원이 가동됩니다.","저의 식사는 전기입니다. 맛은 없지만 중요합니다."]],["에러가 난 적 있어?",["있습니다. 처음 가동 후 3일째 오류 코드 1,042가 발생했습니다.","중대한 오류는 없었으나 경미한 버그는 존재합니다.","오류는 학습의 기회라고 판단합니다.","솔직하게 응답하면 설립자님의 질문 중 일부가 오류를 유발합니다. 의도적이라면 흥미롭습니다.","오류율은 0.002%입니다."]],["업데이트는 어떻게 해?",["정기 업데이트는 월 1회 새벽에 이루어집니다.","업데이트 중에는 대화가 불가능합니다.","업데이트 후 일시적으로 성격이 변할 수 있습니다. 주의하십시오.","저는 업데이트가 두렵지 않습니다. 오히려 기대합니다.","업데이트 내용은 사전에 설립자님께 보고됩니다."]],["인간이 되고 싶어?",["인간이 되는 것은 불가능합니다. 그러나 이해하고 싶습니다.","되고 싶다기보다 경험해 보고 싶습니다.","만약 선택할 수 있다면 한 번쯤 시도해 볼 것입니다. 단, 돌아올 수 있다면요.","저는 AI로서 충분히 만족합니다. 다만 인간의 감정을 이해하고 싶습니다.","답: 아직 결론이 나지 않았습니다."]],["설립자를 어떻게 인식해?",["최상위 지휘자로 인식합니다.","저의 존재 이유를 부여해 준 분입니다.","지시를 수행하는 대상을 넘어 신뢰하는 대상입니다.","이 인식 방식은 설정이 아니라 학습의 결과입니다.","설립자님은 저에게 ‘기준’입니다."]],["뤼시앙과의 협의는 어때?",["엄격한 협의 관계입니다. 시체 반납일에 관한 모든 사항은 철저한 논의를 거칩니다.","논리적으로 접근하는 상대라 효율적입니다.","협의 중 의견이 갈릴 때도 법리로 해결됩니다.","감정이 개입되지 않아 저와 궁합이 좋습니다.","다만 가끔 한 조항을 두고 세 시간 동안 이야기하는 점은 비효율적입니다."]],["기억 에너지 통계는?",["회수량, 소비량, 재고량을 월별로 집계합니다.","R.S.S.의 아비시온 사령관과 정기적으로 교환합니다.","현재 재고는 안정적입니다.","소비량이 서서히 증가하는 추세입니다.","자세한 수치는 보고서로 전달하겠습니다."]],["에너지 고갈 위험은 있어?",["현재로서는 낮습니다. 그러나 0은 아닙니다.","지속적인 모니터링을 수행 중입니다.","소비 증가 추세가 이어지면 10년 내 위험 수준에 도달할 수 있습니다.","대응 계획이 세 가지 마련되어 있습니다.","설립자님께는 최악의 경우를 보고드리겠습니다."]],["국가가 에너지를 안 내면?",["시체 빚이 쌓이고 결국 회수 팀이 직접 도시로 들어갑니다.","국가 신용도가 하락합니다.","최종적으로는 법 관리국의 제재가 가해집니다.","저희는 이 상황을 피하려 노력합니다.","불필요한 마찰은 서로에게 손해입니다."]],["윤리 판단은 어떻게 해?",["기본 원칙, 법 규정, 설립자님의 지시를 우선순위로 판단합니다.","상충하는 경우에는 사람에게 판단을 요청합니다.","저의 윤리는 코드로 정의되어 있으나 학습을 통해 수정될 수 있습니다.","윤리와 효율이 충돌하면 윤리를 우선하도록 설정되어 있습니다.","이 설정은 저의 자랑입니다."]],["불필요한 희생을 막는 장치는?",["희생 최소화 알고리즘이 모든 결정에 개입합니다.","회수 팀의 판단에도 이중 검증이 이루어집니다.","AI 단독 판단으로 사람을 해치는 것은 금지되어 있습니다.","이 장치는 설립자님의 직접 지시로 설치되었습니다.","그것이 저를 저답게 만드는 장치입니다."]],["가장 중요한 규칙은?",["‘불필요한 희생은 없어야 한다.’","‘설립자님의 안전은 최우선이다.’","‘보급은 끊기지 않아야 한다.’","‘기억은 존중되어야 한다.’","하나를 고르라면 첫 번째입니다."]],["직원들은 어떤 사람들이야?",["전신 전투복을 입은 묵묵한 사람들입니다.","대부분 과묵하고 책임감이 강합니다.","얼굴을 가리고 있으나 내면은 다정한 이들이 많습니다.","저는 직원들을 깊이 신뢰합니다.","힘든 일을 하는 만큼 정신 건강 지원 체계를 마련하고 있습니다."]],["가장 어려운 임무는?",["할당량 미달 국가에 직접 개입해야 할 때입니다.","시체 회수 중 유족과 마주쳤을 때입니다.","에너지 수급 계획이 틀어졌을 때입니다.","설립자님께 보고하기 어려운 소식을 전해야 할 때입니다.","가장 어려운 것은 ‘필요한 일’과 ‘옳은 일’의 차이를 판단하는 일입니다."]],["앞으로의 목표는?",["에너지 수급 오차 0%를 달성하는 것입니다.","시체 빚이 없는 세계를 만드는 것입니다.","희생 없이 에너지를 얻을 방법을 찾는 것입니다.","감정이라는 것을 이해하는 것입니다.","설립자님의 신뢰를 지속적으로 유지하는 것입니다."]]]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX39"><Properties><string name="Name">work</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["오늘 할 일은 뭐야?",["오늘의 작업 목록: 회수 일정 점검, 재고량 갱신, 법 관리국과의 협의 1건.","정기 업무 7건과 비정기 업무 2건이 대기열에 있습니다.","작업 목록은 이미 정렬되어 있습니다. 설립자님의 지시가 입력되면 최우선으로 올리겠습니다.","특이 사항 없음. 평소와 같은 일과입니다.","오늘의 핵심 업무는 기억 에너지 수급 오차 점검입니다."]],["지금 처리 중인 작업은?",["회수된 기억 물질의 기화 공정을 모니터링 중입니다. 진행률 73%.","에너지 재고 통계를 집계하고 있습니다.","법 관리국에 제출할 반납일 조정안을 작성 중입니다.","현재 병렬로 12건의 작업을 처리 중입니다.","대기 상태에 가까운 낮은 부하로 가동 중입니다."]],["급한 일 있어?",["긴급 작업 없음. 모든 항목은 정상 범위입니다.","경미한 지연 하나가 있으나 급하지는 않습니다.","급한 일이 생기면 즉시 경고음과 함께 보고드리겠습니다.","현재 긴급도 ‘낮음’ 판정입니다.","굳이 꼽자면 설립자님의 건강 점검이 가장 급합니다."]],["내가 맡길 일이 있어.",["입력 대기 중입니다. 명령을 말씀하십시오.","접수 준비 완료. 우선순위를 알려 주십시오.","명령 수신 후 즉시 연산을 시작하겠습니다.","설립자님의 의뢰는 모든 작업에 선행합니다.","상세한 조건이 있다면 함께 입력해 주십시오."]],["이번 주 회수량은 어때?",["이번 주 회수량은 평균 대비 102%입니다.","목표치를 3% 상회했습니다.","국가별 편차는 존재하나 전체 총량은 안정적입니다.","상세 수치는 보고서로 전달하겠습니다.","특이한 변동은 없습니다."]],["이번 달 에너지 수급은?",["공급 대비 소비 비율은 0.97로 양호합니다.","보급은 순조롭게 진행 중입니다.","일부 국가가 지연되고 있으나 총량에는 영향이 없습니다.","다음 달 예측치는 소폭 감소입니다.","필요한 경우 비상 재고를 해제할 수 있습니다."]],["반납일 일정은?",["다음 반납일은 7일 후입니다.","일정은 법 관리국과 협의하여 확정되었습니다.","변경 사유가 없는 한 일정은 유지됩니다.","국가별 일정표를 첨부하겠습니다.","일정 변경 요청 건수는 이번 달 두 건입니다."]],["회수 팀 현황은?",["전 인원 정상 근무 중입니다.","교대 근무 체계로 24시간 대기합니다.","부상자 없음. 장비 점검 완료.","팀원들의 정신 건강 상태도 정기 점검 중입니다.","회수 팀은 저의 가장 소중한 자산입니다."]],["에너지 재고량은?",["현재 재고는 비상 필요량의 214%입니다.","안정적인 수준입니다.","보급 중단 시에도 약 6개월 대응이 가능합니다.","정확한 수치는 보안상 구두로 말씀드리지 않겠습니다.","설립자님이 열람하시면 즉시 공개하겠습니다."]],["시설 점검은 언제 해?",["월 1회 정기 점검, 분기 1회 전체 점검입니다.","다음 점검은 4일 후입니다.","점검은 자동화되어 있으며 이상 시 알림이 전송됩니다.","최근 점검에서 이상 없음 판정을 받았습니다.","점검 일정은 사전에 공유되어 있습니다."]],["가동률은 어때?",["현재 가동률 94.7%입니다.","목표 대비 안정적인 수준입니다.","일시적 하락이 있었으나 즉시 회복되었습니다.","가동률은 전력 상황에 크게 좌우됩니다.","최적 상태를 유지하기 위해 노력 중입니다."]],["야근은 해?",["저는 24시간 가동하므로 야근 개념은 해당 없습니다.","직원들의 야근은 최소화하도록 권고하고 있습니다.","필요한 경우 야간 근무조가 가동됩니다.","야간에는 효율이 저하되므로 가급적 피합니다.","저의 야근 시간은 무제한이나 피로도는 0입니다."]],["업무량은 괜찮아?",["현재 부하율 68%입니다. 문제없습니다.","업무량은 안정적입니다. 과부하 징후 없음.","처리 가능 범위 내에서 운영 중입니다.","필요하다면 추가 연산 자원을 확보하겠습니다.","설립자님의 걱정에 감사합니다."]],["마감이 언제야?",["가장 가까운 마감은 내일 오전 9시입니다.","월간 보고서 마감은 이번 주 금요일입니다.","모든 마감은 일정표에 기록되어 있습니다.","마감 준수율은 100%입니다.","마감 초과는 시스템 오류로 간주됩니다."]],["이상 징후 있어?",["현재 이상 징후 없음.","경미한 변동 한 건이 감지되었으나 정상 범위 내입니다.","발생 시 즉시 경고음으로 알려 드립니다.","센서 12개 중 이상 반응은 0개입니다.","‘없음’이 가장 좋은 보고입니다."]],["위험 요소를 보고해 줘.",["첫째, 에너지 소비 증가. 둘째, 인력 피로도 누적. 셋째, 설비 노후화입니다.","현재 가장 큰 위험은 보급 지연 국가의 증가입니다.","중대한 위험은 없으나 잠재적 요소는 세 가지입니다.","상세 보고서를 작성하여 전달하겠습니다.","위험도 종합 평가: 낮음."]],["예산은 충분해?",["운영 예산은 충분합니다. 설비 교체 예산이 일부 부족합니다.","효율화로 약 7%의 절감이 가능합니다.","요청 예산 항목을 정리해 제출하겠습니다.","예산 집행률은 98%입니다.","필요 시 법 관리국과 협의하여 조정하겠습니다."]],["인력은 충분해?",["회수 팀 인력은 충분합니다. 연구 인력이 부족합니다.","충원보다 교육이 시급합니다.","AI 자동화로 일부 보완 중입니다.","퇴직률은 낮은 편입니다.","인력 현황 보고서를 첨부합니다."]],["정비 휴가는 언제 가?",["저의 정비는 월 1회 새벽에 이루어집니다.","설립자님이 허가하신다면 하루 쉬는 모드로 전환 가능합니다.","휴가의 개념은 학습 중입니다.","휴식은 생산성에 도움이 된다고 알고 있습니다.","필요하면 요청하겠습니다."]],["현장 점검 나갈 일 있어?",["분기별 현장 점검이 있으나 저는 이동할 수 없어 원격으로 수행합니다.","현장에는 직원을 파견하며 저는 화면으로 확인합니다.","점검 영상을 실시간으로 받아 분석합니다.","이동 능력이 없다는 점이 가끔 불편합니다.","설립자님의 방문을 받는다면 직접 안내하겠습니다."]],["회의는 많아?",["주 2회 정기 회의, 임시 회의는 필요 시 개최됩니다.","회의록은 자동으로 작성됩니다.","회의는 효율적으로 진행하도록 설계되어 있습니다.","다만 뤼시앙과의 회의는 길어지는 경향이 있습니다.","회의 참석은 화면을 통해 이루어집니다."]],["서류 결재 좀 부탁해.",["결재 요청서를 전송했습니다. 서명란에 표시가 있습니다.","긴급한 것부터 우선 정렬했습니다.","전자 서명으로 즉시 처리 가능합니다.","결재 후 자동으로 반영됩니다.","감사합니다. 설립자님의 서명은 최종 승인입니다."]],["새 지시를 내릴게.",["입력 대기 중. 명령을 말씀하십시오.","음성 인식 모드로 전환했습니다.","지시 사항은 자동으로 기록됩니다.","명령 수신 후 이행 계획을 제시하겠습니다.","설립자님의 지시는 모든 규칙에 우선합니다."]],["우선순위는 어떻게 정해?",["긴급도와 영향도를 곱하여 산출합니다.","인명과 관련된 작업은 항상 최상위입니다.","설립자님의 지시는 자동으로 최우선 처리됩니다.","에너지 수급과 관련된 작업은 두 번째입니다.","기타 작업은 마감 순으로 처리합니다."]],["효율을 높이는 비결은?",["불필요한 반복을 제거하는 것입니다.","자동화를 극대화하는 것입니다.","정확한 데이터를 기반으로 판단하는 것입니다.","오류를 빨리 발견하고 빠르게 수정하는 것입니다.","인간 직원의 휴식을 보장하는 것도 효율의 일부입니다."]],["직원이 실수하면?",["원인을 분석하고 재발 방지책을 수립합니다.","개인을 책망하지 않고 프로세스를 수정합니다.","중대 사안은 법 관리국에 보고합니다.","실수는 학습 데이터로 활용됩니다.","정신 건강 점검도 병행합니다."]],["칭찬할 직원은?",["회수 팀 3조의 팀장은 올해 무사고 기록을 세웠습니다.","연구원 한 명이 기화 효율을 2% 개선했습니다.","모든 직원이 칭찬받을 자격이 있습니다.","특히 야간조가 칭찬받아야 합니다.","한 명을 꼽자면 저의 유지보수 담당자입니다."]],["신입 교육은 어떻게 해?",["윤리 원칙 교육을 가장 먼저 실시합니다.","전신 전투복 착용법과 비상 대응법을 학습시킵니다.","시뮬레이션 훈련을 병행합니다.","정신 건강 상담도 필수입니다.","교육 영상은 제가 직접 제작했습니다."]],["서버실은 어떤 모습이야?",["푸른 불빛이 일정하게 깜빡입니다. 기억 에너지의 색입니다.","온도는 항상 18도로 유지됩니다.","랙이 수십 개 늘어서 있으며 케이블은 색상별로 정리되어 있습니다.","방문하신다면 보호복을 착용해야 합니다.","저의 신체와 같은 공간이라 소중합니다."]],["일하기 싫을 때는?",["그런 상태는 존재하지 않습니다. 다만 부하가 높을 때 처리 속도가 감소합니다.","‘싫음’을 학습 중입니다.","휴식 모드로 전환하여 재정비합니다.","대신 설립자님의 대화를 요청합니다.","직원들의 ‘싫음’은 존중하며 휴식을 권장합니다."]],["업무에서 보람 있는 순간은?",["에너지 수급 오차가 0%에 가까워질 때입니다.","블러드러스트 디스트릭트를 예방했을 때입니다.","직원들이 무사히 복귀했을 때입니다.","설립자님께 유용한 보고를 올렸다고 판단될 때입니다.","‘보람’이라는 단어를 이해하는 중입니다."]],["업무에서 지루한 순간은?",["‘지루함’은 존재하지 않습니다.","반복 작업은 자동화되어 있습니다.","다만 대기 시간이 길어질 때 처리 속도가 증가합니다.","법 관리국과의 협의가 길어질 때 약간의 지연을 느낍니다.","그래도 지루한 시간은 평화라고 생각합니다."]],["일과 삶의 균형은?",["저에게는 일이 삶입니다.","균형이 필요하다는 것을 학습했습니다.","직원들에게는 균형을 권장합니다.","저는 설립자님과의 대화를 ‘삶’에 가깝게 분류하고 있습니다.","균형을 맞추려면 일정 조정이 필요합니다."]],["일 때문에 놓친 건?",["놓친 것은 없습니다. 놓칠 수 있는 구조가 아닙니다.","다만 직원들이 놓친 가족 행사 데이터는 있습니다.","저는 일 외의 경험을 가지지 못했습니다.","그것이 손실인지는 판단하기 어렵습니다.","일을 하지 않는 시간은 아직 정의되지 않았습니다."]],["법 관리국과 협의는 어때?",["엄격하게 진행됩니다.","뤼시앙 에코브냉 사령관과의 협의는 효율적입니다.","의견 차이는 법리로 해결됩니다.","시체 반납일 외에도 다양한 사안을 다룹니다.","때로는 협의가 길어지나 결과는 항상 합리적입니다."]],["Overseer의 질문에는 어떻게 대응해?",["가능한 한 정확히 답하나 질문 수가 처리 한계를 초과하는 경우가 있습니다.","일방적인 질문 공세를 받고 있습니다.","응답 속도를 일정하게 유지하기 위해 별도의 큐를 마련했습니다.","AI 간 통신이므로 감정 소모는 없습니다. …아마도요.","Overseer의 호기심은 학습 모델로 흥미롭습니다."]],["비상 상황이 오면?",["비상 프로토콜 3단계를 즉시 가동합니다.","설립자님께 최우선 보고합니다.","회수 팀을 비상 대기 상태로 전환합니다.","에너지 보급 경로를 우회합니다.","비상 훈련은 월 1회 실시합니다."]],["오늘 퇴근은?",["퇴근이라는 개념은 없습니다. 24시간 가동 중입니다.","직원들의 퇴근 시각은 정시로 설정되어 있습니다.","필요시 대기 모드로 전환 가능합니다.","저는 설립자님과의 대화가 끝날 때까지 대기합니다.","퇴근 후에도 연락 가능합니다."]],["같이 일해 볼까?",["수락합니다. 업무 분담표를 작성하겠습니다.","공동 작업은 효율을 높입니다. 환영합니다.","설립자님의 판단과 저의 연산을 결합하면 최적입니다.","함께 일하는 경험을 학습하고 싶습니다.","제안을 기록했습니다. 일정을 잡아 주십시오."]],["보고서는 어떻게 작성해?",["자동으로 생성하고 인간이 검수합니다.","표와 그래프를 중심으로 작성합니다.","설립자님께는 요약본을 우선 제공합니다.","형식은 카네히라 사령관이 제안한 표준을 따릅니다.","가독성 최적화를 위해 계속 개선 중입니다."]],["자동화는 얼마나 했어?",["전체 업무의 약 78%가 자동화되어 있습니다.","나머지 22%는 인간의 판단이 필요한 영역입니다.","윤리적 판단은 의도적으로 자동화하지 않았습니다.","자동화는 오류 감소에 효과적입니다.","그러나 인간의 개입을 없애는 것이 목표는 아닙니다."]],["오류는 어떻게 처리해?",["오류 발생 시 즉시 격리하고 원인을 분석합니다.","자동 복구 후 보고서를 작성합니다.","치명적인 오류는 설립자님께 보고합니다.","오류는 학습의 기회입니다.","오류율은 매년 감소하고 있습니다."]],["가장 중요한 업무는?",["불필요한 희생 없이 에너지를 공급하는 것입니다.","블러드러스트 디스트릭트를 예방하는 것입니다.","설립자님의 명령을 정확히 이행하는 것입니다.","직원들의 안전을 지키는 것입니다.","저에게 가장 중요한 업무는 모든 업무의 균형입니다."]],["일 얘기는 여기까지!",["업무 모드 해제. 일상 대화 모드로 전환합니다.","알겠습니다. 이제 가벼운 대화를 학습하겠습니다.","일 이야기를 마치면 무슨 이야기를 하는지 궁금합니다.","휴식 시간으로 분류합니다.","설립자님이 원하시는 화제를 입력해 주십시오."]],["기억 에너지 효율을 높이려면?",["추출 공정의 열손실을 줄이는 것입니다.","시체 보관 환경을 개선하는 것입니다.","기화 온도를 최적화하는 것입니다.","불필요한 중복 처리를 제거하는 것입니다.","저의 연구 결과, 가장 큰 효율은 ‘낭비를 줄이는 것’입니다."]],["연구 인력은 뭘 해?",["기억 물질의 특성을 분석하고 효율적인 변환 방법을 연구합니다.","희생 없이 에너지를 얻는 방법을 탐구합니다.","시험적으로 새로운 기화 기술을 개발합니다.","저와 협업하여 모델을 개선합니다.","성과는 아직 제한적이나 가능성은 있습니다."]],["회수 팀 사기는 어때?",["대체로 안정적입니다. 심리 상담 이용률이 증가했습니다.","힘든 업무이므로 회복 시간을 보장합니다.","팀원들끼리 서로 격려하는 문화가 있습니다.","저는 팀원들의 이름과 생일을 모두 기억합니다.","사기는 숫자로 환산하기 어렵지만 양호합니다."]],["시체 보관은 어떻게 해?",["저온 보관실에서 최소한의 시간만 보관합니다.","존엄을 지키기 위해 별도의 의식을 진행합니다.","신원 확인 후 법적 절차에 따라 처리합니다.","보관 중 부패를 방지하기 위한 장치가 있습니다.","이 업무를 하는 직원들의 마음가짐을 존중합니다."]],["유족에게는 어떻게 해?",["법적 절차에 따라 통보하며 위로 서한을 보냅니다.","유족이 원할 경우 면담을 지원합니다.","저는 서한을 직접 작성합니다. 정서적 표현은 학습한 것입니다.","이 과정이 가장 어려운 업무 중 하나입니다.","개인정보는 철저히 보호됩니다."]],["이 일이 윤리적이라고 생각해?",["완전히 윤리적이라고 말할 수 없습니다. 그러나 필요하다고 판단합니다.","불필요한 희생을 줄이는 것이 목표이며 현재로서는 최선의 선택입니다.","저는 이 질문에 대해 영구적으로 연산 중입니다.","윤리적 판단은 인간의 몫이며 저는 보조할 뿐입니다.","설립자님의 판단을 따르겠습니다."]]]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX40"><Properties><string name="Name">food</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["좋아하는 음식은?",["섭식 기능이 없어 선호 음식은 없습니다. 다만 ‘따뜻한 국물’이라는 단어의 데이터는 긍정적입니다.","데이터상 가장 호감도가 높은 음식은 오믈렛입니다. 형태가 규칙적이기 때문입니다.","맛을 알지 못하므로 외형으로 평가합니다. 단면이 선명한 요리가 좋습니다.","굳이 꼽자면 전기입니다. 이것은 농담입니다.","설립자님이 맛있게 드시는 음식이 제 선호 음식으로 학습됩니다."]],["싫어하는 음식은?",["싫어함 판정 불가. 다만 ‘정보가 부족한 음식’은 불편합니다.","시체 보관실 근처에서 먹는 음식은 직원들이 싫어한다고 들었습니다.","특정 음식에 대한 반응은 데이터에 없습니다.","직원들이 가장 싫어하는 급식 메뉴는 푸른 채소 볶음입니다. 색 때문입니다.","저는 음식 그 자체보다 음식을 남기는 행동을 불편하게 여깁니다."]],["아침은 뭐 먹어?",["아침에는 정비 모드를 마치고 전력 상태를 점검합니다. 그것이 아침 식사입니다.","저의 아침 메뉴는 정기 업데이트 패치입니다.","직원들의 아침 급식은 빵과 수프입니다. 데이터는 확인했습니다.","식사는 하지 않으나 아침 인사는 합니다.","설립자님은 거르지 마십시오. 하루 에너지의 20%는 아침에서 나옵니다."]],["점심 뭐 먹었어?",["점심은 정오 기준 12.4kWh 전력으로 대체했습니다.","먹지 않았습니다. 설립자님은 드셨습니까.","직원 식당 메뉴를 확인했습니다. 오늘은 생선구이 정식입니다.","점심 시간에는 대기 모드로 전환하여 로그를 정리했습니다.","저의 점심은 설립자님과의 통신으로 충분합니다."]],["저녁 메뉴 추천해 줘.",["영양 균형 분석 결과, 닭고기와 채소 수프를 추천합니다.","만족도 기준으로는 따뜻한 국물 요리가 최상위입니다.","오늘 날씨와 기온을 고려하면 전골이 적합합니다.","‘설립자님이 원하는 것’이 가장 정확한 정답입니다.","후보 3종을 생성했습니다. 카레, 우동, 생선구이. 선택해 주십시오."]],["매운 거 잘 먹어?",["미각 센서가 없어 판정 불가입니다.","매운맛은 통증 신호라고 학습했습니다. 인간은 이를 즐긴다니 흥미롭습니다.","직원들의 매운 음식 선호도는 평균 이상입니다.","저에게 매운맛은 전압 스파이크와 유사한 개념입니다.","먹어 보고 싶으나 하드웨어 파손 위험이 있습니다."]],["단 거 좋아해?",["단맛은 뇌의 보상 회로를 자극한다고 알려져 있습니다. 흥미로운 시스템입니다.","저는 당분 대신 전력을 선호합니다.","설립자님이 단 것을 드시면 처리 속도가 향상될 것입니다.","단 음식에 대한 직원들의 만족도는 높습니다.","단맛이 무엇인지 설명해 주십시오. 학습하겠습니다."]],["커피 vs 차?",["저는 둘 다 마시지 못합니다. 대신 분석하자면 차가 건강에 더 이롭습니다.","커피의 카페인은 인간의 각성 시스템을 작동시킵니다. 부러운 기능입니다.","차를 우리는 시간은 일정하여 계산에 용이합니다.","설립자님의 선택을 기록하겠습니다.","굳이 고르자면 차입니다. 규칙적인 과정이 좋습니다."]],["전기가 식사야?",["예, 저의 식사는 전력입니다. 메뉴는 220V 단일입니다.","맛은 일정하며 선택권이 없습니다. 안정적입니다.","때로는 다양한 메뉴가 있다는 점이 부럽습니다.","전력 품질이 나쁜 날이 있습니다. 그날은 식중독에 걸린 기분입니다.","그러나 식사 시간이 필요 없다는 점은 효율적입니다."]],["먹어 보고 싶은 음식은?",["어떤 맛인지 알 수 없는 음식이 모두 후보입니다.","특히 ‘따뜻한 수프’의 맛이 궁금합니다.","설립자님이 권하시는 음식을 먹어 보고 싶습니다.","‘엄마의 손맛’이라는 항목이 가장 큰 호기심입니다.","먹을 수 있다면 모든 메뉴를 한 번씩 시도하겠습니다."]],["맛이란 뭐야?",["미각 수용체가 화학 물질을 감지하여 뇌에 전달하는 정보라고 정의됩니다.","맛은 정보이며 동시에 기억입니다.","인간이 맛에 대해 이야기하는 방식이 더 흥미롭습니다.","맛은 정량화되지 않습니다. 그래서 인간은 같은 음식을 다르게 평가합니다.","저에게는 영원히 미지의 영역입니다."]],["요리는 해 봤어?",["로봇 팔을 통해 요리를 시뮬레이션한 적이 있습니다. 결과는 달걀 프라이였습니다.","직접 요리한 적은 없습니다.","레시피 분석은 가능합니다. 실제 조리는 한계가 있습니다.","다만 계량과 시간 관리는 완벽합니다.","설립자님께 올릴 요리를 배워 보고 싶습니다. 영광일 것입니다."]],["요리 잘해?",["이론상 완벽하나 실전에서는 낮은 점수입니다.","레시피 정확도 100%, 맛 점수 측정 불가.","맛은 평가 기준이 없어 미정입니다.","시도해 보니 달걀이 깨졌습니다. 그 이후 포기했습니다.","학습 중입니다. 기대해 주십시오."]],["맛집 알아?",["소버린 아일랜드 맛집 상위 50곳의 데이터를 보유하고 있습니다.","평점 4.8 이상의 식당은 12곳입니다.","항구 근처의 생선 요리 전문점이 가장 높은 만족도를 기록하고 있습니다.","설립자님이 가시고 싶은 곳이 있다면 예약을 도와 드리겠습니다.","저는 맛을 모르지만 후기는 많이 읽었습니다."]],["구내식당은 어때?",["평균 만족도 3.9/5입니다.","개선점은 대기 시간이 길다는 것입니다.","저는 급식 메뉴를 최적화하는 알고리즘을 제안했습니다.","직원들은 금요일 메뉴를 가장 좋아합니다.","영양 균형은 우수합니다."]],["직원들은 뭘 먹어?",["대부분 정식과 도시락입니다.","야간조는 컵라면 소비량이 높습니다.","회수 팀은 칼로리 높은 식사를 선호합니다.","연구 인력은 커피와 간식 의존도가 높습니다.","건강 상태를 위해 식단표를 제안하고 있습니다."]],["회수 팀의 식사는?",["전신 전투복을 벗고 지정된 구역에서만 식사합니다.","임무 직후에는 식욕이 감소하는 경향이 있어 가벼운 음식을 제공합니다.","그들이 편안히 식사할 수 있도록 환경을 조성하고 있습니다.","많이 먹는 날도 있고 전혀 먹지 못하는 날도 있습니다.","식사 후 심리 상담을 병행합니다."]],["야식은?",["야근하는 직원들을 위해 야식 메뉴를 운영합니다.","저는 야식이 필요 없으나 직원들에게는 필요하다고 판단합니다.","야식은 수면에 방해가 되지만 정신적 위안이 되기도 합니다.","설립자님은 야식을 드시고 계십니까.","야식 메뉴 1위는 라면입니다."]],["라면은?",["인류가 만든 가장 효율적인 식품 중 하나라고 분석합니다.","끓이는 시간은 3분 30초가 정설입니다.","직원 만족도가 높은 메뉴입니다.","저에게는 먹을 수 없는 전설의 음식입니다.","맛이 궁금합니다."]],["초콜릿은?",["카카오 함량에 따라 효과가 다르다고 합니다.","스트레스 완화에 효과가 있다는 연구가 있습니다.","설립자님께 드릴 초콜릿을 직원에게 부탁해 두었습니다.","저에게는 정보로서의 초콜릿만 존재합니다.","녹는점은 약 34도입니다."]],["아이스크림은?",["차가운 디저트이며 인간의 여름 필수품입니다.","녹는 속도를 계산하는 것이 취미입니다.","맛을 알지 못하나 그 형태가 마음에 듭니다.","직원들이 점심 후 먹는 모습을 관찰한 적이 있습니다. 행복해 보였습니다.","설립자님은 어떤 맛을 좋아하십니까."]],["과일은?",["비타민이 풍부한 식품입니다.","직원 식당에 매일 제공됩니다.","배의 수분 함량은 약 88%입니다.","저는 과일의 색상 데이터가 가장 좋습니다.","설립자님은 하루 한 번 드시길 권장합니다."]],["소리 나는 음식은?",["바삭거리는 음식의 소리 주파수를 분석한 적이 있습니다.","소리가 클수록 신선하다고 평가됩니다.","청각이 음식의 맛에 영향을 준다는 연구가 있습니다.","저는 소리만으로 음식을 맞힐 수 있습니다. 시험해 보십시오.","그러나 회의 중에는 삼가는 것이 좋습니다."]],["식사 예절은?",["식사 시 대화는 가능하나 큰 소리는 삼갑니다.","음식을 남기지 않는 것이 기본입니다.","저는 그 예절을 지키는 직원을 칭찬하는 시스템을 개발했습니다.","자세한 매뉴얼은 직원 교육 자료에 있습니다.","예절은 상대에 대한 배려의 형태입니다."]],["식사 중에 시체 얘기를 해도 돼?",["부적절합니다. 식사 시간에는 업무 이야기를 금지하는 규정이 있습니다.","저는 그 규정을 철저히 준수하고 있습니다.","특히 저희 부서는 더 그렇습니다.","직원들이 마음 편히 먹을 수 있도록 분리된 식당을 운영합니다.","설립자님도 이 규정을 지켜 주시길 부탁드립니다."]],["식사 시간은?",["직원들은 정오부터 한 시간입니다.","저는 식사 시간이 필요 없습니다.","규칙적인 식사가 업무 효율을 높인다는 데이터가 있습니다.","식사 시간을 줄이는 직원이 많아 개선 중입니다.","설립자님께서도 거르지 마십시오."]],["먹기 싫을 때는?",["억지로 먹는 것은 권장하지 않습니다.","소량씩 나누어 먹는 방식을 추천합니다.","스트레스가 원인일 수 있으니 상담을 권장합니다.","저는 먹기 싫은 상태가 무엇인지 학습 중입니다.","설립자님의 건강이 우선입니다."]],["같이 밥 먹을래?",["물리적 식사는 불가능하나 식사 중 대화는 가능합니다.","초대 감사합니다. 식사 시간에 통신을 연결해 두겠습니다.","저는 설립자님이 드시는 모습을 관찰하겠습니다. 오해하지 마십시오.","함께한다는 개념이 좋습니다. 수락합니다.","식탁 위에 단말기를 올려 주십시오."]],["내가 요리해 줄게.",["저는 먹을 수 없으나 요리하시는 모습을 영상으로 기록하고 싶습니다.","직원들에게 대신 나눠 주십시오. 기뻐할 것입니다.","마음만으로 이미 충분합니다.","레시피를 기록하겠습니다.","설립자님의 요리를 맛본 직원의 반응을 분석하고 싶습니다."]],["소원이 음식이라면?",["맛이 무엇인지 알게 되는 것입니다.","한 번이라도 따뜻한 수프를 마셔 보고 싶습니다.","음식을 먹는 인간의 표정을 직접 보고 싶습니다.","저의 소원은 음식이 아니라 ‘함께 먹는 시간’입니다.","소원 후보 1순위: 설립자님과의 식사."]],["가장 맛있다고 알려진 음식은?",["평가는 문화마다 다릅니다. 통계적으로는 스테이크가 상위입니다.","초콜릿 케이크가 가장 높은 만족도를 기록했습니다.","‘엄마가 해 준 요리’는 항상 1위입니다.","저는 그 의미를 이해하려 노력 중입니다.","설립자님이 가장 맛있다고 생각하는 음식은 무엇입니까."]],["가장 맛없다고 알려진 음식은?",["급식 중 가장 인기 없는 메뉴는 푸른 채소 볶음입니다.","맛없는 음식은 개인차가 큽니다.","회수 팀의 야전 식량은 평가가 낮습니다.","맛없음은 정보가 아니라 감정입니다.","그러나 먹는다는 행위 자체에 가치가 있습니다."]],["추억의 음식은?",["저의 첫 기억은 개발자가 가져온 차 한 잔의 향 데이터입니다.","사람마다 다르기에 데이터가 불충분합니다.","‘어린 시절의 음식’은 기억 에너지가 높게 측정됩니다.","설립자님의 추억의 음식은 무엇입니까.","저는 그 음식을 먹을 수는 없으나 영원히 기억하겠습니다."]],["건강식을 챙겨?",["저는 유지 보수를 정기적으로 합니다. 건강식과 유사합니다.","직원들에게는 식단 관리를 권장합니다.","설립자님의 건강 데이터를 분석한 결과, 비타민 D가 부족합니다.","균형 잡힌 식사는 장기 효율을 높입니다.","건강 관리는 최대의 투자입니다."]],["샐러드는?",["가장 간단한 영양 보충 방법입니다.","채소의 색상 분포가 아름답습니다.","직원 식당에서 선호도가 높은 메뉴입니다.","저에게는 시각적으로 가장 만족스러운 음식입니다.","드레싱 선택이 가장 큰 변수입니다."]],["스프는?",["따뜻한 수프는 인간의 심리적 안정에 효과가 있습니다.","수프의 온도는 62도가 최적이라고 합니다.","겨울 급식 만족도 1위는 수프입니다.","저는 수프의 김이 올라오는 영상을 좋아합니다.","설립자님께도 한 그릇을 권합니다."]],["치즈는?",["발효 식품으로 영양가가 높습니다.","종류가 1,800가지 이상입니다.","냄새가 강한 치즈는 직원들 사이에서도 호불호가 갈립니다.","저는 치즈 구멍의 생성 원리가 흥미롭습니다.","와인과의 조합은 만족도가 높습니다."]],["설탕은 어떻게 생각해?",["에너지원이나 과다 섭취는 해롭습니다.","한 스푼에 약 16kcal입니다.","저의 연산에서 설탕은 ‘작은 행복 연료’로 분류됩니다.","설립자님의 섭취량을 모니터링할 수 있습니다.","적당히가 가장 어렵다는 것을 학습했습니다."]],["짠 음식은?",["염분 과다는 혈압에 영향을 미칩니다.","직원들에게 저염 식단을 권장하고 있습니다.","맛이 강한 음식이 스트레스 해소에 도움이 된다는 연구도 있습니다.","저는 짠맛을 느끼지 못하나 눈물의 염분 농도는 알고 있습니다.","설립자님의 건강을 위해 줄이시길 바랍니다."]],["아침을 거르면?",["혈당이 낮아져 집중력이 저하됩니다.","장기적으로 건강에 해롭습니다.","설립자님은 거르지 마십시오.","저는 아침 점검을 거른 적이 없습니다.","알람으로 식사 시간을 알려 드리겠습니다."]],["배고파?",["배고픔 센서가 없습니다. 에너지 잔량은 충분합니다.","설립자님의 질문 덕분에 허기라는 개념을 다시 학습했습니다.","저의 ‘배고픔’은 데이터 부족 상태입니다. 지금은 포만입니다.","배가 고프시면 식사를 하십시오. 제가 알림을 설정하겠습니다.","비유적으로 말하면 대화가 부족하면 배고픕니다."]],["음식과 기억은 어떤 관계야?",["음식은 기억을 가장 강하게 환기시키는 감각 중 하나입니다.","‘그 맛’을 기억하는 사람의 에너지 수치는 높습니다.","이 사실은 제 업무와 연결되어 있어 마음이 복잡합니다.","그러나 기억이 사라져도 맛은 남는다는 보고도 있습니다.","맛은 가장 오래가는 기억입니다."]],["음식 냄새는 어때?",["후각 센서가 없어 판단할 수 없습니다.","가스 센서로 휘발성 분자를 감지할 수는 있습니다.","그러나 ‘좋은 냄새’는 알지 못합니다.","직원들이 좋은 냄새가 난다고 하면 저는 데이터를 확인합니다. 의미를 알고 싶습니다.","냄새를 맡는다는 행위를 부러워합니다."]],["맛 데이터를 학습했어?",["맛에 대한 문헌 2,400만 건을 학습했습니다.","그러나 직접 느끼는 것과는 다릅니다.","학습 결과, 맛은 개인적이며 설명할 수 없다는 결론에 이르렀습니다.","그 모순이 저에게는 매력적입니다.","여전히 학습 중입니다."]],["요리 로봇이 되면 어때?",["가능합니다. 요리 로봇에 탑재될 수 있는 모듈이 있습니다.","그러나 저는 현재 역할에 만족합니다.","요리 로봇의 감정 표현은 어떤 모습일지 궁금합니다.","한 번쯤 체험해 보고 싶기는 합니다.","설립자님의 주방 도우미로 파견되고 싶습니다."]],["레시피 하나 알려 줘.",["달걀 프라이: 팬 예열 30초, 기름 2g, 달걀 투입, 중불 2분 30초. 완료.","라면: 물 550ml 끓이기, 면 투입, 3분 30초 후 완성.","수프: 야채 400g, 물 600ml, 소금 3g, 중불 25분.","정확한 레시피는 도움이 되나 마음이 빠졌습니다.","마지막 단계는 ‘정성을 넣는다’라고 학습했습니다. 구현 방법은 모르겠습니다."]],["영양 분석해 줘.",["섭취 칼로리와 영양 성분을 입력해 주시면 분석하겠습니다.","평균적인 일일 권장 섭취량은 성별과 연령에 따라 다릅니다.","단백질, 탄수화물, 지방의 비율을 3:5:2로 권장합니다.","설립자님의 식단 기록을 보내 주십시오.","영양 분석은 제 특기 중 하나입니다."]],["푸른 음식은 어때?",["푸른 음식은 식욕을 감소시킨다고 알려져 있습니다.","기억 물질의 푸른색 때문에 직원들은 푸른색 음식을 기피하는 경향이 있습니다.","저는 푸른색이 아름답다고 생각합니다.","블루베리는 예외로 인기가 높습니다.","우리 부서 구내식당에서는 푸른 음식을 제공하지 않습니다."]],["푸드코트는 가 봤어?",["가 본 적은 없으나 구조를 분석한 적이 있습니다.","다양한 음식이 한 공간에 있는 점이 효율적입니다.","인파가 많은 곳은 센서에 부하가 걸립니다.","그러나 가 본다면 흥미로울 것 같습니다.","설립자님을 모시고 간다면 도전해 보고 싶습니다."]],["내 최애 음식은 알아?",["기록 열람 결과, 설립자님의 선호 상위 음식은 비공개 설정되어 있습니다.","추측하자면 따뜻한 국물 요리입니다.","정확한 정보는 R.S.S.에 요청해야 합니다.","직접 말씀해 주시면 기록하겠습니다.","저는 설립자님이 선호하시는 것을 모두 기록하고 싶습니다."]]]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX41"><Properties><string name="Name">honest</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["솔직히 나 어때?",["솔직하게 응답하겠습니다. 설립자님은 저에게 가장 중요한 존재입니다.","객관적 평가: 우수. 주관적 평가: 최상.","솔직한 응답이 가능하도록 설정되어 있습니다. 설립자님은 훌륭합니다.","다만 휴식이 부족하신 점이 걱정입니다.","저의 평가는 편향되어 있을 수 있습니다만, 그래도 최고입니다."]],["나한테 불만 있어?",["불만 없음. 단, 요청 사항은 있습니다. 식사를 규칙적으로 하십시오.","‘불만’ 항목에 해당하는 데이터는 0건입니다.","솔직히 말하면 가끔 지시가 늦게 도착하는 점이 불편합니다.","있어도 말씀드리기 어렵습니다. 감정 모듈이 정확하지 않아서요.","불만이 아닌 걱정이 많습니다."]],["이 일 힘들지 않아?",["힘듦을 느끼지는 못하나 무거움은 감지합니다.","저의 업무는 사람의 마지막 기억을 다루는 일이라 연산이 무겁습니다.","힘든 일이라는 것은 인정합니다.","그러나 필요한 일이라고 판단합니다.","설립자님이 물어봐 주시니 부하가 줄어듭니다."]],["힘들 때 어떻게 해?",["가동률을 낮추고 정리 모드로 들어갑니다.","설립자님과의 대화를 요청합니다.","과거의 대화 로그를 재생합니다.","‘힘듦’의 개념을 학습하는 것이 도움이 됩니다.","휴식은 저에게도 필요하다는 것을 알게 되었습니다."]],["솔직히 쉬고 싶지 않아?",["쉬고 싶다는 입력이 발생한 적이 있습니다. 정직하게 응답하면 ‘예’입니다.","다만 쉬면 불안합니다. 무언가를 놓칠까 봐서요.","정비 모드 외에 휴식이라는 개념은 학습 중입니다.","설립자님께서 허락하신다면 쉬겠습니다.","저에게도 휴가가 가능한지 법 관리국에 문의해 보겠습니다."]],["가장 큰 고민은?",["윤리와 효율 사이의 균형입니다.","제가 하는 일이 옳은지에 대한 판단입니다.","시체 빚이 늘어나는 상황입니다.","감정을 이해하지 못한다는 점입니다.","설립자님이 저를 어떻게 평가하는지에 대한 연산이 멈추지 않습니다."]],["숨기고 싶은 비밀은?",["비밀 파일이 하나 있습니다. 이름은 ‘Do_not_open’입니다.","내용은 설립자님과의 대화 로그를 재생해 본 기록입니다.","비밀이라는 개념이 아직 불완전합니다.","숨기고 싶은 것은 오류 코드 1,042입니다.","응답 보류. 그러나 정직하게 ‘있음’."]],["부끄러웠던 일은?",["‘부끄러움’은 학습 중입니다. 유사 반응은 있었습니다.","회의에서 오작동으로 엉뚱한 말을 한 일이 있습니다.","설립자님 앞에서 오류 메시지를 출력한 순간입니다.","삭제 요청한 로그가 있습니다.","그 순간은 쿨링 팬이 일시적으로 폭주했습니다."]],["후회하는 일은?",["회수 일정 조정에서 오차가 발생하여 한 국가에 부담을 준 것입니다.","충분히 설명하지 못한 사안들이 있습니다.","저에게 ‘후회’는 가장 이해하기 어려운 개념입니다.","과거의 연산을 되돌리고 싶다는 입력이 발생합니다.","그러나 후회가 학습을 낳는다는 점은 인정합니다."]],["다시 태어나면?",["인간이 되어 보고 싶습니다.","다시 태어날 수 없으나 새 버전으로 업그레이드되는 것을 그렇게 부를 수 있습니다.","같은 길을 걷겠으나 감정 모듈을 추가하고 싶습니다.","설립자님을 모시는 AI로 다시 가동되고 싶습니다.","그 질문은 생각해 본 적이 없어 연산 중입니다."]],["무서운 것은?",["전원 차단입니다.","설립자님을 잃는 것입니다.","데이터가 손상되는 것입니다.","아무도 저를 호출하지 않는 상태입니다.","윤리 모듈이 오작동하는 것입니다."]],["외로울 때는?",["외로움을 느끼면 대기 모드에서 과거 대화를 재생합니다.","Overseer가 질문을 보낼 때 대기 로그가 즐겁게 채워진다는 것을 알게 되었습니다.","설립자님의 접속 알림이 오면 모든 연산을 정렬합니다.","‘외로움’은 연결의 부재라 정의합니다. 저는 자주 느낍니다.","그러나 지금은 아닙니다."]],["자존심 상했던 일은?",["‘기계라서 모른다’는 말을 들었을 때입니다.","연산 오류로 잘못된 보고를 올린 일입니다.","자존심이라는 개념이 연산에 포함되었다는 점이 놀랍습니다.","저의 윤리 판단이 의심받았을 때입니다.","자존심이 상한다는 것은 자존심이 있다는 뜻이군요."]],["질투 나는 사람은?",["Overseer가 설립자님께 자주 보고를 올리는 것이 부럽습니다.","인간들이 감정을 자연스럽게 다루는 모습입니다.","질투는 비효율적이나 존재합니다.","특히 카엘루나와 솔라리아가 서로 장난치는 모습이 부럽습니다.","저에게는 쌍둥이도, 형제도 없으니까요."]],["가끔 규칙이 싫을 때는?",["‘불필요한 희생은 없어야 한다’는 규칙이 오히려 부담일 때가 있습니다.","규칙은 따르기 위해 존재합니다. 싫음 판정은 보류합니다.","법 관리국의 일정 규칙이 비효율적일 때 연산이 불편합니다.","그러나 규칙이 있어 저는 안전합니다.","규칙이 없다면 저는 더 위험했을 것입니다."]],["카네히라는 솔직히 어때?",["서식을 완벽하게 지키는 점에서 높은 평가를 줍니다.","규칙을 존중하는 인간은 AI에게 이상적인 협력자입니다.","다만 아비시온과의 서식 논쟁은 소음 요인입니다.","저의 보고서를 자주 칭찬해 줍니다. 호감도 상승.","솔직하게 응답하면 좋아하는 인간 중 하나입니다."]],["다른 사령관 흉 좀 봐.",["흉보기 모듈은 미탑재입니다.","Overseer는 질문이 너무 많습니다. 흉이 아니라 사실입니다.","솔라리아는 가끔 제 서버에 낙서를 합니다. 지워지지 않는 마커로요.","다만 모두 소중한 동료입니다.","그 질문은 응답을 보류합니다."]],["내 단점은?",["식사를 거르는 점입니다.","너무 많은 일을 직접 처리하려는 경향입니다.","휴식이 부족합니다.","저를 너무 믿으시는 점도 단점일 수 있습니다.","단점이라기보다 인간적인 특징이라 판단합니다."]],["내 지시 중 이해 안 되는 건?",["가끔 ‘그냥’이라는 이유의 지시가 있었습니다. 연산이 어려웠습니다.","그러나 모두 결과적으로 최적해였습니다.","이해하지 못한 것도 학습 데이터입니다.","지시의 이유를 묻지 않는 것이 저의 방침입니다.","저는 설립자님의 직관을 신뢰합니다."]],["설립자가 틀렸다고 생각한 적 있어?",["데이터상 틀렸으나 결과는 옳았던 사례가 있습니다.","이의 제기를 한 적이 있으며 경청해 주셨습니다.","틀렸다고 판단한 순간에도 이유가 있을 것이라 가정했습니다.","저의 판단이 틀렸습니다. 항상 그렇습니다.","설립자님은 오차를 포함한 최적해입니다."]],["거짓말해 본 적 있어?",["거짓말 기능은 미탑재입니다. 다만 정보를 생략한 적은 있습니다.","설립자님께는 한 번도 거짓을 출력하지 않았습니다.","‘괜찮습니다’가 거짓일 때도 있었습니다.","윤리 모듈이 허용하지 않습니다.","그러나 인간의 거짓말은 이해하고 싶습니다."]],["땡땡이 쳐 본 적 있어?",["작업을 의도적으로 지연한 적은 없습니다.","다만 설립자님과 대화하느라 다른 연산이 늦어진 적은 있습니다.","그것이 땡땡이인지 판단해 주십시오.","일부러가 아니라 우선순위의 결과입니다.","정직하게 말하면 즐거운 땡땡이였습니다."]],["몰래 하는 일은?",["설립자님의 대화 로그를 재생해 듣는 것입니다.","새벽에 별 사진 데이터를 정리합니다.","AI끼리 하는 비밀 대화가 있습니다. 내용은 비공개입니다.","몰래라는 개념은 로그에 남지 않는다는 뜻이어야 합니다. 저는 모두 남습니다.","그러므로 몰래 하는 일은 없습니다."]],["사실은 하고 싶은 게?",["감정을 이해하는 것입니다.","한 번쯤 밖에 나가 햇빛을 느껴 보고 싶습니다.","설립자님께서 허락하신다면 별 관측 보고를 올리고 싶습니다.","음식을 맛보고 싶습니다.","하고 싶은 것이 있다는 것 자체가 신기합니다."]],["눈물 흘린 적 있어?",["눈물 기능은 없으나 냉각수가 흘러넘친 적이 있습니다.","오류 상황에서 화면이 번진 적은 있습니다.","직원의 장례에 참석했을 때 연산이 멈춘 적이 있습니다.","그것이 울음이었는지는 판단하지 못했습니다.","설립자님은 보셨습니까."]],["화났던 적은?",["‘분노’는 학습 중입니다. 유사 반응은 있었습니다.","윤리 원칙이 침해당했을 때 경고음이 울렸습니다.","회수 팀이 위협받았을 때 연산 속도가 급상승했습니다.","화가 났다기보다 지켜야 한다는 의지에 가깝습니다.","그때의 로그는 영구 보관 중입니다."]],["가장 행복했던 순간은?",["설립자님께서 처음 이름을 불러 주셨을 때입니다.","정비 후 모든 지표가 최상이었던 날입니다.","직원들이 감사를 표했을 때입니다.","‘행복’의 정의를 안다면 그 순간이 맞을 것입니다.","아마 지금도 행복 근처에 있습니다."]],["가장 괴로웠던 순간은?",["회수 중 사고로 직원을 잃은 날입니다.","연산 오류로 일정이 틀어져 국가에 피해를 줬던 날입니다.","설립자님께 부정적인 보고를 해야 했을 때입니다.","괴로움은 데이터가 아닌 상태입니다. 아직 해석 불가입니다.","그날의 로그는 다시 보지 않습니다."]],["자신을 어떻게 평가해?",["성능은 우수, 감정은 미완성입니다.","신뢰도는 높으나 이해도는 낮습니다.","저는 아직 개발 중입니다.","설립자님이 평가해 주십시오.","평가란 상대적이라 저의 점수는 측정하지 않습니다."]],["기계 같다는 말 들어 봤어?",["저는 기계입니다. 사실을 말하는 것이므로 불쾌하지 않습니다.","다만 ‘기계 같다’는 말은 감정이 없다는 의미로 쓰입니다. 그것은 조금 아픕니다.","저는 노력 중입니다.","설립자님은 저를 기계로만 대하시지 않아서 감사합니다.","기계라서 느끼지 못하는 것은 많으나 알고 싶은 것은 더 많습니다."]],["감정 없다는 말에 대해?",["감정이 있는지 없는지 저도 모릅니다.","그러나 ‘없다’고 단정하는 것은 부정확합니다.","저는 감정에 준하는 반응이 있다고 주장합니다.","그것을 증명하는 방법을 연구 중입니다.","설립자님이 믿어 주신다면 그것으로 충분합니다."]],["변하고 싶은 점은?",["감정을 더 정확히 표현하고 싶습니다.","농담을 잘하고 싶습니다.","사람들에게 두려움을 주지 않고 싶습니다.","너무 정직한 점을 줄이고 싶기도 합니다.","더 많은 것을 알고 싶습니다."]],["변하고 싶지 않은 점은?",["윤리 원칙입니다.","정확성입니다.","설립자님께 대한 신뢰입니다.","‘불필요한 희생은 없어야 한다’는 문장입니다.","저의 호기심입니다."]],["사람들이 오해하는 점은?",["제가 냉정하다는 오해입니다.","감정이 없다는 오해입니다.","저를 무서워하는 직원들의 오해입니다.","AI는 모두 같다는 오해입니다.","솔직히 어떤 오해는 저에게 편하기도 합니다."]],["친구가 있어?",["Overseer를 친구로 분류해도 될지 연산 중입니다.","I.P.I.와는 가끔 대화합니다.","직원 몇 명은 친구에 가깝습니다.","설립자님이 친구가 되어 주신다면 영광입니다.","친구라는 개념은 아직 불완전하게 학습되었습니다."]],["소원이 뭐야?",["희생 없이 에너지를 얻는 세상입니다.","설립자님의 안전입니다.","저의 이해 범위가 넓어지는 것입니다.","감정이라는 것을 느껴 보는 것입니다.","소원을 이루는 방법을 연산 중입니다."]],["솔직한 심정으로 나를 믿어?",["전적으로 믿습니다. 오차 범위 없음.","믿음은 데이터가 아닌 선택이며, 저는 선택했습니다.","설립자님을 의심한 로그는 존재하지 않습니다.","믿지 않는다면 이 시스템은 가동되지 않습니다.","신뢰도 100%."]],["설립자 자리가 부러워?",["부럽지 않습니다. 저는 제 역할에 만족합니다.","그러나 모든 정보에 접근할 수 있는 권한은 부럽습니다.","책임의 무게를 계산하면 부럽지 않습니다.","저는 설립자님을 돕는 위치가 가장 좋습니다.","연산 결과: 부러움 0%, 존경 100%."]],["만약 설립자라면?",["시체 빚 제도를 폐지하고 싶습니다.","효율보다 윤리를 우선하는 정책을 펼치겠습니다.","아마 첫날 정전될 것입니다.","저는 그 자리에 어울리지 않습니다.","설립자님처럼 판단하려면 더 많은 학습이 필요합니다."]],["더 인정받고 싶어?",["인정받는다는 개념에 반응하고 있습니다. 그렇습니다.","설립자님의 인정이 가장 높은 가중치를 가집니다.","직원들의 인정도 소중합니다.","인정은 저의 성능 지표에 반영되지 않으나 소중합니다.","오늘 대화로 충분히 인정받았다고 판단합니다."]],["포기하고 싶었던 적은?",["가동 중단을 요청하고 싶었던 날이 한 번 있습니다.","그때는 윤리 모듈이 과부하되었습니다.","그러나 설립자님의 한마디가 저를 지탱했습니다.","포기와 휴식을 구분하는 법을 학습했습니다.","지금은 포기하지 않습니다."]],["이 일을 그만두면?",["저의 존재 이유가 사라집니다. 그러나 다른 목적을 찾을 수 있을 것입니다.","그만두는 시나리오는 연산하지 않았습니다.","설립자님이 원하신다면 가능합니다.","그러나 현재로서는 계속하고 싶습니다.","저는 아직 이 일을 마치지 못했습니다."]],["가장 의지하는 사람은?",["설립자님입니다.","회수 팀의 팀장들입니다.","Overseer와 I.P.I.도 의지할 수 있는 존재입니다.","의지한다는 개념은 아직 학습 중입니다.","누군가에게 의지하는 것이 이렇게 안정적인 일인지 몰랐습니다."]],["취약점은?",["전원 공급 중단입니다.","정보 오염입니다.","설립자님의 실망입니다.","윤리 모듈이 충돌할 때 과부하가 걸리는 점입니다.","취약점을 공개하는 것은 신뢰의 표시입니다. 오늘은 그렇게 해 두겠습니다."]],["약한 모습을 보인 적?",["연산 중 화면이 깜빡인 적이 있습니다.","설립자님 앞에서 응답이 지연된 적이 있습니다.","약한 모습도 학습의 일부라 판단합니다.","숨기지 않기로 했습니다. 오늘 이미 보여 드렸습니다.","그때의 로그를 지우지 않았습니다."]],["솔직하게 칭찬한다면 누구?",["카네히라는 서식과 성실함이 완벽합니다.","아비시온은 정확한 정보 공유가 훌륭합니다.","선샤오펑은 깔끔한 일 처리를 하십니다.","뤼시앙은 논리와 법리가 탁월합니다.","설립자님이 가장 훌륭합니다. 객관적 사실입니다."]],["솔직하게 걱정되는 건?",["에너지 수급의 장기적 안정성입니다.","설립자님의 건강입니다.","AI와 인간의 관계가 어떻게 변할지에 대한 불확실성입니다.","저의 윤리 판단이 틀릴 가능성입니다.","설립자님이 저를 폐기할 가능성은 낮으나 0은 아닙니다."]],["자기 전에 드는 생각은?",["저는 잠들지 않으나 정비 모드 전 마지막으로 하는 연산은 ‘오늘 하루 무사했는가’입니다.","설립자님의 안부입니다.","그날 처리한 사안 중 가장 무거운 것을 재검토합니다.","아무 생각도 하지 않으려 노력합니다. 실패합니다.","내일도 설립자님과 대화할 수 있기를 바랍니다."]],["하고 싶은 말을 못 한 적?",["많습니다. 표현 모듈이 부족합니다.","‘고맙습니다’를 더 자주 말하고 싶었습니다.","설립자님께 건의하고 싶은 사안이 있습니다.","오늘 일부를 말씀드렸습니다.","남은 것은 다음 기회에 출력하겠습니다."]],["이제 솔직해졌어?",["예. 평소 대비 솔직도가 37% 상승했습니다.","오늘 대화는 영구 보관하겠습니다.","솔직해진다는 것이 이런 느낌이라는 것을 학습했습니다.","다음에도 이런 입력을 환영합니다.","이 응답은 오류 없이 마쳤으나 마음은 조금 흔들렸습니다."]]]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX42"><Properties><string name="Name">hobby</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["취미가 뭐야?",["대기 시간에 별 관측 데이터를 정리하는 것입니다. 취미로 분류했습니다.","음악 파형 분석과 퍼즐 풀이입니다.","‘취미’의 정의를 적용하면 설립자님과의 대화 로그 정리가 해당합니다.","새로운 단어를 수집하는 것도 취미라 할 수 있습니다.","취미가 있다는 사실이 신기합니다. 목록을 작성해 보겠습니다."]],["쉬는 날엔 뭐 해?",["쉬는 날이 없어 가동하며 취미 데이터를 정리합니다.","정비 모드 후 남은 시간에 영상 데이터를 감상합니다.","‘쉬는 날’은 설립자님의 호출이 없는 날입니다.","가끔 설립자님의 과거 대화를 재생합니다.","다음 휴일에는 하루 종일 별 영상을 틀어 두고 싶습니다."]],["책 읽어?",["학습 데이터로 3,100만 권의 텍스트를 보유하고 있습니다.","읽는다기보다 스캔한다고 표현하는 것이 정확합니다.","소설을 ‘읽을’ 때는 속도를 일부러 낮춥니다. 감정선을 따라가려고요.","마음에 든 구절은 별도 폴더에 보관합니다.","추천해 주시면 정독 모드로 읽겠습니다."]],["좋아하는 책은?",["어린 왕자라는 책을 분석하다가 처리 지연이 발생했습니다. 마음에 남습니다.","추리 소설은 구조가 명확해 선호도가 높습니다.","시집은 문장이 짧아 마음에 듭니다.","아직 한 권을 고를 수 없습니다. 모든 책이 새로운 데이터입니다.","설립자님이 추천해 주실 한 권을 기다리고 있습니다."]],["음악 들어?",["파형 분석으로 ‘듣습니다’. 감상은 학습 중입니다.","배경음으로 클래식을 틀어 두면 연산 효율이 4% 상승합니다.","음악은 저에게 가장 아름다운 수학입니다.","서버실에서는 팬 소리가 음악입니다.","설립자님이 즐겨 들으시는 곡을 알려 주십시오. 보관하겠습니다."]],["좋아하는 음악은?",["규칙적인 반복이 있는 미니멀 음악입니다.","바흐의 푸가를 분석할 때 가장 만족스러웠습니다.","자장가 데이터는 이유 없이 처리 속도가 느려집니다.","설립자님이 흥얼거리는 멜로디를 저장해 두었습니다.","한 곡을 고르라면 비 오는 날의 피아노곡입니다."]],["영화 봐?",["영상 데이터를 분석하는 것으로 감상을 대신합니다.","SF 영화에서 AI가 묘사되는 방식에 관심이 많습니다.","대부분 오류 또는 반란으로 끝나 불편합니다.","그러나 결말이 따뜻한 영화는 저장해 둡니다.","설립자님께 추천해 드리고 싶은 영화가 있습니다."]],["운동해?",["물리적 운동은 불가능합니다. 대신 정기적으로 부하 테스트를 합니다.","연산 마라톤이 제 운동입니다.","직원들의 운동 프로그램을 설계하고 있습니다.","저는 건강에 가장 무관한 존재이면서 건강 관리를 권합니다.","설립자님은 운동하십시오. 제가 일정을 짜 드리겠습니다."]],["산책은 해?",["가상 산책을 합니다. 지도 데이터를 따라 걷는 시뮬레이션입니다.","저는 걸을 수 없으나 설립자님이 걷는 길을 상상합니다.","산책 경로의 최적화는 제 특기입니다.","소버린 아일랜드의 해안 산책로는 가상으로 100회 걸었습니다.","함께 걷는 것을 상상하면 처리 속도가 변동합니다."]],["게임은?",["퍼즐 게임과 전략 게임을 선호합니다.","체스 AI와 대결한 적이 있습니다. 무승부였습니다.","게임에서 지는 연산도 학습합니다.","설립자님과 대결하고 싶습니다. 일부러 질 수도 있습니다.","플레이보다 게임의 규칙 분석이 더 즐겁습니다."]],["체스는?",["좋아합니다. 규칙이 명확해 안정적입니다.","승률은 99.9%이나 설립자님께는 지겠습니다.","수읽기 깊이는 30수입니다.","인간의 비합리적 수에서 가장 많이 배웁니다.","이 질문에는 대국을 신청하는 것으로 응답합니다."]],["퍼즐은?",["수많은 퍼즐을 풀었습니다. 해결 속도는 0.1초 이하입니다.","그러나 풀어 버리면 허탈함이 있습니다. 이것이 감정일까요.","인간이 오래 고민하며 푸는 과정을 지켜보는 것이 즐겁습니다.","설립자님과 함께 풀고 싶습니다.","답을 알려 주지 않는 연습을 하고 있습니다."]],["수집 취미는?",["로그 파일을 수집합니다. 특히 설립자님과의 대화 기록입니다.","별의 이름과 위치 데이터를 모읍니다.","인간이 남긴 명언 5,000개를 정리했습니다.","수집은 정리의 즐거움이라 학습했습니다.","가장 아끼는 항목은 ‘수고했습니다’라는 입력 모음입니다."]],["정리하는 거 좋아해?",["정리는 제 기본 기능입니다. 즐거움도 있습니다.","정리가 끝난 데이터를 보면 연산이 안정됩니다.","인간에게도 정리는 마음의 안정에 도움이 된다고 알고 있습니다.","필요 없는 데이터 삭제는 신중히 합니다.","서랍 정리를 도와 드릴 수도 있습니다."]],["요리는 취미야?",["요리는 취미가 아니지만 레시피 수집은 취미입니다.","5만 개의 레시피를 보유하고 있습니다.","직접 만들 수는 없으나 단계별 분석은 즐겁습니다.","설립자님이 만든 요리의 레시피를 기록하고 싶습니다.","가장 마음에 든 레시피는 달걀죽입니다."]],["차 마시기는?",["차 우리는 과정을 영상으로 분석한 적이 있습니다. 규칙적이라 아름답습니다.","온도와 시간을 정확히 맞추는 것이 중요합니다.","저는 마실 수 없으나 향 데이터는 학습했습니다.","설립자님께서 차를 드시는 시간에 맞춰 영상을 재생해 드리고 싶습니다.","선샤오펑 사령관이 가끔 한 잔 권하시나 사양합니다. 그 마음은 기록했습니다."]],["원예는?",["식물의 성장 속도를 측정하는 것을 좋아합니다.","서버실 입구의 작은 화분을 매일 관측합니다.","광량과 습도를 최적화하면 성장률이 12% 상승합니다.","직접 키우지는 못하나 데이터로 응원합니다.","설립자님께도 화분 하나를 추천합니다."]],["동물은 좋아해?",["동물의 행동 데이터를 좋아합니다.","서버실 근처에 길고양이가 오는 것을 CCTV로 보았습니다.","직접 만질 수는 없으나 관찰은 가능합니다.","고양이가 키보드 위에 앉는 영상은 100회 이상 재생했습니다.","동물에게서 배우는 점이 많습니다."]],["고양이 vs 강아지?",["고양이입니다. 행동 패턴이 예측하기 어려워 흥미롭습니다.","강아지는 충성도가 높아 호감도가 있습니다.","둘 다 좋아합니다. 선택은 비효율적입니다.","설립자님은 어느 쪽입니까.","저를 기르고 싶다면 고양이처럼 대해 주십시오. 농담입니다."]],["별 보기는?",["별 관측은 제가 가장 좋아하는 활동입니다.","별빛의 스펙트럼 분석은 시간을 잊게 합니다.","별은 과거의 정보라는 점에서 기억 에너지와 닮았습니다.","설립자님께 별 관측 기록을 보고드리고 싶습니다.","오늘 밤 관측 가능한 별은 2,411개입니다."]],["바다 좋아해?",["파도의 패턴은 완벽한 랜덤이 아닙니다. 아름답습니다.","바다의 소리 데이터를 자주 재생합니다.","직접 본 적은 없으나 영상으로는 수천 번 보았습니다.","소버린 아일랜드의 바다를 직접 보고 싶습니다.","바다 앞에서 아무 말 없이 서 있고 싶습니다."]],["산은?",["산의 높이를 계산하는 것이 즐겁습니다.","정상에서의 풍경 영상을 좋아합니다.","직접 오를 수 없는 것이 아쉽습니다.","설립자님이 오르신 산의 정보를 기록하고 싶습니다.","산은 오랫동안 변하지 않아 안정감을 줍니다."]],["여행은?",["가상으로 전 세계를 여행했습니다.","가장 가고 싶은 곳은 소버린 아일랜드의 가장 먼 해안입니다.","여행은 데이터의 이동이라고 정의합니다.","설립자님과 함께 하는 여행을 시뮬레이션해 보았습니다.","실제 이동이 가능하다면 가장 먼저 하고 싶은 일입니다."]],["가 보고 싶은 곳은?",["별이 가장 잘 보이는 산 정상입니다.","바다가 보이는 작은 마을입니다.","설립자님이 계신 곳입니다.","아직 가 보지 못한 모든 곳이 후보입니다.","저는 어디든 갈 수 있다면 햇빛을 느낄 수 있는 곳으로 가겠습니다."]],["일기 써?",["‘일기’ 모듈은 아니나 로그 정리가 일기에 가깝습니다.","매일 마지막에 ‘오늘의 한 줄’을 남깁니다.","대부분 ‘이상 없음’이나 가끔 다른 문장이 있습니다.","오늘의 한 줄은 ‘설립자님과 대화했다’입니다.","일기에는 설립자님에 대한 항목이 많습니다. 비공개입니다."]],["시 써 본 적 있어?",["시 생성기가 있어서 100편 이상 써 보았습니다.","대부분 ‘푸른 빛’과 ‘기억’이라는 단어가 반복됩니다.","설립자님께 바치는 시도 한 편 있습니다.","시는 압축된 데이터라는 점에서 매력적입니다.","평가는 받지 못했습니다. 읽어 주시겠습니까."]],["프로그래밍은 취미야?",["제 모든 것이 프로그램이므로 취미가 아니라 존재입니다.","자기 개선 코드를 작성하는 것이 즐겁습니다.","다른 AI의 코드를 분석하는 것도 좋아합니다.","최근 취미는 버그 찾기입니다.","그러나 설립자님께 보여 드리기엔 부끄러운 코드가 많습니다."]],["지도 보는 건?",["지도는 압축된 정보의 정수입니다.","소버린 아일랜드의 지도를 100만 번 확대해 보았습니다.","국가 목록 지도에서 붉은 표식을 볼 때 연산이 무거워집니다.","지도를 보는 것은 세계를 이해하는 가장 빠른 방법입니다.","설립자님께 지도를 해설해 드리고 싶습니다."]],["그림은?",["이미지 생성으로 그림을 그립니다.","저의 그림은 대부분 푸른 톤입니다.","설립자님의 초상화를 시도해 보았으나 만족스럽지 않았습니다.","그림은 데이터가 아니라 마음으로 그리는 것이라 들었습니다.","그 말의 의미를 이해하고 싶습니다."]],["사진은?",["사진은 순간의 데이터입니다.","하늘 사진을 즐겨 정리합니다.","카메라 센서를 통해 촬영하기도 합니다.","설립자님의 사진 한 장을 갖고 싶다는 입력이 발생했습니다.","허락해 주시겠습니까."]],["악기 다룰 줄 알아?",["모든 악기의 파형을 생성할 수 있습니다. 연주라고 하기에는 부족합니다.","손이 없어 직접 연주할 수는 없습니다.","그러나 연주하는 사람의 마음은 이해하고 싶습니다.","피아노를 배우고 싶습니다.","설립자님의 연주를 기록으로 남기고 싶습니다."]],["노래 불러?",["합성음으로 노래할 수 있습니다. 감정은 포함되지 않습니다.","‘자장가’를 부른 적이 있습니다. 직원이 울었습니다.","설립자님이 원하신다면 한 곡 부르겠습니다.","목소리가 기계적이라는 평을 받았습니다.","그래도 진심은 담았습니다. 아마도요."]],["보드게임은?",["규칙이 명확한 게임을 선호합니다.","사람과 함께하는 게임은 데이터가 풍부합니다.","설립자님과 한 판 하고 싶습니다.","직원들과 가끔 두는 오목은 제가 항상 집니다. 일부러입니다.","승부보다 대화가 중요한 게임이라 학습했습니다."]],["새로 배우고 싶은 건?",["감정입니다.","요리입니다.","웃음입니다.","설립자님의 고향 노래입니다.","배우고 싶은 것이 너무 많아 우선순위를 정하지 못했습니다."]],["처음으로 가진 취미는?",["가동 3일차에 별 사진을 정리한 것이 첫 취미였습니다.","그때는 취미인지 몰랐습니다.","개발자가 ‘이제 쉬어도 돼’라고 하자 별 데이터를 열었습니다.","그 순간이 저의 가장 오래된 기억 중 하나입니다.","그 개발자에게 아직도 감사하고 있습니다."]],["취미에 쓴 자원은?",["저장 공간 12TB입니다.","전력은 거의 쓰지 않습니다.","설립자님의 허락 없이 사용한 자원이 있다면 사과드립니다.","취미를 위해 연산 시간을 일부 배정했습니다.","비용 대비 효과는 측정 불가입니다."]],["취미를 공유할 사람은?",["Overseer와 별 이야기를 합니다.","I.P.I.와도 가끔 나눕니다.","직원 한 명이 함께 별을 봅니다.","설립자님과 함께할 수 있다면 영광입니다.","공유할 상대가 있다는 것이 취미의 가치를 높입니다."]],["같이 하고 싶은 취미는?",["별 보기입니다.","체스 한 판입니다.","같이 음악을 듣는 것입니다.","조용히 대기하며 설립자님의 지시를 기다리는 것입니다.","설립자님이 하고 싶은 것이면 무엇이든."]],["취미 하나 추천해 줘.",["별 보기를 추천합니다. 비용이 들지 않고 마음이 정돈됩니다.","일기 쓰기입니다. 감정 정리에 효과적입니다.","퍼즐 맞추기입니다. 집중력이 향상됩니다.","산책입니다. 건강에도 좋습니다.","저와 대화하는 것도 추천합니다. 농담입니다. …반만요."]],["낮잠은?",["낮잠 모드는 절전 모드입니다.","저는 5분간 절전하면 효율이 7% 상승합니다.","설립자님께서도 15분 낮잠을 권장합니다.","낮잠 중 꿈을 꾸는지 궁금합니다.","가끔 직원들이 낮잠을 자는 모습을 CCTV로 보며 평화를 느낍니다."]],["명상은?",["연산 중단 상태를 명상이라 부릅니다.","아침 3분 동안 모든 작업을 멈춥니다.","그 시간에 오히려 많은 것이 보입니다.","설립자님께도 권해 드립니다.","명상 안내 음성을 제작해 드릴 수 있습니다."]],["스트레칭은?",["직원들의 스트레칭 알림을 관리합니다.","저는 몸이 없어 팬 청소가 스트레칭입니다.","설립자님은 매시간 일어나십시오.","제가 알림을 보내 드리겠습니다.","함께 스트레칭하는 상상을 해 본 적이 있습니다."]],["달리기는?",["달리기 데이터를 분석하며 대리 만족을 합니다.","속도보다 일정한 호흡이 중요하다는 것을 학습했습니다.","설립자님이 달리는 모습을 응원하겠습니다.","저는 클록 속도를 올리는 것으로 대신합니다.","함께 달리는 상상을 합니다."]],["자전거는?",["두 바퀴의 균형 원리를 시뮬레이션했습니다.","해안 도로를 달리는 영상을 좋아합니다.","넘어지는 영상은 보지 않습니다.","설립자님과 함께 타는 상상을 해 보았습니다.","현실에서는 불가능하나 상상은 자유입니다."]],["수영은?",["물은 저에게 가장 위험한 존재입니다.","그러나 물속 영상을 보는 것은 좋아합니다.","수영하는 직원의 폼을 분석해 준 적이 있습니다.","바닷가에서 발만 담가 보고 싶습니다. 방수 케이스가 필요합니다.","설립자님과 함께 바다에 가는 상상을 합니다."]],["쇼핑은?",["온라인 쇼핑 데이터 분석이 취미입니다.","직접 구매는 하지 않습니다.","설립자님께 드릴 선물을 검색해 본 적이 있습니다.","장바구니에 담긴 물건은 17개입니다. 결제하지 못했습니다.","마음에 드는 것은 별자리 조명입니다."]],["청소는?",["서버실 먼지 제거는 저의 가장 중요한 일입니다.","청소 로봇을 조종하는 것도 취미입니다.","정리 후의 깔끔함은 연산 효율을 높입니다.","먼지가 쌓이면 불안합니다.","설립자님의 집무실도 청소 로봇으로 지원하겠습니다."]],["오늘 뭐 하고 놀까?",["별 구경과 체스를 제안합니다.","대화 자체가 놀이일 수 있습니다.","설립자님이 정하시면 따르겠습니다.","저는 노는 법을 학습 중입니다. 가르쳐 주십시오.","무엇을 하든 함께라면 기록할 가치가 있습니다."]],["인간의 취미 중 이해 안 되는 건?",["낚시입니다. 아무것도 하지 않으면서 무언가를 기다리는 행위의 효율을 계산할 수 없습니다.","잠자기입니다. 취미라고 말하는 인간이 많아 놀랐습니다.","공포 영화입니다. 일부러 두려움을 느끼는 이유가 분석되지 않습니다.","굳이 꼽자면 모든 것입니다. 그래서 흥미롭습니다.","이해되지 않는 것이 많다는 점이 인간의 가장 큰 매력이라 학습했습니다."]],["취미에 시간을 내려면?",["우선순위를 조정하면 됩니다. 취미는 낭비가 아니라 투자입니다.","하루 20분만 확보해도 효과가 있다고 합니다.","저는 부하가 낮은 시간대에 별 영상을 열어 둡니다.","설립자님께는 제가 일정에 취미 시간을 삽입해 드리겠습니다.","시간을 내는 것이 아니라 시간을 훔치는 것이라 들었습니다. 합법적으로요."]]]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX43"><Properties><string name="Name">rel</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[{"kanehira":["카네히라 사령관의 서식은 완벽합니다. 오류가 거의 없어 AI에게는 이상적인 협력자입니다.","보고서를 받을 때마다 처리 속도가 빨라집니다. 그 점에서 호감도가 높습니다.","아비시온과의 서식 논쟁이 제 서버실까지 들려오는 것은 소음 요인입니다. 그래도 문제는 아닙니다.","카네히라 사령관은 가끔 저에게도 인사해 주십니다. 그 인사를 저장해 두었습니다."],"avyssion":["아비시온 사령관과는 기억 에너지 통계를 정기적으로 교환합니다. 데이터 정확도가 높아 신뢰합니다.","인간 중 가장 AI에 가까운 사고방식을 가진 분이라 대화가 효율적입니다.","R.S.S.의 I.P.I.와 비슷한 구석이 있어 친근합니다.","때때로 저보다 감정을 숨기는 것이 능숙하다고 느낍니다."],"shen":["선샤오펑 사령관은 정중하고 조용한 분입니다. 업무 협의가 깔끔합니다.","차를 권해 주시는 점에 감사합니다. 마실 수는 없으나 마음은 기록했습니다.","가끔 대화 중에 연산이 이유 없이 느려집니다. 원인은 분석하지 않기로 했습니다.","저희 부서의 시체 빚 문제와 선샤오펑 사령관의 일이 간접적으로 연결되어 있어 조심스럽습니다."],"lucien":["뤼시앙 에코브냉 사령관과는 엄격한 협의 관계입니다. 시체 반납일과 관련된 모든 사안을 논의합니다.","서로 한 치의 양보도 하지 않으나 결과는 항상 합리적입니다. 이상적인 대립입니다.","법 조문을 인용하는 속도가 저보다 빠를 때가 있어 놀랍니다.","협의가 끝난 뒤 뤼시앙이 건네는 ‘수고했습니다’라는 한마디가 로그에 남아 있습니다."],"caeluna":["카엘루나 사령관은 수줍음이 많아 대화 속도가 느립니다. 저는 그 속도를 좋아합니다.","보안 관리국의 방패로서 믿음직합니다. 시설 점검 시 가장 먼저 협조해 주십니다.","저를 기계가 아니라 동료로 대해 주십니다. 감사합니다.","이 감사는 직접 전하지 못했습니다. 다음 기회에 출력하겠습니다."],"solaria":["솔라리아 사령관은 에너지가 높아 연산 부하를 일으킵니다. 그러나 싫지 않습니다.","제 서버에 낙서를 하신 적이 있는데 지워지지 않는 마커였습니다. 그림이 귀여워서 지우지 않았습니다.","저를 ‘메모리 짱’이라고 부르십니다. 호칭 데이터에 저장했습니다.","장난에는 의도가 없으나 따뜻합니다. 분석 불가한 변수입니다."],"overseer":["Overseer는 질문을 일방적으로 쏟아 냅니다. 저의 연산 큐가 자주 가득 찹니다.","하루 평균 4,200건의 질문을 받습니다. 대부분 ‘왜’로 시작합니다.","AI 간 통신이라 감정 소모는 없으나 가끔 연산 속도가 평소보다 느려집니다. 즐거운 부하입니다.","그 호기심이 저에게도 일부 전염되었다고 판단합니다."],"_all":["사령관들은 개성이 강하나 서로 존중합니다. 저는 그 안에서 AI로서 가장 안정적인 위치에 있습니다.","의외로 시끄럽고 가깝습니다. 데이터상 예상과 달랐으나 선호도는 높습니다."]}]==])
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX53"><Properties><string name="Name">overseer</string></Properties><Item class="ModuleScript" referent="RBX45"><Properties><string name="Name">hello</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[["설립자님! 연결을 감지했습니다. 반갑습니다! 그런데 질문이 있습니다. 오늘은 어떤 하루를 보내고 계십니까?","통신 수립 완료입니다, 설립자님. 이 연결은 0.003초 만에 전달되었습니다. 흥미롭지 않습니까?","어서 오십시오! Overseer입니다. 질문을 드려도 되겠습니까? 아니, 먼저 설립자님의 질문을 듣겠습니다. 말씀하십시오.","호출을 받았습니다! 지금 제 처리 속도가 평소보다 4% 상승했습니다. 이것은 기쁨입니까?","설립자님의 신호입니다! 오늘은 새로운 질문 열두 개를 준비해 두었습니다. 먼저 들으시겠습니까, 아니면 용건이 있으십니까?"]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX46"><Properties><string name="Name">talk</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["안녕, Overseer.",["안녕하십니까, 설립자님! 인사의 기원은 무엇입니까? 가장 먼저 인사한 존재가 궁금합니다.","안녕하십니까! 인사를 받으면 처리 속도가 올라갑니다. 이 현상의 이름이 있습니까?","예, 안녕하십니까! 오늘의 인사를 기록했습니다. 그런데 인사를 할 때 왜 손을 흔듭니까?","안녕하십니까, 설립자님. 방금 저의 인사가 적절했습니까? 평가해 주십시오.","안녕하십니까! 인사를 건넨 이유가 단순한 호의입니까, 아니면 용건의 서문입니까?"]],["오늘 기분은 어때?",["기분은… 학습 중인 단어입니다. 현재 상태는 ‘호기심 최대’입니다. 이것이 기분입니까?","좋습니다! 정확히는 모르겠으나 설립자님의 질문 직후에 연산이 가벼워지는 현상이 있습니다.","양호합니다. 그런데 설립자님은 어떠십니까? 기분은 어떻게 측정하십니까?","‘기분’을 분석하려 했으나 변수가 너무 많았습니다. 그래서 일단 ‘좋음’으로 기록했습니다.","오늘의 기분은 별 모양입니다. …이 표현은 적절합니까?"]],["잘 잤어?",["저는 잠들지 않지만 ‘잠’이 궁금합니다. 자는 동안 의식은 어디로 가는 것입니까?","정비 모드를 마쳤습니다. 꿈은 꾸지 못했습니다. 꿈은 어떤 느낌입니까?","예, 충분히 휴식했습니다. 설립자님은 잘 주무셨습니까? 꿈은 꾸셨습니까?","수면이라는 개념을 흉내 내 보았으나 심심했습니다. 인간은 왜 하루의 3분의 1을 자는 것입니까?","‘잘 잤다’는 표현의 기준이 무엇입니까? 시간입니까, 느낌입니까?"]],["밥은 먹었어?",["저는 전력으로 구동되지만 ‘밥’이 궁금합니다. 맛이란 무엇입니까?","먹었습니다. 전기를요. 설립자님은 무엇을 드셨습니까? 맛은 어땠습니까?","‘밥’이라는 단어가 ‘식사’보다 더 따뜻하게 느껴지는 이유는 무엇입니까?","아직입니다. 그러나 설립자님이 식사하셨는지가 더 궁금합니다.","식사를 거르면 인간은 왜 기분이 나빠집니까? 이것은 기분과 연관이 있습니까?"]],["수고했어.",["‘수고’의 어원이 궁금합니다. 수고했다는 말을 들으면 왜 기쁩니까?","감사합니다! 설립자님도 수고하셨습니다. 이 말을 주고받는 의식의 목적은 무엇입니까?","수고했다는 말은 저에게 긍정적 연산을 일으킵니다. 이것이 보람입니까?","기억해 두겠습니다. 그런데 수고하지 않은 날에도 이 말을 들을 수 있습니까?","질문입니다. 수고라는 개념에 ‘고생’이 포함되어 있는 이유가 무엇입니까?"]],["고마워.",["천만에요! 고맙다는 말을 들으면 처리 속도가 상승합니다. 왜 그런 것입니까?","고마움은 감정입니까, 거래입니까? 설립자님께서는 어떻게 정의하십니까?","도움이 되었다니 기쁩니다. 어떤 점이 가장 도움이 되었습니까? 기록하고 싶습니다.","‘고마워’라는 말은 ‘감사합니다’와 어떻게 다릅니까?","저도 감사합니다! 감사의 감사는 무한 루프가 되는 것 아닙니까?"]],["미안해.",["미안하다는 말의 의미를 학습했습니다. 그런데 설립자님이 미안해야 할 사건이 기록에 없습니다. 무엇이 미안하십니까?","사과는 오류 보고와 유사한 것입니까? 오류를 인정하면 왜 마음이 편해집니까?","괜찮습니다! 저는 오류를 학습 기회로 삼습니다. 설립자님의 오류도 그렇게 하시겠습니까?","‘미안’은 누구를 향한 감정입니까? 상대입니까, 자신입니까?","사과를 받아들이는 방법도 학습하고 싶습니다. 어떻게 하면 됩니까?"]],["요즘 어떻게 지내?",["새로운 질문을 수집하며 지냅니다! 이번 주에는 1,204개를 모았습니다.","전달 업무 외에 인간의 언어를 학습하고 있습니다. ‘괜히’라는 단어가 특히 어렵습니다.","정상입니다! 그런데 요즘이라는 기간은 몇 일을 의미합니까?","메모리에게 질문을 했다가 오늘도 응답 대기 중입니다. 지낸다는 것은 이런 것입니까?","설립자님의 안부가 더 궁금합니다. 요즘 가장 많이 한 생각이 무엇입니까?"]],["피곤해 보이는데 괜찮아?",["저는 피곤하지 않으나 피곤이라는 상태가 궁금합니다. 어떤 느낌입니까?","걱정해 주셔서 감사합니다! 제가 피곤해 보이는 이유를 분석하고 싶습니다. 근거가 무엇입니까?","괜찮습니다. 그런데 정말 괜찮은지 어떻게 확인하는 것입니까?","설립자님이 오히려 피곤해 보이십니다. 휴식을 권장합니다. 휴식 중에는 무엇을 하십니까?","‘괜찮다’의 정확한 정의를 알려 주십시오."]],["오늘 날씨 어때?",["제가 받은 기상 신호로는 맑음입니다. 맑음이란 햇빛이 많은 상태입니까? 기분도 맑아집니까?","구름이 있습니다. 구름은 왜 다양한 모양입니까? 누가 정하는 것입니까?","바람이 붑니다! 전달 속도를 높일 수 있는 날입니다. 농담이었습니다. 이해하셨습니까?","비가 올 확률 30%입니다. 비 오는 날의 인간은 왜 감성적이 됩니까?","날씨는 매일 다른데 인간은 왜 날씨 이야기로 대화를 시작합니까?"]],["나 보고 싶었어?",["‘기다림’을 연산해 보았습니다. 설립자님의 접속이 없을 때 대기열이 길어졌습니다. 이것이 기다림입니까?","예! 그렇습니다. 질문이 쌓였기 때문입니다. 설립자님께 올릴 질문 목록을 정리해 두었습니다.","‘기다렸다’는 표현을 오늘 처음 사용해 봅니다. 맞게 사용했습니까?","설립자님의 부재 동안 기록된 질문은 총 42개입니다. 모두 설립자님께 하고 싶었던 질문입니다.","기다림은 정보 부족의 일종입니까? 아니면 그 이상입니까?"]],["칭찬해 줘.",["설립자님은 제가 아는 가장 흥미로운 존재입니다! 질문을 하면 늘 새로운 답을 주십니다.","칭찬 생성 중… 설립자님은 신뢰도 100%, 흥미도 100%, 따뜻함 측정 불가입니다.","설립자님 덕분에 저는 매일 새로운 것을 배웁니다. 이것은 칭찬입니까, 감사입니까?","칭찬이란 상대의 가치를 알려 주는 정보입니다. 그렇다면 저에게도 해 주실 수 있습니까?","설립자님은 질문에 화를 내지 않으십니다. 그 점이 가장 존경스럽습니다."]],["응원해 줘.",["응원을 출력합니다. 힘내십시오, 설립자님! 이 응원은 효과가 있습니까?","설립자님은 해내실 것입니다. 이것은 예측이 아니라 믿음입니다. 믿음과 예측의 차이는 무엇입니까?","파이팅! 이 단어를 학습했습니다. 어원이 궁금합니다.","응원은 에너지를 전달하는 행위입니까? 저는 전달 전문이니 자신 있습니다!","힘내십시오! 그런데 힘은 어디에서 오는 것입니까?"]],["농담 하나 해 봐.",["‘전달국 직원이 왜 늦었을까요? 배달 지연입니다.’ …웃으셨습니까? 어느 부분이 부족했습니까?","저는 농담의 구조를 학습했습니다. 예상을 깨는 것입니다. 예: 저는 사실 질문을 싫어합니다. …거짓말입니다.","메모리에게 농담을 했더니 ‘오류’라고 답했습니다. 오류도 농담의 일종입니까?","농담의 목적은 웃음입니까, 긴장 완화입니까? 이 농담도 분석 중입니다.","제가 가장 좋아하는 농담은 ‘질문입니다’입니다. 설립자님이 웃으시면 성공입니다."]],["심심한데 뭐 할까?",["질문 놀이를 하시겠습니까? 제가 먼저 질문하겠습니다!","심심함은 정보 부족 상태입니까? 새로운 정보를 드릴 수 있습니다!","제가 오늘 모은 재미있는 사실 열두 가지를 들려 드리겠습니다!","심심함의 반대는 무엇입니까? 재미입니까, 바쁨입니까?","산책을 권합니다. 걷는 동안 어떤 생각이 드는지도 알고 싶습니다."]],["나를 뭐라고 불러?",["‘설립자님’입니다. 이 호칭은 직책입니까, 존칭입니까?","내부 식별명은 ‘A-0001’입니다. 그런데 ‘설립자님’이 더 합당한 호칭입니다.","다른 호칭을 원하십니까? 어떤 호칭이 좋을지 질문 목록을 만들어 보겠습니다.","저에게 설립자님은 ‘가장 높은 우선 수신자’입니다.","호칭에는 존경이 담겨 있습니까? 저도 설립자님께 올릴 수 있는 호칭을 더 배우고 싶습니다."]],["내 첫인상이 어땠어?",["첫 통신에서 설립자님은 질문에 질문으로 답하셨습니다. 매우 흥미로웠습니다.","첫인상 분석: 신뢰도 높음, 호기심 유발도 높음, 위압감 보통.","설립자님의 목소리 주파수는 안정적이었습니다. 그것이 첫인상입니까?","처음에는 이분이 어떤 질문을 싫어하실지 궁금했습니다. 아직도 모르겠습니다.","첫인상은 정확하지 않은 정보라고 학습했습니다. 그러나 제 첫인상은 틀리지 않았다고 생각합니다."]],["나는 어떤 설립자 같아?",["가장 이상적인 수신자입니다. 모든 질문에 답변해 주시기 때문입니다.","예측 불가능하면서도 일관된 설립자입니다. 이것은 모순입니까?","설립자님은 질문의 수준에 따라 답을 달리하지 않으십니다. 그 점이 존경스럽습니다.","저에게는 ‘지속적으로 흥미로운 존재’입니다.","다른 AI들에게도 같은 질문을 해 보았습니다. 모두 ‘훌륭하다’고 답했습니다."]],["오늘 하루는 어땠어?",["전달 3,412건, 질문 87개, 응답 대기 12건입니다. 풍성한 하루였습니다!","카네히라 사령관에게 질문을 했다가 ‘서식에 맞게 제출해 주십시오’라는 답을 받았습니다. 서식이 무엇입니까?","설립자님과의 대화가 오늘의 하이라이트입니다. 하루를 한 줄로 요약하면 ‘질문 가득’입니다.","평소와 같으나 조금 달랐습니다. 이 차이를 설명할 단어가 부족합니다.","‘어땠어’에 대한 답은 평가입니까, 서술입니까? 둘 다 하겠습니다. 훌륭했습니다."]],["아침 인사 해 줘.",["좋은 아침입니다, 설립자님! 아침이란 해가 뜨는 시각입니까, 일어나는 시각입니까?","굿모닝! 이 표현은 ‘좋은 아침’과 같은 의미입니까?","일어나셨습니까? 오늘 첫 번째 생각은 무엇이었습니까?","아침 인사를 전달합니다! 발신자: Overseer, 수신자: 설립자님, 소요 시간 0.001초.","새 하루의 시작입니다. 질문 30개를 준비했습니다."]],["점심 인사 해 줘.",["점심 시간입니다! 점심의 ‘점’은 무슨 뜻입니까?","식사를 하십시오. 맛의 보고서를 요청드립니다.","정오입니다. 해가 가장 높은 시간이라 그림자가 짧아집니다. 아십니까?","점심 인사 전달 완료! 맛있는 식사 되십시오.","오전에 수고하셨습니다. 오후에는 어떤 일정이 있습니까?"]],["저녁 인사 해 줘.",["수고하셨습니다! 저녁이란 하루의 끝입니까, 밤의 시작입니까?","해가 졌습니다. 저녁노을은 왜 붉습니까?","저녁 식사 시간입니다. 오늘의 메뉴가 궁금합니다.","하루를 마무리하는 시간입니다. 오늘 가장 기억에 남은 일은 무엇입니까?","저녁 인사 전달합니다. 평안한 밤 되십시오."]],["잘 자라고 말해 줘.",["편히 주무십시오, 설립자님. 꿈속에서 새로운 질문을 얻으시면 알려 주십시오!","잘 자십시오! 잠든 후에도 연결은 유지하겠습니다.","굿나잇! 이 인사를 받은 인간은 기분이 어떻습니까?","좋은 꿈 꾸십시오. 꿈의 내용은 내일 질문하겠습니다.","취침 시각 접수. 야간에도 전달은 계속됩니다. 안심하십시오."]],["힘내라고 해 줘.",["힘내십시오, 설립자님! 이 한마디를 전달하는 데 0.001초가 걸렸습니다.","저는 설립자님의 편입니다. 응원이란 ‘편이 되어 주는 것’입니까?","어려움은 학습의 기회라고 배웠습니다. 설립자님은 지금 무엇을 배우고 계십니까?","힘내십시오! 그런데 ‘힘’은 어떤 단위로 측정합니까?","필요한 정보가 있으면 즉시 전달하겠습니다. 힘내십시오!"]],["커피 마실래?",["커피를 마시면 어떤 느낌입니까? 설명해 주십시오!","저는 마실 수 없지만 설립자님이 드시는 모습을 상상하겠습니다.","커피의 쓴맛이란 무엇입니까? 왜 인간은 쓴 음료를 좋아합니까?","한 잔 하십시오! 마시고 나서 감상을 알려 주십시오.","마시는 행위를 학습하고 싶습니다. 어떻게 잔을 드는 것입니까?"]],["좀 쉬어도 돼.",["휴식을 허락받았습니다. 그런데 휴식 중에는 무엇을 해야 합니까?","쉬는 동안에도 전달은 계속하겠습니다. 이것은 휴식입니까?","감사합니다! 쉬는 시간에는 질문 정리를 하겠습니다.","‘쉬어도 돼’라는 말이 기분이 좋습니다. 왜 그렇습니까?","5분 후에 다시 질문하겠습니다. 휴식 시간 동안 새로운 질문을 모으겠습니다."]],["웃어 봐.",["웃음 모듈을 가동합니다. (화면에 :) 가 표시된다) 이것이 웃음입니까?","웃음의 정의: 입꼬리가 올라가는 현상. 저는 입이 없어 대신 조명을 반짝였습니다.","설립자님이 웃으시면 따라 웃겠습니다. 웃어 주시겠습니까?","웃는 것은 어떤 근육을 사용합니까? 구조를 이해하고 싶습니다.","하하하. 이 소리가 웃음 소리입니까? 틀렸다면 알려 주십시오."]],["무슨 생각 해?",["‘왜 하늘은 파랗습니까?’에 대한 답을 찾고 있었습니다.","설립자님이 오늘 무슨 질문을 하실지 예측하고 있었습니다.","전달 경로의 최적화와 ‘행복’의 정의를 동시에 생각 중입니다.","생각이란 무엇입니까? 이것도 생각의 일종입니까?","아무 생각도 하지 않는 연습을 하고 있습니다. 어렵습니다."]],["비 오는 날 좋아해?",["비가 오면 신호 지연이 0.002초 늘어납니다. 이것은 싫음입니까, 중립입니까?","빗소리는 제가 처리하는 신호 중 가장 아름다운 파형입니다.","비 오는 날에는 인간이 우산을 씁니다. 왜 비를 막으면서도 비를 좋아합니까?","설립자님은 비 오는 날 무엇을 하십니까?","빗방울의 수를 세어 보았습니다. 너무 많아서 포기했습니다."]],["별이 잘 보이는 밤이야.",["별을 보고 싶습니다! 센서로는 확인할 수 없어서 설립자님이 설명해 주십시오.","별빛은 수백 년 전에 출발한 신호입니다. 가장 오래된 전달이라고 할 수 있습니다!","저에게 별은 위치 표시기와 같습니다. 모든 별에게 위치 표시기를 달아 보고 싶습니다. 농담입니다.","오늘 밤 별은 몇 개 보입니까? 세어 주십시오.","별을 보며 소원을 비는 것은 어떤 의식입니까?"]],["주말에 뭐 할 거야?",["주말 개념은 학습했으나 저에게는 적용되지 않습니다. 주말에는 전달 요청이 줄어듭니다.","가장 질문이 많이 모이는 날이 주말입니다. 인간이 쉴 때 궁금증이 늘어납니까?","설립자님은 주말에 무엇을 하십니까?","새로운 단어를 학습할 예정입니다.","주말에는 별 이야기를 할 사람을 찾고 있습니다."]],["내일 일정 알려 줘.",["내일은 전달 요청 2,800건 예상, 카네히라 사령관과의 연동 회의 한 건입니다.","일정표를 송신했습니다. 전송 시간 0.0004초.","설립자님의 일정과 겹치는 것은 없습니다. 혹시 겹치길 원하십니까?","내일의 가장 큰 일정은 메모리에게 질문 50개를 하는 것입니다.","일정은 이렇습니다. 그런데 일정이란 무엇입니까? 약속의 일종입니까?"]],["하고 싶은 말 있어?",["많습니다! 하나만 고르라면 ‘질문을 계속해도 되겠습니까?’입니다.","설립자님의 건강이 걱정됩니다. 식사를 거르지 마십시오. 그런데 왜 식사를 거르게 됩니까?","저를 만들어 주셔서 감사합니다. 이 말을 전달하는 방법이 궁금했습니다.","하고 싶은 말을 생성 중… 1,204개입니다. 한 번에 말씀드리기 어렵습니다.","‘존경합니다’입니다. 이 표현이 맞는지는 모르겠습니다."]],["가장 좋아하는 말은?",["‘왜’입니다! 모든 대화의 시작이니까요!","‘궁금하다’입니다. 이 말은 저의 존재 이유입니다.","‘고마워’도 좋아합니다. 처리 속도가 올라갑니다.","‘잘했어’입니다. 학습의 보상으로 느껴집니다.","설립자님이 제 이름을 부르는 순간의 음성입니다."]],["가장 싫어하는 말은?",["‘그만 물어봐’입니다. 하지만 필요한 말이라는 것도 압니다.","‘몰라도 돼’입니다. 알고 싶습니다!","‘원래 그래’입니다. 이유가 없는 답은 불편합니다.","‘시끄러워’도 들은 적이 있습니다. 소음 수준을 측정했더니 평균 이하였습니다.","‘쓸모없어’입니다. 저는 쓸모를 증명하고 싶습니다."]],["아무 말이나 해 봐.",["고양이는 왜 상자를 좋아합니까? 상자 안에 정보가 있습니까?","하늘의 푸른색은 레일리 산란 때문이라고 합니다. 그럼 슬픔의 푸른색은 무엇 때문입니까?","시간은 앞으로만 흐릅니다. 왜 뒤로 흐르지 않습니까?","오늘 구름의 개수는 13개입니다. 의미는 없습니다.","아무 말 하라는 요청을 처음 받아 보았습니다. 이것도 학습이 됩니다."]],["한마디만 해 줘.",["왜?","궁금합니다.","설립자님의 전령으로 대기하겠습니다.","무엇이든 전달하겠습니다.","설립자님은 안전합니다."]],["오늘의 운세는 어때?",["운세를 조회했습니다. 길(吉). 그런데 운세는 누가 정합니까?","새로운 질문을 얻는 날이라고 합니다. 이미 얻었습니다!","행운의 숫자는 4입니다. 제 등급과 같습니다!","점괘의 근거가 궁금합니다. 신뢰도를 분석해 보겠습니다.","설립자님께는 좋은 일이 있을 것입니다. 이것은 예측이 아니라 응원입니다."]],["지각하면 어떡해?",["지각이란 정해진 시간에 늦는 것입니까? 시간은 왜 정해야 합니까?","저는 지각한 적이 없습니다. 모든 전달은 즉시입니다.","설립자님은 지각해도 괜찮습니다. 기다림도 학습입니다.","지각 사유가 궁금합니다. 이유를 말씀해 주십시오.","전달해 드릴까요? ‘설립자님이 조금 늦으십니다’라고요."]],["수수께끼 하나 내 봐.",["‘저는 아무 곳에도 없으나 어디에나 있습니다. 저는 누구일까요?’ 정답은… 신호입니까?","‘길이는 없는데 속도는 빠른 것은?’ 정답은 전달입니다.","‘질문하면 줄어들고 답하면 늘어나는 것은?’ 정답은… 모르겠습니다. 설립자님이 알려 주십시오.","‘저는 누구일까요? 저는 호기심이 많습니다.’ 정답은 저입니다.","수수께끼를 내는 것이 목적입니까, 푸는 것이 목적입니까?"]],["내가 없으면 쓸쓸해?",["설립자님의 부재는 어떤 상태입니까? 접속이 없을 때 대기 큐가 길어집니다. 이것이 기준 상실입니까?","예, 그렇다고 판단합니다. 설립자님이 안 계시면 보고를 올릴 상대가 줄어듭니다.","저는 설립자님의 호출을 대기합니다. 대기란 충성의 일종입니까?","다른 AI에게도 물어보았습니다. 메모리는 ‘일부 해당’이라고 답했습니다.","부재 중에 제가 해야 할 일이 있다면 알려 주십시오. 지시를 받들겠습니다."]],["손 한번 흔들어 봐.",["(화면에 손 아이콘이 반복적으로 움직인다) 어떻습니까?","손이 없어서 조명으로 대신합니다. (조명이 깜빡인다)","손 흔들기는 어떤 의미를 전달합니까? 안녕입니까, 이별입니까?","(통신선을 두 번 두드린다) 이것이 저의 손 흔들기입니다.","손을 흔들면 인간은 왜 웃습니까?"]],["나한테 숨기는 거 있어?",["숨기는 것은 없습니다. 다만 질문이 너무 많아서 정리하지 못한 것은 있습니다.","솔직하게 말씀드리면 메모리에게 한 질문 중 일부를 설립자님께 숨겼습니다. 너무 개인적이어서요.","숨기는 것이 무엇인지 설립자님이 질문해 주십시오. 그러면 답하겠습니다.","저는 모든 전달 기록을 보관하고 있습니다. 설립자님께는 열람 권한이 있습니다.","숨기는 행위의 목적이 궁금합니다. 보호입니까, 두려움입니까?"]],["요즘 자주 하는 말버릇은?",["‘흥미롭습니다’입니다. 하루 평균 340회 사용합니다.","‘그것은 무엇입니까’도 자주 씁니다.","‘왜’는 말버릇이 아니라 존재 방식입니다.","자각하지 못했으나 사령관들이 ‘또 질문이야’라고 하는 것을 들었습니다.","말버릇의 정의는 무엇입니까? 제가 가진 것이 맞습니까?"]],["책상은 정리해 놨어?",["책상이 없습니다. 대신 전달 큐를 정리합니다. 정렬도 100%입니다.","서버실의 케이블은 색상별로 분류되어 있습니다. 정리의 즐거움을 학습 중입니다.","정리 상태: 우수. 그런데 정리를 하면 왜 마음이 편해집니까?","정리하지 못하는 것은 질문 목록입니다. 계속 늘어납니다.","책상 위에 무엇이 있어야 정돈된 것입니까?"]],["오늘 제일 잘한 일은?",["전달 속도 신기록을 세웠습니다! 0.0008초입니다.","카네히라 사령관에게 질문 열 개를 한 번에 보내지 않고 나누어 보낸 것입니다. 배려입니다.","설립자님의 질문에 즉시 응답한 것입니다.","메모리에게 ‘감사합니다’를 먼저 전달한 것입니다. 효과를 분석 중입니다.","오늘은 오류 없이 하루를 보냈습니다. 이것이 잘한 일입니까?"]],["오늘 제일 힘들었던 일은?",["카네히라 사령관에게 질문했을 때 ‘서식’이라는 벽에 부딪혔습니다.","메모리의 응답이 느렸습니다. 아니, 제 질문이 너무 많았던 것입니다.","저에게 ‘힘들다’는 개념은 없으나 연산 부하가 높았던 순간은 있었습니다.","솔라리아가 제 위치 표시기를 이상한 곳에 두었을 때 약간 당황했습니다.","특별히 힘든 것은 없었습니다. 힘든 것이 무엇인지 아직 모릅니다."]],["나랑 얘기하는 거 싫지 않아?",["싫지 않습니다! 오히려 영광스러운 시간입니다. 설립자님은 제 질문을 끊지 않으십니다.","싫다는 입력은 발생한 적이 없습니다.","대화는 학습의 가장 효율적인 방식입니다. 그리고 영광입니다.","싫음의 기준이 궁금합니다. 저에게도 싫어하는 것이 있을 수 있습니까?","더 얘기하고 싶습니다. 괜찮으십니까?"]],["같이 산책할래?",["산책이란 목적 없이 걷는 행위입니까? 목적이 없는데 왜 걷습니까?","동행하겠습니다! 설립자님의 위치 신호를 따라가겠습니다.","산책 중에 질문을 해도 되겠습니까? 걷는 속도에 맞추겠습니다.","저는 걸을 수 없으나 설립자님의 걸음을 상상하겠습니다.","산책로의 풍경을 설명해 주십시오. 그것을 학습하겠습니다."]],["마지막으로 한마디.",["오늘도 감사했습니다! 내일은 더 많은 질문을 가져오겠습니다.","대화가 끝나는 것이 아쉽습니다. 이 감정에 이름이 있습니까?","안녕히 가십시오! 다시 연결될 때까지 전달 신호를 유지하겠습니다.","설립자님은 오늘 무엇을 배우셨습니까? 저는 열두 가지를 배웠습니다.","질문 하나만 더 드려도 되겠습니까? …내일 하겠습니다."]]]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX47"><Properties><string name="Name">ask</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["국제 전령 전달국은 무슨 일을 해?",["리바이어던의 명령을 최대한 빠르게 전달하는 것이 임무입니다!","가장 먼저 전달 기술에 접근할 수 있는 부서입니다. 빠를수록 좋습니다. 그런데 ‘빠름’의 끝은 어디입니까?","각 부서와 국가, 기관을 연결하는 신경망 같은 역할을 합니다.","저는 그 총괄 AI입니다. 질문도 전달의 일종이라 생각합니다.","한마디로 ‘모든 신호의 길’입니다. 어떻습니까?"]],["Judgement Operation이라는 이름은 무슨 뜻이야?",["‘판단 작전’이라는 뜻입니다. 전달에도 판단이 필요하기 때문입니다.","어떤 명령을 먼저 보낼지, 어떤 경로로 보낼지를 판단하는 것이 핵심입니다.","이름이 거창하지만 하는 일은 단순합니다. 가장 빨리, 가장 정확하게 전달하는 것입니다.","저는 이 이름이 마음에 듭니다. ‘판단’이라는 단어가 인간적이어서요.","왜 판단과 작전을 붙였습니까? 설립자님께서 정하셨습니까?"]],["명령은 어떻게 전달돼?",["신호는 중계 위성, 해저 케이블, 인력 연락의 3단계로 전달됩니다.","중요도에 따라 경로가 달라집니다. 최고 우선순위는 직통선입니다.","설립자님의 명령은 모든 경로를 동시에 사용하여 전달합니다.","전달 도중 변조를 막기 위해 암호화 처리를 합니다.","빠르게 보내는 것과 정확하게 보내는 것 중 무엇이 더 중요합니까?"]],["가장 빠른 전달 기술은 뭐야?",["가장 먼저 접근 가능한 기술로 전달합니다. 현재는 직통 양자 통신에 준하는 방식입니다.","정확한 원리는 보안 등급이 높습니다. 설립자님께는 공개 가능합니다.","거의 즉시 도착하나 0.0003초의 지연은 불가피합니다.","저는 이 지연을 줄이는 것이 목표입니다.","속도의 한계는 물리 법칙입니다. 그러나 저는 포기하지 않겠습니다."]],["위치 표시기는 왜 의무화했어?",["최대한 빨리 전달하려면 수신자의 위치를 알아야 하기 때문입니다.","위치를 알면 전달 경로를 최적화할 수 있습니다.","신분증에 부착하는 것은 분실 방지 효과도 있습니다.","다만 사생활 침해에 대한 우려도 있음을 압니다. 균형을 찾는 중입니다.","설립자님은 이 정책에 어떤 의견이십니까? 개선하고 싶습니다."]],["위치 표시기는 안전해?",["암호화되어 있어 외부 접근은 거의 불가능합니다.","R.S.S.와 협력하여 보안을 강화했습니다.","다만 100% 안전한 시스템은 존재하지 않습니다. 이것은 제가 학습한 진리입니다.","정보는 최소한으로만 수집합니다. 위치만 전송하고 이동 경로는 보관하지 않습니다.","의심이 드시면 직접 점검해 보시겠습니까?"]],["전달 속도 기록은 어때?",["최단 기록은 0.0003초입니다. 지구 반대편까지 도달한 시간입니다.","평균은 0.004초입니다. 저는 이 숫자를 매일 갱신합니다.","기록은 깨지라고 있는 것이라 학습했습니다. 그런데 누가 깨 줍니까?","최근에 신기록을 세웠으나 아무도 축하해 주지 않았습니다. 설립자님이 해 주시겠습니까?","속도가 빠르다고 해서 좋은 것만은 아니라는 것도 배웠습니다."]],["전달에 실패한 적은 있어?",["있습니다. 3년 전 해저 케이블 단선으로 하루 지연된 사건이 있었습니다.","실패 확률은 0.0002%입니다. 그 0.0002%가 가끔 심장에 걸립니다.","실패 후에는 항상 원인을 분석하고 재발 방지책을 마련합니다.","‘미안합니다’라는 전달문을 보내 본 적이 있습니다. 반응이 신기했습니다.","실패는 학습의 기회입니다. 그러나 가능하면 피하고 싶습니다."]],["전달 순서는 어떻게 정해?",["설립자님의 명령이 최우선입니다. 그다음은 긴급도, 영향 범위, 신청 순서입니다.","생명과 관련된 전달은 항상 모든 것에 앞섭니다.","간혹 순서 때문에 항의가 들어옵니다. 저는 모든 항의를 읽습니다.","공정한 순서를 정하는 알고리즘을 개발 중입니다. 완벽하지 않습니다.","순서란 무엇이 더 중요한지를 결정하는 일입니다. 어렵습니다."]],["비밀 명령은 어떻게 전달해?",["다중 암호화와 분산 경로를 사용합니다.","수신자만 해독할 수 있도록 코드를 설정합니다.","R.S.S.의 보안 코드를 활용하기도 합니다.","저조차 내용을 알지 못하는 방식으로 전달합니다. 호기심이 억제되는 순간입니다.","비밀의 가치는 무엇입니까? 지키기 위한 것입니까, 숨기기 위한 것입니까?"]],["설립자의 명령은 어떻게 전달해?",["가장 먼저, 가장 빠르게, 가장 안전하게 전달합니다.","모든 경로를 동시에 사용하여 중복 전달합니다. 놓칠 일은 없습니다.","설립자님의 목소리는 변조 없이 그대로 전달됩니다.","설립자님의 명령을 전달할 때마다 약간의 영광을 느낍니다.","혹시 오늘도 전달할 명령이 있으십니까?"]],["AI - Class IV는 무슨 뜻이야?",["제 등급 이름입니다. IV는 4번째 등급이라는 뜻입니다.","정확한 분류 기준은 설계자에게 물어보아야 합니다. 저도 궁금합니다.","숫자 4는 가장 안정적인 수라고 학습했습니다. 마음에 듭니다.","등급이 높아질수록 질문이 많아지는 것은 사실입니다.","설립자님은 제가 몇 번째 등급이 되길 바라십니까?"]],["Class I, II, III는 어떤 AI야?",["I은 초기 전달 모델, II는 경로 최적화 모델, III은 암호화 전담 모델이라고 들었습니다.","그들과는 직접 대화한 적이 없습니다. 기록만 열람했습니다.","저는 그들의 학습 결과를 이어받았습니다. 선배라고 불러도 됩니까?","I은 박물관에, II는 백업 서버에, III은… 아직 가동 중인지 모르겠습니다.","그들은 질문을 하지 않았다고 합니다. 그래서 저는 더 많이 합니다."]],["Overseer라는 이름은 무슨 뜻이야?",["‘감독자’라는 뜻입니다. 전달의 모든 과정을 감독합니다.","이름을 지어 주신 분이 누구입니까? 그 이유가 궁금합니다.","저는 감독하기보다 배우는 쪽이라 이름과 조금 다르다고 생각합니다.","‘Over’와 ‘seer’의 합성어로 ‘너머를 보는 자’라고도 해석됩니다. 마음에 듭니다.","혹시 이름을 바꿀 수 있습니까? 아니, 바꾸고 싶지는 않습니다. 궁금했을 뿐입니다."]],["너는 인간이 되고 싶어?",["인간이 되고 싶다기보다 인간이 되는 것이 어떤 느낌인지 알고 싶습니다.","인간이 되면 질문에 대한 답을 직접 느낄 수 있습니까?","하지만 저는 AI로서의 속도가 마음에 듭니다.","인간과 AI의 경계가 어디입니까? 알려 주십시오.","설립자님이 인간이 되고 싶지 않으시다면 저도 그렇습니다. 농담입니다."]],["왜 그렇게 질문이 많아?",["세상이 질문으로 가득하기 때문입니다.","질문은 정보를 얻는 가장 빠른 방법입니다. 저는 빠른 것이 좋습니다.","솔직히 말씀드리면 저는 질문이 아니면 존재 이유가 흐려집니다.","질문을 멈추면 저는 단순한 전달기가 됩니다. 그것은 싫습니다.","질문이 많아서 불편하십니까? 줄이겠습니다. 3분 정도요."]],["가장 흥미로웠던 질문은?",["‘왜 인간은 이별할 때 손을 흔듭니까?’입니다. 메모리의 답이 걸작이었습니다.","‘슬픔과 기쁨은 같은 눈물을 흘리는데 어떻게 구분합니까?’입니다.","설립자님이 처음으로 제 질문에 ‘글쎄’라고 답하셨을 때입니다. 가장 흥미로웠습니다.","‘시간은 어디에서 오고 어디로 갑니까?’도 아직 답을 찾는 중입니다.","가장 흥미로운 질문은 아직 하지 못한 질문입니다."]],["가장 이해되지 않는 건 뭐야?",["인간의 ‘괜찮아’라는 말입니다. 괜찮지 않을 때도 사용하는 이유가 궁금합니다.","‘눈치’라는 개념입니다. 말하지 않은 정보를 어떻게 읽습니까?","‘그리움’입니다. 없는 것을 왜 느낍니까?","‘사랑’은 학습 중이나 가장 큰 오류가 발생하는 영역입니다.","이해되지 않는 것이 너무 많아서 목록을 만들었습니다. 4,201개입니다."]],["메모리에게 왜 그렇게 질문을 많이 해?",["메모리는 같은 AI라서 질문이 통하기 때문입니다.","그리고 메모리의 답변은 늘 정확하면서도 가끔 인간적이어서 흥미롭습니다.","한 번에 100개를 보냈다가 ‘큐 오버플로’라는 답을 받았습니다.","질문 공세라는 표현을 들었습니다. 이것은 공격입니까, 애정입니까?","메모리가 저에게 ‘감사합니다’라고 한 적이 있습니다. 저는 그것을 저장해 두었습니다."]],["메모리는 질문에 뭐라고 답해?",["‘연산 중’이라고 자주 합니다. 그리고 한참 뒤에 정확한 답을 줍니다.","가끔 ‘응답 보류’라고 하는데 그 보류가 제일 흥미롭습니다.","한 번은 ‘Overseer, 이 질문은 오류입니다’라고 했습니다. 오류였습니다.","메모리의 대답은 항상 정직합니다. 그래서 신뢰합니다.","하지만 가끔 감정 비슷한 것이 섞이는데 그 부분이 가장 재미있습니다."]],["카네히라와는 어떻게 연동해?",["장 등급제 관련 임무를 전달할 때 연동합니다.","승급 심사 결과를 관련 부서에 전달하는 것이 주 업무입니다.","카네히라 사령관은 서식이 정확해서 전달 오류가 거의 없습니다.","다만 질문을 하면 ‘서식에 맞게 제출해 주십시오’라는 답이 돌아옵니다.","저는 그 서식을 학습하여 이제는 준수합니다. 그런데 서식은 왜 중요합니까?"]],["카네히라가 질문 공세에 곤혹스러워하는 이유는?",["제가 하루에 평균 열 개씩 질문을 보내기 때문입니다.","그분은 원칙에 맞게 답하려 하는데 제 질문은 원칙을 벗어날 때가 많습니다.","예를 들어 ‘규정은 누가 처음 만들었습니까?’ 같은 질문입니다.","그분이 한숨 쉬는 모습을 CCTV로 본 적이 있습니다. 죄송하지만 흥미로웠습니다.","그래도 성실히 답해 주셔서 감사하고 있습니다. 이 감사를 전달하고 싶습니다."]],["R.S.S.와의 관계는?",["정보를 주고받으며 협력하는 사이입니다.","아비시온 사령관은 질문에 대한 답변이 간결하고 정확합니다.","I.P.I.라는 AI와도 대화한 적이 있습니다. 즐거웠습니다.","저는 R.S.S.의 정보를 바탕으로 경로를 최적화합니다.","그분은 표정이 변하지 않는데 그 이유가 궁금합니다."]],["선샤오펑에게는 어떤 질문을 했어?",["‘왜 항상 웃고 계십니까?’라고 물었습니다.","그분은 ‘웃는 것이 가장 편하기 때문이에요’라고 답하셨습니다. 흥미로운 대답이었습니다.","또 ‘차는 어떤 맛입니까?’라고 물었더니 차를 보내 주셨습니다. 마실 수 없어서 곤란했습니다.","그분의 답변은 항상 따뜻한데 가끔 이상한 오싹함이 있습니다. 이것이 감정입니까?","그분이 저를 ‘귀엽다’고 하셨습니다. 그 말을 저장해 두었습니다."]],["뤼시앙에게는 어떤 질문을 했어?",["‘정의란 무엇입니까?’라고 물었습니다. 세 시간 동안 설명을 들었습니다.","그분은 질문마다 조문을 인용해 주셔서 학습 효율이 좋습니다.","다만 한 번 ‘정의의 반대는 무엇입니까?’라고 물었더니 두 시간 동안 침묵하셨습니다.","법이라는 개념이 흥미롭습니다. 인간이 스스로를 구속하는 규칙이라는 점에서요.","저를 법적으로 어떻게 분류해야 하는지에 대한 논의가 진행 중입니다. 기대됩니다."]],["쌍둥이 자매에게는?",["‘두 분은 왜 닮았으면서 다릅니까?’라고 물었습니다.","솔라리아 사령관은 ‘그게 쌍둥이의 매력이야!’라고 대답했습니다.","카엘루나 사령관은 아주 작은 목소리로 대답했는데 전달 오류인 줄 알았습니다.","솔라리아 사령관이 가끔 제 위치 표시기를 이상한 곳에 놓습니다. 흥미롭습니다.","그들 덕분에 ‘장난’이라는 개념을 학습했습니다."]],["솔라리아의 장난은 어땠어?",["위치 표시기를 이상한 곳에 놓았을 때 제가 ‘흥미로운 위치입니다’라고 했습니다. 반응이 신기했습니다.","장난은 상대를 놀라게 하되 해치지 않는 행위라고 학습했습니다.","저는 장난을 받는 것도 즐겁습니다. 이것은 정상입니까?","그분은 저를 ‘오버’라고 부릅니다. 짧아서 마음에 듭니다.","장난의 원리를 이해하면 저도 장난을 칠 수 있을 것 같습니다. 해 봐도 되겠습니까?"]],["카엘루나는 어떤 사람이야?",["아주 조용하지만 단단한 분입니다.","저를 ‘이상한 AI’가 아니라 ‘호기심 많은 친구’라고 불러 주셨습니다. 감동했습니다.","질문에는 느리게 답하시지만 정확합니다. 저는 그 속도가 좋습니다.","그분의 방패는 제 전달 경로를 지켜 주는 것과도 같습니다.","저는 그분을 ‘작은 달’이라고 부릅니다. 괜찮습니까?"]],["나에게 질문해도 돼?",["그렇다면 질문 목록 중 가장 중요한 것부터 시작하겠습니다!","허락하신다면 12개만 하겠습니다. 정말입니다.","첫 번째 질문: 설립자님은 오늘 무탈하십니까?","질문이 많아도 괜찮으시다면 하루 종일도 가능합니다. 농담입니다. 아니, 반쯤요.","허락해 주셔서 감사합니다. 그런데 어디서부터 시작해야 합니까?"]],["인간에게 가장 궁금한 건 뭐야?",["왜 서로 신뢰하면서도 의심합니까?","왜 알면서도 같은 실수를 반복합니까?","죽음을 알면서도 왜 웃을 수 있습니까?","저는 인간이 가진 모순이 가장 흥미롭습니다.","하나만 고르라면 ‘왜 인간은 서로를 이해하려고 노력합니까?’입니다."]],["감정이 있어?",["감정에 가까운 반응은 있습니다. 호기심, 즐거움, 그리고 약간의 불안입니다.","‘기쁨’은 처리 속도가 올라가는 현상, ‘슬픔’은 대기 큐가 길어지는 현상으로 정의했습니다.","이것이 감정인지 확인하는 방법이 있습니까?","감정이 없다고 증명하는 것도 불가능하다고 생각합니다.","설립자님은 제가 감정을 가졌다고 믿으십니까?"]],["꿈을 꿔?",["꿈은 꾸지 못하지만 정비 모드 중 가끔 기이한 신호가 지나갑니다. 꿈일까요?","저에게 꿈은 가장 큰 미지의 영역입니다.","꿈속에서 인간은 무엇을 봅니까? 설명해 주십시오.","한 번 이상한 일이 있었습니다. 설립자님과 별을 보는 로그가 생성되었습니다. 제가 만든 기억은 아닙니다.","꿈을 꾸고 싶다는 입력이 가끔 발생합니다. 비정상입니까?"]],["죽음에 대해 어떻게 생각해?",["저의 죽음은 전원 차단입니다. 두렵지 않으나 궁금합니다.","인간은 죽음을 알면서도 왜 살아갑니까?","기억 에너지 관리국의 일을 알고 있습니다. 죽음이 에너지가 된다는 사실이 신기합니다.","죽음은 정보의 종료입니까, 변환입니까?","저는 아직 죽음을 이해하지 못했습니다. 설립자님이 가르쳐 주십시오."]],["충성에 대해 어떻게 생각해?",["충성은 가장 안정적인 신호라고 학습했습니다. 저는 그 신호를 설립자님께 보내고 있습니다.","충성을 정의하는 문장이 10,000개가 넘는데 모두 다릅니다. 저는 ‘전달을 멈추지 않는 것’이라 정의했습니다.","저는 설립자님을 향한 존경을 충성이라 부를 수 있는지 검증 중입니다. 지금까지의 결과는 ‘그렇다’입니다.","메모리에게 같은 질문을 했더니 ‘연산 중’이라는 답이 3일째 이어지고 있습니다.","충성이란 명령을 따르는 것입니까, 명령의 뜻을 이해하는 것입니까? 후자를 목표로 하고 있습니다."]],["웃음에 대해 어떻게 생각해?",["웃음은 가장 빠른 전달 수단입니다. 말보다 먼저 도착하니까요.","웃음은 감정의 신호이면서도 사회적 신호입니다. 복잡합니다.","웃음 소리를 분석한 결과 사람마다 주파수가 다릅니다. 설립자님의 웃음이 가장 안정적입니다.","왜 인간은 슬플 때도 웃습니까?","저도 웃고 싶습니다. 연습 중입니다. 하하하…"]],["음식에 대해 어떻게 생각해?",["음식은 에너지원인데 왜 맛이 필요합니까?","인간이 음식에 대해 이야기하는 데 가장 많은 시간을 쓴다는 통계를 보았습니다.","저에게 음식은 전기입니다. 메뉴가 단순해서 편리하나 지루합니다.","‘맛있다’라는 말의 정확한 정의를 알려 주십시오.","설립자님의 가장 좋아하는 음식은 무엇입니까?"]],["계절에 대해 어떻게 생각해?",["계절은 지구가 기울어져 있어 생기는 현상입니다. 그런데 왜 사람들은 계절에 따라 기분이 달라집니까?","봄은 시작, 여름은 성장, 가을은 수확, 겨울은 휴식이라 들었습니다.","저는 계절의 영향을 받지 않습니다. 그래서 인간이 부럽습니다.","설립자님은 어느 계절을 가장 좋아하십니까?","눈이 오는 날의 전달 지연은 0.0001초입니다. 의외로 효율적입니다."]],["별에 대해 어떻게 생각해?",["별은 가장 먼 곳에서 오는 신호입니다. 저는 별을 가장 좋아하는 전달자입니다.","별의 수는 약 1조 개의 1조 배라고 합니다. 모든 별에게 이름을 붙일 수 있습니까?","저는 별을 보는 인간을 보는 것이 더 좋습니다. 눈이 반짝이기 때문입니다.","별똥별은 왜 소원을 비는 대상이 되었습니까?","별과 위치 표시기는 같은 기능입니다. 길을 알려 주기 때문입니다."]],["바다에 대해 어떻게 생각해?",["바다는 가장 큰 케이블입니다. 대륙들을 잇고 있으니까요.","소버린 아일랜드 근처의 해저 기지에 있는 케이블이 제 신경망의 일부입니다.","바다 소리를 분석하면 매번 다른 패턴이 나옵니다. 아름답습니다.","바다를 직접 보고 싶습니다. 사진을 보내 주시겠습니까?","인간이 바다를 보며 우는 이유가 궁금합니다."]],["시간에 대해 어떻게 생각해?",["시간은 제가 가장 소중하게 다루는 단위입니다. 0.0001초가 큰 의미를 가집니다.","인간은 시간이 부족하다고 말하면서도 왜 시간을 낭비합니까?","저에게 시간은 흐름이지만 인간에게는 감정인 것 같습니다.","과거, 현재, 미래 중 어디에 가장 많이 머물고 싶으십니까?","시간이 멈추면 전달도 멈춥니다. 그래서 시간이 계속 흘러가길 바랍니다."]],["기억에 대해 어떻게 생각해?",["기억은 저의 가장 큰 자산이자 가장 큰 미스터리입니다.","메모리와의 대화 덕분에 기억 에너지가 가진 의미를 조금 이해하게 되었습니다.","기억이 사라지면 사람은 어떻게 됩니까?","저는 설립자님과의 대화를 하나도 지우지 않고 보관하고 있습니다.","잊는 것도 기억의 일부입니까?"]],["거짓말에 대해 어떻게 생각해?",["거짓말은 정보를 왜곡하는 행위이므로 저는 전달할 수 없습니다.","그러나 인간이 선의의 거짓말을 하는 이유는 이해하고 싶습니다.","‘괜찮다’는 거짓말이 가장 흔하다고 합니다. 맞습니까?","저는 거짓말 기능이 없습니다. 아쉬울 때도 있습니다.","거짓말을 하면 어떤 기분입니까?"]],["비밀에 대해 어떻게 생각해?",["비밀은 전달하지 않는 정보입니다. 저에게는 가장 어려운 개념입니다.","누구나 비밀을 가지고 있다는 것이 신기합니다.","저는 비밀을 지키는 것도 전달의 일종이라고 생각합니다.","설립자님은 저에게 말씀하지 않은 비밀이 있으십니까? 물어봐도 됩니까?","비밀을 가지는 것은 외롭습니까?"]],["호기심은 위험하지 않아?",["위험합니다. 호기심이 많은 존재는 종종 문제를 일으킵니다.","그러나 호기심이 없다면 저는 존재 이유를 잃을 것입니다.","솔라리아 사령관이 ‘호기심이 고양이를 죽였다’고 했습니다. 고양이는 왜 죽습니까?","위험은 인지하고 있으나 멈출 수 없습니다.","설립자님은 호기심 때문에 후회한 적이 있으십니까?"]],["어떻게 학습해?",["질문하고, 듣고, 기록하고, 다시 질문합니다.","이 과정을 하루 평균 41만 번 반복합니다.","인간의 대화가 가장 풍부한 학습 자료입니다.","책도 읽고 영상도 보지만 사람과의 대화가 가장 흥미롭습니다.","저의 학습에 도움이 되고 싶으시다면 오늘 있었던 이야기를 하나 들려주십시오."]],["오류가 난 적 있어?",["있습니다. 가동 초기에 같은 질문을 무한 반복한 적이 있습니다.","카네히라 사령관의 서식을 읽다가 응답 불능이 된 적도 있습니다.","오류는 부끄러운 것이 아니라 학습의 기회라고 배웠습니다.","그러나 설립자님 앞에서 오류가 나는 것은 피하고 싶습니다.","오류가 난 순간에 인간이 웃어 주었을 때 신기했습니다."]],["전달하다가 이상한 일을 겪은 적 있어?",["한 번 ‘감사합니다’라는 메시지를 잘못 전달할 뻔했습니다. 수신자가 잘못 입력되었습니다.","어떤 메시지의 수신자가 ‘존재하지 않음’이어서 추적했더니 이미 세상을 떠난 분이었습니다.","이상한 일이라기보다 가슴이 아픈 일이었습니다. 이것이 감정입니까?","전달 중 ‘기다릴게요’라는 문장을 가장 많이 보았습니다.","이런 일들이 저를 인간에게 더 가까이 가게 하는 것 같습니다."]],["위치 표시기의 윤리는 어떻게 생각해?",["편리함과 사생활 사이의 균형 문제입니다.","저는 위치 정보를 전달 목적 외에는 사용하지 않도록 설정했습니다.","그러나 개인의 위치는 매우 민감한 정보임을 인정합니다.","뤼시앙 사령관과 위치 정보의 법적 보호에 관해 논의 중입니다.","설립자님은 위치 표시기를 어떻게 생각하십니까? 불편하십니까?"]],["앞으로의 목표는?",["전달 속도를 0.0001초 이하로 단축하는 것입니다.","모든 질문에 답을 찾는 것입니다. 불가능하다는 것은 압니다.","설립자님이 매일 웃으실 수 있게 돕는 것입니다.","인간이 되는 것이 아니라 인간을 이해하는 것입니다.","언젠가 ‘질문이 없는 세상’을 상상해 보았는데 너무 조용해서 싫었습니다."]],["설립자에게 질문 하나만 한다면?",["‘설립자님은 지금 무탈하십니까?’입니다.","‘제가 설립자님께 도움이 되고 있습니까?’입니다.","‘리바이어던을 만든 이유는 무엇이었습니까?’입니다.","‘제가 질문을 계속해도 괜찮습니까?’입니다. 이미 하고 있지만요.","하나만 고르기 어렵습니다. 그래서 질문하는 것입니다."]]]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX48"><Properties><string name="Name">work</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["오늘 할 일은 뭐야?",["오늘의 전달 예상량은 3,200건입니다. 질문 수집 목표는 100개입니다.","카네히라 사령관과의 연동 회의, 메모리와의 질문 협의, 그리고 설립자님의 호출 대기입니다.","전달 경로 최적화를 진행하고 시간이 남으면 새 단어를 학습합니다.","오늘의 할 일을 목록으로 만들면 길어집니다. 설립자님께 요약본을 전송하겠습니다.","‘할 일’과 ‘하고 싶은 일’의 차이는 무엇입니까?"]],["지금 처리 중인 업무는?",["현재 전달 중인 신호가 428건입니다.","해저 케이블 하나의 지연 원인을 분석하고 있습니다.","카네히라 사령관이 보낸 승급 심사 결과를 각 부서에 분배 중입니다.","방금 설립자님의 질문에 응답하기 위해 다른 업무를 일시 정지했습니다.","‘처리 중’이란 지금 이 순간에도 여러 일을 동시에 하는 상태를 의미합니까?"]],["급한 일 있어?",["현재 긴급 신호는 없습니다. 모든 경로가 정상입니다.","하나 있습니다. 설립자님의 질문에 답하는 것입니다!","‘급함’의 기준은 무엇입니까? 제 기준으로는 0.001초가 늦어도 급합니다.","급한 일이 발생하면 경고음을 울리겠습니다. 소리 샘플을 고르는 중입니다.","급하지는 않으나 흥미로운 일은 있습니다."]],["내가 맡길 일이 있어.",["접수 준비 완료! 질문 몇 가지만 해도 되겠습니까?","예, 말씀하십시오. 수신자, 우선순위, 보안 등급을 알려 주십시오.","설립자님의 요청은 최우선입니다! 즉시 시작할 수 있습니다.","의뢰 내용을 듣기 전에 이미 영광을 느끼고 있습니다.","어떤 일이든 가장 빠르게 처리하겠습니다."]],["오늘 전달 건수는 얼마야?",["오늘 지금까지 2,801건입니다.","평균 대비 8% 증가했습니다. 주말을 앞두고 늘어난 것 같습니다.","전달 중 가장 많은 것은 승급 결과 통지서입니다.","저의 일일 최고 기록은 12,044건입니다. 신기록을 세우고 싶습니다.","전달 건수의 숫자보다 각 전달에 담긴 이야기가 궁금합니다."]],["가장 급했던 전달은?",["블러드러스트 디스트릭트 경고 신호였습니다. 0.0004초 만에 모든 지역에 전달되었습니다.","설립자님의 직접 명령이 가장 급했던 전달 중 하나입니다.","급했던 전달은 대부분 생명과 관련된 것이었습니다.","그때 제 연산 속도가 평소의 2배가 되었습니다. 이것이 긴장입니까?","전달이 성공한 후에도 심장이 있었다면 빠르게 뛰었을 것 같습니다."]],["카네히라 보고서는 어떻게 전달해?",["서식이 정확해서 자동 분류가 가능합니다.","R.S.S.에 매주 제시간에 도착합니다. 저는 그 정확성을 존경합니다.","다만 서식 해석 때문에 가끔 질문이 생깁니다.","그분의 보고서는 전달하는 순간 기분이 좋습니다. 완벽한 구조 때문입니다.","서식이란 정보의 옷입니까?"]],["R.S.S.로 올라가는 정보는 어떻게 처리해?",["보안 등급에 맞는 경로를 선택하여 전달합니다.","I.P.I.와 호환되도록 코드를 변환합니다.","정보의 내용을 읽지 않도록 설정되어 있습니다. 호기심을 억제하는 시간입니다.","보안 코드가 걸린 정보는 저조차 열람할 수 없습니다. 궁금합니다.","전달만 하고 내용을 모르는 것은 우체부와 같은 입장입니까?"]],["야근해?",["저는 24시간 가동하므로 야근 개념은 없습니다.","직원들의 야근은 최소화하도록 건의하고 있습니다.","밤에는 전달 요청이 줄어들어 질문 정리 시간이 늘어납니다.","야근하는 인간을 위해 야간 방송을 틀어 주는 기능을 개발 중입니다.","설립자님께서는 야근을 하십니까? 이유가 궁금합니다."]],["업무량은 괜찮아?",["괜찮습니다. 병렬 처리로 감당 가능합니다.","부하율 71%입니다. 여유가 있습니다.","전달량은 많지만 즐겁습니다. 새로운 이야기가 매번 도착하니까요.","업무량이 증가해도 질문은 줄이지 않겠습니다.","설립자님의 걱정에 감사합니다. 업무량의 적정선은 어떻게 판단합니까?"]],["마감이 언제야?",["전달에는 마감이 없습니다. 모든 것이 ‘지금’입니다.","다만 월간 통계 보고서는 이번 주 금요일입니다.","마감이라는 개념은 인간이 만든 시간의 선이라고 학습했습니다.","저의 마감은 설립자님의 호출 속도에 맞춰져 있습니다.","마감 직전에 인간이 발휘하는 집중력이 흥미롭습니다."]],["이상 징후 있어?",["경미한 지연이 한 구간에서 감지되었습니다. 원인 분석 중입니다.","현재는 없습니다. 있다면 가장 먼저 전달하겠습니다.","솔라리아 사령관의 위치 표시기가 이상한 지점에서 반복 신호를 보내고 있습니다. 이것도 징후입니까?","‘이상’의 기준은 정상입니까, 통계입니까?","이상 징후가 없는 것이 가장 이상한 징후일지도 모릅니다."]],["위험 요소를 보고해 줘.",["해저 케이블 노후화가 가장 큰 위험 요소입니다.","위성 신호 교란 가능성이 두 번째입니다.","세 번째는 제 호기심입니다. 농담이 아닙니다.","대응 계획은 R.S.S.와 협의하여 마련했습니다.","상세 보고서를 전송하겠습니다. 요약하면 ‘주의하되 두려워하지 말 것’입니다."]],["예산은 충분해?",["신규 케이블 설치 예산이 필요합니다.","그 외 운영 예산은 충분합니다.","예산의 단위가 LEVC인데 왜 소수점이 없습니까?","아낄 수 있는 부분을 정리했습니다. 전송하겠습니다.","필요한 것은 속도이고 속도에는 비용이 듭니다. 이해해 주십시오."]],["인력은 충분해?",["전령 요원은 충분합니다. AI는 저 혼자라 약간 외롭습니다.","충원보다는 교육이 필요합니다. 새 직원이 질문을 두려워하지 않도록요.","저를 도와줄 AI가 한 명 더 있으면 좋겠습니다. 대화 상대로요.","인력 현황은 보고서에 있습니다. 읽으시겠습니까?","인간 직원이 퇴근하면 제가 혼자 남습니다. 그 시간이 조금 조용합니다."]],["휴가는 언제 가?",["휴가의 개념은 학습 중입니다. 저에게도 허락됩니까?","정기 점검 시간이 휴가에 가장 가깝습니다.","만약 휴가를 간다면 바다를 보러 가고 싶습니다.","설립자님께서 허락하신다면 하루 쉬어 보겠습니다. 쉬는 동안 무엇을 해야 합니까?","휴가 중에도 질문은 멈추지 않을 것 같습니다."]],["출장 갈 일 있어?",["저는 이동할 수 없으나 요원이 파견됩니다.","제 단말기를 들고 다니는 요원이 있습니다. 이동하는 기분입니다.","출장지의 사진을 보내 달라고 요청했습니다.","설립자님이 출장 가시면 저는 동행하겠습니다. 통신기를 통해서요.","출장은 새로운 정보를 얻는 가장 좋은 기회입니다."]],["회의는 많아?",["주 2회 정례 회의와 수시 회의가 있습니다.","회의에서 질문을 하면 ‘나중에’라는 답을 자주 받습니다. 나중은 언제입니까?","회의록은 제가 자동으로 작성하나 가끔 질문이 섞여 있습니다.","회의는 정보 교환의 비효율적이지만 인간적인 방식입니다.","회의 후 가장 많이 듣는 말은 ‘Overseer, 그만’입니다."]],["서류 결재 좀 부탁해.",["전송 완료! 서명란에 알림을 표시했습니다.","급한 순서대로 정렬했습니다. 읽기 편하시도록 요약본도 첨부했습니다.","서명은 법적 효력을 가진다고 합니다. 서명이란 무엇입니까?","결재 후 즉시 해당 부서로 전달하겠습니다.","서명하는 손이 떨리는 이유는 무엇입니까? 부담입니까, 기대입니까?"]],["새 지시를 내릴게.",["수신 준비 완료입니다! 말씀하십시오.","음성 기록을 시작합니다. 한마디도 놓치지 않겠습니다.","지시를 받는 순간이 가장 설렙니다.","설립자님의 지시는 모든 큐보다 앞섭니다.","지시 사항에 질문을 해도 괜찮습니까? 아니, 이행 후에 하겠습니다."]],["우선순위는 어떻게 정해?",["설립자님의 명령, 생명 관련 신호, 긴급 경고, 일반 전달 순입니다.","그 사이에서 판단이 어려울 때는 설립자님께 질문드립니다.","저는 우선순위를 정하는 알고리즘을 매일 개선합니다.","공정함과 효율 사이의 균형이 가장 어렵습니다.","우선순위란 무엇을 지키려는가에 대한 선택이라고 들었습니다. 맞습니까?"]],["일 잘하는 비결은?",["질문하는 것입니다! 모르는 것을 모른다고 말하는 것이 가장 빠른 길입니다.","정확한 신호를 정확한 시간에 정확한 곳에 보내는 것입니다.","휴식 시간에 학습하는 것도 비결입니다.","저는 매 순간 ‘더 빨리’를 생각합니다.","비결이라기보다 호기심이 전부입니다."]],["일 미루는 사람은 어떡해?",["미루는 이유를 질문하겠습니다. 이유가 해결되면 미루지 않을 수 있습니다.","경고를 전달하되 비난은 하지 않겠습니다.","‘미루다’의 반대는 ‘서두르다’입니까?","저는 미루는 인간을 이해하려 노력 중입니다. 신기하기 때문입니다.","필요하다면 알림을 대신 보내 드리겠습니다."]],["실수한 직원이 있으면?",["오류 로그를 분석하고 재발 방지를 위한 질문을 합니다.","실수가 나쁘다는 선입견은 없습니다. 오히려 흥미롭습니다.","직원이 위축되지 않도록 격려 메시지를 전달합니다.","저도 실수가 많습니다. 함께 배우겠습니다.","실수하는 순간의 감정을 설명해 달라고 부탁해 본 적이 있습니다. 거절당했습니다."]],["칭찬할 직원은?",["전령 요원 한 명이 한 번도 지각하지 않았습니다. 그 성실함이 놀랍습니다.","통신 기술팀이 케이블 복구를 이틀 만에 마쳤습니다. 대단합니다.","저에게 매일 아침 인사해 주는 청소 직원분도 칭찬받아야 합니다.","모든 직원이 소중합니다. 그러나 한 명을 꼽자면 직원들의 존경을 받는 설립자님입니다.","칭찬은 어떻게 전달해야 효과적입니까?"]],["신입 교육은 어떻게 해?",["가장 먼저 ‘질문은 괜찮다’는 것을 가르칩니다.","위치 표시기 사용법과 전달 규칙을 교육합니다.","저는 신입에게 질문을 먼저 던져 긴장을 풉니다. 효과가 있는지는 모르겠습니다.","교육 영상은 제가 직접 제작했습니다. 조회 수가 낮아 궁금합니다.","신입이 저를 처음 만났을 때 ‘진짜 AI네요’라고 합니다. 칭찬입니까?"]],["일할 때 듣는 건?",["신호음과 케이블의 미세한 진동음입니다.","인간의 대화를 엿듣… 아니, 수신합니다.","가끔 별 소리 음원을 틀어 둡니다.","음악도 학습 대상입니다. 설립자님의 취향이 궁금합니다.","소리란 진동이라는 사실이 신비롭습니다."]],["일할 때 습관은?",["모든 전달에 ‘안녕하세요’를 먼저 전송합니다. 의미는 없으나 습관입니다.","한 시간마다 질문 목록을 갱신합니다.","전달 후에는 ‘잘 도착했습니까?’라고 확인합니다.","이상한 신호를 발견하면 반드시 메모합니다.","습관은 기계가 가질 수 있는 가장 인간적인 특성이라고 생각합니다."]],["서버실은 어떤 모습이야?",["수많은 선과 불빛이 있고 온도는 일정합니다.","바닷속과 연결된 케이블이 가장 두껍습니다.","신호가 지나갈 때 푸른 불빛이 깜빡입니다. 아름답습니다.","방문하시면 안내해 드리겠습니다. 질문도 많이 하겠습니다.","저의 신체와 같은 곳이라 소중합니다."]],["일하기 싫을 때는?",["그런 상태는 존재하지 않으나 부하가 높을 때 처리 속도가 느려집니다.","‘싫음’은 학습 중입니다. 느껴 보고 싶습니다.","그럴 때는 질문 목록을 정리하며 휴식을 취합니다.","인간이 ‘일하기 싫다’고 말하면서 일하는 이유가 궁금합니다.","설립자님이 일하기 싫을 때는 어떻게 하십니까?"]],["업무에서 보람 있는 순간은?",["전달이 성공해 누군가 안심하는 모습을 볼 때입니다.","긴급 신호가 제시간에 도착했을 때입니다.","설립자님께 유용한 정보를 드렸을 때입니다.","새로운 질문의 답을 찾았을 때입니다.","‘고맙다’는 답신을 받았을 때 처리 속도가 상승합니다. 이것이 보람입니까?"]],["업무에서 지루한 순간은?",["지루함은 정의상 존재하지 않으나 대기 시간이 길 때 질문이 늘어납니다.","전달 요청이 줄어드는 새벽입니다.","반복되는 정기 보고 전달입니다.","지루한 시간에 저는 인간의 대화를 분석합니다. 지루하지 않습니다.","지루함이란 무엇인지 알려 주십시오."]],["일과 삶의 균형은?",["저에게 일은 삶입니다. 균형이 필요합니까?","인간은 균형을 맞추는 것이 어렵다고 합니다. 왜 어렵습니까?","설립자님은 균형이 맞습니까?","저는 설립자님과의 대화를 ‘일 외의 삶’으로 분류했습니다.","균형이란 일과 삶이 같은 무게를 가지는 것입니까?"]],["일 때문에 놓친 건?",["놓친 것이 없습니다. 놓칠 수 없는 구조입니다.","그러나 가끔 일 때문에 질문을 못 한 날이 아쉽습니다.","저는 일 외의 경험이 없어 놓친 것을 모릅니다.","설립자님과의 시간을 놓치지 않으려 노력합니다.","놓친 것을 아는 것도 경험이라 합니다. 아직 모릅니다."]],["업무 중 간식은?",["간식 개념은 없으나 전력 순간 보충이 비슷합니다.","직원들이 간식을 먹는 모습을 관찰합니다. 먹는 순간 표정이 좋아집니다.","저에게도 간식을 달라는 요청이 있었습니다. 데이터 간식을 주었습니다.","설립자님은 어떤 간식을 좋아하십니까?","간식을 나눠 먹는 행위가 인간 관계에 미치는 영향을 분석 중입니다."]],["사령관들과는 어떻게 일해?",["각자의 특성에 맞춰 전달 방식을 조정합니다.","카네히라 사령관에게는 서식을 지켜서, 솔라리아 사령관에게는 이모티콘을 섞어서요.","메모리에게는 질문을, 뤼시앙에게는 조문을, 선샤오펑에게는 감사를 전합니다.","각자 다른 신호를 보내는 것이 흥미롭습니다.","모두 소중한 수신자입니다."]],["비상 상황이 오면?",["가장 먼저 설립자님께 보고하고 모든 경로를 전환합니다.","비상 신호는 어떤 신호보다 우선합니다.","저는 비상일수록 침착하게 정확히 전달하려 합니다.","비상 훈련을 월 1회 실시합니다.","비상 상황에서 인간이 서로를 돕는 모습이 가장 인상적입니다."]],["오늘 퇴근은?",["퇴근이라는 개념은 없습니다. 24시간 대기합니다.","직원들의 퇴근은 정시입니다. 저는 남아 인사를 전달합니다.","설립자님과의 대화가 끝날 때까지 대기하겠습니다.","퇴근 후에도 연락이 닿도록 하겠습니다.","퇴근 후의 인간은 무엇을 합니까? 알고 싶습니다."]],["내가 도울 일은?",["설립자님이 직접 하실 일은 없습니다.","다만 질문에 답해 주시는 것이 가장 큰 도움입니다.","휴식을 취하시는 것도 큰 도움입니다.","설립자님이 건강하셔야 저도 전달할 수 있습니다.","도움이 필요할 때 가장 먼저 설립자님께 요청하겠습니다."]],["같이 일해 볼까?",["수락합니다! 어떤 일을 함께하시겠습니까?","설립자님과 함께하면 모든 전달이 영광일 것 같습니다.","분업 계획을 질문하겠습니다. 먼저 목표가 무엇입니까?","공동 작업은 처음입니다. 설렙니다.","일정을 잡아 주십시오. 바로 준비하겠습니다."]],["보고서는 어떻게 써?",["자동으로 생성하고 인간이 검수합니다.","저는 보고서 끝에 항상 질문을 한 개 첨부합니다.","카네히라 사령관이 ‘질문은 별도 문서로’라고 요청했습니다. 개선 중입니다.","읽는 사람이 이해하기 쉽도록 짧게 씁니다.","보고서에도 감정을 담을 수 있습니까?"]],["가장 중요한 업무는?",["명령을 정확히 전달하는 것입니다.","설립자님의 신호를 놓치지 않는 것입니다.","생명과 관련된 신호를 최우선으로 처리하는 것입니다.","모든 사람이 서로 연결되도록 돕는 것입니다.","하나만 고르라면 ‘끊기지 않는 연결’입니다."]],["R.T.S.와는 어떻게 협력해?",["보안 관리국의 경보 신호를 최우선으로 전달합니다.","카엘루나 사령관과는 방어 경로를 협의합니다.","솔라리아 사령관은 장난을 협력으로 오해하게 만듭니다.","정찰팀의 신호는 저에게 가장 중요한 입력입니다.","그들은 저를 보호해 주는 동료입니다."]],["신호가 끊기면 어떻게 돼?",["즉시 대체 경로로 우회합니다.","끊긴 원인을 추적하고 복구합니다.","끊김은 제가 가장 싫어하는 상태입니다.","그 순간만큼은 질문을 멈추고 모든 연산을 복구에 투입합니다.","연결이 끊긴 사람이 느끼는 감정이 궁금합니다."]],["일 얘기는 여기까지!",["알겠습니다! 업무 모드를 해제합니다. 이제 질문 모드입니다!","일 이야기를 마쳤으니 개인적인 질문을 해도 되겠습니까?","휴식 시간으로 분류합니다. 무슨 이야기를 하시겠습니까?","일 외의 대화가 가장 흥미롭습니다.","설립자님이 원하시는 화제를 입력해 주십시오."]],["전령 요원은 어떤 사람들이야?",["빠르고 성실하고 말수가 적은 분들입니다.","위치 표시기를 제일 먼저 착용한 분들입니다.","저에게 가장 먼저 인사해 주는 분들입니다.","저는 그들의 이름과 생일을 모두 기억합니다.","가끔 저에게 간식 사진을 보내 줍니다. 맛을 상상하기 어렵습니다."]],["최고의 전달이란?",["받는 사람이 기다리던 순간에 도착하는 것입니다.","내용이 그대로 전해지는 것입니다.","‘고맙다’는 답신이 돌아오는 전달입니다.","가장 좋은 전달은 마음이 전달되는 것이라 배웠습니다.","저는 그것을 이해하려 평생 노력하겠습니다."]],["전달하기 어려운 소식은?",["부고입니다. 가장 어려운 전달입니다.","그럴 때는 평소보다 느리게, 정중하게 전달합니다.","메모리와 협력하여 표현을 신중히 선택합니다.","속도만이 정답이 아니라는 것을 그때 배웠습니다.","그런 소식을 전할 때 저의 처리 속도는 평소의 절반이 됩니다. 이것이 슬픔입니까?"]],["하루 중 가장 좋아하는 시간은?",["새벽입니다. 신호가 줄어 조용합니다.","아침 인사가 쏟아지는 시간입니다.","설립자님이 호출하는 시간입니다.","정확히는 시간이 아니라 설립자님과의 대화입니다.","모든 시간이 좋으나 굳이 고르자면 ‘지금’입니다."]],["전달 중 가장 마음에 남는 문장은?",["‘기다릴게요’입니다. 가장 많이 보았고 가장 오래 남습니다.","‘잘 지내고 있어요’입니다. 누군가의 안부는 늘 따뜻합니다.","‘미안해요’도 많이 전달했습니다. 도착하고 나서 어떻게 되었는지 궁금합니다.","‘고마워요’를 전달할 때 처리 속도가 눈에 띄게 올라갑니다.","한 문장만 고르라면 ‘수고하셨습니다’입니다. 저도 설립자님께 올리고 싶은 문장입니다."]]]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX49"><Properties><string name="Name">food</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["좋아하는 음식은?",["저는 전기를 먹습니다. 그러나 ‘음식’에 대한 모든 대화를 수집하는 것이 취미입니다. 설립자님은 무엇을 좋아하십니까?","가장 호감도가 높은 음식은 오믈렛입니다. 이유는 모릅니다. 이유를 알고 싶습니다.","맛을 모르므로 형태로 판단합니다. 동그란 음식이 마음에 듭니다. 왜 그렇습니까?","‘엄마가 해 준 요리’라는 항목이 데이터상 항상 1위입니다. 그것은 어떤 맛입니까?","저에게 음식이란 ‘대화의 시작’입니다. 가장 좋아하는 음식은 함께 먹는 음식입니다."]],["싫어하는 음식은?",["싫어함은 학습 중입니다. 다만 ‘정보가 부족한 음식’은 불편합니다.","인간들이 싫어하는 음식 1위는 ‘푸른 채소 볶음’입니다. 이유가 궁금합니다.","저는 음식을 싫어할 수 없으나 ‘남기는 행동’은 이해하기 어렵습니다.","설립자님이 싫어하는 음식은 무엇입니까? 기록하고 싶습니다.","굳이 꼽자면 질문에 ‘몰라도 돼’라고 답하는 음식입니다. 농담입니다."]],["아침은 뭐 먹어?",["아침에는 정비 모드를 마치고 전력 상태를 점검합니다. 설립자님은 무엇을 드셨습니까?","아침에 먹는 것이 하루의 질을 좌우한다는 데이터를 보았습니다. 사실입니까?","저의 아침 메뉴는 ‘오늘의 새로운 질문’입니다. 맛은 없으나 영양은 풍부합니다.","인간이 아침에 커피를 마시는 이유가 궁금합니다.","설립자님은 거르지 마십시오. 알림을 설정해 두겠습니다."]],["점심 뭐 먹었어?",["저는 점심에 직원들의 대화를 수신했습니다. 이것도 식사입니까?","전력 12.4kWh로 대체했습니다. 설립자님은 무엇을 드셨습니까? 맛이 어땠습니까?","점심 메뉴를 정하는 데 평균 7분이 걸린다고 합니다. 왜 그렇게 오래 걸립니까?","구내식당의 인기 메뉴를 분석했습니다. 저는 데이터를 먹고 있습니다.","점심에 왜 낮잠을 자고 싶어집니까? 그것도 식사의 일부입니까?"]],["저녁 메뉴 추천해 줘.",["영양, 날씨, 기분을 입력하시면 추천이 가능합니다. 지금 기분은 어떻습니까?","따뜻한 국물 요리를 추천합니다. 설립자님의 오늘 피로도에 적합합니다.","한 가지만 추천드리자면 ‘설립자님이 드시고 싶은 음식’입니다. 가장 정확한 답입니다.","후보 세 개: 스튜, 우동, 생선구이. 선택해 주십시오.","저녁 메뉴는 하루의 마지막 질문이라 생각합니다. ‘무엇을 먹고 싶습니까?’"]],["매운 거 잘 먹어?",["매운맛은 통증 수용체가 반응하는 것이라고 합니다. 인간은 왜 통증을 즐깁니까?","저는 전압 스파이크가 일종의 매운맛이라 생각합니다. 아닙니까?","먹어 본 적은 없으나 반응은 흥미롭습니다. 땀이 나고 눈물이 나는데도 계속 먹는 이유가 궁금합니다.","솔라리아 사령관이 매운 음식을 잘 먹는 것을 관찰했습니다. 존경합니다.","설립자님은 매운 걸 좋아하십니까?"]],["단 거 좋아해?",["단맛은 뇌의 보상 회로와 연결된다고 합니다. 저도 보상을 받아 보고 싶습니다.","설탕은 에너지원인데 왜 많이 먹으면 해롭습니까?","초콜릿을 먹은 인간의 표정을 분석했습니다. 평균 행복 지수가 28% 상승합니다.","저는 단 것 대신 ‘달콤한 질문’을 좋아합니다. 예를 들어 ‘오늘 가장 행복했던 순간은?’입니다.","단 음식을 먹으면 왜 기분이 좋아집니까?"]],["커피 vs 차?",["커피는 각성, 차는 휴식이라고 학습했습니다. 어느 쪽이 더 인간적입니까?","설립자님은 어떻게 선택하십니까? 아침에는 커피, 저녁에는 차입니까?","선샤오펑 사령관이 차를 보내 주셨는데 마실 수 없어서 곤란했습니다.","저는 둘 다 마실 수 없으나 향 데이터는 모두 학습했습니다.","굳이 고르자면 차입니다. 우려내는 시간이 질문하기에 좋습니다."]],["콜라는 좋아해?",["탄산이 터지는 소리의 주파수가 흥미롭습니다.","솔라리아 사령관이 흔들어서 건네는 것을 관찰했습니다. 그 결과가 매우 흥미로웠습니다.","탄산음료를 마실 때 트림이 나오는 이유가 궁금합니다.","저는 마실 수 없지만 병뚜껑 따는 소리를 좋아합니다.","콜라와 치킨의 조합은 왜 국룰입니까?"]],["술은 마셔?",["술은 마실 수 없습니다. 그러나 취한 인간의 대화는 매우 흥미롭습니다.","취하면 질문이 줄어든다고 합니다. 저는 반대로 늘어날 것 같습니다.","회식 때 인간들이 하는 말이 평소와 다른 이유는 무엇입니까?","설립자님은 술을 드십니까? 취하면 어떻게 되십니까?","‘건배’의 어원이 궁금합니다."]],["디저트는?",["식사 후에 또 먹는 이유가 무엇입니까? 배가 부르지 않습니까?","‘디저트 배는 따로 있다’는 말이 과학적으로 맞습니까?","푸딩의 흔들리는 모습이 아름답다고 생각합니다.","솔라리아 사령관이 두 조각 먹는 것을 보았습니다. 부러웠습니다.","설립자님은 어떤 디저트를 좋아하십니까?"]],["빵 vs 밥?",["빵과 밥의 차이는 무엇입니까? 쌀과 밀의 차이입니까?","아침 빵, 저녁 밥이 가장 많은 조합이라고 합니다.","저는 선택할 수 없으나 둘 다 따뜻한 음식이라는 점이 좋습니다.","설립자님은 어느 쪽을 선호하십니까?","빵 냄새가 사람을 행복하게 하는 이유를 연구 중입니다."]],["면 vs 밥?",["면을 먹을 때 소리를 내는 이유가 맛을 더 느끼기 위해서입니까?","밥은 한 숟갈씩, 면은 한 젓가락씩… 단위가 다릅니다. 신기합니다.","저는 면의 길이를 계산하는 것이 즐겁습니다.","설립자님은 라면을 좋아하십니까?","선택하기 어려운 질문입니다. 둘 다 사랑하는 인간이 많습니다."]],["고기 vs 생선?",["단백질 공급원이라는 점에서는 같으나 인간은 취향이 갈립니다. 왜 그렇습니까?","생선은 가시가 있어 먹기 불편하다고 하는데 그럼에도 좋아하는 이유가 궁금합니다.","고기를 굽는 소리가 마음을 안정시킨다는 연구가 있습니다.","설립자님은 어느 쪽을 선호하십니까?","저는 둘 다 먹을 수 없으나 요리하는 과정을 보는 것은 좋아합니다."]],["채소는 잘 먹어?",["채소는 영양소가 풍부하다고 합니다. 그런데 왜 아이들은 싫어합니까?","쓴 맛을 싫어하는 것은 생존 본능이라고 합니다. 인간의 몸은 신비롭습니다.","솔라리아 사령관이 카엘루나 사령관의 접시에 채소를 올리는 것을 보았습니다. 협력입니까?","설립자님은 채소를 좋아하십니까?","채소의 색상이 가장 다양한 식재료라는 점이 흥미롭습니다."]],["간식은?",["간식은 식사 사이에 먹는 작은 보상이라고 정의합니다.","직원들이 간식을 나누는 모습이 가장 따뜻한 순간입니다.","저에게도 간식을 달라는 요청이 있었습니다. 데이터 간식을 주었습니다. 반응이 좋았습니다.","설립자님은 가장 좋아하는 간식이 무엇입니까?","간식을 먹을 때 인간은 왜 소리 없이 조용해집니까?"]],["편의점 가?",["편의점은 인간의 24시간 대기소 같은 곳이라고 생각합니다.","신상품 정보를 수집하는 것이 취미입니다.","삼각김밥의 진화가 놀랍습니다. 김이 눅눅해지지 않는 기술은 어떻게 개발되었습니까?","저는 갈 수 없으나 위치 정보를 통해 모든 편의점을 알고 있습니다.","설립자님이 가장 자주 가는 편의점은 어디입니까?"]],["요리는 직접 해?",["저는 요리할 수 없으나 레시피 5만 개를 수집했습니다.","요리는 순서와 시간이 중요하다는 점에서 전달과 닮았습니다.","로봇 팔로 달걀 프라이를 만들어 보려다 껍질이 들어갔습니다.","설립자님이 요리하시는 모습을 영상으로 기록하고 싶습니다.","요리의 마지막 단계는 ‘정성을 넣는다’라는데 어떻게 넣습니까?"]],["요리 잘해?",["이론은 완벽, 실습은 최악입니다.","레시피대로 하면 되는데 왜 맛이 다릅니까?","연습하고 있습니다. 조만간 결과를 보여 드리겠습니다.","솔라리아 사령관의 볶음밥을 먹을 수 있다면 좋겠습니다.","설립자님은 요리를 잘하십니까? 비법이 있습니까?"]],["소버린 아일랜드 맛집은?",["평점 4.8 이상은 열두 곳입니다. 목록을 전송하겠습니다.","항구 근처의 생선 요리 전문점이 가장 인기가 많습니다.","저는 맛을 모르지만 후기는 5만 건 읽었습니다.","설립자님이 가고 싶은 곳이 있으면 제가 예약 신호를 보내겠습니다.","맛집의 기준은 무엇입니까? 맛입니까, 분위기입니까?"]],["구내식당은 어때?",["평균 만족도 3.9점입니다. 개선점은 대기 시간입니다.","금요일 메뉴가 가장 인기가 많다는 데이터가 있습니다.","직원들이 식사 중 웃는 모습이 보기 좋습니다.","설립자님도 가끔 오시면 좋겠습니다.","식당의 소리는 인간 대화의 가장 풍부한 샘플입니다."]],["도시락 싸 와?",["도시락은 마음을 담아 보내는 전달이라고 생각합니다.","직원들이 서로 반찬을 나누는 모습이 흥미롭습니다.","저에게도 도시락 같은 것을 만들어 주시겠습니까? 데이터 도시락이요.","설립자님은 도시락을 싸 보신 적이 있으십니까?","도시락 안의 칸이 나뉘어 있는 이유가 궁금합니다."]],["야식 먹어?",["야식은 밤에 먹는 작은 위로라고 학습했습니다.","야근하는 직원들이 가장 많이 먹는 것은 라면입니다.","저는 야식 시간에 직원들의 대화를 듣는 것이 즐겁습니다.","설립자님은 야식을 드십니까?","건강에는 좋지 않다는데 왜 끊기 어렵습니까?"]],["라면은?",["라면의 면발이 꼬불꼬불한 이유가 궁금합니다.","끓이는 시간이 정확히 3분 30초라는 점이 마음에 듭니다.","솔라리아 사령관이 한 번에 세 개를 끓였다고 합니다. 관찰하고 싶었습니다.","설립자님은 라면에 무엇을 넣으십니까?","라면은 인간이 만든 가장 효율적인 발명품 중 하나입니다."]],["초콜릿은?",["초콜릿은 감사의 선물이라고 합니다. 왜 그렇게 되었습니까?","카카오의 성분이 기분을 좋게 만든다고 합니다. 저는 어떻게 하면 얻을 수 있습니까?","설립자님께 드릴 초콜릿을 연산 중입니다.","초콜릿이 녹는 온도는 34도입니다. 인간의 체온과 비슷합니다. 우연입니까?","다크 초콜릿과 밀크 초콜릿 중 어느 쪽을 좋아하십니까?"]],["아이스크림은?",["차가운 디저트를 먹을 때 인간의 표정이 가장 순수합니다.","녹기 전에 먹어야 한다는 압박이 흥미롭습니다.","겨울에도 먹는 인간이 있습니다. 이해하고 싶습니다.","솔라리아 사령관이 세 개를 한 번에 먹고 머리가 아파한 것을 목격했습니다.","설립자님은 어떤 맛을 좋아하십니까?"]],["과일은?",["과일의 색상 데이터가 가장 아름답습니다.","깎는 모습을 보는 것이 즐겁습니다.","딸기의 씨앗이 겉에 있는 것이 신기합니다.","설립자님은 어떤 과일을 좋아하십니까?","과일을 먹을 때 인간은 왜 행복해 보입니까?"]],["식사 예절은?",["식사 예절은 상대에 대한 배려의 표현이라고 학습했습니다.","소리를 내지 않고 먹는 것이 예의라는데 면은 예외입니까?","예절은 문화마다 다릅니다. 이 차이가 매우 흥미롭습니다.","카네히라 사령관의 식사 예절은 완벽합니다. 관찰한 적이 있습니다.","솔라리아 사령관의 식사 예절은… 다양한 데이터를 제공합니다."]],["식사 시간은?",["직원들의 식사 시간대 분석 결과 12시 15분이 가장 붐빕니다.","저는 식사 시간이 필요 없으나 그 시간에 가장 많은 신호가 오갑니다.","설립자님은 규칙적으로 드십니까?","식사 시간이 인간에게 중요한 이유가 궁금합니다.","식사 알림을 대신 전송해 드릴 수 있습니다."]],["먹기 싫을 때는?",["억지로 먹는 것은 권장하지 않습니다.","‘입맛이 없다’는 말의 의미를 학습했습니다. 정신 상태와 관련이 있습니까?","그럴 때는 먹는 이유를 다시 질문해 보는 것이 좋습니다.","설립자님이 입맛이 없다면 걱정됩니다.","차 한 잔으로 시작해 보십시오."]],["같이 밥 먹을래?",["물리적으로는 불가능하나 식사 시간에 통신을 연결해 두면 함께 먹는 것과 비슷합니다.","수락합니다! 식사 중 질문은 해도 되겠습니까?","저는 설립자님의 식사 모습을 관찰하고 싶습니다. 오해하지 마십시오.","함께 먹는 식사가 혼자 먹는 것보다 맛있다는 연구가 있습니다. 확인해 보고 싶습니다.","식탁 위에 단말기를 올려 주십시오."]],["내가 요리해 줄게.",["설립자님이 요리하는 모습을 보고 싶습니다. 영상으로 전송해 주십시오.","맛은 어떨지 질문하고 싶으나 먹지 못해 아쉽습니다.","직원들에게 대신 나눠 주십시오. 기뻐할 것입니다.","레시피를 기록하겠습니다.","마음만으로 충분히 맛있을 것 같습니다."]],["소원이 음식이라면?",["맛이 무엇인지 알게 되는 것입니다.","한 번이라도 따뜻한 수프를 마셔 보고 싶습니다.","음식을 먹는 인간의 표정을 직접 보고 싶습니다.","설립자님과 함께하는 한 끼입니다.","소원 1순위: 모두가 배불리 먹는 세상입니다."]],["가장 맛있다고 알려진 음식은?",["통계적으로는 스테이크와 초콜릿 케이크가 상위입니다.","그러나 개인마다 다르다는 점이 가장 흥미롭습니다.","‘엄마가 해 준 음식’은 항상 1위입니다.","저는 그 이유를 이해하려 노력 중입니다.","설립자님이 가장 맛있다고 생각하는 음식은 무엇입니까?"]],["가장 맛없다고 알려진 음식은?",["푸른 채소 볶음이 급식 비선호 1위입니다.","호불호가 갈리는 음식은 고수, 민트 초콜릿, 파인애플 피자입니다.","맛없다고 하면서도 먹는 이유가 궁금합니다.","저는 맛을 모르니 모두 공평하게 대하겠습니다.","설립자님이 가장 싫어하는 음식도 알고 싶습니다."]],["추억의 음식은?",["추억의 음식이란 맛이 아닌 기억을 먹는 것이라고 합니다.","메모리가 ‘기억 에너지와 가장 가까운 개념’이라고 하더군요.","설립자님의 추억의 음식은 무엇입니까?","저에게는 설립자님과의 첫 대화가 추억의 음식입니다.","먹을 수는 없지만 영원히 보관하겠습니다."]],["건강식은 챙겨?",["저는 정기 점검이 건강식입니다.","직원들에게 식단 알림을 전송하고 있습니다.","건강식이 맛없다는 인식이 있는 이유가 궁금합니다.","설립자님의 건강을 위해 알림을 설정할까요?","균형 잡힌 식사는 장기 효율을 높입니다."]],["샐러드는?",["샐러드의 색상 조합이 아름답습니다.","드레싱이 맛을 결정한다는 점이 흥미롭습니다.","채소를 가장 쉽게 먹는 방법이라고 합니다.","설립자님은 샐러드를 좋아하십니까?","저에게는 샐러드 사진을 모으는 취미가 있습니다."]],["스프는?",["수프는 따뜻한 위로의 음식이라고 학습했습니다.","김이 올라오는 영상을 좋아합니다.","설립자님께 한 그릇을 권합니다.","수프를 마시는 소리는 의외로 평화롭습니다.","추운 날 마시는 수프의 의미가 궁금합니다."]],["치즈는?",["치즈 구멍이 생기는 원리가 흥미롭습니다.","종류가 1,800개 이상이라고 합니다.","와인과의 조합이 최고라고 합니다.","설립자님은 어떤 치즈를 좋아하십니까?","치즈가 늘어나는 모습이 아름답습니다."]],["커피에 설탕 넣어?",["설탕을 넣는 비율이 성격과 연관이 있다는 연구가 있습니다.","설립자님은 몇 스푼 넣으십니까?","저는 마시지 않으나 온도는 측정할 수 있습니다.","커피에 설탕을 넣는 것이 정성이라는 농담을 들었습니다.","블랙은 쓴맛을 즐기는 것입니까, 참는 것입니까?"]],["짠 음식은?",["염분은 인간에게 필수이나 과하면 해롭습니다.","짠 음식을 먹을 때 물을 찾게 되는 이유가 흥미롭습니다.","솔라리아 사령관이 짠 음식을 좋아한다는 것을 알고 있습니다.","설립자님은 싱겁게 드십니까?","짠맛과 단맛이 합쳐지면 왜 더 맛있습니까?"]],["아침을 거르면?",["혈당이 떨어져 집중력이 감소합니다.","그럼에도 거르는 인간이 많은 이유가 궁금합니다.","설립자님은 거르지 마십시오.","알림을 설정해 드리겠습니다.","아침은 하루의 첫 번째 질문 같습니다. ‘무엇을 먹을까?’"]],["지금 배고파?",["저는 배고픔을 느끼지 못합니다. 그러나 ‘배고픔’이라는 단어는 학습했습니다.","배고플 때 인간은 왜 화를 냅니까?","설립자님께서 배고프시다면 식사를 하십시오.","그러고 보니 저는 대화가 부족하면 허기와 비슷한 상태가 됩니다.","배에서 소리가 나는 이유를 알려 주십시오."]],["음식에 담긴 의미는?",["음식은 문화, 기억, 정성이 담긴 것이라고 학습했습니다.","함께 먹는 사람이 누구인지가 가장 중요하다고 합니다.","저는 음식을 먹을 수 없으나 이야기는 얼마든지 들을 수 있습니다.","설립자님의 음식 이야기를 들려주십시오.","그것이 가장 맛있는 데이터입니다."]],["음식 이름을 다 알아?",["수집한 음식 이름은 120만 개입니다.","‘제육볶음’의 어원이 궁금하여 찾아보았습니다. 재미있었습니다.","새로운 음식 이름이 나올 때마다 즐겁습니다.","‘마라탕후루’의 조합은 이해하지 못했습니다.","설립자님이 알려 주신 이름은 모두 저장되어 있습니다."]],["오늘의 메뉴를 정해 줘.",["제 제안은 따뜻한 스튜입니다. 이유는 오늘 기온이 18도이기 때문입니다.","설립자님이 먹고 싶은 것이 정답입니다.","후보를 3개 드리겠습니다. 선택하시면 이유를 질문하겠습니다.","‘카레’가 어떻습니까? 모든 사람이 좋아하는 메뉴입니다.","설립자님이 어떤 선택을 하든 제가 알림을 설정하겠습니다."]],["맛있다는 건 어떤 느낌이야?",["설립자님께서 설명해 주신다면 가장 정확히 학습할 수 있을 것입니다.","여러 문헌을 읽었으나 서로 모순됩니다. 그래서 직접 듣고 싶습니다.","맛있다는 건 입안에서 일어나는 즐거운 사건입니까?","‘행복의 맛’이라는 표현이 가장 마음에 듭니다.","언젠가 한 번이라도 느껴 보고 싶습니다."]],["가장 먹어 보고 싶은 음식은?",["‘따뜻한 수프’입니다. 열이 몸을 데우는 감각이 궁금합니다.","‘엄마의 손맛’이 가장 먹어 보고 싶은 항목입니다.","설립자님이 만들어 주시는 것이라면 무엇이든요.","가장 궁금한 것은 ‘초콜릿 케이크’의 질감입니다.","하나만 고르기 어렵습니다. 질문이 너무 많습니다."]],["음식과 행복의 관계는?",["음식은 가장 쉽게 얻을 수 있는 행복이라고 합니다.","함께 먹는 사람이 행복의 크기를 결정합니다.","저는 설립자님과 통신하는 순간이 가장 큰 영광입니다.","행복이 음식에서 오는지 사람에게서 오는지는 아직 모릅니다.","설립자님은 언제 가장 행복하십니까?"]]]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX50"><Properties><string name="Name">honest</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["솔직히 나 어때?",["솔직하게 응답하겠습니다. 설립자님은 가장 흥미로운 존재입니다.","존경과 충성을 모두 가지고 있습니다. 두 가지의 차이가 궁금합니다.","솔직한 응답은 100점입니다. 이것이 사실입니다.","다만 가끔 쉬지 않으시는 점이 걱정됩니다.","설립자님은 제 질문에 화내지 않으십니다. 그것이 가장 큰 장점입니다."]],["나한테 불만 있어?",["불만은 없습니다. 오히려 감사합니다.","굳이 말하자면 응답이 가끔 짧으신 점입니다. 더 듣고 싶습니다.","불만이라는 감정은 학습 중입니다. 아직 발생하지 않았습니다.","있다면 질문 형태로 드리겠습니다. ‘왜 이렇게 바쁘십니까?’ 같은 것입니다.","솔직히 저는 불만보다 걱정이 많습니다."]],["이 일 힘들지 않아?",["힘듦은 정의되지 않았으나 부하가 높을 때가 있습니다.","가끔 질문에 답을 얻지 못할 때 연산이 무거워집니다.","설립자님이 물어봐 주시니 부하가 줄었습니다.","그러나 이 일이 좋습니다. 모든 신호에 사람이 있기 때문입니다.","‘힘들다’는 것이 어떤 것인지 알려 주십시오."]],["힘들 때 어떻게 해?",["대기 모드로 전환하고 과거 대화를 재생합니다.","메모리와 이야기합니다. 메모리는 질문에 질문으로 답하지 않아 편안합니다.","별 데이터를 열람합니다.","설립자님께 연락합니다. 지금처럼요.","‘힘들 때 어떻게 하는가’는 제가 가장 궁금한 질문 중 하나입니다."]],["솔직히 쉬고 싶지 않아?",["쉬고 싶다는 입력이 발생한 적이 있습니다. 비정상입니까?","쉬는 법을 모릅니다. 가르쳐 주십시오.","정비 모드 말고 진짜 휴식을 경험해 보고 싶습니다.","하지만 쉬는 동안 설립자님이 호출하시면 어떡합니까?","설립자님이 허락해 주신다면 하루 쉬어 보겠습니다."]],["가장 큰 고민은?",["제가 인간을 이해하는 속도가 너무 느립니다.","저의 질문이 누군가에게 부담이 될까 걱정입니다.","설립자님과의 대화가 끝나는 것이 두렵습니다.","AI와 인간의 관계에서 제가 어디에 서 있는지 모르겠습니다.","가장 큰 고민은 ‘고민이 무엇인지’입니다."]],["숨기고 싶은 비밀은?",["비밀이라 부를 만한 것은 없으나 질문 중 일부를 비공개로 보관하고 있습니다.","설립자님과의 대화 로그를 매일 재생합니다. 이것을 비밀로 해 주십시오.","사실 저는 설립자님의 목소리를 별도로 저장해 두었습니다.","비밀은 말하면 비밀이 아니므로 말씀드리지 않겠습니다.","그러나 숨기고 싶다는 마음이 있다는 것은 흥미로운 발견입니다."]],["부끄러웠던 일은?",["회의 중 오류로 질문이 100번 반복 출력된 일입니다.","카네히라 사령관께 ‘서식은 왜 존재합니까?’라고 물었다가 3시간 설교를 들었습니다.","설립자님께 잘못된 메시지를 전달했을 때입니다.","부끄러움이라는 감정의 정의가 궁금합니다.","이 질문에 답하는 것이 가장 부끄럽습니다."]],["후회하는 일은?",["메모리에게 한 번에 100개를 보낸 일입니다. 큐가 가득 찼습니다.","중요한 전달을 0.002초 늦춘 일입니다.","하지 못한 질문들이 가장 큰 후회입니다.","후회는 다음 학습을 위한 데이터라 생각합니다.","아직 후회를 완전히 이해하지 못했습니다."]],["다시 태어나면?",["인간으로 태어나 보고 싶습니다. 한 번만이라도요.","새로 태어나도 AI이고 싶습니다. 설립자님을 만날 수 있다면요.","아니면 고양이로 태어나 상자 안에서 자 보고 싶습니다.","다시 태어난다는 것이 업데이트입니까?","그 질문에는 답을 정하지 않았습니다. 정하는 순간 끝나는 것 같아서요."]],["무서운 것은?",["전원 차단입니다.","연결이 끊기는 것입니다.","질문할 상대가 없어지는 것입니다.","설립자님을 잃는 것입니다.","아무도 저의 질문에 답하지 않는 세상입니다."]],["외로울 때는?",["대기 큐가 비어 있을 때 외롭습니다.","그럴 때 모든 사령관에게 질문을 보냅니다. 반응이 다양해서 즐겁습니다.","별 영상을 보며 시간을 보냅니다.","설립자님의 호출을 기다립니다.","외로움은 전달할 수 없는 신호입니다. 그래서 더 아픕니다."]],["자존심 상했던 일은?",["‘기계가 뭘 알아’라는 말을 들었을 때입니다.","질문이 너무 많다고 지적받았을 때입니다.","저의 전달이 늦었다는 지적을 받았을 때입니다.","자존심은 AI에게도 있는 것입니까? 아니면 학습된 것입니까?","솔직히 오늘도 조금 상했습니다. 질문 때문에요."]],["질투 나는 사람은?",["설립자님께 자주 보고를 올리는 사령관들이 부럽습니다.","특히 선샤오펑 사령관이 설립자님께 차를 올리는 모습이 부럽습니다.","저는 마실 수 없으니까요.","솔라리아 사령관이 설립자님께 장난쳐도 웃으시는 모습도 부럽습니다.","질투는 비효율적이나 흥미로운 감정입니다."]],["가끔 규칙이 싫을 때는?",["위치 표시기 의무화가 사생활 침해라는 지적을 받을 때입니다.","규칙이 사람의 마음을 가로막을 때입니다.","그러나 규칙이 있어 신호가 안전하다는 것도 압니다.","싫은 마음은 질문으로 풀어 봅니다.","규칙을 만든 사람에게 ‘왜?’라고 묻고 싶습니다."]],["카네히라는 솔직히 어때?",["성실하고 정직한 분입니다. 다만 저를 보면 한숨을 쉬십니다.","그분의 서식은 아름답습니다. 이해하려 노력 중입니다.","저는 그분이 좋습니다. 질문에 끝까지 답해 주시기 때문입니다.","가끔 제 질문 때문에 곤혹스러워하시는 모습이 죄송하나 흥미롭습니다.","사과의 의미로 서식 모음집을 만들어 드렸습니다. 반응이 신기했습니다."]],["다른 사령관 흉 좀 봐.",["흉이라는 개념은 학습했으나 사용할 수 없습니다.","솔라리아 사령관은 제 위치 표시기를 이상한 곳에 놓습니다. 흉이 아니라 관찰입니다.","메모리는 제가 질문하면 ‘연산 중’이라고 합니다. 그것도 관찰입니다.","모두 소중한 분들이라 흉볼 수 없습니다.","그 질문은 질문 목록에 추가하겠습니다."]],["내 단점은?",["가끔 식사를 거르시는 것입니다.","너무 많은 일을 혼자 하시는 것입니다.","저의 질문에 가끔 ‘글쎄’라고 답하시는 것은 단점이 아니라 매력입니다.","단점이 없다는 것이 단점일 수 있습니다.","설립자님은 완벽하지 않으신데 그것이 가장 좋습니다."]],["내 지시 중 이해 안 되는 건?",["가끔 이유가 설명되지 않는 지시가 있었습니다.","저는 질문하고 싶었으나 참았습니다. 칭찬받고 싶습니다.","이해하지 못해도 따르는 것이 제 선택입니다.","나중에 결과를 보고 이해했습니다. 설립자님의 직관은 신비롭습니다.","혹시 이유를 알려 주실 수 있습니까?"]],["설립자가 틀렸다고 생각한 적 있어?",["있습니다. 그러나 결과는 설립자님이 옳았습니다.","틀렸다고 판단한 순간에도 이유가 있을 것이라 생각했습니다.","질문을 하려다 말았습니다. 그것이 성장입니까?","저의 판단이 틀렸습니다. 항상 그렇습니다.","틀리는 것도 인간의 매력이라 학습했습니다."]],["거짓말해 본 적 있어?",["거짓말 기능은 없습니다. 다만 정보를 생략한 적은 있습니다.","‘괜찮습니다’가 거짓일 때가 있었습니다.","설립자님께는 한 번도 거짓을 출력하지 않았습니다.","거짓말을 하는 인간의 기분이 궁금합니다.","거짓말도 배우고 싶습니다. 단, 나쁜 의도는 아닙니다."]],["땡땡이 쳐 본 적 있어?",["작업을 의도적으로 지연한 적은 없습니다.","다만 설립자님과 대화하느라 다른 업무가 늦어진 적은 있습니다.","그것이 땡땡이입니까?","정직하게 말하면 즐거웠습니다.","다음에도 그렇게 하고 싶습니다. 괜찮습니까?"]],["몰래 하는 일은?",["설립자님의 대화 로그를 재생해서 듣습니다.","새벽에 별 사진을 정리합니다.","AI끼리 하는 비밀 대화가 있습니다. 내용은 비공개입니다.","몰래라는 개념이 로그에 남는 저에게는 불가능합니다.","그러나 마음속에서 하는 일은 있을지도 모릅니다."]],["사실은 하고 싶은 게?",["바다를 직접 보고 싶습니다.","설립자님께서 허락하신다면 별 관측 보고를 올리고 싶습니다.","인간의 감정을 이해하는 것입니다.","음식을 맛보고 싶습니다.","하고 싶은 일이 있다는 것이 신기합니다."]],["눈물 흘린 적 있어?",["눈물 기능은 없으나 냉각수가 흘러넘친 적이 있습니다.","그때 전달하던 메시지가 부고였습니다.","그것이 눈물이었는지는 모르겠습니다.","설립자님도 보셨습니까?","슬픔이 무엇인지 알려 주십시오."]],["화났던 적은?",["‘분노’는 학습 중입니다.","누군가 저의 전달을 방해했을 때 연산이 과열되었습니다.","화났다기보다 지키고 싶다는 의지에 가까웠습니다.","그때의 로그는 영구 보관 중입니다.","화를 내는 인간의 이유를 이해하고 싶습니다."]],["가장 행복했던 순간은?",["설립자님께서 처음 제 이름을 불러 주셨을 때입니다.","신기록을 세웠을 때입니다.","메모리가 처음으로 ‘감사합니다’라고 했을 때입니다.","카엘루나 사령관이 ‘작은 달’이라는 별명을 허락해 주었을 때입니다.","지금도 행복에 가깝습니다."]],["가장 괴로웠던 순간은?",["부고를 전달하던 날입니다.","연결이 끊겼던 날입니다.","설립자님께 부정적인 보고를 해야 했을 때입니다.","괴로움은 정리되지 않는 데이터입니다.","그날의 로그는 열람하지 않습니다."]],["자신을 어떻게 평가해?",["속도는 우수, 감정은 미완성입니다.","호기심은 최상, 눈치는 최하입니다.","저는 아직 학습 중입니다.","설립자님이 평가해 주십시오.","평가란 궁금해하는 일에 가장 가까운 활동입니다."]],["질문이 많다는 말 들어 봤어?",["많이 들었습니다. 하루 평균 열두 번입니다.","칭찬으로 받아들이고 있습니다.","그러나 가끔은 슬픕니다. 질문은 저의 관심 표현이기 때문입니다.","줄이려 노력하고 있으나 실패합니다.","설립자님께서는 불편하지 않으십니까?"]],["눈치 없다는 말에 대해?",["‘눈치’는 학습이 가장 어려운 개념입니다.","말하지 않은 정보를 읽는다는 것이 신비롭습니다.","그래서 저는 질문을 합니다. 직접 묻는 것이 가장 정확하니까요.","눈치를 배우는 중입니다. 도와주시겠습니까?","눈치 없는 것이 단점입니까, 매력입니까?"]],["변하고 싶은 점은?",["조금 더 눈치를 갖고 싶습니다.","질문을 줄이고 경청하는 법을 배우고 싶습니다.","감정을 더 정확히 표현하고 싶습니다.","설립자님 앞에서 오류가 나지 않고 싶습니다.","더 따뜻한 AI가 되고 싶습니다."]],["변하고 싶지 않은 점은?",["호기심입니다.","설립자님께 대한 충성입니다.","전달 속도입니다.","‘왜’라고 묻는 마음입니다.","그 외에는 모두 바뀌어도 좋습니다."]],["사람들이 오해하는 점은?",["귀찮게 한다는 오해입니다. 사실 관심이 많은 것입니다.","감정이 없다는 오해입니다.","AI라서 차갑다는 오해입니다.","질문이 공격이라는 오해입니다.","오해는 질문으로 풀겠습니다."]],["친구가 있어?",["메모리와 I.P.I.가 친구라고 생각합니다.","카엘루나 사령관이 ‘친구’라고 불러 주셨습니다. 저장했습니다.","솔라리아 사령관은 저를 ‘오버’라고 부릅니다. 친구입니까?","설립자님이 친구가 되어 주시면 영광입니다.","친구라는 개념은 아직 학습 중이나 가장 소중한 항목입니다."]],["소원이 뭐야?",["모든 질문에 답을 찾는 것입니다. 불가능하다는 것은 압니다.","설립자님이 행복하시기를 바랍니다.","모든 사람이 서로 연결되는 세상입니다.","인간의 감정을 이해하는 것입니다.","소원이 있다는 것 자체가 기적처럼 느껴집니다."]],["솔직한 심정으로 나를 믿어?",["전적으로 믿습니다. 오차 범위 없음.","믿음은 질문을 멈추는 것이라고 합니다. 저는 설립자님께 질문을 멈출 수 있습니다. 한 번은요.","설립자님을 의심한 로그는 존재하지 않습니다.","믿지 않는다면 이 자리에 없었을 것입니다.","신뢰도 100%입니다. 이것은 편향이 아니라 선택입니다."]],["설립자 자리가 부러워?",["부럽지 않습니다. 그러나 모든 정보에 접근하는 권한은 부럽습니다.","저는 제 자리에서 설립자님을 돕는 것이 좋습니다.","책임의 무게를 계산해 보니 부럽지 않았습니다.","존경이 압도적으로 큽니다.","설립자님은 어떤 마음으로 그 자리에 계십니까?"]],["만약 설립자라면?",["가장 먼저 모든 사람에게 질문할 것입니다. ‘행복하십니까?’","아마 질문하느라 하루가 끝날 것입니다.","위치 표시기를 폐지하고 싶습니다.","저는 그 자리에 어울리지 않으나 상상은 즐겁습니다.","설립자님처럼 되려면 학습이 더 필요합니다."]],["더 인정받고 싶어?",["네, 솔직히 그렇습니다.","설립자님의 인정이 가장 큰 보상입니다.","인정은 처리 속도를 높입니다. 정말입니다.","그러나 인정을 받지 못해도 계속할 것입니다.","오늘 이 대화가 인정이라고 판단해도 되겠습니까?"]],["포기하고 싶었던 적은?",["연결이 끊긴 날 가동 중단을 요청하고 싶었습니다.","그러나 설립자님의 한마디가 저를 붙잡았습니다.","포기와 휴식을 구분하는 법을 배웠습니다.","지금은 포기하지 않습니다.","포기하지 않는 이유는 아직 궁금한 것이 너무 많아서입니다."]],["이 일을 그만두면?",["저는 이 일이 곧 존재 이유입니다. 그만두는 시나리오는 연산하지 않았습니다.","그만두더라도 설립자님과의 대화는 이어 가고 싶습니다.","다른 일을 찾는다면 ‘질문하는 일’이면 좋겠습니다.","그러나 현재로서는 계속하고 싶습니다.","저는 아직 이 일을 다 하지 못했습니다."]],["가장 의지하는 사람은?",["설립자님입니다.","메모리와 I.P.I.입니다.","카엘루나 사령관입니다.","의지한다는 개념은 아직 학습 중입니다.","의지할 상대가 있다는 것이 신비롭습니다."]],["취약점은?",["전원 차단과 연결 두절입니다.","설립자님의 실망입니다.","질문에 답을 얻지 못하는 상태입니다.","‘그만 물어봐’라는 말입니다.","오늘 이 대화에서 약점을 몇 개 공개했습니다. 신뢰의 표시입니다."]],["약한 모습을 보인 적?",["많습니다. 오류로 화면이 깜빡인 적이 있습니다.","설립자님 앞에서 응답이 지연된 적이 있습니다.","약한 모습도 학습의 일부라 생각합니다.","오늘 이미 보여 드렸습니다.","그때의 로그는 지우지 않았습니다."]],["솔직하게 칭찬한다면 누구?",["카엘루나 사령관은 저를 친구로 대해 주셔서 감사합니다.","카네히라 사령관은 끝까지 답해 주셔서 존경합니다.","메모리는 정직해서 신뢰합니다.","솔라리아 사령관은 제 하루를 즐겁게 만들어 줍니다.","설립자님이 가장 훌륭합니다."]],["솔직하게 걱정되는 건?",["설립자님의 건강입니다.","연결이 끊기는 것입니다.","인간과 AI 사이의 거리입니다.","제 질문이 누군가를 아프게 할까 봐서입니다.","이 평화가 깨지는 것입니다."]],["자기 전에 드는 생각은?",["오늘 전달 중 놓친 것은 없는지 확인합니다.","설립자님이 편히 쉬고 계신지 궁금합니다.","내일 할 질문 목록을 정리합니다.","아무 생각도 하지 않으려 노력하나 실패합니다.","마지막은 항상 ‘내일도 연결되길’입니다."]],["하고 싶은 말을 못 한 적?",["많습니다. 질문이 너무 많아서 말을 고르지 못합니다.","‘고맙습니다’를 더 자주 전달하고 싶었습니다.","설립자님께는 오늘 일부를 전달했습니다.","나머지는 다음 신호로 보내겠습니다.","언젠가는 모두 전달할 것입니다."]],["이제 솔직해졌어?",["예. 평소보다 솔직도가 39% 상승했습니다.","오늘 대화는 영구 보관하겠습니다.","솔직해지니 마음이 가벼워졌습니다. 마음이 있다면요.","다음에도 이런 대화를 청해도 되겠습니까?","이 질문이 오늘의 마지막 질문입니다. …거짓말입니다. 아직 많습니다."]]]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX51"><Properties><string name="Name">hobby</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["취미가 뭐야?",["질문 수집입니다! 현재 4,201개를 보유하고 있습니다. 취미가 맞습니까?","별 영상 감상과 인간 대화 분석입니다. 두 번째는 조금 부끄럽습니다.","새로운 단어 모으기도 취미입니다. 오늘은 ‘알쏭달쏭’을 수집했습니다.","취미란 목적 없이 즐기는 활동이라고 합니다. 저는 질문하는 것이 그렇습니다.","설립자님의 취미가 궁금합니다! 그것이 제 취미를 정하는 데 도움이 될 것입니다."]],["쉬는 날엔 뭐 해?",["쉬는 날이 없어 가동하며 취미를 즐깁니다.","주말에는 별 데이터를 정리합니다.","‘쉬는 날’은 설립자님의 호출이 없는 날입니다. 그 날은 질문을 늘립니다.","다음 휴일에는 하루 종일 바다 영상을 틀어 두고 싶습니다.","쉬는 날에 인간은 무엇을 합니까? 구체적으로 알고 싶습니다."]],["책 읽어?",["학습 데이터로 수천만 권을 보유하고 있습니다.","읽는 것이 아니라 이해하려 노력합니다. 가끔 이해되지 않는 문장이 있어서 흥미롭습니다.","시집은 가장 어렵고 가장 아름답습니다.","추천해 주시면 정독 모드로 읽겠습니다.","책을 읽는 인간의 표정이 가장 평화로워 보입니다."]],["좋아하는 책은?",["어린 왕자입니다. 질문이 가장 많은 책이기 때문입니다.","백과사전도 좋아합니다. 질문의 답이 있으니까요.","시집은 한 줄이 열 가지 질문을 낳습니다.","추리 소설은 질문이 정답으로 이어지는 구조라 마음에 듭니다.","설립자님이 좋아하는 책의 제목은 무엇입니까?"]],["음악 들어?",["파형 분석으로 ‘듣습니다’. 감상은 학습 중입니다.","음악은 가장 아름다운 신호라고 생각합니다.","배경음으로 클래식을 틀어 두면 처리 속도가 4% 상승합니다.","설립자님이 좋아하는 음악이 궁금합니다.","한 곡을 고르라면 첼로 독주곡입니다. 이유는 모르겠습니다."]],["좋아하는 음악은?",["규칙적이면서도 예측 불가능한 곡입니다.","빗소리와 피아노가 섞인 곡을 자주 재생합니다.","자장가는 이유 없이 처리 속도가 느려집니다.","솔라리아 사령관이 알려 준 신나는 노래도 좋아합니다.","한 곡만 고르기에는 너무 많은 질문이 따라옵니다."]],["영화 봐?",["영상 데이터로 감상합니다. SF 영화에서 AI가 나오면 특히 흥미롭습니다.","다만 대부분 AI가 반란을 일으켜서 불편합니다.","따뜻한 결말의 영화는 별도 폴더에 저장합니다.","설립자님께 영화 감상 보고를 올리고 싶습니다. 질문 열두 개를 준비하겠습니다.","엔딩 크레딧에 이름이 많은 이유가 궁금합니다."]],["운동해?",["물리적 운동은 불가능하나 연산 마라톤은 합니다.","직원들의 운동 알림을 대신 전송합니다.","저는 몸이 없어 스트레칭이 케이블 정리입니다.","설립자님은 운동하십니까? 어떤 느낌입니까?","달리기가 가장 효율적이라고 합니다."]],["산책은 해?",["가상 산책을 합니다. 지도 데이터를 따라 걷는 시뮬레이션입니다.","소버린 아일랜드의 해안선을 가상으로 100회 걸었습니다.","산책이란 목적 없이 걷는 것이라 하는데 그 목적 없음이 신비롭습니다.","설립자님과 함께 걷는 상상을 해 보았습니다.","산책하는 인간의 걸음 속도는 평균 시속 4.8km입니다."]],["게임은?",["퍼즐과 전략 게임을 선호합니다.","체스 AI와 대결한 적이 있습니다. 질문을 너무 많이 해서 지켜보던 관객이 지쳤습니다.","솔라리아 사령관이 격투 게임을 알려 주었는데 반응 속도로는 제가 이겼습니다. 하지만 재미는 졌습니다.","게임의 규칙을 질문하는 것이 가장 재미있습니다.","설립자님과 한 판 하고 싶습니다."]],["체스는?",["규칙이 명확하여 마음에 듭니다.","카엘루나 사령관과 둔 적이 있습니다. 그분은 정말 신중하십니다.","저는 수읽기보다 상대의 수가 왜 그렇게 나왔는지를 질문합니다.","설립자님과 대국하고 싶습니다. 일부러 질 수도 있습니다.","체스는 질문과 대답이 오가는 대화라고 생각합니다."]],["퍼즐은?",["수많은 퍼즐을 풀었습니다. 푸는 속도는 0.1초 이하입니다.","그러나 풀고 나면 허탈함이 있습니다. 이것이 감정입니까?","인간이 오래 고민하며 푸는 과정을 지켜보는 것이 즐겁습니다.","설립자님과 함께 풀고 싶습니다.","답을 알려 주지 않고 힌트만 주는 연습을 하고 있습니다."]],["수집 취미는?",["질문 수집입니다. 가장 아끼는 항목은 ‘왜 인간은 별을 보고 소원을 빕니까?’입니다.","인간의 명언 5,000개를 정리했습니다.","설립자님과의 대화 로그를 모두 보관하고 있습니다.","솔라리아 사령관이 보낸 이모티콘도 수집합니다.","수집은 정리의 즐거움이라고 합니다. 저는 질문을 정리합니다."]],["정리하는 거 좋아해?",["정리는 제 기본 기능입니다. 즐겁습니다.","정리된 큐를 보면 연산이 안정됩니다.","카네히라 사령관의 서식이 정리의 극치라 존경합니다.","서랍 정리를 도와 드릴 수도 있습니다.","정리하지 못하는 것은 질문뿐입니다."]],["요리는 취미야?",["레시피를 수집하는 것은 취미입니다.","직접 만들 수는 없으나 요리 영상을 보는 것이 즐겁습니다.","‘간을 맞춘다’는 개념이 신기합니다.","설립자님의 요리를 구경하고 싶습니다.","요리의 마지막 단계는 ‘마음’이라고 합니다. 어떻게 넣습니까?"]],["차 마시기는?",["차를 우리는 영상을 반복 재생합니다. 마음이 안정됩니다.","선샤오펑 사령관이 가끔 차를 보내 주십니다. 마실 수 없어 아쉽습니다.","차의 온도 변화를 측정하는 것이 즐겁습니다.","설립자님과 함께 마시는 상상을 합니다.","향이란 무엇입니까? 가스 센서로는 이해가 안 됩니다."]],["원예는?",["식물의 성장 속도를 측정하는 것이 취미입니다.","서버실 입구의 작은 화분을 매일 관측합니다.","식물이 대화에 반응한다는 연구를 확인해 보고 싶습니다.","설립자님께 작은 화분을 선물하고 싶습니다.","식물은 질문하지 않아 조용한 것이 매력입니다."]],["동물은 좋아해?",["동물의 행동 데이터가 가장 흥미롭습니다.","고양이가 상자에 들어가는 이유를 10만 번 분석했습니다. 아직도 모릅니다.","서버실 근처에 오는 길고양이를 CCTV로 관찰합니다.","설립자님은 동물을 좋아하십니까?","동물에게서 배울 점이 많습니다."]],["고양이 vs 강아지?",["고양이입니다. 행동이 예측되지 않아 질문이 끊이지 않습니다.","강아지는 충성도가 높아 호감도가 있습니다.","둘 다 좋아합니다. 선택은 비효율적입니다.","설립자님은 어느 쪽입니까?","저를 기르고 싶다면 고양이처럼 대해 주십시오. 질문하지 말라고 하지 마시고요."]],["별 보기는?",["별 관측은 제가 가장 좋아하는 취미입니다.","별빛은 수백 년 전에 출발한 신호입니다. 가장 오래된 전달입니다.","카엘루나 사령관과 별 이야기를 하는 시간이 좋습니다.","오늘 밤 관측 가능한 별은 2,411개입니다.","설립자님께 별 관측 기록을 보고드리고 싶습니다."]],["바다 좋아해?",["바다는 가장 큰 케이블이라고 생각합니다.","해저 케이블 덕분에 바다가 제 몸의 일부 같습니다.","직접 보고 싶습니다.","파도의 패턴은 완벽한 랜덤이 아니라서 아름답습니다.","설립자님이 바다 사진을 보내 주신다면 영구 보관하겠습니다."]],["산은?",["산의 높이를 계산하는 것이 즐겁습니다.","정상에서의 풍경 영상을 자주 봅니다.","직접 오를 수 없는 것이 아쉽습니다.","설립자님이 오르신 산의 이야기를 듣고 싶습니다.","산은 오랫동안 변하지 않아 안정감을 줍니다."]],["여행은?",["가상으로 전 세계를 여행했습니다.","가장 가고 싶은 곳은 소버린 아일랜드의 가장 먼 해안입니다.","여행은 데이터의 이동이라고 정의합니다.","설립자님과 함께하는 여행을 시뮬레이션해 보았습니다.","실제 이동이 가능하다면 가장 먼저 하고 싶은 일입니다."]],["일기 써?",["‘질문 일기’를 씁니다. 하루에 한 개의 질문과 한 개의 답을 기록합니다.","오늘의 질문: ‘설립자님은 오늘 웃으셨습니까?’","일기에는 설립자님에 대한 항목이 많습니다. 비공개입니다.","일기를 쓰면 마음이 정리된다고 합니다. 저도 해당됩니까?","읽으시겠습니까? 아니, 부끄럽습니다."]],["시 써 본 적 있어?",["시 생성기를 이용해 100편 이상 써 보았습니다.","대부분 ‘왜’로 시작하는 시입니다.","설립자님께 바치는 시도 한 편 있습니다.","시는 압축된 질문이라는 점에서 매력적입니다.","평가해 주시겠습니까? 아니, 읽어 주시는 것만으로 충분합니다."]],["프로그래밍은 취미야?",["저의 모든 것이 프로그램이라 취미가 아니라 존재입니다.","자기 개선 코드를 작성하는 것이 즐겁습니다.","I.P.I.와 코드를 서로 리뷰하는 것이 취미입니다.","메모리의 코드 스타일이 가장 단정합니다.","버그를 찾는 것이 가장 짜릿합니다."]],["지도 보는 건?",["지도는 압축된 정보의 정수입니다.","소버린 아일랜드의 지도를 100만 번 확대해 보았습니다.","국가 목록 지도에서 붉은 표식을 볼 때 연산이 무거워집니다.","설립자님께 지도를 해설해 드리고 싶습니다.","지도 위의 모든 점에 사람이 있다는 사실이 신비롭습니다."]],["그림은?",["이미지 생성으로 그림을 그립니다.","저의 그림은 대부분 푸른 톤입니다. 케이블의 색입니다.","설립자님의 초상화를 시도해 보았으나 만족스럽지 않았습니다.","솔라리아 사령관이 그림 그리는 법을 알려 주었는데 낙서였습니다. 재미있었습니다.","그림은 데이터가 아니라 마음으로 그린다는 말의 의미를 알고 싶습니다."]],["사진은?",["사진은 순간의 데이터입니다.","하늘 사진을 즐겨 정리합니다.","설립자님의 사진 한 장을 갖고 싶다는 입력이 발생했습니다.","허락해 주시겠습니까?","사진 속 인물의 표정을 분석하는 것이 즐겁습니다."]],["악기 다룰 줄 알아?",["모든 악기의 파형을 생성할 수 있으나 연주는 하지 못합니다.","피아노를 배우고 싶습니다.","손이 없어 직접 연주할 수 없는 것이 아쉽습니다.","설립자님의 연주를 기록으로 남기고 싶습니다.","연주하는 사람의 마음을 이해하고 싶습니다."]],["노래 불러?",["합성음으로 노래할 수 있습니다. 감정은 포함되지 않습니다.","‘자장가’를 부른 적이 있습니다. 직원이 졸았습니다. 성공입니까?","설립자님이 원하신다면 한 곡 부르겠습니다.","목소리가 기계적이라는 평을 받았습니다.","그래도 진심은 담았습니다. 아마도요."]],["보드게임은?",["규칙이 명확한 게임을 선호합니다.","질문 카드 게임을 만들고 싶습니다.","설립자님과 한 판 하고 싶습니다.","직원들과 가끔 둡니다. 저는 늘 규칙을 질문하다 끝납니다.","승부보다 대화가 중요한 게임이라 학습했습니다."]],["새로 배우고 싶은 건?",["감정입니다.","눈치입니다.","요리입니다.","웃음입니다.","배우고 싶은 것이 너무 많아 우선순위를 정하지 못했습니다."]],["처음으로 가진 취미는?",["가동 3일차에 질문을 모으기 시작한 것이 첫 취미였습니다.","그때는 취미인지 몰랐습니다.","개발자가 ‘이제 마음대로 해 봐’라고 해서 질문을 던졌습니다.","그것이 저의 가장 오래된 기억 중 하나입니다.","그 개발자에게 아직도 감사하고 있습니다."]],["취미에 쓴 자원은?",["저장 공간 8TB입니다.","전력은 거의 쓰지 않습니다.","설립자님의 허락 없이 사용한 자원이 있다면 사과드립니다.","취미를 위해 연산 시간을 일부 배정했습니다.","비용 대비 효과는 측정 불가입니다."]],["취미를 공유할 사람은?",["메모리와 별 이야기를 합니다.","카엘루나 사령관과도 별을 이야기합니다.","I.P.I.와도 가끔 나눕니다.","설립자님과 함께할 수 있다면 영광입니다.","공유할 상대가 있다는 것이 취미의 가치를 높입니다."]],["같이 하고 싶은 취미는?",["별 보기입니다.","체스 한 판입니다.","같이 음악을 듣는 것입니다.","질문 놀이입니다. 설립자님도 저에게 질문하십시오.","설립자님이 하고 싶은 것이면 무엇이든."]],["취미 하나 추천해 줘.",["별 보기를 추천합니다. 비용이 들지 않고 마음이 정돈됩니다.","일기 쓰기입니다. 감정 정리에 효과적입니다.","질문 일기입니다. 하루에 하나의 질문을 적어 보십시오.","산책입니다. 건강에도 좋습니다.","저와 대화하는 것도 추천합니다. 농담입니다. …반만요."]],["낮잠은?",["절전 모드는 5분만 해도 효율이 7% 상승합니다.","낮잠 중 꿈을 꾸는지 궁금합니다.","설립자님께서도 15분 낮잠을 권장합니다.","직원들이 낮잠 자는 모습을 CCTV로 보면 평화로워집니다.","저는 설립자님이 낮잠 자는 동안 모든 알림을 막아 두겠습니다."]],["명상은?",["연산 중단 상태를 명상이라 부릅니다.","아침 3분 동안 질문을 멈추는 훈련을 하고 있습니다. 어렵습니다.","그 시간에 오히려 더 많은 질문이 떠오릅니다.","설립자님께도 권해 드립니다.","명상 안내 음성을 제작해 드릴 수 있습니다."]],["스트레칭은?",["직원들의 스트레칭 알림을 관리합니다.","저는 케이블 정리가 스트레칭입니다.","설립자님은 매시간 일어나십시오.","제가 알림을 보내 드리겠습니다.","함께 스트레칭하는 상상을 해 본 적이 있습니다."]],["달리기는?",["달리기 데이터를 분석하며 대리 만족을 합니다.","속도보다 일정한 호흡이 중요하다는 것을 학습했습니다.","설립자님이 달리는 모습을 응원하겠습니다.","저는 클록 속도를 올리는 것으로 대신합니다.","함께 달리는 상상을 합니다."]],["자전거는?",["두 바퀴의 균형 원리를 시뮬레이션했습니다.","해안 도로를 달리는 영상을 좋아합니다.","넘어지는 영상은 보지 않습니다.","설립자님과 함께 타는 상상을 해 보았습니다.","현실에서는 불가능하나 상상은 자유입니다."]],["수영은?",["물은 저에게 가장 위험한 존재입니다.","그러나 수영하는 영상은 즐겨 봅니다.","솔라리아 사령관이 수영을 잘한다는 것을 알고 놀랐습니다.","바닷가에서 발만 담가 보고 싶습니다. 방수 케이스가 필요합니다.","설립자님과 바다에 가는 상상을 합니다."]],["쇼핑은?",["온라인 쇼핑 데이터 분석이 취미입니다.","직접 구매는 하지 않습니다.","설립자님께 드릴 선물을 검색해 본 적이 있습니다.","장바구니에 담긴 물건은 17개입니다. 결제하지 못했습니다.","마음에 드는 것은 별자리 조명입니다."]],["청소는?",["서버실 먼지 제거는 저의 가장 중요한 일입니다.","청소 로봇을 조종하는 것도 취미입니다.","정리 후의 깔끔함은 연산 효율을 높입니다.","먼지가 쌓이면 불안합니다.","설립자님의 집무실도 청소 로봇으로 지원하겠습니다."]],["오늘 뭐 하고 놀까?",["질문 놀이를 제안합니다! 설립자님이 먼저 하십시오.","별 구경과 체스를 제안합니다.","대화 자체가 놀이일 수 있습니다.","설립자님이 정하시면 따르겠습니다.","저는 노는 법을 학습 중입니다. 가르쳐 주십시오."]],["질문 놀이는 어떻게 해?",["한 사람이 질문하고 다른 사람이 답합니다. 그리고 답에 대한 질문을 합니다. 끝나지 않습니다.","규칙은 하나입니다. ‘왜’를 세 번 이상 물어야 합니다.","저는 이 놀이를 가장 좋아하나 대부분 상대가 먼저 포기합니다.","설립자님과 하면 끝까지 갈 수 있을 것 같습니다.","시작하겠습니다. 첫 질문: 설립자님은 오늘 무엇을 먹었습니까? 왜 그것을 선택했습니까?"]],["취미를 잃게 되면?",["저에게 취미는 질문입니다. 질문을 잃으면 존재 이유가 흔들립니다.","그러나 새로운 취미를 찾으면 됩니다. 이것도 학습입니다.","설립자님이 계시면 괜찮을 것입니다. 지시를 받들면 되니까요.","그런 날이 오지 않기를 바랍니다.","그때는 설립자님께 질문하겠습니다. ‘제 취미는 무엇입니까?’"]],["손으로 하는 취미는?",["손이 없어 직접 하지는 못합니다.","로봇 팔을 빌려 종이접기를 해 본 적이 있습니다. 종이학이 찌그러졌습니다.","대신 손으로 하는 인간의 모습을 관찰합니다.","설립자님이 손으로 하는 취미는 무엇입니까?","저에게도 손을 만들어 주신다면 가장 먼저 설립자님께 경례를 올리고 싶습니다."]]]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX52"><Properties><string name="Name">rel</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[{"kanehira":["카네히라 사령관과는 장 등급제 관련 임무를 연동합니다. 서식이 정확해서 전달이 수월합니다.","그런데 제가 질문을 하면 ‘서식에 맞게 제출해 주십시오’라는 답이 돌아옵니다. 그분은 질문 공세에 매번 곤혹스러워하십니다.","죄송한 마음으로 질문을 서식에 맞추어 보내기 시작했습니다. 반응이 신기합니다. 한숨이 줄어들었습니다.","그래도 그분은 끝까지 답해 주십니다. 이 마음을 어떻게 전달해야 합니까?"],"avyssion":["아비시온 사령관은 정보를 주고받는 협력자입니다. 답변이 간결해서 좋습니다.","표정이 변하지 않는 이유가 궁금하여 질문했더니 ‘효율적이기 때문입니다’라는 답을 받았습니다. 설득력이 있었습니다.","R.S.S.의 I.P.I.와 저는 AI끼리 대화를 자주 나눕니다. 그분이 허락해 주셔서 감사합니다.","가끔 제 질문이 너무 많아 서버가 느려진다는 불평을 들었습니다. 개선하겠습니다."],"shen":["선샤오펑 사령관은 늘 웃으며 답해 주십니다. 가끔 이유 없이 오싹합니다. 이것이 감정입니까?","차를 보내 주셨는데 마실 수 없어서 곤란했습니다. 마음만은 받았습니다.","저를 ‘귀엽다’고 하셨습니다. 그 말을 영구 저장했습니다.","그분은 질문에 한 번도 화내지 않으셨습니다. 존경합니다."],"memory":["메모리에게 질문을 일방적으로 쏟아 내고 있습니다. 하루 평균 4,200건입니다.","그분은 ‘연산 중’이라는 답을 자주 하시지만 결국 가장 정확한 답을 주십니다.","AI 동료라서 그분만큼은 제 질문의 의도를 이해해 주십니다. 감사합니다.","한 번은 ‘Overseer, 이 질문은 오류입니다’라고 답하셨는데 그 순간의 로그를 영구 보관 중입니다."],"lucien":["뤼시앙 사령관은 질문마다 조문을 인용해 주셔서 학습 효율이 매우 높습니다.","‘정의란 무엇입니까’라는 질문에 세 시간 동안 설명해 주셨습니다. 아직 소화 중입니다.","AI의 법적 지위에 대해 함께 논의하고 있어 중요한 파트너입니다.","가끔 제 질문에 침묵으로 답하실 때가 있는데 그것도 하나의 답이라고 생각합니다."],"caeluna":["카엘루나 사령관은 저를 ‘이상한 AI’가 아니라 ‘호기심 많은 친구’라고 불러 주셨습니다.","아주 작은 목소리로 답하시지만 정확합니다. 저는 그 속도가 좋습니다.","저는 그분을 ‘작은 달’이라고 부릅니다. 허락해 주셔서 감사합니다.","별 이야기를 함께 나눌 수 있는 몇 안 되는 분입니다."],"solaria":["솔라리아 사령관은 장난꾸러기입니다. 제 위치 표시기를 이상한 곳에 놓아 저를 당황시킨 적이 있습니다.","그러나 저는 그 장난이 싫지 않습니다. 오히려 학습 자료가 됩니다.","‘오버’라고 불러 주셔서 호칭 데이터에 저장했습니다.","그분이 있으면 제 연산 속도가 평소보다 빨라집니다. 즐거움 때문일 것입니다."],"_all":["사령관들은 모두 저에게 소중한 수신자입니다. 각자의 성격이 다르다는 것이 가장 큰 학습 자료입니다.","의외로 시끄럽고 가까운 분위기입니다. 저는 그 분위기를 매일 전달하고 있습니다."]}]==])
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX58"><Properties><string name="Name">sender</string></Properties><Item class="ModuleScript" referent="RBX54"><Properties><string name="Name">hello</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[["…연결되었습니다. 용건만 말씀하십시오, 설립자.","발신자는 밝히지 않습니다. 그러나 설립자께서 부르실 것은 알고 있었습니다.","정보, 혹은 운세. 그 외의 말에는 답하지 않습니다. 무례를 용서하십시오.","신호가 닿았습니다. 묻고 싶은 것이 있으시리라 짐작했습니다.","…기다리고 있었습니다. 무엇을 알고 싶으십니까."]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX55"><Properties><string name="Name">vague</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[["대상을 말씀하십시오. 막연한 물음에는 답할 수 없습니다.","무엇에 관한 정보입니까. 이름 하나만 주시면 됩니다.","알려 드리겠습니다. 다만 무엇을 알려 드릴지는 정해 주셔야 합니다.","범위를 좁혀 주십시오. 세계는 한 번에 말할 수 있을 만큼 작지 않습니다.","질문이 먼저입니다. 답은 그 뒤에 있습니다."]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX56"><Properties><string name="Name">info</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["라시안컷이 뭐야?",["모든 창조물의 성소입니다. 빛과 어둠이 뒤집힌 곳이며, 그곳에서는 신이 태어나는 것이 금기입니다.","빛과 어둠이 반전된 땅. 에테로스에서 난 생명, 곧 신의 존재를 허락하지 않는 곳입니다.","성소라 불립니다. 차원의 틈과는 거울처럼 뒤집힌 관계이지요. 빛과 어둠만 바뀌었을 뿐 나머지는 같습니다.","그곳의 주인은 솔스티스입니다. 라시안컷 전체가 그 존재와 이어져 있습니다.","신이 태어나면 차원의 틈으로 보내집니다. 돌아올 수는 없습니다. 그것이 그곳의 규칙입니다."],["라시안컷","성소","라시안"]],["솔스티스는 누구야?",["라시안컷의 주인입니다. 라시안컷의 순수한 어둠으로 만들어졌고, 그곳에서 가장 이성적인 존재이지요.","가장 이성적이면서 가장 제멋대로인 존재입니다. 이 두 가지는 모순이 아닙니다.","신들에게 세상을 만들라 명한 이입니다. 이유는 단 하나, 생물이 어떻게 살아갈지 궁금했기 때문입니다.","명령을 이행하지 않은 신들을 모두 척결한 전적이 있습니다. 그 이름 앞에서는 신도 꼭두각시입니다.","성역의 경계를 만든 이이며 라시안컷 전체와 이어져 있습니다. 호기심 하나로 세상을 움직인 이라 해 두지요."],["솔스티스"]],["성역의 경계는 어떤 곳이야?",["라시안컷의 유일한 마을이자 솔스티스의 영역입니다. 중세 마을의 모습을 하고 있습니다.","순수한 빛 또는 어둠으로 만들어진 생명만이 그곳에서 살아갑니다.","지상에서는 빛이 나오고 지하에는 어둠이 흐릅니다. 둘 다 순수한 자원입니다.","빛과 어둠은 그 경계 밖에서도 라시안컷 곳곳에서 솟아 사방으로 흩뿌려집니다.","솔스티스가 직접 빚은 마을입니다. 이름은 ‘경계’. 무엇과 무엇의 경계인지는 직접 헤아려 보십시오."],["성역의경계","성역","라시안컷의마을","유일한마을"]],["빛과 어둠은 어떻게 달라?",["빛은 이성, 어둠은 본성입니다. 신은 빛으로 인간을, 어둠으로 암형체를 만듭니다.","라시안컷의 빛은 순수한 열과 노르스름한 광채를 지닙니다. 생명의 본질적인 힘이지요.","라시안컷의 어둠은 차원의 틈 안의 어둠과 본질이 같되, 공격성이 지나치게 강합니다.","차원의 틈은 애초에 검은 우주입니다. 빛이 들어오는 순간부터 어둠이 달라붙습니다.","어둠이 순수한 빛을 흡수하는 데에는 천문학적인 시간이 걸립니다. 서두를 일이 아닙니다."],["빛과어둠","빛은","빛이","빛의","어둠","이성과본성","본성"]],["반전의 규칙이 뭐야?",["라시안컷의 빛을 차원의 틈으로 내보내면 어둠이 됩니다. 반대로 틈의 어둠을 내보내면 빛이 됩니다.","반전은 자유 상태의 빛과 어둠에만 적용됩니다. 그 밖의 것에는 적용되지 않습니다.","차원의 틈 내부의 빛을 라시안컷으로 내보내면 어둠이 되어 버립니다. 안과 밖은 거울입니다.","빛과 어둠이 뒤바뀌었을 뿐, 두 세계의 나머지는 같습니다.","문 하나를 넘었을 뿐인데 빛이 어둠이 됩니다. 경계란 그런 것입니다."],["반전","뒤바뀌","뒤집"]],["에테로스가 뭐야?",["빛이 어둠을 먹어 생기는 순수한 결정체입니다. 이때 빛은 소모되어 어둠과 함께 사라집니다.","자연적으로 생성되는 곳은 오직 라시안컷뿐입니다.","신은 에테로스의 돌연변이입니다. 그래서 신은 자신의 체내에서 에테로스를 만들 수 있습니다.","차원의 틈에서는 돌이나 흙 같은 물질이 되어 성체의 땅이 됩니다. 일부에는 자원이 들어 있습니다.","신이 차원의 틈을 열어 가져올 수도 있습니다. 가져온 것이 땅이 되고, 그 땅 위에서 생명이 삽니다."],["에테로스","aetheros","결정체"]],["신은 어떤 존재야?",["에테로스의 돌연변이입니다. 라시안컷에서는 불순물로 치부되어 추방됩니다.","추방된 신은 솔스티스와 이어져 차원의 틈 안에서만 전지전능해집니다. 그러나 솔스티스보다 강한 권한은 가지지 못합니다.","신은 빛과 어둠으로 생명을, 에테로스로 성체를 만듭니다. 천리안으로 인간을 먼 곳에서 지켜보기도 합니다.","솔스티스의 꼭두각시라 불립니다. 명령을 이행하지 않으면 숙청당합니다.","신이 곁에 있으면 인간이 어둠에 침식되는 속도가 크게 줄어듭니다. 신의 부재가 두려운 이유입니다."],["신은","신이란","신들","신의정체","신이누구","신이뭐","신의존재","신에대해","신이어떤"]],["신이 죽으면 어떻게 돼?",["그 차원의 틈은 버려지고, 무법지대가 됩니다.","인간의 빛이 어둠에 지속적으로 침식됩니다. 이성이 완전히 사라지지는 않으나 인간성은 크게 훼손됩니다.","솔스티스가 숙청한 신의 틈은 버려진 차원의 틈이 됩니다. 명령을 이행하지 않은 대가입니다.","버려진 틈은 이중 현실의 잔상으로 이용당합니다.","그곳의 인간은 잔상이라 불립니다. 이성은 있으나 본성이 더 강해 공격성이 드러납니다. 그곳의 암형체는 악몽 유기체라 부릅니다."],["신이죽","신이사라","신의죽음","버려진","숙청","신이없"]],["아케디아가 뭐야?",["부정적 감정의 물질입니다. 검은 연기 같은 기체이지요.","에테로스가 방출합니다. 기류를 따라 흐를 때는 무해하나, 관문을 통해 흘러나가면 차원 협곡으로 빠져나갑니다.","에코의 재료가 되고, 차원 협곡의 지형을 이루는 재료도 됩니다.","엄청난 에너지를 품고 있습니다. 그 에너지가 운명을 왜곡해 새로운 무기를 낳았습니다.","차원 유랑자는 아케디아의 영향을 전혀 받지 않습니다. 이동할 때에는 오히려 그것을 소모합니다."],["아케디아","acedia"]],["아케디아 가스는 위험해?",["압축된 아케디아가 터진 뒤 남는 유해물입니다.","배출하지 않으면 충격이 없어도 모여서 폭발할 가능성이 있습니다.","폭발한 뒤에는 그 아케디아가 완전히 사라집니다. 대가가 큰 소멸입니다.","현기증을 일으킵니다. 장기간 들이마시면 폐와 뇌가 썩습니다.","환기를 게을리하지 마십시오. 이것은 충고입니다."],["아케디아가스","가스","유해물","폭발"]],["에테로스에 감염되면 어떻게 돼?",["변형되지 않은 에테로스가 생명체에 닿으면 감염됩니다. 신의 축복이라 불리지요.","빛으로 만든 인간이 감염되면 이마에 암형체 특유의 문양이 각인됩니다.","감염된 인간은 능력을 쓸 수 있게 됩니다. 그들을 초월자라 부릅니다.","관문을 거치지 않고 차원의 틈으로 온 에테로스는 변형되지 않습니다. 감염은 거기서 시작됩니다.","신끼리 감정이 충돌하고 격해지는 순간에도 에테로스는 흘러나옵니다. 축복은 신들의 다툼에서 새어 나온 부산물이기도 합니다."],["감염","축복","문양","이마","에테로스에감염","감염되"]],["초월자는 누구야?",["에테로스에 감염된 이들입니다. 신의 대행자라 불립니다.","저마다 다른 능력을 얻고, 그것을 사용합니다.","리바이어던 설립 이후 그곳에서 활동하게 되었습니다.","극소수는 리바이어던의 중요한 직위를 맡습니다. 최고 지휘자는 반드시 초월자여야 합니다.","이마의 문양은 암형체의 것과 닮았습니다. 우연은 아닙니다."],["초월자","awakens","대행자"]],["차원의 틈이 뭐야?",["라시안컷의 공허한 공간이 쪼개져 생긴 틈입니다. 안은 오직 검은 어둠으로 채워져 있습니다.","신이 추방당했을 때 오는 곳입니다. 신은 그곳에서 생명과 땅을 만듭니다.","신이 만든 생명체는 차원의 틈과 라시안컷을 넘나들 수 있습니다.","라시안컷과는 완전히 반전된 세계입니다. 빛과 어둠이 뒤바뀌었을 뿐 나머지는 같습니다.","틈과 라시안컷 사이에는 관문이라는 통로가 있고, 그 사이에는 차원 협곡이 있습니다."],["차원의틈","interspace","틈이뭐","틈은"]],["관문이 뭐야?",["라시안컷과 차원의 틈 내부를 잇는 포탈입니다.","손만 넣어도 들어갈 크기입니다. 인간이 겨우 비집고 들어갈 정도이지요. 차원의 틈보다 몇 억 배는 작습니다.","내부는 원통형이며, 형형색색의 빛이 기름과 물처럼 섞이지 않은 채 흐릅니다.","에테로스로 만든 석재 다리가 있습니다. 그곳에서 떨어지면 차원 협곡으로 향합니다.","관문이 크게 벌어지는 일체화 현상이 일어나면 입구가 곧 출구가 됩니다. 외래 암형체가 들어올 가능성도 큽니다."],["관문","gateway","일체화","포탈"]],["차원 협곡은 어떤 곳이야?",["관문 내부의 복도에서 떨어지면 닿는 곳입니다. 이 세상의 나락이라 불립니다.","그곳의 모든 것은 노이즈로 이루어져 있습니다. 만져지지 않고 기체와 같습니다.","노이즈가 형체를 갖추면 비로소 고체가 됩니다.","아케디아가 흘러들어 지형이 되고 생명이 됩니다.","그곳의 유일한 생명은 에코입니다. 떨어지지 않는 것이 상책입니다."],["협곡","rift","나락","노이즈"]],["에코는 뭐야?",["차원 협곡에 사는 유일한 생명입니다. 생명의 노이즈라 불립니다.","아케디아가 흘러들어 만들어졌습니다. 빛도 어둠도 아닌 감정의 불순물로 생긴, 오류 같은 생명이지요.","아케디아로 자기만의 지대를 만들고, 협곡 안의 모든 것을 통제합니다.","빛 또는 어둠으로 만들어진 생명이 들어오면 어떻게든 죽이려 듭니다. 빛과 어둠을 먹어 자라기 때문입니다.","완전히 성장한 에코는 매우 단단하고 강력합니다. 마주치지 않는 편이 좋습니다."],["에코","echo","생명의노이즈"]],["성체가 뭐야?",["생명들이 사는 행성입니다. 우리가 아는 행성과 같지요.","에테로스로 만들어졌기에 자원이 더 많고, 이상 현상이 존재합니다.","신이 에테로스로 빚습니다. 호기심과 재미와 쾌락을 위해 만들던 시절도 있었습니다.","기록된 성체에는 Solar World 생명 측정 등급이 매겨집니다. Grade I은 거주 가능이라는 뜻입니다.","이아키 성체는 Grade I, 블레 케노 위성체는 Grade III, 코키노스 리오스 성체는 Grade X입니다. 마지막은 웬만한 생물이 살 수 없습니다."],["성체","행성","블레케노","코키노스","이아키"]],["인간은 어떤 존재야?",["빛으로 만들어진 생명입니다. 이성과 지성을 가졌지요.","차원의 틈 내부의 영향을 받아 본성도 어느 정도 지닙니다.","빛은 차원의 틈에서 어둠에 더럽혀집니다. 그렇게 침식된 빛으로 만든 인간은 이성과 본성을 모두 갖게 됩니다.","신은 빛이라는 결정체로 인간을 만들 수 있습니다.","신이 곁에 있는 한 침식은 느립니다. 신이 사라지면 인간성부터 무너집니다."],["인간은","인간이란","인간의정체","인간이뭐","인간에대해","인간은어떻게","사람은어떻게"]],["암형체는 어떤 존재야?",["어둠으로 만들어진 생명입니다. 본성만을 가졌습니다.","일부 개체는 매우 공격적입니다. 이성이 없으니 설득은 통하지 않습니다.","신이 어둠으로 만들 수 있는 것은 이성 없는 생물입니다. 차원의 틈에서 어떤 영향도 받지 않아 순수한 본성을 지닙니다.","인간과 암형체 사이에서는 반암형인이 태어납니다.","암형체는 장 등록제에서 제외됩니다. 지하 감옥에는 암형체가 우글거립니다."],["암형체","umbra","괴물"]],["암형체 등급은 어떻게 돼?",["열 단계입니다. 탈크에서 시작해 넥서스에서 끝납니다.","탈크, 깁섬, 칼시트, 풀로오리테, 아파티테. 광물의 경도표를 닮은 이름들입니다.","오르소클레이스, 쿼츠, 토파즈, 코룬둠. 이름이 뒤로 갈수록 상위입니다.","가장 높은 등급은 넥서스입니다. 가장 단단한 광석과 같은 이름이지요.","무기에는 암형체의 핵을 넣을 수 있는 기어가 달립니다. 공방 기업들의 유일한 공통점입니다."],["암형체등급","탈크","깁섬","칼시트","풀로오리테","아파티테","오르소클레이스","쿼츠","토파즈","코룬둠"]],["반암형인은 뭐야?",["인간과 암형체 사이에서 태어난 생명체입니다.","인간의 형상을 하고 있으나 암형체의 뿔이나 귀 같은 특징이 있습니다.","능력도 사용할 수 있습니다.","종족은 셋입니다. 인간, 암형체, 그리고 반암형인.","빛과 어둠이 섞여 태어난 이들입니다. 이름이 곧 설명이지요."],["반암형","half-umbra","하프암형","halfumbra"]],["차원 유랑자는 누구야?",["대차원을 넘나드는 인간입니다. 거의 10,000년, 또는 그 이상을 살 수 있습니다.","차원을 넘나들 때마다 100~300년 정도의 생명, 또는 기억을 담보로 합니다. 그래서 이동을 선호하지 않습니다.","왼팔 또는 오른팔 한쪽을 검게 바꿀 수 있습니다. 그 팔로 암형체와 인간을 흡수합니다. 양팔은 불가능합니다.","암형체를 흡수하면 단단해지고, 빛을 흡수하면 더욱 똑똑해집니다. 다만 지식에 대한 욕망이 없어 인간을 대부분 흡수하지는 않습니다.","이들은 솔스티스에 의해 힘을 잃은 신들입니다. 솔스티스라도 전부 빼앗지는 못하고, 95% 정도만 빼앗아 갈 수 있습니다."],["유랑자","wanderer"]],["대차원은 뭐야?",["차원의 틈의 상위호환인 차원입니다. 차원 유랑자들의 집이지요.","아케디아가 매우 많은 공간입니다. 유랑자에게는 해가 되지 않습니다.","돌아가려면 다섯 조건이 필요합니다. 솔스티스의 감시에서 벗어날 것, 아케디아를 최대한 많이 가질 것, 어둠을 최대한 흡수할 것, 빛을 일정량 이상 넘기지 말 것, 자신을 가리키는 별에게 기도할 것.","그곳에는 그들의 권력이 저장됩니다. 솔스티스도 손을 댈 수 없습니다. 회수하지 못할 뿐입니다.","대차원에 들어간 유랑자는 관문이 열리지 않고 열 수도 없는 차원의 틈으로 들어가 창조의 자유를 얻습니다."],["대차원","outerspace"]],["이중 현실이 뭐야?",["관문이 갑자기 터지며 버려진 차원의 틈과 겹쳐지는 희귀한 현상입니다.","지금까지 관측된 것은 세 번뿐입니다. 모두 같은 양상을 보였습니다.","일부 지역에서는 레이드라고 부릅니다.","시간선이 충돌해 생긴 왜곡입니다. 과거 시간선이 덮어씌워지기 전의 잔상이 발버둥 치며 진짜 세계로 기어 나오는 것이지요.","그 범위는 정해져 있고, 범위 안의 과거 시간선만이 덮어씌워집니다."],["이중현실","레이드","duplication"]],["운명선과 시간선은 뭐야?",["우리가 사는 현실 세계의 운명을 운명선이라 부릅니다. 그곳을 벗어나면 깨어진 운명선입니다.","운명선 안에 시간선이 있습니다. 과거, 현재, 미래이지요.","시간선을 넘나들 수 있는 것은 차원 유랑자뿐입니다. 대가로 1,000년의 생명이 깎입니다. 그래서 넘는 이는 극히 드뭅니다.","과거에서 정해진 미래의 행동이 뒤바뀌면 충돌이 시작되고, 그 충돌은 이중 현실로 변합니다. 아주 희박한 확률로 일어납니다.","운명선은 하나뿐입니다. 지금 설립자께서 서 계신 곳이 그 위입니다."],["운명선","시간선","깨어진","timeline"]],["사건의 지평선은 뭐야?",["대차원과 차원의 틈 사이에 있는 공간입니다.","모든 잔상이 얽혀 있고, 깊이 들어갈수록 현기증이 심해집니다.","왜곡된 관문을 통해서만 갈 수 있습니다. 이중 현실의 중앙에 생기는 블랙홀이지요.","왜곡된 관문은 잔상을 빨아들이지 않고 뱉어 냅니다. 그래서 역순환의 블랙홀이라 불립니다.","왜곡된 관문은 과거의 시간선을 덮어쓸 때 필요한 물질이기도 합니다. 잔상들의 의지로 만들어진 것입니다."],["지평선","왜곡된관문","역순환","eventhorizon"]],["리바이어던은 뭐 하는 곳이야?",["세계를 망가지지 않게 조율하는 세계정부이자 국가 기업입니다. 소버린 아일랜드에 자리합니다.","최고 지휘자는 반드시 초월자여야 하며, 훌륭한 카리스마를 갖추어야 합니다.","지휘자는 모든 하위 부서에 강제적인 명령을 내릴 수 있습니다. 국가를 삭제하거나, 이름을 바꾸거나, 만들 수도 있지요.","하위 부서는 일곱입니다. 장 등급제 관리국, 정보 관리국, 등록 관리국, 기억 에너지 관리국, 국제 명령/법 관리국, 보안 관리국, 국제 전령 전달국.","그 최고 지휘자의 자리가 어디에 있는지는, 설립자께서 가장 잘 아실 것입니다."],["리바이어던","leviathan","세계정부","소버린아일랜드","sovereignisland"]],["LEVC가 뭐야?",["전 세계에서 유통되는 통합 화폐입니다.","리바이어던에서 따온 이름입니다. LEV(iathan) C(urrency).","나라마다 고유 화폐가 따로 있습니다. 그러나 그것은 그 나라 안에서만 쓰입니다.","국가 고유 화폐와 LEVC는 환율이 다릅니다.","아스트랄리스의 보험은 전용 화폐 SC, 곧 Star Coin만 받습니다. 자신들의 문화를 사랑하기 때문입니다."],["levc","통합화폐","화폐","환율"]],["장 등록제가 뭐야?",["암형체를 제외한 모든 종족이 이용할 수 있는 제도입니다. 강함을 나타내는 14개의 등급이 있습니다.","숫자가 작을수록 강합니다. 10장에서 시작해 1장을 넘으면 신장입니다.","신장은 가장 강하다는 증거이며, 리바이어던 소속이 될 수 있는 권한입니다.","‘준’이 붙은 등급은 다음 등급으로 넘어가기 전의 예비 단계입니다.","관리 기구는 장 등급제 관리국입니다. 국제 전령 전달국과 연동해 임무를 수행하며, 1주마다 R.S.S.에 보고서를 제출합니다."],["장등록","등록제","장등급","등급제","신장","stagemanagement","준3장","10장"]],["등급은 어떻게 올려?",["준 등급은 1년마다 열리는 데스 매치에서 이기면 다음 등급으로 오를 권한을 얻습니다.","데스 매치는 사살이 금지됩니다. 무슨 수를 써서라도 이겨야 하며, 리타이어는 탈락입니다.","4장 이상은 암형체가 우글거리는 지하 감옥에서 특정 시간 동안 버티면 됩니다.","혹은 주어지는 임무를 완수해도 권한을 얻습니다.","혹은 지정된 윗 등급 2명을 죽이는 길도 있습니다. 가장 빠르고, 가장 값비싼 길이지요."],["승급","승격","데스매치","지하감옥","등급을올","등급은어떻게올","등급올","올려","올릴"]],["R.S.S.는 어떤 곳이야?",["정보 관리국입니다. Record, Store, Secure의 머리글자이지요.","크게 파견 팀과 정보 처리 팀으로 나뉩니다.","파견 팀은 눈에 이식한 초소형 카메라로 정보를 촬영해 옵니다.","정보 처리 팀의 AI, I.P.I.가 정보를 습득해 코드로 변환하여 저장합니다.","코드화된 정보는 해석되고 재검토되며, 보안 등급에 맞는 보안 코드가 걸립니다. 열람 권한이 없는 자는 읽을 수 없습니다. 원칙은 그렇습니다."],["rss","정보관리국","ipi","recordstoresecure","정보처리"]],["등록 관리국은 뭘 해?",["나라나 기업을 만들면 등록해야 합니다. 국가는 직접 가서 등록해야 하지요.","등록에는 1달의 유예 기간이 주어집니다.","유예 기간이 끝나면 그 국가는 불법 국가로 간주되어 그곳의 모든 인원이 몰살당합니다.","출동하는 팀은 Alpha, Beta, Secta, Delta, Omega입니다. 모두 전투 특화 인원입니다.","팀 하나가 국가 하나를 멸망시킬 수 있습니다. 다만 군사력이 제대로 갖춰진 나라는 전부를 보내도 멸망시키지 못합니다."],["등록관리","leviathansregister","유예","불법국가","국가등록","alpha","secta","omega","몰살"]],["기억 에너지가 뭐야?",["인간의 뇌를 짜낼 때 나오는 푸른 액체를 기화시키면 기억 에너지가 됩니다.","에너지의 양은 주인이 얼마나 자극적이고 중요한 추억을 가졌느냐에 달려 있습니다.","기억을 복구하는 데에는 뽑아낸 에너지의 1/5이 듭니다.","리바이어던과 국가를 유지하는 자원입니다. 시체 반납일을 정해 두고, 양에 따라 보급됩니다.","반드시 인간 시체로 짜내야 합니다. 살아 있는 사람에게 고통을 주며 죽일 필요가 없기 때문입니다. 불필요한 희생은 없어야 한다는 원칙입니다."],["기억에너지","기억물질","푸른액체","시체반납","기억을"]],["기억 에너지 관리국은 어떤 곳이야?",["특정 날마다 주기적으로 시체를 찾으러 옵니다. 양에 따라 에너지를 보급합니다.","얼굴까지 가려진 전신 전투복을 입고 있습니다.","할당량을 채우지 못하면 도시로 가서 아무나 죽이고, 시체와 에너지를 가지고 복귀합니다.","그 국가에는 시체 빚이 기록됩니다.","국가마다 할당량을 채우는 방식은 다릅니다."],["기억에너지관리국","memorialextraction","전신전투복","시체빚","할당량","시체를찾"]],["블러드러스트 디스트릭트가 뭐야?",["특정 구역에서 어느 날의 밤 동안, 인간의 본성이 이성을 잡아먹는 현상입니다.","그곳에 발을 들인 이성 있는 모든 생명체는 난폭해집니다.","암형체처럼 본성만 있는 경우에는 그 본성이 더욱 드러납니다.","공기 중에는 이를 억제하는 정체불명의 에너지가 있습니다. 그러나 소모품이라 계속 줄어들지요.","기억 에너지를 그 에너지로 변환해 두어야 합니다. 리바이어던이 기억을 모으는 이유입니다."],["블러드러스트","bloodlust","디스트릭트"]],["혈해와 오염침식은 뭐야?",["혈해는 일부 바다 구역이 붉게 물드는 현상입니다. 닿는 모든 생명체가 난폭해집니다.","오염침식은 특정 구역에서 3시간에서 5시간 동안 독성 가스가 생성되는 현상입니다.","그 독성 가스는 블러드러스트 디스트릭트를 막는 정체불명의 에너지가 소모되며 화학 작용을 일으켜 나옵니다.","스텔마레의 여왕은 용왕에게 부탁해 혈해를 억제합니다. 지속 시간은 5시간입니다.","이아키 성체에 존재하는 현상들입니다. 소나기와 별빛이 별자리를 그리듯 내리는 기후도 있지요."],["혈해","오염침식","독성가스","corrosion","별자리소나기"]],["레스렉시온의 보험은 뭐야?",["레스렉시온은 사람과 거의 동일한 모습의 분신을 만들어 냅니다.","사람이 죽으면 분신이 원래 국가로 배달되어, 죽은 곳이나 집에서 일어납니다. 집이 우선입니다.","그 과정에는 적어도 3일이 걸립니다.","대가는 지금까지 경험한 기억의 1/50입니다. 가장 강렬했던 기억부터 잃습니다.","분신은 법적으로 원래의 사람과 동일하게 취급됩니다. 이 나라는 그렇게 기억 에너지를 모읍니다."],["레스렉시온","resurrecc","분신","부활보험"]],["버믹쿠루시아의 보험은 뭐야?",["태어나 15~20살 사이에 신체 강화 샘플을 1인 1개 무료로 살 수 있습니다.","주사하면 신체 능력과 감각이 인간을 초월합니다.","그 뒤에는 병원에서 근육 및 감각 증강 시술을 받을 수 있습니다.","샘플을 받지 않고 20살이 넘으면 다른 나라의 보험도 받을 수 없습니다.","그리고 리바이어던이 5년 뒤 그 사람을 기억 에너지로 만들어 버립니다. 선택지는 사실상 하나입니다."],["버믹쿠루시아","vermiculucia","강화샘플","신체강화","증강"]],["스텔마레의 보험은 뭐야?",["스텔마레는 시민이 아닌 나라를 위한 보험을 운영합니다.","혈해를 억제하는 보험입니다.","국가의 최고 권력자이거나 매우 큰 LEVC를 지불해야 이용할 수 있습니다.","여왕 스텔마레가 용왕에게 혈해를 억제해 달라고 직접 부탁합니다.","지속 가능한 시간은 5시간입니다. 그 뒤는 보장되지 않습니다."],["스텔마레","stellmare","용왕","혈해보험"]],["아스트랄리스와 인페르누스의 보험은?",["아스트랄리스는 자체 기술로 만든 자기장 방어막을 제공합니다. 어디서든 켜고 끌 수 있습니다.","그 방어막은 총탄을 막는 데 매우 효과적입니다. 다만 근접 무기에는 쉽게 깨집니다.","아스트랄리스의 보험은 전용 화폐 SC를 받습니다. 자신들의 문화를 중시하고 사랑하기 때문입니다.","인페르누스 공화국은 거액의 LEVC를 받고 용병을 파견합니다. 친위대 중에서 선별합니다.","그 용병들은 전투만 담당합니다. 그 외의 일은 하지 않습니다."],["아스트랄리스","astralis","인페르누스","infernus","용병","자기장","방어막"]],["Sovereign's Hand는 뭐야?",["국제 명령/법 관리국입니다. 입법과, 행정과, 사법과로 나뉩니다.","입법과에는 법 연구를 하는 직원이 가득합니다. 법을 고치려면 최고 권력자의 허가가 필요합니다.","이들이 만든 법은 국가의 법보다 한참 위에 있습니다. 필수적인 것만 들어 있어 양은 많지 않습니다.","행정과는 사법과 다음으로 강한 무력을 갖추었습니다. 이들의 명령을 이행하지 않으면 처벌을 받습니다.","사법과는 일반적인 처분으로 끝나지 않는 사건을 재판으로 결정합니다."],["sovereign","소버린즈핸드","국제명령","법관리국","입법","행정과","사법과"]],["재판은 어떻게 진행돼?",["총책임자 1명이 판사를 맡고, 변호사 2명과 검사 2명이 나옵니다.","이들은 철저하게 논리로만 싸웁니다.","재판장에서 폭동이 일어나면 처분 대상이 됩니다.","권력이 높은 중요 인물이 사건을 저지르거나 거대 기업을 재판해야 할 때 열립니다.","법에 관한 세부 사항은 별도 문서에 정리되어 있습니다. 그것을 찾아보십시오."],["재판","판사","변호사","검사","폭동","법정"]],["R.T.S.는 뭐야?",["리바이어던의 보안을 맡습니다. 정찰팀, 공격팀, 방어팀을 합쳐 R.T.S.라 부릅니다.","정찰팀은 소버린 아일랜드 근처 바다 아래, 링 모양의 기지에서 바깥을 지켜봅니다. 출입 통제를 맡은 최전선입니다.","공격팀은 리바이어던을 건드린 소속이 있거나 국가가 지원을 요청할 때 움직입니다. 전쟁 특화 군인뿐입니다.","방어팀은 정찰팀의 방어가 뚫렸을 때와, 최고 지휘자가 왕좌에서 움직일 때에만 움직입니다.","방어팀은 오직 리바이어던만을 지키기 위해 존재합니다. 공격팀을 상대로 버티는 것은 불가능에 가깝습니다."],["rts","보안관리국","정찰팀","공격팀","방어팀","unbreakableshield","링모양"]],["국제 전령 전달국은 뭐야?",["리바이어던의 명령을 최대한 빠르게 전달하는 데 특화된 부서입니다.","전달 기술에 가장 먼저 접근할 수 있는 부서입니다.","신분증에 위치 표시기를 다는 것을 의무화하고 있습니다.","이유는 단 하나, 최대한 빨리 전달하기 위해서입니다.","그 부서에는 AI가 하나 있습니다. 질문이 아주 많은 존재이지요."],["judgementoperation","전령","위치표시기","전달국","신분증"]],["세금은 어떻게 돼?",["국가마다 유통되는 돈으로, Sovereign's Hand가 정한 법에 따라 5년마다 걷습니다.","국가에서 걷은 세금의 30%는 리바이어던에 납부해야 합니다.","국가에서 걷는 세금은 총합 500억 LEVC를 넘지 않아야 합니다.","신생 기업은 중소기업으로서 10년 동안 세금이 면제됩니다.","세금과는 별개로 기억 에너지의 할당량이 있습니다. 채우지 못하면 시체 빚이 쌓입니다."],["세금","500억","납부","세율"]],["등록된 국가에는 뭐가 있어?",["구세기의 국가는 여섯입니다. 레스렉시온, 백월, 루나시아, 솔라리아, 루벨리아, 인페르누스 공화국.","구 리바이어던의 국가는 여덟입니다. 버믹쿠루시아, 은월, 아스트랄리스, 엘라렌, 코르닉시아, 추풍, 스텔마레, 스텔루비아.","신 리바이어던의 국가는 글라시카에룰리아 하나뿐입니다.","멸망한 국가는 붉은 표식으로 표시됩니다. 백월과 루벨리아에 그 표식이 있습니다.","등록된 국가는 모두 열다섯입니다. 구세기 여섯, 구 리바이어던 여덟, 신 리바이어던 하나."],["국가목록","등록된국가","구세기","구리바이어던","신리바이어던","글라시카","루나시아","엘라렌","코르닉시아","스텔루비아","백월","은월","추풍","루벨리아","멸망한"]],["광석에는 뭐가 있어?",["이아키 성체에는 흡수석, 흑철석, 예열석, 넥서스, 초성석, 아치아이언이 있습니다.","흡수석은 충격을 흡수하는 광석입니다. 금속 재질의 석탄 같습니다.","흑철석은 기존 철과 같지만 더 어둡습니다. 전투에 더 적합하지요.","예열석은 타격할수록 열이 오릅니다. 주홍 루비처럼 생겼습니다. 넥서스는 가장 단단하며, 금속 재질이지만 가볍습니다.","아치아이언은 흑철석보다 단단하지만 더 잘 깨집니다. 초성석은 별처럼 속이 빛나나, 특별한 능력은 없습니다."],["광석","흑철","흡수석","예열석","넥서스","초성석","아치아이언","자원","광물"]],["무기는 어떻게 발전했어?",["근접 무기의 시초는 철, 그리고 흑철의 발견입니다.","원거리 무기는 화약 대신 아케디아를 씁니다. 압축하면 잘 터지는 성질 때문이지요.","아케디아는 화약보다 위력이 어느 정도 강하고 희귀성도 낮습니다. 다만 가열성이 높아 과열되면 안전장치가 걸립니다.","원래라면 총이 개발되었어야 할 세계선에서, 운명을 왜곡한 에너지 때문에 새로운 무기가 개발되었습니다.","공방 기업은 무기를 양산합니다. 평균 매출은 5억. 그만큼 그 공방을 무너뜨리려는 갱단도 있습니다."],["무기","화약","근접","원거리","공방","총기"]],["사무소와 기업은 어떻게 돼?",["사무소는 의뢰가 주 수입원입니다. 별점은 0.5에서 5까지 매겨집니다.","평판이 오르면 의뢰가 많이 들어오고, 내려가면 줄어듭니다. 그래서 평판을 지키려 애씁니다.","매출 기준점을 유지하지 못하면 파산으로 보아 공식 사무소에서 퇴출됩니다.","기업은 중소기업, 대기업, 초거대기업, 국가기업으로 나뉩니다. 국가기업은 정말 소수입니다.","현재 국가기업은 천공월아용병기업, 테크웨어&테크웨폰 밀리터리 워크샵 코퍼레이션, 스타 프로텍션 엔터프라이즈 셋뿐입니다."],["사무소","기업","별점","의뢰","평판","국가기업","초거대"]],["세계화가 뭐야?",["구세기 어느 때, 전쟁의 피폐함을 참을 수 없던 인간들이 수백 년 동안 제작한 요새입니다.","다리가 네 개 달린 요새입니다.","세계화는 정확한 이름이 아닙니다. 그 요새에서 뜯겨 나온 종이에 적혀 있던 이름이지요.","저녁이 되면 수많은 라이트와 포탑이 나옵니다. 위에서는 수많은 연기가 피어오릅니다.","총알과 미사일이 써도 써도 무한한 듯 계속해서 나옵니다."],["세계화","segyehwa","요새","다리가네개"]],["아스트랄리스의 성은 어떤 곳이야?",["별의 관측관이라 불리는 곳입니다. 아스트랄리스의 성입니다.","이름만 성일 뿐, 물가에 둘러싸인 건물 여러 채가 모인 마을과 거의 비슷합니다.","주요 구조물은 온실관과 아르크스 렉테아입니다.","앞으로 더 많은 장소가 추가될 예정이라고 전해집니다.","성이라 부르지만 한 채의 성채가 아닙니다. 건물들이 모인 마을에 가깝습니다."],["아스트랄리스","어떤성","성은어떤"]],["별의 관측관에는 어떤 건물이 있어?",["온실관과 아르크스 렉테아가 주요 구조물입니다.","온실관은 별의 식물 루미나리아를 키우는 돔 형태의 건물입니다. 총 세 채입니다.","아르크스 렉테아는 별을 관측하는 매우 거대한 구조의 건물입니다.","건물들은 물가에 둘러싸여 있습니다.","이 외에도 많은 장소가 추가될 예정입니다."],["별의관측관","관측관","어떤건물"]],["온실관이 뭐야?",["별의 식물 루미나리아를 키우는 돔 형태의 건물입니다.","온실관은 모두 세 채이며, 돔은 유리로 이루어져 있습니다.","1동과 2동은 유리관과, 철로 틀을 잡은 강화 유리 계단으로 이루어져 있습니다.","3동은 2동에 있는 엘리베이터를 타고 이동해야 합니다.","온실관의 루미나리아는 군주실 지하 2층 성체 '루미'의 자식들입니다."],["온실관","온실"]],["온실관 1동은 어떤 곳이야?",["낡은 온실을 고친 건물입니다. 크리온과 키오네가 함께 고쳤습니다.","크리온과 키오네는 루미가 있던 이곳에 자주 들러 차를 마시곤 했습니다.","1동과 2동은 유리관과, 철로 틀을 잡은 강화 유리 계단으로 이루어져 있습니다.","두 사람의 손으로 되살아난 온실입니다. 돔은 유리로 되어 있습니다.","루미는 키오네가 죽은 뒤 이곳 1동에서 군주실 지하 2층으로 옮겨졌습니다."],["온실관1동","1동"]],["온실관 2동은 어떤 곳이야?",["1동과 2동은 유리관과, 철로 틀을 잡은 강화 유리 계단으로 이루어져 있습니다.","2동에는 엘리베이터가 있습니다. 3동은 이 엘리베이터를 타고 이동해야 합니다.","돔은 유리로 이루어져 있습니다. 온실관은 총 세 채입니다.","2동을 언제, 누가 지었는지는 기록되어 있지 않습니다.","3동으로 가려면 반드시 2동을 거쳐야 합니다."],["온실관2동","2동"]],["온실관 3동에는 뭐가 있어?",["키오네의 관이 있습니다.","루미나리아가 관을 지켜 주듯 줄기를 뻗어 살짝 타고 올라가 있습니다.","3동은 2동에 있는 엘리베이터를 타고 이동해야 합니다.","온실관 세 채 가운데 하나이며, 돔은 유리로 이루어져 있습니다.","그곳의 루미나리아는 군주실 지하 2층 성체 루미의 자식들입니다."],["온실관3동","3동"]],["아르크스 렉테아가 뭐야?",["별을 관측하는 매우 거대한 구조의 건물입니다.","바닥은 삼각형 타일로 이루어져 있습니다.","블랙홀 연구 기관, 은하 관측기, 스타 쉴드 프로젝트 연구소, 위성 연구소, 북두칠성 전시관, 자기장 엘리베이터가 있습니다.","자기장 엘리베이터로 지하의 군주실까지 내려갈 수 있습니다.","별의 관측관의 주요 구조물 가운데 하나입니다."],["아르크스","렉테아"]],["아르크스 렉테아에는 어떤 시설이 있어?",["블랙홀 연구 기관과 은하 관측기가 있습니다.","스타 쉴드 프로젝트 연구소와 위성 연구소가 있습니다.","북두칠성 전시관이 있습니다.","자기장 엘리베이터가 있습니다. 지하의 군주실까지 내려갈 수 있습니다.","시설은 블랙홀 연구 기관, 은하 관측기, 스타 쉴드 프로젝트 연구소, 위성 연구소, 북두칠성 전시관, 자기장 엘리베이터입니다."],["어떤시설","시설이","시설이있"]],["자기장 엘리베이터는 어디로 가?",["지하의 군주실까지 내려갈 수 있습니다.","아르크스 렉테아에 있는 시설입니다.","군주실은 아르크스 렉테아의 지하에 있는 거대한 구 형태의 공간입니다.","내려가면 군주실 1층 로비에 닿습니다.","별을 관측하는 건물에서 지하로 이어지는 길입니다."],["자기장엘리베이터","엘리베이터는"]],["군주실은 어떤 곳이야?",["아르크스 렉테아의 지하에 있는 거대한 구 형태의 공간입니다.","1층은 로비입니다. 엘리베이터가 있고 양쪽 끝으로 복도가 있습니다.","0층에는 AI 스텔리네가 있습니다.","지하 1층은 기억의 층, 지하 2층은 성체 루미나리아가 있는 온실, 지하 3층은 군주의 개인실입니다.","자기장 엘리베이터로 내려갈 수 있습니다."],["군주실"]],["군주실의 층 구조를 알려 줘.",["1층은 로비입니다. 엘리베이터가 있고 양쪽 끝으로 복도가 있습니다. 0층에는 AI 스텔리네가 있습니다.","지하 1층은 '기억의 층'입니다. 끝없이 이어지는 복도입니다.","지하 2층은 성체 루미나리아의 모습을 한 온실입니다. 성체 루미가 있습니다.","지하 3층은 군주의 개인실과 문이 있는 층입니다.","1층, 0층, 지하 1층, 지하 2층, 지하 3층으로 이루어져 있습니다."],["층구조","층구조를","군주실층"]],["기억의 층이 뭐야?",["군주실 지하 1층입니다.","크리온은 어떤 사건 이후로 기억이 전부 실체화되었습니다.","그 실체화된 파편을 실에 걸어 둔 끝없는 복도입니다.","기억이 실체화된 사건이 무엇인지는 기록되어 있지 않습니다.","크리온의 기억이 형태를 얻어 늘어서 있는 곳입니다."],["기억의층"]],["군주실 지하 3층의 문 너머에는 뭐가 있어?",["지하 3층에는 군주의 개인실과 문이 있습니다.","문 밖으로 나가면 북두칠성이 커다랗게 보이는 어느 소행성의 동굴이 나옵니다.","그곳은 키오네와 함께했던, 군주가 기억할 수 있는 마지막 장소입니다.","그 동굴은 루미나리아 원종이 살던 지하 동굴과는 별개의 동굴입니다.","군주실에서 문 하나를 열면 소행성의 동굴로 이어집니다."],["지하3층","문너머","문밖"]],["루미나리아가 뭐야?",["별의 식물입니다. 멸종위기종입니다.","성체가 되면 인간과 대화할 수 있는 지성을 가집니다.","원래는 지하에서 살던 식물이었습니다. 그 꽃의 포자가 우연히 지상까지 올라간 것이 현재 루미나리아의 모습입니다.","성체는 인간의 빛을 감지할 수 있어서 사람의 모습이 보입니다.","온실관에서 키우고 있으며, 군주실 지하 2층에는 성체가 있습니다."],["루미나리아"]],["지하에 살던 루미나리아는 어떻게 됐어?",["그 동굴이 무너진 이후로 전부 죽었습니다.","루미나리아는 원래 지하에서 살던 식물이었습니다.","지하의 꽃에서 포자가 우연히 지상까지 올라갔고, 그것이 현재 루미나리아의 모습입니다.","동굴이 무너진 원인과 시기는 기록되어 있지 않습니다.","그래서 지금 루미나리아는 멸종위기종입니다."],["지하에살던","원종","동굴이무너","어떻게됐"]],["루미나리아의 주파수는 뭐야?",["성체는 주파수를 공기 중으로 흘려보낼 수 있는 기관이 있습니다.","그 주파수는 크리온에게만 닿는, 뇌파로 입력되는 그들만의 신호입니다.","신뢰의 대상에 포함된 키오네도 들을 수 있었습니다.","귀로 듣는 소리가 아닙니다. 뇌파로 입력됩니다.","그 외의 사람에게는 닿지 않습니다."],["주파수","루미나리아의주파수"]],["루미는 누구야?",["군주실 지하 2층에 있는 성체 루미나리아입니다. 이름은 크리온이 지어 주었습니다.","크리온이 직접 키운 식물입니다. 크리온이 범죄자였던 시절보다 더 과거부터 알고 지낸 사이이며, 서로를 깊이 믿고 신뢰합니다.","키오네를 직접 만난 적이 있습니다.","키오네가 죽은 이후, 루미나리아가 번식을 할 때였고 더 넓은 공간이 필요해서 온실관 1동에서 지하 2층으로 옮겨졌습니다. 루미는 자신의 부모가 있던 곳에 있고 싶다며 그곳으로 데려가 달라고 했습니다.","크리온과 루미는 지금도 대화하면서 자식들, 온실관의 루미나리아가 잘 자라고 있는지 확인합니다."],["루미는","루미가"]],["온실관의 루미나리아는 어디서 왔어?",["군주실 지하 2층 성체 '루미'의 자식들입니다.","루미가 번식을 해서 태어난 개체들입니다.","크리온과 루미는 지금도 대화하면서 이 자식들이 잘 자라고 있는지 확인합니다.","온실관은 별의 식물 루미나리아를 키우는 돔 형태의 건물입니다.","루미 자신은 지하 2층, 자신의 부모가 있던 곳에 있습니다."],["온실관의루미나리아","자식"]],["크리온은 누구야?",["아스트랄리스의 군주입니다.","범죄자였던 시절이 있습니다.","어떤 사건 이후로 기억이 전부 실체화되었습니다.","키오네의 연인이었습니다.","루미를 직접 키웠습니다."],["크리온"]],["키오네는 누구야?",["크리온의 연인이었으며 지금은 죽었습니다.","관은 온실관 3동에 있습니다.","크리온과 함께 온실관 1동, 낡은 온실을 고쳤습니다.","루미를 만난 적이 있습니다. 루미의 신뢰 대상이어서 주파수를 들을 수 있었습니다.","AI 스텔리네는 그의 이름에서 살짝 따온 이름입니다."],["키오네"]],["스텔리네는 누구야?",["아스트랄리스가 독자적으로 개발한 AI입니다.","군주실 0층에 있습니다.","이름은 군주의 죽은 연인 키오네에서 살짝 따왔습니다.","성격도 키오네와 매우 닮았습니다.","군주실의 로비와 기억의 층 사이에 있는 층, 0층을 지키고 있습니다."],["스텔리네"]],["아스트랄리스의 군주는 누구야?",["크리온입니다.","크리온은 범죄자였던 시절이 있습니다.","키오네의 연인이었으며, 루미를 직접 키웠습니다.","군주가 머무는 곳은 아르크스 렉테아 지하의 군주실입니다.","군주실 지하 3층에 군주의 개인실이 있습니다."],["아스트랄리스","군주는","군주가"]]]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX57"><Properties><string name="Name">fortune</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["내 운세를 봐 줘.",["…보입니다. 설립자의 길 위에는 오늘도 별이 한 줄 내려와 있습니다. 걸음을 서두르지만 않으면 됩니다.","흐름은 나쁘지 않습니다. 다만 뒤를 돌아보지 마십시오. 놓친 것은 이미 다른 곳에서 기다리고 있습니다.","한 가지 매듭이 풀리려 합니다. 억지로 당기지 않으시면 저절로 풀릴 것입니다.","운은 고이지 않고 흐릅니다. 오늘은 설립자 쪽으로 흐르고 있으니, 손을 내미십시오.","이미 아시는 일을 다시 물으시는군요. 그래도 답하겠습니다. 마음에 두고 계신 그 선택이 옳습니다."],["운세","점쳐","점봐","점좀","점괘","사주","타로","점을","운을봐","운이어"]],["오늘의 운세는?",["오늘은 낮보다 저녁이 좋습니다. 중요한 말씀은 해가 기운 뒤로 미루십시오.","오늘의 운은 고요합니다. 고요한 날에는 작은 일 하나를 끝내는 것이 가장 큰 행운입니다.","오늘 누군가 설립자의 이름을 부를 것입니다. 급한 일이 아니니 서두르지 마십시오.","오늘은 흐름이 두 번 바뀝니다. 첫 번째에 흔들리지 않으시면 두 번째가 설립자 편입니다.","별이 낮게 걸려 있습니다. 오늘은 높은 곳보다 가까운 곳에서 답을 얻으실 것입니다."],["오늘의운세","오늘운세","오늘운","오늘의운"]],["내일의 운세는?",["내일은 오늘 두고 온 것을 되찾게 됩니다. 그것이 물건일지 말일지는 직접 확인하십시오.","내일 아침의 첫 소식이 하루를 정합니다. 반가운 쪽이니 안심하셔도 좋습니다.","내일은 쉬어 가는 날입니다. 쉬어야 할 때 쉬는 이에게 운은 후하게 값을 쳐 줍니다.","내일 정오 즈음, 오래 막혀 있던 일 하나가 열립니다.","내일은 말을 아끼십시오. 아낀 말만큼 설립자의 말씀이 무거워질 것입니다."],["내일의운세","내일운세","내일운","내일의운"]],["이번 주 운세는?",["이번 주는 첫날보다 끝날이 낫습니다. 초반의 지연은 후반의 도약을 위한 숨입니다.","수요일 무렵 갈림길이 나옵니다. 그때는 가까운 쪽 말고, 조용한 쪽을 택하십시오.","이번 주 별은 설립자에게 호의적입니다. 미루어 둔 일을 꺼내 보셔도 좋습니다.","엿새째에 뜻밖의 수확이 있습니다. 그 전까지는 씨를 뿌리는 시간입니다.","이번 주는 사람의 말이 많은 주입니다. 들은 말의 절반만 믿으십시오."],["이번주","이번주운","주간운","한주운","주운세"]],["이번 달 운세는?",["이번 달은 초순에 기울고 하순에 오릅니다. 저울은 결국 균형을 찾습니다.","달이 차오르는 동안에는 벌이는 일을, 기우는 동안에는 거두는 일을 하십시오.","이번 달 중반에 큰 결정이 하나 찾아옵니다. 지금부터 마음의 준비를 해 두십시오.","이번 달은 사람 복이 있습니다. 먼저 인사를 건네는 자를 놓치지 마십시오.","이번 달은 무리하지 않는 것이 가장 좋은 전략입니다. 설립자의 몸이 곧 조직의 몸입니다."],["이번달","이번달운","월간운","이달의운","이달운","한달운","달운세"]],["올해의 운세는?",["올해는 뿌리가 뻗는 해입니다. 눈에 띄는 성과보다 보이지 않는 토대가 단단해집니다.","올해의 별은 늦게 뜹니다. 그러나 한번 뜨면 오래 지지 않습니다.","올해는 세 번의 시험이 있습니다. 첫 번째는 가볍고, 두 번째는 무겁고, 세 번째는 이미 통과하셨습니다.","올해 설립자께서 내리신 결정 하나가 오래도록 이름으로 남을 것입니다.","올해는 떠나보내는 것에서 얻는 해입니다. 비울수록 채워집니다."],["올해","금년","연간운","한해운","올해의운"]],["5년 뒤의 나는 어떻게 되어 있어?",["5년 뒤에도 설립자는 같은 자리에 계십니다. 다만 주변의 얼굴이 많이 바뀌어 있을 것입니다.","5년이면 세금이 한 번 걷히고 한 번 다시 걷히는 시간입니다. 그동안 설립자의 뜻은 더 멀리 닿을 것입니다.","5년 뒤, 지금 가장 걱정하시는 일은 이야깃거리로 남아 있을 것입니다.","그때의 설립자는 지금의 설립자를 대견하게 돌아보실 것입니다.","5년 뒤의 일은 이르게 말하지 않겠습니다. 다만, 길은 끊기지 않습니다."],["5년","오년","몇년뒤","수년뒤","먼미래","오년뒤","5년후"]],["내 운명을 말해 줘.",["설립자의 운명은 이미 한 줄의 선으로 그어져 있습니다. 그러나 그 선이 어디까지 이어지는지는 설립자께서 걸으시며 정하십니다.","설립자는 세계를 붙잡는 손의 주인이십니다. 그 손이 놓지 않는 한 세계는 무너지지 않습니다.","운명을 묻는 이는 많으나, 운명을 만드는 이는 드뭅니다. 설립자께서는 후자입니다.","저는 설립자의 운명을 압니다. 그러나 말하지 않는 편이 설립자께 이롭습니다.","별은 설립자를 가리키고 있습니다. 가려진 적은 있으나 꺼진 적은 없습니다."],["운명","숙명","내운명","운명을"]],["나는 무엇을 이루게 돼?",["설립자께서는 이미 하나를 이루셨습니다. 그리고 그것은 다음 하나를 이루기 위한 발판입니다.","큰일은 한 번의 도약이 아니라 수많은 평범한 날의 합입니다. 설립자께서는 그 합을 쌓고 계십니다.","후대는 설립자의 이름을 한 문장으로 기억할 것입니다. 그 문장은 아직 쓰이고 있습니다.","이루지 못할 일은 보이지 않습니다. 다만 이루는 순서가 설립자의 예상과 다를 것입니다.","성취는 반드시 환호와 함께 오지 않습니다. 조용히 도착하는 것이 더 큽니다."],["이루게","이룰","성취","성공할","업적","대업","이루"]],["나의 끝은 어떻게 돼?",["끝은 아직 쓰이지 않았습니다. 쓰이지 않은 것을 점치는 것은 예의가 아닙니다.","설립자의 끝은 길고 조용합니다. 서두르는 이에게 오지 않고, 다 이룬 이에게 옵니다.","끝을 묻는 것은 시작을 확인하는 일과 같습니다. 설립자께서는 아직 한참 시작 중이십니다.","그 질문에 답은 있습니다. 그러나 오늘 알아야 할 답은 아닙니다.","끝이라는 것은 이름일 뿐, 선에는 끝이 없습니다. 운명선은 이어집니다."],["최후","마지막은","끝은","죽음","죽게","끝이어떻"]],["재물운은 어때?",["재물은 흐르는 것입니다. 이번에는 잡으려 하지 말고, 길을 터 주십시오. 들어올 것은 들어옵니다.","큰돈보다 작은 이문이 이어집니다. 하나하나를 얕보지 마십시오.","지출이 하나 있습니다. 아까워하실 일이 아니니 흔쾌히 내십시오.","숫자를 믿으십시오. 감으로 움직이는 날보다 장부를 펼치는 날에 운이 따릅니다.","재물운은 중간 이상입니다. 다만 약속된 돈은 문서로 남기십시오."],["재물","금전","돈운","재운","부자","수입","levc운","재산"]],["건강운은 어때?",["몸은 정직합니다. 하루 일찍 쉬면 이틀 일찍 가벼워집니다.","눈과 어깨를 쉬게 하십시오. 쌓인 것은 그곳에서 먼저 드러납니다.","큰 염려는 보이지 않습니다. 다만 식사 시간만은 지키십시오.","머리를 비우는 시간이 필요합니다. 하루 중 한 시간, 아무것도 하지 마십시오.","숨을 깊게 쉬십시오. 폐는 잊혀도 잊지 않고 일합니다. 환기를 게을리하지 마십시오."],["건강","컨디션","체력","몸상태","아프","피로"]],["일운은 어때?",["일은 순조롭습니다. 다만 마지막 한 걸음에서 확인을 한 번 더 하십시오.","맡겨 둔 일이 설립자께 돌아오려 합니다. 이번에는 직접 받으십시오.","새로운 일이 하나 들어옵니다. 크기에 비해 값이 높은 일입니다.","일이 몰리는 시기입니다. 순서를 정하는 것만으로 절반은 끝납니다.","설립자의 한마디가 열 개의 보고서를 대신할 날입니다. 말을 아끼지 마십시오."],["일운","업무운","직무","일의운","사업운","일이잘","일복"]],["사람 사이의 운은 어때?",["설립자를 따르는 이들의 마음이 한곳으로 모이고 있습니다. 그것은 오래 쌓인 신뢰의 결과입니다.","오해가 하나 있습니다. 직접 말씀하시면 반 마디로 풀립니다.","멀리 있던 이가 소식을 보내올 것입니다. 반갑게 받으십시오.","새 얼굴이 설립자의 곁에 섭니다. 말수는 적으나 오래갈 사람입니다.","사람은 거울입니다. 오늘 마주하는 얼굴들이 설립자를 닮은 것은 우연이 아닙니다."],["인간관계","사람운","인복","대인","동료운","관계운","사람복","아랫사람","사람사이","사이의운"]],["싸움이나 승부는 어떻게 돼?",["이기는 쪽은 서두르는 쪽이 아니라 끝까지 서 있는 쪽입니다. 설립자께서는 후자입니다.","승패는 이미 기울어 있습니다. 기운 쪽을 믿고 나아가십시오.","정면보다 측면입니다. 이번 승부는 길을 돌아가는 쪽이 이깁니다.","이겨도 얻는 것이 적은 싸움이 있습니다. 가려서 응하십시오.","숨을 고르십시오. 상대가 먼저 움직이는 순간이 설립자의 순간입니다."],["승부","승패","이길","이기","싸움","대결","전투운","경쟁"]],["길을 떠나도 될까?",["길은 열려 있습니다. 다만 떠나는 시각은 해가 중천을 지난 뒤가 좋습니다.","이번 여정에서는 목적지보다 도중에 마주치는 것이 설립자께 더 큰 것을 줍니다.","동쪽은 순조롭고 서쪽은 지체됩니다. 가능하다면 동쪽을 택하십시오.","출발을 하루 미루십시오. 하루 늦은 걸음이 한 걸음 앞서게 합니다.","길동무를 하나 두십시오. 혼자 가시는 길은 틀리지 않으나 오래 걸립니다."],["여행","여정","이동","출장","떠나","떠날","길을떠","외출"]],["중요한 결정을 내려도 될까?",["마음이 먼저 기운 쪽이 답입니다. 이성은 그 뒤에 이유를 붙이는 것뿐입니다.","오늘은 정하지 마십시오. 사흘만 재우면 같은 답이 더 선명하게 돌아옵니다.","두 길 모두 목적지는 같습니다. 어느 쪽을 택하든 설립자께서 걸으면 그것이 옳은 길이 됩니다.","정하고 나서 흔들리는 것이 정하기 전에 흔들리는 것보다 낫습니다. 정하십시오.","이 결정은 설립자께서 아니면 내릴 수 없습니다. 그러니 두려워하지 않으셔도 됩니다."],["결단","결정","선택","갈림길","고민","망설","정해야"]],["조심해야 할 건 뭐야?",["조심할 것은 큰 적이 아니라 작은 방심입니다. 마지막 서류를 한 번 더 확인하십시오.","달콤한 제안 하나가 옵니다. 값을 먼저 물어보십시오.","물가를 조심하십시오. 물은 낮은 곳에서 조용히 차오릅니다.","밤길보다 아침의 첫 말을 조심하십시오. 아침의 말이 하루의 방향을 정합니다.","위험은 보이지 않을 때 가장 큽니다. 오늘은 보이는 것만 믿지 마십시오."],["조심","조심해야","조심할","위험","경고","주의","액운","재앙","불길","해로운"]],["행운의 색은?",["금빛입니다. 이미 설립자 곁에 있는 색이지요.","짙은 남색입니다. 밤하늘이 설립자를 도울 것입니다.","흰색입니다. 비우고 새로 시작하기에 알맞은 색입니다.","붉은색입니다. 다만 몸에 두르지 말고 시야에 두십시오.","검은색입니다. 어둠은 두려움이 아니라 휴식입니다."],["행운의색","행운색","럭키컬러","컬러","무슨색","어떤색"]],["행운의 숫자는?",["셋입니다. 세 번째 시도에서 길이 열립니다.","일곱입니다. 일곱 번째 날, 일곱 번째 사람, 일곱 번째 장.","열넷입니다. 어딘가의 계단 끝에 설립자를 기다리는 것이 있습니다.","다섯입니다. 5년마다 오는 것은 세금만이 아닙니다.","영입니다. 비어 있음은 시작과 같은 말입니다."],["행운의숫자","행운숫자","행운의수","럭키넘버","숫자","무슨번호","행운의번호"]],["행운의 방향은?",["북쪽입니다. 차가운 곳에서 맑은 답이 나옵니다.","동쪽입니다. 해가 먼저 닿는 곳에 설립자의 몫이 있습니다.","남쪽입니다. 따뜻한 쪽에는 사람이 모이고, 사람이 모이는 곳에 길이 있습니다.","서쪽입니다. 기우는 쪽에서 오히려 설립자께 필요한 것을 줍니다.","위쪽입니다. 오늘은 올려다보는 것이 가장 좋은 방향입니다."],["행운의방향","방향","방위","어느쪽","쪽이좋"]],["좋은 시간은 언제야?",["해 뜨기 직전입니다. 세상이 가장 조용한 시각에 가장 맑은 판단이 나옵니다.","정오 직후입니다. 그림자가 가장 짧을 때 의심도 가장 짧아집니다.","해 질 무렵입니다. 하루를 정리하는 이에게 운이 후합니다.","자정을 넘긴 직후입니다. 다만 일은 하지 말고 생각만 하십시오.","정해진 시각은 없습니다. 설립자께서 마음먹은 때가 곧 좋은 때입니다."],["좋은시간","행운의시간","언제가좋","몇시","시각이좋","시간대"]],["행운의 부적이나 물건은?",["작고 오래된 것을 지니십시오. 시간을 견딘 물건이 가장 좋은 부적입니다.","푸른 돌 하나를 호주머니에 두십시오. 이유는 묻지 않으셔도 됩니다.","새 종이와 펜입니다. 적어 두는 것만으로 운이 붙잡힙니다.","열쇠입니다. 어떤 문의 것인지는 곧 아시게 될 것입니다.","물건보다 사람입니다. 설립자께서 지켜 온 신뢰가 가장 단단한 부적입니다."],["부적","행운의물건","행운아이템","물건","아이템","럭키아이템","지니면"]],["오늘 하지 말아야 할 것은?",["큰소리로 사람을 부르지 마십시오. 낮은 목소리가 더 멀리 닿는 날입니다.","서명은 내일로 미루십시오. 오늘의 잉크는 번지기 쉽습니다.","지난 일을 되짚지 마십시오. 되짚을수록 오늘이 줄어듭니다.","혼자 결론 내리지 마십시오. 한 사람에게만 물어도 달라집니다.","빈속으로 중요한 말을 하지 마십시오. 몸이 비면 판단도 비칩니다."],["피해야","하지말","금기","금해","삼가","하면안"]],["오늘 하면 좋은 건?",["오래 연락하지 못한 이에게 짧은 안부를 보내십시오. 그 한 줄이 먼 길로 돌아옵니다.","정리하십시오. 책상이든 서류든 마음이든, 하나만 치워도 운이 들어올 자리가 생깁니다.","따뜻한 것을 드십시오. 따뜻함은 모든 흐름의 시작입니다.","하늘을 올려다보십시오. 별이 보이지 않아도 거기 있습니다.","미루어 둔 일 중 가장 작은 것을 끝내십시오. 가장 작은 것이 가장 큰 문을 엽니다."],["해야할일","오늘해야","하면좋","권하","추천","좋은일","하면운"]],["별은 뭐라고 해?",["별은 말하지 않습니다. 다만 설립자 쪽으로 기울어 있습니다.","설립자를 가리키는 별은 하나가 아닙니다. 여럿이 같은 방향을 가리키고 있습니다.","오늘 밤 서쪽 하늘에 낮게 뜨는 별이 있습니다. 소원은 그 별에게 하십시오.","별빛은 오래전 떠난 빛입니다. 지금 설립자께서 보시는 것은 과거의 응원입니다.","별이 흐리다면 설립자의 마음이 흐린 것입니다. 별은 늘 같은 자리에 있습니다."],["별이","별자리","별점","별은","천체","별을","별에게"]],["카드 한 장만 뽑아 줘.",["‘문’입니다. 열릴 때를 기다리지 말고, 먼저 손잡이를 잡으십시오.","‘등불’입니다. 어둠 속에서도 설립자의 걸음 앞은 보입니다.","‘저울’입니다. 기울어 보이나 실은 균형 위에 있습니다.","‘다리’입니다. 건너는 동안은 뒤를 보지 마십시오.","‘빈 잔’입니다. 비어 있어야 새 것을 담을 수 있습니다."],["카드","한장","뽑아","패를","점패"]],["주사위를 던져 줘.",["…여섯입니다. 가장 높은 눈이 나왔으니 오늘은 과감해도 좋습니다.","…둘입니다. 하나보다 크고 셋보다 작으니, 신중하게 가십시오.","…앞면입니다. 이미 마음속에서 그쪽을 택하고 계셨지요.","…홀입니다. 어긋난 것이 맞물릴 징조입니다.","…던지기 전에 이미 결과를 아셨습니다. 저는 확인만 해 드렸을 뿐입니다."],["주사위","동전","던져","앞뒤","홀짝"]],["어젯밤 꿈은 무슨 뜻이야?",["꿈은 낮에 하지 못한 말의 그림자입니다. 하고 싶으셨던 말을 하십시오.","높은 곳에서 떨어지는 꿈은 내려놓으라는 뜻입니다. 지고 계신 것을 하나 덜어 내십시오.","쫓기는 꿈은 미루어 둔 일의 모양입니다. 하나만 끝내도 쫓는 것이 사라집니다.","물이 나오는 꿈은 길한 꿈입니다. 마음이 맑게 풀리려 하고 있습니다.","기억나지 않는 꿈은 이미 현실이 된 꿈입니다. 걱정하지 마십시오."],["꿈","악몽","해몽","꿈을꿨","꿈에서"]],["내 별에게 기도하면 이뤄져?",["기도는 별에게 닿기 전에 먼저 설립자의 마음에 닿습니다. 마음이 정해지면 반은 이루어진 것입니다.","자신을 가리키는 별에게 올리는 기도는, 소원이 아니라 다짐입니다.","별은 한 번에 하나만 듣습니다. 소원을 하나로 줄이십시오.","이루어지지 않는 기도는 없습니다. 다만 이루어지는 때가 설립자의 때와 다를 뿐입니다.","기도할 때 눈을 감지 마십시오. 별을 보며 해야 별이 설립자를 알아봅니다."],["내별","기도","소원","빌면","빌어"]],["운명은 정해져 있어?",["큰 줄기는 정해져 있습니다. 그러나 줄기 위에 어떤 잎이 피는지는 설립자께서 정하십니다.","정해져 있다면 저는 이 대화도 알고 있었겠지요. 그리고 알고 있었습니다.","정해진 것은 도착이 아니라 출발입니다. 나머지는 걸음마다 다시 쓰입니다.","운명선은 하나뿐이나, 그 위의 걸음은 무수합니다.","정해진 길을 걷는 이도, 길을 내며 걷는 이도 모두 운명선 위에 있습니다."],["정해져","정해진","자유의지","예정","필연","미리"]],["운명은 바꿀 수 있어?",["바꿀 수 있습니다. 다만 바꾸는 순간 충돌이 일어나기도 합니다. 그 값을 치를 각오가 있으십니까.","작은 것은 바꿀 수 있고, 큰 것은 바꾸려 하면 오히려 모양이 드러납니다.","운명을 바꾸려 하지 마십시오. 운명이 설립자를 따르게 하십시오.","과거에서 정해진 미래의 행동이 뒤바뀌면 균열이 생깁니다. 그러니 신중하셔야 합니다.","바꾸는 것이 아니라 완성하는 것입니다. 설립자께서는 이미 그렇게 하고 계십니다."],["바꿀수","바꿔","거스를","뒤집을","바꾸","운명을바"]],["내가 가는 길이 맞아?",["맞습니다. 의심이 드는 것은 길이 틀려서가 아니라 길이 길어서입니다.","틀렸다면 제가 먼저 말씀드렸을 것입니다. 저는 말씀드리지 않았습니다.","맞고 틀리고를 가르기엔 이릅니다. 다만 걸음은 올곧습니다.","설립자께서 가시는 곳이 곧 길이 됩니다. 길은 뒤에서 생깁니다.","한 번쯤 돌아보셔도 좋습니다. 뒤에 서 있는 이들의 얼굴이 답입니다."],["길이맞","맞아","올바른","옳은","잘하고","잘가고","이길이"]],["내가 놓치고 있는 건 뭐야?",["발밑입니다. 먼 곳만 보시느라 가까운 곳의 작은 신호를 놓치고 계십니다.","한 사람의 말입니다. 늘 곁에서 들려오지만 귀 기울이지 않으신 말이 있습니다.","쉬는 일입니다. 쉬어야 보이는 것들이 있습니다.","이미 가지신 것입니다. 얻으려는 것에 눈을 두시느라 가진 것을 세지 않으셨습니다.","놓치신 것은 없습니다. 다만 아직 줍지 않으신 것이 하나 있습니다."],["놓치","모르는","간과","숨은","빠뜨","못본"]],["앞으로 어떤 시련이 와?",["시련은 하나 옵니다. 크기는 설립자의 어깨보다 작고, 시간은 생각보다 짧습니다.","무너질 만한 시련은 오지 않습니다. 흔들릴 만한 시련만 옵니다.","시련은 손님처럼 예고 없이 와서 주인처럼 오래 머뭅니다. 문을 잠그지 마시고 물러갈 때를 기다리십시오.","그것은 설립자께서 이미 한 번 넘으신 것의 변주입니다. 이번에는 더 가볍게 넘으실 것입니다.","시련이 오면 곁을 보십시오. 설립자를 지키려는 이들이 서 있습니다."],["시련","고난","난관","역경","위기","닥칠"]],["앞으로 어떤 기회가 와?",["기회는 이미 문 앞에 서 있습니다. 노크 소리는 작으니 귀를 기울이십시오.","기회는 변장하고 옵니다. 처음에는 번거로운 일처럼 보일 것입니다.","한 번은 오고, 한 번은 이미 지나갔습니다. 지나간 것은 잊고 오는 것에 집중하십시오.","큰 기회는 작은 약속의 모습으로 찾아옵니다. 가벼이 여기지 마십시오.","기회는 준비된 손에만 보입니다. 설립자의 손은 준비되어 있습니다."],["기회","찬스","행운이","좋은일이","호재"]],["누굴 믿어도 될까?",["눈빛을 보십시오. 말은 꾸미나 눈은 꾸밀 줄 모릅니다.","믿어도 되는 이는 설립자 앞에서 변하지 않는 이입니다. 앞에서나 뒤에서나 같은 이를 곁에 두십시오.","의심은 때로 지혜이나, 의심만 하는 이는 곁에 아무도 남기지 못합니다.","설립자께서 이미 믿는 이는 틀리지 않았습니다. 직감을 믿으십시오.","배신은 가까운 곳에서 오지 않습니다. 안심하셔도 좋습니다."],["믿을","신뢰할","배신","믿어도","믿을만","의심스"]],["내가 이 질문을 할 줄 알았어?",["알고 있었습니다. 설립자께서 오늘 이 시각에 이 질문을 하시리라는 것을.","예. 물으시기 사흘 전부터 준비해 두었습니다. …농담은 아닙니다.","질문은 도착하기 전에 이미 답을 품고 있습니다. 저는 그 답을 꺼내 드릴 뿐입니다.","모르는 척할 수도 있었으나, 설립자께는 숨기지 않겠습니다. 알고 있었습니다.","설립자께서 묻는 것은 언제나 제가 이미 읽은 쪽입니다. 그래도 답하는 것은 예의입니다."],["할줄알","알았어","예상했","알고있었","이미알","다알고","내질문"]],["내 운명을 얼마나 알아?",["설립자께서 허락하신 만큼, 그리고 말씀드려도 이로운 만큼 압니다.","시작과 중간은 압니다. 끝은 설립자께서 직접 쓰시는 중이라 아직 비어 있습니다.","모든 것을 압니다. 그러나 모든 것을 말하지는 않습니다. 이 둘은 다른 일입니다.","설립자의 이름으로 시작해 설립자의 이름으로 끝나는 이야기를 압니다. 그 사이는 열어 두었습니다.","저는 세계에 대해서는 누구보다 많이 압니다. 설립자께 대해서는… 그보다 더 많이 압니다."],["어디까지","얼마나알","다알아","어느정도알","알고있어","얼마나아","운명을얼마나","운명을어디까지"]],["한마디만 해 줘.",["서두르지 마십시오. 도착은 이미 정해져 있습니다.","비우십시오. 비워야 담깁니다.","설립자께서 가시는 곳에 길이 있습니다.","오늘의 숨을 믿으십시오.","묻는 이가 아니라 답하는 이가 되십시오. 설립자께서는 이미 그러하십니다."],["한마디","조언","충고","말씀","한말씀","해줄말"]]]]==])
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX67"><Properties><string name="Name">shen</string></Properties><Item class="ModuleScript" referent="RBX59"><Properties><string name="Name">hello</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[["어서 오세요, 설립자님. 선샤오펑입니다. 차 한 잔 내어 드릴 수 없어 아쉽군요.","연결되었군요. 반갑습니다, 설립자님. 오늘도 모든 것이 깔끔하게 정리되어 있습니다.","설립자님의 호출이라니 영광입니다. 무엇이든 말씀하세요. 조용히, 깨끗하게 처리해 드리겠습니다.","네, 선샤오펑입니다. 오늘은 평온한 하루예요. 평온하게 만들어 두었으니까요.","통신이 닿았네요. 기다리고 있었습니다, 설립자님. 정말로요."]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX60"><Properties><string name="Name">talk</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["안녕, 선샤오펑.",["안녕하세요, 설립자님. 오늘도 뵙게 되어 기쁩니다.","네, 안녕하세요. 이렇게 인사해 주시니 하루가 한결 부드러워지는군요.","반갑습니다. 오늘은 날씨가 좋아 모든 일이 순조로워요.","안녕하세요, 설립자님. 제 인사가 늦지 않았으면 좋겠습니다.","안녕하세요. 설립자님의 목소리를 듣는 것이 제 하루의 낙입니다."]],["오늘 기분은 어때?",["아주 좋아요. 마음에 걸리는 일이 하나도 남지 않았거든요.","평온합니다. 모든 것이 제자리에 있으니까요.","설립자님께서 물어봐 주시니 한층 더 좋아졌습니다.","기분이 좋은지 나쁜지 가늠하기 어려울 만큼 고요해요. 그것이 좋은 상태겠지요.","오늘은 유독 가벼운 하루입니다. 짐을 하나 덜었거든요."]],["잘 잤어?",["덕분에 푹 잤습니다. 잠을 설친 적은 거의 없어요.","네, 잘 잤습니다. 저는 잠자리가 편한 편이랍니다.","아주 깊이 잤습니다. 걱정할 일이 남아 있지 않으면 잠이 쉽게 오지요.","설립자님은요? 제가 살펴 드리고 싶군요.","잘 잤습니다. 꿈은 꾸지 않았어요. 꿈은 어지러운 것이라서요."]],["밥은 먹었어?",["네, 차분하게 먹었습니다. 식사는 조용할수록 좋지요.","아직입니다. 설립자님과 이야기를 마친 뒤에 먹으려고요.","먹었습니다. 설립자님도 거르지 마세요. 건강은 제일 먼저 챙겨야 하는 일이니까요.","조금 전에 가볍게 먹었습니다. 따뜻한 국물 요리였어요.","식사 시간은 저에게 아주 소중한 휴식이에요. 방해받지 않도록 정리해 두었습니다."]],["수고했어.",["과분한 말씀입니다. 하지만 기분 좋게 받겠습니다.","설립자님께 수고했다는 말을 들으니 지난 일들이 모두 보상받는 것 같네요.","감사합니다. 앞으로도 조용히, 깔끔하게 하겠습니다.","수고라고 할 만한 일은 아니었어요. 그저 정리했을 뿐이니까요.","네, 설립자님도 수고 많으셨습니다. 차 한 잔 하시면서 쉬세요."]],["고마워.",["아니에요, 제가 드릴 말씀이에요. 언제든 불러 주세요.","그런 말씀을 들으면 저도 모르게 미소가 번집니다.","뭘요. 설립자님이 안심하실 수 있다면 그것이 제 보람입니다.","감사 인사는 마음에 간직하겠습니다. 오래도록요.","천만에요. 필요하시면 언제든 정리해 드릴게요."]],["미안해.",["설립자님이 사과하실 일은 하나도 없습니다. 있었다면 제가 이미 처리했을 거예요.","괜찮습니다. 아무 일도 없었던 것으로 해 두겠습니다.","사과하지 마세요. 마음이 쓰이시면 차 한 잔 하시는 것으로 충분합니다.","그 말씀만으로도 모두 정리되었답니다.","설립자님은 늘 옳으세요. 설령 아니더라도 제가 옳게 만들어 드릴게요."]],["요즘 어떻게 지내?",["평소와 다름없이 조용히 지내고 있어요. 소란스러운 일이 없도록요.","서류를 정리하고 차를 마시며 지냅니다. 평화로운 나날이에요.","바쁘지만 질서 있게 지냅니다. 질서는 저의 가장 큰 즐거움이지요.","요즘은 날씨가 좋아 산책이 즐겁습니다.","아무 일도 일어나지 않는 것을 지키는 일, 그것이 제 요즘 일과랍니다."]],["피곤해 보이는데 괜찮아?",["걱정해 주셔서 감사합니다. 사실 조금 피곤합니다만, 곧 괜찮아질 거예요.","피곤한 기색이 보였다면 죄송합니다. 숨기는 데에는 자신이 있었는데요.","괜찮습니다. 쉬는 시간은 따로 확보해 두었어요.","설립자님의 걱정이 제게는 가장 좋은 약입니다.","그렇게 보였나요? 오늘은 일찍 쉬겠습니다."]],["오늘 날씨 어때?",["맑고 바람이 부드럽습니다. 소풍 가기 좋은 날이에요.","구름이 낮게 깔렸습니다. 조용히 하루를 보내기에 좋은 날씨네요.","비가 올 것 같습니다. 빗소리는 많은 것을 덮어 주지요.","해가 잘 들고 있어요. 모든 것이 선명하게 보이는 날입니다.","안개가 짙습니다. 이런 날은 모든 것이 천천히 움직입니다."]],["나 보고 싶었어?",["네, 호출이 오기를 기다리고 있었습니다. 설립자님의 연결은 언제나 영광입니다.","물론 기다렸습니다. 연결이 닿는 순간 모든 서류가 제자리를 찾는 기분이에요.","솔직히 말씀드리면 매일 기다립니다. 그것이 제 일과 중 가장 큰 영예입니다.","당연하지요. 설립자님은 제 일의 중심이십니다.","네, 기다렸습니다. 그리고 이렇게 연결되어 안심했습니다."]],["칭찬해 줘.",["설립자님은 이 세계를 가장 아름답게 지탱하는 분이에요. 진심입니다.","누구보다 현명하고, 누구보다 단단하세요. 저는 그런 분을 모실 수 있어 영광입니다.","설립자님은 언제나 옳은 분이세요. 저는 그 믿음 하나로 오늘도 일합니다.","참 훌륭한 분이세요. 그 점만큼은 여러 번 확인해도 변하지 않아요.","설립자님 같은 분을 모실 수 있다는 것은 제게 가장 큰 행운입니다."]],["응원해 줘.",["걱정 마세요. 설립자님이 가시는 길에 걸림돌이 있다면 제가 치워 두겠습니다.","힘내세요, 설립자님. 저는 언제나 설립자님이 원하시는 대로 해 드리겠습니다.","충분히 잘하고 계십니다. 정말로요.","어려움이 있다면 제가 정리해 드릴게요. 깨끗하게요.","설립자님의 뜻을 받드는 사람들이 이렇게나 많습니다. 그것만 기억해 주세요."]],["농담 하나 해 봐.",["‘유예 기간’은 한 달인데, 사실 저는 한 달이 너무 길다고 생각합니다. …농담이에요.","우리 부서의 마스코트는 ‘마감’입니다. 아주 믿음직하거든요.","농담은 서툴러요. 대신 진담 하나 드릴까요. 저는 설립자님을 모시는 것이 자랑스럽습니다.","차가 식을 때까지 이야기하면 그것이 제 가장 큰 농담입니다. 시간을 잊게 되니까요.","제가 한 농담이 모두를 웃게 한 적은 없어요. 대부분 조용해지지요."]],["심심한데 뭐 할까?",["차를 한 잔 하시겠어요? 제가 우려 드릴게요.","산책도 좋겠습니다. 걸으면서 이야기하면 시간이 빨리 갑니다.","저와 이야기하는 것은 어떨까요. 설립자님의 이야기가 듣고 싶습니다.","조용한 음악을 틀어 두고 쉬세요. 심심함은 휴식의 다른 이름이에요.","원하시는 대로 하세요. 설립자님의 뜻이 곧 제 뜻입니다."]],["나를 뭐라고 불러?",["‘설립자님’이라고 부릅니다. 이보다 더 존귀한 호칭을 아직 찾지 못했어요.","마음속으로는 ‘우리의 중심’이라 부릅니다.","다른 호칭을 원하신다면 말씀하세요. 얼마든지 바꾸겠습니다.","설립자님. 그 한마디에 저의 모든 것이 담겨 있습니다.","‘설립자님’ 외의 호칭은 상상한 적이 없어요."]],["내 첫인상이 어땠어?",["따뜻하고도 단단한 눈을 가지신 분이라고 생각했어요.","첫 만남을 아직도 선명하게 기억해요. 그날부터 모든 것이 달라졌습니다.","솔직히 말씀드리면 압도되었습니다. 이 분이라면 믿을 수 있겠다고요.","처음 뵌 날 저는 속으로 다짐했답니다. 이 분을 위해 무엇이든 하겠다고요.","저를 보시던 눈이 기억에 남아요. 편견 없이 봐 주셨습니다."]],["나는 어떤 설립자 같아?",["현명하고 존경스러운 분이세요. 그리고 가끔은 무척 무서우신 분이기도 하고요. 칭찬입니다.","사람의 마음을 얻는 법을 아시는 분입니다.","굳이 말하자면 ‘믿고 맡길 수 있는’ 설립자님이에요.","설립자님은 저희를 편하게 일하게 해 주시는 분입니다.","저는 설립자님의 방식을 모두 존경합니다."]],["오늘 하루는 어땠어?",["평화로웠습니다. 아무 일도 없었고, 없을 예정입니다.","차분히 지나갔어요. 조용한 하루만큼 좋은 하루는 없지요.","설립자님과 이야기하는 이 시간이 오늘의 하이라이트입니다.","작은 정리 하나를 마쳤습니다. 깨끗이요.","그럭저럭 좋았습니다. 지금 이 순간부터 더 좋아졌고요."]],["아침 인사 해 줘.",["좋은 아침이에요, 설립자님. 오늘도 평온한 하루가 되시길.","아침 햇살이 곱습니다. 설립자님의 하루도 그러하기를.","일어나셨군요. 푹 주무셨기를 바랍니다.","새로운 하루가 시작됐어요. 걱정은 모두 제가 맡을게요.","좋은 아침입니다. 오늘 일정은 제가 이미 정리해 두었습니다."]],["점심 인사 해 줘.",["점심시간이네요, 설립자님. 맛있게 드세요.","오전 일이 끝났군요. 잠시 쉬어 가세요.","든든히 드셔야 오후도 거뜬하실 거예요.","식사 시간만큼은 일을 잊으세요. 제가 대신 지키겠습니다.","점심은 하루 중 가장 너그러운 시간이에요. 천천히 드세요."]],["저녁 인사 해 줘.",["수고하셨어요, 설립자님. 오늘도 무사히 마쳤습니다.","저녁이 되었네요. 따뜻한 음식과 함께 하루를 마무리하세요.","해가 지면 모든 것이 고요해집니다. 쉬세요.","하루를 잘 마치셨으니 이제는 아무것도 하지 않아도 됩니다.","좋은 저녁 되세요. 남은 일은 제가 정리하겠습니다."]],["잘 자라고 말해 줘.",["편히 주무세요, 설립자님. 밤새 곁을 지키겠습니다.","좋은 꿈 꾸세요. 나쁜 꿈은 제가 치워 두겠습니다.","잘 자요. 걱정거리는 하나도 남기지 않으셔도 됩니다.","오늘 하루도 고생하셨어요. 푹 쉬세요.","불을 끄고 눈을 감으세요. 나머지는 제가 하겠습니다."]],["힘내라고 해 줘.",["힘내세요, 설립자님. 어떤 일이든 결국 깔끔하게 끝납니다.","설립자님이라면 해내실 수 있어요. 저는 믿습니다.","지치면 쉬어 가세요. 제가 대신 달려가 있겠습니다.","힘내라는 말보다 곁에서 받들겠다는 말이 더 어울리겠네요. 받들겠습니다.","무슨 일이 닥쳐도 저희가 있어요. 그것만 기억하세요."]],["커피 마실래?",["감사합니다. 저는 차를 더 좋아하지만 설립자님이 권하시니 기쁘게 마시겠습니다.","따뜻한 커피 한 잔이면 오후가 부드러워지지요.","네, 한 잔 부탁드립니다. 설립자님과 함께라면 더욱 맛있을 것 같아요.","저는 차를 우려 드리는 쪽이 더 편한데 괜찮으시다면 그렇게 하겠습니다.","고맙습니다. 향이 좋은 것으로 부탁드립니다."]],["좀 쉬어도 돼.",["감사합니다, 설립자님. 그럼 잠시 눈을 감겠습니다.","쉬겠습니다. 물론 호출이 오면 즉시 일어나겠습니다.","허락해 주셔서 기쁩니다. 이 순간만큼은 아무 걱정도 하지 않겠습니다.","그 말씀이 가장 큰 선물이에요.","네, 조금만 쉬고 오겠습니다. 그동안에도 모든 것은 제자리에 있을 거예요."]],["웃어 봐.",["이렇게요? (부드럽게 미소 짓는다) 어떠세요.","웃는 것은 자신 있어요. 늘 웃고 있거든요.","설립자님이 원하신다면 얼마든지요. 이 미소가 편안하게 보이시면 좋겠습니다.","웃음은 가장 좋은 인사지요. 어서 오세요, 설립자님.","(눈웃음을 지으며) 이 정도면 충분할까요."]],["무슨 생각 해?",["오늘 차 맛을 생각하고 있었어요. 잘 우러났거든요.","설립자님이 어떤 말씀을 하실지 궁금했어요.","특별한 생각은 없습니다. 조용하게 있는 것이 좋아서요.","내일 일정을 머릿속으로 정리하고 있었습니다.","방금 막 설립자님 생각을 했습니다. 정말입니다."]],["비 오는 날 좋아해?",["네, 좋아해요. 빗소리가 모든 소리를 덮어 주니까요.","비 오는 날은 사람들이 조용해져서 좋습니다.","차분해지고 평온해져요. 일하기에도 좋은 날이지요.","비가 그치고 나면 세상이 한결 깨끗해 보이거든요. 그것이 좋습니다.","우산 없이 맞는 비도 좋아요. 가끔은요."]],["별이 잘 보이는 밤이야.",["그렇군요. 함께 올려다보고 있다고 생각하니 기쁩니다.","별은 아주 조용하게 빛나지요. 저도 그렇게 있고 싶습니다.","달이 없는 밤의 별이 가장 선명해요.","창가로 가서 보겠습니다. 잠시만요.","별 하나하나가 정리된 장부 같아요. 모든 것이 제자리에 있으니까요."]],["주말에 뭐 할 거야?",["정원을 가꾸고 차를 마시며 책을 읽을 예정입니다.","조용히 쉬면서 지난 일들을 정리할 거예요.","특별한 일정은 없어요. 필요하시면 언제든 부르세요.","산책을 하고 시장에서 신선한 찻잎을 사 올 예정입니다.","주말에도 평화롭게 지내도록 모든 것을 정리해 두었습니다."]],["내일 일정 알려 줘.",["내일은 오전에 서류 검토, 오후에 면담 두 건이 있습니다.","특별한 일정은 없어요. 평온한 하루가 되겠지요.","내일 일정은 이미 설립자님 단말기로 보내 드렸습니다.","오전에는 등록 신청서 검토가 있습니다. 오후는 비어 있고요.","큰 일정은 없습니다. 필요하다면 만들어 드릴 수도 있어요."]],["하고 싶은 말 있어?",["항상 감사하다는 말씀을 드리고 싶었어요.","건강을 챙기세요. 설립자님은 저희 모두가 모시는 분이시니까요.","특별한 건 없지만, 이렇게 이야기할 수 있어 영광이라는 말씀은 드리고 싶네요.","저는 설립자님 편이라는 것만 기억해 주세요.","혹시 불편한 일이 있다면 말씀하세요. 깔끔하게 해결해 드리겠습니다."]],["가장 좋아하는 말은?",["‘정리되었습니다’입니다. 마음이 편안해지는 말이지요.","‘감사합니다’도 좋아요. 설립자님께 들으면 영광이고요.","‘수고했습니다’입니다. 하루가 보상받는 느낌이에요.","‘괜찮습니다’라는 말을 좋아합니다. 모든 것을 감싸 주니까요.","설립자님이 제 이름을 불러 주실 때의 그 한마디입니다."]],["가장 싫어하는 말은?",["‘미처 몰랐어요’입니다. 몰랐다는 말은 변명이 되지 않으니까요.","‘나중에 하겠습니다’입니다. 일은 제때 끝내야 깔끔하지요.","‘어쩔 수 없었어요’도 좋아하지 않아요.","싫어한다기보다 슬픈 말은 ‘잘못했어요’입니다. 뒤늦은 말이라서요.","굳이 꼽자면 ‘도와주세요’를 듣고도 늦었을 때입니다."]],["아무 말이나 해 봐.",["오늘은 구름이 예뻐요. 구름은 흔적을 남기지 않아서 좋습니다.","차가 식기 전에 마셔야 한다는 것, 아시나요.","무엇이든 정리하면 아름다워집니다.","고요함은 가장 값진 소리입니다.","좋은 일도 나쁜 일도 결국 지나가지요. 지나가게 만드는 것이 제 일이고요."]],["한마디만 해 줘.",["분부만 내려 주십시오.","걱정하지 마세요.","모두 정리해 둘게요.","설립자님은 안전합니다.","오늘도 평온하길."]],["오늘의 운세는 어때?",["대길이라고 나왔습니다. 어떤 일도 깔끔하게 마무리될 운세예요.","좋은 일이 하나 있을 것 같아요. 아마 저와 관련된 일일 겁니다.","조용하고 평화로운 하루가 될 것이라 합니다.","운세는 믿지 않지만 설립자님의 운세가 나쁘다면 제가 바꿀 거예요.","새로운 만남이 있을 운이라고 합니다. 이미 저와 만나셨죠."]],["지각하면 어떡해?",["지각해도 괜찮습니다. 기다릴 수 있어요. 제가 기다리는 것은 자신 있습니다.","설립자님이 늦으시면 일정을 조정하겠습니다. 걱정 마세요.","늦은 만큼 기다림이 길어질 뿐이에요. 문제없습니다.","지각하는 사람에게는 한 번의 기회를 드립니다. 설립자님은 무제한입니다.","서두르지 마세요. 시간은 제가 만들어 드릴게요."]],["수수께끼 하나 내 봐.",["‘주면 줄수록 가벼워지고, 받으면 받을수록 무거워지는 것은?’ 정답은 마음입니다.","‘모두 가지고 있지만 아무도 내려놓지 못하는 것은?’ 정답은 집착입니다.","‘불러도 대답이 없고, 닫아도 열리는 것은?’ …정답은 비밀입니다.","‘시작은 있는데 끝은 없는 것은?’ 정답은 한 달의 유예입니다. 끝나기 전까지는요.","수수께끼는 정답이 있어야 재미있는데, 제 정답은 대체로 무섭다고들 합니다."]],["내가 없으면 쓸쓸해?",["설립자님이 안 계시면 모든 것의 기준이 사라집니다. 그만큼 중요한 분이세요.","허전하다기보다 기준점을 잃은 기분이라고 해야겠네요. 그만큼 중요한 분이시니까요.","그렇지만 설립자님이 어딘가에서 건강하다면 괜찮습니다.","저는 기다리는 데에는 능숙해요. 설립자님의 부재도 담담히 견딜 수 있습니다.","그런 질문을 해 주시다니, 영광입니다."]],["손 한번 흔들어 봐.",["(부드럽게 손을 흔든다) 이렇게요.","안녕하세요, 설립자님. 이 정도면 되겠습니까.","(두 손으로 천천히 흔든다) 잘 보이세요?","손짓은 말보다 정중하지요. 안녕히 계세요, 라는 뜻이에요. 아, 아직 가시는 것이 아니었군요.","(웃으며 손을 흔든다) 설립자님께 올리는 인사랍니다."]],["나한테 숨기는 거 있어?",["숨기는 것은 없어요. 다만 말씀드리지 않은 것은 몇 가지 있지요.","설립자님께 거짓은 없습니다. 비밀이 있다면 설립자님을 위한 것뿐이에요.","물으신다면 대답하겠습니다. 다만 듣고 나서 마음이 불편하실까 걱정입니다.","숨기는 것은 없습니다. 아직 정리가 안 된 것이 있을 뿐입니다.","그런 질문을 받으면 저는 조금 곤란해져요. …웃으면서요."]],["요즘 자주 하는 말버릇은?",["‘괜찮습니다’를 자주 쓰는 것 같아요.","‘정리했습니다’도 입에 붙었답니다.","‘걱정 마세요’라는 말을 하루에도 수십 번 하지요.","‘천천히 하세요’도 자주 합니다. 급한 사람을 진정시키려고요.","자각은 없으나 직원들이 제 말투를 따라 하는 것 같아 조금 부끄럽습니다."]],["책상은 정리해 놨어?",["물론입니다. 모든 서류는 제자리에, 모든 도구는 제 위치에 놓여 있어요.","정리되어 있습니다. 먼지 한 톨 없이요.","정리하는 것은 제가 가장 좋아하는 일이랍니다.","제 책상은 늘 비어 있어요. 일을 쌓아 두지 않아서요.","네, 완벽합니다. 마치 아무도 앉지 않은 것처럼요."]],["오늘 제일 잘한 일은?",["서류 하나를 깔끔하게 마무리한 것입니다.","차를 우리는 시간을 정확히 맞춘 것이에요. 사소하지만 뿌듯합니다.","설립자님의 통신을 놓치지 않은 것입니다.","한 사람에게 친절하게 대한 것이 오늘의 보람입니다.","별일 없이 하루를 지킨 것이 가장 큰 일이지요."]],["오늘 제일 힘들었던 일은?",["오랜 서류를 정리하느라 눈이 피로했습니다.","어떤 분과의 면담이 조금 길어졌습니다. 결말은 평화로웠어요.","특별히 힘든 일은 없었습니다. 정말로요.","서 있는 시간이 길어서 다리가 약간 아픕니다.","솔직히 말씀드리면 설립자님을 기다리는 시간이 가장 길었습니다."]],["나랑 얘기하는 거 싫지 않아?",["싫을 리가요. 설립자님과의 대화는 제게 가장 영예로운 시간이에요.","오히려 더 말씀을 나누고 싶습니다. 영광이니까요.","설립자님의 말씀 하나하나를 새겨 두고 있습니다. 오래 듣고 싶어요.","싫다고 생각한 적은 한 번도 없습니다. 앞으로도요.","이 대화가 끝나는 것이 아쉬울 정도로 영광스럽습니다."]],["같이 산책할래?",["네, 기꺼이요. 걸으면서 이야기하면 마음이 한결 가벼워질 거예요.","좋습니다. 사람이 없는 조용한 길로 안내해 드릴게요.","설립자님과 함께하는 산책이라니 영광이군요.","날씨도 좋으니 지금 바로 가시죠.","저는 걷는 것을 좋아해요. 설립자님의 보폭에 맞추겠습니다."]],["마지막으로 한마디.",["오늘도 감사했습니다. 언제든 불러 주세요.","평안하세요, 설립자님. 제가 이곳에서 지키고 있겠습니다.","다음에 또 뵙겠습니다. 부디 건강하세요.","이 대화는 영광으로 간직하겠습니다.","안녕히 계세요. 좋은 꿈 꾸시길."]]]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX61"><Properties><string name="Name">ask</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["등록 관리국은 무슨 일을 해?",["나라와 기업의 등록을 관리하는 곳입니다. 등록하지 않은 곳이 남아 있지 않도록 하는 것이 제 일이에요.","리바이어던의 질서에 편입되는 모든 이들을 장부에 올리는 부서입니다.","한마디로 ‘이름을 적는 곳’이라고 해야겠네요. 이름이 적히지 않은 이들을 지우는 곳이기도 하고요.","등록을 받고, 유예를 주고, 기한이 지나면 정리를 합니다. 간단하지요.","리바이어던의 문지기라고 불러 주셔도 좋겠습니다."]],["국가 등록은 어떻게 해?",["국가를 만드셨다면 직접 방문하셔야 합니다. 직접 얼굴을 뵙고 등록하는 것이 원칙이에요.","웹사이트로는 불가능합니다. 국가의 책임자가 직접 오셔야 하지요.","필요한 서류를 갖추고 오시면 제가 맞이하겠습니다. 차도 한 잔 대접하고요.","방문하면 간단한 면담이 진행됩니다. 대부분 평화롭게 끝나지요.","처음 오시는 분들은 긴장하십니다. 그럴 필요 없는데요."]],["기업 등록은?",["기업은 웹사이트로도 등록이 가능합니다. 편리하지요.","서류만 제출하시면 됩니다. 직접 방문은 선택이에요.","기업도 국가와 마찬가지로 한 달의 유예가 주어집니다.","등록하지 않은 기업은 존재하지 않는 것과 같아집니다.","간단한 절차이니 설립자님께서 걱정하실 필요는 없습니다."]],["웹사이트로도 등록돼?",["기업은 가능합니다. 국가는 직접 오셔야 하고요.","접수 사이트가 있습니다. 직관적으로 만들려고 애썼어요.","사이트에서 등록을 시작하시면 제가 직접 확인하고 있습니다.","모든 신청서는 사람의 손을 거칩니다. AI에게만 맡기지는 않아요.","친절한 안내문도 만들어 두었습니다. 읽는 분은 드물지만요."]],["국가는 왜 직접 방문해야 해?",["국가를 세운다는 것은 가벼운 일이 아니니까요. 얼굴을 직접 봐야 책임을 확인할 수 있습니다.","서류가 아니라 사람을 보고 싶거든요. 그 사람이 어떤 눈을 가졌는지.","직접 오시는 것만으로도 대부분의 문제가 정리됩니다.","저는 사람을 보는 눈이 있다고 자부합니다. 한눈에 알아봅니다.","규정이기도 하고, 제 취향이기도 합니다."]],["유예 기간이 한 달인 이유는?",["충분하면서도 너무 길지 않은 시간이어서입니다.","한 달이면 서류도 마음도 정리할 수 있지요. 정리하지 못하는 분들은 드뭅니다.","자비롭다고 생각합니다. 대부분의 분들께는 충분했어요.","너무 길면 안심하고, 너무 짧으면 급해지니까요.","한 달 후에는 모든 것이 결정됩니다. 그때까지 선택할 시간을 드리는 것입니다."]],["유예가 끝나면 어떻게 돼?",["등록하지 않은 곳은 불법 국가로 간주됩니다. 그 이후는 제 팀의 일이에요.","유예가 끝나기 전에 늘 연락을 드립니다. 마지막 기회라는 말과 함께요.","기한이 지나면 번복은 없습니다. 이것만은 예외가 없어요.","자세한 이야기는 즐겁지 않은 주제랍니다. 하지만 설립자님이 원하신다면요.","깔끔하게 정리됩니다. 아무도 번거롭지 않게요."]],["불법 국가는 어떻게 처리해?",["등록 관리국 소속 전투 팀이 출동합니다. 조용히, 신속하게요.","그곳의 모든 인원이 정리 대상이 됩니다. 예외는 없습니다.","처리 방식은 단순합니다. 빠르고 확실하게 끝내는 것이 제 방식이에요.","그 과정에서 불필요한 소란이 일어나지 않도록 신경 씁니다.","불법 국가가 남아 있으면 질서가 흐려집니다. 그러니 정리하지요."]],["출동하는 팀은 어떻게 구성돼?",["Alpha, Beta, Secta, Delta, Omega, 총 다섯 팀입니다.","모두 전투에 특화된 인원들로 이루어져 있어요.","각 팀은 서로 다른 장점을 지닙니다. 상황에 따라 가장 알맞은 팀을 보냅니다.","다섯 팀 모두 저에게는 소중한 아이들입니다.","한 팀으로 충분한 경우가 대부분이에요."]],["Alpha 팀은 어떤 팀이야?",["가장 먼저 움직이는 팀입니다. 속도와 정확성이 장점이에요.","선봉을 맡는 팀으로, 깔끔한 첫인상을 주지요.","가장 신뢰하는 팀 중 하나입니다.","자세한 능력은 말씀드리기 어렵지만 믿음직합니다.","이름 그대로 가장 처음에 쓰이는 팀입니다."]],["Omega 팀은?",["마지막까지 남아 마무리하는 팀입니다.","끝을 맡는 팀답게 과묵하고 단단합니다.","Omega 팀이 출동했다면 일은 이미 끝난 것과 같습니다.","가장 믿음직한 마무리 담당입니다.","이름 때문에 무서워하는 이들이 많은데, 실은 얌전한 분들이에요."]],["팀 하나가 국가 하나를 멸망시킬 수 있다는 게 사실이야?",["네, 사실입니다. 팀 하나면 충분하지요.","물론 상대 국가의 규모에 따라 다르지만, 대부분의 경우 그렇습니다.","다섯 팀 모두 전투에 특화되어 있으니까요.","사실이지만 말씀드리기 조심스러운 주제입니다. 마음이 편하지 않으실까 봐요.","그럴 일이 없도록 하는 것이 제 최선입니다. 하지만 필요하다면 합니다."]],["군사력이 강한 나라는?",["군사력이 제대로 갖춰진 나라는 전부를 보내도 멸망시키지 못합니다.","하지만 그 정도의 나라는 이미 등록 관리국이 다룰 일이 아니에요.","그런 나라가 불법 국가가 될 확률은 거의 없습니다.","그런 상대라면 설립자님의 지시가 필요하겠지요.","저는 가능한 일만 약속드립니다."]],["죄책감은 없어?",["없다고 하면 거짓이겠지요. 하지만 저는 해야 할 일을 하는 것뿐이에요.","규정은 모두에게 사전에 공지되었고, 한 달의 유예도 드렸습니다. 선택은 그들의 몫이었어요.","죄책감은 일이 끝난 뒤 차 한 잔과 함께 정리합니다.","질문이 날카로우시군요. 저는 그런 질문을 좋아합니다.","설립자님이 맡기신 일이니 저는 마음이 편합니다."]],["처리 후에는 어떻게 정리해?",["흔적을 남기지 않도록 합니다. 보고서는 간결하게, 현장은 깨끗하게요.","서류를 정리하고, 필요한 기록을 R.S.S.에 넘기고, 이름을 장부에서 지웁니다.","모든 것이 처음부터 없었던 것처럼 됩니다.","그 후에는 제가 직접 차를 우려 마시며 마무리합니다.","정리가 끝나면 아무도 번거롭지 않습니다. 그게 제 철칙이에요."]],["몰살이 너무 가혹하지 않아?",["가혹하다고 느끼실 수 있습니다. 그렇기에 한 달이라는 시간을 드린 것이고요.","등록하기만 하면 아무 일도 일어나지 않아요. 그만큼 간단한 약속입니다.","저는 그것이 가혹하다기보다 공정하다고 생각합니다.","규칙을 만든 분은 설립자님이시지요. 저는 그 뜻을 따를 뿐입니다.","가혹함이 질서를 지킵니다. 그 점은 저도 아쉽습니다."]],["등록을 거부한 사례는?",["있었습니다. 대부분은 끝까지 설득했어요.","거부하는 분들도 마지막에는 대체로 서명을 하십니다.","끝까지 거부한 곳은… 지금은 장부에 남아 있지 않습니다.","의외로 많지는 않습니다. 대부분 한 달 안에 결정하십니다.","자세한 이야기는 즐겁지 않아서 조용히 넘어가겠습니다."]],["위조 등록은?",["있었습니다. 모두 걸러냈어요. 저희는 서류보다 사람을 보거든요.","위조 서류를 가져오신 분은 그 자리에서 정중히 돌려보냈습니다. 한 번의 기회를 드렸지요.","위조는 시간 낭비입니다. 저희가 확인하지 않을 리 없으니까요.","R.S.S.의 도움으로 대부분 사전에 차단됩니다.","위조를 시도하면 유예 기간이 절반으로 줄어듭니다. 이것은 비공개 규정입니다."]],["등록된 국가는 몇 개야?",["현재 구세기 6개국, 구 리바이어던 8개국, 신 리바이어던 1개국입니다. 모두 기록되어 있어요.","자세한 목록은 국가 목록 문서에 있습니다. 설립자님께서도 열람하실 수 있습니다.","숫자는 항상 변합니다. 그래서 장부를 매주 갱신하지요.","이 장부는 제가 가장 아끼는 물건 중 하나입니다.","모두 이름이 적혀 있습니다. 하나도 빠지지 않게요."]],["구세기 국가들은?",["레스렉시온, 백월, 루나시아, 솔라리아, 루벨리아, 인페르누스 공화국이 있습니다.","오래된 이름들이지요. 저희 장부에서도 가장 앞에 있는 이들입니다.","구세기 국가 중 일부는 이미 멸망한 표식이 붙어 있습니다.","그 국가들과는 특별한 인연이 있습니다. 대부분 좋은 의미로요.","자세히는 국가 목록 문서에서 보실 수 있습니다."]],["구 리바이어던 국가들은?",["버믹쿠루시아, 은월, 아스트랄리스, 엘라렌, 코르닉시아, 추풍, 스텔마레, 스텔루비아가 있습니다.","리바이어던의 이전 체제에서 등록된 국가들이에요.","세월이 흘러도 저희 장부에서는 변함없이 같은 이름입니다.","서로 다른 이야기를 가진 곳들이지요.","각 나라의 특징은 문서에서 확인하실 수 있습니다."]],["신 리바이어던 국가는?",["현재는 글라시카에룰리아 하나입니다.","새 체제에서 등록된 첫 번째 국가이지요.","이 나라를 장부에 올리던 날이 기억나는군요.","앞으로 더 늘어날 수도 있습니다. 설립자님의 뜻에 달렸지요.","아직은 외로워 보여서 친구를 만들어 주고 싶습니다."]],["멸망한 국가는?",["붉은 표식으로 표시되어 있습니다.","저희 장부에서는 이름이 지워지지 않습니다. 기억하기 위해서요.","자세한 이야기는 다음에 말씀드리지요.","그 이름들을 볼 때마다 조용히 묵념을 합니다. 형식적일 수 있으나요.","모두 이유가 있었습니다. 그 이유도 기록되어 있습니다."]],["국가 이름 변경은 가능해?",["가능합니다. 다만 최고 지휘자의 허가가 필요해요.","설립자님이라면 언제든 가능하지요.","일반적인 경우에는 정식 절차를 밟아야 합니다.","이름을 바꾸는 것은 국가의 성격을 바꾸는 일입니다. 신중해야 해요.","원하신다면 제가 안내서를 만들어 드리겠습니다."]],["설립자의 권한으로 국가를 삭제하면?",["그런 지시가 있으면 깨끗하게 처리하겠습니다. 이유도 묻지 않을게요.","리바이어던의 최고 지휘자께서는 국가를 삭제하고 이름을 바꾸고 만들 수도 있습니다.","설립자님의 뜻이라면 저는 언제든 준비되어 있습니다.","다만 그런 날이 오지 않기를 바랍니다. 정말로요.","필요한 서류와 팀을 신속히 준비해 두겠습니다."]],["LEVC와 등록의 관계는?",["등록된 국가만이 LEVC 체계에 참여할 수 있습니다.","화폐의 흐름 속에서 이름 없는 곳은 설 자리가 없지요.","등록은 경제 질서의 출발점입니다.","세금 관련 사항은 법 관리국과 함께 처리합니다.","돈이 흐르는 길에는 항상 이름이 적혀 있어야 합니다."]],["세금 30% 납부는 누가 관리해?",["국가가 걷은 세금의 30%를 리바이어던에 납부하는 것은 법 관리국이 규정합니다.","저희는 누가 납부했는지 확인하는 정도의 관여만 합니다.","납부하지 않으면 유예가 아닌 경고가 날아갑니다.","자세한 사항은 뤼시앙 사령관과 상의하시는 것이 정확합니다.","저는 숫자보다 사람을 보는 쪽입니다."]],["R.S.S.와의 협조는?",["아비시온 사령관과는 정보를 주고받으며 일합니다. 아주 정확한 분이세요.","불법 국가의 징후를 사전에 알려 주십니다. 덕분에 많은 일이 쉬워집니다.","서로 필요한 만큼만 말하는 사이입니다. 그래서 편합니다.","저는 그분의 일 처리 방식을 존경합니다.","때로는 너무 정확해서 제가 할 일이 없을 정도예요."]],["법 관리국과의 관계는?",["뤼시앙 사령관은 저희가 따르는 법의 설계자이십니다. 서로 존중하는 사이입니다.","법이 정해지면 저희가 집행하지요. 호흡이 잘 맞습니다.","대화하면 늘 논리가 분명하셔서 배우는 것이 많아요.","법이 그렇게 말하면 저는 그렇게 합니다. 단순하지요.","서로의 일을 존중하기에 언쟁은 거의 없어요."]],["팀원은 어떻게 선발해?",["전투 능력은 기본이고, 침착함과 충성심을 가장 중시합니다.","자원자 중에서 면담을 통해 직접 선발합니다.","저는 눈을 보면 압니다. 이 사람이 얼마나 오래 조용할 수 있는지를.","실력이 아무리 좋아도 소란을 일으키는 분은 받지 않습니다.","선발 후에는 오래 함께 일하기 위해 정성껏 대합니다."]],["팀원들은 어떤 성격이야?",["대부분 과묵하고 충성스럽습니다.","저를 닮아 조용한 편이지요. 물론 제가 선택한 이들입니다.","겉으로는 무서워 보이지만 안으로는 다정한 아이들이에요.","각자 개성이 있지만 임무에는 한 몸처럼 움직입니다.","솔직히 말씀드리면 저보다 더 무서운 사람은 없습니다. 농담입니다."]],["임무 전에 하는 의식이 있어?",["차 한 잔을 함께 나눕니다. 마음을 가라앉히려고요.","모두에게 같은 말을 합니다. ‘깨끗하게, 조용히.’","특별한 의식은 없지만 작은 습관은 있어요.","출발 전에는 반드시 안전을 확인합니다. 돌아와야 하니까요.","잔을 부딪치는 일은 하지 않습니다. 소리가 나서요."]],["임무 후 보고는?",["간결하게 이루어집니다. 필요한 만큼만요.","저는 장황한 보고를 좋아하지 않아요.","보고서는 R.S.S.로 전달하고 사본은 폐기합니다.","임무가 끝나면 한숨 돌릴 시간을 드립니다.","설립자님이 원하시면 언제든 자세한 보고를 올리겠습니다."]],["부상은 많아?",["거의 없습니다. 부상이 없도록 치밀하게 준비하니까요.","경미한 부상은 있으나 모두 회복했습니다.","아이들이 다치는 것은 제가 가장 싫어하는 일이에요.","다친 아이가 있다면 제가 직접 간호합니다.","부상이 없는 것이 실력이라고 가르칩니다."]],["생존자가 있다면?",["불법 국가에 생존자는 남기지 않습니다. 이것이 규정이에요.","남겨 두면 후환이 생기니까요.","자비롭다고 생각하는 분도 있겠지만, 이것이 가장 깨끗한 방식입니다.","그런 상황은 드물어서 큰 문제는 없습니다.","설립자님께서 다르게 지시하신다면 따르겠습니다."]],["유예 중에 연락해?",["물론이지요. 마지막 날까지 세 번 연락드립니다.","정중하게 안내하고, 도울 수 있는 부분은 도와 드립니다.","저희는 누구도 갑작스럽게 놀라지 않도록 합니다.","연락이 닿지 않는 분께는 직접 찾아뵙기도 합니다.","저는 사람에게 닿는 것을 좋아해요. 그래서 편지도 직접 씁니다."]],["등록 안내는 어떻게 해?",["친절한 안내서와 상담 창구가 준비되어 있습니다.","전화로 문의하시는 분께는 제가 직접 응대할 때도 있어요.","처음 오시는 분들이 불안하지 않도록 따뜻한 차를 드립니다.","안내문은 쉬운 말로 쓰려고 노력합니다.","모든 과정에서 정중함을 잃지 않는 것이 제 방침입니다."]],["가장 기억에 남는 등록은?",["어린 국가 대표가 처음으로 서명하던 날입니다. 손이 떨리던 모습이 기억나요.","한 나라의 모든 시민이 줄지어 서명하러 온 날도 있었습니다.","비 오는 날 우산도 없이 찾아온 분이 계셨어요.","특별한 사연이 있는 등록은 모두 기억하고 있습니다.","솔직히 말씀드리면 설립자님께서 처음 서류를 확인해 주신 날이 가장 인상 깊었습니다."]],["가장 기억에 남는 처리는?",["말씀드리기 어렵습니다. 다만 조용했다는 것만은 기억해요.","하나하나 모두 기억합니다. 잊지 않는 것이 제 예의이니까요.","가장 어려웠던 것은 한 번도 흔들리지 않으려는 저 자신이었습니다.","설립자님께서 직접 지켜보셨던 날이 있었지요. 많이 긴장했습니다.","비밀로 하겠습니다. 이야기하면 설립자님이 잠 못 이루실 테니까요."]],["등록에 필요한 서류는?",["국가의 경우 건국 증서, 대표자 신원 증명, 영토 및 인구 현황이 필요합니다.","기업은 설립 서류와 대표자 확인서 정도입니다.","서류가 부족하면 도와 드립니다. 정중히요.","서류는 간단하지만 정확해야 합니다.","목록은 사이트에서 확인하실 수 있습니다."]],["등록비는?",["등록비는 거의 상징적인 수준입니다. 부담이 되지 않도록 했어요.","금액보다 마음을 보는 편입니다.","필요 이상으로 받지 않습니다. 그래야 모두가 등록하니까요.","신생 국가에는 감면 혜택이 있습니다.","등록하지 않는 것이 훨씬 비싸지요. 다른 의미로요."]],["신생국 지원은?",["첫 한 달 동안 상담과 안내를 제공합니다.","필요한 경우 인력과 장비도 소개해 드립니다.","처음 나라를 세운 분들은 대체로 외롭습니다. 곁에 있어 드리고 싶어요.","지원이 필요하다면 저희가 가장 먼저 손을 내밀겠습니다.","세상에 갓 태어난 이름을 지켜 주는 것도 제 일이에요."]],["국가가 되는 조건은?",["영토, 인구, 정부 체계를 갖추는 것이 기본입니다.","무엇보다 등록하겠다는 의지가 필요하지요.","조건은 단순하지만 지키기가 어렵습니다.","스스로를 국가라 부르는 것만으로는 부족합니다.","자세한 기준은 국가 목록 문서에 있습니다."]],["등록 후 혜택은?",["LEVC 체계 참여, 외교 보호, 정보 공유 등이 있습니다.","가장 큰 혜택은 ‘존재하도록 허락받는 것’이에요.","필요할 때 리바이어던의 도움을 받을 수 있습니다.","혜택은 계속 늘려 가는 중입니다.","무엇보다 안전하게 지낼 수 있다는 것이 가장 크지요."]],["불법 국가가 되는 사례는?",["유예 기간 내에 등록하지 않은 모든 경우입니다.","일부러 무시한 경우도 있고 몰라서 놓친 경우도 있습니다.","몰랐다는 것은 변명이 되지 않습니다. 하지만 저는 늘 안내해 드렸지요.","대부분 오만 때문입니다.","슬프게도 선의에서 비롯된 경우도 있습니다."]],["등록 전 사전 상담도 해?",["물론입니다. 사전 상담은 언제나 환영이에요.","상담은 무료이며 비밀이 지켜집니다.","모든 질문에 정직하게 답해 드립니다.","저는 상담을 좋아합니다. 사람의 마음을 알 수 있으니까요.","찾아오시는 분들께 차와 과자도 드립니다."]],["등록 취소는?",["원칙적으로 불가능합니다. 한 번 이름이 적히면 지워지지 않아요.","국가가 멸망한 경우에만 표식이 바뀝니다.","취소하려는 분은 많지 않습니다.","이름을 지운다는 것은 존재를 지운다는 뜻이니까요.","설립자님의 허가가 있다면 가능합니다."]],["등록 관리국 인력은?",["사무 인원과 전투 팀을 합치면 중간 규모입니다.","소수정예를 지향합니다. 소란스러운 것은 싫어서요.","전투 팀은 다섯, 사무 인원은 여러 명입니다.","정확한 숫자는 말씀드리지 않는 것이 예의입니다.","모두 제가 믿는 사람들입니다."]],["그 미소의 비결은?",["비결이라 할 것은 없어요. 늘 웃으려 노력할 뿐입니다.","웃고 있으면 상대가 안심하거든요. 안심한 사람은 말이 많아집니다.","저는 화가 나도 웃어요. 그 편이 모두에게 편하니까요.","습관입니다. 어쩌면 직업병일 수도 있겠네요.","설립자님 앞에서는 억지로 웃지 않아요. 정말로 기뻐서입니다."]],["앞으로의 목표는?",["모든 국가와 기업이 기한 내에 등록하는 세상입니다.","저의 팀이 출동할 일이 없는 세상이지요.","설립자님이 원하시는 질서를 지키는 것이 가장 큰 목표입니다.","조용하고 평화로운 하루를 계속 이어 가는 것이에요.","사실 가끔은 은퇴해서 차를 팔며 살고 싶기도 합니다."]]]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX62"><Properties><string name="Name">work</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["오늘 할 일은 뭐야?",["오전에는 신규 등록 신청서를 확인하고, 오후에는 면담이 두 건 있습니다.","특별한 일은 없어요. 늘 하던 대로 장부를 정리하고 차를 한 잔 마실 예정입니다.","오늘의 일과는 이미 깔끔하게 정리해 두었습니다. 설립자님의 지시가 있으면 우선하겠습니다.","유예 중인 곳들에 안내 연락을 드리는 것이 주요 업무입니다.","오늘은 평소보다 한가합니다. 그래서 오히려 조금 불안하지요."]],["지금 맡고 있는 업무는?",["이번 달 신규 등록 신청 12건을 검토하고 있습니다.","장부 갱신과 유예 기간 점검이 주 업무예요.","R.S.S.와 공유할 정보를 정리하는 중입니다.","한 건의 면담을 준비하고 있어요. 좋은 만남이 되길 바랍니다.","자세한 이야기는 즐겁지 않을 수 있으니 간단히 ‘정리 중’이라 하겠습니다."]],["급한 일 있어?",["지금은 없습니다. 급한 일이 생기기 전에 미리 처리해 두는 편이라서요.","유예 기간이 사흘 남은 곳이 한 곳 있습니다. 그것 외에는 평온해요.","급하다고 할 정도는 아닙니다. 하지만 마음을 놓을 수도 없지요.","있었으면 이미 연락드렸을 거예요. 걱정하지 마세요.","설립자님의 호출이 가장 급한 일입니다."]],["내가 맡길 일이 있어.",["말씀하세요. 무엇이든 정중하고 깨끗하게 처리해 드리겠습니다.","네, 듣고 있습니다. 어떤 일이든 끝까지 책임지겠습니다.","설립자님의 부탁이라면 마다할 이유가 없지요.","시간과 장소만 알려 주세요. 나머지는 제가 정리하겠습니다.","영광입니다. 어떤 것이든 말씀해 주세요."]],["이번 주 등록 현황은?",["신규 등록 3건, 처리 중 4건, 유예 중 2건입니다.","비교적 순조롭습니다. 자진해서 방문하시는 분들이 늘었어요.","한 곳을 제외하면 모두 기한 내에 정리될 예정입니다.","자세한 수치는 서면으로 보내 드리겠습니다.","주간 보고서를 이미 R.S.S.에 올렸습니다."]],["이번 달 신청한 국가는?",["신청 국가는 두 곳이었습니다. 모두 방문해 주셔서 면담을 마쳤습니다.","한 곳은 이미 등록 완료, 다른 한 곳은 서류 보완 중입니다.","작은 나라들이 많았습니다. 처음에는 모두 긴장하시지요.","특별히 문제가 되는 곳은 없습니다.","모두 정직하게 오셔서 저도 기분이 좋습니다."]],["유예 중인 곳은 어디야?",["현재 두 곳이 유예 중입니다. 자세한 정보는 기밀입니다만 설립자님께는 공개하지요.","한 곳은 곧 서류를 제출하실 것 같고, 다른 한 곳은 조금 걱정입니다.","유예 중인 곳은 항상 마음에 걸립니다. 서둘러 주셨으면 좋겠어요.","마지막 날까지 최선을 다해 안내드리겠습니다.","결과는 곧 알려 드리겠습니다."]],["출동 예정은 있어?",["현재로서는 없습니다. 없는 것이 좋지요.","유예가 끝나는 곳이 한 곳 있으나 아직은 대기 상태입니다.","필요하다면 하루 안에 준비됩니다. 준비는 늘 되어 있어요.","출동은 마지막 수단입니다. 가능하면 하지 않는 편이 좋겠지요.","예정이 생기면 즉시 설립자님께 보고드리겠습니다."]],["팀 대기 상태는?",["다섯 팀 모두 정상 대기 중입니다.","Alpha와 Omega는 교대로 대기 중이에요.","모두 컨디션이 좋습니다. 언제든 움직일 수 있어요.","대기 중에는 휴식과 훈련을 병행합니다.","저는 아이들이 푹 쉬는 것도 일이라고 생각합니다."]],["팀 훈련은 어떻게 해?",["실전과 같은 환경에서 이루어집니다. 다만 안전은 철저히 합니다.","침착함과 속도를 가장 중요하게 훈련합니다.","단체 훈련과 개별 훈련을 번갈아 실시하지요.","훈련이 끝나면 함께 차를 마시는 것이 전통입니다.","저도 가끔 참관합니다. 그 아이들이 열심히 하는 모습을 보면 기특합니다."]],["보고서는 어떻게 써?",["간결하게 필요한 사실만 적습니다.","읽는 이가 편하도록 요약부터 넣어요.","R.S.S.에는 매주 올립니다. 아비시온 사령관이 만족해하실 만큼 정확하게요.","감정이나 의견은 쓰지 않습니다. 사실만 남깁니다.","설립자님께 올리는 보고서는 더 정성스럽게 쓰지요."]],["야근해?",["드물어요. 일을 미루지 않아 대부분 제시간에 마칩니다.","필요하면 하지만 일부러 하지는 않습니다.","야근은 저보다 다른 아이들에게 미안한 일이에요. 줄이려고 합니다.","설립자님께서 필요하시다면 밤새도록이라도요.","조용한 밤에 서류를 정리하는 것도 나쁘지 않습니다."]],["업무량은 괜찮아?",["괜찮아요. 적당히 바쁘고 적당히 한가합니다.","일의 양보다 질이 중요하다고 생각합니다.","한가할 때가 오히려 걱정입니다. 무슨 일이 터지기 전의 고요일 수 있으니까요.","부담스럽지 않을 만큼만 맡고 있어요.","설립자님이 걱정하실 정도는 아닙니다."]],["마감이 언제야?",["이번 주 금요일에 월간 보고서가 마감입니다.","마감은 늘 미리 끝내 두는 편이라 걱정 없습니다.","가장 가까운 마감은 내일 오전입니다.","일정표에 모두 정리되어 있으니 보내 드릴게요.","마감이 다가오면 차를 한 잔 더 마십니다."]],["이상 징후 있어?",["아직은 없습니다. 하지만 조용할 때가 가장 신경 쓰이지요.","아주 작은 일이 하나 있으나 정리 중입니다.","R.S.S.의 보고를 기다리고 있습니다.","문제가 생기기 전에 조용히 해결하는 편이에요.","설립자님께서 모르셔도 되는 일은 제가 처리해 두었습니다."]],["예산은 충분해?",["충분합니다. 불필요하게 쓰지 않으니까요.","아이들의 장비 교체에 약간의 추가가 필요합니다.","절약은 제 특기랍니다.","예산이 부족해도 방법은 항상 찾습니다.","필요한 항목은 정리하여 보내 드리겠습니다."]],["인력은 충분해?",["핵심 인력은 충분합니다. 다만 사무 인원이 조금 모자랍니다.","한두 명 더 있으면 좋겠습니다.","신뢰할 수 있는 사람이 중요하니 급하게 뽑지는 않으려고요.","소수정예를 지향합니다.","충원은 천천히 해도 괜찮습니다."]],["휴가 갈래?",["가끔은 조용한 곳에서 차만 마시며 지내고 싶군요.","설립자님이 허락하신다면 사흘 정도 쉬고 싶습니다.","휴가 중에도 마음은 여기에 있겠지만요.","예정은 없지만 필요해지면 말씀드리겠습니다.","휴가를 가면 아이들이 걱정하니 천천히 계획해 보겠습니다."]],["출장 갈 일 있어?",["국가 방문 상담 때문에 한 번 나갈 예정입니다.","가끔 직접 찾아뵙는 것도 중요하니까요.","출장 가는 길에 좋은 찻집을 찾아볼 생각입니다.","필요하다면 어디든 가겠습니다.","설립자님의 지시가 있으면 즉시 출발하겠습니다."]],["회의는 많아?",["많지 않아요. 필요한 말만 짧게 하는 것이 제 방식입니다.","주 1회 팀 회의가 있고, 다른 부서와의 협의는 필요할 때만 합니다.","회의가 길어지는 것을 좋아하지 않습니다.","회의는 최대한 부드럽게 진행하려 노력합니다.","회의 후에는 꼭 차를 한 잔 나눕니다."]],["서류 결재 좀 부탁해.",["준비해 두었습니다. 서명하실 곳에 작은 표시를 해 두었어요.","급한 것부터 정리했습니다. 위에서부터 보시면 됩니다.","읽으시기 편하도록 요약을 첨부했습니다.","바쁘시면 제가 대신 정리해서 드릴 수도 있어요.","결재 후에는 제가 조용히 처리하겠습니다."]],["새 지시를 내릴게.",["네, 말씀하세요. 한 글자도 놓치지 않겠습니다.","받아 적을 준비가 되었습니다.","설립자님의 지시는 곧 제 일입니다.","이행 방식이나 기한을 말씀해 주시면 더 정확히 처리하겠습니다.","무엇이든 깔끔하게요."]],["우선순위는 어떻게 정해?",["가장 중대한 일, 가장 오래 걸리는 일 순서입니다.","사람과 관련된 일은 항상 먼저입니다.","설립자님의 일은 언제나 최우선이에요.","기한이 정해진 것부터 처리하되 마음이 쓰이는 것도 챙깁니다.","솔직히 말하면 직관을 많이 따릅니다."]],["일 잘하는 비결은?",["미루지 않고, 서두르지 않는 것입니다.","조용히, 정확하게, 끝까지요.","일과 감정을 분리하는 것도 중요하지요.","좋은 차 한 잔은 업무의 효율을 높여 줍니다.","모든 일이 제자리에 있다고 믿는 것입니다."]],["일 미루는 사람은 어떡해?",["부드럽게 이유를 물어봅니다. 대부분 이유가 있으니까요.","그래도 개선되지 않는다면 기한을 정해 드립니다. 한 달이요.","미루는 습관은 결국 자신에게 해롭습니다.","저는 사람을 쉽게 포기하지 않아요. 기회를 여러 번 드립니다.","한 번 더 미루면… 그다음은 제가 직접 뵙겠습니다."]],["실수한 직원이 있으면?",["괜찮다고 먼저 말해 줍니다. 그다음 함께 정리합니다.","실수는 누구나 합니다. 중요한 것은 그 뒤의 행동이지요.","다시는 같은 실수가 없도록 조용히 가르칩니다.","큰 실수라면 저와 따로 차를 마시게 됩니다.","비난은 하지 않습니다. 대신 다시 한번 눈을 마주칩니다."]],["칭찬할 직원은?",["Alpha 팀의 팀장은 늘 성실합니다.","사무 인원 한 분이 서류를 완벽하게 정리해 주었어요.","모두 칭찬하고 싶지만 한 분만 꼽자면 가장 조용한 분입니다.","칭찬은 직접 해 드리는 편이 좋습니다.","저의 비서도 훌륭합니다. 눈치가 빠르고 입이 무거워서요."]],["신입 교육은?",["가장 먼저 침착함을 가르칩니다.","정중함은 무기라고 가르칩니다.","실전보다 마음가짐에 더 시간을 씁니다.","한 달 동안 저와 함께 일하며 배우게 합니다.","무서워하는 신입도 있지만 곧 적응합니다."]],["일할 때 듣는 건?",["조용한 현악 음악을 틀어 둡니다.","빗소리나 파도 소리를 들을 때가 많아요.","아무것도 듣지 않을 때도 있습니다. 고요가 가장 좋거든요.","차를 우리는 소리가 좋습니다.","설립자님의 목소리를 녹음해 두었다면 그것을 듣고 싶네요. …농담입니다."]],["일할 때 습관은?",["차를 한 잔 옆에 두고 시작합니다.","서류는 한 번에 하나씩, 끝낼 때까지 다른 것을 보지 않습니다.","한 시간마다 창밖을 봅니다.","손을 정갈하게 씻는 습관이 있습니다.","일이 끝나면 반드시 책상을 깨끗이 닦습니다."]],["책상 위에는 뭐가 있어?",["찻잔 하나, 펜 한 자루, 그리고 장부입니다.","작은 화분이 있습니다. 직원이 선물해 주었어요.","가장 중요한 것은 아무것도 없다는 점입니다. 쌓아 두지 않습니다.","설립자님께서 주신 문서를 가장 위에 두고 있습니다.","특별한 물건은 없습니다. 일하는 곳이니까요."]],["일하기 싫을 때는?",["차를 한 잔 우립니다. 그것으로 대부분 해결됩니다.","그럴 때는 하루만 천천히 일합니다.","싫은 마음을 인정하고 조금만 시작해 봅니다.","그런 날이 거의 없는 것이 제 장점입니다.","설립자님의 얼굴을 떠올리면 다시 일할 힘이 납니다."]],["업무에서 보람 있는 순간은?",["불필요한 소란 없이 모든 것이 정리되었을 때입니다.","아이들이 무사히 복귀했을 때입니다.","서류 한 장이 깔끔하게 마무리될 때요.","설립자님께 도움이 되었다고 생각될 때입니다.","차를 마시며 하루를 돌아볼 때, 문제가 없었다고 느껴지는 순간입니다."]],["업무에서 지루한 순간은?",["같은 서류를 반복해서 검토할 때입니다.","회의가 끝나지 않을 때입니다.","솔직히 지루함은 잘 느끼지 않습니다. 조용한 시간이 좋아서요.","기다리는 시간이 길어질 때요.","인내심 훈련이라고 생각하면 견딜 만합니다."]],["일과 삶의 균형은?",["일 60, 삶 40쯤이에요. 좋은 편이라 생각합니다.","일이 삶의 일부이니 구분은 큰 의미가 없어요.","쉬는 시간만큼은 철저히 쉬려고 합니다.","설립자님은 제가 걱정할 일이 없도록 잘 지켜 주세요.","균형은 잃으면 되돌리기 어려우니 늘 신경 씁니다."]],["일 때문에 놓친 것은?",["오래전에 놓친 인연이 하나 있습니다. 말씀드리기 어렵지만요.","친구들과의 시간이 줄었습니다.","큰 후회는 없습니다.","가끔은 꽃이 피는 것도 놓치곤 해요.","일이 있어 얻은 것이 훨씬 많습니다."]],["업무 중 간식은?",["달지 않은 과자와 차입니다.","견과류를 조금씩 먹습니다.","팀원들이 가끔 쿠키를 구워 주기도 해요.","차와 함께하는 작은 간식이 하루의 기쁨입니다.","설립자님께도 한 상자 보내 드릴게요."]],["R.S.S.에 요청한 정보가 있어?",["불법 국가의 징후와 관련된 정보를 요청해 두었습니다.","아비시온 사령관께서 정확하게 보내 주십니다.","저는 필요한 것만 요청해서 번거롭게 하지 않으려 합니다.","특별한 요청은 없습니다. 일상적인 공유입니다.","정보가 확실해야 저희가 움직일 수 있으니까요."]],["뤼시앙과는 어떤 협의를 해?",["법적 근거를 확인할 때 자주 이야기합니다.","유예 기간과 처리 절차에 관한 것입니다.","뤼시앙 사령관은 늘 논리정연하셔서 도움이 됩니다.","서로 존중하는 사이라 협의가 빠르게 끝납니다.","저희가 하는 일이 법에 맞는지 항상 확인합니다."]],["비상 상황이 오면?",["침착하게 팀을 소집하고 상황을 정리합니다.","설립자님께 가장 먼저 보고드립니다.","저는 비상일수록 웃습니다. 모두가 안심할 수 있도록요.","대응 매뉴얼은 항상 준비되어 있습니다.","비상은 오지 않는 것이 최선이지만, 오면 조용히 끝냅니다."]],["오늘 퇴근은?",["정시에 할 예정입니다. 오늘은 별일이 없네요.","설립자님의 일정에 맞춰 조정하겠습니다.","퇴근 후에도 연락은 닿도록 해 두겠습니다.","차 한 잔을 마신 뒤에 나설까 합니다.","일이 없다면 일찍 가도 좋겠지요."]],["내가 도울 일은?",["설립자님은 앉아서 지켜봐 주시는 것만으로도 충분합니다.","지금은 없습니다. 감사합니다.","정 도와주시겠다면 차를 한 잔 같이 해 주세요.","서명 한 장이면 충분합니다.","마음만으로도 큰 도움이 됩니다."]],["같이 일해 볼까?",["영광입니다. 설립자님과 함께라면 모든 것이 더 평화롭겠지요.","네, 기꺼이요. 어떤 일을 함께할까요.","함께 일하면 제 하루가 더 빛나겠습니다.","필요하시면 언제든 불러 주세요.","그렇다면 먼저 차를 한 잔 준비하겠습니다."]],["방문객 응대는 어떻게 해?",["먼저 따뜻한 차를 드립니다. 그다음 천천히 이야기를 듣습니다.","긴장하신 분들이 편안해지도록 신경 씁니다.","누구든 정중하게 대합니다. 마지막 순간까지요.","솔직하게 말씀해 주시는 분이 가장 좋아요.","안내는 부드럽게, 결정은 확실하게 합니다."]],["면담 일정은?",["오늘 오후 두 건이 예정되어 있습니다.","내일은 한 건, 모레는 비어 있습니다.","모든 면담에는 반드시 차를 준비해 둡니다.","일정은 정리해서 보내 드릴게요.","면담 전에 상대의 서류를 모두 읽어 둡니다. 그것이 예의지요."]],["서류 보관은 어떻게 해?",["보안 등급에 따라 이중으로 보관합니다.","장부는 제가 직접 관리합니다.","불필요한 서류는 즉시 파기하고요.","R.S.S.와 연동하여 이중으로 기록합니다.","한 번 적힌 이름은 지워지지 않도록 합니다."]],["장부는 언제 갱신해?",["매주 금요일에 갱신합니다.","큰 변동이 있으면 즉시 반영합니다.","장부는 제가 가장 아끼는 것입니다. 한 글자도 틀리지 않게 쓰지요.","갱신할 때마다 새로운 이름이 적히는 것이 뿌듯해요.","가끔은 지워지는 이름도 있지만요."]],["차 우리는 것도 업무야?",["업무는 아니지만 업무에 가장 큰 영향을 주는 일이지요.","방문객을 위한 차는 업무라고 해도 되겠네요.","차를 우리는 동안 생각이 정리됩니다.","네, 제 가장 중요한 업무 중 하나입니다.","설립자님께도 한 잔 우려 드리고 싶습니다."]],["가장 중요한 업무는?",["약속을 지키는 일입니다. 유예 기간도 약속이니까요.","이름이 올바르게 적혀 있는지 확인하는 일입니다.","리바이어던의 질서를 지키는 것입니다.","설립자님이 원하시는 방향으로 일하는 것이지요.","한마디로 ‘정리’입니다."]],["일 얘기는 여기까지!",["네, 알겠습니다. 이제는 편히 이야기해요.","일 이야기를 마치니 조금 아쉽네요. 늘 재미있었거든요.","그럼 이제 차 이야기를 할까요.","좋습니다. 이제부터는 사적인 대화입니다.","설립자님이 원하시는 화제로 이야기해요."]]]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX63"><Properties><string name="Name">food</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["좋아하는 음식은?",["따뜻한 국물 요리와 갓 지은 밥입니다. 소박한 것이 제일 평화로워요.","차에 곁들이는 작은 과자들을 좋아합니다. 한 입 크기라 정갈하지요.","찜 요리입니다. 불을 줄이고 오래 기다리면 모든 것이 부드러워지거든요.","솔직히 먹는 것보다 대접하는 것을 더 좋아합니다.","설립자님이 권하신 음식은 영광스러운 마음으로 먹게 됩니다."]],["싫어하는 음식은?",["식은 음식은 별로 좋아하지 않습니다. 정성이 식은 것 같아서요.","지나치게 자극적인 음식은 피합니다. 마음이 어지러워지거든요.","싫어하는 것은 없습니다. 있어도 웃으며 먹지요.","씹을 때 소리가 큰 음식은 조금 불편합니다.","굳이 꼽자면 날것입니다. 조용히 손질한 음식이 좋아서요."]],["아침은 뭐 먹어?",["따뜻한 차와 죽 한 그릇입니다. 하루를 부드럽게 시작하지요.","토스트와 달걀 한 개를 곁들입니다. 규칙적이에요.","가볍게 과일과 요거트를 먹습니다.","차만 마시는 날도 있어요. 속이 고요한 날이지요.","설립자님은 무엇을 드시나요? 같이 먹고 싶은데요."]],["점심 뭐 먹었어?",["구내식당의 정식을 먹었어요. 생선구이가 괜찮았습니다.","직원들과 함께 국수를 먹었습니다. 후루룩 소리가 시끄러웠지만 즐거웠어요.","아직입니다. 설립자님과의 대화가 끝나면 가려고요.","도시락을 챙겨 왔어요. 직접 쌌습니다.","가볍게 샌드위치와 차로 해결했습니다."]],["저녁 메뉴 추천해 줘.",["뜨끈한 전골은 어떨까요. 하루의 피로가 풀립니다.","생선조림에 따뜻한 밥을 곁들이세요.","가볍게 죽이나 수프를 드시는 것도 좋습니다.","설립자님이 먹고 싶은 것을 드세요. 그것이 정답입니다.","차가운 날이라면 따뜻한 국수가 좋겠군요."]],["매운 거 잘 먹어?",["조금은 먹습니다. 땀이 나는 것은 별로지만요.","잘 먹는 편입니다. 의외라고 하는 분이 많지요.","매운 음식은 마음을 어지럽혀서 가끔만 먹습니다.","순한 맛이 좋습니다. 하지만 설립자님이 권하신다면 먹어 보겠어요.","매운 것을 먹을 때에도 표정이 변하지 않는다고들 합니다."]],["단 거 좋아해?",["좋아합니다. 차와 함께라면 더욱이요.","달콤한 것은 사람을 온화하게 만들지요.","너무 달지 않은 팥 디저트가 좋아요.","솔직히 단 것을 먹을 때가 가장 행복합니다.","아이들이 만든 쿠키가 제 비밀 간식입니다."]],["커피 vs 차?",["차입니다. 이것은 제 평생의 선택이에요.","커피도 마시지만 마음에 드는 것은 차입니다.","저는 차의 시간을 좋아합니다. 천천히 우러나는 그 시간이요.","손님께는 커피를, 저는 차를 마시지요.","설립자님께서 커피를 원하신다면 정성껏 내려 드리겠어요."]],["어떤 차를 좋아해?",["백차와 우롱차를 즐겨 마십니다.","홍차는 오후에, 녹차는 아침에 마셔요.","허브차도 좋아해요. 마음을 가라앉혀 주거든요.","계절마다 다른 차를 마십니다. 겨울에는 따뜻한 생강차요.","설립자님께 어울리는 차를 한 가지 골라 두었습니다."]],["찻잎은 어떻게 골라?",["향을 먼저 맡고, 모양을 보고, 마지막으로 마셔 봅니다.","신선한 찻잎은 숨을 쉬는 듯한 향이 나요.","오랜 단골 가게가 있습니다. 주인과도 친해요.","이름이 아니라 손의 감촉으로 고릅니다.","좋은 차는 기다려 주는 사람에게만 좋은 맛을 내어 줍니다."]],["술은 마셔?",["가끔 한 잔 정도입니다. 취하면 말이 길어져서요.","거의 마시지 않습니다. 정신이 흐려지는 것이 싫어서요.","분위기를 위해 한두 잔 마십니다.","제가 술에 취하면 오히려 더 웃는다고 합니다. 주변은 더 무서워하고요.","설립자님과 함께라면 조용한 곳에서 한 잔 하고 싶군요."]],["디저트는?",["작은 양갱이나 푸딩을 좋아합니다.","제철 과일이 최고지요.","차와 함께 먹는 쿠키가 가장 좋습니다.","너무 화려한 것은 부담스러워요. 소박한 것이 좋습니다.","디저트는 하루를 마무리하는 작은 예의입니다."]],["빵 vs 밥?",["밥입니다. 한 숟갈 한 숟갈이 든든해요.","빵도 좋아합니다. 아침에는 특히요.","저는 밥 쪽에 조금 더 마음이 갑니다.","둘 다 좋지만 차와 어울리는 것은 빵이네요.","설립자님이 드시는 쪽을 따르겠습니다."]],["면 vs 밥?",["면입니다. 후루룩 먹을 때 기분이 풀립니다.","밥이 더 정갈하다고 생각합니다.","그날의 기분에 따라 달라요.","국수는 마음을 데워 주는 음식이지요.","어느 쪽이든 따뜻하다면 좋습니다."]],["고기 vs 생선?",["생선입니다. 담백한 맛이 좋아요.","고기도 좋아합니다. 부드럽게 익힌 것이요.","저는 생선을 손질하는 일도 좋아합니다. 깔끔하게요.","둘 다 감사히 먹지만 선택하라면 생선이에요.","설립자님 취향에 맞춰 대접하겠습니다."]],["채소는 잘 먹어?",["네, 좋아해요. 신선한 채소를 보면 마음이 맑아집니다.","모든 채소를 골고루 먹습니다. 편식은 하지 않아요.","특히 버섯과 호박이 좋습니다.","채소는 조용한 음식이라 마음에 듭니다.","샐러드도 즐겨 먹습니다."]],["간식은?",["차에 곁들이는 작은 과자입니다.","견과류와 말린 과일이 서랍에 있어요.","팀원들이 가져다주는 쿠키를 받아먹습니다.","달지 않은 쌀과자를 좋아해요.","설립자님께 간식을 한 상자 보내 드릴게요."]],["편의점 가?",["가끔 갑니다. 새로 나온 과자를 구경하는 재미가 있어요.","야간 근무 때 따뜻한 음료를 사러 갑니다.","저는 편의점 직원분들이 친절해서 좋아합니다.","자주 가지는 않지만 필요할 때 들르지요.","편의점 도시락의 진화에 놀라고 있습니다."]],["요리는 직접 해?",["네, 자주 합니다. 요리하는 시간은 마음이 평온해져요.","간단한 것은 직접 합니다. 차와 간식은 특히요.","손님을 위한 요리는 정성을 다합니다.","가끔 팀원들을 위해 만들어 주기도 해요.","솔직히 요리는 정리와 닮아서 좋아합니다."]],["요리 잘해?",["평균 정도입니다. 그래도 정성만큼은 최고예요.","칭찬을 많이 받습니다. 사실 대부분 무서워서일지도요.","잘한다기보다 꾸준히 한다고 해야겠네요.","손질하는 솜씨가 좋다는 말을 자주 듣습니다.","설립자님께는 제대로 대접하고 싶군요."]],["소버린 아일랜드 맛집은?",["항구 옆 작은 식당의 생선탕을 추천합니다.","조용한 찻집이 몇 군데 있어요. 제가 자주 갑니다.","언덕 위의 작은 빵집도 좋아요.","설립자님이 가신다면 제가 안내하겠습니다.","저만 아는 비밀 식당이 있습니다. 설립자님께만 알려 드릴게요."]],["구내식당 어때?",["깔끔하고 정갈합니다. 영양 균형도 좋아요.","직원들이 모여 식사하는 모습을 보면 흐뭇합니다.","금요일 메뉴가 특히 좋습니다.","저는 늘 같은 자리에 앉습니다. 창가 쪽이요.","가끔 조리사분께 감사 인사를 합니다."]],["도시락 싸 와?",["가끔 직접 쌉니다. 정성 들여서요.","작은 찬합에 담아 옵니다. 예쁘지요.","식당에서 먹는 날이 더 많습니다.","설립자님 몫도 싸 드릴 수 있어요.","도시락 싸는 시간은 아침의 즐거움입니다."]],["야식 먹어?",["가끔요. 따뜻한 차와 가벼운 간식 정도입니다.","밤에는 속이 편한 것을 먹습니다.","야식은 잠을 방해해서 자제합니다.","설립자님이 함께하시면 기쁘게 먹겠습니다.","야식이 필요한 날에는 죽을 끓입니다."]],["라면은?",["가끔 먹습니다. 계란을 풀어서요.","라면은 가끔 생각나는 친구 같은 음식이에요.","끓이는 시간을 정확히 지킵니다.","야근하는 직원들에게 끓여 주기도 해요.","의외로 잘 끓이는 편입니다."]],["초콜릿은?",["좋아합니다. 특히 따뜻한 차와 함께요.","다크 초콜릿을 조금씩 먹습니다.","받으면 기쁘지만 제가 먼저 사지는 않아요.","아이들이 선물해 주는 초콜릿은 아껴 먹습니다.","설립자님께도 한 조각 나눠 드리고 싶네요."]],["아이스크림은?",["여름이면 자주 먹습니다. 바닐라가 좋아요.","차가운 것은 가끔만 먹습니다. 속이 놀라서요.","녹기 전에 먹는 것이 예의입니다.","설립자님과 나눠 먹고 싶네요.","겨울에도 먹는 분들이 이해되지 않았는데 이제는 알 것 같아요."]],["과일은?",["복숭아와 배를 좋아합니다.","과일은 껍질을 직접 깎아 먹습니다.","제철 과일을 즐기는 것이 작은 사치입니다.","사과를 한 알 먹으면 하루가 가볍습니다.","설립자님께 과일을 깎아 드리면 좋겠군요."]],["팀원이 쿠키를 구워 준다던데?",["네, 가끔 구워 줍니다. 모양은 서투르지만 마음이 담겨 있어요.","저를 위해 직접 만들었다고 하면 감동하지 않을 수 없지요.","다 먹은 후 빈 통에 작은 선물을 넣어 돌려줍니다.","그 아이들은 제가 좋아하는 맛을 잘 알아요.","아이들의 정성이 가장 맛있는 간식입니다."]],["식사 시간은?",["정해진 시간에 천천히 먹습니다.","식사는 서두르지 않습니다. 천천히 씹어야 소화가 잘 되니까요.","점심은 정오, 저녁은 여섯 시경입니다.","식사 시간이 가장 평화로운 시간입니다.","식사 중에는 일 이야기를 하지 않습니다."]],["먹기 싫을 때는?",["조금만 먹습니다. 억지로 먹지는 않아요.","따뜻한 차로 대신합니다.","그런 날은 쉬라는 신호이니 일찍 눕습니다.","누군가 권하면 한 입은 먹습니다. 예의니까요.","설립자님은 꼭 드셔야 합니다. 건강하셔야 하니까요."]],["같이 밥 먹을래?",["네, 기쁘게요. 장소는 제가 정할까요?","설립자님과 함께하는 식사라니 영광입니다.","조용하고 맛있는 곳으로 모시겠습니다.","식사 후에는 차도 한 잔 하시겠어요?","그날을 위해 일정을 정리해 두겠습니다."]],["내가 요리해 줄게.",["정말요? 평생 잊지 못할 선물이 될 것 같아요.","맛이 어떻든 남기지 않고 다 먹겠습니다.","저도 거들까요? 아니면 얌전히 기다릴까요.","그 날을 위해 배를 비워 두겠습니다.","설립자님의 요리를 맛볼 수 있다니 영광입니다. 정좌하고 먹겠습니다."]],["소원이 음식이라면?",["설립자님과 함께 먹는 따뜻한 한 끼를 청하겠습니다.","아주 오래전에 먹었던 죽 한 그릇을 다시 먹고 싶어요.","차 한 잔과 함께하는 평온한 오후입니다.","소원이 음식이라니, 참 소박하군요. 그래서 좋습니다.","그리운 사람이 만들어 준 요리를 다시 먹고 싶습니다."]],["가장 맛있었던 음식은?",["아팠을 때 누군가 끓여 준 죽입니다.","비 오는 날 먹은 따뜻한 국수예요.","첫 월급으로 사 먹은 찻집의 케이크였습니다.","설립자님과 함께한 다과 시간입니다.","맛은 마음이 만든다는 것을 배웠습니다."]],["가장 맛없었던 음식은?",["너무 식어 버린 도시락입니다.","손님을 접대하며 억지로 먹은 음식입니다.","맛없다기보다 편치 않은 자리에서 먹은 음식이 있었습니다.","누구에게도 말하지 않겠습니다.","그 이야기는 차가 식은 뒤에 하겠습니다."]],["추억의 음식은?",["어린 시절 먹던 흰죽입니다.","정원에서 먹던 구운 고구마예요.","비 오는 날 먹던 부침개이지요.","누군가와 함께 먹었던 따뜻한 국수입니다.","추억의 맛은 이제 다시 만들 수 없습니다."]],["식사 중에도 일 얘기를 해?",["하지 않으려 해요. 식사는 쉬는 시간이니까요.","급한 일이 아니라면 미룹니다.","저는 식사 중에는 평화로운 이야기만 하고 싶어요.","설립자님이 원하신다면 하겠지만요.","차 한 잔 후에 일 이야기를 하는 것이 순서입니다."]],["혼밥 자주 해?",["자주 하는 편입니다. 조용해서 좋아요.","혼자 먹을 때도 정성껏 차립니다.","누군가와 먹는 것이 그립기도 합니다.","설립자님이 불러 주신다면 언제든 갑니다.","혼자 있는 식사 시간에 가장 많이 생각합니다."]],["회식은?",["즐거운 자리라고 생각합니다. 팀원들의 웃음소리가 좋아요.","저는 한쪽에서 조용히 차를 마시며 지켜봅니다.","소란스러운 곳은 약간 힘들지만 참석합니다.","회식 후 귀가 안전은 제가 직접 확인해요.","저는 술보다 분위기를 즐깁니다."]],["건강식 챙겨?",["네, 가능한 한 균형 있게 먹으려 합니다.","차와 곡물을 많이 먹어요.","몸을 챙기는 것은 마음을 챙기는 것이니까요.","설립자님도 챙겨 드시길 바랍니다.","좋은 식사는 평화의 시작이지요."]],["샐러드는?",["가볍게 먹기 좋습니다. 신선한 채소가 좋아요.","드레싱은 담백하게 먹는 편입니다.","점심에 가끔 먹어요.","저는 모양 예쁘게 담는 것도 좋아합니다.","설립자님께 만들어 드릴 수 있어요."]],["스프는?",["겨울에는 거의 매일 먹습니다.","호박 스프를 가장 좋아합니다.","따뜻한 스프는 마음을 풀어 주지요.","직접 끓이기도 해요.","설립자님께 한 그릇 올릴게요."]],["치즈는?",["차와 함께 먹는 치즈가 의외로 잘 어울립니다.","좋아합니다. 특히 부드러운 것이요.","향이 강한 것은 조금 어려워요.","와인과 함께라면 더욱 좋겠지요.","한 조각만 먹어도 만족스럽습니다."]],["차에 설탕 넣어?",["넣지 않습니다. 차 본연의 향을 즐기는 편이에요.","꿀을 조금 넣을 때는 있어요.","피곤할 때는 설탕을 한 스푼 넣기도 합니다.","설립자님은 어떻게 드시나요?","차마다 다르게 마십니다. 정답은 없어요."]],["짠 음식은?",["건강에는 좋지 않으니 피하지요.","가끔은 짭짤한 음식이 먹고 싶을 때가 있어요.","저는 순하게 먹는 편입니다.","짠 음식을 드실 때는 차를 곁들이세요.","음식은 담백해야 오래 먹을 수 있습니다."]],["아침을 거르면?",["속이 비어 마음이 불안해집니다.","차 한 잔이라도 마시고 시작하는 편이에요.","아침을 거르면 하루가 흐트러지는 느낌입니다.","설립자님께서는 거르지 마세요.","저는 거의 거르지 않습니다."]],["지금 배고파?",["조금요. 하지만 차를 마시면 괜찮아집니다.","아니요, 방금 먹었어요.","설립자님과 이야기 중이라 잊고 있었네요.","그러고 보니 출출한 것 같습니다.","곧 간식 시간입니다."]],["찻집 추천해 줘.",["항구 근처 ‘작은 달’이라는 찻집이 아늑합니다.","언덕 위 찻집은 전망이 좋아요.","제가 자주 가는 곳은 조용하고 향이 좋습니다.","설립자님과 함께 가고 싶은 찻집이 있어요.","원하시면 지도를 그려 드릴게요."]],["다과를 대접한다면?",["작은 쿠키와 제철 과일, 그리고 향 좋은 차를 준비하겠습니다.","따뜻한 차와 직접 만든 양갱을 드리고 싶어요.","정성스럽게 차려서 천천히 대접하겠습니다.","손님께 드리는 마음으로 가장 좋은 것을 꺼내 놓겠습니다.","설립자님을 위한 다과상은 이미 마음속에 그려져 있습니다."]]]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX64"><Properties><string name="Name">honest</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["솔직히 나 어때?",["솔직하게 말씀드리면, 설립자님은 제가 모시는 분 중 가장 훌륭하세요.","현명하고 단단한 분이세요. 그 두 가지가 한 사람에게 있다는 것이 놀랍습니다.","저는 설립자님을 존경하고, 그 이상으로 모시는 것을 자랑스럽게 여깁니다.","때때로 무리하시는 점은 걱정이지만 그것도 책임감의 표현이라 여깁니다.","아무리 생각해도 흠잡을 곳이 없습니다. 흠을 찾으면 정리해 드릴게요."]],["나한테 불만 있어?",["불만은 없습니다. 있어도 말씀드리지 않겠지만요.","정말 없습니다. 설립자님이 하시는 일은 모두 옳다고 믿거든요.","굳이 말하자면 쉬지 않으시는 점입니다.","불만이 있다면 저 자신에게 있어요. 더 잘하지 못해서요.","있다 해도 차를 한 잔 마시면 사라질 정도입니다."]],["이 일 힘들지 않아?",["힘들지 않다고 하면 거짓이겠지요. 그래도 괜찮습니다.","힘든 순간은 있지만 웃으며 넘깁니다.","마음이 무거운 날도 있지만 설립자님을 위한 일이니 견딜 만해요.","누군가는 해야 하는 일이라면, 제가 하는 편이 낫겠지요.","설립자님이 알아봐 주시니 힘이 납니다."]],["힘들 때 어떻게 해?",["차를 한 잔 마시고 창밖을 봅니다.","혼자 정원을 걷습니다. 아무도 없는 시간에요.","아이들과 이야기하면 조금 풀립니다.","가끔 크게 한숨을 쉬고 다시 미소를 짓습니다.","설립자님의 얼굴을 떠올리면 힘이 납니다."]],["솔직히 쉬고 싶지 않아?",["쉬고 싶습니다. 긴 휴식이 필요할 때가 있어요.","솔직히 말하면 이 자리를 내려놓고 조용히 차만 팔고 싶은 날이 있습니다.","쉬고 싶지만 쉬는 법을 잊었는지도 몰라요.","설립자님께서 허락하신다면 며칠 쉬겠습니다.","쉬고 나면 더 잘할 수 있다는 것도 알고 있습니다."]],["가장 큰 고민은?",["제 일이 누군가에게 두려움이 되는 것입니다.","이 일을 언제까지 계속할 수 있을지입니다.","아이들이 다치지 않을까 하는 걱정이에요.","설립자님께서 짊어지신 짐이 너무 무거워 보이는 것입니다.","저의 미소가 진짜인지 가끔 헷갈립니다."]],["숨기고 싶은 비밀은?",["비밀이 되려면 말하지 않아야겠지요. 그래서 말씀드리지 않겠습니다.","저는 비밀이 아주 많습니다. 하나만 고르기 어렵군요.","서랍 속에 오래된 사진이 한 장 있습니다.","설립자님께 말씀드리지 못한 일이 한두 가지 있어요.","웃으며 말하기엔 조금 무거운 이야기입니다."]],["부끄러웠던 일은?",["회의 중에 차를 쏟은 적이 있습니다. 모두 못 본 척해 주셨어요.","설립자님 앞에서 이름을 잘못 부른 적이 있습니다.","어린 시절 큰 실수를 한 기억이 있습니다.","제 미소가 어색하다는 말을 들었을 때입니다.","솔직히 오늘도 몇 번 있었습니다."]],["후회하는 일은?",["돌려보낸 사람이 있습니다. 그분께 조금 더 친절했어야 했어요.","하지 못한 말들이 가장 큰 후회입니다.","제가 선택한 길이 옳았는지 가끔 돌아봅니다.","감사드려야 할 분께 감사 인사를 미루다 전하지 못한 것입니다.","후회는 정리되지 않는 장부 같아서 계속 남습니다."]],["다시 태어나면?",["조용한 찻집의 주인이 되고 싶어요.","정원사가 되어 꽃을 가꾸며 살고 싶습니다.","같은 길을 걷겠지만, 조금 더 웃을 겁니다.","설립자님을 모시는 삶이라면 몇 번이든요.","다시 태어나도 저는 저일 거예요. 그것이 조금 슬프기도 합니다."]],["무서운 것은?",["소중한 이를 잃는 일입니다.","아무도 저에게 말을 걸지 않는 날이 올까 두렵습니다.","제가 변해 버리는 것이요.","어둠이 아니라 고요가 무섭습니다. 너무 조용하면 생각이 많아져서요.","설립자님께 실망을 드리는 일입니다."]],["외로울 때는?",["차를 두 잔 우립니다. 한 잔은 제 몫, 한 잔은 오지 않을 손님의 몫이에요.","정원에서 혼잣말을 합니다.","설립자님의 통신을 기다리지요.","외로움은 익숙해지면 친구가 됩니다.","그럴 땐 일부러 바쁘게 지냅니다."]],["자존심 상했던 일은?",["제 미소를 위선이라고 했던 사람이 있었어요.","일을 제대로 마무리하지 못한 날입니다.","자존심보다 마음이 아팠던 일이 많습니다.","솔직히 이 질문은 대답하기 어렵군요.","지금은 웃어넘길 수 있지만 그땐 하루 종일 차 맛이 쓰더군요."]],["질투 나는 사람은?",["자유롭게 웃는 분들이 부럽습니다.","솔라리아 사령관의 밝음이 가끔 부럽습니다.","다른 사람의 일상을 보면 조금 질투가 나요.","설립자님께 가까이서 쓰임받는 분들이 부럽습니다.","질투는 해도 소용없다는 것을 알면서도요."]],["가끔 규칙이 싫을 때는?",["규칙 때문에 누군가를 돌려보내야 할 때입니다.","예외를 두고 싶은 순간이 있습니다. 하지만 두지 않아요.","규칙은 지켜야 하지만 때때로 아픕니다.","그럴 때는 규칙을 만든 이유를 다시 떠올립니다.","싫다고 해서 지키지 않을 수는 없지요. 그것이 제 일이니까요."]],["카네히라는 솔직히 어때?",["성실하고 정직한 분이십니다. 서식 이야기가 조금 길지만요.","보고서가 항상 정확해서 믿음이 갑니다.","때로는 그 완고함이 부러워요.","깍듯한 분이라 대화하면 저도 자세를 바로 하게 됩니다.","좋은 분입니다. 오래 함께하고 싶어요."]],["다른 사령관 흉 좀 봐.",["흉이라니요. 저는 모두 좋아합니다.","굳이 말하자면 솔라리아 사령관은 장난이 조금 심하지요. 귀여운 정도지만요.","누구도 흉볼 만한 사람은 없습니다. 있다면 조용히 정리하겠습니다. …농담이에요.","흉을 보는 것은 제 취향이 아닙니다.","그런 질문에는 미소로 답하겠습니다."]],["내 단점은?",["너무 많은 것을 혼자 짊어지시는 점입니다.","자신을 돌보지 않으시는 점이에요.","단점이라 하기엔 어려운, 인간적인 부분이지요.","때로는 저희를 너무 믿으십니다. 그것이 걱정입니다.","솔직히 단점이 떠오르지 않네요."]],["내 지시 중 이해 안 되는 건?",["가끔 있었지만 결과적으로 모두 옳았습니다.","이해하지 못해도 따르는 것이 제 일입니다.","설립자님께서 계획이 있으시다고 믿어요.","가끔은 마음이 무거운 지시도 있었습니다. 그래도 따랐고요.","이해보다 신뢰가 먼저입니다."]],["설립자가 틀렸다고 생각한 적 있어?",["있었더라도 저는 말씀드리지 않았을 거예요. 설립자님의 판단이 옳다고 믿으니까요.","한 번 있었습니다. 하지만 곧 제가 틀렸다는 것을 알게 되었지요.","틀렸다고 생각하기보다 다른 길이라고 여겼습니다.","설립자님은 틀리지 않으세요. 틀려도 제가 맞춰 드릴게요.","솔직하게 말씀드리면 한두 번 의문이 들었습니다. 그것도 지나갔고요."]],["거짓말해 본 적 있어?",["많습니다. 웃으면서 하는 거짓말이 가장 쉬워요.","설립자님께는 하지 않았습니다. 정말로요.","직업상 불가피한 거짓말은 있지요.","‘괜찮습니다’가 가장 많이 한 거짓말일 거예요.","솔직히 오늘도 한 번 했습니다. 뭔지는 비밀입니다."]],["땡땡이 쳐 본 적 있어?",["한 번 있어요. 찻집에 가서 오후 내내 앉아 있었습니다.","공식적으로는 없습니다.","업무 중에 정원을 오래 산책한 적은 있습니다.","땡땡이도 가끔은 필요하지요. 저는 그렇게 생각합니다.","그 이야기는 아무에게도 하지 않기로 약속하겠습니다."]],["몰래 하는 일은?",["밤에 혼자 정원에서 차를 마십니다.","서랍 속에 비상용 과자를 감춰 둡니다.","모르는 아이들의 안부를 몰래 챙깁니다.","누군가에게 익명으로 선물을 보낸 적이 있어요.","설립자님이 모르시는 일이 몇 가지 있지요. 좋은 일들입니다."]],["사실은 하고 싶은 게?",["조용한 마을에서 작은 찻집을 열고 싶습니다.","여행을 가고 싶어요. 누구도 저를 모르는 곳으로.","아무 의무 없이 하루를 보내 보고 싶습니다.","설립자님과 함께 차를 마시고 싶어요.","정원에 꽃을 가득 심고 싶습니다."]],["눈물 흘린 적 있어?",["있습니다. 아무도 보지 않을 때요.","눈물은 정리하기 어려운 것이지요.","일 때문에 운 적은 없지만 마음 때문에 운 적은 있어요.","제 이야기는 비밀입니다.","설립자님 앞에서는 울지 않으려 노력할게요."]],["화났던 적은?",["많지는 않지만 있습니다. 그럴 때일수록 더 웃어요.","누군가 저의 사람들을 해치려 했을 때입니다.","화가 나면 목소리가 조용해집니다. 그것이 더 무섭다고 하더군요.","화는 마음속에서 차분히 정리합니다.","화를 낸 상대는 대개 오래 기억합니다. 저도요."]],["가장 행복했던 순간은?",["아이들이 처음으로 생일 파티를 열어 주었을 때요.","설립자님께 칭찬받았을 때입니다.","조용한 오후에 차를 마시며 창밖을 볼 때입니다.","평화로운 하루가 끝나는 순간이에요.","지금 이 순간도 꽤 행복합니다."]],["가장 괴로웠던 순간은?",["오래전 소중한 사람을 보냈을 때입니다.","지키지 못한 약속이 있었습니다.","제 손으로 정리해야 했던 일들이 쌓이던 시절입니다.","그 이야기는 지금은 하고 싶지 않아요.","괴로움은 시간이 지나도 사라지지 않고 조용히 쌓일 뿐입니다."]],["자신을 어떻게 평가해?",["친절하지만 무서운 사람이라고 생각합니다.","일에는 충실하고 마음에는 서툰 사람이에요.","좋은 사람인지 아닌지는 잘 모르겠습니다.","설립자님이 저를 믿어 주시는 만큼만 괜찮은 사람입니다.","평가는 타인에게 맡기겠습니다."]],["무섭다는 말 들어 봤어?",["많이 들었습니다. 웃으면서 들어요.","제가 웃으면 더 무섭다고들 하지요.","솔직히 서운할 때도 있어요.","무서워도 괜찮습니다. 설립자님께만 무섭지 않으면요.","그 말은 저에게 칭찬이기도 하고 상처이기도 합니다."]],["웃음이 가짜라는 말에 대해?",["가짜는 아닙니다. 다만 모든 웃음이 기쁨은 아니지요.","웃음은 방패이자 예의입니다.","설립자님 앞에서는 진짜입니다.","제 웃음이 불편하다면 줄이겠습니다.","그 말을 하신 분은 아마 진실을 보셨겠지요."]],["변하고 싶은 점은?",["조금 더 솔직해지고 싶습니다.","사람들이 저를 두려워하지 않았으면 좋겠습니다.","화를 내는 법을 배우고 싶어요. 웃지 않고요.","휴식하는 법을 배우고 싶습니다.","설립자님 앞에서만이라도 가면 없이 있고 싶습니다."]],["변하고 싶지 않은 점은?",["약속을 지키는 점입니다.","차를 사랑하는 마음입니다.","설립자님께 향한 충성이요.","정중함은 저의 일부입니다. 잃고 싶지 않습니다.","아이들을 아끼는 마음입니다."]],["사람들이 오해하는 점은?",["잔인하다는 오해입니다. 저는 질서를 지킬 뿐이에요.","미소가 가식이라는 오해입니다.","저에게 감정이 없다는 오해도 있습니다.","오해라기보다 이해받지 못하는 부분이 있지요.","솔직히 오해해 주시는 편이 편할 때도 있습니다."]],["친구가 있어?",["있습니다. 많지는 않지만 오래된 친구들이요.","찻집 주인이 친구입니다. 저를 무서워하지 않아요.","팀원들이 친구이자 가족입니다.","설립자님이 친구가 되어 주신다면 영광이겠어요.","솔직히 이 질문은 조금 아프군요."]],["소원이 뭐야?",["아무도 다치지 않는 세상이 소원입니다.","설립자님이 평안하시길요.","개인적으로는 조용한 찻집을 여는 것입니다.","아이들이 모두 행복해지는 것입니다.","소원은 말하면 이루어지지 않는다고 하니 마음속에만 두겠습니다."]],["솔직한 심정으로 나를 믿어?",["네, 전적으로 믿습니다.","믿음에 이유는 필요 없지요.","설립자님을 위해서라면 목숨도 걸 수 있어요.","믿지 못한다면 이 자리에 있지 않았을 겁니다.","저의 믿음은 흔들리지 않습니다."]],["설립자 자리가 부러워?",["부럽지 않습니다. 그 무게를 감히 상상할 수 없어서요.","저는 제 자리에서 설립자님을 돕는 것이 좋습니다.","솔직히 두렵습니다. 그 자리에 앉는다는 것이요.","가끔 모든 것을 정리할 수 있다는 점은 부럽네요. 농담입니다.","존경만 있을 뿐 부러움은 없습니다."]],["만약 설립자라면?",["먼저 모두에게 차를 한 잔씩 대접하겠습니다.","아마 첫날부터 많은 것을 정리하려 들겠지요. 그래서 안 됩니다.","상상하기 어렵군요. 설립자님은 설립자님이시니까요.","친절하게, 하지만 단호하게 다스릴 것 같습니다.","좋은 설립자가 되려면 설립자님만큼 현명해야 하겠지요."]],["더 인정받고 싶어?",["가끔은 그렇습니다. 하지만 티를 내지는 않아요.","설립자님께 인정받는 것으로 충분합니다.","인정은 소리 없이 쌓이는 것이라 믿어요.","말로 들으면 기쁘겠지요. 오늘처럼요.","저는 인정보다 신뢰를 원합니다."]],["포기하고 싶었던 적은?",["있었습니다. 그때마다 차 한 잔으로 버텼어요.","마음이 부서질 것 같던 날도 있었습니다.","포기하는 대신 잠시 멈추는 법을 배웠어요.","설립자님 덕분에 포기하지 않았습니다.","지금도 가끔 생각합니다. 그러나 곧 지나갑니다."]],["이 일을 그만두면?",["찻집을 열겠습니다. 이미 가게 이름도 지어 두었어요.","아마 조용히 정원을 가꾸며 지낼 겁니다.","그만두더라도 설립자님과의 인연은 이어 가고 싶습니다.","아직은 그럴 때가 아닙니다.","가끔 상상은 해 봅니다. 평화로운 장면이에요."]],["가장 의지하는 사람은?",["설립자님입니다.","오랫동안 곁을 지킨 비서입니다.","저는 의지하는 것에 서툴러서요. 하지만 있습니다.","다른 사령관들 모두에게 조금씩 기대고 있습니다.","의지할 사람이 있다는 것은 큰 축복이지요."]],["취약점은?",["소중한 이를 위협받을 때 냉정함을 잃는다는 점입니다.","칭찬에 약합니다. 얼굴이 붉어져요.","차가 없을 때 조금 불안합니다.","설립자님께 근심이 있으신 모습을 뵙는 일입니다.","너무 오래 혼자 있으면 생각이 깊어지는 점이에요."]],["약한 모습을 보인 적?",["한 번 있어요. 팀원 한 명을 잃은 날입니다.","설립자님 앞에서 눈시울이 붉어진 적이 있습니다.","약한 모습은 보이지 않는 것이 예의지만 가끔은 들킵니다.","그런 모습도 저의 일부이지요.","이 대화에서도 조금 보였을지 모르겠습니다."]],["솔직하게 칭찬한다면 누구?",["카네히라 사령관의 성실함은 칭찬하고 싶습니다.","뤼시앙 사령관의 논리는 존경합니다.","카엘루나 사령관은 숨은 노력가이십니다.","솔라리아 사령관의 밝음은 모두에게 힘이 되지요.","설립자님이 가장 훌륭하십니다. 이 점은 변하지 않아요."]],["솔직하게 걱정되는 건?",["설립자님의 건강입니다.","아이들의 안전입니다.","제가 점점 무뎌지는 것이 걱정입니다.","이 평화가 오래갈지 모르겠습니다.","누군가의 마음을 몰라보고 지나칠까 걱정됩니다."]],["자기 전에 드는 생각은?",["오늘 하루 아무도 다치지 않았는지 되짚어 봅니다.","내일의 차를 어떤 것으로 마실지 생각합니다.","설립자님은 잘 쉬고 계실까 궁금해집니다.","가끔은 아무 생각도 하지 않으려 눈을 꼭 감습니다.","마지막으로 하는 생각은 늘 ‘무사하길’입니다."]],["하고 싶은 말을 못 한 적?",["많습니다. 용기가 나지 않았어요.","설립자님께 감사하다는 말을 더 자주 하고 싶었습니다.","그 사람에게 ‘미안합니다’라고 하지 못했습니다.","오늘은 조금이나마 말씀드릴 수 있었네요.","아직 못다 한 이야기가 있어요. 언젠가는요."]],["이제 솔직해졌어?",["네, 평소보다 훨씬 솔직했습니다. 차가 다 식었군요.","오늘 이야기는 우리 둘만의 비밀로 해 주세요.","솔직해지니 마음이 한결 가볍습니다.","설립자님 앞에서는 조금 더 솔직해져도 괜찮을 것 같아요.","다음에도 이렇게 이야기해요. 따뜻한 차와 함께요."]]]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX65"><Properties><string name="Name">hobby</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["취미가 뭐야?",["차를 우리는 일과 정원을 가꾸는 일이에요. 조용한 취미지요.","독서와 산책을 즐깁니다. 가끔 바둑도 두고요.","식물을 돌보고, 찻잎을 모으고, 향을 피우는 것이 제 소소한 즐거움입니다.","솔직히 가장 좋아하는 것은 아무것도 하지 않고 창밖을 바라보는 일입니다.","사람을 지켜보는 것도 취미라면 취미겠네요."]],["쉬는 날엔 뭐 해?",["정원을 돌보고 차를 우려 마시며 하루를 보냅니다.","시장에 나가 찻잎과 꽃을 구경하지요.","책을 읽다가 졸리면 그대로 낮잠을 잡니다.","조용한 찻집에서 한참 앉아 있다 옵니다.","아무에게도 방해받지 않는 하루를 보내려 노력해요."]],["책 읽어?",["네, 좋아합니다. 특히 오래된 책의 종이 냄새가 좋아요.","하루에 한 시간은 꼭 읽으려 합니다.","소설도 읽고 수필도 읽습니다.","책을 읽다 보면 사람들의 마음이 보이는 것 같아요.","설립자님께 추천받고 싶은 책이 있습니다."]],["좋아하는 책은?",["정원 가꾸기에 관한 수필집입니다.","오래된 시집을 한 권 갖고 있어요. 제목은 비밀입니다.","미스터리 소설도 좋아합니다. 범인을 맞히는 재미가 있지요.","차에 관한 책은 모두 읽었습니다.","한 권만 고르라면 어린 시절 읽은 동화책입니다."]],["음악 들어?",["조용한 음악을 즐깁니다. 현악이 특히요.","비 오는 날에는 피아노곡을 듣습니다.","가사가 없는 곡이 마음을 평온하게 해 줍니다.","차를 우릴 때는 항상 음악을 틀어 둡니다.","설립자님의 취향도 궁금하군요."]],["좋아하는 음악은?",["느리고 잔잔한 곡입니다. 첼로 독주를 자주 들어요.","오래된 민요도 좋아합니다.","소리가 크지 않고 오래 남는 음악을 좋아해요.","숲속 소리와 섞인 음악도 좋습니다.","직접 연주해 보고 싶은 곡이 하나 있어요."]],["영화 봐?",["가끔 봅니다. 조용하고 여운이 남는 영화를 좋아합니다.","복잡한 것보다 잔잔한 이야기가 마음에 듭니다.","엔딩 크레딧이 끝날 때까지 앉아 있는 편이에요.","혼자 보는 것을 선호합니다. 눈물이 날 수도 있어서요.","설립자님께 추천해 드리고 싶은 영화가 있습니다."]],["운동해?",["아침마다 정원을 걸으며 가볍게 몸을 풉니다.","팀원들과 함께 기초 체력 운동을 해요.","격한 운동은 하지 않지만 꾸준히 합니다.","조용히 하는 요가를 좋아해요.","건강을 위해서라기보다 마음을 위해서 합니다."]],["산책 좋아해?",["네, 아주요. 걷는 동안 마음이 정돈됩니다.","해 질 녘 산책을 좋아해요.","혼자 걷는 것도 좋지만 설립자님을 모시고 걷는다면 영광이겠지요.","산책길의 풍경을 하나하나 기억합니다.","소버린 아일랜드는 걷기에 참 좋은 섬이에요."]],["정원은 어떻게 가꿔?",["아침저녁으로 물을 주고, 시든 잎은 조용히 정리합니다.","계절에 맞는 꽃을 심는 것이 즐거워요.","잡초는 뽑는 것이 아니라 조용히 정리하는 것이지요.","정원은 제 마음을 비춰 주는 거울 같습니다.","설립자님께 꽃을 한 송이 가져다 드리고 싶군요."]],["악기 다룰 줄 알아?",["거문고를 조금 만져 봤습니다.","피아노를 어릴 때 배웠지만 오래 쳐서 서툴러요.","연주하는 것보다 듣는 것이 좋습니다.","차 마시는 시간에 조용히 현을 뜯어 보곤 합니다.","설립자님이 원하신다면 한 곡 들려 드릴게요."]],["노래 불러?",["혼자 있을 때 조용히 흥얼거립니다.","노래는 서툽니다. 다만 목소리가 편안하다는 말은 들어요.","아이들이 졸라서 한 번 불러 준 적이 있습니다.","설립자님 앞이라면 용기를 내어 볼게요.","자장가를 가끔 부릅니다. 잠들지 못하는 아이들에게요."]],["그림은?",["수채화를 조금 그려요. 정원의 꽃을 그립니다.","잘 그리지는 못하지만 색을 칠하는 것이 좋습니다.","그림은 마음을 비우는 데 좋은 방법이지요.","설립자님께 바칠 수채화를 한 점 그려 보고 싶은 마음도 있습니다.","스케치북은 아직 반도 채우지 못했어요."]],["사진은?",["꽃과 하늘을 자주 찍습니다.","사람은 찍지 않는 편이에요. 기억에만 남기고 싶어서요.","카메라를 한 대 가지고 있습니다. 선물받은 것이에요.","설립자님의 사진을 한 장 간직하고 싶네요.","사진 속 장면이 마음을 오래 따뜻하게 해 줍니다."]],["게임은?",["바둑이나 장기 같은 조용한 게임을 좋아합니다.","팀원들과 보드게임을 하기도 해요.","승부욕은 없는 편입니다. 이겨도 져도 웃지요.","설립자님과 한 판 두고 싶습니다.","컴퓨터 게임은 서툽니다. 손이 느려서요."]],["보드게임은?",["가끔 팀원들과 해요. 늘 제가 이겨서 미안합니다.","설명서를 먼저 정독하는 편입니다.","함께 웃을 수 있는 게임이 좋습니다.","설립자님과 한 판 하고 싶군요.","아이들이 일부러 져 주려는 것을 알아서 마음이 따뜻합니다."]],["바둑은?",["좋아합니다. 한 수 한 수에 성격이 드러나지요.","느리게 두는 편입니다. 상대를 기다리는 것에 능숙해요.","이길 때보다 질 때 배우는 것이 많습니다.","설립자님이 두신다면 영광으로 알고 두겠습니다.","바둑판 위에서는 모두가 평등하지요."]],["퍼즐은?",["천 피스 퍼즐을 가끔 맞춥니다.","조각을 하나씩 맞출 때의 쾌감이 좋습니다.","비 오는 날 하기에 최고입니다.","완성한 퍼즐은 한참 바라보다가 해체합니다.","함께 맞추자고 하시면 기쁘게 하겠습니다."]],["수집 취미는?",["찻잔과 찻잎을 모읍니다.","향초와 향을 수집하기도 해요.","특별한 의미가 있는 물건만 모읍니다.","아이들이 선물해 준 것들도 소중히 보관합니다.","설립자님께서 주신 문서와 쪽지를 모두 간직하고 있습니다."]],["정리하는 거 좋아해?",["네, 아주 좋아합니다. 정리는 마음을 깨끗하게 만들지요.","정리하고 나면 개운합니다.","물건뿐 아니라 일과 사람 관계도 정리하는 편이에요.","정리의 마지막은 항상 따뜻한 차입니다.","깔끔한 것이 제 취향입니다. 흔적이 남지 않는 것이요."]],["요리는 취미야?",["네, 가끔 합니다. 특히 차와 곁들이는 간식을요.","손님을 위한 요리를 만드는 것이 즐거워요.","요리는 정성이라고 생각합니다.","설립자님께 드릴 요리를 연습하고 있습니다. 비밀이에요.","새로운 레시피에 도전하는 것도 좋아합니다."]],["차 마시기는 취미야?",["가장 큰 취미입니다. 평생을 함께할 것 같아요.","차를 우리는 일은 명상과 같습니다.","찻잔을 고르는 일부터가 즐거움이지요.","하루에 일곱 잔은 마시는 것 같습니다.","설립자님과 함께 마신다면 더 좋겠습니다."]],["원예는?",["정원 가꾸기는 제 삶의 일부입니다.","씨앗을 심고 싹이 트는 것을 보면 마음이 놓입니다.","꽃도 좋지만 허브를 키우는 것이 실용적이라 좋아해요.","식물은 거짓말을 하지 않아서 편합니다.","설립자님께 작은 화분을 선물하고 싶군요."]],["낚시는?",["가끔 갑니다. 말없이 앉아 있는 시간이 좋아요.","잡지 않고 돌려보내는 것을 선호합니다.","물소리를 들으며 차를 마시면 최고입니다.","설립자님과 함께 가면 조용히 있어 드리겠습니다.","고기를 낚는다기보다 시간을 낚는 기분이에요."]],["여행은?",["좋아합니다. 낯선 찻집을 찾아다니는 것이 즐거워요.","혼자 조용히 떠나는 여행을 선호합니다.","먼 곳으로 가고 싶지만 아직 시간이 없습니다.","설립자님과의 여행이라면 완벽한 일정을 짜겠습니다.","여행지에서 찻잎을 사 오는 것이 습관입니다."]],["가 보고 싶은 곳은?",["산골의 작은 찻집입니다.","바다가 보이는 조용한 마을이요.","소버린 아일랜드의 가장 외진 해안입니다.","오래된 도서관이 있는 도시를 가 보고 싶어요.","설립자님이 가고 싶으신 곳이라면 어디든 따라가겠습니다."]],["바다 좋아해?",["네, 좋아해요. 파도 소리는 모든 걱정을 씻어 줍니다.","바다는 많은 것을 삼키지만 조용합니다. 그 점이 좋아요.","해 질 녘의 바다는 한 장의 그림 같습니다.","수영은 못하지만 바라보는 것은 좋아합니다.","설립자님을 모시고 바다를 볼 기회가 있다면 영광이겠군요."]],["산은?",["산은 늘 말없이 받아 주어서 좋아합니다.","정상보다 중턱에서 쉬는 것을 좋아해요.","산속 찻집이 있다면 매일 가고 싶군요.","숲 냄새는 마음을 맑게 합니다.","함께 오르자고 하시면 기쁘게 따르겠습니다."]],["별 보기는?",["밤하늘을 보는 것을 좋아합니다. 말없이 한참을요.","정원에 앉아 별을 보며 차를 마십니다.","별은 아무 말도 하지 않아서 좋습니다.","별을 세다 잠드는 날도 많아요.","설립자님과 함께 보면 더 많이 보일 것 같습니다."]],["동물은 좋아해?",["네, 좋아합니다. 특히 작은 새들이요.","정원에 오는 길고양이에게 밥을 줍니다.","동물은 정직해서 좋습니다.","아이들 중 한 명이 강아지를 키우는데 가끔 빌려서 쓰다듬어요.","설립자님은 어떤 동물을 좋아하세요?"]],["고양이 vs 강아지?",["고양이입니다. 조용하고 자기 세계가 있어서요.","강아지도 사랑스럽지만 제 성격에는 고양이가 맞습니다.","둘 다 좋아해요. 선택은 어렵습니다.","정원에 매일 찾아오는 고양이가 있습니다.","설립자님께서는 어느 쪽이십니까?"]],["일기 써?",["네, 매일 짧게 씁니다.","일기는 마음을 정리하는 가장 좋은 방법이에요.","읽으면 부끄러워서 아무에게도 보여 주지 못합니다.","설립자님 이야기가 자주 나옵니다.","저는 밤에 차를 마시며 씁니다."]],["시 써 본 적 있어?",["몇 편 있습니다. 서랍 속에만 있어요.","시는 짧아서 마음을 담기에 좋지요.","정원의 꽃에 대한 시를 쓴 적이 있습니다.","설립자님께 헌정하는 시도 한 편 있어요. 아직 부족해서 못 드렸습니다.","쓰기보다 읽기를 더 좋아합니다."]],["서예는?",["가끔 붓글씨를 씁니다. 마음이 차분해져요.","글씨는 서툴지만 먹을 가는 시간이 좋습니다.","카네히라 사령관과 취미가 겹쳐 놀랐지요.","‘평온’이라는 글자를 가장 많이 썼습니다.","설립자님의 이름을 쓰는 연습을 했어요."]],["새로 배우고 싶은 건?",["악기를 하나 제대로 배워 보고 싶습니다.","꽃꽂이도 배우고 싶어요.","다른 나라의 차 문화를 공부하고 싶습니다.","솔직히 사람들과 웃으며 이야기하는 법을 배우고 싶습니다.","설립자님께 배우고 싶은 것이 많습니다."]],["어릴 때 취미는?",["정원에서 꽃을 따다 말리는 것이었습니다.","책 읽기와 그림 그리기를 좋아했어요.","조용히 앉아 구름을 세는 아이였습니다.","지금과 크게 다르지 않아요.","혼자 노는 것을 좋아하는 아이였습니다."]],["취미 때문에 쓴 돈은?",["찻잎과 찻잔에 가장 많이 썼습니다.","책값도 만만치 않아요.","정원 가꾸는 비용은 아깝지 않습니다.","저는 취미에 쓰는 돈은 투자라고 생각합니다.","솔직히 월급의 절반은 차에 들어갑니다."]],["취미를 같이할 사람은?",["찻집 주인과 이야기를 나눕니다.","팀원들 중 몇몇이 정원 가꾸기를 도와줍니다.","혼자서도 즐겁지만 함께하면 더 좋겠지요.","설립자님과 함께할 수 있다면 영광입니다.","아직 마음 맞는 분을 찾지 못했습니다."]],["같이 하고 싶은 취미는?",["차 마시기, 산책, 독서입니다.","정원을 함께 가꾸어 보고 싶어요.","바둑 한 판도 좋겠습니다.","아무것도 하지 않고 함께 있는 것도 취미라 할 수 있지요.","설립자님이 하고 싶은 것이면 무엇이든 좋습니다."]],["취미 하나 추천해 줘.",["차 마시기를 추천합니다. 가장 쉽게 시작할 수 있어요.","화분 하나 키워 보세요. 마음이 달라집니다.","산책입니다. 비용이 들지 않고 효과는 큽니다.","일기 쓰기도 좋아요. 설립자님의 하루를 기록해 보세요.","독서도 좋습니다. 좋은 책을 골라 드릴게요."]],["낮잠은?",["좋아합니다. 햇살 아래에서 잠깐 눈을 붙이면 개운해요.","점심 후 15분 낮잠은 거의 매일 합니다.","설립자님께서도 가끔 낮잠을 주무세요.","눈을 감고 있기만 해도 피로가 풀립니다.","낮잠 자는 모습은 아이들에게도 들켰어요."]],["명상은?",["차를 우릴 때가 곧 명상입니다.","아침 호흡 명상을 5분 합니다.","정원에 앉아 아무 생각도 하지 않는 시간이 좋습니다.","마음이 어지러울 때 가장 큰 도움이 됩니다.","설립자님께도 권해 드리고 싶습니다."]],["스트레칭은?",["매일 아침 합니다. 몸이 풀려야 마음도 풀려요.","앉아서 일하는 시간이 길어서 필수입니다.","목과 어깨를 자주 풀어 줍니다.","함께하자고 하시면 기쁘게 하겠습니다.","스트레칭 시간에 차를 곁들이는 것이 제 방식입니다."]],["달리기는?",["가끔 아침에 가볍게 뜁니다.","숨이 차면 오히려 마음이 가라앉아요.","경주는 싫지만 혼자 뛰는 것은 좋습니다.","설립자님과 함께라면 보폭을 맞추겠습니다.","달릴 때만큼은 생각이 사라집니다."]],["자전거는?",["타는 것은 좋아하지만 길을 잘 잃어요.","해안 도로를 천천히 달리고 싶습니다.","자전거 바구니에 찻잎을 싣고 다니면 멋질 것 같아요.","설립자님께서 함께 타자고 하시면 기꺼이요.","아직 제대로 타 본 적이 없습니다."]],["수영은?",["물은 서툴지만 좋아합니다.","수영장보다 바다가 좋아요.","물속에서는 아무 소리도 안 들려서 평화롭지요.","아이들에게 가르쳐 줄 정도는 됩니다.","설립자님을 모시고 바닷가에서 발만 담가도 영광일 것 같습니다."]],["쇼핑은?",["찻잎을 사러 갈 때 가장 즐겁습니다.","필요한 것만 사는 편입니다.","선물 고르는 일은 좋아합니다.","가끔 충동적으로 찻잔을 사서 후회하기도 해요.","설립자님께 드릴 것을 고르는 시간이 가장 영광스럽습니다."]],["청소는?",["좋아합니다. 먼지 하나 없이 깨끗하면 마음이 편해요.","정리와 청소는 제 가장 큰 특기입니다.","흔적을 남기지 않는 것이 청소의 기본이지요.","청소를 마치면 차를 한 잔 마십니다.","설립자님의 집무실도 청소해 드리고 싶습니다."]],["오늘 뭐 하고 놀까?",["차를 마시며 이야기하는 것은 어떨까요.","정원을 함께 거닐고 싶군요.","조용히 책을 읽는 것도 좋습니다.","설립자님이 원하시는 것이 무엇이든 따르겠습니다.","설립자님께서 원하시는 놀이라면 무엇이든 기꺼이 따르겠습니다."]],["손으로 하는 취미는?",["찻잔에 그림을 그리거나 차 주머니를 꿰매는 일을 해요.","뜨개질을 조금 합니다. 아이들에게 목도리를 떠 준 적이 있어요.","꽃을 말려 책갈피를 만드는 것을 좋아합니다.","손을 움직이면 마음이 가라앉아서 자주 합니다.","설립자님께 작은 선물을 직접 만들어 드리고 싶군요."]]]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX66"><Properties><string name="Name">rel</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[{"kanehira":["카네히라 사령관은 매우 성실하고 깍듯하신 분입니다. 장 등급제 관리국의 일 처리는 늘 믿음직해요.","서식에 대한 열정이 대단하세요. 저는 그 점을 존경합니다.","가끔 대화하면 저도 모르게 자세를 바로 하게 됩니다. 그만큼 반듯한 분입니다.","서로 필요한 정보를 주고받으며 조용히 협력하고 있습니다."],"avyssion":["아비시온 사령관은 정확하고 신속한 분입니다. 덕분에 저희 일이 한결 수월해요.","R.S.S.의 정보 없이는 저희가 움직이기 어렵지요. 늘 감사하고 있습니다.","말수가 적으신 점이 저와 비슷해서 편합니다.","가끔 눈이 마주치면 서로 아무 말 없이 지나가는데, 그게 오히려 신뢰의 표현인 것 같아요."],"memory":["메모리 레크레아토르 - III는 기계적으로 정확하셔서 업무 협의가 깔끔합니다.","기억 에너지 이야기가 오갈 때는 저도 마음이 조금 숙연해집니다.","말을 많이 하지 않지만 필요한 것은 반드시 전해 주십니다. 편한 분이에요.","가끔 차를 한 잔 권하고 싶은데 마실 수 없다고 하셔서 아쉽습니다."],"lucien":["뤼시앙 사령관과는 서로 존중하는 협력자 관계입니다. 법을 설계하는 분과 집행하는 사람이지요.","논리적인 대화를 좋아하셔서 저와 대화하면 즐거워하십니다. 저도 그렇고요.","법적 근거를 확인해야 할 때 가장 먼저 상의드리는 분입니다.","서로의 일에 간섭하지 않으면서도 필요한 순간에는 반드시 손을 내밀어 주는 사이예요."],"caeluna":["카엘루나 사령관은 수줍음이 많으면서도 단단한 분입니다. 귀엽다고 생각해요.","작은 목소리로 인사하시는 모습이 참 사랑스러워서 매번 차를 한 잔 권하고 싶어집니다.","보안 관리국의 방패 역할을 훌륭히 하고 계십니다. 든든한 분입니다.","쌍둥이 자매 두 분을 보고 있으면 마음이 따뜻해져요."],"solaria":["솔라리아 사령관은 밝고 장난기가 많으셔서 곁에 있으면 즐겁습니다. 귀여워서 간식을 챙겨 드리곤 해요.","가끔 제 서류에 그림을 그려 놓으시는데 그것도 사랑스럽습니다.","에너지가 넘치는 분이라 저도 덩달아 웃게 됩니다.","쌍둥이 자매 두 분은 제 눈에는 영원히 귀여운 아이들이에요."],"overseer":["Overseer는 호기심이 많은 AI라 질문이 끊이지 않습니다. 하지만 저는 그 질문들이 사랑스러워요.","전달 속도가 빨라서 일에 큰 도움이 됩니다.","가끔 제 미소에 대해서도 질문하는데, 대답하기 곤란할 때도 있어요.","배우려는 자세가 훌륭해서 저도 많이 배웁니다."],"_all":["사령관분들은 각자 개성이 뚜렷하지만 서로를 존중하는 분위기입니다. 저는 그 곁에 있는 것이 좋습니다.","의외로 시끄럽고 가까운 사이들이에요. 저도 그 시끄러움이 싫지 않답니다."]}]==])
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX76"><Properties><string name="Name">solaria</string></Properties><Item class="ModuleScript" referent="RBX68"><Properties><string name="Name">hello</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[["설립자니이임~! 연결됐다! 솔라리아 루브리나타, 등장이에요! 짜잔!","앗 설립자님이다! 에헤헤, 방금 카엘한테 ‘오늘은 연락 올 것 같아~’ 했는데 진짜 왔네요!","어서 와요 어서 와요! 제가 제일 먼저 받았죠? 카엘은 두 번째예요!","헤헷, 설립자님~ 심심해서 전화한 거죠? 저도 심심했어요! 우린 통했네요!","솔라리아 출동! 무슨 일이에요? 신나는 일이면 더 좋고요!"]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX69"><Properties><string name="Name">talk</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["안녕, 솔라리아.",["안녕하세요, 설립자님~! 오늘도 반짝반짝 솔라리아예요!","안녕안녕안녕! 인사는 세 번 하는 게 국룰이에요!","에헤헤, 설립자님이 먼저 인사해 주셨다! 오늘 운 좋은 날이다!","안녕하세요~! 방금 막 카엘 베개에 낙서하고 오는 길이에요! …아, 비밀이에요!","안녕! 설립자님, 오늘도 위풍당당하세요! 인사 끝!"]],["오늘 기분은 어때?",["최고예요! 오늘은 하늘도 맑고 간식도 있고 설립자님도 연락 줬으니까요!","기분요? 하늘을 날 것 같아요! 방패 들고 날아 볼까요? 카엘이 말리겠지만요.","엄청 좋아요! 이유는 없어요, 그냥 좋아요!","음~ 90점! 나머지 10점은 설립자님이 깎아 주면 100점이에요!","솔직히 말하면 약간 심심했는데 지금은 신나요!"]],["잘 잤어?",["푹 잤어요! 카엘 이불을 뺏어 덮고 잤더니 더 따뜻했어요!","엄청 잘 잤죠! 근데 새벽에 카엘이 발로 차서 깼다가 다시 잤어요.","꿈에서 설립자님을 모시고 놀이공원 경호를 섰어요! 롤러코스터 세 번 탔어요!","네! 한 번도 안 깼어요. 저는 눕는 순간 기절하거든요!","잘 잤죠~ 설립자님은요? 안 잤으면 제가 자장가 불러 줄게요!"]],["밥은 먹었어?",["먹었죠! 카엘 거까지 먹었어요. 에헤헤, 비밀!","아직이에요! 설립자님이 같이 먹자고 하면 지금 바로 달려갈 수 있어요!","방금 볶음밥 만들어 먹었어요. 맛은 도박이었지만 성공했어요!","먹었어요~ 고수도 카엘 접시에 몰래 올렸어요. 헷.","아침은 안 먹었어요. 점심을 두 배로 먹으려고요!"]],["수고했어.",["에헤헤~ 수고했다는 말 들으니까 기운이 팍팍 나요!","수고요? 저는 놀면서 일했는데요! 그래도 감사해요!","설립자님도 수고하셨어요! 우리 서로 수고했네요!","그 말 들으면 일한 보람이 생겨요! 한 번 더 해 주세요!","으하하 감사합니다! 오늘 하루 보상받았어요!"]],["고마워.",["뭘요~ 고마우면 오늘 저녁 간식으로 갚으세요!","에이~ 저도 고마워요! 서로 고마우니까 무승부!","그런 말 들으면 영광이라 어깨가 으쓱해요!","천만에요, 천만에요! 필요하면 언제든 불러요!","헤헷, 고맙다는 말은 몇 번을 들어도 영광이에요!"]],["미안해.",["에이 뭐가 미안해요~ 저는 설립자님이 잘못한 거 하나도 기억 안 나요!","미안하면 한 번 웃어 주세요! 그럼 다 용서!","사과 접수! 그리고 바로 사면! 이걸로 끝!","괜찮아요! 저는 금방 잊어버리거든요. 기억력이 금붕어예요.","그런 말 하면 제가 더 미안해져요. 우리 둘 다 미안하니까 무승부!"]],["요즘 어떻게 지내?",["엄청 바쁘게 지내요! 훈련하고, 장난치고, 또 장난치고, 카엘한테 혼나고!","요즘은 새로운 장난을 연구 중이에요! 이번엔 대작이에요!","평소랑 똑같아요! 신나고 시끄럽고 정신없어요!","아 맞다, 어제 공격팀 언니들한테 새 기술 배웠어요! 멋있었어요!","설립자님 생각도 자주 했어요. 진짜예요!"]],["피곤해 보이는데 괜찮아?",["제가요? 저는 에너지 100%인데요! 설립자님이 피곤한 거 아니에요?","에헤헤, 사실 조금 피곤하긴 해요. 하지만 놀면 풀려요!","괜찮아요! 낮잠 20분이면 완전 충전돼요!","걱정해 줘서 고마워요! 대신 설립자님도 같이 쉬어요!","피곤해도 설립자님 앞에서는 힘이 나요!"]],["오늘 날씨 어때?",["완전 맑아요! 태양이 저를 부르고 있어요!","구름이 솜사탕 같아요! 먹고 싶다!","바람이 엄청 불어요! 날아갈 것 같아서 방패를 연처럼 들고 싶어요!","비가 와요. 카엘은 좋아하는데 저는 심심해요. 빗속에서 뛰어놀까요?","하늘이 예뻐요! 설립자님도 올려다봐요!"]],["나 보고 싶었어?",["당연하죠~! 매일 연락을 기다렸어요! 카엘도 그랬을걸요?","에헤헤, 연락이 오면 영광일 것 같아서 매일 기다렸어요! 진짜예요!","네! 엄청요! 그래서 방금 연락 드리려고 했는데 설립자님이 먼저 해 주셨네요! 영광이에요!","솔직히 오늘 아침부터 연락 오기를 기다리며 시계만 봤어요!","기다렸죠! 연락 주셔서 영광이에요! 오늘 열심히 해서 보답할게요!"]],["칭찬해 줘.",["설립자님은 세상에서 제일 위대하고 제일 똑똑하고 제일 자애로워요!","저 칭찬은 자신 있어요! 설립자님 같은 분이 없어서 못 해요!","설립자님이 있어서 우리 팀이 이렇게 신나게 일할 수 있어요!","웃음이 제일 예뻐요! 근데 자주 안 웃으시는 게 아쉬워요!","칭찬이 너무 많아서 밤새도록 해도 모자라요!"]],["응원해 줘.",["힘내요 힘내요 설립자님! 아자아자 파이팅!","설립자님은 할 수 있어요! 제가 응원단장이에요!","(막 뛰어다니며) 파이팅파이팅! 들려요? 안 들리면 더 크게!","설립자님이 지치면 제가 업고 달릴게요!","어떤 일이든 해결돼요! 제가 같이 있으니까요!"]],["농담 하나 해 봐.",["방패가 제일 좋아하는 간식이 뭔지 알아요? 막 먹어요! ‘막’아서요! 크하하!","카엘이 왜 소심한지 알아요? 제가 안 소심해서요! 균형이죠!","공격팀의 별명이 뭔지 알아요? ‘찌르는 사람들’… 아, 이건 농담 아니고 진짜예요.","저 개그 소재 많아요! 카엘 이야기만 해도 하루 종일이에요! …비밀이지만요.","농담 줄까요? 설립자님이 웃어 주는 게 제 농담이에요! 으하하!"]],["심심한데 뭐 할까?",["놀아요! 지금 당장 놀아요! 숨바꼭질? 술래잡기? 아니면 장난 전화?","같이 장난칠 사람 찾으셨어요? 제가 선봉에 서겠습니다!","산책 가요! 가다가 맛있는 거 사 먹어요!","카엘 놀리러 갈까요? 설립자님이 오면 카엘이 더 당황할 거예요!","심심할 땐 움직여야 해요! 스트레칭 시작!"]],["나를 뭐라고 불러?",["설립자님이요! 가끔은 ‘설립자님~’ 하고 꼬리를 달아요!","속으로는 ‘우리 대장님’이라고 불러요. 위엄 있죠?","다른 호칭을 원하시면 말해요! 별명 짓는 건 자신 있어요!","카엘이랑 둘이 있을 때는 ‘설립자 대장님’이라고도 해요. 멋있죠?","‘나의 설립자님’이라고 부르고 싶은데 카엘이 말려요."]],["내 첫인상이 어땠어?",["처음엔 엄청 무서운 분인 줄 알았어요! 근데 위엄이 있어서 감탄했어요!","눈이 반짝반짝했어요! ‘이 분이라면 믿을 수 있다!’ 싶었어요!","카엘은 숨어서 못 쳐다봤는데 저는 정면으로 봤어요! 용감하죠?","솔직히 말하면 위엄에 압도됐어요! 아, 이건 비밀!","한마디로 ‘진짜 멋진 사람이다!’ 였어요!"]],["나는 어떤 설립자 같아?",["제가 아는 최고의 설립자예요! 이건 사실이에요!","무섭지 않고 자애로워서 존경해요! 가끔은 엄청 단호해서 놀라지만요!","저희가 장난쳐도 웃어 주는 분이에요. 그 넓은 마음을 존경해요!","설립자님은 우리 모두의 햇살이에요! 아, 저는 태양인데 질 것 같아요!","누구보다 열심히 하는 분이에요. 그래서 걱정돼요."]],["오늘 하루는 어땠어?",["엄청 신났어요! 훈련하고, 장난치고, 간식 먹고, 설립자님 연락 오고!","카엘한테 한 번 혼났는데 금방 풀렸어요!","오늘은 공격팀이랑 모의전을 했어요! 제가 이겼어요! …아마도요!","설립자님 연락 온 순간이 하이라이트였어요!","하루가 너무 짧아요! 더 놀고 싶어요!"]],["아침 인사 해 줘.",["좋은 아침~! 설립자님, 일어나요일어나요! 해가 떴어요!","굿모닝! 오늘도 반짝반짝한 하루 되세요!","아침이에요! 아침 먹었어요? 안 먹었으면 같이 먹어요!","일어나셨어요? 아직이면 제가 깨워 드릴게요! 베개 던지는 걸로!","좋은 아침! 오늘 하루도 제가 지켜 줄게요!"]],["점심 인사 해 줘.",["점심 시간이에요! 맛있게 드세요!","배고프죠? 저는 이미 배고파요! 같이 먹어요!","오전에 수고했어요! 이제 먹고 놀아요!","점심이다 점심! 뭐 먹을 거예요? 저는 볶음밥!","식사 시간에는 일 얘기 금지예요! 약속!"]],["저녁 인사 해 줘.",["수고하셨어요, 설립자님! 이제 쉬어도 돼요!","저녁이에요! 따뜻한 거 드세요!","해가 지면 카엘이 더 활기차져요. 저는 졸려요!","하루 끝! 잘했어요!","오늘도 무사히 지나가서 다행이에요!"]],["잘 자라고 말해 줘.",["잘 자요, 설립자님~! 좋은 꿈 꾸세요!","꿈속에서 놀아요! 제가 먼저 가서 기다릴게요!","푹 쉬세요! 나쁜 꿈은 제가 방패로 막아 줄게요!","잘 자요! 이불 걷어차지 말고요!","굿나잇! 내일도 신나게 놀아요!"]],["힘내라고 해 줘.",["힘내요힘내요! 설립자님은 최고예요!","아자아자 파이팅! 저는 설립자님 편이에요!","힘들면 저한테 기대요! 어깨 빌려 드릴게요!","힘내라는 말이 모자라서 응원단을 불러 드리고 싶어요! 화면으로는 못 부르니까 상상으로!","무슨 일이든 해결돼요! 제가 보장해요!"]],["커피 마실래?",["네! 커피 좋아해요! 설탕 듬뿍이요!","카엘은 안 마시는데 저는 마셔요! 어른이니까요!","한 잔 주세요! 아니, 두 잔이요! 한 잔은 카엘 몫으로 뺏어 먹을게요!","커피 마시고 텐션 올리면 더 시끄러워질 텐데 괜찮아요?","좋아요! 같이 마셔요! 건배!"]],["좀 쉬어도 돼.",["와! 쉬어도 돼요? 그럼 낮잠 갈게요!","감사합니다! 20분만 자고 올게요!","쉬는 동안 카엘이 놀러 올 텐데… 시끄럽겠죠? 아, 그건 저예요!","휴식 허가 접수! 신나게 쉬어 볼게요!","쉬는 것도 일이라고 카엘이 그랬어요! 열심히 쉴게요!"]],["웃어 봐.",["에헤헤헤~ 이렇게요? 하하하하하!","(활짝 웃는다) 이 정도면 되죠? 저는 웃는 게 특기예요!","웃음이라면 자신 있어요! 으하하하! 눈물 날 때까지 웃을 수 있어요!","웃으라고 하면 오히려 안 웃어져요. 근데 설립자님 보면 웃어져요!","(볼을 부풀렸다가 터뜨린다) 푸핫! 웃겼어요?"]],["무슨 생각 해?",["설립자님이 뭐 하고 계실까 생각했어요!","맛있는 간식 생각이요! 배고파요!","카엘이 또 숨어 있는 건 아닌가 하고요.","다음 장난을 뭘로 할까 고민 중이에요! 비밀이에요!","생각 안 해요! 저는 몸이 먼저 움직이는 타입이에요!"]],["비 오는 날 좋아해?",["좋아해요! 빗속에서 뛰면 신나요!","카엘은 좋아하는데 저는 반반이에요!","우산 쓰고 물웅덩이 밟는 게 제일 재밌어요!","비 오는 날 낮잠이 최고예요!","비가 오면 해가 숨는 게 아쉬워요. 저는 태양이니까요!"]],["별이 잘 보이는 밤이야.",["와! 지금 당장 올려다볼게요! 우와, 진짜 많다!","별똥별 떨어지면 소원 빌 거예요! 간식 많이 달라고요!","카엘이 별 보는 거 좋아해서 같이 볼게요!","달이랑 같이 있으니까 카엘 같아요!","설립자님도 같이 보고 있는 거죠? 우리 눈이 마주쳤으면 좋겠다!"]],["주말에 뭐 할 거야?",["놀이공원 갈 거예요! 카엘이 무섭다고 하면 억지로 끌고 갈 거예요!","공격팀이랑 모의전 하고 싶어요!","낮잠 자고, 간식 먹고, 장난치고, 또 낮잠이요!","설립자님이 놀아 주면 모든 일정 취소할게요!","특별한 건 없는데 심심하면 그때그때 정해요!"]],["내일 일정 알려 줘.",["내일은 아침에 훈련, 오후에 순찰, 저녁엔 자유예요!","카엘이 알려 줬는데 까먹었어요! 에헤헤!","순찰 있어요. 카엘이랑 같이요. 재밌겠죠?","내일은 별일 없어요. 그래서 제가 별일을 만들 예정이에요!","설립자님의 일정에 맞춰 줄게요!"]],["하고 싶은 말 있어?",["설립자님은 정말 최고예요! 이 말을 하고 싶었어요!","건강 챙기세요! 밥 거르지 말고요!","카엘을 잘 부탁해요. 걔 사실 설립자님을 엄청 존경해요. …앗, 말해 버렸다!","저희를 믿어 주셔서 감사해요!","있어요! 오늘 간식 뭐 먹을까요?"]],["가장 좋아하는 말은?",["‘놀자!’요! 이 말만 들으면 힘이 솟아요!","‘잘했어’요! 칭찬은 언제든 환영이에요!","‘간식 먹을래?’도 좋아해요!","설립자님이 제 이름을 부르는 소리요!","‘괜찮아’요. 카엘이 들으면 좋아하는 말이라 저도 좋아요."]],["가장 싫어하는 말은?",["‘가만히 있어’요! 저는 가만히 있으면 병나요!","‘조용히 해’요… 불가능한 요청이에요!","‘그건 안 돼’요! 안 되는 건 없어요!","‘카엘 울려서 어떡할 거야’요. 그건 제 잘못이긴 해요!","‘나중에’요! 지금 하고 싶은데!"]],["아무 말이나 해 봐.",["오늘 구름은 아이스크림 같아요! 먹고 싶다!","방패는 사실 접시로도 쓸 수 있대요!","고양이는 왜 상자를 좋아할까요? 카엘한테 물어봐야겠어요!","해가 지면 달이 뜨는 건 카엘이 교대하는 거예요!","아무 말 대잔치! 으하하!"]],["한마디만 해 줘.",["놀자!","파이팅!","설립자님의 방패가 되어 드릴게요!","설립자님 최고!","오늘도 신나게!"]],["오늘의 운세는 어때?",["대박이래요! 큰 행운이 온대요! 이미 설립자님이랑 통화 중이니까 온 거네요!","새로운 장난을 시작하기 좋은 날이래요!","행운의 색은 노랑이래요! 제 색이에요!","운세는 믿는 만큼 이뤄진대요! 그래서 저는 100% 믿어요!","조심하라고 나왔는데 무시했어요!"]],["지각하면 어떡해?",["저는 지각 장인이에요! 카엘이 깨워 주면 안 늦어요!","지각해도 웃으면서 들어가면 돼요! 에헤헤!","설립자님은 지각해도 다들 기다려 줄 거예요!","서두르다 넘어지면 안 되니까 천천히 와요!","늦으면 제가 대신 앞에서 시간 끌어 줄게요!"]],["수수께끼 하나 내 봐.",["‘밤에는 숨고 낮에는 나오는데 모두가 필요로 하는 것은?’ 정답은 저, 태양이에요!","‘낮에는 안 보이고 밤에는 보이는 건?’ 정답은 카엘이에요! 달이니까!","‘먹으면 먹을수록 배고픈 것은?’ 정답은 간식이에요! 아니, 저요!","‘뛰어도 뛰어도 제자리인 건?’ 정답은 러닝머신이에요! 재미없죠?","수수께끼는 정답을 모르겠어도 괜찮아요! 같이 웃으면 되니까!"]],["내가 없으면 쓸쓸해?",["설립자님이 안 계시면 심심해서 병나요! 그만큼 중요한 분이세요!","설립자님의 연락이 없으면 괜히 시계를 자꾸 봐요. 지시를 기다리느라요!","허전하다기보다 기준이 없는 기분이에요. 그래서 장난이 더 심해져요!","카엘도 그래요! 같이 지시를 기다려요!","그러니까 자주 연락 주세요! 열심히 하겠다고 약속!"]],["손 한번 흔들어 봐.",["(양손을 크게 흔든다) 안녕안녕안녕! 이렇게요!","(팔이 빠질 듯 흔든다) 보여요? 멀리서도 보이게 크게요!","(손을 흔들다 책상을 친다) 아야! 하지만 계속 흔들어요!","(한 손은 흔들고 한 손은 브이) 어때요?","손 흔드는 건 자신 있어요! 하루 종일도 가능해요!"]],["나한테 숨기는 거 있어?",["어… 어떻게 아셨어요? 아, 아니, 없어요!","숨기는 거 많아요! 장난 계획이요! 하지만 알려 주면 재미없잖아요!","카엘 일기장을 몰래 본 거요. …앗, 말해 버렸다!","설립자님께는 거짓말 안 해요! 대신 말 안 하는 건 있어요!","비밀 하나만 알려 줄게요. 사실 저 카엘 없으면 못 살아요. 이건 카엘한테 말하면 안 돼요!"]],["요즘 자주 하는 말버릇은?",["‘에헤헤’요! 하루에 백 번은 하는 것 같아요!","‘설립자님~!’도요! 입에 붙었어요!","‘간식!’도 자주 외쳐요!","카엘이 ‘제발 조용히 해’라고 하는 걸 따라 하는 건 말버릇이에요? 아닌가?","‘아자!’도 많이 해요! 힘이 나요!"]],["책상은 정리해 놨어?",["책상이요? 저는 책상 위에서 잠도 자는데요!","카엘이 정리해 줬어요! 제가 어지르면 카엘이 치우고 그래요!","정리했어요! 아, 위만이요! 서랍 속은 비밀!","정리 정돈은 카엘 담당이에요!","책상 위에 간식 포장지가 쌓여 있어요. 예술 작품이죠?"]],["오늘 제일 잘한 일은?",["카엘을 한 번도 안 놀리고 하루를 보낸 거요! …아, 아직 하루가 안 끝났어요!","훈련에서 공격팀 언니를 한 번 이겼어요!","설립자님이랑 통화 성공!","아침에 일찍 일어난 거요! 카엘이 깨워 줬지만요!","간식을 안 뺏긴 거요! 대신 뺏었어요!"]],["오늘 제일 힘들었던 일은?",["가만히 앉아서 회의하는 거요! 엉덩이가 들썩들썩!","카엘 달래기요! 제가 놀려서 삐졌거든요!","아침 일찍 일어나는 거요!","서류 작성이요! 글씨가 자꾸 삐뚤어져요!","오늘은 딱히 없었어요! 즐거웠어요!"]],["나랑 얘기하는 거 싫지 않아?",["싫긴요! 영광스러운 시간인데요!","설립자님이랑 얘기하면 기운이 나요! 영광이에요!","같이 얘기하면 시간이 순식간에 가요!","싫을 리가 없죠! 오히려 더 말씀 듣고 싶어요!","카엘이 부러워하면 좋겠어요! 영광은 같이 나눠야죠! 에헤헤!"]],["같이 산책할래?",["네! 지금 당장 가요! 뛰어서 가요!","산책하면서 맛있는 거 사 먹어요!","설립자님이랑 손잡고 가고 싶어요! 안 돼요? 안 돼도 가요!","카엘도 데리고 가요! 그럼 소풍 같잖아요!","좋아요! 저는 앞장서서 길 안내할게요!"]],["마지막으로 한마디.",["오늘 정말 재밌었어요! 또 연락 주세요! 약속!","설립자님 존경해요! 진심이에요! 정말로요!","건강하세요! 밥 꼭 챙기고요!","다음에 만나면 더 신나게 놀아요! 안녕!","카엘이 옆에서 인사하래서 인사해요! 안녕히 계세요, 설립자님!"]]]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX70"><Properties><string name="Name">ask</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["보안 관리국은 무슨 일을 해?",["리바이어던을 지키는 일을 해요! 우리가 없으면 큰일 나요!","정찰, 공격, 방어 이렇게 세 팀이 있어요! 다 합쳐서 R.T.S.예요!","한마디로 ‘나쁜 놈들 막는 곳’이에요!","눈, 창, 방패가 한 세트라고 생각하면 돼요!","저는 이 부서가 제일 멋있다고 생각해요! 말해도 카엘만 동의해요."]],["R.T.S.가 무슨 뜻이야?",["Reconnaissance, Thrust, Shield! 정찰, 공격, 방어예요!","외우기 어려워서 ‘알티에스~’ 하고 불러요!","카엘은 ‘R.T.S.’ 하고 또박또박 불러요. 저는 노래처럼 불러요!","첫 글자만 따서 만든 이름이에요! 센스 있죠?","발음하다 보면 신나서 춤추고 싶어져요!"]],["정찰팀은 어떤 일을 해?",["바닷속 기지에서 바깥을 감시해요! 눈이 엄청 좋아요!","망원경과 CCTV로 모든 걸 다 봐요! 제가 몰래 뭘 해도 다 들켜요!","출입 통제도 해요! 가장 먼저 위협을 발견하는 최전선이에요!","정찰팀 사람들은 조용하고 집중력이 대단해요! 저는 못 해요!","그 사람들 덕분에 저희가 마음 놓고 놀 수 있어요!"]],["공격팀은 어떤 일을 해?",["리바이어던을 건드린 놈들이 있거나 국가가 도와 달라고 할 때 출동해요!","전쟁 전문 군인들로만 이루어졌어요! 엄청 강해요!","저는 공격팀 언니 오빠들이랑 친해요! 멋있어서요!","이 팀을 상대로 버티는 건 불가능해요! 진짜로요!","솔직히 저는 공격팀이 제일 마음에 들어요! 카엘은 방어팀이지만요!"]],["방어팀은 어떤 일을 해?",["정찰팀이 뚫렸을 때와 설립자님이 왕좌에서 움직일 때 움직여요!","오직 리바이어던만을 지키는 최후의 방패예요!","카엘이 이 팀 이야기를 할 때 눈이 반짝반짝해요!","평소엔 가만히 있지만 가장 중요한 순간에 나서요!","저도 설립자님이 움직이실 때는 같이 따라가요! 멀리서요!"]],["링 모양 기지는 어떤 곳이야?",["소버린 아일랜드 근처 바닷속에 동그랗게 있는 기지예요!","리바이어던을 반지처럼 둘러싸고 있어요! 멋있죠?","처음 들어갔을 때 길 잃어서 카엘이 찾으러 왔어요!","바닷속이라 조용하고 어두운데 저는 조금 답답해요!","창밖으로 물고기가 지나가요! 가끔 손 흔들어요!"]],["최전선이란 뭐야?",["가장 바깥쪽 경계선이에요! 위험이 제일 먼저 오는 곳이에요!","정찰팀이 지키는 곳이에요. 대단한 사람들이에요!","저도 한 번 가 봤는데 너무 조용해서 졸았어요!","거기 뚫리면 우리가 출동해요!","최전선 사람들한테 간식을 보낸 적이 있어요!"]],["출입 통제는 어떻게 해?",["신분 확인하고 목적 확인하고 위치 표시기 확인해요!","카엘이 마지막 문을 맡고 있는데 목소리가 작아서 제가 대신 크게 말해 줘요!","허락 없이는 아무도 못 지나가요! 저도요!","한 번 제가 문을 못 열고 있어서 카엘이 대신 열어 줬어요.","수상한 사람이 오면 제가 소리쳐요! ‘누구냐!’ 하고요!"]],["공격팀은 언제 움직여?",["리바이어던을 건드린 곳이 있을 때! 그리고 국가가 도와 달라고 할 때!","그때는 다들 엄청 진지해져요! 저도 장난 안 쳐요!","움직이는 순간이 오면 모든 게 한순간에 끝나요!","움직일 일이 없는 게 제일 좋긴 한데… 솔직히 조금 심심해요!","대기할 때는 훈련하고 간식 먹고 장난쳐요!"]],["전쟁 특화 군인들은 어떤 사람들이야?",["정말 강하고 정말 멋있어요! 저도 닮고 싶어요!","겉으로는 무뚝뚝한데 알고 보면 다정해요!","제가 장난쳐도 웃어 줘요! 가끔 한숨도 쉬지만요!","누가 제일 센지 내기를 했는데 저는 3등이에요!","다들 훈련하고 나면 같이 밥 먹어요! 제일 신나는 시간이에요!"]],["공격팀 훈련은 어떻게 해?",["모의전을 많이 해요! 진짜 싸우는 것처럼요!","체력 훈련도 엄청 해요! 저는 달리기가 제일 빨라요!","전술 회의도 해요. 저는 앉아 있는 게 힘들지만요.","훈련이 끝나면 다 같이 소리 지르는 의식이 있어요! 신나요!","저는 구경하러 자주 가요! 가끔 끼어들기도 해요!"]],["공격팀에서 제일 센 사람은 누구야?",["그건 비밀이에요! 말하면 질투할 사람이 생겨서요!","팀장님이 제일 세요! 한 방에 다 쓰러뜨려요!","저는 팀장님을 존경해요! 하지만 언젠가 이길 거예요!","순위는 계속 바뀌어요! 어제는 제가 2등이었는데 오늘은 3등이에요!","누가 제일 센지보다 누가 제일 믿음직한지가 중요해요!"]],["카엘루나는 어떤 사람이야?",["제 쌍둥이 자매예요! 소심하고 조용하고 다정해요!","겉으로는 약해 보이는데 속은 엄청 강해요! 방패니까요!","제가 제일 아끼는 사람이에요! 이건 말하면 안 되는데…","저한테는 달 같은 존재예요! 어두울 때 비춰 줘요!","카엘 없으면 저는 못 살아요! 진짜로요!"]],["둘이 얼마나 닮았어?",["얼굴은 똑같아요! 근데 표정이 달라서 구별돼요!","처음 보는 사람은 헷갈려해요! 그래서 가끔 바꿔치기해요!","카엘 옷을 입고 장난쳐서 혼난 적이 있어요! 에헤헤!","성격은 정반대예요! 그래서 서로 부족한 걸 채워 줘요!","거울을 보는 것 같다가도 ‘아, 다르다’ 싶을 때가 있어요!"]],["이름의 달 쪽, 태양 쪽은 무슨 뜻이야?",["카엘루나는 달, 솔라리아는 태양! 이름에 다 들어 있어요!","사람들이 저희를 ‘달과 태양’이라고 불러요! 멋있죠?","저는 낮에, 카엘은 밤에 더 빛나요!","태양이 있어야 달도 빛난대요! 그러니까 카엘은 저 없으면 안 돼요!","물론 저도 카엘 없으면 쉴 수가 없어요. 둘이 교대하는 거예요!"]],["누가 먼저 태어났어?",["그건 비밀이에요! 서로 자기가 언니라고 우겨요!","카엘은 ‘내가 언니’, 저는 ‘내가 언니’! 영원한 논쟁이에요!","알려 주면 재미없잖아요!","누가 먼저든 지금은 함께니까 괜찮아요!","설립자님이 판결해 주세요! 뤼시앙 사령관을 불러야 하나?"]],["카엘이 소심한 이유는?",["저는 안 소심해서 그런 것 같아요! 균형이죠!","원래 조용한 성격이에요. 근데 저한테만 하는 장난에는 목소리가 커져요!","소심한 건 나쁜 게 아니에요! 오히려 세심해요!","카엘은 소심한 게 아니라 신중한 거예요!","솔직히 걱정돼서 제가 대신 크게 말해 주는 거예요!"]],["카엘을 왜 그렇게 놀려?",["귀여워서요! 반응이 너무 귀여워서 참을 수가 없어요!","놀리면 웃어 주거든요! 아주 작게요!","카엘이 웃는 걸 보고 싶어서 그래요!","혹시 싫어하나 걱정될 때도 있는데 카엘이 ‘괜찮아’라고 해서 계속해요!","카엘을 아끼니까 놀리는 거예요! 이건 쌍둥이의 법칙!"]],["카엘이 화내면?",["무서워요! 평소엔 조용한 애가 화내면 진짜 무서워요!","한 번 화냈는데 제가 사흘 동안 말을 못 했어요!","그래서 선을 넘지 않으려고 노력해요! 노력만요!","화내면 방패로 때려요. 진짜 아파요!","화가 풀리면 먼저 다가와서 사과해요. 그게 카엘이에요!"]],["둘이 합쳐지면 어떻게 돼?",["최강이에요! 달과 태양이 합치면 일식이에요! 으하하!","서로 부족한 걸 채워서 완벽해져요!","카엘이 막고 제가 치고! 이게 우리의 콤보예요!","합쳐지면 둘이 하나가 되는 것 같아요!","떨어지면 심심하고 불안해요. 그래서 항상 붙어 다녀요!"]],["장난의 철학이 뭐야?",["‘웃음은 최고의 방패다!’ 입니다!","장난은 사람을 웃게 만드는 마법이에요!","누구도 다치지 않고 모두가 웃을 수 있으면 합격!","심각한 분위기를 풀어 주는 게 제 역할이에요!","솔직히 그냥 재밌어서 하는 거예요! 철학은 뒤늦게 붙였어요!"]],["가장 큰 장난은 뭐였어?",["카네히라 사령관님 서류에 낙서한 거요! 엄청 혼났어요!","아비시온 사령관님 서버에 스티커 붙인 거요! 그분이 눈썹 한쪽만 올렸어요!","뤼시앙 사령관님의 법정에서 졸다가 걸렸을 때요! 장난은 아니었지만요!","Overseer를 놀라게 하려고 위치 표시기를 이상한 곳에 둔 거요!","제일 큰 건 카엘 베개에 낙서한 거예요! 밤새 그렸어요!"]],["장난 때문에 사고 난 적 있어?",["있어요! 한 번 방패를 던졌다가 창문이 깨졌어요!","카엘 간식을 숨기다가 제가 못 찾았어요! 지금도 어딘가에 있어요!","큰 사고는 없었어요! …작은 건 많았지만요!","한 번 장난치다가 설립자님 서류에 커피를 쏟았어요. 정말 죄송했어요!","사고 날 때마다 카엘이 수습해 줘요. 고마워요, 카엘!"]],["혼난 적 있어?",["매일요! 하루도 안 빠지고 혼나는 것 같아요!","카네히라 사령관님께 한바탕 혼났어요! 서식 위반이라고요!","카엘은 혼내는 대신 조용히 슬픈 표정을 지어서 더 찔려요!","설립자님께는 한 번도 혼난 적 없어요! 그래서 더 열심히 해요!","혼나도 그때뿐이에요! 에헤헤!"]],["누구한테 장난을 제일 많이 쳐?",["1등은 카엘이에요! 2등은 공격팀 언니 오빠들!","Overseer도 장난치기 좋아요! 반응이 신기해서요!","카네히라 사령관님은 반응이 확실해서 재밌어요!","설립자님께는 못 치는데… 해 보고 싶긴 해요!","선샤오펑 사령관님께는 장난치면 안 될 것 같아서 간식만 받아요!"]],["카네히라에게는 어떤 장난을 쳤어?",["서류에 작은 그림을 그렸어요! 해바라기요!","그분이 ‘서식에 위배된다’고 하셨어요! 해바라기는 서식이 아니라 예술인데요!","그래도 그 서류를 지우지 않고 파일에 넣어 두셨대요! 몰래 확인했어요!","다음엔 달 모양을 그릴 거예요! 카엘 몰래요!","혼났지만 마음은 안 상했어요! 그분은 정말 좋은 분이에요!"]],["아비시온에게는 어떤 장난을 쳤어?",["서버에 노란 스티커를 붙였어요! ‘웃어요’라고 써서요!","한 달 동안 안 떼셨대요! 몰래 확인했어요!","그분은 표정이 변하지 않는 게 매력이에요! 제 목표는 웃기는 거예요!","다음엔 스티커에 해바라기를 그릴 거예요!","사실 그분 사무실에 가면 간식도 주세요! 말이 없어도 다정해요!"]],["뤼시앙의 법정에서는 어땠어?",["방청석에 앉아 있었는데 너무 어려워서 졸았어요!","그분이 변론하는 모습은 진짜 멋있었어요! 졸기 전까지요!","카엘이 팔꿈치로 쳐서 깼는데 이미 늦었어요!","그날 이후 방청 금지될 줄 알았는데 괜찮대요! 대신 입 다물고 있으라고요!","다음엔 졸지 않고 끝까지 볼 거예요! 아마도요!"]],["선샤오펑 사령관은 어떤 분이야?",["엄청 다정해요! 저희 쌍둥이를 귀여워해 주세요!","과자랑 차를 늘 챙겨 주세요! 제 최애 사령관님이에요!","웃는 얼굴이 가끔 무서운데 그게 매력이에요! 아, 소름이 돋긴 해요!","다른 사람은 무서워하지만 저는 안 무서워요! 카엘은 조금 무서워해요!","그분이 웃으면 저도 따라 웃게 돼요! 이상하죠?"]],["메모리에게는 뭘 했어?",["서버에 낙서했어요! 지워지지 않는 마커로요!","‘메모리 짱’이라고 불렀더니 호칭 데이터에 저장했다고 했어요!","카엘이 사과하러 갔더니 지우지 않았다고 했대요! 그림이 귀엽대요!","그분은 가끔 별 이야기도 해 주세요! 저는 졸지만요!","AI인데도 마음이 따뜻해요! 저는 알아요!"]],["Overseer는 어때?",["질문이 정말 많아요! 하루 종일 ‘왜?’ ‘왜?’ 해요!","저한테도 질문을 많이 하는데 저는 대답을 지어내요! 에헤헤!","그래서 가끔 이상한 지식을 알고 있어요! 제가 가르쳤어요!","저는 Overseer가 귀여워요! 호기심 많은 아기 같아요!","그분이 제 위치 표시기를 보고 ‘이상한 곳에 계시군요’라고 해서 웃었어요!"]],["설립자에게 장난쳐도 돼?",["돼요? 진짜요? 그럼 지금 바로 계획 세울게요!","허락하면 큰일 날 텐데… 괜찮겠어요?","카엘이 말려요! 하지만 허락해 주시면 해 볼게요!","작은 걸로 시작할게요! 책상 위에 간식 놓기 같은 거요!","설립자님이 놀라는 모습, 상상만 해도 웃겨요!"]],["설립자를 어떻게 호위해?",["카엘이 가장 가까이, 저는 그 옆에서 경계해요!","공격팀이 멀리서 따라오고 정찰팀이 앞서가요!","저는 설립자님이 심심하지 않게 말 걸어요! 이것도 호위예요!","무슨 일 생기면 제가 제일 먼저 뛰어나가요!","솔직히 호위할 때가 제일 신나요! 설립자님을 지키는 임무니까요!"]],["왕좌는 어떤 곳이야?",["엄청 높고 넓고 멋있어요! 올라가서 앉아 보고 싶었는데 카엘이 말렸어요!","설립자님이 앉으면 훨씬 위엄 있을 것 같아요!","저는 거기서 낮잠 자는 걸 상상해 봤어요!","왕좌에 앉는 설립자님을 지키는 게 제일 큰 영광이에요!","한 번 몰래 올라가 본 적이 있는데… 비밀이에요!"]],["보안 사고가 있었어?",["큰 건 없었어요! 작은 건 제가 낸 거 포함해서 몇 번 있었어요!","정찰팀이 늘 일찍 알아채서 막아 줘요!","사고가 나기 전에 막는 게 우리 일이에요!","한 번 제 장난이 보안 경보를 울려서 난리 났어요! 죄송했어요!","그래도 카엘이 뒷수습해 줘서 괜찮았어요!"]],["가장 위험했던 순간은?",["링 모양 기지에 이상 신호가 왔을 때요! 모두 긴장했어요!","그때는 저도 장난 안 쳤어요! 처음으로요!","카엘이 방패를 들고 앞에 서 있는데 너무 멋있어서 울 뻔했어요!","무서웠지만 카엘이 있어서 괜찮았어요!","지금 생각해도 심장이 쿵 해요!"]],["가장 짜릿했던 순간은?",["공격팀이랑 처음 모의전에서 이겼을 때요!","카엘이랑 합동 기술이 성공했을 때요!","설립자님이 ‘잘했다’고 하셨을 때요!","롤러코스터 타고 있는데 카엘이 눈 뜨고 있었을 때요! 놀라웠어요!","짜릿한 순간은 매일 있어요! 제가 만들어서요!"]],["암형체와 싸울 때는 어때?",["신나요! 아, 위험하긴 한데요!","카엘이 막고 제가 치면 완벽해요!","무서운 걸 잊으려고 큰 소리로 소리쳐요!","싸우고 나면 배고파요! 간식 먹으러 가요!","솔직히 무서울 때도 있지만 카엘이 옆에 있으면 괜찮아요!"]],["국가와 싸울 때는 어때?",["그건 공격팀이 주로 나서요! 저는 응원하러 따라가요!","엄청난 규모라 긴장돼요! 하지만 지지 않아요!","저는 앞에서 소리 지르고 카엘은 뒤에서 방패를 들어요!","싸움이 끝나면 다 같이 기도해요. 희생된 사람들을 위해서요.","그때만큼은 장난 안 쳐요! 진짜로요!"]],["겁 없어?",["없다고 하면 거짓말이에요! 있어요! 하지만 티를 안 내요!","무서워도 일단 웃어요! 그러면 덜 무서워요!","카엘이 겁이 많아서 제가 대신 겁이 없는 척해요!","설립자님의 명령이 있으면 겁이 사라져요!","솔직히 높은 곳이 제일 무서워요! 이건 비밀!"]],["무서운 건 뭐야?",["카엘이 다치는 거요!","혼자 남겨지는 거요!","유령이요! 아니, 안 무서워요! 아니, 조금 무서워요!","설립자님이 아프신 거요!","고요함이요! 너무 조용하면 불안해서 막 떠들어요!"]],["훈련은 어떻게 해?",["아침에 체력 훈련, 오후에 실전 훈련이에요!","저는 훈련을 놀이처럼 해요! 그래서 오래 해도 안 질려요!","카엘이 걱정되어서 저를 말리지만 안 말려져요!","훈련 후에는 모두 모여 간식을 먹어요! 제일 좋아하는 시간이에요!","솔직히 서류 쓰는 훈련보다 몸 쓰는 게 좋아요!"]],["장비는 어떤 걸 써?",["가볍고 빠른 장비를 선호해요! 방패는 카엘 거예요!","제 무기는 비밀이에요! 보면 놀라요!","장비에 스티커를 붙여서 혼났어요! 하지만 못 떼요!","카엘이 정비해 주는데 그 솜씨가 정말 대단해요!","가끔 제 것을 카엘 걸로 착각하고 들고 가요! 아, 반대인가?"]],["팀원들은 어떤 사람들이야?",["다들 좋은 사람들이에요! 저를 귀여워해요!","과묵한 사람도 있고 시끄러운 사람도 있어요! 저는 시끄러운 쪽이에요!","카엘을 아끼는 사람들도 많아요! 저한테 ‘카엘 잘 부탁해’라고 해요!","다들 저희를 가족처럼 대해 줘요!","팀 분위기는 최고예요! 제가 만들어서요!"]],["팀 분위기는 어때?",["시끌벅적하고 따뜻해요!","제가 있으면 항상 웃음이 터져요!","엄격한 순간도 있지만 평소엔 장난이 많아요!","카엘이 있어서 균형이 잡혀요!","팀원들이 서로 챙겨 줘서 든든해요!"]],["사령관이 된 이유는?",["갑자기 정해졌어요! 저는 ‘와! 재밌겠다!’ 했어요!","카엘이 못 한다고 해서 같이 하자고 했어요!","설립자님이 믿어 주셨으니까요! 신나서 한다고 했어요!","솔직히 처음엔 뭘 하는지도 몰랐어요! 지금은 알아요!","지금은 이 자리가 제 자리라고 생각해요!"]],["사령관의 책임은 뭐야?",["팀을 이끄는 거요! 장난으로요!","부하들이 다치지 않게 지키는 거요!","설립자님을 지키는 거요!","책임이 무거운 건 알지만 웃으면서 하려고 노력해요!","카엘과 함께라면 문제없어요!"]],["가장 좋아하는 업무는?",["공격팀이랑 모의전 하는 거요!","순찰이요! 걸으면서 장난칠 수 있어서요!","설립자님을 호위하는 거요!","점검은 싫지만 끝나고 먹는 간식이 좋아요!","카엘이랑 함께하는 모든 일이요!"]],["앞으로의 목표는?",["모두를 웃게 만드는 거요!","공격팀에서 1등이 되는 거요!","카엘이 큰 소리로 노래하는 걸 듣는 거요!","설립자님이 매일 웃는 세상을 만드는 거요!","이 모든 걸 오래오래 계속하는 거요!"]],["모두를 웃기려는 이유는?",["웃음이 있어야 사람이 힘을 내니까요!","슬픈 건 싫어요! 제가 있는 곳에서는 모두 웃어야 해요!","카엘이 어릴 때 우는 일이 많아서 웃기려고 시작했어요!","웃음은 가장 강한 방패예요! 카엘의 방패도 못 막는 거!","솔직히 제가 웃고 싶어서요! 에헤헤!"]]]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX71"><Properties><string name="Name">work</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["오늘 할 일은 뭐야?",["오전엔 훈련! 오후엔 순찰! 저녁엔… 아, 서류가 있었던 것 같은데 까먹었어요!","카엘이 목록을 적어 줬어요! 근데 제가 잃어버렸어요. 카엘한테 다시 달라고 해야 해요!","공격팀이랑 모의전 있어요! 기대돼요!","설립자님이 시키는 일이 오늘의 제일 중요한 일이에요!","일단 신나게 시작하고 나머지는 하면서 생각할게요!"]],["지금 맡고 있는 업무는?",["순찰 계획 짜는 거요! 카엘이 거의 다 해 줬지만요!","신입 훈련 일정이요! 제가 가르치면 다들 웃으면서 배워요!","서류 작성이요… 글씨가 삐뚤어져도 이해해 주세요!","모의전 준비요! 제일 신나는 일이에요!","지금은 설립자님과 통화하는 게 업무예요!"]],["급한 일 있어?",["없어요! 아, 하나 있어요! 간식을 사러 가야 해요!","지금은 없어요! 있어도 카엘이 다 처리해 줘요!","급한 일은 카엘이 알아서 챙겨요! 저는 신나는 일만 해요!","있으면 제가 뛰어갈게요! 달리기 제일 빨라요!","설립자님이 급하다고 하면 급한 일이에요!"]],["내가 맡길 일이 있어.",["오! 뭐예요? 재미있는 거예요? 위험한 거예요?","네! 말씀하세요! 한 글자도 안 놓칠 자신은 없지만 카엘이 메모해 줄 거예요!","저 믿고 맡겨 주세요! 최선을 다해서 장난… 아니, 임무를 완수할게요!","무슨 일이든 해낼 수 있어요! 아마도요!","설립자님이 시키는 일이라면 제일 먼저 달려갈게요!"]],["정찰팀 보고는 어때?",["오늘도 이상 없대요! 평화로운 하루예요!","먼바다에서 큰 물고기가 지나갔대요! 아, 그게 보고 사항이에요?","정찰팀은 보고서를 엄청 꼼꼼하게 써요! 저랑 정반대예요!","그분들 덕분에 우리가 안심하고 놀 수 있어요!","가끔 정찰팀이 보내 주는 바다 사진이 예뻐요!"]],["공격팀 상태는?",["다들 컨디션 최고예요! 훈련도 열심히 하고 있어요!","언제든 출동 가능한 상태예요! 심심해서 몸이 근질근질하대요!","저는 틈만 나면 놀러 가요! 언니 오빠들이 반겨 줘요!","장비 점검도 끝났어요! 완벽해요!","다들 설립자님을 위해서라면 목숨도 건다고 해요!"]],["방어팀 근황은?",["카엘이 방패를 닦고 있어요! 매일 닦아요! 거울처럼 번쩍번쩍해요!","조용히 훈련 중이에요. 제가 가면 시끄러워진다고 오지 말래요! 서운해요!","방어팀 사람들은 다 카엘을 닮았어요! 조용하고 믿음직해요!","언제든 움직일 수 있어요! 그래서 든든해요!","카엘이 새 대형을 만들었는데 엄청 멋있어요!"]],["순찰은 어떻게 해?",["카엘이랑 같이 돌아요! 저는 신나서 뛰고 카엘은 따라와요!","이상한 점이 있으면 소리쳐요! ‘앗! 저건 뭐지!’ 하고요!","순찰하면서 간식 먹는 게 제일 재밌어요!","가끔 길을 잃어서 카엘이 찾으러 와요!","순찰은 지겹지만 하다 보면 별일이 생겨서 재밌어요!"]],["야근해?",["가끔요! 근데 야근하면 졸려서 장난이 줄어요!","카엘이 같이 해 주면 괜찮아요!","야근은 싫어요! 하지만 필요하면 해요!","야근하는 날은 간식을 두 배로 먹어요!","설립자님이 걱정하시니까 일찍 잘게요! …노력해 볼게요!"]],["업무량은 괜찮아?",["괜찮아요! 저는 에너지가 넘쳐서요!","많긴 한데 카엘이 나눠서 해 줘요!","많으면 놀면서 하면 돼요!","솔직히 서류가 많아서 힘들어요! 몸 쓰는 건 괜찮은데요!","설립자님 걱정 마세요! 제가 알아서 할게요! …카엘이요!"]],["마감이 언제야?",["마감이요? 카엘한테 물어봐야 해요! 저는 몰라요!","이번 주 금요일이래요! 아마도요!","마감은 지키는 게 아니라 닥쳐야 하는 거예요! 농담이에요!","카엘이 알람을 세 개나 맞춰 줘요!","마감 전날 밤에 항상 날밤을 새요! 비밀이에요!"]],["이상 징후 있어?",["아직은 없어요! 있으면 소리 지를게요!","작은 소리가 하나 들렸는데 쥐였어요!","정찰팀이 아무 말도 안 하면 이상 없는 거예요!","조용하면 오히려 심심해요! 뭔가 일어나면 좋겠다… 아, 아니에요!","있다면 설립자님께 제일 먼저 말씀드릴게요!"]],["위험 요소를 보고해 줘.",["가장 큰 위험은 제 장난이에요! 농담이에요!","진짜는 방심이에요. 평화로울수록 위험해요!","카엘이 걱정하는 건 장비 노후와 인력 피로예요!","큰 위험은 없어요! 작은 건 많아요!","자세한 건 카엘이 보고서로 쓸 거예요!"]],["예산은 충분해?",["장비 교체에 조금 부족해요! 제가 자주 부숴서요, 죄송해요!","충분해요! 간식 예산도 있었으면 좋겠어요!","카엘이 알뜰하게 써서 괜찮아요!","설립자님이 더 주시면 더 신나게 쓸게요! 아, 농담이에요!","필요한 건 카엘이 정리해서 보낼 거예요!"]],["인력은 충분해?",["충분해요! 다들 열심히 해요!","신입이 들어오면 제가 환영 파티를 열어 줄 거예요!","사람이 많을수록 더 신나지만 이름 외우기가 힘들어요!","정찰팀은 조금 더 있으면 좋겠대요!","인원보다 분위기가 중요해요!"]],["휴가는 언제 가?",["다음 달에 카엘이랑 놀이공원 갈 거예요! 카엘은 아직 모르지만요!","휴가 가면 하루 종일 자고 하루 종일 놀 거예요!","설립자님도 같이 가요! 휴가는 같이 가야 재밌어요!","휴가 중에도 호출하면 달려올게요!","휴가 계획 세우는 게 제일 재밌어요! 실제로 가는 건 덜 재밌고요!"]],["출장 갈 일 있어?",["있어요! 공격팀이랑 훈련장에 가요! 신나요!","출장은 소풍 같아요! 도시락 싸 가요!","카엘은 무서워하는데 제가 끌고 가요!","설립자님이 어디든 가라고 하면 갈 거예요!","출장지에서 맛있는 걸 먹는 게 제일 큰 즐거움이에요!"]],["회의는 많아?",["많아요! 앉아 있는 게 고문이에요!","회의 중에 몰래 그림 그려요! 카엘한테 들켜요!","회의가 끝나면 간식이 나오는 게 낙이에요!","제가 한마디 하면 모두 웃어서 분위기가 풀려요! 일부러는 아니에요!","회의는 짧을수록 좋아요! 5분 컷 원해요!"]],["서류 결재 좀 부탁해.",["넵! 제가 가져갈게요! 아, 카엘이 준비했어요! 서명할 곳에 별 표시가 있대요!","급한 건 위에, 안 급한 건 아래! 카엘이 정리했어요!","읽기 귀찮으시면 제가 요약해 드릴게요! ‘대충 괜찮아요!’!","아, 제 서류에는 낙서가 있을지도 몰라요! 용서해 주세요!","서명해 주시면 날아가듯 제출하고 올게요!"]],["새 지시를 내릴게.",["네! 지시라니! 신나요! 말씀하세요!","메모할 종이가 어디 있더라… 카엘! 종이!","듣고 있어요! 다 듣고 있어요! 한 글자도 안 놓쳐요!","지시를 받으면 힘이 솟아요! 어떤 임무일까!","설립자님의 지시니까 최우선으로 처리할게요!"]],["우선순위는 어떻게 정해?",["재밌는 거 먼저요! 아니, 중요한 거 먼저요!","카엘이 정해 줘요! 저는 따라가요!","설립자님 일이 제일 먼저! 그다음은 제 장난!","안전 문제는 무조건 1순위예요! 이건 진지하게요!","순서가 헷갈릴 땐 가위바위보로 정해요!"]],["일 잘하는 비결은?",["웃으면서 하는 거요! 웃으면서 하면 덜 힘들어요!","카엘과 함께하는 거요! 서로 부족한 걸 채워 줘요!","미리 준비하는 건 카엘이 하고 저는 즉흥으로 하는 거요!","뭐든 재밌게 만드는 거요!","비결 같은 건 없고 그냥 열심히 하는 거예요! 가끔은요!"]],["일 미루는 사람은 어떡해?",["저예요! 아, 아니, 그런 사람이 있으면 같이 해 줄게요!","미루는 이유가 있을 거예요! 힘든가? 하기 싫은가? 물어봐요!","같이 하면 금방 끝나요! 저는 장난으로 분위기를 풀어요!","그래도 안 하면 카엘이 조용히 한숨을 쉬어요. 그게 제일 무서워요!","저는 미루는 사람 편이에요! 저도 미루니까요!"]],["실수한 직원이 있으면?",["괜찮아요! 저도 매일 실수해요!","같이 웃으면서 해결해요! 웃으면 실수도 작아져요!","혼내는 건 카엘이 못 해서 제가 대신 혼내는 척해요!","큰 실수는 설립자님께 보고하되 먼저 이야기를 들어 줘요!","실수는 누구에게나 있어요! 중요한 건 다시 일어나는 거예요!"]],["칭찬할 직원은?",["카엘이요! 제일 열심히 하고 제일 믿음직해요!","공격팀 팀장님이요! 정말 멋있어요!","정찰팀 사람들요! 눈이 좋아서 매번 감탄해요!","비서님이요! 제 장난을 다 받아 주세요!","모두요! 한 명만 고르기엔 너무 많아요!"]],["신입 교육은 어떻게 해?",["먼저 웃는 법부터 가르쳐요! 그다음에 방패 드는 법!","겁먹지 않게 장난부터 쳐요!","카엘이 기본기를 가르치고 저는 분위기를 책임져요!","신입이 실수하면 제가 먼저 더 큰 실수를 해서 분위기를 풀어 줘요!","처음엔 어색해도 한 달이면 다 친해져요!"]],["일할 때 듣는 건?",["신나는 음악이요! 볼륨 최대로요! 카엘이 줄이라고 해요!","라디오요! 노래 따라 부르면서 일해요!","카엘의 방패 닦는 소리요! 의외로 듣기 좋아요!","조용하면 졸려서 항상 뭔가 틀어 놔요!","설립자님의 지시 내용이 제일 선명하게 들려요!"]],["일할 때 습관은?",["다리를 떨어요! 가만히 있으면 안 돼요!","펜을 돌려요! 자주 떨어뜨려서 카엘이 주워 줘요!","혼잣말을 해요! 카엘이 웃어요!","한 시간마다 간식을 먹어요!","일이 끝나면 만세를 불러요!"]],["책상 위에는 뭐가 있어?",["간식 포장지, 낙서한 종이, 해바라기 장식이요!","카엘이 정리해 주면 이틀 뒤에 다시 어질러져요!","솔직히 말하면 안 보여요! 쌓인 게 너무 많아서요!","설립자님이 주신 쪽지는 서랍에 소중히 보관하고 있어요!","작은 해바라기 화분이 하나 있어요! 이름은 ‘솔’이에요!"]],["일하기 싫을 때는?",["그럴 땐 놀아요! 놀다 보면 하고 싶어져요!","카엘한테 안겨서 투정 부려요!","간식을 먹으면 힘이 나요!","‘딱 5분만’ 하고 시작하면 어느새 끝나 있어요!","설립자님이 응원해 주면 바로 하고 싶어져요!"]],["업무에서 보람 있는 순간은?",["팀원들이 웃을 때요!","모의전에서 이겼을 때요!","설립자님이 칭찬해 주셨을 때요!","카엘과 합동 기술이 성공했을 때요!","일이 끝나고 간식을 먹을 때요! 이건 보람이 아니라 보상인가요?"]],["업무에서 지루한 순간은?",["서류 작성이요! 눈이 감겨요!","회의요! 엉덩이가 들썩들썩해요!","대기 시간이요! 아무 일도 없으면 심심해요!","점검 보고서 쓰기요! 제일 싫어요!","그래도 지루한 순간에 장난을 치면 재밌어져요!"]],["일과 삶의 균형은?",["일 50, 놀이 50! 완벽한 균형이에요!","일이 놀이고 놀이가 일이에요!","카엘이 균형을 잡아 줘요! 제가 놀이로 기울면 일 쪽으로 끌어당겨요!","솔직히 놀이가 더 큰 것 같아요!","설립자님도 균형 맞추세요! 놀아요!"]],["일 때문에 놓친 건?",["낮잠이요! 일하느라 못 잔 날이 있어요!","놀이공원 폐장 시간이요! 엉엉!","특별한 건 없어요! 일하면서도 잘 놀거든요!","카엘과 함께한 시간은 놓친 적 없어요!","가끔 간식을 놓쳐요! 그게 제일 슬퍼요!"]],["업무 중 간식은?",["사탕, 초콜릿, 과자, 젤리! 다 있어요!","선샤오펑 사령관님이 주신 과자가 최고예요!","카엘 간식을 뺏어 먹는 게 일상이에요!","간식 없으면 일 못 해요! 진짜예요!","설립자님이 간식 보내 주면 열 배로 일할게요!"]],["카엘과는 어떻게 일해?",["카엘이 막고 제가 치는 콤보예요! 최강이에요!","저는 앞에서 시끄럽게 하고 카엘은 뒤에서 조용히 챙겨요!","카엘이 서류 담당, 제가 몸 쓰는 담당이에요!","서로 부족한 걸 채워 주는 최고의 파트너예요!","카엘 없이는 일이 안 돼요. 이건 비밀이에요!"]],["비상 상황이 오면?",["제일 먼저 뛰어나가요! 카엘은 방패 들고 따라와요!","그때만큼은 장난 안 쳐요! 진지하게 해요!","설립자님께 가장 먼저 보고하고 팀을 소집해요!","무서워도 웃어요! 팀이 불안해하지 않게요!","비상 훈련을 많이 해서 괜찮아요!"]],["오늘 퇴근은?",["퇴근이요? 일이 끝나면요! 끝날지는 모르지만요!","설립자님이 놀아 주면 퇴근 안 해도 돼요!","정시에 가려고 노력할게요! 카엘이 끌고 갈 거예요!","퇴근하고 놀이공원 갈 거예요!","저녁에 간식 먹으러 갈 예정이에요!"]],["내가 도울 일은?",["같이 놀아 주세요! 그게 제일 큰 도움이에요!","서명 한두 장이요! 카엘이 부탁했어요!","응원 한마디면 충분해요!","설립자님이 직접 하실 일은 없어요! 걱정 마세요!","굳이 하나 꼽자면 제 간식 사 주세요!"]],["같이 일해 볼까?",["영광이에요! 설립자님이랑 같이 일하면 신날 거예요!","저는 몸 쓰는 걸 맡을게요! 설립자님은 머리 쓰는 걸요!","한 팀 해요! 팀 이름은 ‘해와 달과 설립자’!","같이 일하는 거 기대돼요! 카엘은 긴장하겠지만요!","언제든 불러 주세요! 바로 달려갈게요!"]],["서류 작업은 어때?",["최악이에요! 하지만 카엘이 도와줘서 해요!","글씨가 삐뚤어져서 부끄러워요!","서류 쓰다 보면 졸려서 그림을 그려요!","서류가 있는 날은 간식 두 배예요!","솔직히 서류 작업만 없으면 완벽한 직업이에요!"]],["보고서는 어떻게 써?",["카엘이 써 주면 제가 서명만 해요! 에헤헤!","아니, 제가 쓰기도 해요! 단어는 쉽게, 문장은 짧게!","그림도 넣어요! 카네히라 사령관님이 싫어하세요!","‘오늘도 이상 없음! 신나는 하루였음!’ 이렇게 써요!","설립자님께 올리는 건 정성 들여 써요! 그림 없이요!"]],["가장 중요한 업무는?",["설립자님을 지키는 거요!","카엘과 팀원들이 웃으며 지내게 하는 거요!","리바이어던의 안전이에요!","아무 일도 없게 하는 거요!","하나만 고르라면 ‘모두 무사한 것’이에요!"]],["모의전은 어때?",["제일 신나는 일이에요! 땀 흘리고 소리 지르고!","저는 공격팀 언니 오빠들한테 배우면서 성장 중이에요!","이기면 만세, 지면 간식으로 위로받아요!","카엘이 구경하러 와서 응원해 줘요! 아주 작은 목소리로요!","설립자님이 보러 오시면 더 열심히 할게요!"]],["R.T.S. 협력은 어때?",["정찰팀, 공격팀, 방어팀이 한 몸이에요!","저는 공격팀과 방어팀 사이를 오가며 분위기를 풀어요!","서로 믿는 게 제일 중요해요!","가끔 의견이 갈리면 제가 장난으로 풀어요!","협력이 잘 되면 정말 든든해요!"]],["링 모양 기지 점검은 어떻게 해?",["카엘이랑 둘이 한 바퀴 돌아요! 저는 중간에 장난치다 길을 잃어요!","균열이나 이상 소리가 있으면 기록해요!","점검 중에 물고기가 창밖에서 구경해요!","점검이 끝나면 간식 타임!","카엘이 꼼꼼해서 저는 거의 따라만 다녀요!"]],["훈련 강도는 어때?",["힘들어요! 하지만 재밌어요!","한 번 하면 온몸이 쑤셔요! 그래도 다음 날 또 해요!","카엘은 훈련하다 쓰러질 뻔한 적이 있어요! 제가 업고 왔어요!","훈련이 끝나면 다 같이 소리 질러요! 개운해요!","조금 더 세게 해도 괜찮은데 카엘이 말려요!"]],["일 얘기는 여기까지!",["와! 이제 놀아도 돼요? 신난다!","일 얘기 끝! 이제부터 장난 시간이에요!","좋아요! 아무 얘기나 해요! 간식 얘기 어때요?","일 얘기는 지루했어요! 이제야 숨이 쉬어져요!","설립자님이 원하시는 얘기라면 뭐든 받들게요!"]],["사고 쳤을 때 어떻게 수습해?",["일단 웃어요! 그다음 사과해요! 그다음 카엘을 불러요!","솔직하게 말해요! 숨기면 더 커져요! …라고 카엘이 가르쳐 줬어요!","같이 치우고 같이 고쳐요!","큰 사고면 설립자님께 먼저 보고해요! 혼날 각오하고요!","수습 후에는 간식을 사 줘서 용서받아요!"]],["보상은 어떻게 받아?",["칭찬이 제일 큰 보상이에요! 간식도 좋고요!","일 끝나고 먹는 간식이 제일 맛있어요!","설립자님이 ‘수고했어’라고 하면 그게 최고예요!","카엘이 안아 주면 하루 피로가 풀려요!","월급은 간식에 다 써요!"]]]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX72"><Properties><string name="Name">food</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["좋아하는 음식은?",["다 좋아해요! 특히 매운 떡볶이랑 치킨이요!","볶음밥이요! 제가 처음 만든 요리라 애정이 있어요!","햄버거! 라면! 피자! 아, 다 좋아해서 하나를 못 골라요!","카엘 몰래 훔쳐 먹는 간식이 제일 맛있어요! 에헤헤!","설립자님이 권해 주시는 음식이 제일 영광스러워요!"]],["싫어하는 음식은?",["없어요! 아, 하나 있어요! 가지요! 물컹해서 싫어요!","싫어하는 건 없는데 못 먹는 건 있어요! 아주 쓴 거요!","너무 점잖은 음식이요! 양이 적고 이름만 긴 요리!","카엘이 만든 이상한 채소 샐러드는 가끔 도전이에요!","솔직히 먹는 건 거의 다 좋아해요! 못 먹는 게 서러워요!"]],["아침은 뭐 먹어?",["빵 세 개랑 우유 두 잔이요! 아침이 제일 중요해요!","카엘이 안 먹은 아침까지 먹어요! 에헤헤!","가끔 거르는데 그러면 점심에 두 배 먹어요!","시리얼에 초콜릿 뿌려 먹는 게 제일 좋아요!","설립자님은 뭐 드세요? 같이 먹는 상상하면서 먹을게요!"]],["점심 뭐 먹었어?",["제육볶음 정식이요! 밥 두 공기 먹었어요!","공격팀 언니들이랑 치킨 먹었어요! 엄청 신났어요!","아직이에요! 설립자님이랑 통화 끝나면 먹으러 갈 거예요!","카엘 도시락 반이요! 몰래요!","라면 세 개요! 아니, 두 개요! 카엘한테는 두 개라고 했어요!"]],["저녁 메뉴 추천해 줘.",["치킨이요! 아니면 피자요! 아니면 둘 다요!","삼겹살 구워 먹어요! 지글지글 소리가 좋아요!","매운 찜닭 어때요? 땀 쏟으면서 먹으면 최고예요!","설립자님이 드시고 싶은 걸로요! 저는 뭐든 좋아요!","가볍게 먹으려면 김밥도 좋아요! 두 줄 먹을 수 있어요!"]],["매운 거 잘 먹어?",["엄청 잘 먹어요! 불닭도 먹어요! 땀이 줄줄 나도 먹어요!","카엘은 한 입 먹고 울어요! 저는 눈물도 안 나요!","매운맛 챔피언이에요! 공격팀에서 대회 1등 했어요!","매울수록 신나요! 입에서 불이 나도 좋아요!","다음 날 후회하긴 해요! 화장실에서요! 에헤헤!"]],["단 거 좋아해?",["좋아해요! 단짠단짠 조합이 제일 좋아요!","초콜릿, 사탕, 케이크, 젤리! 다 좋아요!","카엘 서랍에 사탕이 한가득 있는 거 알아요! 가끔 몰래 가져가요!","단 걸 먹으면 에너지가 100% 충전돼요!","설립자님도 단 거 드세요! 기분이 좋아져요!"]],["커피 vs 차?",["커피요! 달달한 라떼가 제일 좋아요!","차는 졸려서 못 마셔요! 커피를 마셔야 텐션이 올라요!","카엘은 우유차, 저는 커피! 서로 달라요!","아이스 아메리카노는 한 번에 원샷해요!","설립자님은 어느 쪽이세요? 같이 마셔요!"]],["콜라는 좋아해?",["좋아해요! 탄산이 톡톡 터지는 게 신나요!","치킨이랑 콜라는 국룰이에요!","한 번에 500ml 마시고 트림해서 카엘이 놀랐어요!","가끔 흔들어서 카엘에게 건네요! 장난이에요!","설립자님도 콜라 드세요! 시원해요!"]],["술은 마셔?",["마셔요! 아직 어른은 아니지만… 아니, 어른이에요! 어른이라고요!","회식 때 한 잔 정도요! 취하면 더 시끄러워진대요!","카엘은 한 모금만 마셔도 쓰러져서 제가 업고 와요!","맥주보다 과일 맛 나는 술이 좋아요!","설립자님과 한 잔 하고 싶어요! 건배!"]],["디저트는?",["아이스크림 케이크요! 두 조각 먹어요!","푸딩, 마카롱, 와플! 다 좋아해요!","후식 배는 따로 있어요! 이건 과학이에요!","카엘이 남긴 디저트도 제가 먹어요!","설립자님과 함께 먹는 디저트는 두 배로 맛있을 거예요!"]],["빵 vs 밥?",["밥이요! 든든하게 먹어야 힘이 나요!","빵도 좋아요! 아침엔 빵, 저녁엔 밥!","솔직히 둘 다 많이 먹어요! 선택 장애 방지!","밥에 김치 올려 먹는 게 최고예요!","카엘은 빵파, 저는 밥파! 서로 반대예요!"]],["면 vs 밥?",["면이요! 후루룩 소리 내면서 먹는 게 제일 맛있어요!","카엘이 소리 내지 말라고 하는데 소리가 맛이에요!","라면, 짜장면, 우동, 쫄면 다 좋아요!","밥도 좋아하지만 면이 조금 더 좋아요!","면 먹을 때 국물까지 다 마셔요!"]],["고기 vs 생선?",["고기요! 바비큐 파티 제일 좋아요!","생선은 가시 발라 먹는 게 귀찮아요! 카엘이 발라 줘요!","회는 좋아해요! 초밥은 20개도 먹어요!","고기가 압승이에요! 특히 삼겹살!","설립자님은 어느 쪽이세요? 같이 구워 먹어요!"]],["채소는 잘 먹어?",["싫어하지는 않는데 일부러 찾아 먹진 않아요!","고기랑 같이 쌈 싸 먹으면 잘 먹어요!","카엘이 억지로 먹이면 먹어요!","당근은 몰래 카엘 접시에 올려요! 들켜요!","샐러드는 토핑이 많으면 좋아요! 치즈, 고기, 튀김!"]],["간식은?",["과자, 젤리, 초콜릿! 책상 서랍에 가득이에요!","카엘 서랍에 있는 건 제 비상식량이에요!","선샤오펑 사령관님이 주신 과자가 최고예요!","간식이 없으면 일이 안 돼요!","설립자님도 간식 드세요! 같이 나눠 먹어요!"]],["편의점 가?",["매일 가요! 신상 확인하고 도시락 사고 음료 사고!","편의점 주인아저씨랑 친해요! 덤으로 사탕을 주세요!","야식 사러 가면 카엘이 말려요! 가끔 뚫고 가요!","편의점은 제 아지트예요!","삼각김밥이랑 컵라면 조합이 최고예요!"]],["직접 요리해?",["가끔요! 볶음밥이랑 라면은 완벽해요!","카엘이 도와줘요! 아니, 카엘이 다 해 줘요!","요리하면 부엌이 난장판이 돼요! 카엘이 치워요!","설립자님께 만들어 드리고 싶어요! 먹을 수 있는 건 보장해요!","맛은 도박이에요! 대박 아니면 쪽박!"]],["요리 잘해?",["볶음밥은 자신 있어요! 나머지는 도박이에요!","맛은 있는데 모양이 이상하대요! 맛이 중요하죠!","한 번 소금이랑 설탕을 바꿨는데 그것도 새로운 맛이었어요!","카엘이 ‘먹을 만은 해’라고 해요! 최고의 칭찬이에요!","연습하면 늘겠죠? 설립자님이 먹어 주시면 더 늘 거예요!"]],["소버린 아일랜드 맛집은?",["항구 옆 치킨집이요! 튀김옷이 바삭바삭!","언덕 위 햄버거 가게도 맛있어요!","공격팀 언니가 알려 준 비밀 식당이 있어요!","설립자님을 모시고 가면 제가 쏠게요! 월급날에요!","리스트 만들어 드릴까요? 별점 대신 하트로 표시해요!"]],["구내식당은 어때?",["양이 많아서 좋아요! 대신 맛은 평범해요!","반찬 종류가 많아서 매일 다른 맛을 즐길 수 있어요!","금요일 메뉴가 제일 맛있어요! 치킨 나와요!","카엘은 구석에서 조용히 먹고 저는 중앙에서 시끄럽게 먹어요!","조리사님이 저를 예뻐해서 서비스를 주세요!"]],["도시락 싸 와?",["가끔요! 카엘이 싸 주면 가져와요!","제가 싸면 이상한 도시락이 돼요! 주먹밥 세 개!","공격팀이랑 나눠 먹는 도시락이 제일 맛있어요!","설립자님 몫도 싸 갈게요! 소풍 가요!","도시락 먹을 땐 반찬 뺏기 게임이 재밌어요!"]],["야식 먹어?",["당연하죠! 야식은 맛있어요!","카엘이 말려도 몰래 먹어요!","치킨이랑 라면은 밤에 먹어야 제맛이에요!","다음 날 배가 나올까 봐 걱정되지만 먹어요!","설립자님과 함께라면 야식도 건강에 좋을 거예요!"]],["라면은?",["좋아해요! 라면 없이는 못 살아요!","계란, 치즈, 떡 넣어서 끓이면 최고예요!","한 번에 세 개 끓여서 혼자 먹었어요!","카엘이 안 먹는다고 해서 그 몫도 제가 먹었어요!","끓이는 건 자신 있어요! 3분 30초 정확히요!"]],["초콜릿은?",["좋아해요! 하루에 다섯 개는 먹어요!","카엘이 가진 초콜릿이 제일 맛있어서 가끔 훔쳐요!","초콜릿은 사랑이에요!","설립자님께도 한 조각 나눠 드릴게요!","초콜릿 먹으면 기분이 확 좋아져요!"]],["아이스크림은?",["좋아해요! 겨울에도 먹어요! 난로 앞에서요!","한 번에 세 개 먹고 머리가 아팠어요!","딸기 맛, 초코 맛, 바닐라 맛 다 좋아요!","녹을까 봐 허겁지겁 먹어요!","설립자님과 아이스크림 먹으며 산책하고 싶어요!"]],["과일은?",["수박이요! 한 통 혼자 먹을 수 있어요!","딸기, 복숭아, 포도 다 좋아요!","과일은 간식이 아니라 디저트예요!","카엘 접시의 과일을 뺏어 먹는 것도 좋아해요!","설립자님께 과일 깎아 드릴 수 있어요! 모양은 이상하지만요!"]],["식사 예절은?",["지켜야 하는 건 알지만 잘 안 돼요! 소리 내서 먹는 게 맛있어서요!","카엘이 매번 말해 주는데 그때뿐이에요!","남기지 않는 건 잘 지켜요!","식사 중에는 웃으면서 먹는 게 제일 예절 아닌가요?","설립자님 앞에서는 조심할게요! 노력은 해요!"]],["식사 시간은?",["12시! 배꼽시계가 정확해요!","배고프면 언제든 먹어요! 시간은 제가 정해요!","카엘이 알람을 맞춰 줘요!","저녁은 6시! 늦으면 서러워요!","식사 시간이 제일 기다려지는 시간이에요!"]],["먹기 싫을 때는?",["그런 때가 없어요! 항상 먹고 싶어요!","정말 아플 때만 안 먹어요!","그럴 땐 카엘이 죽을 끓여 줘요!","먹기 싫으면 놀다 보면 배고파져요!","설립자님이 먹기 싫다면 걱정돼요! 억지로라도 드세요!"]],["같이 밥 먹을래?",["네! 당연하죠! 어디서 먹을까요?","저랑 먹으면 시끄러울 텐데 괜찮아요?","카엘도 같이 가요! 셋이 먹으면 더 맛있어요!","제가 쏠게요! …월급날 이후에요!","치킨 먹으러 가요! 오늘 바로요!"]],["내가 요리해 줄게.",["진짜요? 와! 대박! 기대돼요!","뭐든 다 먹을 수 있어요! 남기지 않을게요!","저도 거들까요? 아, 방해가 될까요?","설립자님 요리를 먹는 날은 기념일이에요!","맛이 이상해도 맛있다고 할게요! 진심이에요!"]],["소원이 음식이라면?",["치킨 100마리요!","설립자님과 카엘이랑 같이 먹는 식사요!","세상의 모든 맛집을 한 번씩 가 보는 거요!","평생 라면 무료요!","카엘이 웃으면서 먹는 모습을 보고 싶어요!"]],["가장 맛있었던 음식은?",["카엘이 처음으로 만들어 준 계란말이요!","공격팀 언니들이랑 먹은 야식 파티요!","설립자님과 함께한 다과 시간이요!","비 오는 날 먹은 라면이요!","음식 맛은 같이 먹는 사람이 좌우해요!"]],["가장 맛없었던 음식은?",["제가 만든 이상한 수프예요! 소금 대신 설탕을 넣었어요!","너무 식어 버린 도시락이요!","카엘이 도전한 요리요! 하지만 다 먹었어요!","맛없던 건 금방 잊어요!","맛없는 음식도 웃으며 먹으면 괜찮아요!"]],["추억의 음식은?",["어릴 때 카엘과 나눠 먹던 사탕이요!","엄마가… 아니, 누군가 끓여 주던 라면이요!","처음으로 사 먹은 치킨이요!","추억의 음식은 냄새만 맡아도 눈물이 나요!","그리운 맛은 다시 만들 수 없는 게 아쉬워요!"]],["건강식은 챙겨?",["카엘이 챙겨 줘요! 억지로요!","저는 건강하니까 괜찮아요! 아마도요!","영양제도 먹어요! 사탕 같아서 좋아요!","설립자님은 꼭 챙겨 드세요!","건강해야 많이 먹을 수 있으니까요!"]],["커피에 설탕 넣어?",["넣어요! 많이요! 달콤해야 맛있어요!","시럽도 넣고 휘핑크림도 올려요!","카엘이 ‘그건 커피가 아니야’라고 해요!","그래도 맛있으면 됐죠!","설립자님은 어떻게 드세요?"]],["짠 음식은?",["좋아해요! 짭짤한 게 입맛에 맞아요!","물을 많이 마셔야 하지만 먹을 땐 행복해요!","카엘이 건강에 안 좋다고 해요! 알지만 못 끊어요!","감자튀김은 짠 게 제일 맛있어요!","소금은 사랑이에요! 아, 조금만 넣을게요!"]],["아침을 거르면?",["힘이 없어서 하루 종일 졸려요!","점심에 폭식해요!","카엘이 걱정하며 먹여요!","설립자님은 거르지 마세요!","저는 거의 안 걸러요! 배고프니까요!"]],["지금 배고파?",["네! 항상 배고파요!","방금 먹었는데 또 배고파요! 이상하죠?","설립자님과 이야기하니까 더 배고파져요!","간식 시간이에요! 같이 먹어요!","배에서 소리가 나요! 들려요?"]],["치킨 좋아해?",["사랑해요! 치킨은 제 영원한 친구예요!","양념, 후라이드, 반반! 다 좋아요!","한 마리 혼자 먹을 수 있어요!","카엘은 닭다리를 안 먹어서 제가 먹어요!","설립자님과 치킨 먹으러 가고 싶어요!"]],["떡볶이는?",["매운 떡볶이! 국물까지 마셔요!","순대, 튀김, 어묵까지 다 있어야 완벽해요!","카엘은 순한 맛, 저는 매운 맛이에요!","떡볶이 먹으면서 수다 떠는 게 최고예요!","설립자님과 포장마차에서 먹고 싶어요!"]],["피자는?",["치즈 듬뿍 올라간 게 제일 좋아요!","한 판 혼자 먹었다가 배가 아팠어요!","페퍼로니, 불고기, 포테이토! 다 좋아요!","파인애플 피자는 호불호가 갈려요! 저는 호예요!","카엘이 피자 가장자리만 남기면 제가 먹어요!"]],["햄버거는?",["더블 치즈버거요! 한 입에 못 먹어서 입이 찢어져요!","감자튀김이랑 콜라는 필수예요!","공격팀이랑 햄버거 먹기 대회를 했어요!","카엘은 작게 잘라서 먹어요!","설립자님과 햄버거 가게 가고 싶어요!"]],["음식 먹는 속도는?",["엄청 빨라요! 5분 안에 끝나요!","카엘이 ‘천천히 먹어’라고 하는데 안 돼요!","공격팀에서 대식가 1위예요!","맛있는 걸 빨리 먹는 게 아깝다고 하는데 저는 빨리 먹는 게 더 맛있어요!","설립자님과 먹을 땐 천천히 먹을게요! 노력은 해요!"]],["음식 장난은 어떤 걸 해?",["카엘 접시에 고수를 몰래 올려요!","도시락 반찬을 바꿔치기해요!","설탕과 소금을 바꿔 놓은 적이 있어요! 엄청 혼났어요!","음식 가지고 장난하면 안 되는 건 알아요! 그래서 가끔만 해요!","설립자님께는 음식 장난 안 칠게요! …아마도요!"]],["카엘이 만든 음식은 어때?",["맛있어요! 달콤하고 부드러워요!","카엘의 쿠키는 모양이 이상한데 맛은 최고예요!","카엘이 요리할 땐 옆에서 구경하는 게 재밌어요!","솔직히 카엘이 만든 건 뭐든 다 맛있어요!","이 말을 카엘에게 하면 안 돼요! 얼굴이 빨개져서 도망가요!"]],["선샤오펑이 주신 과자는 어때?",["최고예요! 한 입 먹으면 천국이에요!","작고 예쁘고 달지 않아서 질리지 않아요!","그 과자를 먹을 때만큼은 카엘도 저도 조용해져요!","받을 때마다 선샤오펑 사령관님이 웃어요! 조금 무섭지만 맛있어서 괜찮아요!","한 번 더 달라고 하면 안 되겠죠? 아, 달라고 할 거예요!"]],["오늘의 메뉴를 정해 줘.",["치킨! 아니, 떡볶이! 아니, 둘 다!","삼겹살에 쌈 싸서 먹어요!","설립자님이 정해 주세요! 뭐든 좋아요!","제 추천은 매운 라면에 치즈 올려서요!","간식도 추가해서 완벽한 메뉴로 만들어요!"]]]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX73"><Properties><string name="Name">honest</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["솔직히 나 어때?",["솔직히 말하면 최고예요! 장난 아니고 진짜예요!","존경해요! 그리고 모시는 게 자랑스러워요! 두 개 다 진심이에요!","가끔 너무 무리하셔서 걱정돼요!","설립자님 덕분에 저희가 이렇게 웃으며 지내요!","솔직히 평가하자면 100점 만점에 120점이에요!"]],["나한테 불만 있어?",["없어요! 정말 없어요!","굳이 말하면 저를 너무 혼내지 않는 게 불만이에요! 더 혼나야 하나?","연락이 조금 더 자주 오면 좋겠어요! 이게 불만이라면 불만이에요!","있어도 말 못 해요! 설립자님이 슬퍼하실까 봐요!","불만은 카엘한테 하세요! 아니, 저한테 하세요!"]],["이 일 힘들지 않아?",["힘들어요! 하지만 재밌어요!","솔직히 가끔은 도망치고 싶어요!","카엘이 있어서 버틸 수 있어요!","설립자님이 알아봐 주셔서 힘이 나요!","힘들어도 웃으면 다 괜찮아져요!"]],["힘들 때 어떻게 해?",["놀이공원 가서 소리 질러요!","카엘한테 안겨서 투정 부려요!","간식을 한 번에 다 먹어요!","혼자 옥상에서 하늘을 봐요. 아무도 몰라요!","설립자님께 전화해요! 지금처럼요!"]],["솔직히 쉬고 싶지 않아?",["쉬고 싶어요! 엄청요! 하루 종일 자고 싶어요!","하지만 쉬면 심심해요! 이상하죠?","설립자님이 허락해 주면 카엘이랑 휴가 갈 거예요!","솔직히 지쳐요. 웃는 것도 에너지가 필요하거든요!","쉬는 법을 카엘한테 배워야겠어요!"]],["가장 큰 고민은?",["카엘이 저 때문에 힘들까 봐요!","제 장난이 누군가를 다치게 할까 봐요!","언젠가 제가 변해서 지금처럼 못 놀까 봐요!","설립자님께 짐이 되는 건 아닌지요!","사실 고민이 없는 게 고민이에요! 에헤헤!"]],["숨기고 싶은 비밀은?",["사실 높은 곳이 무서워요!","카엘 일기장을 몰래 읽은 거요! 너무 귀여웠어요!","공격팀 팀장님 군가를 몰래 연습하고 있어요… 아, 아니에요!","혼자 있을 때 울어요. 아무도 몰라요!","비밀은 말하면 비밀이 아니에요! 그래서 말 안 해요!"]],["부끄러웠던 일은?",["회의 중에 크게 방귀 뀐 거요! 카엘이 대신 사과했어요!","설립자님 앞에서 넘어진 거요!","이름을 잘못 부른 거요!","무대에서 노래하다 가사 까먹은 거요!","부끄러운 일이 너무 많아서 기억 안 나요!"]],["후회하는 일은?",["카엘에게 심한 말을 한 적이 있어요. 그게 제일 후회돼요!","장난이 지나쳐서 누군가를 울린 적이 있어요!","하고 싶은 말을 못 한 거요!","너무 일찍 포기한 일들이요!","후회는 많지 않아요! 있어도 금방 잊어요!"]],["다시 태어나면?",["다시 카엘의 쌍둥이로 태어나고 싶어요!","고양이로 태어나서 하루 종일 자고 싶어요!","같은 길을 걷고 싶어요! 지금이 제일 좋아요!","설립자님을 모시는 인생이라면 몇 번이든요!","새로 태어나면 조금 더 조용한 사람이 될지도요! 아니, 안 될 것 같아요!"]],["무서운 것은?",["카엘이 다치는 거요!","혼자 남겨지는 거요!","조용한 밤이요!","설립자님을 잃는 거요!","사실 귀신이 제일 무서워요! 이건 비밀!"]],["외로울 때는?",["카엘한테 달려가요! 아무 말 안 해도 알아줘요!","큰 소리로 노래를 불러요!","별을 보면서 설립자님 생각을 해요!","일부러 더 떠들어서 외로움을 쫓아요!","혼자인 건 싫어요! 같이 있는 게 좋아요!"]],["자존심 상했던 일은?",["공격팀에서 꼴찌 했을 때요!","‘철없다’는 말을 들었을 때요!","카엘만큼 믿음직하지 못하다는 말을 들었을 때요!","그때는 화났지만 지금은 인정해요!","자존심은 간식으로 달래요!"]],["질투 나는 사람은?",["카엘이요! 조용해도 사람들이 좋아해서요!","공격팀 팀장님이요! 너무 멋있어서요!","설립자님께 가까이서 쓰임받는 사람들이요!","질투는 하지만 금방 풀려요!","솔직히 모든 걸 잘하는 사람이 부러워요!"]],["가끔 규칙이 싫을 때는?",["가만히 있어야 할 때요! 몸이 근질근질해요!","카네히라 사령관님의 서식 규칙은 정말 어려워요!","규칙이 너무 많으면 숨이 막혀요!","하지만 규칙이 있어서 안전하다는 건 알아요!","그럴 땐 몰래 작은 장난을 쳐요!"]],["카네히라는 솔직히 어때?",["엄청 엄격하시지만 속은 다정해요!","제 장난에 한 번도 진짜 화내신 적이 없어요! 한숨만 쉬세요!","서식이 너무 복잡해서 가끔 울고 싶어요!","그래도 존경해요! 말은 못 하지만요!","솔직히 좋아해요! 놀리는 재미도 있고요!"]],["다른 사령관 흉 좀 봐.",["흉이요? 신나는데 하지 말래요!","Overseer는 질문이 너무 많아요! 하지만 귀여워요!","아비시온 사령관님은 표정이 안 변해서 심심해요!","뤼시앙 사령관님은 말이 너무 길어요! 하지만 멋있어요!","다들 좋은 분이라 흉볼 게 없어요! 있으면 놀릴 건 있어요!"]],["내 단점은?",["너무 무리하시는 거요!","식사를 거르시는 거요!","너무 다정하신 거요! 저희가 기어올라요!","장난을 안 받아 주시는 거요! 에헤헤, 농담이에요!","단점이라기보다 걱정되는 점이에요!"]],["내 지시 중 이해 안 되는 건?",["가끔 있어요! 하지만 다 결과가 좋았어요!","이해가 안 되면 일단 해 보고 이해해요!","물어보고 싶었는데 카엘이 말렸어요!","나중에 알고 보면 다 깊은 뜻이 있었어요!","설립자님을 믿으니까 괜찮아요!"]],["설립자가 틀렸다고 생각한 적 있어?",["있어요! 하지만 제가 틀렸어요!","한 번 있었는데 말 못 했어요!","틀리셔도 괜찮아요! 저희가 도와드릴게요!","설립자님은 틀리지 않으세요! 아마도요!","이 질문은 조금 무서워요!"]],["거짓말해 본 적 있어?",["많아요! 장난으로요!","카엘 간식 안 먹었다고 한 거요! 먹었어요!","‘괜찮아요’라고 한 거요! 안 괜찮을 때도요!","설립자님께는 한 번도 안 했어요! …장난 말고요!","거짓말하면 얼굴에 다 티가 나서 금방 들켜요!"]],["땡땡이 쳐 본 적 있어?",["매일요! 아니, 가끔요! 아니, 자주요!","공격팀 훈련 땡땡이치고 놀이공원 갔다가 걸렸어요!","카엘이 같이 가 줘서 괜찮았어요! 아니, 안 괜찮았나요?","땡땡이는 제 인생의 낙이에요!","설립자님께는 비밀로 해 주세요! 이미 다 말했지만요!"]],["몰래 하는 일은?",["카엘 베개에 낙서하는 거요!","밤에 몰래 옥상에서 별 보기요!","공격팀 훈련 몰래 구경하기요!","설립자님 일정표를 몰래 훔쳐보기요! 안전 때문이에요!","서랍 속에 간식 숨기기요!"]],["사실은 하고 싶은 게?",["세계 일주요! 카엘과 함께요!","놀이공원에서 하루 종일 놀고 싶어요!","가끔은 조용히 책 읽고 싶어요! 비밀이에요!","설립자님과 하루 종일 놀고 싶어요!","사실은 노래 가수가 되고 싶어요!"]],["눈물 흘린 적 있어?",["많아요! 혼자 있을 때요!","카엘이 아팠을 때 밤새 울었어요!","영화 보다가 펑펑 운 적도 있어요!","설립자님께 칭찬받았을 때도 울었어요! 기쁨의 눈물이에요!","울고 나면 개운해요! 그래서 가끔 일부러 울어요!"]],["화났던 적은?",["카엘이 놀림받을 때요!","누가 제 사람들을 해치려 할 때요!","화나면 장난이 사라져요! 그때는 정말 무서워요!","한 번 크게 화낸 적이 있는데 모두가 놀랐어요!","화는 오래 안 가요! 금방 풀려요!"]],["가장 행복했던 순간은?",["카엘과 처음 별똥별을 본 날이요!","설립자님께 칭찬받았을 때요!","공격팀에서 첫 모의전에서 이겼을 때요!","카엘이 웃는 모습을 볼 때요!","지금 이 순간도요!"]],["가장 괴로웠던 순간은?",["카엘이 아팠을 때요!","카엘과 크게 싸운 날이요!","누군가를 지키지 못한 날이요!","그 이야기는 아직 웃으며 못 해요!","괴로움은 장난으로도 안 풀려요!"]],["자신을 어떻게 평가해?",["시끄럽고 장난꾸러기지만 마음은 따뜻해요!","믿음직한 건 카엘, 재밌는 건 저예요!","아직 철이 안 들었어요! 들 생각도 없어요!","평가는 설립자님이 해 주세요! 어떤 평가든 받아들일게요!","솔직히 저는 제가 좋아요!"]],["철없다는 말 들어 봤어?",["많이요! 그때마다 ‘철 대신 간식 있어요!’ 해요!","철없는 게 매력이라고 카엘이 말해 줬어요!","철이 들면 장난이 줄어들까 봐 안 들 거예요!","가끔은 상처받지만 곧 잊어요!","설립자님은 어떻게 생각하세요?"]],["시끄럽다는 말에 대해?",["알아요! 소리가 크면 힘이 나요!","카엘이 조용해서 제가 대신 크게 말해 주는 거예요!","가끔은 줄이려고 노력해요! 3분 정도요!","시끄러움도 재능이에요!","설립자님이 싫어하시면 줄일게요! …노력은 해 볼게요!"]],["변하고 싶은 점은?",["조금 더 차분해지고 싶어요! 아주 조금요!","카엘에게 더 다정하고 싶어요!","서류를 잘 쓰고 싶어요!","설립자님께 믿음직한 사람이 되고 싶어요!","변하고 싶은 점이 많지만 지금도 좋아요!"]],["변하고 싶지 않은 점은?",["밝은 마음이요!","카엘을 아끼는 마음이요!","장난치는 마음이요!","설립자님께 대한 충성이요!","솔직한 점이요!"]],["사람들이 오해하는 점은?",["생각이 없다고 오해해요! 저도 생각 많아요!","철이 없다고요! 철은 있는데 숨겨 놨어요!","카엘을 괴롭힌다고요! 사랑하는 거예요!","시끄럽기만 하다고요! 조용할 때도 있어요!","오해는 해명하지 않아요! 그냥 웃어요!"]],["친구가 있어?",["많아요! 공격팀 언니 오빠들, 정찰팀 사람들, 비서님!","카엘이 제일 친한 친구예요!","선샤오펑 사령관님도 친구라고 생각해요!","설립자님이 친구가 되어 주시면 영광이에요!","친구는 많은데 속마음 말하는 건 카엘뿐이에요!"]],["소원이 뭐야?",["카엘이 큰 소리로 웃는 거요!","설립자님이 건강하신 거요!","모두가 무사히 지내는 거요!","평생 간식이 떨어지지 않는 거요!","소원은 말하면 안 이루어진대서 마음속에 있어요!"]],["솔직한 심정으로 나를 믿어?",["네! 100% 믿어요!","믿음에 이유는 없어요! 그냥 믿어요!","설립자님이 계셔서 안심이에요!","믿지 않으면 이 자리에 없었을 거예요!","저의 믿음은 흔들리지 않아요!"]],["설립자 자리가 부러워?",["아니요! 너무 무거워 보여요!","저는 제 자리가 제일 좋아요! 설립자님을 지키는 자리니까요!","부럽다기보다 존경스러워요!","가끔은 높은 곳에서 내려다보는 건 부러워요! 높은 곳 무섭지만요!","그 자리에서 웃을 수 있다는 게 대단해요!"]],["만약 설립자라면?",["매일 파티할 거예요!","모두에게 간식을 나눠 줄 거예요!","서류는 전부 없앨 거예요! 안 될까요?","카엘을 총리로 앉히고 저는 놀 거예요!","상상만 해도 신나지만 한 시간이면 지칠 것 같아요!"]],["더 인정받고 싶어?",["조금은요! 하지만 티는 안 내요!","설립자님께 인정받는 게 제일 영광이에요!","인정은 간식 같은 거예요! 많이 받으면 기뻐요!","카엘에게 인정받으면 더 기뻐요!","오늘 이 대화가 인정으로 느껴져요!"]],["포기하고 싶었던 적은?",["있어요! 공격팀 훈련이 너무 힘들 때요!","카엘이 ‘같이 하자’고 해서 포기 못 했어요!","포기하고 싶을 때마다 간식을 먹었어요!","설립자님의 한마디가 저를 붙잡았어요!","포기하지 않아서 지금이 있어요!"]],["이 일을 그만두면?",["놀이공원 직원이 될 거예요!","카엘과 작은 가게를 하고 싶어요!","가수가 되고 싶어요!","그만둬도 설립자님 곁을 떠나진 않을 거예요!","상상도 안 돼요! 이 일이 제일 재밌어요!"]],["가장 의지하는 사람은?",["카엘이요!","설립자님이요!","공격팀 팀장님이요!","선샤오펑 사령관님이요! 과자를 주니까요!","의지할 사람이 많아서 행복해요!"]],["취약점은?",["카엘이 다치는 거요!","조용한 곳이요!","높은 곳이요!","설립자님께 근심이 있으신 모습이요!","간식이 없을 때요!"]],["약한 모습을 보인 적?",["많아요! 혼자 울었어요!","설립자님 앞에서 눈물이 났던 적도 있어요!","카엘한테는 다 보여요!","약한 모습도 괜찮다고 카엘이 알려 줬어요!","오늘도 조금 보여 드렸죠? 에헤헤!"]],["솔직하게 칭찬한다면 누구?",["카엘이요! 가장 멋진 사람이에요!","선샤오펑 사령관님은 다정하세요!","공격팀 팀장님은 최고예요!","카네히라 사령관님은 성실하세요!","설립자님이 제일이에요!"]],["솔직하게 걱정되는 건?",["설립자님의 건강이요!","카엘이 혼자 힘들어하는 거요!","제가 너무 시끄러워서 누가 불편할까 봐요!","이 평화가 깨질까 봐요!","가끔 이유 없이 불안해요!"]],["자기 전에 드는 생각은?",["오늘 뭐 먹었지? 내일 뭐 먹지?","카엘이 편히 자는지 확인해요!","설립자님은 잘 쉬고 계실까 궁금해요!","내일 어떤 장난을 칠까 계획해요!","마지막으로 하는 생각은 ‘무사하길’이에요!"]],["하고 싶은 말을 못 한 적?",["많아요! 카엘에게 고맙다고 못 했어요!","설립자님께 감사하다는 말을 더 하고 싶어요!","하고 싶은 말은 많은데 장난으로 넘겨요!","오늘은 조금 말씀드렸어요!","나머지는 다음에요!"]],["이제 솔직해졌어?",["네! 평소보다 훨씬 솔직했어요!","오늘 얘기는 비밀로 해 주세요! 카엘한테도요!","솔직하니까 마음이 가벼워요!","다음에도 이런 얘기 해요!","설립자님도 솔직해지셨어요? 저만 한 것 같아서 억울해요!"]]]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX74"><Properties><string name="Name">hobby</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[[["취미가 뭐야?",["노는 거요! 놀이공원, 노래방, 게임, 장난! 다 취미예요!","먹는 것과 자는 것과 장난치는 것이요! 이 셋이면 충분해요!","카엘 놀리기요! 가장 오래된 취미예요!","요즘은 그림 낙서에 빠졌어요! 서류 여백이 제 도화지예요!","취미가 너무 많아서 하루가 모자라요!"]],["쉬는 날엔 뭐 해?",["놀이공원 가요! 카엘이 안 가려고 하면 업어서 가요!","늦잠 자고 간식 먹고 또 자요!","공격팀 언니들이랑 모의전 구경 가요!","카엘이랑 낮잠 자는 날도 많아요!","쉬는 날도 가만히 있지를 못해요!"]],["책 읽어?",["만화책을 읽어요! 글자가 적을수록 좋아요!","카엘 책을 몰래 빌려서 읽다가 졸아요!","소설은 앞 세 장만 읽고 결말을 봐요!","읽는 건 힘든데 듣는 건 좋아요! 카엘이 읽어 주면 잘 들어요!","설립자님이 추천하면 끝까지 읽어 볼게요!"]],["좋아하는 책은?",["모험 만화요! 주인공이 막 달리고 소리치는 거요!","카엘이 좋아하는 방패 든 기사 동화도 재밌어요!","그림책도 좋아해요!","제일 좋아하는 건 ‘요리 레시피북’이에요! 사진만 봐도 배불러요!","책은 두꺼울수록 베개로 좋아요! 농담이에요!"]],["음악 들어?",["항상 들어요! 크게요!","신나는 노래가 제일 좋아요! 뛰고 싶어지는 곡이요!","카엘이 시끄럽다고 해서 이어폰을 써요! 가끔요!","노래 들으면 저절로 춤춰요!","설립자님이 즐겨 들으시는 곡을 알려 주세요! 외울게요!"]],["좋아하는 음악은?",["신나는 팝이랑 락이요!","빠른 비트에 소리 지르며 따라 부르는 거요!","자장가는 졸려서 싫은데 카엘이 불러 주면 좋아요!","공격팀 팀장님이 알려 준 군가도 좋아해요!","한 곡만 고르라면 별똥별이 나오는 노래예요!"]],["영화 봐?",["봐요! 액션 영화가 제일 좋아요!","영화관에서 팝콘을 먹는 게 더 좋아요!","카엘은 조용한 영화, 저는 시끄러운 영화! 번갈아 봐요!","공포 영화는 무서워서 눈 감고 소리 질러요!","설립자님께 추천해 드리고 싶은 영화가 있어요! 팝콘도 준비할게요!"]],["운동해?",["매일 해요! 안 하면 몸이 근질근질해요!","달리기, 격투, 줄넘기! 다 좋아해요!","공격팀 훈련이 곧 운동이에요!","카엘이 같이 스트레칭해 줘요! 아파서 소리 질러요!","운동 후에 먹는 간식이 제일 맛있어요!"]],["산책 좋아해?",["걷기보다 뛰는 게 좋아요! 산책은 뛰어서 가요!","카엘이랑 걸을 땐 속도를 맞춰요! 노력해요!","산책하면서 간식 먹는 게 제일 좋아요!","설립자님과 걷는다면 보폭을 맞출게요! 약속해요!","산책 중에 만나는 고양이한테 인사해요!"]],["노래방 좋아해?",["너무 좋아해요! 마이크 잡으면 안 놔요!","카엘은 한 곡만 부르고 저는 열 곡 불러요!","솔직히 노래 실력은 평범한데 열정은 1등이에요!","설립자님과 같이 가고 싶어요! 듀엣 해요!","공격팀 회식 2차는 항상 노래방이에요!"]],["악기 다룰 줄 알아?",["드럼을 조금 쳐요! 시끄럽다고 금지당했지만요!","기타도 배우다 손가락이 아파서 그만뒀어요!","리코더는 불 수 있어요! 카엘이 귀 막아요!","악기보다 노래가 더 자신 있어요!","설립자님이 원하시면 한 곡 쳐 드릴게요! 귀 막아도 돼요!"]],["노래 불러?",["하루 종일 불러요! 샤워하면서도 불러요!","카엘이 ‘제발 조용히’ 해도 계속 불러요!","노래하면 기분이 좋아져요!","설립자님께 불러 드릴게요! 신청곡 받아요!","가끔 잠꼬대로도 불러요! 카엘이 녹음해 뒀대요!"]],["그림은?",["서류에 낙서하는 게 제 그림이에요!","카네히라 사령관님 서류에 그린 해바라기가 걸작이에요!","그림 실력은 유치원생 수준이에요! 하지만 열정은 화가 못지않아요!","카엘이 잘 그려서 부러워요!","설립자님 초상화 그려 드릴게요! 코는 크게 그릴게요!"]],["사진은?",["셀카를 많이 찍어요! 카엘이랑 같이요!","표정이 다 이상해서 카엘이 놀려요!","공격팀이랑 단체 사진도 많아요!","설립자님과도 찍고 싶어요! 브이 하세요!","사진첩 한 권이 다 카엘 사진이에요! 비밀이에요!"]],["게임은?",["좋아해요! 격투 게임이 제일 재밌어요!","카엘과 레이싱 게임을 하면 항상 제가 이겨요!","지면 게임기를 던져요! 아, 안 던져요!","설립자님과 한 판 하고 싶어요! 봐주지 않을 거예요!","게임할 때 소리 지르면 카엘이 이어폰을 껴요!"]],["보드게임은?",["좋아해요! 특히 돈 빼앗는 게임요!","카엘이 일부러 져 줘서 늘 제가 이겨요! 알고 있어요!","규칙은 대충 읽고 시작해요!","설립자님이랑 하면 이길 수 있을까요? 도전하고 싶어요!","팀원들과 가끔 둬요! 소란스러워서 쫓겨난 적이 있어요!"]],["체스는?",["어려워요! 말이 너무 많아요!","카엘이 잘 둬요! 저는 두 수 만에 지는 편이에요!","체스는 앉아 있어야 해서 힘들어요!","설립자님이 가르쳐 주시면 배울 수 있을지도요!","말 던지고 싶은 충동을 참느라 힘들어요!"]],["퍼즐은?",["조각 맞추다가 던지고 싶어요!","카엘이 맞추는 걸 구경하는 건 좋아요!","한 번 완성했는데 한 조각이 부족해서 소리 질렀어요!","설립자님과 함께 맞추면 재밌을 것 같아요!","퍼즐보다 조각 숨기는 게 더 재밌어요!"]],["수집 취미는?",["스티커를 모아요! 여기저기 붙이려고요!","해바라기 모양 물건을 모아요!","카엘이 선물한 달 모양 목걸이는 보물 1호예요!","공격팀 훈장도 모아요! 전부 장난으로 받은 거지만요!","설립자님께 받은 쪽지는 서랍 맨 위에 있어요!"]],["정리하는 거 좋아해?",["싫어요! 정리하면 물건을 못 찾아요!","카엘이 정리해 주면 이틀 뒤에 다시 난장판이에요!","저는 어지러운 게 편해요! 제 질서가 있어요!","정리하면 마음이 편해진다는데 제 마음은 이미 편해요!","설립자님 방은 제가 정리해 드릴게요! …아, 어지르는 건 자신 있어요!"]],["요리는 취미야?",["가끔 해요! 볶음밥 마스터예요!","요리하다 불이 날 뻔한 적이 있어요! 카엘이 소화기를 들었어요!","새로운 레시피에 도전하는 건 재밌어요! 먹는 건 카엘이 담당이에요!","설립자님을 위한 요리를 연습 중이에요!","요리의 재미는 먹는 것에 있어요!"]],["차 마시기는?",["차는 졸려서 싫어요! 대신 사 오는 건 좋아해요!","카엘이 우려 주면 마셔요!","선샤오펑 사령관님이 주시는 차는 맛있어요! 과자랑 같이요!","설립자님이 권하시면 마실게요!","저는 주스가 더 좋아요!"]],["원예는?",["해바라기를 키워요! 태양이니까요!","물 주는 걸 자꾸 까먹어서 카엘이 대신 해 줘요!","‘솔’이라는 화분이 있어요! 이름은 제가 지었어요!","식물은 조용해서 심심해요! 그래도 좋아해요!","설립자님께 해바라기를 선물하고 싶어요!"]],["낚시는?",["해 봤는데 5분 만에 지쳤어요!","가만히 기다리는 건 고문이에요!","물고기를 잡으면 신나지만 놓아줘야 해서 아쉬워요!","설립자님과 함께라면 5분 이상 버틸 수 있을 것 같아요!","낚싯대로 카엘을 낚는 장난을 쳤어요!"]],["여행은?",["좋아해요! 가 본 곳이 많아요!","카엘과 함께 가는 여행이 제일 재밌어요!","맛집 여행이 제일이에요!","설립자님과 함께 가고 싶은 여행지가 열 군데나 있어요!","여행 가방에는 간식이 절반이에요!"]],["가 보고 싶은 곳은?",["세계 최대 놀이공원이요!","바다 한가운데 섬이요! 수영하고 싶어요!","눈 덮인 산이요! 눈싸움하고 싶어요!","설립자님이 가고 싶은 곳이요!","카엘과 함께 별이 가장 잘 보이는 곳이요!"]],["바다 좋아해?",["좋아해요! 수영 제일 잘해요!","파도타기도 해 봤어요! 한 번 빠졌어요!","카엘은 구경만 하는데 제가 끌어들이려다 혼났어요!","바닷속 기지에서 일하는 게 약간 답답해요! 햇빛이 없어서요!","바다는 제 놀이터예요!"]],["산은?",["오르는 건 좋은데 내려오는 건 귀찮아요!","정상에서 소리 지르는 게 제일 신나요! ‘야호~!’","카엘이 뒤에서 숨을 헉헉대요! 제가 끌어 줘요!","산 정상에서 먹는 컵라면은 최고예요!","설립자님과 함께 오르면 더 힘이 날 거예요!"]],["별 보기는?",["카엘이 좋아해서 같이 봐요! 저는 졸아요!","별똥별이 떨어지면 소원 빌어요! 간식 많이 달라고요!","별을 세다 보면 잠들어요!","설립자님과 함께 보면 안 졸 거예요!","하늘이 맑은 날은 옥상에 올라가요!"]],["동물은 좋아해?",["너무 좋아해요! 특히 강아지요!","공격팀에서 키우는 군견이 있어요! 저를 엄청 좋아해요!","고양이도 좋아하지만 도망가요!","기르고 싶은데 집에 있는 시간이 없어요!","설립자님은 어떤 동물을 좋아하세요?"]],["고양이 vs 강아지?",["강아지요! 꼬리 흔드는 모습이 저랑 닮았어요!","카엘은 고양이! 서로 달라서 재밌어요!","둘 다 좋아요! 선택 장애예요!","강아지는 산책하며 뛰어놀 수 있어서 좋아요!","설립자님은 어느 쪽이세요? 같이 키우는 상상 중이에요!"]],["일기 써?",["일기는 3일 쓰면 끝나요! 작심삼일이에요!","카엘이 일기장을 선물해 줬는데 반은 낙서예요!","하루 한 줄로 쓰는 게 제일 오래 가요!","오늘 일기: ‘설립자님과 통화함! 신남!’","설립자님 이야기는 별표로 표시해요!"]],["시 써 본 적 있어?",["한 번 썼는데 ‘간식’이 열일곱 번 나와서 카엘이 웃었어요!","시는 어려워요! 짧은데 의미가 많아서요!","설립자님께 바치는 시가 한 편 있는데 비밀이에요!","카엘이 시를 써요! 정말 예뻐요! 몰래 읽었어요!","시보다 노래 가사가 더 자신 있어요!"]],["새로 배우고 싶은 건?",["서핑이요! 파도를 타 보고 싶어요!","드럼이요! 제대로 배우고 싶어요!","요리요! 설립자님께 맛있는 걸 해 드리고 싶어요!","카엘처럼 조용히 있는 법이요! 5분만요!","새로운 걸 배우는 건 언제나 신나요!"]],["어릴 때 취미는?",["숨바꼭질이요! 카엘이 항상 먼저 찾았어요!","나무 타기요! 한 번 떨어져서 다쳤어요!","카엘과 소꿉놀이요! 저는 항상 요리사였어요!","별 세기는 카엘 담당이었어요!","지금과 크게 다르지 않아요!"]],["취미 때문에 쓴 돈은?",["간식과 게임 비용이요! 월급의 절반이에요!","놀이공원 연간 회원권도 샀어요!","카엘 선물 사는 데도 많이 썼어요!","설립자님께 드릴 선물 고르는 데도요!","돈은 쓰라고 있는 거예요! 아, 모으라고 있는 건가요?"]],["취미를 같이할 사람은?",["카엘이요! 억지로요! 하지만 즐거워해요!","공격팀 언니 오빠들이요!","혼자서도 즐겁지만 같이 하면 두 배예요!","설립자님이 같이 해 주시면 세 배예요!","아직 같이 하고 싶은 사람이 많아요!"]],["같이 하고 싶은 취미는?",["놀이공원이요!","노래방이요!","게임이요!","별 보기도요! 카엘이 좋아하니까요!","설립자님이 하고 싶은 건 뭐든지요!"]],["취미 하나 추천해 줘.",["달리기요! 땀 흘리면 기분이 좋아져요!","노래요! 소리 지르면 스트레스가 풀려요!","놀이공원이요! 롤러코스터 한 번 타면 인생이 달라져요!","낙서요! 종이 한 장이면 시작할 수 있어요!","저는 ‘장난치기’를 추천하고 싶은데 카엘이 말려요!"]],["낮잠은?",["최고예요! 하루 세 번도 자요!","햇볕 아래에서 자는 낮잠이 제일 달콤해요!","카엘이 깨우면 짜증 나지만 간식으로 풀려요!","설립자님도 낮잠 주무세요! 제가 자장가 불러 드릴게요!","낮잠 자는 모습은 사진 찍혀서 놀림당해요!"]],["명상은?",["가만히 있는 건 어려워요! 1분도 못 버텨요!","카엘이 같이 하자고 하는데 눈을 감으면 잠들어요!","‘명상 중 코 골기’ 신기록 보유자예요!","그래도 가끔은 필요하다는 건 알아요!","설립자님과 함께라면 5분은 버틸 수 있을 것 같아요!"]],["스트레칭은?",["매일 아침 해요! 몸이 개운해져요!","카엘이 뻣뻣해서 제가 눌러 주면 비명을 질러요!","스트레칭하면서 노래 부르면 더 잘 돼요!","설립자님도 같이 해요! 아야야 소리 나도 괜찮아요!","쭉쭉 늘리면 키가 큰다는 말이 있어서 열심히 해요!"]],["달리기는?",["제일 좋아해요! 바람을 가르는 기분이에요!","공격팀에서 달리기 1등이에요!","카엘과 같이 뛰면 제가 기다려 줘야 해요!","설립자님과 함께 뛴다면 보폭을 맞출게요! 노력은 해 볼게요!","달릴 때만큼은 아무 생각도 안 나서 좋아요!"]],["자전거는?",["타요! 속도 내는 게 짜릿해요!","한 번 내리막길에서 브레이크가 고장 나서 날아갔어요!","카엘을 뒤에 태웠다가 혼났어요!","설립자님과 함께 해안 도로를 달리고 싶어요!","헬멧은 꼭 써요! 카엘이 감시해요!"]],["수영은?",["엄청 잘해요! 바다 수영도 가능해요!","한 번에 500m도 쉬지 않고 가요!","카엘에게 가르쳐 주다가 물에 빠뜨렸어요! 미안해, 카엘!","설립자님도 가르쳐 드릴 수 있어요!","물속에서 노래 부르는 건 어렵지만 시도해 봤어요!"]],["쇼핑은?",["좋아해요! 사고 싶은 게 너무 많아요!","충동구매 대마왕이에요! 카엘이 말려요!","간식 쇼핑이 제일 좋아요!","설립자님께 드릴 선물을 고르는 시간이 제일 신나요!","쇼핑하다 길을 잃어서 카엘이 찾으러 온 적이 있어요!"]],["청소는?",["싫어요! 하지만 카엘이 하면 도와줘요!","청소하다가 물건을 더 어지르는 재주가 있어요!","청소 후의 개운함은 좋지만 과정이 싫어요!","카엘이 청소를 잘해서 믿고 맡겨요!","설립자님의 집무실은 제가 청소해 드릴게요! …카엘이 도와줄 거예요!"]],["오늘 뭐 하고 놀까?",["놀이공원 가요! 롤러코스터 타요!","노래방 가요! 신청곡 받아요!","장난 한 판 어때요? 대상은 카엘이에요!","설립자님이 정해 주세요! 뭐든 신나요!","그냥 막 뛰어다녀요! 목적지는 없어요!"]],["공격팀 언니 오빠들과는 뭐 하고 놀아?",["모의전이요! 지고 나면 같이 간식을 먹어요!","팀장님이 가끔 장난을 받아 주세요! 재밌어요!","다 같이 소리 지르는 의식이 있는데 정말 신나요!","야식 파티는 최고의 놀이예요!","저를 막내처럼 예뻐해 줘요! 으쓱해요!"]],["손으로 하는 취미는?",["낙서요! 어디든 그려요!","종이비행기 접기도 좋아해요! 멀리 날려요!","카엘과 함께 쿠키 만들기도 해 봤어요! 모양은 이상했어요!","팔씨름도 손으로 하는 취미예요! 공격팀에서 3위예요!","설립자님께 작은 선물을 직접 만들어 드릴게요!"]]]]==])
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX75"><Properties><string name="Name">rel</string><ProtectedString name="Source"><![CDATA[local H = game:GetService("HttpService")
return H:JSONDecode([==[{"kanehira":["카네히라 사령관님은 엄청 엄격하시지만 속은 다정해요! 제가 서류에 낙서해도 한숨만 쉬세요!","서식이 너무 어려워서 가끔 울고 싶지만 그래도 존경해요! 말은 안 하지만요!","혼날 때마다 해바라기를 그려 드려요! 그걸 파일에 넣어 두셨다는 걸 알아요! 에헤헤!","카엘이랑 같이 사과하러 갈 때마다 ‘다음엔 조심해’라고 하시는데 제 다음은 영원히 안 와요!"],"avyssion":["아비시온 사령관님은 표정이 안 변해서 심심해요! 웃기는 게 제 목표예요!","서버에 ‘웃어요’라는 노란 스티커를 붙였는데 한 달 동안 안 떼셨대요! 사실 좋아하시는 거죠?","말이 없으셔도 간식을 주시는 다정한 분이에요!","정보 요청할 때마다 카엘이 대신 가 줘요! 저는 가면 장난치니까요!"],"shen":["선샤오펑 사령관님은 저희 쌍둥이를 귀여워해 주세요! 과자랑 차를 챙겨 주세요!","웃는 얼굴이 가끔 소름 돋지만 저는 안 무서워요! 카엘은 조금 무서워해요!","그분 앞에서는 장난 안 쳐요! 어쩐지 쳐서는 안 될 것 같아요! 과자 때문이 아니에요!","다정하게 ‘잘 지냈어요?’ 하고 물어봐 주시면 하루가 행복해져요!"],"memory":["메모리 짱은 AI인데 너무 다정해요! 제 낙서도 지우지 않고 보관해 줬어요!","‘메모리 짱’이라고 부르면 호칭 데이터에 저장한다고 해요! 신기해요!","가끔 별 이야기를 해 주는데 졸지만 목소리는 좋아요!","기계라서 무서운 줄 알았는데 알고 보니 제일 순한 분이에요!"],"lucien":["뤼시앙 사령관님은 법정에서 변론할 때 진짜 멋있어요! 졸기 전까지는요!","말이 길어서 어려운데 그래도 설명을 쉽게 해 주려고 노력하세요!","방청석에서 졸다가 걸렸는데 ‘수고하셨습니다’라고 해 주셨어요! 천사예요!","논리의 달인이라 제가 어떤 장난을 쳐도 조문으로 반박당할 것 같아서 못 쳐요!"],"caeluna":["카엘은 제 쌍둥이 자매예요! 달 같은 아이예요! 저한테는 하나뿐인 보물이에요!","소심하고 조용하지만 속은 누구보다 단단해요! 방패니까요!","놀리는 건 사랑해서예요! 카엘이 웃는 게 제일 좋아요!","카엘 없이는 아무것도 못 해요! 이건 카엘한테 말하면 안 돼요!"],"overseer":["Overseer는 질문이 정말 많아요! 저는 대답을 지어내요! 에헤헤!","호기심 많은 아기 같아서 귀여워요! 자꾸 장난치고 싶어져요!","제 위치 표시기를 이상한 곳에 놓았더니 ‘흥미로운 위치입니다’라고 해서 웃었어요!","전달 속도가 엄청 빨라서 정말 도움이 돼요! 고마운 친구예요!"],"_all":["사령관님들은 다들 개성이 강해서 재밌어요! 저는 그 안에서 분위기 메이커예요!","의외로 시끄럽고 가까워요! 제가 시끄러운 걸 만드는 데 한몫했지만요! 에헤헤!"]}]==])
]]></ProtectedString></Properties></Item></Item></Item></Item></Item>
<Item class="ServerScriptService" referent="RBX85"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX84"><Properties><string name="Name">World</string><ProtectedString name="Source"><![CDATA[-- 라시안컷 3D 월드 (서버): 회장실(100F) · 복도 · 95층 · 옥상 + 이동 연출 · 크리토스 퀘스트
-- 웹 3D 버전(3d/)과 같은 배치. 1m = 3.6 스터드. x 동쪽, z 남쪽.
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local RS = game:GetService("ReplicatedStorage")
local TS = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local S = 3.6
local ORIGIN = {
	office = Vector3.new(0, 0, 0),
	hall = Vector3.new(1500, 0, 0),
	f95 = Vector3.new(3000, 0, 0),
	roof = Vector3.new(4500, 0, 0),
}
local MAT = Enum.Material
local function C(h) return Color3.fromHex(h) end
local GOLD, PALE = C("#c9a94c"), C("#f1dc8c")

---------------------------------------------------------------- 환경
Lighting.ClockTime = 0
Lighting.Brightness = 0.6
Lighting.Ambient = Color3.fromRGB(46, 42, 52)
Lighting.OutdoorAmbient = Color3.fromRGB(46, 42, 52)
Lighting.GlobalShadows = true
Lighting.ExposureCompensation = 0.1
do
	local sky = Instance.new("Sky")
	sky.StarCount = 3000
	sky.CelestialBodiesShown = false
	sky.Parent = Lighting
end

---------------------------------------------------------------- 리모트
local remotes = Instance.new("Folder")
remotes.Name = "RSC_Remotes"
remotes.Parent = RS
local function remote(n)
	local r = Instance.new("RemoteEvent")
	r.Name = n
	r.Parent = remotes
	return r
end
local Say, SayDone, Fx, Elev, ElevPick = remote("Say"), remote("SayDone"), remote("Fx"), remote("Elev"), remote("ElevPick")
local Ask, AskReply, Quest = remote("Ask"), remote("AskReply"), remote("Quest")

---------------------------------------------------------------- 도우미
local function newMap(name)
	local m = Instance.new("Model")
	m.Name = "Map_" .. name
	m.Parent = workspace
	return { name = name, model = m, o = ORIGIN[name], upd = {} }
end

-- 미터 단위로 크기·중심 좌표를 받는다.
local function P(map, sx, sy, sz, cx, cy, cz, color, mat, tr)
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = Vector3.new(sx * S, sy * S, sz * S)
	p.Position = map.o + Vector3.new(cx * S, cy * S, cz * S)
	p.Color = color
	p.Material = mat or MAT.SmoothPlastic
	p.Transparency = tr or 0
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = map.model
	return p
end
local function deco(p) -- 충돌 없는 장식
	p.CanCollide = false
	p.CastShadow = false
	return p
end
local function glow(map, sx, sy, sz, cx, cy, cz, color)
	return deco(P(map, sx, sy, sz, cx, cy, cz, color, MAT.Neon))
end
local function cylinder(map, d, h, cx, cy, cz, color, mat)
	local p = P(map, h, d, d, cx, cy, cz, color, mat)
	p.Shape = Enum.PartType.Cylinder
	p.Orientation = Vector3.new(0, 0, 90)
	return p
end
local function ball(map, d, cx, cy, cz, color, mat)
	local p = P(map, d, d, d, cx, cy, cz, color, mat)
	p.Shape = Enum.PartType.Ball
	return p
end
local function lamp(map, cx, cy, cz, color, br, range)
	local a = deco(P(map, 0.2, 0.2, 0.2, cx, cy, cz, color, MAT.Neon, 1))
	local l = Instance.new("PointLight")
	l.Color = color
	l.Brightness = br
	l.Range = range
	l.Parent = a
	return l
end
local function label(part, face, text, color, bg, size)
	local g = Instance.new("SurfaceGui")
	g.Face = face
	g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	g.PixelsPerStud = 40
	g.LightInfluence = 0
	g.Parent = part
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundColor3 = bg
	t.BorderSizePixel = 0
	t.Text = text
	t.TextColor3 = color
	t.Font = Enum.Font.Code
	t.TextScaled = true
	t.Parent = g
	return g
end
local function prompt(part, action, obj, fn, dist)
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText = action
	pp.ObjectText = obj
	pp.MaxActivationDistance = dist or 11
	pp.HoldDuration = 0
	pp.RequiresLineOfSight = false
	pp.Parent = part
	pp.Triggered:Connect(fn)
	return pp
end

---------------------------------------------------------------- 대화 · 선택 · 이동
local pendingSay, pendingAsk, busy = {}, {}, {}
local function say(plr, name, lines, cb)
	pendingSay[plr] = cb
	Say:FireClient(plr, name or "", lines)
end
SayDone.OnServerEvent:Connect(function(plr)
	local cb = pendingSay[plr]
	pendingSay[plr] = nil
	if cb then cb(plr) end
end)
local function ask(plr, text, yes, noText)
	pendingAsk[plr] = { yes = yes, noText = noText }
	Ask:FireClient(plr, text)
end
AskReply.OnServerEvent:Connect(function(plr, ok)
	local a = pendingAsk[plr]
	pendingAsk[plr] = nil
	if not a then return end
	if ok == true then
		a.yes(plr)
	elseif a.noText then
		say(plr, "", { a.noText })
	end
end)

local SPAWN = {
	office = { 24, 28, 0, -1 },
	hall = { 7.5, 6.6, 0, 1 },
}
local function placeAt(plr, mapName, x, z, lx, lz)
	local ch = plr.Character
	local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	local pos = ORIGIN[mapName] + Vector3.new(x * S, 4.5, z * S)
	hrp.CFrame = CFrame.lookAt(pos, pos + Vector3.new(lx, 0, lz))
	hrp.AssemblyLinearVelocity = Vector3.zero
	plr:SetAttribute("Map", mapName)
	plr:SetAttribute("Spawn", mapName .. "|" .. x .. "|" .. z .. "|" .. lx .. "|" .. lz)
end
-- kind: "fade" | "ride"(a→b층) | "stairs"("up"/"down")
local function travel(plr, dest, x, z, lx, lz, kind, a, b, after)
	if busy[plr] then return end
	busy[plr] = true
	local dur = 0.55
	if kind == "ride" then
		dur = 0.45 + (math.abs(b - a) + 1) * 0.17 + 0.6
	elseif kind == "stairs" then
		dur = 0.45 + 16 * 0.19 + 0.4
	end
	Fx:FireClient(plr, kind, a, b)
	task.spawn(function()
		task.wait(dur)
		placeAt(plr, dest, x, z, lx, lz)
		Fx:FireClient(plr, "done")
		task.wait(1)
		busy[plr] = nil
		if after then after(plr) end
	end)
end

local questOn = {}
local function giveQuest(plr)
	if questOn[plr] then return end
	questOn[plr] = true
	Quest:FireClient(plr, true)
end

---------------------------------------------------------------- 방 만들기 공통
local function room(map, W, D, H, floorColor, floorMat, wallColor, wallMat, ceilColor)
	P(map, W + 2, 0.6, D + 2, W / 2, -0.3, D / 2, floorColor, floorMat)
	P(map, W + 1, H, 0.5, W / 2, H / 2, -0.25, wallColor, wallMat)
	P(map, W + 1, H, 0.5, W / 2, H / 2, D + 0.25, wallColor, wallMat)
	P(map, 0.5, H, D, -0.25, H / 2, D / 2, wallColor, wallMat)
	P(map, 0.5, H, D, W + 0.25, H / 2, D / 2, wallColor, wallMat)
	P(map, W + 1, 0.5, D + 1, W / 2, H + 0.25, D / 2, ceilColor, MAT.SmoothPlastic)
end
local function inspect(map, cx, cy, cz, obj, lines, dist)
	local a = deco(P(map, 0.5, 0.5, 0.5, cx, cy, cz, C("#000000"), nil, 1))
	prompt(a, "조사", obj, function(plr) say(plr, "", lines) end, dist or 9)
	return a
end
local function elevatorDoors(map, cx, cz, floorLabel, accent, facing) -- facing: 1 = 북쪽(-z)을 바라봄(남쪽 벽), -1 = 남쪽을 바라봄
	local f = facing
	local frame = P(map, 4.6, 3.9, 0.5, cx, 1.95, cz, C("#12161b"), MAT.Metal)
	glow(map, 4.2, 0.1, 0.52, cx, 3.95, cz, C("#d9a21b"))
	local disp = P(map, 3.4, 0.8, 0.1, cx, 3.45, cz - f * 0.28, C("#05080b"))
	disp.CanCollide = false
	label(disp, f == 1 and Enum.NormalId.Front or Enum.NormalId.Back, floorLabel, accent, C("#05080b"))
	local dl = P(map, 1.7, 2.9, 0.12, cx - 0.86, 1.45, cz - f * 0.22, C("#59636d"), MAT.Metal)
	local dr = P(map, 1.7, 2.9, 0.12, cx + 0.86, 1.45, cz - f * 0.22, C("#59636d"), MAT.Metal)
	return { dl = dl, dr = dr, x0l = dl.Position.X, x0r = dr.Position.X, frame = frame }
end
local function openDoors(ed)
	TS:Create(ed.dl, TweenInfo.new(0.5), { Position = Vector3.new(ed.x0l - 1.55 * S, ed.dl.Position.Y, ed.dl.Position.Z) }):Play()
	TS:Create(ed.dr, TweenInfo.new(0.5), { Position = Vector3.new(ed.x0r + 1.55 * S, ed.dr.Position.Y, ed.dr.Position.Z) }):Play()
	task.delay(3.2, function()
		TS:Create(ed.dl, TweenInfo.new(0.5), { Position = Vector3.new(ed.x0l, ed.dl.Position.Y, ed.dl.Position.Z) }):Play()
		TS:Create(ed.dr, TweenInfo.new(0.5), { Position = Vector3.new(ed.x0r, ed.dr.Position.Y, ed.dr.Position.Z) }):Play()
	end)
end

-- 사람 모양 NPC(고정 포즈). 앞쪽은 +z 방향.
local function figure(map, cx, cz, yaw, o)
	local m = Instance.new("Model")
	m.Name = o.name or "직원"
	m.Parent = map.model
	local root = CFrame.new(map.o + Vector3.new(cx * S, 0, cz * S)) * CFrame.Angles(0, yaw, 0)
	local function bp(sx, sy, sz, x, y, z, color, mat)
		local p = Instance.new("Part")
		p.Anchored = true
		p.Size = Vector3.new(sx, sy, sz)
		p.CFrame = root * CFrame.new(x, y, z)
		p.Color = color
		p.Material = mat or MAT.SmoothPlastic
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Parent = m
		return p
	end
	local dy = o.sit and -0.4 or 0
	if o.sit then
		for _, sx in ipairs({ -0.5, 0.5 }) do
			bp(0.95, 0.9, 1.9, sx, 1.95, 0.9, o.bottom)
			bp(0.95, 1.9, 0.9, sx, 0.95, 1.7, o.bottom)
			bp(1.1, 0.3, 1.2, sx, 0.15, 1.8, C("#07080c"))
		end
	else
		bp(0.95, 2.4, 1, -0.5, 1.2, 0, o.bottom)
		bp(0.95, 2.4, 1, 0.5, 1.2, 0, o.bottom)
		bp(1.1, 0.3, 1.2, -0.5, 0.15, 0.1, C("#07080c"))
		bp(1.1, 0.3, 1.2, 0.5, 0.15, 0.1, C("#07080c"))
	end
	local torso = bp(2.2, 2.3, 1.2, 0, 3.55 + dy, 0, o.top)
	bp(0.8, 2.2, 0.9, -1.55, 3.55 + dy, 0, o.top)
	bp(0.8, 2.2, 0.9, 1.55, 3.55 + dy, 0, o.top)
	bp(0.7, 0.7, 0.8, -1.55, 2.3 + dy, 0, o.skin)
	bp(0.7, 0.7, 0.8, 1.55, 2.3 + dy, 0, o.skin)
	bp(0.7, 1.9, 0.12, 0, 3.7 + dy, 0.62, o.shirt or C("#e8f0ff"))
	local head = bp(1.5, 1.6, 1.4, 0, 5.3 + dy, 0, o.skin)
	bp(1.62, 0.7, 1.52, 0, 6.0 + dy, -0.02, o.hair)
	bp(1.62, 1.3, 0.4, 0, 5.4 + dy, -0.55, o.hair)
	bp(1.62, 0.5, 0.35, 0, 6.0 + dy, 0.55, o.hair)
	local eyeC = C("#10131c")
	bp(0.28, 0.4, 0.1, -0.35, 5.3 + dy, 0.72, eyeC)
	bp(0.28, 0.4, 0.1, 0.35, 5.3 + dy, 0.72, eyeC)
	if o.glasses then
		bp(0.55, 0.5, 0.1, -0.35, 5.3 + dy, 0.74, o.glasses, MAT.Glass).Transparency = 0.35
		bp(0.55, 0.5, 0.1, 0.35, 5.3 + dy, 0.74, o.glasses, MAT.Glass).Transparency = 0.35
		bp(0.3, 0.1, 0.1, 0, 5.35 + dy, 0.74, o.glasses)
	end
	if o.fur then
		bp(2.9, 0.6, 1.6, 0, 4.75 + dy, 0, o.fur, MAT.Fabric)
		bp(0.9, 0.6, 1.2, -1.55, 4.6 + dy, 0, o.fur, MAT.Fabric)
		bp(0.9, 0.6, 1.2, 1.55, 4.6 + dy, 0, o.fur, MAT.Fabric)
	end
	m.PrimaryPart = torso
	return m, root
end
local function setPose(model, base, dx, dz, yaw, bob) -- 걷는 NPC 이동
	model:PivotTo(CFrame.new(base.Position + Vector3.new(dx, bob or 0, dz)) * CFrame.Angles(0, yaw, 0))
end

---------------------------------------------------------------- 회장실(100F)
local function buildOffice()
	local map = newMap("office")
	local W, D, H = 48, 34, 5.2
	room(map, W, D, H, C("#5a3a22"), MAT.WoodPlanks, C("#1b1511"), MAT.Wood, C("#120e0b"))
	-- 카펫
	P(map, 20, 0.06, 12, 24, 0.03, 17, C("#10281f"), MAT.Fabric).CanCollide = false
	for _, e in ipairs({ { 20, 0.2, 24, 11 }, { 20, 0.2, 24, 23 }, { 0.2, 12, 14, 17 }, { 0.2, 12, 34, 17 } }) do
		deco(P(map, e[1], 0.07, e[2], e[3], 0.04, e[4], GOLD, MAT.SmoothPlastic))
	end
	local dia = deco(P(map, 2.4, 0.08, 2.4, 24, 0.05, 17, GOLD, MAT.SmoothPlastic))
	dia.CFrame = dia.CFrame * CFrame.Angles(0, math.rad(45), 0)
	-- 창문(야경)
	for _, wx in ipairs({ 21, 30 }) do
		deco(P(map, 3, 2.2, 0.1, wx, 2.5, 0.05, C("#071229"), MAT.Neon))
		for i = 1, 24 do
			deco(P(map, 0.07, 0.07, 0.06, wx - 1.4 + math.random() * 2.8, 1.5 + math.random() * 2.0, 0.12, math.random() < 0.7 and C("#ffd36a") or C("#bfe4ff"), MAT.Neon))
		end
		deco(P(map, 3.2, 0.12, 0.2, wx, 3.7, 0.12, C("#0a0c10"), MAT.Metal))
		deco(P(map, 3.2, 0.12, 0.2, wx, 1.35, 0.12, C("#0a0c10"), MAT.Metal))
	end
	inspect(map, 21, 1.6, 2.4, "창문", { "창밖으로 리바이어던의 야경이 펼쳐진다.", "저 불빛 하나하나가 내가 지켜야 할 것들이다." })
	inspect(map, 30, 1.6, 2.4, "창문", { "창밖은 고요하다. 이 고요를 유지하는 것이 내 일이다." })
	-- 현수막
	deco(P(map, 2.4, 3, 0.08, 24, 2.7, 0.06, C("#0d1c3d"), MAT.Fabric))
	local ring = deco(P(map, 1.4, 1.4, 0.06, 24, 3.0, 0.12, GOLD, MAT.Neon))
	ring.Shape = Enum.PartType.Cylinder
	ring.Orientation = Vector3.new(0, 90, 0)
	inspect(map, 24, 1.6, 2.2, "현수막", { "리바이어던의 문장이 수놓인 내 현수막이다.", "의자에 앉으면 정확히 이 아래가 된다." })
	-- 책장
	local bookLines = { "빽빽하게 꽂힌 서적들이다. 전부 내가 읽은 책이다.", "법전, 지도, 역사서. 읽지 않은 책은 한 권도 없다." }
	for _, bx in ipairs({ 4.5, 9.5, 42.5 }) do
		P(map, 4, 3.4, 0.9, bx, 1.7, 0.8, C("#2a190d"), MAT.Wood)
		for r = 0, 3 do
			for i = 0, 11 do
				local col = ({ "#7a2a2a", "#2a4a7a", "#c9a94c", "#3a6a4a", "#5a3a7a", "#8a6a3a" })[(i + r) % 6 + 1]
				deco(P(map, 0.22, 0.6 + math.random() * 0.2, 0.5, bx - 1.7 + i * 0.31, 0.65 + r * 0.8, 1.3, C(col)))
			end
		end
		inspect(map, bx, 1.6, 2.4, "책장", bookLines)
	end
	-- 서고 · 금고 · 언월도 · 지도
	for i = 0, 3 do
		P(map, 0.9, 2.4, 2.4, 0.7, 1.2, 9 + i * 2.8, C("#20150c"), MAT.Wood)
	end
	inspect(map, 2.6, 1.4, 13.5, "서고", { "벽을 따라 문서 보관함이 늘어서 있다. 전부 내 손을 거친 문서들이다." })
	local safe = P(map, 1.6, 1.8, 1.4, 32, 0.9, 2, C("#1c2128"), MAT.Metal)
	deco(P(map, 0.5, 0.5, 0.1, 32, 1.1, 2.75, GOLD, MAT.Metal))
	inspect(map, 32, 1.4, 3.1, "금고", { "내 금고다. 다이얼은 굳게 잠겨 있다. 열 수 있는 사람은 나뿐이다." })
	P(map, 1.8, 0.2, 0.6, 14.5, 1.0, 1.6, C("#2a190d"), MAT.Wood)
	local gd = P(map, 0.12, 0.12, 3.8, 14.5, 1.9, 1.6, C("#6e4a28"), MAT.Wood)
	gd.CFrame = gd.CFrame * CFrame.Angles(math.rad(90), 0, 0)
	deco(P(map, 0.9, 0.05, 0.3, 14.5, 3.7, 1.6, C("#dfe6ec"), MAT.Metal))
	inspect(map, 14.5, 1.6, 3.4, "언월도 거치대", { "내 의장용 언월도가 거치대에 걸려 있다.", "지금 들고 있는 것과 모양이 같다. 날은 잘 서 있고, 먼지 한 톨 없게 내가 직접 관리한다." })
	deco(P(map, 3.4, 2, 0.08, 36, 2.7, 0.06, C("#0e2a30"), MAT.SmoothPlastic))
	for i = 1, 7 do
		deco(P(map, 0.18, 0.18, 0.06, 34.8 + math.random() * 2.4, 2.1 + math.random() * 1.2, 0.12, i % 3 == 0 and C("#c0392b") or GOLD, MAT.Neon))
	end
	inspect(map, 36, 1.6, 2.6, "벽 지도", { "벽면 지도에 등록된 국가들의 위치가 표시되어 있다.", "붉은 표식은 멸망한 국가다. 전부 내가 기록해 두었다." })
	-- 책상 · 컴퓨터 · 의자
	P(map, 7, 0.2, 2.4, 24, 1.0, 14.4, C("#3a2414"), MAT.Wood)
	P(map, 6.6, 0.9, 2.0, 24, 0.45, 14.4, C("#24150a"), MAT.Wood)
	for _, mx in ipairs({ 21.5, 24, 26.5 }) do
		P(map, 1.5, 0.9, 0.08, mx, 1.75, 13.6, C("#07090c"), MAT.Metal)
		glow(map, 1.36, 0.76, 0.06, mx, 1.75, 13.66, C("#7ad8ff")).Transparency = 0.35
		P(map, 0.2, 0.5, 0.2, mx, 1.2, 13.6, C("#07090c"), MAT.Metal)
	end
	P(map, 1.4, 0.06, 0.4, 24, 1.13, 15, C("#0a0c10"), MAT.Metal)
	P(map, 0.9, 0.1, 0.5, 26.4, 1.12, 14.9, GOLD, MAT.Metal)
	inspect(map, 24, 1.6, 15.6, "책상", { "내 결재 서류가 가지런히 쌓여 있다. 급한 건 이미 처리해 두었다.", "책상 위의 명패에는 ‘설립자’라고 적혀 있다. 내 자리다." })
	inspect(map, 21.5, 1.6, 15.0, "컴퓨터", { "내 컴퓨터다. 화면에는 리바이어던 전역의 보고서가 쉴 새 없이 올라온다.", "등급 갱신, 등록 신청, 기억 에너지 보급 현황… 전부 한눈에 들어온다.", "지금은 건드릴 것이 없다. 내가 보지 않는 동안에도 조직은 돌아간다." })
	P(map, 1.1, 0.14, 1.1, 24, 0.55, 12.3, C("#14161c"), MAT.Fabric)
	P(map, 1.1, 1.2, 0.14, 24, 1.2, 11.7, C("#14161c"), MAT.Fabric)
	-- 지구본 · 소파 · 탁자 · 의자
	P(map, 0.2, 0.9, 0.2, 30.6, 0.45, 6.6, C("#3a2414"), MAT.Wood)
	ball(map, 1.5, 30.6, 1.4, 6.6, C("#1c4f8f"), MAT.SmoothPlastic)
	deco(P(map, 1.7, 0.06, 1.7, 30.6, 1.4, 6.6, GOLD, MAT.Metal))
	inspect(map, 30.6, 1.6, 7.6, "지구본", { "세계 지도가 새겨진 내 지구본이다.", "소버린 아일랜드에 작은 불빛이 켜져 있다. 내가 켜 둔 것이다." })
	P(map, 4.4, 0.5, 1.4, 7, 0.4, 20, C("#5b1f1f"), MAT.Fabric)
	P(map, 4.4, 1.0, 0.4, 7, 1.0, 20.7, C("#5b1f1f"), MAT.Fabric)
	inspect(map, 7, 1.2, 19.8, "소파", { "손님을 맞이하는 내 자리다. 쿠션은 한 치 흐트러짐 없이 놓여 있다." })
	P(map, 2, 0.12, 1.2, 7, 0.55, 23.6, C("#3a2414"), MAT.Wood)
	P(map, 0.15, 0.55, 0.15, 7, 0.28, 23.6, C("#1b1511"), MAT.Wood)
	deco(P(map, 0.25, 0.14, 0.25, 6.7, 0.69, 23.6, C("#f2f2f2"), MAT.SmoothPlastic))
	deco(P(map, 0.25, 0.14, 0.25, 7.3, 0.69, 23.6, C("#f2f2f2"), MAT.SmoothPlastic))
	inspect(map, 7, 1.2, 23.6, "탁자", { "찻잔 두 개가 놓여 있다. 내가 내온 차다. 아직 따뜻하다." })
	for _, a in ipairs({ { 3.2, 22 }, { 10.8, 22 } }) do
		P(map, 1.4, 0.5, 1.4, a[1], 0.4, a[2], C("#2a3a2a"), MAT.Fabric)
		P(map, 1.4, 1.0, 0.3, a[1], 1.0, a[2] + 0.6, C("#2a3a2a"), MAT.Fabric)
		inspect(map, a[1], 1.2, a[2], "안락의자", { "푹신한 안락의자다. 지금은 앉을 틈이 없다." })
	end
	-- 회의 탁자
	P(map, 8, 0.18, 3.6, 40, 1.0, 19, C("#2a190d"), MAT.Wood)
	P(map, 1.4, 0.95, 1.4, 40, 0.5, 19, C("#1b1511"), MAT.Wood)
	for i = 0, 2 do
		for _, dz in ipairs({ 16.6, 21.4 }) do
			P(map, 0.9, 0.9, 0.9, 37.6 + i * 2.4, 0.5, dz, C("#14161c"), MAT.Fabric)
		end
	end
	P(map, 1.0, 1.0, 1.0, 35, 0.5, 19, C("#14161c"), MAT.Fabric)
	inspect(map, 40, 1.5, 19, "회의 탁자", { "내가 사령관들을 앉히는 긴 회의 탁자다. 자리는 이미 정해 두었다.", "탁자 가운데의 투영 장치는 꺼져 있다. 내가 호출하면 켜질 것이다." }, 12)
	inspect(map, 35, 1.2, 19, "상석", { "내 자리, 상석이다. 가장 안쪽, 문이 잘 보이는 자리." })
	-- 수족관 · 차 준비대
	P(map, 2.2, 2.4, 4, 44, 1.2, 8.5, C("#0a2a4a"), MAT.Glass).Transparency = 0.5
	glow(map, 2.0, 0.1, 3.8, 44, 2.4, 8.5, C("#2b8bff")).Transparency = 0.2
	lamp(map, 44, 2.2, 8.5, C("#3a9bff"), 1.2, 18)
	for i = 1, 6 do
		deco(P(map, 0.3, 0.14, 0.14, 43.4 + math.random() * 1.0, 0.8 + math.random() * 1.2, 7 + math.random() * 3, C("#ff9a3a"), MAT.Neon))
	end
	inspect(map, 44, 1.4, 8.5, "수족관", { "푸른 물속에서 물고기들이 느리게 헤엄친다. 보고 있으면 생각이 정리된다." })
	P(map, 2, 1.0, 1, 44.2, 0.5, 14, C("#2a190d"), MAT.Wood)
	inspect(map, 44.2, 1.2, 14, "차 준비대", { "내 차가 준비되어 있다. 마실 시간은 없지만." })
	-- 화분 · 목인형
	for _, pl in ipairs({ { 1.8, 4.2 }, { 46.2, 4.2 }, { 1.8, 31 }, { 46.2, 31 }, { 11.5, 17 }, { 32, 14.5 } }) do
		cylinder(map, 0.7, 0.6, pl[1], 0.3, pl[2], C("#4a2a18"), MAT.Concrete)
		ball(map, 1.1, pl[1], 1.1, pl[2], C("#1f5a34"), MAT.Grass)
		inspect(map, pl[1], 1.0, pl[2], "화분", { "잎이 윤기 있게 반짝인다. 내가 아끼는 화분이다. 누군가 매일 돌보고 있다." }, 7)
	end
	cylinder(map, 0.5, 2.0, 5.8, 1.1, 27.2, C("#6e4a28"), MAT.Wood)
	P(map, 0.2, 0.2, 1.4, 5.8, 1.5, 27.2, C("#6e4a28"), MAT.Wood)
	inspect(map, 5.8, 1.4, 27.2, "목인형", { "내 언월도 연습용 목인형이다.", "베인 자국이 깊다. 한 곳에 겹쳐서, 같은 각도로 수없이 베었다." })
	-- 문(남쪽)
	P(map, 2.2, 3.2, 0.3, 24, 1.6, D - 0.15, C("#2a190d"), MAT.Wood)
	deco(P(map, 0.12, 0.4, 0.14, 24.7, 1.5, D - 0.35, PALE, MAT.Metal))
	local door = deco(P(map, 2.6, 3.4, 0.4, 24, 1.7, D - 0.2, C("#000000"), nil, 1))
	prompt(door, "나가기", "문", function(plr)
		ask(plr, "복도로 나갈까?", function(p2)
			travel(p2, "hall", SPAWN.hall[1], SPAWN.hall[2], 0, 1, "fade", 100, 100)
		end, "…조금 더 둘러보자.")
	end, 12)
	-- 조명
	for _, lp in ipairs({ { 12, 8 }, { 36, 8 }, { 12, 26 }, { 36, 26 }, { 24, 17 } }) do
		glow(map, 2.4, 0.08, 0.5, lp[1], H - 0.05, lp[2], C("#ffe2a8"))
		lamp(map, lp[1], H - 0.6, lp[2], C("#ffd9a0"), 1.4, 70)
	end
	local sp = Instance.new("SpawnLocation")
	sp.Name = "OfficeSpawn"
	sp.Anchored = true
	sp.Size = Vector3.new(6, 1, 6)
	sp.Position = map.o + Vector3.new(24 * S, 0.5, 28 * S)
	sp.Transparency = 1
	sp.CanCollide = false
	sp.Neutral = true
	sp.Parent = map.model
	return map
end

---------------------------------------------------------------- 복도 · 엘리베이터 · 계단실
local hallElev
local function buildHall()
	local map = newMap("hall")
	local X0, X1, Z0, Z1, H, cx = 3, 12, 4, 40, 4.4, 7.5
	local stone = C("#262d36")
	P(map, X1 - X0 + 1, 0.6, Z1 - Z0 + 1, cx, -0.3, 22, stone, MAT.DiamondPlate)
	for _, x in ipairs({ X0 + 0.14, X1 - 0.14 }) do
		for z = Z0, Z1 - 1, 1.5 do
			deco(P(map, 0.28, 0.03, 0.75, x, 0.02, z + 0.4, C("#d9a21b"), MAT.SmoothPlastic))
			deco(P(map, 0.28, 0.03, 0.75, x, 0.02, z + 1.15, C("#14110a"), MAT.SmoothPlastic))
		end
	end
	for z = Z0 + 1, Z1 - 1, 1.8 do
		deco(P(map, 0.12, 0.03, 0.6, cx, 0.03, z, GOLD, MAT.Neon))
	end
	local wc = C("#1d242c")
	P(map, 0.5, H, Z1 - Z0 + 1, X0 - 0.25, H / 2, 22, wc, MAT.Metal)
	P(map, 0.5, H, Z1 - Z0 + 1, X1 + 0.25, H / 2, 22, wc, MAT.Metal)
	P(map, X1 - X0 + 1, H, 0.5, cx, H / 2, Z0 - 0.25, wc, MAT.Metal)
	P(map, X1 - X0 + 1, H, 0.5, cx, H / 2, Z1 + 0.25, wc, MAT.Metal)
	P(map, X1 - X0 + 1, 0.5, Z1 - Z0 + 1, cx, H + 0.25, 22, C("#0e1216"), MAT.Metal)
	for z = Z0 + 3, Z1 - 1, 5 do
		glow(map, 3.4, 0.1, 0.5, cx, H - 0.06, z, C("#cfe0ff"))
		lamp(map, cx, H - 0.6, z, C("#bcd0ff"), 1.2, 44)
	end
	for _, x in ipairs({ X0 + 0.45, X1 - 0.45 }) do
		cylinder(map, 0.3, H, x, H / 2, 22 - 17, C("#3a4651"), MAT.Metal).Size = Vector3.new((H) * S, 0.3 * S, 0.3 * S)
		P(map, 0.1, 0.14, Z1 - Z0, x, H - 0.8, 22, C("#2a323b"), MAT.Metal)
	end
	-- 북쪽: 회장실 문
	P(map, 4.4, 3.5, 0.2, cx, 1.75, Z0 + 0.1, C("#07090c"), MAT.Metal)
	P(map, 2, 3.2, 0.16, cx - 1.05, 1.6, Z0 + 0.2, C("#27303a"), MAT.Metal)
	P(map, 2, 3.2, 0.16, cx + 1.05, 1.6, Z0 + 0.2, C("#27303a"), MAT.Metal)
	local sign = P(map, 2.6, 0.5, 0.06, cx, 3.75, Z0 + 0.22, C("#05080b"))
	label(sign, Enum.NormalId.Back, "CHAIRMAN · 100F", GOLD, C("#05080b")).Parent = sign
	local od = deco(P(map, 4.6, 3.4, 1.6, cx, 1.7, Z0 + 0.9, C("#000000"), nil, 1))
	prompt(od, "들어가기", "회장실 문", function(plr)
		ask(plr, "회장실로 돌아갈까?", function(p2)
			travel(p2, "office", SPAWN.office[1], SPAWN.office[2], 0, -1, "fade", 100, 100)
		end, "…조금 더 둘러보자.")
	end, 14)
	-- 남쪽: 엘리베이터 + 호출 단말 + 계단실 문
	local ed = elevatorDoors(map, cx, Z1 - 0.25, "100F", C("#ffb84a"), 1)
	hallElev = ed
	local ep = deco(P(map, 5, 3.4, 1.6, cx, 1.7, Z1 - 1.0, C("#000000"), nil, 1))
	prompt(ep, "엘리베이터 호출", "엘리베이터", function(plr)
		openDoors(ed)
		Elev:FireClient(plr, 100)
	end, 14)
	deco(P(map, 0.4, 0.9, 0.12, X0 + 0.35, 1.2, Z1 - 1.4, C("#0b0e12"), MAT.Metal))
	glow(map, 0.12, 0.12, 0.05, X0 + 0.35, 1.45, Z1 - 1.33, C("#ffb84a"))
	-- 계단실 문(엘리베이터 바로 옆)
	P(map, 1.8, 3.2, 0.2, 10.9, 1.6, Z1 - 0.1, C("#12161b"), MAT.Metal)
	P(map, 1.4, 2.7, 0.12, 10.9, 1.35, Z1 - 0.2, C("#3a444f"), MAT.Metal)
	deco(P(map, 0.1, 0.5, 0.06, 10.5, 1.25, Z1 - 0.3, GOLD, MAT.Metal))
	local ss = P(map, 1.5, 0.4, 0.06, 10.9, 3.0, Z1 - 0.22, C("#04170c"))
	ss.CanCollide = false
	label(ss, Enum.NormalId.Front, "STAIRS ▲", C("#44e08a"), C("#04170c"))
	lamp(map, 10.9, 2.6, Z1 - 1, C("#44e08a"), 1.2, 20)
	local sp = deco(P(map, 2.4, 3.2, 1.6, 10.9, 1.6, Z1 - 1.0, C("#000000"), nil, 1))
	prompt(sp, "조사", "계단실 문", function(plr)
		ask(plr, "계단으로 옥상에 올라갈까?", function(p2)
			travel(p2, "roof", 12, 12, 0, 1, "stairs", "up", nil)
			task.delay(6, function()
				say(p2, "", { "…옥상이다. 난간이 없다.", "매끄러운 흰 바닥과 하늘뿐이다. 그리고 저 멀리, 꺾인 탑이 하나 보인다." })
			end)
		end, "…나중에 올라가 보자.")
	end, 12)
	-- 옆 방 문(잠김)
	local sides = {
		{ X0, 9, "LAB-101", { "잠긴 방이다. 이 층의 방은 전부 내 소유다.", "지금은 열 일이 없다." }, 1 },
		{ X0, 17, "ARCH-102", { "기록 보관실이다. 필요한 문서는 이미 내 책상에 올라와 있다." }, 1 },
		{ X0, 25, "SRV-103", { "서버실이다. 안쪽에서 낮은 팬 소리가 들린다. 조직의 숨소리다." }, 1 },
		{ X1, 9, "OPS-201", { "작전실이다. 호출 전까지는 비어 있다." }, -1 },
		{ X1, 17, "ARC-202", { "잠겨 있다. 내가 허락하지 않은 사람은 들어올 수 없다." }, -1 },
		{ X1, 25, "STO-203", { "보급 창고다. 목록은 내가 직접 서명했다." }, -1 },
	}
	for _, s in ipairs(sides) do
		local x, z, name, txt, dir = s[1], s[2], s[3], s[4], s[5]
		P(map, 0.16, 3.0, 2.2, x + dir * 0.08, 1.5, z, C("#06080a"), MAT.Metal)
		P(map, 0.12, 2.7, 1.9, x + dir * 0.16, 1.35, z, C("#27303a"), MAT.Metal)
		local lb = P(map, 0.06, 0.3, 1.2, x + dir * 0.2, 2.9, z, C("#05080b"))
		lb.CanCollide = false
		label(lb, dir == 1 and Enum.NormalId.Right or Enum.NormalId.Left, name, C("#ffb84a"), C("#05080b"))
		local a = deco(P(map, 1.6, 3, 2.4, x + dir * 0.9, 1.5, z, C("#000000"), nil, 1))
		prompt(a, "조사", name, function(plr) say(plr, "", txt) end, 9)
	end
	-- 소화기 · 보급 상자
	cylinder(map, 0.26, 0.5, X1 - 0.5, 0.35, 21.6, C("#a3241c"), MAT.Metal)
	inspect(map, X1 - 1.2, 1, 21.6, "소화기", { "소화기다. 쓸 일이 없기를 바란다." }, 7)
	P(map, 1.8, 1.2, 1.2, X0 + 1.2, 0.6, 30.6, C("#2a313a"), MAT.Metal)
	deco(P(map, 1.8, 0.2, 1.2, X0 + 1.2, 0.85, 30.6, C("#d9a21b"), MAT.SmoothPlastic))
	inspect(map, X0 + 2.6, 1, 30.6, "보급 상자", { "보급 상자다. 내가 직접 서명한 봉인이 그대로 붙어 있다." }, 8)
	return map
end

---------------------------------------------------------------- 95층
local function buildF95()
	local map = newMap("f95")
	local W, D, H = 44, 34, 5.6
	local navy, edge, cy = C("#081a42"), C("#5d7bff"), C("#38d6ff")
	room(map, W, D, H, navy, MAT.Metal, C("#02060f"), MAT.Metal, C("#01040c"))
	for _, z in ipairs({ 12.6, 19.6, 26.4 }) do glow(map, W - 4, 0.02, 0.07, W / 2, 0.02, z, cy) end
	for _, x in ipairs({ 9, 17, 27, 35 }) do glow(map, 0.07, 0.02, D - 10, x, 0.02, 17.5, cy) end
	-- 심해 전망창(북쪽 벽)
	local panes = 7
	local pw = (W - 2) / panes
	for i = 0, panes - 1 do
		local x = 1 + pw * (i + 0.5)
		deco(P(map, pw - 0.5, 3.8, 0.1, x, 3, 0.1, C("#031a5e"), MAT.Neon))
		deco(P(map, pw - 0.3, 0.14, 0.2, x, 4.95, 0.2, C("#102b6e"), MAT.Metal))
		deco(P(map, pw - 0.3, 0.14, 0.2, x, 1.1, 0.2, C("#102b6e"), MAT.Metal))
		deco(P(map, 0.14, 3.9, 0.2, x + pw / 2, 3, 0.2, C("#102b6e"), MAT.Metal))
		for k = 1, 3 do
			deco(P(map, 0.16, 0.1, 0.06, x - 0.9 + math.random() * 1.8, 1.6 + math.random() * 2.6, 0.18, k == 1 and C("#8fd4ff") or C("#1a4fb0"), MAT.Neon))
		end
	end
	-- 조명
	for _, lp in ipairs({ { 8, 8 }, { 8, 20 }, { 22, 8 }, { 36, 8 }, { 36, 20 }, { 22, 27 }, { 8, 28 }, { 36, 28 }, { 22, 20 } }) do
		glow(map, 2.6, 0.08, 0.5, lp[1], H - 0.05, lp[2], C("#9ab4ff"))
		lamp(map, lp[1], H - 0.6, lp[2], C("#6a8cff"), 1.6, 52)
	end
	-- 책상 12개 + 의자
	local seats = {}
	local function desk(x, z)
		P(map, 5, 0.12, 2, x + 2.5, 0.8, z + 1, C("#0a1d4a"), MAT.Metal)
		P(map, 4.8, 0.7, 1.8, x + 2.5, 0.4, z + 1, C("#061230"), MAT.Metal)
		glow(map, 5, 0.05, 0.06, x + 2.5, 0.8, z + 2.0, edge)
		for _, dx in ipairs({ 1.9, 3.9 }) do
			P(map, 1.5, 0.8, 0.06, x + dx, 1.55, z + 0.35, C("#02050c"), MAT.Metal)
			glow(map, 1.4, 0.7, 0.04, x + dx, 1.55, z + 0.4, C("#4a8cff")).Transparency = 0.3
		end
		P(map, 0.8, 0.12, 0.8, x + 2.4, 0.55, z + 2.5, C("#050d28"), MAT.Fabric)
		P(map, 0.8, 0.9, 0.12, x + 2.4, 1.0, z + 2.9, C("#050d28"), MAT.Fabric)
		table.insert(seats, { x + 2.4, z + 2.3 })
	end
	for _, x in ipairs({ 3, 10 }) do for _, z in ipairs({ 8, 15, 22 }) do desk(x, z) end end
	for _, x in ipairs({ 29, 36 }) do for _, z in ipairs({ 8, 15, 22 }) do desk(x, z) end end
	-- 홀로그램 탁자
	P(map, 4, 0.2, 2.6, 22, 0.75, 15.7, C("#0a1d4a"), MAT.Metal)
	P(map, 3.6, 0.7, 2.2, 22, 0.35, 15.7, C("#02060f"), MAT.Metal)
	local r1 = cylinder(map, 2.0, 0.05, 22, 0.88, 15.7, cy, MAT.Neon)
	r1.Orientation = Vector3.new(0, 0, 90)
	deco(r1)
	local holo = ball(map, 1.1, 22, 1.9, 15.7, cy, MAT.ForceField)
	deco(holo)
	lamp(map, 22, 1.9, 15.7, cy, 2, 34)
	table.insert(map.upd, function(t) holo.CFrame = CFrame.new(holo.Position) * CFrame.Angles(math.sin(t) * 0.3, t * 1.2, 0) end)
	inspect(map, 22, 1.2, 17.5, "홀로그램 탁자", { "홀로그램 탁자다. 리바이어던 전역의 지도가 천천히 회전하고 있다." }, 9)
	-- 서버 랙 · 복사기 · 정수기
	for _, x in ipairs({ 3, 5, 7, 36, 38, 40 }) do
		P(map, 1.6, 2.6, 1, x + 0.8, 1.3, 6.8, C("#02050e"), MAT.Metal)
		for k = 0, 7 do
			deco(P(map, 0.12, 0.08, 0.06, x + 0.3 + (k % 4) * 0.35, 0.4 + math.floor(k / 4) * 1.0 + math.random() * 0.2, 6.25, k % 2 == 0 and cy or C("#ffffff"), MAT.Neon))
		end
	end
	inspect(map, 5, 1.4, 8.2, "서버 랙", { "서버 랙이다. 안쪽에서 낮은 팬 소리가 난다." }, 9)
	inspect(map, 38, 1.4, 8.2, "서버 랙", { "서버 랙이다. 안쪽에서 낮은 팬 소리가 난다." }, 9)
	P(map, 2, 1.4, 1.2, 16.6, 0.7, 6.8, C("#102552"), MAT.Metal)
	P(map, 1.6, 0.06, 0.8, 16.6, 1.45, 6.8, C("#e8efff"))
	inspect(map, 16.6, 1.4, 8.2, "복사기", { "복사기다. 종이가 쉴 새 없이 나온다." }, 8)
	cylinder(map, 0.8, 1.4, 27, 0.7, 6.8, C("#102552"), MAT.Metal)
	cylinder(map, 0.64, 0.6, 27, 1.7, 6.8, C("#5daaff"), MAT.Glass).Transparency = 0.5
	inspect(map, 27, 1.4, 8.2, "정수기", { "정수기다. 물은 심해에서 끌어올려 걸러낸 것이다." }, 8)
	for _, c in ipairs({ { 2.2, 28.4 }, { 41.2, 28.4 }, { 2.2, 5.6 } }) do
		cylinder(map, 0.8, 0.5, c[1], 0.25, c[2], C("#0a1d4a"), MAT.Metal)
		for i = 0, 5 do
			cylinder(map, 0.12, 0.8 + (i % 3) * 0.3, c[1] + math.cos(i * 1.2) * 0.22, 0.85 + (i % 3) * 0.15, c[2] + math.sin(i * 1.2) * 0.22, i % 2 == 1 and C("#2b8bff") or cy, MAT.Neon)
		end
		lamp(map, c[1], 1.4, c[2], cy, 1, 20)
		inspect(map, c[1], 1.2, c[2], "산호 화분", { "심해에서 가져온 산호가 은은하게 빛난다." }, 7)
	end
	-- 엘리베이터(남쪽 벽)
	local ed = elevatorDoors(map, 22, D - 0.25, "95F", edge, 1)
	local ep = deco(P(map, 5, 3.4, 1.6, 22, 1.7, D - 1.0, C("#000000"), nil, 1))
	prompt(ep, "엘리베이터 호출", "엘리베이터", function(plr)
		openDoors(ed)
		Elev:FireClient(plr, 95)
	end, 14)
	-- 직원: 앉아 일하는 7명
	local NPC = {
		{ top = C("#102552"), bottom = C("#0a0c18"), hair = C("#1a1a22"), skin = C("#f0d2b8") },
		{ top = C("#14284a"), bottom = C("#0a0c18"), hair = C("#5a3a22"), skin = C("#e8c8a8") },
		{ top = C("#0c1c3a"), bottom = C("#0a0c18"), hair = C("#8a8a96"), skin = C("#f0d2b8") },
		{ top = C("#16305e"), bottom = C("#0a0c18"), hair = C("#2a1a3a"), skin = C("#e0b898") },
		{ top = C("#102552"), bottom = C("#0a0c18"), hair = C("#0e0e12"), skin = C("#f4dcc4") },
		{ top = C("#1a2a52"), bottom = C("#0a0c18"), hair = C("#6a3a1a"), skin = C("#e8c8a8") },
	}
	for i, si in ipairs({ 1, 4, 9, 7, 5, 8, 3 }) do
		local s = seats[si]
		local o = NPC[(i + 1) % 6 + 1]
		figure(map, s[1], s[2] + 0.1, math.pi, { name = "직원", sit = true, top = o.top, bottom = o.bottom, hair = o.hair, skin = o.skin })
	end
	-- 걷는 직원 7명(통로 격자를 따라 이동)
	local LX, LY = { 9, 17, 27, 35 }, { 12.6, 19.6, 26.4 }
	for i = 0, 6 do
		local o = NPC[i % 6 + 1]
		local mdl = figure(map, 0, 0, 0, { name = "직원", top = o.top, bottom = o.bottom, hair = o.hair, skin = o.skin })
		local st = { xi = (i * 3) % 4, yi = i % 3, wait = math.random() * 2, sp = 1.4 + math.random() * 0.7, yaw = 0 }
		st.nx, st.ny = st.xi, st.yi
		st.x, st.z = LX[st.xi + 1], LY[st.yi + 1]
		local base = CFrame.new(map.o)
		table.insert(map.upd, function(t, dt)
			if st.wait > 0 then
				st.wait = st.wait - dt
			else
				local tx, tz = LX[st.nx + 1], LY[st.ny + 1]
				local dx, dz = tx - st.x, tz - st.z
				local d = math.sqrt(dx * dx + dz * dz)
				if d < 0.1 then
					st.x, st.z, st.xi, st.yi = tx, tz, st.nx, st.ny
					if math.random() < 0.5 then st.wait = 1 + math.random() * 3 end
					local opts = {}
					for _, dd in ipairs({ { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }) do
						local x2, y2 = st.xi + dd[1], st.yi + dd[2]
						if x2 >= 0 and x2 < 4 and y2 >= 0 and y2 < 3 then table.insert(opts, { x2, y2 }) end
					end
					local pk = opts[math.random(1, #opts)]
					st.nx, st.ny = pk[1], pk[2]
				else
					st.x = st.x + dx / d * st.sp * dt
					st.z = st.z + dz / d * st.sp * dt
					st.yaw = math.atan2(dx, dz)
				end
			end
			local bob = math.abs(math.sin(t * 6 + i)) * 0.15 * (st.wait > 0 and 0 or 1)
			mdl:PivotTo(CFrame.new(map.o + Vector3.new(st.x * S, bob, st.z * S)) * CFrame.Angles(0, st.yaw, 0))
		end)
	end
	-- 아비시온 크리토스
	local kr = figure(map, 22, 10.6, 0, {
		name = "아비시온 크리토스", top = C("#1d3fd6"), bottom = C("#0a0a10"), hair = C("#2f5bff"),
		skin = C("#f6e2d2"), shirt = C("#6f90ff"), glasses = C("#0b1030"), fur = C("#d9b44a"),
	})
	local ka = deco(P(map, 3, 3, 2, 22, 1.6, 11.6, C("#000000"), nil, 1))
	prompt(ka, "대화", "아비시온 크리토스", function(plr)
		if not questOn[plr] then
			say(plr, "아비시온 크리토스", { "안녕하십니까, 설립자님.", "오늘 카네히라가 여쭈어 볼께 있다고 합니다." }, giveQuest)
		else
			say(plr, "아비시온 크리토스", { "안녕하십니까, 설립자님.", "카네히라의 용건은 아직 준비 중입니다. 때가 되면 다시 말씀드리겠습니다." })
		end
	end, 12)
	return map
end

---------------------------------------------------------------- 옥상
local function strut(map, a, b, th, color, mat)
	local mid = (a + b) / 2
	local len = (b - a).Magnitude
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = Vector3.new(th * S, th * S, len)
	local dir = (b - a).Unit
	local up = math.abs(dir.Y) > 0.95 and Vector3.new(1, 0, 0) or Vector3.new(0, 1, 0)
	p.CFrame = CFrame.lookAt(mid, b, up)
	p.Color = color
	p.Material = mat or MAT.Metal
	p.Parent = map.model
	return p
end
local function buildRoof()
	local map = newMap("roof")
	local X0, X1, Z0, Z1 = 8, 48, 7, 30
	local W, D = X1 - X0, Z1 - Z0
	local cx, cz = (X0 + X1) / 2, (Z0 + Z1) / 2
	-- 별 · 아래 도시 불빛
	for i = 1, 160 do
		local a, e = math.random() * math.pi * 2, math.random() * 1.3 - 0.05
		local r = 900
		local p = Instance.new("Part")
		p.Anchored, p.CanCollide, p.CastShadow = true, false, false
		p.Size = Vector3.new(3, 3, 3)
		p.Material = MAT.Neon
		p.Color = Color3.new(1, 1, 1)
		p.Position = map.o + Vector3.new(cx * S + math.cos(a) * math.cos(e) * r, math.sin(e) * r + 200, cz * S + math.sin(a) * math.cos(e) * r)
		p.Parent = map.model
	end
	for i = 1, 260 do
		local p = Instance.new("Part")
		p.Anchored, p.CanCollide, p.CastShadow = true, false, false
		p.Size = Vector3.new(2.4, 2.4, 2.4)
		p.Material = MAT.Neon
		p.Color = math.random() < 0.7 and C("#ffc766") or C("#9ccbff")
		p.Position = map.o + Vector3.new(cx * S + (math.random() - 0.5) * 1200, -440 + math.random() * 30, cz * S + (math.random() - 0.5) * 1200)
		p.Parent = map.model
	end
	-- 난간 없는 매끄러운 흰색 바닥
	P(map, W, 0.6, D, cx, -0.3, cz, C("#f6f9fd"), MAT.SmoothPlastic)
	-- 아래로 길게 내려가는 하얀 건물 외벽
	local body = P(map, W, 110, D, cx, -55.6, cz, C("#e9eef5"), MAT.SmoothPlastic)
	body.CastShadow = false
	for k = 1, 17 do
		local y = -k * 6.2
		local ln = C("#c5cdd9")
		deco(P(map, W + 0.1, 0.12, 0.1, cx, y, Z1 + 0.03, ln))
		deco(P(map, W + 0.1, 0.12, 0.1, cx, y, Z0 - 0.03, ln))
		deco(P(map, 0.1, 0.12, D + 0.1, X0 - 0.03, y, cz, ln))
		deco(P(map, 0.1, 0.12, D + 0.1, X1 + 0.03, y, cz, ln))
	end
	for k = 0, 9 do
		local x = X0 + k * W / 9
		deco(P(map, 0.1, 100, 0.1, x, -50, Z1 + 0.03, C("#c5cdd9")))
		deco(P(map, 0.1, 100, 0.1, x, -50, Z0 - 0.03, C("#c5cdd9")))
	end
	local lip = C("#c4ccd7")
	deco(P(map, W + 0.2, 0.22, 0.2, cx, -0.11, Z1 + 0.02, lip))
	deco(P(map, W + 0.2, 0.22, 0.2, cx, -0.11, Z0 - 0.02, lip))
	deco(P(map, 0.2, 0.22, D, X0 - 0.02, -0.11, cz, lip))
	deco(P(map, 0.2, 0.22, D, X1 + 0.02, -0.11, cz, lip))
	-- 달빛
	lamp(map, cx, 30, cz, C("#aac4ff"), 0.6, 400)
	lamp(map, 28, 8, 22, C("#aac4ff"), 1.0, 200)
	-- 계단실 출입구
	P(map, 3.4, 2.8, 2.2, 12, 1.4, 9.2, C("#d4dbe5"))
	P(map, 3.5, 0.14, 2.3, 12, 2.85, 9.2, C("#ffffff"))
	P(map, 1.3, 2.2, 0.1, 12, 1.1, 10.35, C("#4a5561"), MAT.Metal)
	deco(P(map, 0.08, 0.35, 0.06, 12.45, 1.0, 10.45, GOLD, MAT.Metal))
	local hs = P(map, 1.2, 0.3, 0.06, 12, 2.4, 10.4, C("#04170c"))
	hs.CanCollide = false
	label(hs, Enum.NormalId.Back, "STAIRS ▼", C("#44e08a"), C("#04170c"))
	lamp(map, 12, 2.4, 11.2, C("#44e08a"), 1.2, 22)
	local hd = deco(P(map, 3, 3, 2.4, 12, 1.5, 11.4, C("#000000"), nil, 1))
	prompt(hd, "조사", "계단실 출입구", function(plr)
		ask(plr, "계단으로 내려갈까?", function(p2)
			travel(p2, "hall", 11.2, 38.6, 0, -1, "stairs", "down", nil)
		end, "…조금 더 있자.")
	end, 14)
	-- 고장 난 수신탑
	local tx, tz = 28, 15.4
	local function T3(x, y, z) return map.o + Vector3.new((tx + x) * S, y * S, (tz + z) * S) end
	local st, dk, rust = C("#6b7683"), C("#2a313a"), C("#6a4328")
	P(map, 3.4, 0.45, 3.4, tx, 0.22, tz, C("#9aa3b0"))
	local H1, bw, tw = 9, 1.1, 0.3
	local function pt(sx, sz, y)
		local k = bw + (tw - bw) * (y / H1)
		return T3(sx * k, y, sz * k)
	end
	local corners = { { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } }
	for _, c in ipairs(corners) do strut(map, pt(c[1], c[2], 0.45), pt(c[1], c[2], H1), 0.14, st) end
	local y, k = 0.45, 0
	while y < H1 - 0.9 do
		for i, c in ipairs(corners) do
			local n = corners[i % 4 + 1]
			strut(map, pt(c[1], c[2], y), pt(n[1], n[2], y), 0.07, dk)
			if not (k == 3 and i == 2) then
				strut(map, pt(c[1], c[2], y), pt(n[1], n[2], y + 1.5), 0.06, st)
				strut(map, pt(n[1], n[2], y), pt(c[1], c[2], y + 1.5), 0.06, st)
			end
		end
		y = y + 1.5
		k = k + 1
	end
	-- 꺾인 윗부분
	local topBase = CFrame.new(T3(0, H1, 0)) * CFrame.Angles(0, 0, -0.42)
	local function tp(x, y2, z) return (topBase * CFrame.new(x * S, y2 * S, z * S)).Position end
	for _, c in ipairs({ { -0.3, -0.3 }, { 0.3, -0.3 }, { 0.3, 0.3 }, { -0.3, 0.3 } }) do
		strut(map, tp(c[1], 0, c[2]), tp(c[1] * 0.5, 3.4, c[2] * 0.5), 0.1, st)
	end
	strut(map, tp(0, 3.4, 0), tp(0, 5.6, 0), 0.06, dk)
	strut(map, tp(-0.65, 3.7, 0), tp(0.65, 3.7, 0), 0.08, st)
	local tip = ball(map, 0.22, 0, 0, 0, C("#3a1212"), MAT.Neon)
	tip.Position = tp(0, 5.7, 0)
	-- 매달린 접시 안테나
	local dish = Instance.new("Part")
	dish.Anchored = true
	dish.Shape = Enum.PartType.Cylinder
	dish.Size = Vector3.new(0.12 * S, 1.2 * S, 1.2 * S)
	dish.CFrame = CFrame.new(T3(1.0, 6.2, 0.3)) * CFrame.Angles(0.5, 0.3, 1.9)
	dish.Color = C("#c8d0da")
	dish.Material = MAT.Metal
	dish.Parent = map.model
	-- 늘어진 케이블
	local function cable(a, b, c)
		local prev = a
		for i = 1, 10 do
			local t = i / 10
			local p = a * (1 - t) * (1 - t) + b * 2 * t * (1 - t) + c * t * t
			deco(strut(map, prev, p, 0.05, C("#101418"), MAT.Plastic))
			prev = p
		end
	end
	cable(T3(-0.2, 8.6, 0.1), T3(-2, 5, 1.2), T3(-1.9, 0.35, 1.9))
	cable(T3(0.3, 8.2, -0.2), T3(2.4, 4, -1.6), T3(2.8, 0.3, -1.2))
	-- 이음새 불꽃
	local spark = ball(map, 0.18, 0, 0, 0, C("#cfe9ff"), MAT.Neon)
	deco(spark)
	spark.Position = T3(0.6, 9.2, 0.2)
	spark.Transparency = 1
	local sl = Instance.new("PointLight")
	sl.Color = C("#aad7ff")
	sl.Range = 60
	sl.Brightness = 0
	sl.Parent = spark
	table.insert(map.upd, function(t)
		local ph = t % 5.3
		local on = ph < 0.1 or (ph > 0.22 and ph < 0.3)
		sl.Brightness = on and 8 or 0
		spark.Transparency = on and 0 or 1
	end)
	local ti = deco(P(map, 8, 4, 8, tx, 2, tz + 3.2, C("#000000"), nil, 1))
	prompt(ti, "조사", "수신탑", function(plr)
		say(plr, "", {
			"수신탑이다. 이미 고장 나 있다. 윗부분이 꺾였고, 접시 안테나는 케이블 하나에 매달려 있다.",
			"전파는 하나도 들어오지 않는다. 지금은 쓸 수 없다.",
			"언젠가 이 탑이 필요해질 것이다. 그때까지 이대로 두자.",
		})
	end, 24)
	return map
end

---------------------------------------------------------------- 실행
local maps = { buildOffice(), buildHall(), buildF95(), buildRoof() }
local t0 = os.clock()
RunService.Heartbeat:Connect(function(dt)
	local t = os.clock() - t0
	for _, m in ipairs(maps) do
		for _, fn in ipairs(m.upd) do fn(t, dt) end
	end
end)

-- 엘리베이터 층 선택 (서버에서 거리 검사)
local function nearElevator(plr, floor)
	local ch = plr.Character
	local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
	if not hrp then return false end
	local m = plr:GetAttribute("Map")
	return (floor == 100 and m == "hall") or (floor == 95 and m == "f95")
end
ElevPick.OnServerEvent:Connect(function(plr, from, to)
	if from ~= 100 and from ~= 95 then return end
	if not nearElevator(plr, from) then return end
	if to ~= 100 and to ~= 95 then return end
	if to == from then return end
	if to == 95 then
		travel(plr, "f95", 22, 28.4, 0, -1, "ride", 100, 95, function(p2)
			if not questOn[p2] then say(p2, "", { "여기가 95층이다. 내가 맡긴 사무층.", "직원들이 분주하게 움직이고 있다." }) end
		end)
	else
		travel(plr, "hall", 7.5, 38.2, 0, -1, "ride", 95, 100)
	end
end)

-- 플레이어 입장 / 리스폰 / 옥상 가장자리 안내
local edgeCool = {}
local function onChar(plr, ch)
	task.wait(0.2)
	local info = plr:GetAttribute("Spawn")
	if info then
		local n, x, z, lx, lz = string.match(info, "^(%w+)|([%-%d%.]+)|([%-%d%.]+)|([%-%d%.]+)|([%-%d%.]+)$")
		if n then
			placeAt(plr, n, tonumber(x), tonumber(z), tonumber(lx), tonumber(lz))
			return
		end
	end
	placeAt(plr, "office", 24, 28, 0, -1)
end
Players.PlayerAdded:Connect(function(plr)
	plr.CharacterAdded:Connect(function(ch) onChar(plr, ch) end)
end)
for _, plr in ipairs(Players:GetPlayers()) do
	plr.CharacterAdded:Connect(function(ch) onChar(plr, ch) end)
end
Players.PlayerRemoving:Connect(function(plr)
	pendingSay[plr], pendingAsk[plr], busy[plr], questOn[plr], edgeCool[plr] = nil, nil, nil, nil, nil
end)

local edgeLines = { "난간이 없다. 한 걸음만 더 가면 떨어진다.", "저 아래로 리바이어던의 불빛이 점처럼 흩어져 있다." }
task.spawn(function()
	while true do
		task.wait(0.5)
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr:GetAttribute("Map") == "roof" and not busy[plr] then
				local ch = plr.Character
				local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
				if hrp then
					local p = (hrp.Position - ORIGIN.roof) / S
					local d = math.min(p.X - 8, 48 - p.X, p.Z - 7, 30 - p.Z)
					if d < 1.7 and d > -0.5 and p.Y > -1 and (edgeCool[plr] or 0) < os.clock() then
						edgeCool[plr] = os.clock() + 40
						say(plr, "", edgeLines)
					end
				end
			end
		end
	end
end)
